    "nuxt-gtag": "^4.1.0",
    "vue": "^3.5.0",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.12.2",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^25.6.0",
    "autoprefixer": "^10.4.20",
    "firebase-tools": "^15.32.1",
