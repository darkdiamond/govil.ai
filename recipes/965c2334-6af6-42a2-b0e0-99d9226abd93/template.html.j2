<script>
  (function () {
    function mk(id) {
      var el = document.getElementById(id);
      if (!el) return null;
      var c = echarts.init(el);
      window.addEventListener("resize", function () { c.resize(); });
      return c;
    }
    window.__bsSurvey = {
      mk: mk,
      hbar: function (id, d, unit) {
        var c = mk(id);
        if (!c) return;
        c.setOption(window.GovEcharts.option({
          color: window.GOVIL_PALETTE,
          tooltip: { trigger: "axis", valueFormatter: function (v) { return v + unit; } },
          grid: { left: 16, right: 40, top: 8, bottom: 16, containLabel: true },
          xAxis: { type: "value", axisLabel: { formatter: "{value}" + unit } },
          yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 140, overflow: "truncate" } },
          series: [{ type: "bar", data: d.values.slice().reverse(), label: { show: true, position: "right", formatter: "{c}" + unit } }]
        }));
      },
      group: function (id, d) {
        var c = mk(id);
        if (!c) return;
        c.setOption(window.GovEcharts.option({
          color: window.GOVIL_PALETTE,
          tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
          legend: { bottom: 0 },
          grid: { left: 16, right: 24, top: 8, bottom: 40, containLabel: true },
          xAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
          yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 130, overflow: "truncate" } },
          series: d.series.map(function (s) { return { type: "bar", name: s.name, data: s.values.slice().reverse() }; })
        }));
      }
    };
  })();
  (function () {
    window.__bsSurvey.hbar("chart-top-items", {{ model.charts.top_items | tojson }}, "%");
  })();
  (function () {
    window.__bsSurvey.hbar("chart-cats", {{ model.charts.cats | tojson }}, "%");
  })();
  (function () {
    var d = {{ model.charts.sel | tojson }};
    var c = window.__bsSurvey.mk("chart-sel");
    if (!c) return;
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) { return echarts.format.encodeHTML(p.name) + ": " + p.value + " משיבים (" + p.percent + "%)"; } },
      legend: { bottom: 0 },
      series: [{ type: "pie", radius: ["40%", "68%"], center: ["50%", "45%"], data: d, label: { formatter: "{b}\n{d}%" } }]
    }));
  })();
  (function () {
    window.__bsSurvey.group("chart-ctx", {{ model.charts.ctx | tojson }});
  })();
{%- for ci in model.cat_items %}
  (function () {
    window.__bsSurvey.hbar({{ ci.id | tojson }}, {{ ci.chart | tojson }}, "%");
  })();
{%- endfor %}
  (function () {
    var d = {{ model.charts.nb | tojson }};
    var c = window.__bsSurvey.mk("chart-nb");
    if (!c) return;
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 8, bottom: 40, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 130, overflow: "truncate" } },
      series: d.series.map(function (s) { return { type: "bar", stack: "t", name: s.name, data: s.values.slice().reverse() }; })
    }));
  })();
{%- if model.flags.heat %}
  (function () {
    var d = {{ model.charts.heat | tojson }};
    var c = window.__bsSurvey.mk("chart-heat");
    if (!c) return;
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) { var e = echarts.format.encodeHTML; return e(d.x[p.value[0]]) + "<br>" + e(d.y[p.value[1]]) + ": " + p.value[2] + "% מתוך " + p.value[3] + " משיבים"; } },
      grid: { left: 16, right: 16, top: 8, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: d.x, splitArea: { show: true }, axisLabel: { interval: 0, rotate: 40 } },
      yAxis: { type: "category", data: d.y, splitArea: { show: true }, axisLabel: { width: 110, overflow: "truncate" } },
      visualMap: { min: 0, max: d.max, dimension: 2, calculable: true, orient: "horizontal", left: "center", bottom: 0,
        itemHeight: 120, inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] }, textStyle: { fontFamily: "Rubik", color: "#0c3058" } },
      series: [{ type: "heatmap", data: d.cells, label: { show: true, fontSize: 10, formatter: function (p) { return Math.round(p.value[2]); } } }]
    }));
  })();
{%- endif %}
{%- if model.flags.gender %}
  (function () {
    window.__bsSurvey.group("chart-gender", {{ model.charts.gender | tojson }});
  })();
{%- endif %}
{%- if model.flags.kids %}
  (function () {
    window.__bsSurvey.group("chart-kids", {{ model.charts.kids | tojson }});
  })();
{%- endif %}
  (function () {
    var d = {{ model.charts.profile | tojson }};
    var c = window.__bsSurvey.mk("chart-profile");
    if (!c) return;
    c.setOption(window.GovEcharts.option({
      color: ["#0068f5", "#9fc3f7"],
      tooltip: { trigger: "item", formatter: function (p) { var s = d.series[p.seriesIndex]; return echarts.format.encodeHTML(s.labels[p.dataIndex]) + ": " + p.value + "%"; } },
      grid: { left: 16, right: 24, top: 8, bottom: 16, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names.slice().reverse() },
      series: d.series.map(function (s) {
        var labels = s.labels.slice().reverse();
        return { type: "bar", stack: "p", data: s.values.slice().reverse(),
          label: { show: true, color: s.name === "first" ? "#ffffff" : "#0c3058", formatter: function (p) { return labels[p.dataIndex] + " " + Math.round(p.value) + "%"; } } };
      })
    }));
  })();
{%- if model.flags.age %}
  (function () {
    var d = {{ model.charts.age | tojson }};
    var c = window.__bsSurvey.mk("chart-age");
    if (!c) return;
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 16, right: 16, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, rotate: 30 } },
      yAxis: { type: "value" },
      series: [{ type: "bar", name: "משיבים", data: d.values }]
    }));
  })();
{%- endif %}
{%- if model.flags.fam %}
  (function () {
    var d = {{ model.charts.fam | tojson }};
    var c = window.__bsSurvey.mk("chart-fam");
    if (!c) return;
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) { return echarts.format.encodeHTML(p.name) + ": " + p.value + " (" + p.percent + "%)"; } },
      legend: { bottom: 0 },
      series: [{ type: "pie", radius: ["40%", "68%"], center: ["50%", "45%"], data: d, label: { formatter: "{b}\n{d}%" } }]
    }));
  })();
{%- endif %}
{%- if model.flags.free %}
  (function () {
    window.__bsSurvey.hbar("chart-free", {{ model.charts.free | tojson }}, "");
  })();
{%- endif %}
</script>
