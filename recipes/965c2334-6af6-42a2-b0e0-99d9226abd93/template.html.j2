  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.free_note }}</p>
  <div id="chart-free" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.free_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
