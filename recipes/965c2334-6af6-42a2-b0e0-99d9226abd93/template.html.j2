<h1>{{ model.labels.h1 }}</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.users.tone }} mb-1" dir="ltr">{{ model.kpis.users.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.users_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.answers.tone }} mb-1" dir="ltr">{{ model.kpis.answers.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.answers_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.mentions.tone }} mb-1" dir="ltr">{{ model.kpis.mentions.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.mentions_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.neighborhoods.tone }} mb-1" dir="ltr">{{ model.kpis.neighborhoods.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.nb_kpi }}</div>
  </div>
{%- if model.flags.top_share %}
  <div class="card p-4 text-center col-span-2 md:col-span-1">
    <div class="text-3xl font-bold text-{{ model.kpis.top_share.tone }} mb-1" dir="ltr">{{ model.kpis.top_share.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.top_kpi }}</div>
  </div>
{%- endif %}
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

{% macro share_table(rows, aria, head) -%}
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ aria }}</caption>
      <thead><tr><th scope="col">{{ head }}</th><th scope="col">משיבים</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in rows %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.n }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
{%- endmacro %}

{% macro multi_table(rows, heads, aria, head) -%}
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ aria }}</caption>
      <thead><tr><th scope="col">{{ head }}</th>{% for h in heads %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for r in rows %}
        <tr><th scope="row">{{ r.name }}</th>{% for v in r.vals %}<td>{{ v }}</td>{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
{%- endmacro %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">אילו עסקים חסרים לתושבים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.top_items_note }}</p>
  <div id="chart-top-items" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.top_items_aria }}"></div>
  {{ share_table(model.tables.top_items, model.labels.top_items_aria, "סוג עסק") }}
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/list.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">קטגוריות העסקים שנבחרו</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">שיעור המשיבים שבחרו לענות על כל קטגוריה.</p>
    <div id="chart-cats" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.cat_aria }}"></div>
    {{ share_table(model.tables.cats, model.labels.cat_aria, "קטגוריה") }}
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">איפה חסרים העסקים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">כל משיב בחר מקום אחד שאליו התייחס בתשובותיו.</p>
    <div id="chart-sel" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.sel_aria }}"></div>
    {{ share_table(model.tables.sel, model.labels.sel_aria, "מקום") }}
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">ליד הבית או במרכז העיר: מה מבקשים בכל מקום</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">שיעור המבקשים מתוך המשיבים שהתייחסו לכל מקום, לעשרת העסקים המבוקשים ביותר.</p>
  <div id="chart-ctx" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.ctx_aria }}"></div>
  {{ multi_table(model.tables.ctx, model.tables.ctx_heads, model.labels.ctx_aria, "סוג עסק") }}
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">המבוקשים בכל קטגוריה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-4">{{ model.labels.cats_note }}</p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
{%- for c in model.cat_items %}
    <div>
      <h3 class="m-0 mb-1 text-base font-semibold text-ink-deep">{{ c.name }}</h3>
      <p class="m-0 text-xs text-subtle">{{ c.n_users }} משיבים בחרו בקטגוריה</p>
      <div id="{{ c.id }}" class="h-64 md:h-80" role="img" aria-label="{{ c.aria }}"></div>
      <details class="mt-2">
        <summary class="text-sm text-subtle">הצג כטבלה</summary>
        <table class="mt-2 w-full text-sm">
          <caption class="sr-only">{{ c.aria }}</caption>
          <thead><tr><th scope="col">סוג עסק</th><th scope="col">משיבים</th><th scope="col">שיעור</th></tr></thead>
          <tbody>
{%- for r in c.rows %}
            <tr><th scope="row">{{ r.name }}</th><td>{{ r.n }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
          </tbody>
        </table>
      </details>
    </div>
{%- endfor %}
  </div>
</section>

<section class="card p-5 mb-6">
