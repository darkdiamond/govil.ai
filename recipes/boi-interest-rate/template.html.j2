<h1>ריבית בנק ישראל: הריבית היום וכל שינויי הריבית</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["rate", "last_change", "prime", "effective", "days"] %}
{%- if model.kpis[key] is defined %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.labels[key ~ "_kpi"] }}</div>
  </div>
{%- endif %}
{%- endfor %}
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">הריבית לאורך השנים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.history_note }}</p>
  <div id="chart-history" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.history_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה (הריבית בסוף כל שנה)</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.year_caption }}</caption>
      <thead><tr><th scope="col">שנה</th><th scope="col">ריבית בסוף השנה</th><th scope="col">שינויים בשנה</th></tr></thead>
      <tbody>
{%- for r in model.tables.years %}
        <tr><th scope="row">{{ r.year }}</th><td dir="ltr">{{ r.rate }}</td><td>{{ r.n }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">החלטות הריבית האחרונות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.recent_note }}</p>
  <div id="chart-recent" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.recent_aria }}"></div>
  <details class="mt-3" open>
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.recent_caption }}</caption>
      <thead><tr><th scope="col">בתוקף מ-</th><th scope="col">ריבית קודמת</th><th scope="col">ריבית חדשה</th><th scope="col">שינוי (נקודות אחוז)</th></tr></thead>
      <tbody>
{%- for r in model.tables.recent %}
        <tr><th scope="row">{{ r.date }}</th><td dir="ltr">{{ r["from"] }}</td><td dir="ltr">{{ r.to }}</td><td dir="ltr">{{ r.change }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מחזורי העלאה והורדה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cycles_note }}</p>
  <div id="chart-cycles" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.cycles_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.cycles_caption }}</caption>
      <thead><tr><th scope="col">התחלה</th><th scope="col">סיום</th><th scope="col">כיוון</th><th scope="col">החלטות</th><th scope="col">מ-</th><th scope="col">אל</th><th scope="col">שינוי מצטבר</th></tr></thead>
      <tbody>
{%- for r in model.tables.cycles %}
        <tr><th scope="row">{{ r.start }}</th><td>{{ r.end }}</td><td>{{ r.kind }}</td><td>{{ r.n }}</td><td dir="ltr">{{ r["from"] }}</td><td dir="ltr">{{ r.to }}</td><td dir="ltr">{{ r.change }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">העלאות והורדות לפי שנה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.per_year_note }}</p>
  <div id="chart-per-year" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.per_year_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.per_year_caption }}</caption>
      <thead><tr><th scope="col">שנה</th><th scope="col">העלאות</th><th scope="col">הורדות</th><th scope="col">שינוי מצטבר (נקודות אחוז)</th></tr></thead>
      <tbody>
{%- for r in model.tables.per_year %}
        <tr><th scope="row">{{ r.year }}</th><td>{{ r.hikes }}</td><td>{{ r.cuts }}</td><td dir="ltr">{{ r.net }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">התקופות הארוכות ללא שינוי</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.holds_note }}</p>
  <div id="chart-holds" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.holds_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.holds_caption }}</caption>
      <thead><tr><th scope="col">ריבית</th><th scope="col">מ-</th><th scope="col">עד</th><th scope="col">ימים</th></tr></thead>
      <tbody>
{%- for r in model.tables.holds %}
        <tr><th scope="row" dir="ltr">{{ r.rate }}</th><td>{{ r.start }}</td><td>{{ r.end }}</td><td>{{ r.days }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

{%- if model.flags.corridor %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מסדרון הריבית: חלון הפיקדונות וחלון ההלוואות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.corridor_note }}</p>
  <div id="chart-corridor" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.corridor_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה (רוחב המסדרון)</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.corridor_caption }}</caption>
      <thead><tr><th scope="col">מתאריך</th><th scope="col">מרווח לכל צד (נקודות אחוז)</th></tr></thead>
      <tbody>
{%- for r in model.tables.corridor %}
        <tr><th scope="row">{{ r["from"] }}</th><td dir="ltr">{{ r.width }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{%- endif %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">על הנתונים</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
{%- if model.flags.shir %}
    <li>{{ model.labels.shir_note }}</li>
{%- endif %}
    <li>ריבית הפריים מחושבת כאן לפי המוסכמה הבנקאית: ריבית בנק ישראל ועוד מרווח קבוע. היא אינה סדרה במאגר.</li>
    <li>תאריך ההחלטה בעמוד הוא היום שבו נכנסה הריבית החדשה לתוקף, ולא יום ההודעה של הוועדה המוניטרית.</li>
  </ul>
</section>

<script>
  (function () {
    const d = {{ model.charts.history | tojson }};
    const chart = echarts.init(document.getElementById("chart-history"));
    chart.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: (v) => Number(v).toFixed(2) + "%" },
      grid: { left: 16, right: 16, top: 24, bottom: 64, containLabel: true },
      xAxis: { type: "time" },
      yAxis: { type: "value", axisLabel: { formatter: (v) => v + "%" } },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 20 }],
      series: [{ type: "line", step: "end", showSymbol: false, name: "ריבית בנק ישראל", data: d, areaStyle: { opacity: 0.08 } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.recent | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-recent"));
    chart.setOption(window.GovEcharts.option({
      color: pal,
      tooltip: {
        trigger: "axis",
        formatter: (ps) => {
          const i = ps[0].dataIndex, v = d.y[i];
          return echarts.format.encodeHTML(d.x[i]) + "<br>" + (v > 0 ? "העלאה" : "הורדה") + " של " +
            Math.abs(v).toFixed(2) + " נקודות אחוז<br>ריבית חדשה: " + d.to[i].toFixed(2) + "%";
        }
      },
      grid: { left: 16, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value" },
      series: [{
        type: "bar",
        data: d.y.map((v) => ({ value: v, itemStyle: { color: v > 0 ? pal[0] : pal[5] } }))
      }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.cycles | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-cycles"));
    chart.setOption(window.GovEcharts.option({
      color: pal,
      tooltip: {
        trigger: "axis",
        formatter: (ps) => {
          const i = ps[0].dataIndex;
          return echarts.format.encodeHTML(d.x[i]) + "<br>" + d.n[i] + " החלטות, " +
            echarts.format.encodeHTML(d.span[i]) + "<br>שינוי מצטבר: " + d.y[i].toFixed(2) + " נקודות אחוז";
        }
      },
      grid: { left: 16, right: 16, top: 24, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value" },
      dataZoom: [{ type: "inside" }],
      series: [{
        type: "bar",
        data: d.y.map((v) => ({ value: v, itemStyle: { color: v > 0 ? pal[0] : pal[5] } }))
      }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.per_year | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-per-year"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[5]],
      tooltip: { trigger: "axis", valueFormatter: (v) => Math.abs(v) },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 36, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", minInterval: 1, axisLabel: { formatter: (v) => Math.abs(v) } },
      series: [
        { type: "bar", name: "העלאות", stack: "n", data: d.hikes },
        { type: "bar", name: "הורדות", stack: "n", data: d.cuts.map((v) => -v) }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.holds | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-holds"));
    chart.setOption(window.GovEcharts.option({
      color: pal,
      tooltip: {
        trigger: "axis",
        formatter: (ps) => {
          const i = ps[0].dataIndex;
          return echarts.format.encodeHTML(d.names[i]) + "<br>" + d.days[i].toLocaleString("he-IL") + " ימים" +
            (d.ongoing[i] ? " (נמשכת)" : "");
        }
      },
      grid: { left: 16, right: 24, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [{
        type: "bar",
        data: d.days.map((v, i) => ({ value: v, itemStyle: { color: d.ongoing[i] ? pal[3] : pal[0] } })),
        label: { show: true, position: "right", formatter: (p) => p.value.toLocaleString("he-IL") }
      }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- if model.flags.corridor %}
  (function () {
    const d = {{ model.charts.corridor | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-corridor"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[5], pal[0], pal[3]],
      tooltip: { trigger: "axis", valueFormatter: (v) => Number(v).toFixed(2) + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 36, bottom: 64, containLabel: true },
      xAxis: { type: "time" },
      yAxis: { type: "value", axisLabel: { formatter: (v) => v + "%" } },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 20 }],
      series: [
        { type: "line", step: "end", showSymbol: false, name: "חלון הפיקדונות", data: d.dep },
        { type: "line", step: "end", showSymbol: false, name: "ריבית בנק ישראל", data: d.rate, lineStyle: { width: 3 } },
        { type: "line", step: "end", showSymbol: false, name: "חלון ההלוואות", data: d.loan }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
</script>
