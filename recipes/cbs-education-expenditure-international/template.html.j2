{% import "gov.j2" as gov %}
{%- macro lede_p(key) -%}
{%- if model.ledes.get(key) %}
  <p class="m-0 mb-3 text-ink-deep">{{ model.ledes[key] }}</p>
{%- endif %}
{%- endmacro %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "המהדורה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסמה {{ model.release.date }}</p>
{%- if model.release.headline %}
  <p class="m-0 mb-3 font-semibold text-ink-deep">{{ model.release.headline }}</p>
{%- endif %}
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לפרסום המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["gdp", "gdp_oecd", "prim", "tert", "hh"] %}
{%- if model.kpis[key] is defined %}
  {{ gov.kpi(model.kpis[key], model.labels[key ~ "_kpi"]) }}
{%- endif %}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

{%- if model.flags.get("gdp") %}
<section class="card p-5 mb-6">
  {{ gov.head("chart-bar", "ההוצאה על מוסדות חינוך כאחוז מהתמ\"ג") }}
  {{ lede_p("gdp") }}
  <p class="m-0 text-sm text-subtle mb-3">כל דרגי החינוך, כולל חינוך קדם-יסודי (גני ילדים), שנת {{ model.years.gdp_level }}. העמודה מחולקת לפי דרג חינוך; החלק "קדם-יסודי ושאר ההוצאה" הוא ההפרש בין הסך לשני הדרגים האחרים.</p>
  {{ gov.chart("chart-gdp", "ההוצאה על מוסדות חינוך כאחוז מהתמ\"ג, ישראל ומדינות OECD, לפי דרג חינוך", "h-[720px] md:h-[780px]") }}
  {{ gov.table("ההוצאה על מוסדות חינוך כאחוז מהתמ\"ג", ["מדינה", "כל דרגי החינוך", "יסודי, על-יסודי ומכינות", "חינוך גבוה"], model.tables.gdp, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

{%- if model.flags.get("np") %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "הוצאה לאומית מול הוצאה ציבורית") }}
  {{ lede_p("np") }}
  <p class="m-0 text-sm text-subtle mb-3">אחוז מהתמ"ג, ללא חינוך קדם-יסודי, שנת {{ model.years.gdp_np }}. ההוצאה הלאומית כוללת את כל מקורות המימון; ההוצאה הציבורית כוללת את הרשויות המקומיות, הוצאה ישירה והעברות למלכ"רים. הפער ביניהן הוא המימון הפרטי.</p>
  {{ gov.chart("chart-np", "ההוצאה הלאומית וההוצאה הציבורית לחינוך כאחוז מהתמ\"ג לפי מדינה", "h-[560px] md:h-[620px]") }}
  {{ gov.table("ההוצאה הלאומית והציבורית לחינוך כאחוז מהתמ\"ג", ["מדינה", "הוצאה לאומית", "הוצאה ציבורית", "הפער (מימון לא ציבורי)"], model.tables.np, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

{%- if model.flags.get("pp_lv") %}
<section class="card p-5 mb-6">
  {{ gov.head("trending-up", "הוצאה לתלמיד לפי שלב חינוך: ישראל מול OECD") }}
  {{ lede_p("pp_lv") }}
  <p class="m-0 text-sm text-subtle mb-3">הוצאה שנתית על מוסדות חינוך לתלמיד, בדולרים לפי שווי כוח קנייה (PPP), שנת {{ model.years.per_pupil }}.</p>
  {{ gov.chart("chart-pp_lv", "הוצאה לתלמיד לפי שלב חינוך, ישראל לעומת ממוצע OECD", "h-72 md:h-96") }}
  {{ gov.table("הוצאה לתלמיד לפי שלב חינוך", ["שלב חינוך", "ישראל (דולר)", "ממוצע OECD (דולר)", "ישראל כאחוז מהממוצע"], model.tables.pp_lv, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

{%- if model.flags.get("pp_rank") %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "דירוג המדינות בהוצאה לתלמיד") }}
  <p class="m-0 text-sm text-subtle mb-3">בדולרים לפי שווי כוח קנייה, שנת {{ model.years.per_pupil }}. בחרו שלב חינוך:</p>
  <div id="pp-level" class="flex flex-wrap gap-2 mb-3" role="group" aria-label="בחירת שלב חינוך">
{%- for m in model.charts.pp_rank.metrics %}
    <button type="button" class="rounded-gov-pill border border-rule px-3 py-1 text-sm" data-k="{{ loop.index0 }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ m.label }}</button>
{%- endfor %}
  </div>
  {{ gov.chart("chart-pp_rank", "דירוג המדינות בהוצאה לתלמיד בשלב החינוך שנבחר", "h-[720px] md:h-[780px]") }}
  {{ gov.table("הוצאה לתלמיד לפי מדינה ושלב חינוך (דולר)", ["מדינה", "קדם-יסודי", "יסודי", "על-יסודי", "חינוך גבוה"], model.tables.pp_rank, ltr=(1, 2, 3, 4)) }}
</section>
{%- endif %}

{%- if model.flags.get("pub") %}
<section class="card p-5 mb-6">
  {{ gov.head("building-2", "ההוצאה הציבורית לתלמיד") }}
  {{ lede_p("pub") }}
  <p class="m-0 text-sm text-subtle mb-3">הוצאות המגזר הממשלתי לתלמיד בכל דרגי החינוך (ללא קדם-יסודי), בדולרים לפי שווי כוח קנייה, שנת {{ model.years.pub_pupil }}.</p>
  {{ gov.chart("chart-pub", "ההוצאה הציבורית לתלמיד לפי מדינה", "h-[560px] md:h-[620px]") }}
  {{ gov.table("ההוצאה הציבורית לתלמיד לפי מדינה (דולר)", ["מדינה", "כל דרגי החינוך", "יסודי, על-יסודי ומכינות", "חינוך גבוה"], model.tables.pub, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

{%- if model.flags.get("sh_lv") %}
<section class="card p-5 mb-6">
  {{ gov.head("circle-check", "מי מממן את מוסדות החינוך") }}
  {{ lede_p("sh_lv") }}
  <p class="m-0 text-sm text-subtle mb-3">שיעור כל מקור מימון מההוצאה על מוסדות חינוך (ללא קדם-יסודי), באחוזים, שנת {{ model.years.shares }}. "מקורות אחרים" כוללים מימון בין-לאומי.</p>
  {{ gov.chart("chart-sh_lv", "מקורות המימון של מוסדות החינוך בישראל ובממוצע OECD לפי דרג חינוך", "h-72 md:h-80") }}
  {{ gov.table("מקורות מימון לפי דרג חינוך (אחוזים)", ["", "מקורות ציבוריים", "משקי בית", "גופים פרטיים אחרים"], model.tables.sh_lv, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

{%- if model.flags.get("sh") %}
<section class="card p-5 mb-6">
  {{ gov.head("chart-bar", "חלק המימון הציבורי לפי מדינה") }}
  <p class="m-0 text-sm text-subtle mb-3">כל דרגי החינוך (ללא קדם-יסודי), באחוזים מההוצאה על מוסדות חינוך, שנת {{ model.years.shares }}. מסודר מהמימון הציבורי הגבוה לנמוך.</p>
  {{ gov.chart("chart-sh", "מקורות המימון של מוסדות החינוך לפי מדינה", "h-[480px] md:h-[520px]") }}
  {{ gov.table("מקורות מימון לפי מדינה, כל דרגי החינוך (אחוזים)", ["מדינה", "מקורות ציבוריים", "משקי בית", "גופים פרטיים אחרים"], model.tables.sh, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>המקור: ההודעה השנתית לתקשורת "ההוצאה הלאומית לחינוך: השוואה בין-לאומית" של הלשכה המרכזית לסטטיסטיקה (הלמ"ס), המבוססת על שנתון החינוך של OECD, Education at a Glance. העמוד מציג את המהדורה האחרונה ומתעדכן כשמתפרסמת מהדורה חדשה.</li>
    <li>ההשוואה מתייחסת לשנת נתונים מוקדמת בשנתיים עד שלוש משנת הפרסום. ממוצע OECD הוא ממוצע לא משוקלל של המדינות שיש להן נתונים, והלוחות מציגים מדינות נבחרות בלבד, לכן הדירוג בעמוד הוא בין המדינות שבלוח.</li>
    <li>סכומים לתלמיד מומרים לדולרים לפי שווי כוח קנייה (PPP), כדי שאפשר יהיה להשוות בין מדינות עם רמות מחירים שונות.</li>
    <li>חלק מהלוחות כוללים חינוך קדם-יסודי וחלקם לא (מצוין ליד כל תרשים), לכן אחוזי התמ"ג בתרשימים שונים אינם זהים.</li>
  </ul>
</section>

<script>
  (function () {
    const pal = window.GOVIL_PALETTE;
    const charts = [];
    const narrow = () => window.innerWidth < 640;
    const f1 = (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    const f0 = (v) => v == null ? "" : Math.round(Number(v)).toLocaleString("he-IL");
    const enc = (s) => echarts.format.encodeHTML(String(s));
    function mount(id) {
      const el = document.getElementById(id);
      if (!el) return null;
      const c = echarts.init(el);
      charts.push(c);
      return c;
    }
    function catAxis(d) {
      return {
        type: "category", data: d.x, inverse: true,
        axisLabel: {
          interval: 0, width: narrow() ? 84 : 140, overflow: "truncate", fontSize: narrow() ? 11 : 12,
          formatter: (v, i) => d.hl[i] === "il" ? "{il|" + v + "}" : (d.hl[i] === "oecd" ? "{oe|" + v + "}" : v),
          rich: { il: { fontWeight: "bold", color: "#0068f5" }, oe: { fontWeight: "bold", color: "#0c3058" } }
        }
      };
    }
    function hlColor(hl, base) {
      return hl === "il" ? "#0068f5" : (hl === "oecd" ? "#0c3058" : base);
    }
{%- if model.flags.get("gdp") %}
    (function () {
      const d = {{ model.charts.gdp | tojson }};
      const c = mount("chart-gdp");
      c.setOption(window.GovEcharts.option({
        color: [pal[0], pal[2], pal[6]],
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : f1(v) + "%",
          formatter: (ps) => { const i = ps[0].dataIndex; return enc(d.x[i]) + ": " + f1(d.total[i]) + "% מהתמ\"ג<br>" + ps.map((p) => p.marker + enc(p.seriesName) + " " + f1(p.value) + "%").join("<br>"); } },
        legend: { top: 0, type: "scroll" },
        grid: { left: 16, right: 24, top: 48, bottom: 16, containLabel: true },
        xAxis: { type: "value", splitNumber: narrow() ? 3 : 5, axisLabel: { formatter: (v) => f1(v) + "%" } },
        yAxis: catAxis(d),
        series: d.series.map((s) => ({ type: "bar", name: s.name, data: s.data, stack: "all", barMaxWidth: 18 }))
      }));
    })();
{%- endif %}
{%- if model.flags.get("np") %}
    (function () {
      const d = {{ model.charts.np | tojson }};
      const c = mount("chart-np");
      c.setOption(window.GovEcharts.option({
        color: [pal[0], pal[2]],
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : f1(v) + "%" },
        legend: { top: 0 },
        grid: { left: 16, right: 24, top: 48, bottom: 16, containLabel: true },
        xAxis: { type: "value", splitNumber: narrow() ? 3 : 5, axisLabel: { formatter: (v) => f1(v) + "%" } },
        yAxis: catAxis(d),
        series: d.series.map((s) => ({ type: "bar", name: s.name, data: s.data, barMaxWidth: 10, barGap: "10%" }))
      }));
    })();
{%- endif %}
{%- if model.flags.get("pp_lv") %}
    (function () {
      const d = {{ model.charts.pp_lv | tojson }};
      const c = mount("chart-pp_lv");
      c.setOption(window.GovEcharts.option({
        color: ["#0068f5", "#0c3058"],
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
          formatter: (ps) => { const i = ps[0].dataIndex; return enc(d.x[i]) + "<br>" + ps.map((p) => p.marker + enc(p.seriesName) + " " + f0(p.value) + " $").join("<br>") + (d.pct[i] == null ? "" : "<br>ישראל: " + d.pct[i] + "% מהממוצע"); } },
        legend: { top: 0 },
        grid: { left: 16, right: 16, top: 48, bottom: 16, containLabel: true },
        xAxis: { type: "category", data: d.x, axisLabel: { interval: 0, rotate: narrow() ? 35 : 0, fontSize: narrow() ? 11 : 12 } },
        yAxis: { type: "value", axisLabel: { formatter: (v) => f0(v) } },
        series: [
          { type: "bar", name: "ישראל", data: d.il, barMaxWidth: 28 },
          { type: "bar", name: "ממוצע OECD", data: d.oecd, barMaxWidth: 28 }
        ]
      }));
    })();
{%- endif %}
{%- if model.flags.get("pp_rank") %}
    (function () {
      const d = {{ model.charts.pp_rank | tojson }};
      const c = mount("chart-pp_rank");
      const btns = Array.prototype.slice.call(document.querySelectorAll("#pp-level button"));
      function show(k) {
        const m = d.metrics[k];
        btns.forEach((b, i) => {
          b.setAttribute("aria-pressed", i === k ? "true" : "false");
          b.style.background = i === k ? "#0068f5" : "";
          b.style.color = i === k ? "#fff" : "";
        });
        c.setOption(window.GovEcharts.option({
          tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : f0(v) + " $" },
          grid: { left: 16, right: 56, top: 16, bottom: 16, containLabel: true },
          xAxis: { type: "value", splitNumber: narrow() ? 3 : 5, axisLabel: { formatter: (v) => f0(v) } },
          yAxis: catAxis(m),
          series: [{
            type: "bar", name: m.label, barMaxWidth: 16,
            data: m.y.map((v, i) => ({ value: v, itemStyle: { color: hlColor(m.hl[i], "#b7d2f7") } })),
            label: { show: true, position: "right", formatter: (p) => f0(p.value), fontSize: 10 }
          }]
        }), true);
      }
      btns.forEach((b, i) => b.addEventListener("click", () => show(i)));
      show(0);
    })();
{%- endif %}
{%- if model.flags.get("pub") %}
    (function () {
      const d = {{ model.charts.pub | tojson }};
      const c = mount("chart-pub");
      c.setOption(window.GovEcharts.option({
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : f0(v) + " $" },
        grid: { left: 16, right: 56, top: 16, bottom: 16, containLabel: true },
        xAxis: { type: "value", splitNumber: narrow() ? 3 : 5, axisLabel: { formatter: (v) => f0(v) } },
        yAxis: catAxis(d),
        series: [{
          type: "bar", name: "הוצאה ציבורית לתלמיד", barMaxWidth: 16,
          data: d.y.map((v, i) => ({ value: v, itemStyle: { color: hlColor(d.hl[i], "#b7d2f7") } })),
          label: { show: true, position: "right", formatter: (p) => f0(p.value), fontSize: 10 }
        }]
      }));
    })();
{%- endif %}
{%- if model.flags.get("sh_lv") or model.flags.get("sh") %}
    function shares(id, d, hlAxis) {
      const c = mount(id);
      if (!c) return;
      const y = hlAxis ? catAxis(d) : { type: "category", data: d.x, inverse: true, axisLabel: { interval: 0, width: narrow() ? 110 : 200, overflow: "break", fontSize: narrow() ? 11 : 12 } };
      c.setOption(window.GovEcharts.option({
        color: ["#0068f5", "#0b3668", "#6c9fd8", "#c3cfe7"],
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : f1(v) + "%" },
        legend: { top: 0 },
        grid: { left: 16, right: 24, top: narrow() ? 72 : 48, bottom: 16, containLabel: true },
        xAxis: { type: "value", splitNumber: narrow() ? 3 : 5, max: 100, axisLabel: { formatter: (v) => v + "%" } },
        yAxis: y,
        series: [
          { type: "bar", name: "מקורות ציבוריים", stack: "s", data: d.pub, barMaxWidth: 22 },
          { type: "bar", name: "משקי בית", stack: "s", data: d.hh, barMaxWidth: 22 },
          { type: "bar", name: "גופים פרטיים אחרים", stack: "s", data: d.oth, barMaxWidth: 22 },
          { type: "bar", name: "מקורות אחרים", stack: "s", data: d.intl, barMaxWidth: 22 }
        ]
      }));
    }
{%- endif %}
{%- if model.flags.get("sh_lv") %}
    shares("chart-sh_lv", {{ model.charts.sh_lv | tojson }}, false);
{%- endif %}
{%- if model.flags.get("sh") %}
    shares("chart-sh", {{ model.charts.sh | tojson }}, true);
{%- endif %}
    window.addEventListener("resize", () => charts.forEach((c) => c.resize()));
  })();
</script>
