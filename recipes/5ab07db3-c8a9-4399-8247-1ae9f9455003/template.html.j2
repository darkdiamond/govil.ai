<h1>בעלי רישיון עיסוק בקנביס רפואי מהיק"ר</h1>

<style>
  .cn-table th, .cn-table td { padding: 0.35rem 0.5rem; text-align: start; vertical-align: top; }
  .cn-table tbody tr { border-top: 1px solid #c3cfe7; }
</style>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">בדיקת רישיון עיסוק בקנביס לפי שם החברה ←</span>
    <span class="block text-sm text-subtle">{{ model.labels.lookup_sub }}</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.active.tone }} mb-1" dir="ltr">{{ model.kpis.active.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.active_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.bodies.tone }} mb-1" dir="ltr">{{ model.kpis.bodies.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.bodies_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.frozen.tone }} mb-1" dir="ltr">{{ model.kpis.frozen.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.frozen_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.share.tone }} mb-1" dir="ltr">{{ model.kpis.share.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.share_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">רישיונות לפי שלב בשרשרת האספקה: פעילים ומוקפאים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.chain_note }}</p>
  <div id="chart-chain" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.chain_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="cn-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.chain_aria }}</caption>
        <thead><tr><th scope="col">תחום פעילות</th><th scope="col">פעילים</th><th scope="col">מוקפאים או מבוטלים</th><th scope="col">שיעור מוקפאים</th></tr></thead>
        <tbody>
{%- for r in model.tables.chain %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.active }}</td><td>{{ r.frozen }}</td><td>{{ r.rate }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>

{%- if model.flags.rate %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/triangle-alert.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">שיעור ההקפאות והביטולים בכל תחום</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.rate_note }}</p>
  <div id="chart-rate" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.rate_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="cn-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.rate_aria }}</caption>
        <thead><tr><th scope="col">תחום פעילות</th><th scope="col">שיעור מוקפאים או מבוטלים</th><th scope="col">פעילים</th><th scope="col">מוקפאים או מבוטלים</th></tr></thead>
        <tbody>
{%- for r in model.tables.rate %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.rate }}</td><td>{{ r.active }}</td><td>{{ r.frozen }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>
{%- endif %}

{%- if model.flags.multi %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">גופים עם כמה רישיונות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.multi_note }}</p>
  <div id="chart-combo" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.multi_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="cn-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.multi_aria }}</caption>
        <thead><tr><th scope="col">צירוף תחומים</th><th scope="col">גופים</th></tr></thead>
        <tbody>
{%- for r in model.tables.combo %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
      <table class="cn-table mt-4 w-full text-sm">
        <caption class="sr-only">{{ model.labels.dist_aria }}</caption>
        <thead><tr><th scope="col">רישיונות פעילים לגוף</th><th scope="col">גופים</th></tr></thead>
        <tbody>
{%- for r in model.tables.dist %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
  <details class="mt-3">
    <summary class="text-sm text-subtle">רשימת הגופים עם יותר מרישיון פעיל אחד</summary>
    <div class="overflow-x-auto">
      <table class="cn-table mt-2 w-full text-sm">
        <caption class="sr-only">גופים המחזיקים יותר מרישיון עיסוק פעיל אחד</caption>
        <thead><tr><th scope="col">שם הגוף</th><th scope="col">רישיונות פעילים</th><th scope="col">תחומים</th></tr></thead>
        <tbody>
{%- for r in model.tables.multi %}
          <tr><th scope="row" class="font-normal">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.stages }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>
{%- endif %}

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
{%- if model.flags.labs %}
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/list.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">מעבדות: היקף השירות</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.labs_note }}</p>
    <div id="chart-labs" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.labs_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="cn-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.labs_aria }}</caption>
        <thead><tr><th scope="col">היקף השירות</th><th scope="col">מעבדות</th></tr></thead>
        <tbody>
{%- for r in model.tables.labs %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
{%- endif %}
{%- if model.flags.form %}
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">צורת ההתאגדות של בעלי הרישיון</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.form_note }}</p>
    <div id="chart-form" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.form_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="cn-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.form_aria }}</caption>
        <thead><tr><th scope="col">צורת התאגדות</th><th scope="col">גופים</th></tr></thead>
        <tbody>
{%- for r in model.tables.form %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
{%- endif %}
</div>

{%- if model.flags.other %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מה מסתתר בקטגוריה "אחר"</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.other_note }}</p>
  <div id="chart-other" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.other_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="cn-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.other_aria }}</caption>
        <thead><tr><th scope="col">פעילות שצוינה</th><th scope="col">רישיונות</th></tr></thead>
        <tbody>
{%- for r in model.tables.other %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>
{%- endif %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/triangle-alert.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">איכות הנתונים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.quality_note }}</p>
  <table class="cn-table w-full text-sm">
    <caption class="sr-only">בדיקות איכות הנתונים ברשימת בעלי רישיון העיסוק בקנביס</caption>
    <thead><tr><th scope="col">בדיקה</th><th scope="col">מספר</th></tr></thead>
    <tbody>
{%- for r in model.tables.quality %}
      <tr><th scope="row" class="font-normal">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
    </tbody>
  </table>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">להלן רשימות הגופים בעלי רישיון מהיק"ר לעיסוק בתחום הקנביס לשימוש רפואי ולמחקר, על פי תחום ונושא הפעילות. רשימה זו עשוייה להתעדכן מעת לעת.

בהתקשרות בין שני גופים בעלי רישיון, מוטלת האחריות על כל אחד מצדדי ההתקשרות לוודא קיום רישיון מהיק"ר לעיסוק בתחום הקנביס בתוקף, של הגוף האחר.</p>
</section>

<script>
  (function () {
    var d = {{ model.charts.chain | tojson }};
    var el = document.getElementById("chart-chain");
    var c = echarts.init(el);
    var narrow = el.clientWidth < 500;
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0, data: ["פעילים", "מוקפאים או מבוטלים"] },
      grid: { left: 16, right: 32, top: 16, bottom: 40, containLabel: true },
      xAxis: { type: "value", minInterval: 1, axisLabel: { show: !narrow } },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [
        { type: "bar", name: "פעילים", stack: "all", data: d.active, itemStyle: { color: "#0068f5" },
          label: { show: true, position: "insideRight", color: "#ffffff", formatter: function (p) { return p.value >= 4 ? p.value : ""; } } },
        { type: "bar", name: "מוקפאים או מבוטלים", stack: "all", data: d.frozen, itemStyle: { color: "#9fb3cf" },
          label: { show: true, position: "right", color: "#0c3058", formatter: function (p) { return p.value > 0 ? p.value : ""; } } }
      ]
    }));
    window.addEventListener("resize", function () {
      var w = el.clientWidth < 500;
      if (w !== narrow) { narrow = w; c.setOption({ xAxis: { axisLabel: { show: !narrow } } }); }
      c.resize();
    });
  })();
</script>

{%- if model.flags.rate %}
<script>
  (function () {
    var d = {{ model.charts.rate | tojson }};
    var el = document.getElementById("chart-rate");
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: {
        trigger: "axis", axisPointer: { type: "shadow" },
        formatter: function (ps) {
          var i = ps[0].dataIndex;
          return echarts.format.encodeHTML(d.names[i]) + "<br>" + d.values[i] + "% מוקפאים או מבוטלים" +
            (d.values[i] >= d.high ? " (שיעור גבוה)" : "") +
            "<br>" + d.frozen[i] + " מוקפאים, " + d.active[i] + " פעילים";
        }
      },
      grid: { left: 16, right: 48, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [{
        type: "bar",
        data: d.values.map(function (v) { return v >= d.high ? { value: v, itemStyle: { color: "#dc3545" } } : { value: v, itemStyle: { color: "#0068f5" } }; }),
        label: { show: true, position: "right", formatter: function (p) { return Math.round(p.value) + "%"; } }
      }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

{%- if model.flags.multi %}
<script>
  (function () {
    var d = {{ model.charts.combo | tojson }};
    var el = document.getElementById("chart-combo");
    var c = echarts.init(el);
    var narrow = el.clientWidth < 500;
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 40, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "value", minInterval: 1, axisLabel: { show: !narrow } },
      yAxis: { type: "category", data: d.names, inverse: true,
               axisLabel: { width: narrow ? 140 : 280, overflow: "break" } },
      series: [{ type: "bar", name: "גופים", data: d.values, itemStyle: { color: "#0068f5" },
                 label: { show: true, position: "right" } }]
    }));
    window.addEventListener("resize", function () {
      var w = el.clientWidth < 500;
      if (w !== narrow) { narrow = w; c.setOption({ xAxis: { axisLabel: { show: !narrow } }, yAxis: { axisLabel: { width: narrow ? 140 : 280 } } }); }
      c.resize();
    });
  })();
</script>
{%- endif %}

{%- if model.flags.labs %}
<script>
  (function () {
    var d = {{ model.charts.labs | tojson }};
    var el = document.getElementById("chart-labs");
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 40, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "value", minInterval: 1 },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 150, overflow: "break" } },
      series: [{ type: "bar", name: "מעבדות", data: d.values, itemStyle: { color: "#0068f5" },
                 label: { show: true, position: "right" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

{%- if model.flags.form %}
<script>
  (function () {
    var d = {{ model.charts.form | tojson }};
    var el = document.getElementById("chart-form");
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) { return echarts.format.encodeHTML(p.name) + ": " + p.value + " גופים (" + p.percent + "%)"; } },
      legend: { bottom: 0, type: "scroll" },
      series: [{
        type: "pie", radius: ["38%", "64%"], center: ["50%", "44%"],
        data: d.names.map(function (nm, i) { return { name: nm, value: d.values[i] }; }),
        label: { formatter: function (p) { return p.percent >= 5 ? Math.round(p.percent) + "%" : ""; } }
      }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

{%- if model.flags.other %}
<script>
  (function () {
    var d = {{ model.charts.other | tojson }};
    var el = document.getElementById("chart-other");
    var c = echarts.init(el);
    var narrow = el.clientWidth < 500;
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 40, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "value", minInterval: 1, axisLabel: { show: !narrow } },
      yAxis: { type: "category", data: d.names, inverse: true,
               axisLabel: { width: narrow ? 150 : 320, overflow: "break" } },
      series: [{
        type: "bar", name: "רישיונות",
        data: d.values.map(function (v, i) { return { value: v, itemStyle: { color: (d.names[i] === "ללא פירוט") ? "#9fb3cf" : "#0068f5" } }; }),
        label: { show: true, position: "right" }
      }]
    }));
    window.addEventListener("resize", function () {
      var w = el.clientWidth < 500;
      if (w !== narrow) { narrow = w; c.setOption({ xAxis: { axisLabel: { show: !narrow } }, yAxis: { axisLabel: { width: narrow ? 150 : 320 } } }); }
      c.resize();
    });
  })();
</script>
{%- endif %}
