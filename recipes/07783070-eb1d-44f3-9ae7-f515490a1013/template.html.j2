<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">על הרשימה</h2>
  </div>
  <p class="m-0 text-sm text-subtle">הנהלת בתי המשפט נדרשת להעמיד לרשות בתי המשפט רשימת מומחים שאפשר למנות לחוות דעת בתיק. במאגר זה מוצגים המומחים בתחום ההנדסה האזרחית. תחומי ההתמחות, המחוזות וההשכלה נכתבים ברשימה כטקסט חופשי, והדף מקבץ אותם לקטגוריות; הניסוח המקורי של כל מומחה מופיע בטבלת הנתונים.</p>
</section>

<script>
  (function () {
    var esc = echarts.format.encodeHTML;
    function hbar(id, d, unit, color) {
      var el = document.getElementById(id);
      if (!el) { return; }
      var x = echarts.init(el);
      x.setOption(window.GovEcharts.option({
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
          return esc(String(p[0].name)) + ": " + Number(p[0].value).toLocaleString("he-IL") + " " + unit;
        } },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 4, minInterval: 1, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true,
                 axisLabel: { fontSize: 11, interval: 0, lineHeight: 13,
                              width: window.innerWidth < 500 ? 96 : 170, overflow: "break" } },
        series: [{ type: "bar", name: unit, data: d.values, itemStyle: { color: color, borderRadius: [0, 4, 4, 0] },
                   label: { show: true, position: "right", fontSize: 11 } }]
      }));
      window.addEventListener("resize", function () { x.resize(); });
    }
    function vbar(id, d, unit, color) {
      var el = document.getElementById(id);
      if (!el) { return; }
      var x = echarts.init(el);
      x.setOption(window.GovEcharts.option({
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
          return esc(String(p[0].name)) + ": " + Number(p[0].value).toLocaleString("he-IL") + " " + unit;
        } },
        grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
        xAxis: { type: "category", data: d.names, axisLabel: { interval: 0 } },
        yAxis: { type: "value", splitNumber: 4, minInterval: 1 },
        series: [{ type: "bar", name: unit, data: d.values, itemStyle: { color: color, borderRadius: [4, 4, 0, 0] },
                   label: { show: true, position: "top", fontSize: 11 } }]
      }));
      window.addEventListener("resize", function () { x.resize(); });
    }
    hbar("chart-spec", {{ model.charts.spec | tojson }}, "מומחים", "#0068f5");
    vbar("chart-nspec", {{ model.charts.nspec | tojson }}, "מומחים", "#0b3668");
{%- if model.flags.districts %}
    hbar("chart-dist", {{ model.charts.dist | tojson }}, "מומחים זמינים", "#0068f5");
    vbar("chart-ndist", {{ model.charts.ndist | tojson }}, "מומחים", "#0b3668");
{%- endif %}
{%- if model.flags.pairs %}
    hbar("chart-pairs", {{ model.charts.pairs | tojson }}, "מומחים", "#0b3668");
{%- endif %}
    hbar("chart-langs", {{ model.charts.langs | tojson }}, "מומחים", "#0068f5");
    hbar("chart-deg", {{ model.charts.deg | tojson }}, "מומחים", "#0b3668");
{%- if model.flags.inst %}
    hbar("chart-inst", {{ model.charts.inst | tojson }}, "מומחים", "#0068f5");
{%- endif %}
{%- if model.flags.cred %}
    hbar("chart-cred", {{ model.charts.cred | tojson }}, "מומחים", "#0b3668");
{%- endif %}
  })();
</script>

{% if model.flags.districts %}
<script>
  (function () {
    var esc = echarts.format.encodeHTML;
    var H = {{ model.charts.matrix | tojson }};
    var el = document.getElementById("chart-matrix");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return esc(String(H.full_y[p.value[1]])) + "<br/>מחוז " + esc(String(H.x[p.value[0]])) + ": " +
          Number(p.value[2]).toLocaleString("he-IL") + " מומחים";
      } },
      grid: { left: 8, right: 16, top: 8, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: H.x, splitArea: { show: true },
        axisLabel: { interval: 0, fontSize: 11, rotate: window.innerWidth < 500 ? 45 : 0 } },
      yAxis: { type: "category", data: H.y, inverse: true, splitArea: { show: true },
        axisLabel: { fontSize: 11, width: window.innerWidth < 500 ? 80 : 170, overflow: "truncate" } },
      visualMap: { min: 0, max: H.max, dimension: 2, calculable: true, orient: "horizontal", left: "center", bottom: 0,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] }, textStyle: { fontFamily: "Rubik", color: "#0c3058" } },
      series: [{ type: "heatmap", data: H.data, label: { show: true, fontFamily: "Rubik", fontSize: 10 },
        emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{% endif %}
