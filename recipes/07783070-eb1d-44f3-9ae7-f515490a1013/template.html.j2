<h1>{{ model.agent_data.seo.name }}</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור מומחה לפי שם, תחום התמחות או מחוז ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: שם המומחה, תחומי ההתמחות, מחוזות, השכלה, שפות, כתובת ופרטי קשר</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.experts.tone }} mb-1" dir="ltr">{{ model.kpis.experts.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.experts_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.families.tone }} mb-1" dir="ltr">{{ model.kpis.families.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.families_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.nationwide.tone }} mb-1" dir="ltr">{{ model.kpis.nationwide.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.nationwide_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.weakest.tone }} mb-1" dir="ltr">{{ model.kpis.weakest.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.weakest_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">מומחים לפי תחום התמחות</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.spec_note }}</p>
    <div id="chart-spec" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.spec_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.spec_aria }}</caption>
        <thead><tr><th scope="col">תחום</th><th scope="col">מומחים</th><th scope="col">מתוך כל המומחים</th></tr></thead>
        <tbody>
{%- for r in model.tables.spec %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/chart-bar.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">כמה תחומים לכל מומחה</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.nspec_note }}</p>
    <div id="chart-nspec" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.nspec_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.nspec_aria }}</caption>
        <thead><tr><th scope="col">מספר תחומים</th><th scope="col">מומחים</th></tr></thead>
        <tbody>
{%- for r in model.tables.nspec %}
          <tr><th scope="row" dir="ltr">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

