      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.streets_caption }}</caption>
        <thead><tr><th scope="col">רחוב</th><th scope="col">רישיונות</th></tr></thead>
        <tbody>
{%- for r in model.tables.streets %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
