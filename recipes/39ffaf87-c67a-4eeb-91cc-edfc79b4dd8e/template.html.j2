  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאורי הרישיון הנפוצים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.types_note }}</p>
    <div id="chart-types" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.types_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.types_caption }}</caption>
        <thead><tr><th scope="col">תיאור</th><th scope="col">רישיונות</th></tr></thead>
        <tbody>
{%- for r in model.tables.types %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">רחובות מול תחומי עיסוק</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.heat_note }}</p>
  <div id="chart-heat" data-fallback="explorer" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.heat_aria }}"></div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">סטטוס הרישיונות בכל תחום</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.ss_note }}</p>
  <div id="chart-sector-status" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.ss_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.ss_caption }}</caption>
      <thead><tr><th scope="col">תחום</th><th scope="col">רישיונות</th>{% for s in model.tables.status_cols %}<th scope="col">{{ s }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for r in model.tables.sector_status %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.n }}</td>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">עסקים עם הכי הרבה רישיונות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.biz_note }}</p>
  <div id="chart-businesses" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.biz_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.biz_caption }}</caption>
      <thead><tr><th scope="col">עסק</th><th scope="col">רישיונות</th></tr></thead>
      <tbody>
{%- for r in model.tables.businesses %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<script>
  (function () {
    function hbar(id, d, unit) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis" },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value" },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 130, overflow: "truncate" } },
        series: [{ type: "bar", name: unit, data: d.values }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    hbar("chart-sectors", {{ model.charts.sectors | tojson }}, "רישיונות");
    hbar("chart-streets", {{ model.charts.streets | tojson }}, "רישיונות");
    hbar("chart-types", {{ model.charts.types | tojson }}, "רישיונות");
    hbar("chart-businesses", {{ model.charts.businesses | tojson }}, "רישיונות");

    var st = {{ model.charts.status | tojson }};
    var c1 = echarts.init(document.getElementById("chart-status"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: "{b}: {c} ({d}%)" },
      legend: { bottom: 0 },
      series: [{ type: "pie", radius: ["45%", "70%"], center: ["50%", "45%"], name: "רישיונות",
                 data: st, label: { formatter: "{b}\n{d}%" } }]
    }));
    window.addEventListener("resize", function () { c1.resize(); });
  })();
</script>

<script>
  (function () {
    function stacked(id, d, yName, bottom) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis" },
        legend: { bottom: 0 },
        grid: { left: 40, right: 16, top: 24, bottom: bottom, containLabel: true },
        xAxis: { type: "category", data: d.x, axisLabel: { rotate: 45, interval: 0 } },
        yAxis: { type: "value", name: yName },
        series: d.series.map(function (s) { return { type: "bar", stack: "total", name: s.name, data: s.data }; })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    stacked("chart-expiry", {{ model.charts.expiry | tojson }}, "רישיונות", 72);
    var m = {{ model.charts.months | tojson }};
    var c2 = echarts.init(document.getElementById("chart-months"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 40, right: 16, top: 24, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: m.x, axisLabel: { rotate: 45, interval: 0 } },
      yAxis: { type: "value", name: "שינויים" },
      dataZoom: m.x.length > 18 ? [{ type: "inside" }] : [],
      series: m.series.map(function (s) { return { type: "bar", stack: "total", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    var h = {{ model.charts.heat | tojson }};
    var c = echarts.init(document.getElementById("chart-heat"));
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return echarts.format.encodeHTML(h.y[p.value[1]]) + " · " + echarts.format.encodeHTML(h.x[p.value[0]]) + ": " + p.value[2].toLocaleString("he-IL");
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true }, axisLabel: { interval: 0, rotate: 30 } },
      yAxis: { type: "category", data: h.y, inverse: true, splitArea: { show: true } },
      visualMap: {
        min: 0, max: h.max, dimension: 2, calculable: true,
        orient: "horizontal", left: "center", bottom: 8,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells,
                 label: { show: true, color: "#0c3058" },
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var s = {{ model.charts.sector_status | tojson }};
    var c2 = echarts.init(document.getElementById("chart-sector-status"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 56, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: s.names, inverse: true, axisLabel: { width: 130, overflow: "truncate" } },
      series: s.series.map(function (x) { return { type: "bar", stack: "total", name: x.name, data: x.data }; })
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>
