  <p class="m-0 mb-3 text-sm text-subtle leading-relaxed">{{ model.labels.network_lede }}</p>
  <div id="chart-network" class="h-72 md:h-96" role="img" data-fallback="explorer" aria-label="{{ model.labels.network_aria }}"></div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מפת תחנות השירות המטאורולוגי</h2>
