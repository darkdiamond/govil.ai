  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.elevation_aria }}</caption>
      <thead><tr><th scope="col">גובה (מ׳)</th><th scope="col">תחנות פעילות</th></tr></thead>
      <tbody>
{%- for r in model.charts.elevation.rows %}
        <tr><th scope="row">{{ r.label }}</th><td>{{ r.count | fmt_int }}</td></tr>
{%- endfor %}
      </tbody>
