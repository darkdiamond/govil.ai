<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">מאגר הנתונים הרשמי של השירות המטאורולוגי (שמ״ט) מוצג בזה לציבור, באמצעות פורטל השירותים והמידע הממשלתי (Data.Gov), מכיל מגוון נתונים מטאורולוגיים (טמפרטורה, לחות יחסית, לחץ, משקעים, רוח ועוד) מתחנות מדידה שפעלו ברחבי הארץ בתקופות שונות.
המאגר מורכב משני חלקים: ארכיון נתונים מטאורולוגיים ומאגר נתונים עשר דקתיים (תחנות אוטומטיות). הנתונים שבארכיון הנתונים המטאורולוגים עברו תהליכי בקרה. עם זאת, מתגלה מדי פעם צורך בעדכונים ובתיקונים נוספים.</p>
</section>

<script>
  window.__mkA6 = function (id) {
    var el = document.getElementById(id);
    if (!el || !window.echarts) { return null; }
    var c = echarts.getInstanceByDom(el) || echarts.init(el);
    window.addEventListener("resize", function () { c.resize(); });
    return c;
  };
</script>

{%- if model.charts.anomaly %}
<script>
  (function () {
    var d = {{ model.charts.anomaly | tojson }};
    var c = window.__mkA6("chart-anomaly");
    if (!c) { return; }
    var bars = d.max.map(function (v) {
      return { value: v, itemStyle: { color: v > 0 ? "#dc3545" : "#0068f5" } };
    });
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: {
        trigger: "axis",
        formatter: function (p) {
          var i = p[0].dataIndex;
          var f = function (v) { return (v > 0 ? "+" : "") + v.toFixed(2) + "°"; };
          return echarts.format.encodeHTML(d.x[i]) + (d.max[i] > 0 ? " (חמה מהנורמה)" : " (קרה מהנורמה)") +
            "<br>חריגת המקסימום: " + f(d.max[i]) +
            "<br>חריגת המינימום: " + f(d.min[i]) +
            "<br>תחנות: " + d.n[i];
        }
      },
      legend: { top: 0, data: ["חריגת טמפרטורת המקסימום", "חריגת טמפרטורת המינימום"] },
      grid: { left: 8, right: 16, top: 40, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: "{value}°" } },
      dataZoom: [{ type: "inside" }, { type: "slider", height: 18, bottom: 8 }],
      series: [
        { name: "חריגת טמפרטורת המקסימום", type: "bar", data: bars, itemStyle: { color: "#dc3545" } },
        { name: "חריגת טמפרטורת המינימום", type: "line", data: d.min, symbolSize: 4, itemStyle: { color: "#0b3668" }, lineStyle: { color: "#0b3668", width: 1.5 } }
      ]
    }));
  })();
</script>

