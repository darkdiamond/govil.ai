      <thead><tr><th scope="col">משרד</th><th scope="col">חקיקה ראשית</th><th scope="col">חקיקה משנית</th><th scope="col">סה״כ</th></tr></thead>
      <tbody>
{%- for r in model.tables.offices %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.primary | fmt_int }}</td><td>{{ r.secondary | fmt_int }}</td><td>{{ r.total | fmt_int }}</td></tr>
{%- endfor %}
