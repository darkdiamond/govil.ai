    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">סעיף 37 לחוק עקרונות האסדרה, התשפ״ב-2021 (להלן – החוק), קובע חובה לפרסם את כל האסדרה (רגולציה) במאגר אסדרה אחוד.
מאגר זה הוא הגרסה הראשונה למאגר האסדרה ומכיל חקיקה ראשית ותקנות רגולטוריות.

המאגר יתעדכן באופן עיתי.</p>
</section>

<script>
  (function () {
    var d = {{ model.charts.kind | tojson }};
    var c = echarts.init(document.getElementById("chart-kind"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 40, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: d.x, inverse: true },
      series: d.series.map(function (s) { return { type: "bar", stack: "all", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.offices | tojson }};
    var c = echarts.init(document.getElementById("chart-offices"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 40, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: d.x, inverse: true,
               axisLabel: { width: 130, overflow: "truncate" } },
      series: [
        { type: "bar", stack: "all", name: "חקיקה משנית", data: d.secondary },
        { type: "bar", stack: "all", name: "חקיקה ראשית", data: d.primary }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

