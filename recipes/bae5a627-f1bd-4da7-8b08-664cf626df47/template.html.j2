<h1>נציגויות זרות בישראל</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.missions.tone }} mb-1" dir="ltr">{{ model.kpis.missions.display }}</div>
    <div class="text-sm text-subtle">נציגויות</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.countries.tone }} mb-1" dir="ltr">{{ model.kpis.countries.display }}</div>
    <div class="text-sm text-subtle">מדינות מיוצגות</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.embassies.tone }} mb-1" dir="ltr">{{ model.kpis.embassies.display }}</div>
    <div class="text-sm text-subtle">שגרירויות תושבות</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.nonres.tone }} mb-1" dir="ltr">{{ model.kpis.nonres.display }}</div>
    <div class="text-sm text-subtle">שגרירויות לא תושבות (ללא משרד בישראל)</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">מעמד הנציגות</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">שגרירויות, קונסוליות ושגרירויות שאינן תושבות בישראל.</p>
    <div id="chart-status" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.status_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.status_aria }}</caption>
        <thead><tr><th scope="col">מעמד</th><th scope="col">נציגויות</th><th scope="col">שיעור (%)</th></tr></thead>
        <tbody>
{%- for r in model.tables.status %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">שלמות פרטי הקשר</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.contact_lede }}</p>
    <div id="chart-contact" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.contact_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.contact_aria }}</caption>
        <thead><tr><th scope="col">פרט</th><th scope="col">נציגויות</th><th scope="col">שיעור (%)</th></tr></thead>
        <tbody>
{%- for r in model.tables.contact %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">לפי אזור בעולם</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.region_note }}</p>
  <div id="chart-region" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.region_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.region_aria }}</caption>
      <thead><tr><th scope="col">אזור</th><th scope="col">מדינות</th><th scope="col">נציגויות</th>
{%- for s in model.tables.statuses %}<th scope="col">{{ s }}</th>{% endfor -%}
        <th scope="col">שגרירויות לא תושבות (%)</th></tr></thead>
      <tbody>
{%- for r in model.tables.region %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.countries }}</td><td>{{ r.total }}</td>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}<td>{{ r.nonres }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">עיר המושב</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.city_lede }}</p>
  <div id="chart-city" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.city_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.city_aria }}</caption>
      <thead><tr><th scope="col">עיר</th><th scope="col">סך הכול</th>
{%- for h in model.tables.city_heads %}<th scope="col">{{ h }}</th>{% endfor -%}
      </tr></thead>
      <tbody>
{%- for r in model.tables.city %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.total }}</td>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

{% if model.flags.jerusalem %}
<section id="table-jerusalem" class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">נציגויות בירושלים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.jerusalem_lede }}</p>
  <div class="overflow-x-auto">
  <table class="w-full text-sm">
    <caption class="sr-only">נציגויות זרות שמקום מושבן בירושלים</caption>
    <thead><tr><th scope="col">מדינה</th><th scope="col">מעמד</th><th scope="col">שם הנציגות</th></tr></thead>
    <tbody>
{%- for r in model.tables.jerusalem %}
      <tr><th scope="row">{{ r.country }}</th><td>{{ r.status }}</td><td>{{ r.name }}</td></tr>
{%- endfor %}
    </tbody>
  </table>
  </div>
</section>
{% endif %}

{% if model.flags.multi %}
<section id="table-multi" class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מדינות עם כמה נציגויות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.multi_lede }}</p>
  <div class="overflow-x-auto">
  <table class="w-full text-sm">
    <caption class="sr-only">מדינות עם יותר מנציגות אחת בישראל</caption>
    <thead><tr><th scope="col">מדינה</th><th scope="col">נציגויות</th><th scope="col">מעמד</th><th scope="col">ערים</th></tr></thead>
    <tbody>
{%- for r in model.tables.multi %}
      <tr><th scope="row">{{ r.country }}</th><td>{{ r.count }}</td><td>{{ r.kinds }}</td><td>{{ r.cities }}</td></tr>
{%- endfor %}
    </tbody>
  </table>
  </div>
</section>
{% endif %}

<script>
  (function () {
    var s = {{ model.charts.status | tojson }};
    var c1 = echarts.init(document.getElementById("chart-status"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 8, right: 32, top: 8, bottom: 24, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: s.names.slice().reverse(), axisLabel: { width: 120, overflow: "truncate" } },
      series: [{ type: "bar", name: "נציגויות", data: s.values.slice().reverse(),
                 label: { show: true, position: "right", fontFamily: "Rubik" } }]
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    var k = {{ model.charts.contact | tojson }};
    var c2 = echarts.init(document.getElementById("chart-contact"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                 formatter: function (p) { var i = p[0].dataIndex; return k.names[i] + ": " + k.values[i] + "% (" + k.counts[i] + ")"; } },
      grid: { left: 40, right: 16, top: 24, bottom: 32, containLabel: true },
      xAxis: { type: "category", data: k.names },
      yAxis: { type: "value", max: 100, name: "%" },
      series: [{ type: "bar", data: k.values, barMaxWidth: 64,
                 label: { show: true, position: "top", fontFamily: "Rubik", formatter: "{c}%" } }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    function stacked(id, d, cats) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { bottom: 0 },
        grid: { left: 8, right: 24, top: 8, bottom: 64, containLabel: true },
        xAxis: { type: "value" },
        yAxis: { type: "category", data: cats.slice().reverse(), axisLabel: { width: 110, overflow: "truncate" } },
        series: d.series.map(function (x) {
          return { type: "bar", stack: "t", name: x.name, data: x.data.slice().reverse() };
        })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    var r = {{ model.charts.region | tojson }};
    stacked("chart-region", r, r.regions);
    var t = {{ model.charts.city | tojson }};
    stacked("chart-city", t, t.names);
  })();
</script>
