{% if model.map %}
{%- for chunk in model.map.chunks %}
<script type="application/json" id="map-plans-{{ loop.index0 }}">{{ chunk | tojson }}</script>
{%- endfor %}
<script>
  (function () {
    var el = document.getElementById("map-main");
    if (!el || !window.L) { return; }
    var meta = {{ {"n": model.map.chunks | length, "origin": model.map.origin, "q": model.map.q, "statuses": model.map.statuses, "counts": model.map.counts, "view": model.map.view, "link": model.link_prefix} | tojson }};
    var colors = ["#0068f5", "#ffc107", "#dc3545", "#0dcaf0", "#198754"];
    var color = function (i) { return colors[i] || "#6c757d"; };
    var map = L.map(el, { scrollWheelZoom: false, zoomSnap: 0.25, preferCanvas: true });
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 19, attribution: "© OpenStreetMap" }).addTo(map);
    var renderer = L.canvas({ padding: 0.5 });
    var groups = meta.statuses.map(function () { return L.layerGroup().addTo(map); });
    var index = [];
    function decode(r) {
      var x = meta.origin[0] + r[0], y = meta.origin[1] + r[1], out = [[y / meta.q, x / meta.q]];
      for (var i = 2; i < r.length; i += 2) {
        x += r[i]; y += r[i + 1];
        out.push([y / meta.q, x / meta.q]);
      }
      return out;
    }
    function popup(f) {
      var box = document.createElement("div");
      var title = document.createElement("strong");
      title.textContent = "תכנית " + f[1];
      box.appendChild(title);
      var rows = [["סטטוס", meta.statuses[f[0]]]];
      if (f[3] >= 0) { rows.push(["שטח קטע הגבול", f[3].toLocaleString("he-IL") + " דונם"]); }
      if (f[2] >= 0) { rows.push(["מספר פנימי", String(f[2])]); }
      rows.forEach(function (row) {
        var d = document.createElement("div");
        d.textContent = row[0] + ": " + row[1];
        box.appendChild(d);
      });
      if (meta.link && f[2] >= 0) {
        var a = document.createElement("a");
        a.href = meta.link + String(f[2]);
        a.target = "_blank";
        a.rel = "noopener";
        a.textContent = "פתיחת התכנית במערכת ההנדסית של העירייה";
        box.appendChild(a);
      }
      return box;
    }
    for (var c = 0; c < meta.n; c++) {
      var node = document.getElementById("map-plans-" + c);
      if (!node) { continue; }
      JSON.parse(node.textContent).forEach(function (f) {
        var main = f[0] === 0, wide = f[5] === 1;
        var poly = L.polygon(f[4].map(decode), wide ? {
          renderer: renderer, color: color(f[0]), weight: 1.5, opacity: 0.8,
          dashArray: "6 4", fill: false
        } : {
          renderer: renderer, color: color(f[0]), weight: main ? 1 : 1.5,
          opacity: 0.9, fillOpacity: main ? 0.15 : 0.25
        });
        poly.bindPopup(function () { return popup(f); });
        poly.addTo(groups[f[0]]);
        index.push([f[1], poly, f[0]]);
      });
    }
    map.fitBounds(meta.view, { padding: [8, 8] });
    var legend = document.getElementById("map-legend");
    meta.statuses.forEach(function (s, i) {
      if (!meta.counts[i]) { return; }
      var li = document.createElement("li");
      var lab = document.createElement("label");
      lab.className = "flex items-center gap-2 cursor-pointer";
      var cb = document.createElement("input");
      cb.type = "checkbox";
      cb.checked = true;
      cb.addEventListener("change", function () {
        if (cb.checked) { groups[i].addTo(map); } else { map.removeLayer(groups[i]); }
      });
      var sw = document.createElement("span");
      sw.style.cssText = "display:inline-block;width:14px;height:14px;border-radius:2px;border:2px solid " + color(i) + ";background:" + color(i) + "55";
      lab.appendChild(cb);
      lab.appendChild(sw);
      lab.appendChild(document.createTextNode(s + " (" + meta.counts[i].toLocaleString("he-IL") + ")"));
      li.appendChild(lab);
      legend.appendChild(li);
    });
    var msg = document.getElementById("map-search-msg");
    var input = document.getElementById("map-search-q");
    function search() {
      var q = input.value.trim();
      msg.textContent = "";
      if (!q) { return; }
      var hits = index.filter(function (h) { return h[0] === q; });
      if (!hits.length) { hits = index.filter(function (h) { return h[0].indexOf(q) !== -1; }); }
      if (!hits.length) { msg.textContent = "לא נמצאה תכנית במספר הזה במפה."; return; }
      var plan = hits[0][0];
      hits = hits.filter(function (h) { return h[0] === plan; });
      var b = hits[0][1].getBounds();
      hits.forEach(function (h) {
        if (!map.hasLayer(groups[h[2]])) { groups[h[2]].addTo(map); }
        b.extend(h[1].getBounds());
      });
      legend.querySelectorAll("input").forEach(function (cb) { cb.checked = true; });
      meta.statuses.forEach(function (s, i) { if (!map.hasLayer(groups[i])) { groups[i].addTo(map); } });
      map.fitBounds(b, { padding: [24, 24], maxZoom: 17 });
      hits[0][1].openPopup(b.getCenter());
      msg.textContent = "תכנית " + plan;
    }
    document.getElementById("map-search-go").addEventListener("click", search);
    input.addEventListener("keydown", function (e) { if (e.key === "Enter") { e.preventDefault(); search(); } });
  })();
</script>
{% endif %}

<script>
  (function () {
    function hbar(id, d, name) {
      var el = document.getElementById(id);
      if (!el) { return; }
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value" },
        yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 150, overflow: "truncate" } },
        series: [{ type: "bar", name: name, data: d.values.slice().reverse() }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    hbar("chart-area", {{ model.charts.area | tojson }}, "תכניות");
    hbar("chart-famarea", {{ model.charts.famarea | tojson }}, "מ״ר");
    hbar("chart-top", {{ model.charts.top | tojson }}, "ק״מ רבועים");
    hbar("chart-parts", {{ model.charts.parts | tojson }}, "תכניות");
    hbar("chart-compact", {{ model.charts.compact | tojson }}, "קטעים");
    hbar("chart-lat", {{ model.charts.lat | tojson }}, "קטעים");
    hbar("chart-lon", {{ model.charts.lon | tojson }}, "קטעים");
  })();
</script>

<script>
  (function () {
    function stacked(id, names, series, colors) {
      var el = document.getElementById(id);
      if (!el) { return; }
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option({
        color: colors,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { bottom: 0 },
        grid: { left: 8, right: 24, top: 8, bottom: 40, containLabel: true },
        xAxis: { type: "value" },
        yAxis: { type: "category", data: names.slice().reverse(), axisLabel: { width: 150, overflow: "truncate" } },
        series: series.map(function (s) {
          return { type: "bar", stack: "t", name: s.name, data: s.values.slice().reverse() };
        })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    var f = {{ model.charts.family | tojson }};
    stacked("chart-family", f.names, f.series, window.GOVIL_PALETTE);
    var r = {{ model.charts.regno | tojson }};
    stacked("chart-regno", r.names, [{ name: "בתוקף", values: r.force }, { name: "אחרות", values: r.rest }],
      [window.GOVIL_PALETTE[0], "#ffc107"]);
  })();
</script>
