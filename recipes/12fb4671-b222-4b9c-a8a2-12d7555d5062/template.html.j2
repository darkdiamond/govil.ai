{% if model.has_geo %}
<script>
  GovMap.create({
    container: "#map-main",
    resourceId: {{ inputs.plans[0].id | tojson }},
    latField: "lat",
    lngField: "lon",
    projection: "wgs84",
    popupTitleField: "Plan",
    popupFields: ["status"]
  });
</script>
