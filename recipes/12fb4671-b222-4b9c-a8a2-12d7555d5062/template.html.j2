<script>
  (function () {
    function hbar(id, d, name) {
      var el = document.getElementById(id);
      if (!el) { return; }
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value" },
        yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 150, overflow: "truncate" } },
        series: [{ type: "bar", name: name, data: d.values.slice().reverse() }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    hbar("chart-area", {{ model.charts.area | tojson }}, "תכניות");
    hbar("chart-famarea", {{ model.charts.famarea | tojson }}, "מ״ר");
    hbar("chart-top", {{ model.charts.top | tojson }}, "ק״מ רבועים");
    hbar("chart-parts", {{ model.charts.parts | tojson }}, "תכניות");
    hbar("chart-compact", {{ model.charts.compact | tojson }}, "קטעים");
    hbar("chart-lat", {{ model.charts.lat | tojson }}, "קטעים");
    hbar("chart-lon", {{ model.charts.lon | tojson }}, "קטעים");
  })();
</script>

<script>
  (function () {
    function stacked(id, names, series, colors) {
      var el = document.getElementById(id);
      if (!el) { return; }
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option({
        color: colors,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { bottom: 0 },
        grid: { left: 8, right: 24, top: 8, bottom: 40, containLabel: true },
        xAxis: { type: "value" },
        yAxis: { type: "category", data: names.slice().reverse(), axisLabel: { width: 150, overflow: "truncate" } },
        series: series.map(function (s) {
          return { type: "bar", stack: "t", name: s.name, data: s.values.slice().reverse() };
        })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    var f = {{ model.charts.family | tojson }};
    stacked("chart-family", f.names, f.series, window.GOVIL_PALETTE);
    var r = {{ model.charts.regno | tojson }};
    stacked("chart-regno", r.names, [{ name: "בתוקף", values: r.force }, { name: "אחרות", values: r.rest }],
      [window.GOVIL_PALETTE[0], "#ffc107"]);
  })();
</script>
