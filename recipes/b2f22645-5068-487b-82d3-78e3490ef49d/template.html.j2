<h1>מס הבלו על הדלק: שיעורי הבלו על בנזין, סולר, גפ"מ ומזוט</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }} הבלו הוא מס קבוע לכל ליטר או טון, ונגבה בנוסף למע"מ, ולכן הוא רכיב מרכזי במחיר הדלק בתחנה.</p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["gas", "gas_last", "die", "die_year", "lpg", "span"] %}
{%- if model.kpis[key] is defined %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.labels[key ~ "_kpi"] }}</div>
  </div>
{%- endif %}
{%- endfor %}
</div>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">בדיקת שיעור הבלו לפי תאריך ומוצר ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: תאריך, מוצר, יחידות ושיעור הבלו בשקלים.</span>
  </span>
</a>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

{%- if model.flags.cur_liter or model.flags.cur_other %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">כמה בלו משלמים היום על כל מוצר</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">השיעור העדכני של כל מוצר פעיל במאגר. מוצרים נוזליים בשקלים לליטר, גפ"מ ומזוט בשקלים לטון.</p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
{%- if model.flags.cur_liter %}
    <div>
      <h3 class="m-0 mb-2 text-base font-semibold text-ink-deep">בשקלים לליטר</h3>
      <div id="chart-current-liter" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.current_aria }}"></div>
    </div>
{%- endif %}
{%- if model.flags.cur_other %}
    <div>
      <h3 class="m-0 mb-2 text-base font-semibold text-ink-deep">בשקלים לטון</h3>
      <div id="chart-current-ton" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.current_other_aria }}"></div>
    </div>
{%- endif %}
  </div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">שיעור הבלו הנוכחי לפי מוצר</caption>
      <thead><tr><th scope="col">מוצר</th><th scope="col">שיעור הבלו</th><th scope="col">יחידה</th><th scope="col">בתוקף מאז העדכון של</th></tr></thead>
      <tbody>
{%- for r in model.tables.current %}
        <tr><th scope="row">{{ r.name }}</th><td dir="ltr">{{ r.display }}</td><td>{{ r.unit }}</td><td>{{ r.date }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>
{%- endif %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">הבלו על ליטר דלק לאורך השנים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.liter_note }}</p>
  <div id="chart-liter" class="h-72 md:h-96" role="img" data-fallback="explorer" aria-label="{{ model.labels.liter_aria }}"></div>
</section>

{%- if model.flags.gap %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ model.labels.gap_title }}</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.gap_note }}</p>
  <div id="chart-gap" class="h-64 md:h-80" role="img" data-fallback="explorer" aria-label="{{ model.labels.gap_aria }}"></div>
</section>
{%- endif %}

{%- if model.flags.events %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ model.labels.events_title }}</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.events_note }}</p>
  <div id="chart-events" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.events_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה (השינויים הגדולים ביותר)</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.events_caption }}</caption>
      <thead><tr><th scope="col">תאריך</th><th scope="col">שיעור קודם (₪ לליטר)</th><th scope="col">שיעור חדש (₪ לליטר)</th><th scope="col">שינוי</th></tr></thead>
      <tbody>
{%- for r in model.tables.biggest %}
        <tr><th scope="row">{{ r.date }}</th><td dir="ltr">{{ r.old }}</td><td dir="ltr">{{ r.new }}</td><td dir="ltr" class="{{ 'text-ok' if r.down else 'text-ink' }}">{{ r.pct }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{%- endif %}

{%- if model.flags.per_year %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">כמה פעמים בשנה משתנה הבלו</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.per_year_note }}</p>
  <div id="chart-per-year" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.per_year_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.per_year_aria }}</caption>
      <thead><tr><th scope="col">שנה</th>{% if model.flags.gas %}<th scope="col">{{ model.names.gas }}</th>{% endif %}{% if model.flags.die %}<th scope="col">{{ model.names.die }}</th>{% endif %}</tr></thead>
      <tbody>
{%- for r in model.tables.per_year %}
        <tr><th scope="row">{{ r.year }}</th>{% if model.flags.gas %}<td>{{ r.gas }}</td>{% endif %}{% if model.flags.die %}<td>{{ r.die }}</td>{% endif %}</tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{%- endif %}

{%- if model.flags.heat %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">השינוי השנתי בבלו לפי מוצר</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.heat_note }}</p>
  <div class="overflow-x-auto">
    <div id="chart-heat" class="h-80 md:h-[460px] min-w-[640px]" role="img" data-fallback="explorer" aria-label="{{ model.labels.heat_aria }}"></div>
  </div>
</section>
{%- endif %}

{%- if model.flags.cum %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">השינוי המצטבר מאז תחילת הנתונים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cum_note }}</p>
  <div id="chart-cum" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.cum_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.cum_aria }}</caption>
      <thead><tr><th scope="col">מוצר</th><th scope="col">מאז</th><th scope="col">שיעור ראשון</th><th scope="col">שיעור נוכחי</th><th scope="col">יחידה</th><th scope="col">שינוי</th></tr></thead>
      <tbody>
{%- for r in model.tables.cum %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.since }}</td><td dir="ltr">{{ r.from }}</td><td dir="ltr">{{ r.to }}</td><td>{{ r.unit }}</td><td dir="ltr">{{ r.pct }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>
{%- endif %}

{%- if model.flags.ton %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">הבלו על גפ"מ ומזוט לאורך השנים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.ton_note }}</p>
  <div id="chart-ton" class="h-72 md:h-96" role="img" data-fallback="explorer" aria-label="{{ model.labels.ton_aria }}"></div>
</section>
{%- endif %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">בלו הוא מס עקיף המוטל על רכישת מוצרים מייצור מקומי, כגון מוצרי טבק, אלכוהול ודלק. שיעורי הבלו על מוצרי הדלק השונים נקבעים על ידי אגף המכס והמע"מ במשרד האוצר, ומתעדכנים בצו.</p>
</section>

<script>
  (function () {
    function fmt(v, d) { return Number(v).toLocaleString("he-IL", { minimumFractionDigits: d, maximumFractionDigits: d }); }
    function dmy(s) { var p = s.split("-"); return p[2] + "." + p[1] + "." + p[0]; }
    function stepChart(id, d, unit, digits, log) {
      var el = document.getElementById(id);
      if (!el) return;
      var chart = echarts.init(el);
      chart.setOption(window.GovEcharts.option({
        tooltip: { trigger: "axis", formatter: function (ps) {
          if (!ps.length) return "";
          var out = dmy(ps[0].value[0]);
          ps.forEach(function (p) { out += "<br/>" + p.marker + echarts.format.encodeHTML(p.seriesName) + ": " + fmt(p.value[1], digits) + " " + unit; });
          return out;
        } },
        legend: { type: "scroll", top: 0 },
        grid: { left: 16, right: 24, top: 48, bottom: 64, containLabel: true },
        xAxis: { type: "time" },
        yAxis: log ? { type: "log", logBase: 10, name: unit } : { type: "value", scale: true, name: unit },
        dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 20 }],
        series: d.series.map(function (s) { return { name: s.name, type: "line", step: "end", showSymbol: false, data: s.data }; })
      }));
      window.addEventListener("resize", function () { chart.resize(); });
    }
    stepChart("chart-liter", {{ model.charts.liter | tojson }}, "₪ לליטר", 2, false);
    var ton = {{ model.charts.ton | tojson }};
    stepChart("chart-ton", ton, ton.unit, 2, ton.log);
  })();
  (function () {
    function barH(id, d, unit) {
      var el = document.getElementById(id);
      if (!el) return;
      var chart = echarts.init(el);
      chart.setOption(window.GovEcharts.option({
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
          return echarts.format.encodeHTML(ps[0].name) + ": " + Number(ps[0].value).toLocaleString("he-IL", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " " + unit;
        } },
        grid: { left: 16, right: 56, top: 8, bottom: 8, containLabel: true },
        xAxis: { type: "value", show: false },
        yAxis: { type: "category", data: d.names.slice().reverse(), inverse: false },
        series: [{ type: "bar", data: d.values.slice().reverse(), barMaxWidth: 26,
          label: { show: true, position: "right", formatter: function (p) { return Number(p.value).toLocaleString("he-IL", { minimumFractionDigits: 2, maximumFractionDigits: 2 }); } } }]
      }));
      window.addEventListener("resize", function () { chart.resize(); });
    }
    barH("chart-current-liter", {{ model.charts.current_liter | tojson }}, "₪ לליטר");
    barH("chart-current-ton", {{ model.charts.current_other | tojson }}, "₪ לטון");
  })();
  (function () {
    var el = document.getElementById("chart-gap");
    if (!el) return;
    var d = {{ model.charts.gap | tojson }};
    var chart = echarts.init(el);
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", formatter: function (ps) {
        var v = ps[0].value;
        return v[0].split("-").reverse().join(".") + "<br/>פער: " + Number(v[1]).toLocaleString("he-IL", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " ₪ לליטר";
      } },
      grid: { left: 16, right: 24, top: 24, bottom: 64, containLabel: true },
      xAxis: { type: "time" },
      yAxis: { type: "value", name: "₪ לליטר" },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 20 }],
      series: [{ type: "line", step: "end", showSymbol: false, data: d.data, areaStyle: { opacity: 0.15 },
        markLine: { symbol: "none", silent: true, label: { show: false }, lineStyle: { color: "#6c757d", type: "dashed" }, data: [{ yAxis: 0 }] } }]
    }));
    window.addEventListener("resize", function () { chart.resize(); });
  })();
  (function () {
    var el = document.getElementById("chart-events");
    if (!el) return;
    var d = {{ model.charts.events | tojson }};
    var chart = echarts.init(el);
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "item", formatter: function (p) {
        var r = p.data.raw;
        var dir = r[1] < 0 ? "הפחתה" : "העלאה";
        return r[2] + "<br/>" + dir + ": " + (r[1] > 0 ? "+" : "") + r[1].toFixed(1) + "%<br/>" + r[3].toFixed(2) + " ← " + r[4].toFixed(2) + " ₪ לליטר";
      } },
      grid: { left: 16, right: 24, top: 24, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.data.map(function (r) { return r[2]; }), axisLabel: { hideOverlap: true } },
      yAxis: { type: "value", name: "%" },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 20 }],
      series: [{ type: "bar", data: d.data.map(function (r) {
        return { value: r[1], raw: r, itemStyle: r[1] < 0 ? { color: "#198754" } : undefined };
      }) }]
    }));
    window.addEventListener("resize", function () { chart.resize(); });
  })();
  (function () {
    var el = document.getElementById("chart-per-year");
    if (!el) return;
    var d = {{ model.charts.per_year | tojson }};
    var series = [];
    if (d.gas_name) series.push({ name: d.gas_name, type: "bar", data: d.gas });
    if (d.die_name) series.push({ name: d.die_name, type: "bar", data: d.die });
    var chart = echarts.init(el);
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.years },
      yAxis: { type: "value", minInterval: 1, name: "שינויים" },
      series: series
    }));
    window.addEventListener("resize", function () { chart.resize(); });
  })();
  (function () {
    var el = document.getElementById("chart-heat");
    if (!el) return;
    var d = {{ model.charts.heat | tojson }};
    var chart = echarts.init(el);
    chart.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        var v = p.data[3];
        return echarts.format.encodeHTML(d.products[p.data[1]]) + ", " + echarts.format.encodeHTML(d.years[p.data[0]]) + ": " + (v > 0 ? "+" : "") + v.toFixed(1) + "%";
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.years, splitArea: { show: true } },
      yAxis: { type: "category", data: d.products, splitArea: { show: true } },
      visualMap: { min: -d.cap, max: d.cap, dimension: 2, calculable: false, orient: "horizontal", left: "center", bottom: 8,
        inRange: { color: ["#0068f5", "#f1f7ff", "#dc3545"] }, textStyle: { fontFamily: "Rubik", color: "#0c3058" } },
      series: [{ type: "heatmap", data: d.cells,
        label: { show: true, fontFamily: "Rubik", fontSize: 9, formatter: function (p) { var v = p.data[3]; return (v > 0 ? "+" : "") + v.toFixed(1) + "%"; } },
        emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { chart.resize(); });
  })();
  (function () {
    var el = document.getElementById("chart-cum");
    if (!el) return;
    var d = {{ model.charts.cum | tojson }};
    var chart = echarts.init(el);
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex; var n = d.names.length - 1 - i;
        var v = d.values[n];
        return echarts.format.encodeHTML(d.names[n]) + "<br/>מאז " + d.since[n] + ": " + (v > 0 ? "+" : "") + v.toFixed(1) + "%";
      } },
      grid: { left: 16, right: 56, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", show: false },
      yAxis: { type: "category", data: d.names.slice().reverse() },
      series: [{ type: "bar", barMaxWidth: 26, data: d.values.slice().reverse().map(function (v) {
          return { value: v, itemStyle: v < 0 ? { color: "#198754" } : undefined };
        }),
        label: { show: true, position: "right", formatter: function (p) { return (p.value > 0 ? "+" : "") + p.value.toFixed(1) + "%"; } } }]
    }));
    window.addEventListener("resize", function () { chart.resize(); });
  })();
</script>
