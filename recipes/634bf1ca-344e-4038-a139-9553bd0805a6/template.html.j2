<h1>רשימת משרדי חקירות: חוקרים פרטיים בעלי רישיון</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">בדיקת רישיון חוקר פרטי לפי שם או מספר רישיון ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: מספר רישיון, שם פרטי ושם משפחה.</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">בעלי רישיון ברשימה</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.surnames.tone }} mb-1" dir="ltr">{{ model.kpis.surnames.display }}</div>
    <div class="text-sm text-subtle">שמות משפחה שונים</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.compound.tone }} mb-1" dir="ltr">{{ model.kpis.compound.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.compound_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.largest_block.tone }} mb-1" dir="ltr">{{ model.kpis.largest_block.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.largest_block_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">סדרות מספור הרישיונות</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.series_note }}</p>
    <div id="chart-series" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.series_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.series_aria }}</caption>
        <thead><tr><th scope="col">אורך המספר</th><th scope="col">רישיונות</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.series %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">מבנה השמות</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.structure_note }}</p>
    <div id="chart-structure" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.structure_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.structure_aria }}</caption>
        <thead><tr><th scope="col">מבנה</th><th scope="col">בעלי רישיון</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.structure %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">רישיונות לפי גוש מספור</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.blocks_note }}</p>
  <div id="chart-blocks" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.blocks_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.blocks_aria }}</caption>
      <thead><tr><th scope="col">גוש מספור</th><th scope="col">רישיונות</th></tr></thead>
      <tbody>
{%- for r in model.tables.blocks %}
        <tr><th scope="row" dir="ltr">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">שמות המשפחה הנפוצים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.surnames_note }}</p>
    <div id="chart-surnames" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.surnames_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.surnames_aria }}</caption>
        <thead><tr><th scope="col">שם משפחה</th><th scope="col">בעלי רישיון</th></tr></thead>
        <tbody>
{%- for r in model.tables.surnames %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">השמות הפרטיים הנפוצים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.firsts_note }}</p>
    <div id="chart-firsts" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.firsts_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.firsts_aria }}</caption>
        <thead><tr><th scope="col">שם פרטי</th><th scope="col">בעלי רישיון</th></tr></thead>
        <tbody>
{%- for r in model.tables.firsts %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">פיזור שמות המשפחה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.freq_note }}</p>
  <div id="chart-freq" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.freq_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.freq_aria }}</caption>
      <thead><tr><th scope="col">מופעים ברשימה</th><th scope="col">שמות משפחה</th><th scope="col">בעלי רישיון</th></tr></thead>
      <tbody>
{%- for r in model.tables.freq %}
        <tr><th scope="row" dir="ltr">{{ r.name }}</th><td>{{ r.names }}</td><td>{{ r.people }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">רשימת משרדי חקירות</p>
</section>

<script>
  (function () {
    var d = {{ model.charts.series | tojson }};
    var c = echarts.init(document.getElementById("chart-series"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item" },
      legend: { bottom: 0 },
      series: [{ type: "pie", name: "רישיונות", radius: ["42%", "68%"], center: ["50%", "44%"],
                 label: { show: true, formatter: "{d}%" },
                 data: d.names.map(function (nm, i) { return { name: nm, value: d.values[i] }; }) }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.structure | tojson }};
    var c = echarts.init(document.getElementById("chart-structure"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", minInterval: 1, splitNumber: 4 },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [{ type: "bar", name: "בעלי רישיון", data: d.values, label: { show: true, position: "insideStart", color: "#fff" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.blocks | tojson }};
    var c = echarts.init(document.getElementById("chart-blocks"));
    var seriesKeys = [];
    d.series.forEach(function (s) { if (seriesKeys.indexOf(s) < 0) { seriesKeys.push(s); } });
    var pal = window.GOVIL_PALETTE;
    c.setOption(window.GovEcharts.option({
      color: pal,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 16, top: 24, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: { rotate: 45, fontSize: 10 } },
      yAxis: { type: "value", name: "רישיונות", minInterval: 1 },
      series: [{ type: "bar", name: "רישיונות",
                 data: d.values.map(function (v, i) {
                   return { value: v, itemStyle: { color: pal[(seriesKeys.indexOf(d.series[i]) * 3) % pal.length] } };
                 }) }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    function hbar(id, d) {
      var x = echarts.init(document.getElementById(id));
      x.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 4, minInterval: 1 },
        yAxis: { type: "category", data: d.names, inverse: true },
        series: [{ type: "bar", name: "בעלי רישיון", data: d.values }]
      }));
      window.addEventListener("resize", function () { x.resize(); });
    }
    hbar("chart-surnames", {{ model.charts.surnames | tojson }});
    hbar("chart-firsts", {{ model.charts.firsts | tojson }});
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.freq | tojson }};
    var c = echarts.init(document.getElementById("chart-freq"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 32, containLabel: true },
      xAxis: { type: "category", data: d.names, name: "מופעים" },
      yAxis: { type: "value", minInterval: 1 },
      series: [
        { type: "bar", name: "שמות משפחה", data: d.names_count },
        { type: "bar", name: "בעלי רישיון", data: d.people }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
