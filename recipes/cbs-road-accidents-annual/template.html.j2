{% import "gov.j2" as gov %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסמה {{ model.release.date }}</p>
{%- if model.release.headline %}
  <p class="m-0 mb-3 font-semibold text-ink-deep">{{ model.release.headline }}</p>
{%- endif %}
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["killed", "killed_chg", "srate", "sshare", "intl"] %}
{%- if model.kpis[key] is defined %}
  {{ gov.kpi(model.kpis[key], model.labels[key ~ "_kpi"]) }}
{%- endif %}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

<section class="card p-5 mb-6">
  {{ gov.head("database", "הרוגים בתאונות דרכים לפי שנה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.killed_note }}</p>
  {{ gov.chart("chart-killed", model.labels.killed_aria, "h-72 md:h-96") }}
  {{ gov.table("הרוגים בתאונות דרכים לפי שנה", ["שנה", "הרוגים"], model.tables.killed, ltr=(1,)) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("calendar", "ממוצע ההרוגים בשנה, לפי עשור") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.decades_note }} {{ model.labels.total_since }}</p>
  {{ gov.chart("chart-decades", model.labels.decades_aria, "h-64 md:h-80") }}
  {{ gov.table("הרוגים בתאונות דרכים לפי עשור", ["עשור", "ממוצע לשנה", "סך הכול", "שנים בנתונים"], model.tables.decades, ltr=(0, 1, 2, 3)) }}
</section>

{%- if model.flags.srate %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "הרוגים ופצועים קשה לכל 100,000 תושבים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.srate_note }}</p>
  {{ gov.chart("chart-srate", model.labels.srate_aria, "h-64 md:h-80") }}
  {{ gov.table("נפגעים באופן חמור לכל 100,000 תושבים לפי שנה", ["שנה", "לכל 100,000 תושבים"], model.tables.srate, ltr=(1,)) }}
</section>
{%- endif %}

{%- if model.flags.sshare %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "כמה מהתאונות חמורות") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.sshare_note }}</p>
  {{ gov.chart("chart-sshare", model.labels.sshare_aria, "h-64 md:h-80") }}
  {{ gov.table("אחוז התאונות החמורות מכלל התאונות עם נפגעים", ["שנה", "תאונות חמורות"], model.tables.sshare, ltr=(1,)) }}
</section>
{%- endif %}

{%- if model.flags.intl %}
<section class="card p-5 mb-6">
  {{ gov.head("list", model.labels.intl_title) }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.intl_note }}</p>
  {{ gov.chart("chart-intl", model.labels.intl_aria, "h-[640px]") }}
  {{ gov.table(model.labels.intl_aria, model.labels.intl_cols, model.tables.intl, ltr=range(1, model.labels.intl_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.peds %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "הולכי רגל שנפגעו בחציית כביש") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.peds_note }}</p>
  {{ gov.chart("chart-peds", model.labels.peds_aria, "h-64 md:h-72") }}
  {{ gov.table(model.labels.peds_aria, ["חומרת הפגיעה", "במעבר חצייה", "לא במעבר חצייה"], model.tables.peds, ltr=(1, 2)) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>הנתונים מתוך ההודעה השנתית לתקשורת של הלשכה המרכזית לסטטיסטיקה על תאונות דרכים עם נפגעים (נתונים סופיים), המבוססת על דיווחי משטרת ישראל. הרוג הוא מי שמת בתוך 30 יום מהתאונה.</li>
    <li>תאונה חמורה היא תאונה קטלנית או קשה. נפגע באופן חמור הוא הרוג או פצוע קשה.</li>
    <li>לנתונים החודשיים והארעיים של השנה השוטפת יש עמוד נפרד: "תאונות דרכים עם נפגעים לפי חודש".</li>
    <li>התרשימים בהודעה משתנים משנה לשנה. העמוד מציג את התרשימים שמופיעים בהודעה האחרונה, ונתוני שנים קודמות בה עשויים להיות מעודכנים לעומת הודעות קודמות.</li>
  </ul>
</section>

<script>
  (function () {
    const d = {{ model.charts.killed | tojson }};
    const peak = {{ model.labels.peak_year | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-killed"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") + " הרוגים" },
      grid: { left: 16, right: 16, top: 24, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", min: 0 },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 20 }],
      series: [{
        type: "line", name: "הרוגים", data: d.y, showSymbol: false, lineStyle: { width: 3 },
        areaStyle: { opacity: 0.12 },
        markPoint: { symbolSize: 44, data: [
          { coord: [peak, d.y[d.x.indexOf(peak)]], value: d.y[d.x.indexOf(peak)] },
          { coord: [d.x[d.x.length - 1], d.y[d.y.length - 1]], value: d.y[d.y.length - 1] }
        ] }
      }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.decades | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-decades"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") + " הרוגים בשנה בממוצע" },
      grid: { left: 16, right: 16, top: 32, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { interval: 0, rotate: 30 } },
      yAxis: { type: "value", min: 0 },
      series: [{
        type: "bar", name: "ממוצע לשנה",
        data: d.y.map((v, i) => d.years[i] < 10 ? { value: v, itemStyle: { color: pal[6] } } : v),
        label: { show: true, position: "top", formatter: (p) => Number(p.value).toLocaleString("he-IL") }
      }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- if model.flags.srate %}
  (function () {
    const d = {{ model.charts.srate | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-srate"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[3]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + " לכל 100,000 תושבים" },
      grid: { left: 16, right: 16, top: 32, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", min: 0 },
      series: [{ type: "line", name: "נפגעים באופן חמור", data: d.y, lineStyle: { width: 3 },
        label: { show: true, position: "top", formatter: (p) => Number(p.value).toFixed(1) } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.sshare %}
  (function () {
    const d = {{ model.charts.sshare | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-sshare"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[2]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      grid: { left: 16, right: 16, top: 32, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", min: 0, axisLabel: { formatter: "{value}%" } },
      series: [{ type: "bar", name: "תאונות חמורות", data: d.y,
        label: { show: true, position: "top", formatter: (p) => Number(p.value).toFixed(1) + "%" } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.intl %}
  (function () {
    const d = {{ model.charts.intl | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-intl"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[6]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) },
      grid: { left: 16, right: 40, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: false }, splitLine: { show: false } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 100, overflow: "truncate" } },
      series: [{
        type: "bar",
        data: d.values.map((v, i) => d.names[i] === d.israel ? { value: v, itemStyle: { color: pal[0] } } : v),
        label: { show: true, position: "right", formatter: (p) => Number(p.value).toFixed(1) }
      }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.peds %}
  (function () {
    const d = {{ model.charts.peds | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-peds"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[6]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 8, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.cats, inverse: true },
      series: [
        { type: "bar", stack: "a", name: "במעבר חצייה", data: d.inside, label: { show: true, formatter: (p) => Number(p.value).toFixed(0) + "%" } },
        { type: "bar", stack: "a", name: "לא במעבר חצייה", data: d.outside, label: { show: true, formatter: (p) => Number(p.value).toFixed(0) + "%" } }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
</script>
