{% import "gov.j2" as gov %}
{%- macro callout(key) -%}
{%- if model.callouts[key] is defined %}
  <p class="m-0 mb-3 text-sm font-semibold text-ink-deep">{{ model.callouts[key] }}</p>
{%- endif %}
{%- endmacro %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסמה {{ model.release.date }}</p>
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["holders", "yoy", "per1000", "women"] %}
{%- if model.kpis[key] is defined %}
  {{ gov.kpi(model.kpis[key], model.labels[key ~ "_kpi"]) }}
{%- endif %}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

<section class="card p-5 mb-6">
  {{ gov.head("database", "מורשים לנהוג, כלי רכב ואוכלוסייה לאורך השנים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.trend_note }}</p>
  {{ callout("growth") }}{{ callout("faster") }}
  {{ gov.chart("chart-trend", model.labels.trend_aria, "h-72 md:h-96") }}
  {{ gov.table("מורשים לנהוג, כלי רכב מנועיים ואוכלוסייה לפי שנה", ["שנה", "מורשים לנהוג", "אוכלוסייה קבועה", "כלי רכב מנועיים"], model.tables.trend, ltr=(1, 2, 3)) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("database", "מורשים לנהוג לכל 1,000 תושבים וגידול שנתי") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.ratio_note }}</p>
  {{ callout("per1000") }}{{ callout("net") }}
  {{ gov.chart("chart-ratio", model.labels.ratio_aria, "h-72 md:h-96") }}
  {{ gov.table("מורשים לנהוג לכל 1,000 תושבים וגידול נטו לפי שנה", ["שנה", "לכל 1,000 תושבים", "גידול נטו"], model.tables.ratio, ltr=(1, 2)) }}
</section>

{%- if model.flags.sex %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "גברים ונשים בעלי רישיון נהיגה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.sex_note }}</p>
  {{ callout("women") }}
  {{ gov.chart("chart-sex", model.labels.sex_aria, "h-72 md:h-80") }}
  {{ gov.table("מורשים לנהוג לפי מין ושנה", ["שנה", "גברים", "נשים", "חלק הנשים"], model.tables.sex, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

{%- if model.flags.rate %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "מי מחזיק ברישיון: לפי מין, גיל וקבוצת אוכלוסייה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.rate_note }}</p>
  {{ callout("rate_sex") }}{{ callout("rate_age") }}{{ callout("rate_pop") }}
  {{ gov.chart("chart-rate", model.labels.rate_aria, "h-[440px]") }}
  {{ gov.table("אחוז המורשים לנהוג לפי קבוצה", ["קבוצה", "פילוח", "אחוז מורשים"], model.tables.rate, ltr=(2,)) }}
</section>
{%- endif %}

{%- if model.flags.work %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "רישיון נהיגה, תעסוקה והכנסה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.work_note }}</p>
  {{ callout("work_income") }}{{ callout("work_emp") }}
  {{ gov.chart("chart-work", model.labels.work_aria, "h-80 md:h-96") }}
  {{ gov.table("אחוז בעלי רישיון נהיגה לפי תעסוקה והכנסה", ["קבוצה", "פילוח", "אחוז בעלי רישיון"], model.tables.work, ltr=(2,)) }}
</section>
{%- endif %}

{%- if model.flags.freq %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "כמה נוהגים: תדירות נהיגה לפי מין וגיל") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.freq_note }}</p>
  {{ callout("freq_sex") }}{{ callout("freq_old") }}
  {{ gov.chart("chart-freq", model.labels.freq_aria, "h-80 md:h-96") }}
  {{ gov.table("תדירות נהיגה לפי מין וגיל (אחוזים)", model.labels.freq_cols, model.tables.freq, ltr=range(1, model.labels.freq_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.vehicle %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "כמה נהגים מורשים על כל רכב") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.vehicle_note }}</p>
  {{ callout("vehicle") }}
  {{ gov.chart("chart-vehicle", model.labels.vehicle_aria, "h-72 md:h-80") }}
  {{ gov.table("מורשים לנהוג לכל כלי רכב לפי סוג רכב", ["סוג רכב", "מורשים לכל רכב"], model.tables.vehicle, ltr=(1,)) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>הנתונים מתוך ההודעה השנתית לתקשורת של הלשכה המרכזית לסטטיסטיקה על המורשים לנהוג בישראל, המבוססת על מרשם רישיונות הנהיגה של משרד התחבורה. מספר המורשים לנהוג נכון לסוף כל שנה.</li>
    <li>הנתונים על תעסוקה, הכנסה ותדירות נהיגה לקוחים מהסקר החברתי של הלמ"ס, שנערך בשנה שלפני שנת הנתונים של המרשם, ולכן הם אומדנים מתוך מדגם.</li>
    <li>התרשימים בהודעה עשויים להשתנות משנה לשנה. העמוד מציג את התרשימים שמופיעים בהודעה האחרונה, ונתוני השנים הקודמות בה עשויים להיות מעודכנים לעומת הודעות קודמות.</li>
  </ul>
</section>

<script>
  (function () {
    const d = {{ model.charts.trend | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-trend"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2], pal[6]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Math.round(v).toLocaleString("he-IL") + " אלף" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: (v) => (v / 1000).toLocaleString("he-IL") + " מיליון" } },
      series: [
        { type: "line", name: "מורשים לנהוג", data: d.hold, showSymbol: false, lineStyle: { width: 3 } },
        { type: "line", name: "אוכלוסייה קבועה", data: d.pop, showSymbol: false },
        { type: "line", name: "כלי רכב מנועיים", data: d.veh, showSymbol: false }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.ratio | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-ratio"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[6], pal[0]],
      tooltip: { trigger: "axis" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: [
        { type: "value" },
        { type: "value", scale: true, splitLine: { show: false } }
      ],
      series: [
        { type: "bar", name: "גידול נטו (אלפים)", data: d.net, yAxisIndex: 0,
          tooltip: { valueFormatter: (v) => v == null ? "" : Math.round(v).toLocaleString("he-IL") + " אלף" } },
        { type: "line", name: "מורשים לכל 1,000 תושבים", data: d.per1000, yAxisIndex: 1, showSymbol: false, lineStyle: { width: 3 },
          tooltip: { valueFormatter: (v) => v == null ? "" : Math.round(v).toLocaleString("he-IL") } }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- if model.flags.sex %}
  (function () {
    const d = {{ model.charts.sex | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-sex"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Math.round(v).toLocaleString("he-IL") + " אלף" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: (v) => v.toLocaleString("he-IL") + " אלף" } },
      series: [
        { type: "line", name: "גברים", data: d.men, showSymbol: false, lineStyle: { width: 3 } },
        { type: "line", name: "נשים", data: d.women, showSymbol: false, lineStyle: { width: 3 } }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.rate %}
  (function () {
    const d = {{ model.charts.rate | tojson }};
    const pal = window.GOVIL_PALETTE;
    const groups = [...new Set(d.groups)];
    const cols = [pal[0], pal[2], pal[6], pal[5], pal[1]];
    const chart = echarts.init(document.getElementById("chart-rate"));
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "item", formatter: (p) => echarts.format.encodeHTML(d.groups[p.dataIndex] + ": " + d.names[p.dataIndex]) + "<br>" + Number(p.value).toFixed(1) + "%" },
      grid: { left: 16, right: 48, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [{
        type: "bar",
        data: d.values.map((v, i) => ({ value: v, itemStyle: { color: cols[groups.indexOf(d.groups[i]) % cols.length] } })),
        label: { show: true, position: "right", formatter: (p) => Number(p.value).toFixed(1) + "%" }
      }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.work %}
  (function () {
    const d = {{ model.charts.work | tojson }};
    const pal = window.GOVIL_PALETTE;
    const groups = [...new Set(d.groups)];
    const cols = [pal[0], pal[2], pal[6], pal[5]];
    const chart = echarts.init(document.getElementById("chart-work"));
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "item", formatter: (p) => echarts.format.encodeHTML(d.names[p.dataIndex]) + "<br>" + Number(p.value).toFixed(1) + "%" },
      grid: { left: 16, right: 48, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 110, overflow: "break" } },
      series: [{
        type: "bar",
        data: d.values.map((v, i) => ({ value: v, itemStyle: { color: cols[groups.indexOf(d.groups[i]) % cols.length] } })),
        label: { show: true, position: "right", formatter: (p) => Number(p.value).toFixed(1) + "%" }
      }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.freq %}
  (function () {
    const d = {{ model.charts.freq | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-freq"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2], pal[6], pal[5], pal[8]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 72, bottom: 8, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: d.cats.map((c, k) => ({ type: "bar", stack: "a", name: c, data: d.series[k] }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.vehicle %}
  (function () {
    const d = {{ model.charts.vehicle | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-vehicle"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[2]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + " מורשים לכל רכב" },
      grid: { left: 16, right: 40, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 110, overflow: "break" } },
      series: [{
        type: "bar",
        data: d.values.map((v, i) => d.names[i] === "רכב פרטי" ? { value: v, itemStyle: { color: pal[0] } } : v),
        label: { show: true, position: "right", formatter: (p) => Number(p.value).toFixed(1) }
      }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
</script>
