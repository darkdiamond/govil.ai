<h1>דרגת זיהום אוויר של כלי צמ״ה</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">כלי צמ״ה פעילים</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.polluting.tone }} mb-1" dir="ltr">{{ model.kpis.polluting.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.pol_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.unauth.tone }} mb-1" dir="ltr">{{ model.kpis.unauth.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.unauth_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.low.tone }} mb-1" dir="ltr">{{ model.kpis.low.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.low_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">כלים לפי דרגת זיהום</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.grades_note }}</p>
    <div id="chart-grades" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.grades_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.grades_caption }}</caption>
        <thead><tr><th scope="col">דרגה</th><th scope="col">כלים</th><th scope="col">שיעור</th><th scope="col">לא מורשים</th></tr></thead>
        <tbody>
{%- for r in model.tables.grades %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td><td>{{ r.unauth }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">גיל הכלים והרשאת פעילות</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.age_note }}</p>
    <div id="chart-age" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.age_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.age_caption }}</caption>
        <thead><tr><th scope="col">גיל (שנים)</th><th scope="col">מורשים</th><th scope="col">לא מורשים</th></tr></thead>
        <tbody>
  {%- for r in model.tables.age %}
          <tr><th scope="row" dir="ltr">{{ r.bucket }}</th><td>{{ r.auth }}</td><td>{{ r.unauth }}</td></tr>
  {%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מהנעה לדרגה ולהרשאה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">כל כלי עובר מסוג ההנעה שלו, לדרגת הזיהום שנקבעה לו ולהרשאת הפעילות. רוחב כל רצועה הוא מספר הכלים.</p>
  <div id="chart-flow" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.flow_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.flow_caption }}</caption>
      <thead><tr><th scope="col">הנעה</th><th scope="col">דרגה</th><th scope="col">כלים</th></tr></thead>
      <tbody>
{%- for r in model.tables.flow %}
        <tr><th scope="row">{{ r.fuel }}</th><td>{{ r.grade }}</td><td>{{ r.count }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">הרכב דרגות הזיהום לפי שנת ייצור</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.gy_note }}</p>
  <div id="chart-grade-year" data-fallback="explorer" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.gy_aria }}"></div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">הרשאת פעילות לפי שנת ייצור</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.ay_note }}</p>
  <div id="chart-auth-year" data-fallback="explorer" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.ay_aria }}"></div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">הספק המנוע, דרגה והרשאה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.power_note }}</p>
  <div id="chart-power" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.power_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.power_caption }}</caption>
      <thead><tr><th scope="col">הספק (קילוואט)</th><th scope="col">כלים</th><th scope="col">מזהמים</th><th scope="col">לא מורשים מבין המזהמים</th></tr></thead>
      <tbody>
{%- for r in model.tables.power %}
        <tr><th scope="row" dir="ltr">{{ r.band }}</th><td>{{ r.n }}</td><td>{{ r.pol }}</td><td dir="ltr">{{ r.rate }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">דרגת זיהום לפי סוג כלי</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.types_note }}</p>
    <div id="chart-types" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.types_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.types_caption }}</caption>
        <thead><tr><th scope="col">סוג</th><th scope="col">כלים</th><th scope="col">מזהם</th><th scope="col">מופחת, נקי או חשמלי</th><th scope="col">לא מורשים</th></tr></thead>
        <tbody>
{%- for r in model.tables.types %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.pol }}</td><td dir="ltr">{{ r.low }}</td><td dir="ltr">{{ r.un }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">דרגת זיהום לפי יצרן</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.makers_note }}</p>
    <div id="chart-makers" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.makers_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.makers_caption }}</caption>
        <thead><tr><th scope="col">יצרן</th><th scope="col">כלים</th><th scope="col">מזהם</th><th scope="col">מופחת, נקי או חשמלי</th><th scope="col">לא מורשים</th></tr></thead>
        <tbody>
{%- for r in model.tables.makers %}
          <tr><th scope="row" dir="ltr">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.pol }}</td><td dir="ltr">{{ r.low }}</td><td dir="ltr">{{ r.un }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>


<script>
  (function () {
    var g = {{ model.charts.grades | tojson }};
    var c = echarts.init(document.getElementById("chart-grades"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v.toLocaleString("he-IL") + " כלים"; } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: g.names, inverse: true },
      series: [{ type: "bar", name: "כלים", data: g.values.map(function (v, i) {
        return { value: v, itemStyle: { color: g.colors[i] } };
      }) }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var f = {{ model.charts.flow | tojson }};
    var el = document.getElementById("chart-flow");
    var c = echarts.init(el);
    function draw() {
      var narrow = el.clientWidth < 600;
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "item", formatter: function (p) {
          if (p.dataType === "edge") { return p.data.source + " ← " + p.data.target + ": " + p.data.value.toLocaleString("he-IL"); }
          return p.name + ": " + p.value.toLocaleString("he-IL");
        } },
        series: [{
          type: "sankey", data: f.nodes, links: f.links,
          orient: narrow ? "vertical" : "horizontal",
          left: narrow ? 8 : 90, right: narrow ? 8 : 110, top: narrow ? 8 : 16, bottom: narrow ? 64 : 16,
          nodeGap: narrow ? 6 : 10, nodeAlign: "justify",
          label: { fontFamily: "Rubik", fontSize: narrow ? 10 : 12, color: "#0c3058",
                   position: narrow ? "bottom" : "right", rotate: narrow ? -60 : 0,
                   formatter: function (p) { return narrow && p.value < f.total * 0.02 ? "" : p.name; } },
          lineStyle: { color: "source", opacity: 0.35 },
          emphasis: { focus: "adjacency" }
        }]
      }), true);
    }
    draw();
    window.addEventListener("resize", function () { c.resize(); draw(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.grade_year | tojson }};
    var c = echarts.init(document.getElementById("chart-grade-year"));
    c.setOption(window.GovEcharts.option({
      color: d.colors,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      legend: { top: 0 },
      grid: { left: 40, right: 16, top: window.innerWidth < 640 ? 84 : 56, bottom: 48, containLabel: true },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 4, height: 16 }],
      xAxis: { type: "category", data: d.x, boundaryGap: false },
      yAxis: { type: "value", max: 100, name: "%" },
      series: d.series.map(function (s) {
        return { type: "line", name: s.name, data: s.data, stack: "mix", areaStyle: {}, showSymbol: false, lineStyle: { width: 0.5 } };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var a = {{ model.charts.auth_year | tojson }};
    var c2 = echarts.init(document.getElementById("chart-auth-year"));
    c2.setOption(window.GovEcharts.option({
      color: a.colors,
      tooltip: { trigger: "axis" },
      legend: { top: 0 },
      grid: { left: 48, right: 16, top: window.innerWidth < 640 ? 76 : 56, bottom: 48, containLabel: true },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 4, height: 16 }],
      xAxis: { type: "category", data: a.x },
      yAxis: { type: "value", name: "כלים" },
      series: a.series.map(function (s) { return { type: "bar", stack: "all", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    var p = {{ model.charts.power | tojson }};
    var c = echarts.init(document.getElementById("chart-power"));
    var series = p.series.map(function (s, i) {
      return { type: "bar", stack: "grade", name: s.name, data: s.data, itemStyle: { color: p.colors[i] } };
    });
    series.push({ type: "line", name: "לא מורשים מבין המזהמים (%)", yAxisIndex: 1, data: p.rate,
                  connectNulls: true, symbolSize: 7, itemStyle: { color: "#0c1f3d" }, lineStyle: { type: "dashed", color: "#0c1f3d" } });
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 48, right: 48, top: 32, bottom: window.innerWidth < 640 ? 100 : 80, containLabel: true },
      xAxis: { type: "category", data: p.x, name: "קילוואט", nameLocation: "middle", nameGap: window.innerWidth < 640 ? 44 : 28,
               axisLabel: { interval: 0, rotate: window.innerWidth < 640 ? 40 : 0, fontSize: 11 } },
      yAxis: [{ type: "value", name: "כלים" }, { type: "value", name: "%", max: 100, splitLine: { show: false } }],
      series: series
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    function mix(id, d) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: d.colors,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + "%"; } },
        legend: { bottom: 0 },
        grid: { left: 16, right: 24, top: 16, bottom: 72, containLabel: true },
        xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
        yAxis: { type: "category", data: d.names, inverse: true },
        series: d.series.map(function (s) { return { type: "bar", stack: "mix", name: s.name, data: s.data }; })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    mix("chart-types", {{ model.charts.types | tojson }});
    mix("chart-makers", {{ model.charts.makers | tojson }});

    var a = {{ model.charts.age | tojson }};
    var c3 = echarts.init(document.getElementById("chart-age"));
    c3.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 48, right: 16, top: 24, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: a.names, name: "שנים", axisLabel: { interval: 0, fontSize: 11 } },
      yAxis: { type: "value", name: "כלים" },
      series: [
        { type: "bar", name: "מורשה פעילות", data: a.auth, itemStyle: { color: "#0068f5" } },
        { type: "bar", name: "לא מורשה פעילות", data: a.unauth, itemStyle: { color: "#dc3545" } }
      ]
    }));
    window.addEventListener("resize", function () { c3.resize(); });
  })();
</script>
