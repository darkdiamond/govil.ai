    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">הרשם לענייני ירושה הוקם ב-1998 עם תיקון חוק הירושה, תשכ"ה-1965. מאז מוגשות אל הרשם לענייני ירושה כל הבקשות לצווי ירושה ולצווי קיום צוואה, פרט לאלה המוגשות לבתי הדין הדתיים.
המאגר שלפניכם מכיל מידע על אודות הבקשות שהוגשו לרשם הירושה, סוגיהן, מועדים והחלטות של הרשמים שניתנו בבקשות אלו.</p>
</section>

<script>
  (function () {
    var d = {{ model.charts.yearly | tojson }};
    var c = echarts.init(document.getElementById("chart-yearly"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        var s = d.x[i] + (i === d.partial_index ? " (שנה חלקית)" : "") + "<br>";
        p.forEach(function (q) { s += q.marker + q.seriesName + ": " + Number(q.value).toLocaleString("he-IL") + "<br>"; });
        return s + "סך הכול: " + d.total[i].toLocaleString("he-IL");
      } },
      legend: { top: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 48, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value" },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 4, height: 16 }],
      series: d.series.map(function (s) {
        return { type: "bar", stack: "t", name: s.name, data: s.data.map(function (v, i) {
          return i === d.partial_index ? { value: v, itemStyle: { opacity: 0.5 } } : v;
        }) };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

{%- if model.flags.share %}
<script>
  (function () {
    var d = {{ model.charts.share | tojson }};
    var c = echarts.init(document.getElementById("chart-share"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      grid: { left: 16, right: 16, top: 24, bottom: 32, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", scale: true, axisLabel: { formatter: "{value}%" } },
      series: [{ type: "line", name: "שיעור צו קיום צוואה", data: d.y, showSymbol: false }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

<script>
  (function () {
    var d = {{ model.charts.heat | tojson }};
    var c = echarts.init(document.getElementById("chart-heat"));
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return d.months[p.value[1]] + " " + d.years[p.value[0]] + ": " + p.value[2].toLocaleString("he-IL") + " בקשות";
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.years, splitArea: { show: true } },
      yAxis: { type: "category", data: d.months, splitArea: { show: true } },
      visualMap: {
        dimension: 2, min: 0, max: d.max, calculable: true,
        orient: "horizontal", left: "center", bottom: 0,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", name: "בקשות", data: d.cells,
