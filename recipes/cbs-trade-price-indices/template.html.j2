{% import "gov.j2" as gov %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסמה {{ model.release.date }}</p>
  <p class="m-0 mb-3 font-semibold text-ink-deep">{{ model.release.headline }}</p>
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["tot", "exp", "imp", "fuel"] %}
{%- if model.kpis[key] is defined %}
  {{ gov.kpi(model.kpis[key], model.labels[key ~ "_kpi"]) }}
{%- endif %}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

<section class="card p-5 mb-6">
  {{ gov.head("trending-up", "מחירי היצוא והיבוא בכל רבעון") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.prices_note }}</p>
  {{ gov.chart("chart-prices", model.labels.prices_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.prices_caption, ["רבעון", "יצוא", "שינוי ברבעון", "יבוא", "שינוי ברבעון", "יבוא ללא אנרגיה"], model.tables.prices, ltr=(1, 2, 3, 4, 5)) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("chart-bar", "מדד תנאי הסחר") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.tot_note }}</p>
  {{ gov.chart("chart-tot", model.labels.tot_aria, "h-64 md:h-80") }}
  {{ gov.table(model.labels.tot_caption, ["רבעון", "ללא אנרגיה", "שינוי ברבעון", "כולל אנרגיה", "שינוי ברבעון"], model.tables.tot, ltr=(1, 2, 3, 4)) }}
</section>

{%- if model.flags.months %}
<section class="card p-5 mb-6">
  {{ gov.head("calendar", "המדדים בכל חודש") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.months_note }}</p>
  {{ gov.chart("chart-months", model.labels.months_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.months_caption, ["חודש", "יצוא", "יבוא", "תנאי הסחר ללא אנרגיה"], model.tables.months, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("database", "מחירי היבוא לפי קבוצת סחורות") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cats_note }}</p>
  {{ gov.chart("chart-cats", model.labels.cats_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.cats_caption, ["קבוצה", model.labels.q_col, model.labels.p_col, model.labels.y_col, model.labels.cats_w_col], model.tables.cats, ltr=(1, 2, 3, 4)) }}
</section>

{%- if model.flags.sitc %}
<section class="card p-5 mb-6">
  {{ gov.head("tag", "שינוי שנתי במחירים לפי סוג סחורה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.sitc_note }}</p>
  {{ gov.chart("chart-sitc", model.labels.sitc_aria, "h-80 md:h-[460px]") }}
  {{ gov.table(model.labels.sitc_caption, ["סוג סחורה", "מדד יבוא", "שינוי שנתי ביבוא", "מדד יצוא", "שינוי שנתי ביצוא"], model.tables.sitc, ltr=(1, 2, 3, 4)) }}
</section>
{%- endif %}

{%- if model.flags.tech %}
<section class="card p-5 mb-6">
  {{ gov.head("trending-up", "היצוא התעשייתי לפי עוצמה טכנולוגית") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.tech_note }}</p>
  {{ gov.chart("chart-tech", model.labels.tech_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.tech_caption, ["תעשיות", model.labels.q_col, model.labels.p_col, model.labels.y_col], model.tables.tech, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

{%- if model.flags.inds %}
<section class="card p-5 mb-6">
  {{ gov.head("building-2", "מחירי היצוא לפי ענף תעשייה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.inds_note }}</p>
  {{ gov.chart("chart-inds", model.labels.inds_aria, "h-[520px] md:h-[560px]") }}
  {{ gov.table(model.labels.inds_caption, ["ענף", model.labels.y_short, model.labels.q_col, "שינוי שנתי", model.labels.inds_w_col], model.tables.inds, ltr=(1, 2, 3, 4)) }}
</section>
{%- endif %}

{%- if model.flags.volume %}
<section class="card p-5 mb-6">
  {{ gov.head("chart-bar", "מדדי הנפח: כמה יובא ויוצא") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.volume_note }}</p>
  {{ gov.chart("chart-volume", model.labels.volume_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.volume_caption, ["רבעון", "יצוא", "שינוי שנתי", "יבוא", "שינוי שנתי"], model.tables.volume, ltr=(1, 2, 3, 4)) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("info", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>המדדים מחושבים בדולרים של ארצות הברית לפי נוסחת פישר, בבסיס {{ model.labels.base_txt }}. שינוי בשער החליפין של השקל אינו משפיע עליהם ישירות.</li>
    <li>המדדים הראשיים אינם כוללים אוניות, מטוסים ויהלומים, שמחיריהם תלויים בעסקאות בודדות.{% if model.labels.diamonds_note %} {{ model.labels.diamonds_note }}{% endif %}</li>
    <li>מדד תנאי הסחר הוא היחס בין מדד מחירי היצוא למדד מחירי היבוא. עלייה בו היא שיפור בתנאי הסחר של המשק.</li>
    <li>נתוני הרבעונים והחודשים האחרונים עשויים להתעדכן בהודעות הבאות. העמוד מציג תמיד את הגרסה האחרונה.</li>
  </ul>
</section>

<script>
  (function () {
    const d = {{ model.charts.prices | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-prices"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1], pal[1]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 56, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value", scale: true },
      series: [
        { type: "line", name: "יצוא", data: d.exp, lineStyle: { width: 3 } },
        { type: "line", name: "יבוא", data: d.imp, lineStyle: { width: 3 } },
        { type: "line", name: "יבוא ללא אנרגיה", data: d.imp_nf, lineStyle: { type: "dashed" } }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.tot | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-tot"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[2], pal[6]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value", scale: true },
      series: [
        { type: "line", name: "ללא אנרגיה", data: d.nf, lineStyle: { width: 3 } },
        { type: "line", name: "כולל אנרגיה", data: d.all, lineStyle: { type: "dashed" } }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- if model.flags.months %}
  (function () {
    const d = {{ model.charts.months | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-months"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1], pal[2]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 56, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value", scale: true },
      series: [
        { type: "line", name: "יצוא", data: d.exp },
        { type: "line", name: "יבוא", data: d.imp },
        { type: "line", name: "תנאי הסחר ללא אנרגיה", data: d.tot, lineStyle: { type: "dashed" } }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
  (function () {
    const d = {{ model.charts.cats | tojson }};
    const chart = echarts.init(document.getElementById("chart-cats"));
    chart.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 56, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value", scale: true },
      series: d.series.map((s) => ({ type: "line", name: s.name, data: s.data }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- if model.flags.sitc %}
  (function () {
    const d = {{ model.charts.sitc | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-sitc"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[1], pal[0]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 24, top: 40, bottom: 8, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { formatter: (v) => v + "%", hideOverlap: true } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 120, overflow: "break" } },
      series: [
        { type: "bar", name: "יבוא", data: d.imp },
        { type: "bar", name: "יצוא", data: d.exp }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.tech %}
  (function () {
    const d = {{ model.charts.tech | tojson }};
    const chart = echarts.init(document.getElementById("chart-tech"));
    chart.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 72, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value", scale: true },
      series: d.series.map((s) => ({ type: "line", name: s.name, data: s.data }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.inds %}
  (function () {
    const d = {{ model.charts.inds | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-inds"));
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) + "%" },
      grid: { left: 16, right: 24, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { formatter: (v) => v + "%", hideOverlap: true } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 120, overflow: "break" } },
      series: [{ type: "bar", data: d.y.map((v) => ({ value: v, itemStyle: { color: v < 0 ? pal[1] : pal[0] } })) }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.volume %}
  (function () {
    const d = {{ model.charts.volume | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-volume"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value" },
      series: [
        { type: "bar", name: "יצוא", data: d.exp },
        { type: "bar", name: "יבוא", data: d.imp }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
</script>
