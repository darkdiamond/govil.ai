{% import "gov.j2" as gov %}
{%- macro callout(key) -%}
{%- if model.callouts[key] is defined %}
  <p class="m-0 mb-3 text-sm font-semibold text-ink-deep">{{ model.callouts[key] }}</p>
{%- endif %}
{%- endmacro %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסמה {{ model.release.date }}</p>
{%- if model.release.headline %}
  <p class="m-0 mb-3 font-semibold text-ink-deep">{{ model.release.headline }}</p>
{%- endif %}
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["bus", "yoy", "growth", "all_modes", "lrt", "peak"] %}
{%- if model.kpis[key] is defined %}
  {{ gov.kpi(model.kpis[key], model.labels[key ~ "_kpi"]) }}
{%- endif %}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

<section class="card p-5 mb-6">
  {{ gov.head("trending-up", "תיקופים באוטובוסים לפי שנה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.year_note }}</p>
  {{ callout("year") }}
  {{ gov.chart("chart-year", model.labels.year_aria, "h-64 md:h-80") }}
  {{ gov.table("תיקופים באוטובוסים לפי שנה (מיליונים)", ["שנה", "תיקופים (מיליונים)"], model.tables.year, ltr=(1,)) }}
</section>

{%- if model.flags.month %}
<section class="card p-5 mb-6">
  {{ gov.head("calendar", "עונתיות: תיקופים באוטובוסים לפי חודש") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.month_note }}</p>
  {{ callout("month_drop") }}{{ callout("month_range") }}
  {{ gov.chart("chart-month", model.labels.month_aria, "h-72 md:h-80") }}
  {{ gov.table("תיקופים באוטובוסים לפי חודש ושנה (מיליונים)", model.labels.month_cols, model.tables.month, ltr=range(1, model.labels.month_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.hour %}
<section class="card p-5 mb-6">
  {{ gov.head("chart-bar", "שעות העומס באוטובוסים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.hour_note }}</p>
  {{ callout("hour_peak") }}{{ callout("hour_night") }}
  {{ gov.chart("chart-hour", model.labels.hour_aria, "h-72 md:h-96") }}
  {{ gov.table("תיקופים באוטובוסים לפי שעה ביממה (מיליונים)", model.labels.hour_cols, model.tables.hour, ltr=range(0, model.labels.hour_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.shape %}
<section class="card p-5 mb-6">
  {{ gov.head("trending-up", "צורת היום: אוטובוסים מול הרכבת הקלה בירושלים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.shape_note }}</p>
  {{ callout("shape") }}
  {{ gov.chart("chart-shape", model.labels.shape_aria, "h-72 md:h-80") }}
  {{ gov.table("חלק התיקופים בכל שעה ביממה", ["שעה", "אוטובוסים", "רכבת קלה בירושלים"], model.tables.shape, ltr=(0, 1, 2)) }}
</section>
{%- endif %}

{%- if model.flags.dow %}
<section class="card p-5 mb-6">
  {{ gov.head("calendar", "תיקופים באוטובוסים לפי יום בשבוע") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.dow_note }}</p>
  {{ callout("dow") }}
  {{ gov.chart("chart-dow", model.labels.dow_aria, "h-64 md:h-80") }}
  {{ gov.table("חלק התיקופים באוטובוסים בכל יום בשבוע", model.labels.dow_cols, model.tables.dow, ltr=range(1, model.labels.dow_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.profile %}
<section class="card p-5 mb-6">
  {{ gov.head("chart-bar", "מי נוסע: פרופיל הנוסע באוטובוסים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.profile_note }}</p>
  {{ callout("profile") }}
  {{ gov.chart("chart-profile", model.labels.profile_aria, "h-80 md:h-96") }}
  {{ gov.table("תיקופים באוטובוסים לפי פרופיל נוסע (מיליונים)", model.labels.profile_cols, model.tables.profile, ltr=range(0, model.labels.profile_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.city %}
<section class="card p-5 mb-6">
  {{ gov.head("map-pin", "תיקופים באוטובוסים בערים הגדולות") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.city_note }}</p>
  {{ callout("city") }}
  {{ gov.chart("chart-city", model.labels.city_aria, "h-[480px]") }}
  {{ gov.table("חלק התיקופים באוטובוסים לפי עיר", ["עיר", "חלק מהתיקופים"], model.tables.city, ltr=(1,)) }}
</section>
{%- endif %}

{%- if model.flags.modes %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "אוטובוסים, רכבות קלות, כרמלית ורכבלית") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.modes_note }}</p>
  {{ callout("modes_total") }}{{ callout("modes_profile") }}
  {{ gov.chart("chart-mode-tot", model.labels.mode_tot_aria, "h-64") }}
  {{ gov.chart("chart-modes", model.labels.modes_aria, "h-80 md:h-96") }}
  {{ gov.table("תיקופים לפי אמצעי תחבורה ופרופיל נוסע", model.labels.modes_cols, model.tables.modes, ltr=range(1, model.labels.modes_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.lrt_year %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "הרכבת הקלה בירושלים לפי שנה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.lrt_year_note }}</p>
  {{ callout("lrt_year") }}
  {{ gov.chart("chart-lrt-year", model.labels.lrt_year_aria, "h-64 md:h-72") }}
  {{ gov.table("תיקופים ברכבת הקלה בירושלים לפי שנה (מיליונים)", ["שנה", "תיקופים (מיליונים)"], model.tables.lrt_year, ltr=(1,)) }}
</section>
{%- endif %}

{%- if model.flags.carmel %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "הכרמלית בחיפה לפי שנה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.carmel_note }}</p>
  {{ callout("carmel") }}
  {{ gov.chart("chart-carmel", model.labels.carmel_aria, "h-64 md:h-72") }}
  {{ gov.table("תיקופים בכרמלית לפי שנה (אלפים)", ["שנה", "תיקופים (אלפים)"], model.tables.carmel, ltr=(1,)) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>הנתונים מתוך ההודעה השנתית לתקשורת של הלשכה המרכזית לסטטיסטיקה על תיקופי הנסיעות בתחבורה הציבורית. תיקוף הוא רישום של עלייה לכלי תחבורה ציבורית בכרטיס רב-קו או באמצעי תשלום אחר, כך שנוסע שמחליף קו נספר יותר מפעם אחת.</li>
    <li>פרופיל הנוסע הוא סוג הזכאות שעל הכרטיס (למשל סטודנט, נוער או ותיק). "לא מוגדר" ו"אחר ולא ידוע" הם תיקופים ללא פרופיל מזוהה, כפי שהלמ"ס מסווגת אותם.</li>
    <li>ההודעה אינה כוללת את רכבת ישראל. התרשימים בהודעה משתנים משנה לשנה: העמוד מציג את אלה שמופיעים בהודעה האחרונה, ונתוני השנים הקודמות בה עשויים להיות מעודכנים לעומת הודעות קודמות.</li>
  </ul>
</section>

<script>
  (function () {
    const d = {{ model.charts.year | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-year"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + " מיליון" },
      grid: { left: 16, right: 16, top: 32, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", name: "מיליונים" },
      series: [{ type: "bar", name: "תיקופים", data: d.y, barMaxWidth: 48,
        label: { show: true, position: "top", formatter: (p) => Number(p.value).toFixed(0) } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- if model.flags.month %}
  (function () {
    const d = {{ model.charts.month | tojson }};
    const chart = echarts.init(document.getElementById("chart-month"));
    chart.setOption(window.GovEcharts.option({
      tooltip: {
        position: "top",
        formatter: (p) => echarts.format.encodeHTML(d.x[p.value[0]]) + " " + echarts.format.encodeHTML(d.y[p.value[1]]) +
          ": " + Number(p.value[2]).toFixed(1) + " מיליון"
      },
      grid: { left: 16, right: 16, top: 8, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.x, splitArea: { show: true }, axisLabel: { interval: 0, fontSize: 10 } },
      yAxis: { type: "category", data: d.y, inverse: true },
      visualMap: {
        min: d.min, max: d.max, calculable: true, dimension: 2, precision: 0,
        orient: "horizontal", left: "center", bottom: 4,
        inRange: { color: ["#f1f7ff", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: d.cells }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.hour %}
  (function () {
    const d = {{ model.charts.hour | tojson }};
    const pal = window.GOVIL_PALETTE;
    const n = d.years.length;
    const chart = echarts.init(document.getElementById("chart-hour"));
    chart.setOption(window.GovEcharts.option({
      color: d.years.map((y, k) => k === n - 1 ? pal[0] : [pal[6], pal[2], pal[5], pal[8]][k % 4]),
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toFixed(2) + " מיליון" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 56, containLabel: true },
      dataZoom: [{ type: "inside" }, { type: "slider", height: 18, bottom: 8 }],
      xAxis: { type: "category", data: d.x, boundaryGap: false },
      yAxis: { type: "value", name: "מיליונים" },
      series: d.years.map((y, k) => ({ type: "line", name: y, data: d.series[k], showSymbol: false,
        lineStyle: { width: k === n - 1 ? 3 : 1.5 } }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.shape %}
  (function () {
    const d = {{ model.charts.shape | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-shape"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x, boundaryGap: false },
      yAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
      series: [
        { type: "line", name: "אוטובוסים", data: d.bus, showSymbol: false, lineStyle: { width: 3 } },
        { type: "line", name: "רכבת קלה בירושלים", data: d.lrt, showSymbol: false, lineStyle: { width: 3 } }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.dow %}
  (function () {
    const d = {{ model.charts.dow | tojson }};
    const pal = window.GOVIL_PALETTE;
    const n = d.years.length;
    const chart = echarts.init(document.getElementById("chart-dow"));
    chart.setOption(window.GovEcharts.option({
      color: d.years.map((y, k) => k === n - 1 ? pal[0] : pal[6]),
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { interval: 0 } },
      yAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
      series: d.years.map((y, k) => ({ type: "bar", name: y, data: d.series[k] }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.profile %}
  (function () {
    const d = {{ model.charts.profile | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-profile"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1], pal[2], pal[3], pal[4], pal[5], pal[6], pal[7], pal[8], pal[9]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + " מיליון" },
      legend: { top: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 48, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", name: "מיליונים" },
      series: d.cats.map((c, k) => ({ type: "bar", stack: "a", name: c, data: d.series[k] }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.city %}
  (function () {
    const d = {{ model.charts.city | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-city"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => Number(v).toFixed(1) + "%" },
      grid: { left: 16, right: 48, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: false }, splitLine: { show: false } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 90, overflow: "truncate" } },
      series: [{ type: "bar", data: d.values,
        label: { show: true, position: "right", formatter: (p) => Number(p.value).toFixed(1) + "%" } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.modes %}
  (function () {
    const d = {{ model.charts.mode_tot | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-mode-tot"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[2]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => Number(v).toFixed(2) + " מיליון" },
      grid: { left: 16, right: 88, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: false }, splitLine: { show: false } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 90, overflow: "truncate" } },
      series: [{ type: "bar", data: d.values,
        label: { show: true, position: "right", formatter: (p) => Number(p.value).toLocaleString("he-IL", { maximumFractionDigits: 2 }) + " מיליון" } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.modes | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-modes"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1], pal[2], pal[3], pal[4], pal[5], pal[6], pal[7], pal[8], pal[9]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      legend: { top: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 48, bottom: 8, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 90, overflow: "truncate" } },
      series: d.cats.map((c, k) => ({ type: "bar", stack: "a", name: c, data: d.series[k] }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.lrt_year %}
  (function () {
    const d = {{ model.charts.lrt_year | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-lrt-year"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[2]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toFixed(2) + " מיליון" },
      grid: { left: 16, right: 16, top: 32, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", name: "מיליונים" },
      series: [{ type: "bar", name: "תיקופים", data: d.y, barMaxWidth: 48,
        label: { show: true, position: "top", formatter: (p) => Number(p.value).toFixed(1) } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.carmel %}
  (function () {
    const d = {{ model.charts.carmel | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-carmel"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[5]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") + " אלף" },
      grid: { left: 16, right: 16, top: 32, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", name: "אלפים" },
      series: [{ type: "bar", name: "תיקופים", data: d.y, barMaxWidth: 48 }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
</script>
