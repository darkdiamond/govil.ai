<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">כאשר מתנהל סכסוך משפחתי בתהליך הגירושין, בעת הצורך ולפי דרישת בית המשפט, מעמידות יחידות הסיוע לרשות הציבור ובתי המשפט רשימות מומחים למתן חוות דעת בתחומי העבודה הסוציאלית, הפסיכולוגיה, הפסיכיאטריה ורפואת ילדים, בעניינים כגון: שאלות בדבר קביעת משמורת חלוקת זמני השהות של הילדים הקטינים עם מי מהוריהם, כשרות משפטית ואפוטרופסות, אלימות במשפחה.</p>
</section>

<script>
  (function () {
    var P = window.GOVIL_PALETTE;
    var d = {{ model.charts.prof | tojson }};
    var c = echarts.init(document.getElementById("chart-prof"));
    c.setOption(window.GovEcharts.option({
      color: P,
      tooltip: { trigger: "item", formatter: function (p) {
        return p.name + ": " + p.value.toLocaleString("he-IL") + " (" + p.percent + "%)";
      } },
      legend: { bottom: 0 },
      series: [{
        type: "pie", radius: ["42%", "68%"], center: ["50%", "44%"],
        label: { show: false },
        data: d.names.map(function (nm, i) { return { name: nm, value: d.values[i], itemStyle: { color: d.colors[i] } }; })
      }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var P = window.GOVIL_PALETTE;
    var d = {{ model.charts.districts | tojson }};
    var c = echarts.init(document.getElementById("chart-districts"));
    c.setOption(window.GovEcharts.option({
      color: P,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 56, containLabel: true },
      xAxis: { type: "value", splitNumber: 4, minInterval: 1, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: d.x, inverse: true, axisLabel: { fontSize: 11, interval: 0 } },
      series: d.series.map(function (s) {
        return { type: "bar", stack: "t", name: s.name, data: s.data, itemStyle: { color: s.color } };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

