<h1>רשימת מומחים לבתי משפט</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.experts.tone }} mb-1" dir="ltr">{{ model.kpis.experts.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.experts_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.national.tone }} mb-1" dir="ltr">{{ model.kpis.national.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.national_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.rate.tone }} mb-1" dir="ltr">{{ model.kpis.rate.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.rate_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.opinion.tone }} mb-1" dir="ltr">{{ model.kpis.opinion.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.opinion_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">מומחים לפי תחום</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.prof_note }}</p>
    <div id="chart-prof" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.prof_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.prof_caption }}</caption>
        <thead><tr><th scope="col">תחום</th><th scope="col">מומחים</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.prof %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">פריסה לפי מחוז</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.districts_note }}</p>
    <div id="chart-districts" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.districts_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
        <table class="mt-2 w-full text-sm">
          <caption class="sr-only">{{ model.labels.districts_caption }}</caption>
          <thead><tr><th scope="col">מחוז</th>{% for c in model.tables.prof_cols %}<th scope="col">{{ c }}</th>{% endfor %}<th scope="col">סה״כ</th></tr></thead>
          <tbody>
{%- for r in model.tables.districts %}
            <tr><th scope="row">{{ r.name }}</th>{% for v in r.vals %}<td>{{ v }}</td>{% endfor %}<td>{{ r.total }}</td></tr>
{%- endfor %}
          </tbody>
        </table>
      </div>
    </details>
  </section>
</div>

