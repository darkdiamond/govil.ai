{% if model.flags.rates %}
<script>
  (function () {
    var d = {{ model.charts.rates | tojson }};
    var c = echarts.init(document.getElementById("chart-rates"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        if (p.seriesType === "boxplot") {
          var v = p.value.slice(-5);
          return p.name + "<br/>חציון: " + v[2].toLocaleString("he-IL") + " ₪<br/>מחצית אמצעית: " +
            v[1].toLocaleString("he-IL") + " עד " + v[3].toLocaleString("he-IL") + " ₪";
        }
        return d.names[p.value[0]] + ": " + p.value[1].toLocaleString("he-IL") + " ₪";
      } },
      grid: { left: 16, right: 16, top: 32, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: { fontSize: 11, interval: 0 } },
      yAxis: { type: "log", logBase: 10, name: "₪ (סולם לוגריתמי)", axisLabel: { formatter: function (v) { return v.toLocaleString("he-IL"); } } },
      series: [
        { type: "boxplot", name: "תעריף", data: d.boxes,
          itemStyle: { color: "#f1f7ff", borderColor: "#0068f5", borderWidth: 2 } },
        { type: "scatter", name: "חריג", data: d.outliers, symbolSize: 9, itemStyle: { color: "#0b3668" } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{% endif %}

