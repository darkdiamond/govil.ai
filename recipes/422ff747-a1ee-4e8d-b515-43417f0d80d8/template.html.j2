</section>
{%- endif %}

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">דיווחים לפי אזור</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.regions_lede }}</p>
    <div id="chart-regions" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.regions_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.regions_aria }}</caption>
        <thead><tr><th scope="col">אזור</th><th scope="col">דיווחים</th><th scope="col">מפעלים</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.regions %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.sites }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">ארובות ומוקדי פליטה</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.chimneys_lede }}</p>
    <div id="chart-chimneys" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.chimneys_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.chimneys_aria }}</caption>
        <thead><tr><th scope="col">ארובה</th><th scope="col">מפעל</th><th scope="col">דיווחים</th></tr></thead>
        <tbody>
{%- for r in model.tables.chimneys %}
          <tr><th scope="row">{{ r.chimney }}</th><td>{{ r.site }}</td><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">הדיווחים האחרונים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.recent_lede }}</p>
  <div class="overflow-x-auto">
  <table id="table-recent" class="w-full text-sm">
    <caption class="sr-only">{{ model.labels.recent_lede }}</caption>
    <thead><tr><th scope="col">תחילת התקלה</th><th scope="col">מפעל</th><th scope="col">ארובה</th><th scope="col">מזהם</th><th scope="col">התקלה</th></tr></thead>
    <tbody>
{%- for r in model.tables.recent %}
      <tr><th scope="row">{{ r.date }}</th><td>{{ r.site }}</td><td>{{ r.chimney }}</td><td>{{ r.pollutant }}</td><td>{{ r.desc }}</td></tr>
{%- endfor %}
    </tbody>
  </table>
  </div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-subtle">פרסום לציבור נתוני של ניטור רציף מזהמים בארובה</p>
</section>

<script>
  (function () {
    const d = {{ model.charts.timeline | tojson }};
    const chart = echarts.init(document.getElementById("chart-timeline"));
    const zoom = d.x.length > 24;
    chart.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", formatter: function (p) { return echarts.format.encodeHTML(p[0].name) + "<br>" + p[0].value + " דיווחים"; } },
      grid: { left: 16, right: 16, top: 24, bottom: zoom ? 64 : 40, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: 45, fontSize: 11 } },
      yAxis: { type: "value", minInterval: 1, name: "דיווחים" },
      dataZoom: zoom ? [{ type: "inside" }, { type: "slider", height: 18, bottom: 8 }] : [],
      series: [{ type: "bar", data: d.y, itemStyle: { color: "#0068f5" } }]
    }));
    window.addEventListener("resize", function () { chart.resize(); });
  })();
  (function () {
    const d = {{ model.charts.sites | tojson }};
    const chart = echarts.init(document.getElementById("chart-sites"));
    const names = d.names.slice().reverse();
    chart.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0, type: "scroll" },
      grid: { left: 16, right: 24, top: 40, bottom: 16, containLabel: true },
      xAxis: { type: "value", minInterval: 1 },
      yAxis: { type: "category", data: names, axisLabel: { width: 150, overflow: "truncate" } },
      series: d.series.map(function (s) {
        return { name: s.name, type: "bar", stack: "f", data: s.data.slice().reverse() };
      })
    }));
    window.addEventListener("resize", function () { chart.resize(); });
  })();
  (function () {
    const d = {{ model.charts.faults | tojson }};
    const chart = echarts.init(document.getElementById("chart-faults"));
    chart.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) { return echarts.format.encodeHTML(p.name) + "<br>" + p.value + " דיווחים (" + p.percent + "%)"; } },
      legend: { bottom: 0, type: "scroll" },
      series: [{ type: "pie", radius: ["40%", "68%"], center: ["50%", "44%"], label: { show: false },
        data: d.names.map(function (n, i) { return { name: n, value: d.values[i] }; }) }]
    }));
    window.addEventListener("resize", function () { chart.resize(); });
  })();
  (function () {
    const d = {{ model.charts.pollutants | tojson }};
    const chart = echarts.init(document.getElementById("chart-pollutants"));
    chart.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 24, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "value", minInterval: 1 },
      yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 120, overflow: "truncate" } },
      series: [{ type: "bar", data: d.values.slice().reverse(), label: { show: true, position: "right" } }]
    }));
    window.addEventListener("resize", function () { chart.resize(); });
  })();
  (function () {
    const d = {{ model.charts.themes | tojson }};
    const chart = echarts.init(document.getElementById("chart-themes"));
    chart.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 32, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "value", minInterval: 1 },
      yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 140, overflow: "truncate" } },
      series: [{ type: "bar", data: d.values.slice().reverse(), label: { show: true, position: "right" } }]
    }));
    window.addEventListener("resize", function () { chart.resize(); });
  })();
  (function () {
    const d = {{ model.charts.lag | tojson }};
    const chart = echarts.init(document.getElementById("chart-lag"));
    chart.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, fontSize: 11 } },
      yAxis: { type: "value", minInterval: 1 },
      series: [{ type: "bar", data: d.values, label: { show: true, position: "top" } }]
    }));
    window.addEventListener("resize", function () { chart.resize(); });
  })();
  (function () {
    const d = {{ model.charts.duration | tojson }};
    const chart = echarts.init(document.getElementById("chart-duration"));
    chart.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, fontSize: 11 } },
      yAxis: { type: "value", minInterval: 1 },
      series: [{ type: "bar", data: d.values, label: { show: true, position: "top" } }]
    }));
    window.addEventListener("resize", function () { chart.resize(); });
  })();
{%- if model.charts.has_downtime %}
  (function () {
    const d = {{ model.charts.downtime | tojson }};
    const chart = echarts.init(document.getElementById("chart-downtime"));
    chart.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        const i = p[0].dataIndex;
        return echarts.format.encodeHTML(d.x[i]) + "<br>" + echarts.format.encodeHTML(d.site[i]) + "<br>" + d.y[i] + " שעות";
      } },
      grid: { left: 16, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: 45, fontSize: 11 } },
      yAxis: { type: "value", name: "שעות" },
      series: [{ type: "bar", data: d.y, itemStyle: { color: "#0068f5" } }]
    }));
    window.addEventListener("resize", function () { chart.resize(); });
  })();
{%- endif %}
  (function () {
    const d = {{ model.charts.regions | tojson }};
    const chart = echarts.init(document.getElementById("chart-regions"));
    chart.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        const i = p[0].dataIndex;
        return echarts.format.encodeHTML(d.names[i]) + "<br>" + d.values[i] + " דיווחים, " + d.sites[i] + " מפעלים";
      } },
      grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: { interval: 0 } },
      yAxis: { type: "value", minInterval: 1 },
      series: [{ type: "bar", data: d.values, label: { show: true, position: "top" } }]
    }));
    window.addEventListener("resize", function () { chart.resize(); });
  })();
  (function () {
    const d = {{ model.charts.chimneys | tojson }};
    const chart = echarts.init(document.getElementById("chart-chimneys"));
    chart.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 32, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "value", minInterval: 1 },
      yAxis: { type: "category", data: d.names, axisLabel: { width: 150, overflow: "truncate", fontSize: 11 } },
      series: [{ type: "bar", data: d.values, label: { show: true, position: "right" } }]
    }));
    window.addEventListener("resize", function () { chart.resize(); });
  })();
</script>
