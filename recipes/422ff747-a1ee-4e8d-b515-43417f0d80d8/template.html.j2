</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">מהירות הדיווח</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.lag_lede }}</p>
    <div id="chart-lag" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.lag_aria }}"></div>
    {{ count_table(model.tables.lag, model.labels.lag_aria, "זמן עד הדיווח", share=false) }}
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">משך התקלה</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.duration_lede }}</p>
    <div id="chart-duration" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.duration_aria }}"></div>
    {{ count_table(model.tables.duration, model.labels.duration_aria, "משך", share=false) }}
