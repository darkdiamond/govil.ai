{% macro count_table(rows, caption, head, unit="דיווחים", share=true) -%}
<details class="mt-3">
  <summary class="text-sm text-subtle">הצג כטבלה</summary>
  <table class="mt-2 w-full text-sm">
    <caption class="sr-only">{{ caption }}</caption>
    <thead><tr><th scope="col">{{ head }}</th><th scope="col">{{ unit }}</th>{% if share %}<th scope="col">שיעור</th>{% endif %}</tr></thead>
    <tbody>
{%- for r in rows %}
      <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td>{% if share %}<td>{{ r.share }}</td>{% endif %}</tr>
{%- endfor %}
    </tbody>
  </table>
</details>
{%- endmacro %}

<h1>דיווח על תקלה לידיעת הציבור: תקלות בארובות מפעלים</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
{%- if model.labels.test_note %}
  <p class="mt-2 mb-0 text-sm text-subtle">{{ model.labels.test_note }}</p>
{%- endif %}
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור דיווח תקלה לפי שם מפעל או ארובה ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל הדיווחים: שם המפעל, אזור, כתובת, שם הארובה, המזהם, סוג התקלה והערות המפעל.</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
{%- for key in ["reports", "sites", "top_share", "lag", "span"] %}
{%- if model.kpis[key] is defined %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.labels["kpi_" ~ key] }}</div>
  </div>
{%- endif %}
{%- endfor %}
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">דיווחים לאורך זמן</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.timeline_lede }}</p>
  <div id="chart-timeline" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.timeline_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה (תקופות עם דיווחים)</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.timeline_aria }}</caption>
      <thead><tr><th scope="col">תקופה</th><th scope="col">דיווחים</th></tr></thead>
      <tbody>
{%- for r in model.tables.timeline %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">המפעלים המדווחים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.sites_lede }}</p>
