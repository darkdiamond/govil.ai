</div>

{%- if model.charts.has_downtime %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">שעות השבתה שדווחו</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.downtime_lede }}</p>
  <div id="chart-downtime" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.downtime_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.downtime_aria }}</caption>
      <thead><tr><th scope="col">תאריך התקלה</th><th scope="col">מפעל</th><th scope="col">שעות</th></tr></thead>
      <tbody>
{%- for r in model.tables.downtime %}
        <tr><th scope="row">{{ r.date }}</th><td>{{ r.site }}</td><td>{{ r.hours }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
