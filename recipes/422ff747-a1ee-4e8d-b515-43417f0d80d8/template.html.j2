    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.pollutants_lede }}</p>
    <div id="chart-pollutants" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.pollutants_aria }}"></div>
