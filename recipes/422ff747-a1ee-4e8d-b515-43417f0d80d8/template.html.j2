      <tbody>
{%- for r in model.tables.sites %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td><td>{{ r.chimneys }}</td><td>{{ r.last }}</td></tr>
{%- endfor %}
      </tbody>
