    <h2 class="m-0 text-lg font-semibold text-ink-deep">העדכונים האחרונים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.recent_note }}</p>
  <div class="overflow-x-auto">
  <table class="w-full text-sm">
    <caption class="sr-only">{{ model.labels.recent_caption }}</caption>
    <thead><tr><th scope="col">חומר פעיל</th><th scope="col">גידול</th><th scope="col">גבול (מ״ג/ק״ג)</th><th scope="col">עדכון</th><th scope="col">סימון</th></tr></thead>
    <tbody>
{%- for r in model.tables.recent %}
      <tr><th scope="row" dir="ltr">{{ r.ai }}</th><td>{{ r.crop }}</td><td>{{ r.mrl }}</td><td dir="ltr">{{ r.date }}</td><td>{{ r.status }}</td></tr>
{%- endfor %}
    </tbody>
  </table>
  </div>
