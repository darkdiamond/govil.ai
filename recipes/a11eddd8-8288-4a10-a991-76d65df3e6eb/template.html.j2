    <caption class="sr-only">{{ model.labels.high_caption }}</caption>
    <thead><tr><th scope="col">חומר פעיל</th><th scope="col">גידול</th><th scope="col">גבול (מ״ג/ק״ג)</th><th scope="col">עדכון</th><th scope="col">סימון</th></tr></thead>
