<script>
  (function () {
    var STATUS_COLORS = { "ללא סימון": "#0068f5", "בהמתנה": "#ffc107", "מיועד לביטול": "#dc3545", "סימון אחר": "#6c757d" };
    function colors(series) { return series.map(function (s) { return STATUS_COLORS[s.name] || "#6c757d"; }); }

    var t = {{ model.charts.years | tojson }};
    var el = document.getElementById("chart-years");
    var c = echarts.init(el);
    var last = t.x.length - 1;
    c.setOption(window.GovEcharts.option({
      color: colors(t.series),
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var s = ps[0].axisValue + ((t.partial && ps[0].dataIndex === last) ? " (שנה חלקית)" : "");
        var sum = 0;
        ps.forEach(function (p) { sum += p.value; s += "<br>" + p.marker + p.seriesName + ": " + Number(p.value).toLocaleString("he-IL"); });
        return s + "<br>סה״כ: " + sum.toLocaleString("he-IL");
      } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 32, bottom: 88, containLabel: true },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 28, height: 18 }],
      xAxis: { type: "category", data: t.x },
      yAxis: { type: "value", name: "גבולות" },
      series: t.series.map(function (s) { return { type: "bar", stack: "a", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var st = {{ model.charts.status | tojson }};
    var sc = echarts.init(document.getElementById("chart-status"));
    sc.setOption(window.GovEcharts.option({
      color: colors(st.series),
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex, s = ps[0].axisValue;
        ps.forEach(function (p, k) { s += "<br>" + p.marker + p.seriesName + ": " + p.value + "% (" + st.counts[i][k].toLocaleString("he-IL") + ")"; });
        return s;
      } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "value", max: 100, interval: 25, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: st.rows, inverse: true, axisLabel: { width: 110, overflow: "truncate" } },
      series: st.series.map(function (s) { return { type: "bar", stack: "a", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { sc.resize(); });
  })();
</script>

<script>
  (function () {
    var m = {{ model.charts.mrl | tojson }};
    var el = document.getElementById("chart-mrl");
    var narrow = el.clientWidth < 500;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        return ps[0].axisValue + " מ״ג/ק״ג<br>" + Number(ps[0].value).toLocaleString("he-IL") + " גבולות";
      } },
      grid: { left: 16, right: 16, top: 32, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: m.names, axisLabel: { interval: 0, rotate: narrow ? 40 : 0, fontSize: narrow ? 10 : 12 } },
      yAxis: { type: "value", name: "גבולות" },
      series: [{ type: "bar", name: "גבולות", data: m.values }]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var g = {{ model.charts.groups | tojson }};
    var gEl = document.getElementById("chart-groups");
    var gNarrow = gEl.clientWidth < 500;
    var gc = echarts.init(gEl);
    gc.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 40, containLabel: true },
      xAxis: { type: "value", splitNumber: gNarrow ? 3 : 5, axisLabel: { hideOverlap: true, fontSize: gNarrow ? 10 : 12 } },
      yAxis: { type: "category", data: g.names, inverse: true, axisLabel: { width: 100, overflow: "truncate" } },
      series: [
        { type: "bar", name: "גבולות", data: g.limits },
        { type: "bar", name: "חומרים פעילים", data: g.ai }
      ]
    }));
    window.addEventListener("resize", function () { gc.resize(); });

    var bx = {{ model.charts.box | tojson }};
    var bc = echarts.init(document.getElementById("chart-box"));
    bc.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (q) {
        var v = q.value;
        return q.name + "<br>עשירון תחתון: " + v[1] + "<br>רבעון תחתון: " + v[2] + "<br>חציון: " + v[3] +
               "<br>רבעון עליון: " + v[4] + "<br>עשירון עליון: " + v[5] + " (מ״ג/ק״ג)";
      } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "log", logBase: 10, name: "מ״ג/ק״ג", nameLocation: "middle", nameGap: 26 },
      yAxis: { type: "category", data: bx.names, inverse: true, axisLabel: { width: 100, overflow: "truncate" } },
      series: [{ type: "boxplot", name: "גבול", data: bx.box,
                 itemStyle: { color: "#dbe8fb", borderColor: "#0068f5" } }]
    }));
    window.addEventListener("resize", function () { bc.resize(); });
  })();
</script>

<script>
  (function () {
    function hbar(id, d, unit, ltr) {
      var el = document.getElementById(id);
      var c = echarts.init(el);
      var narrow = el.clientWidth < 500;
      var lw = Math.min(170, Math.round(el.clientWidth * 0.42));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
          return ps[0].axisValue + "<br>" + Number(ps[0].value).toLocaleString("he-IL") + " " + unit;
        } },
        grid: { left: 16, right: narrow ? 36 : 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", axisLabel: { show: !narrow } },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: lw, overflow: "truncate", fontSize: ltr && narrow ? 10 : 12 } },
        series: [{ type: "bar", name: unit, data: d.values,
                   label: { show: narrow, position: "right", fontSize: 10, color: "#0c3058" } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    hbar("chart-crops", {{ model.charts.crops | tojson }}, "חומרים פעילים", false);
    hbar("chart-ai", {{ model.charts.ai | tojson }}, "גידולים", true);
  })();
</script>

<script>
  (function () {
    var h = {{ model.charts.heat | tojson }};
    var el = document.getElementById("chart-heat");
    var narrow = el.clientWidth < 600;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return h.y[p.value[1]] + " · " + h.x[p.value[0]] + ": " + p.value[2].toLocaleString("he-IL") + " גידולים";
      } },
      grid: { left: 8, right: 8, top: 8, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true },
               axisLabel: narrow ? { interval: 0, rotate: 50, width: 80, overflow: "truncate", fontSize: 10 }
                                 : { interval: 0, width: 90, overflow: "break" } },
      yAxis: { type: "category", data: h.y, inverse: true, splitArea: { show: true },
               axisLabel: { interval: 0, fontSize: narrow ? 9 : 12, width: narrow ? 110 : 180, overflow: "truncate" } },
      visualMap: {
        min: 0, max: h.max, calculable: true, dimension: 2,
        orient: "horizontal", left: "center", bottom: 4, itemHeight: 120,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells, label: { show: true, fontFamily: "Rubik", fontSize: narrow ? 8 : 11 },
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var s = {{ model.charts.scatter | tojson }};
    var sc = echarts.init(document.getElementById("chart-scatter"));
    sc.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        return p.value[2] + "<br>גידולים: " + p.value[0] + "<br>חציון הגבול: " + p.value[1] + " מ״ג/ק״ג";
      } },
      grid: { left: 16, right: 24, top: 32, bottom: 40, containLabel: true },
      xAxis: { type: "value", name: "גידולים", nameLocation: "middle", nameGap: 26 },
      yAxis: { type: "log", logBase: 10, name: "חציון (מ״ג/ק״ג)" },
      series: [{ type: "scatter", name: "חומר פעיל", data: s.points, symbolSize: 8,
                 itemStyle: { opacity: 0.6 } }]
    }));
    window.addEventListener("resize", function () { sc.resize(); });
  })();
</script>
