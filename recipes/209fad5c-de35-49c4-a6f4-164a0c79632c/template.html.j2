      <thead><tr><th scope="col">מרחק (ק״מ)</th><th scope="col">מספר</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.radial %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
