<script>
  GovMap.create({
    container: "#map-main",
    resourceId: {{ inputs.cameras[0].id | tojson }},
    latField: "lat",
    lngField: "lon",
    projection: "wgs84",
    popupFields: [
      { field: "location", label: "מיקום" },
      { field: "address", label: "כתובת" },
      { field: "amount", label: "מצלמות" },
      { field: "angle", label: "זווית" }
    ]
  });
</script>

<script>
  (function () {
    function mk(id) {
      var el = document.getElementById(id);
      if (!el) { return null; }
      var c = echarts.init(el);
      window.addEventListener("resize", function () { c.resize(); });
      return c;
    }
    function hbar(id, d, unit) {
      var c = mk(id);
      if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value", axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 130, overflow: "truncate" } },
        series: [{ type: "bar", name: unit, data: d.values.slice().reverse() }]
      }));
    }
    function col(id, d, unit) {
      var c = mk(id);
      if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 16, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, hideOverlap: true } },
        yAxis: { type: "value" },
        series: [{ type: "bar", name: unit, data: d.values }]
      }));
    }
    hbar("chart-types", {{ model.charts.types | tojson }}, "נקודות");
    hbar("chart-sites", {{ model.charts.sites | tojson }}, "נקודות");
    var f = {{ model.charts.fields | tojson }};
    var cf = mk("chart-fields");
    if (cf) {
      cf.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + "%"; } },
        grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
        yAxis: { type: "category", data: f.names.slice().reverse() },
        series: [{ type: "bar", name: "אחוז", data: f.pct.slice().reverse() }]
      }));
    }
    col("chart-radial", {{ model.charts.radial | tojson }}, "נקודות");
    col("chart-nearest", {{ model.charts.nearest | tojson }}, "נקודות");
    col("chart-lenses", {{ model.charts.lenses | tojson }}, "נקודות");
    col("chart-angle", {{ model.charts.angle | tojson }}, "נקודות");
  })();
</script>

<script>
  (function () {
    var g = {{ model.charts.grid | tojson }};
    var el = document.getElementById("chart-grid");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top" },
      grid: { left: 8, right: 16, top: 16, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: g.x, splitArea: { show: true }, name: "קו אורך", nameLocation: "middle", nameGap: 28 },
      yAxis: { type: "category", data: g.y, splitArea: { show: true }, name: "קו רוחב" },
      visualMap: { min: 0, max: g.max, dimension: 2, calculable: false, orient: "horizontal", left: "center", bottom: 0,
                   inRange: { color: ["#f1f7ff", "#0068f5", "#0b3668"] } },
      series: [{ type: "heatmap", name: "נקודות", data: g.data, label: { show: false } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
