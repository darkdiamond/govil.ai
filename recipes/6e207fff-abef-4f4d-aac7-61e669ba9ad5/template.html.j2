<h1>סיווגי CPC לבקשות פטנט</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.apps.tone }} mb-1" dir="ltr">{{ model.kpis.apps.display }}</div>
    <div class="text-sm text-subtle">בקשות פטנט</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.codes.tone }} mb-1" dir="ltr">{{ model.kpis.codes.display }}</div>
    <div class="text-sm text-subtle">שיוכי סיווג CPC</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.subclasses.tone }} mb-1" dir="ltr">{{ model.kpis.subclasses.display }}</div>
    <div class="text-sm text-subtle">תתי-סעיפים בשימוש</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.multi.tone }} mb-1" dir="ltr">{{ model.kpis.multi.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.multi_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תחומי הטכנולוגיה (סעיפי CPC)</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.sections_note }}</p>
  <div id="chart-sections" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.sections_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.sections_aria }}</caption>
      <thead><tr><th scope="col">סעיף</th><th scope="col">לפי סיווג ראשי</th><th scope="col">סיווג כלשהו בסעיף</th></tr></thead>
      <tbody>
{%- for r in model.tables.sections %}
        <tr><th scope="row">{{ r.name }}</th><td dir="ltr">{{ r.main }}</td><td dir="ltr">{{ r.any }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תתי-הסעיפים הנפוצים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.sub_note }}</p>
  <div id="chart-subclasses" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.sub_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.sub_aria }}</caption>
      <thead><tr><th scope="col">תת-סעיף</th><th scope="col">בקשות</th><th scope="col">מכלל הבקשות</th></tr></thead>
      <tbody>
{%- for r in model.tables.subclasses %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מבנה הסיווג הראשי: סעיפים ומחלקות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.tree_note }}</p>
  <div id="chart-tree" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.tree_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.classes_caption }}</caption>
      <thead><tr><th scope="col">מחלקה</th><th scope="col">תחום</th><th scope="col">סעיף</th><th scope="col">בקשות</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.classes %}
        <tr><th scope="row" dir="ltr">{{ r.code }}</th><td>{{ r.name }}</td><td>{{ r.section }}</td><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

{% if model.flags.has_bands %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תמהיל התחומים לאורך סדר ההגשה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.band_note }} {{ model.labels.mix_minor }}</p>
  <div id="chart-mix" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.mix_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.mix_caption }}</caption>
      <thead><tr><th scope="col">טווח מספרי בקשה</th>{% for g in model.tables.mix_groups %}<th scope="col">{{ g }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for r in model.tables.mix %}
        <tr><th scope="row">{{ r.band }}</th>{% for c in r.cells %}<td dir="ltr">{{ c }}</td>{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">טכנולוגיות במגמה</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.markers_note }}</p>
    <div id="chart-markers" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.markers_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.markers_caption }}</caption>
        <thead><tr><th scope="col">טווח</th>{% for g in model.tables.markers_names %}<th scope="col">{{ g }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in model.tables.markers %}
          <tr><th scope="row">{{ r.band }}</th>{% for c in r.cells %}<td dir="ltr">{{ c }}</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
      </div>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">היקף ועומק הסיווג לפי טווח</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">עמודות: מספר הבקשות בכל טווח מספרים. קו: מספר הסיווגים הממוצע לבקשה.</p>
    <div id="chart-depth" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.depth_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.depth_caption }}</caption>
        <thead><tr><th scope="col">טווח</th><th scope="col">בקשות</th><th scope="col">סיווגים לבקשה</th></tr></thead>
        <tbody>
{%- for r in model.tables.depth %}
          <tr><th scope="row">{{ r.band }}</th><td>{{ r.apps }}</td><td>{{ r.mean }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>
{% endif %}

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">מספר הסיווגים לבקשה</h2>
    </div>
    <div id="chart-per-app" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.per_app_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.per_app_caption }}</caption>
        <thead><tr><th scope="col">סיווגים</th><th scope="col">בקשות</th></tr></thead>
        <tbody>
{%- for r in model.tables.per_app %}
          <tr><th scope="row" dir="ltr">{{ r.bucket }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">כמה סעיפים בבקשה אחת</h2>
    </div>
    <div id="chart-nsec" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.nsec_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.nsec_caption }}</caption>
        <thead><tr><th scope="col">סעיפים שונים</th><th scope="col">בקשות</th></tr></thead>
        <tbody>
{%- for r in model.tables.nsec %}
          <tr><th scope="row" dir="ltr">{{ r.bucket }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">שילובי סעיפים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cooc_note }}</p>
    <div id="chart-cooc" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.cooc_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.cooc_caption }}</caption>
        <thead><tr><th scope="col">סעיף</th>{% for x in model.tables.cooc_x %}<th scope="col" dir="ltr">{{ x }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in model.tables.cooc %}
          <tr><th scope="row">{{ r.sec }}</th>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
      </div>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">סוג ההמצאה לפי שמה</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.kinds_note }}</p>
    <div id="chart-kinds" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.kinds_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.kinds_caption }}</caption>
        <thead><tr><th scope="col">סוג</th><th scope="col">בקשות</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.kinds %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">סיווגי CPC בבקשות לרישום פטנט בישראל</p>
</section>

<script>
  (function () {
    var s = {{ model.charts.sections | tojson }};
    var el = document.getElementById("chart-sections");
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 40, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { formatter: "{value}%", hideOverlap: true } },
      yAxis: { type: "category", data: s.names, inverse: true, axisLabel: { width: Math.min(150, el.clientWidth * 0.4), overflow: "truncate" } },
      series: [
        { type: "bar", name: "לפי סיווג ראשי", data: s.main },
        { type: "bar", name: "סיווג כלשהו בסעיף", data: s.any }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.subclasses | tojson }};
    var el = document.getElementById("chart-subclasses");
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", formatter: function (p) {
        var i = p[0].dataIndex;
        return d.names[i] + "<br>" + d.values[i].toLocaleString("he-IL") + " בקשות (" + d.share[i] + "%)";
      } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: Math.min(170, el.clientWidth * 0.45), overflow: "truncate" } },
      series: [{ type: "bar", name: "בקשות", data: d.values }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var t = {{ model.charts.tree | tojson }};
    var c = echarts.init(document.getElementById("chart-tree"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { formatter: function (p) { return p.name + ": " + p.value.toLocaleString("he-IL") + " בקשות"; } },
      series: [{ type: "treemap", data: t, roam: false, nodeClick: false,
                 breadcrumb: { show: false }, width: "100%", height: "100%",
                 upperLabel: { show: true, height: 22, color: "#fff", fontFamily: "Rubik", overflow: "truncate" },
                 label: { show: true, formatter: "{b}", overflow: "truncate", fontFamily: "Rubik" },
                 levels: [
                   { colorMappingBy: "index", itemStyle: { borderColor: "#fff", borderWidth: 3, gapWidth: 3 } },
                   { colorSaturation: [0.35, 0.6], itemStyle: { borderColorSaturation: 0.7, gapWidth: 1, borderWidth: 1 } }
                 ] }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

{% if model.flags.has_bands %}
<script>
  (function () {
    var m = {{ model.charts.mix | tojson }};
    var c = echarts.init(document.getElementById("chart-mix"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0, type: "scroll" },
      grid: { left: 16, right: 24, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: m.x, boundaryGap: false, axisLabel: { rotate: 35, fontSize: 10 } },
      yAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      series: m.series.map(function (s) {
        return { type: "line", stack: "mix", name: s.name, data: s.data, areaStyle: {}, showSymbol: false, lineStyle: { width: 1 } };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var m = {{ model.charts.markers | tojson }};
    var c = echarts.init(document.getElementById("chart-markers"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 24, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: m.x, axisLabel: { rotate: 35, fontSize: 10 } },
      yAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
      series: m.series.map(function (s) { return { type: "line", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var d = {{ model.charts.depth | tojson }};
    var c2 = echarts.init(document.getElementById("chart-depth"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: 35, fontSize: 10 } },
      yAxis: [
        { type: "value", name: "בקשות" },
        { type: "value", name: "סיווגים לבקשה", splitLine: { show: false } }
      ],
      series: [
        { type: "bar", name: "בקשות", data: d.apps },
        { type: "line", name: "סיווגים לבקשה", yAxisIndex: 1, data: d.mean, itemStyle: { color: "#0b3668" } }
      ]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>
{% endif %}

<script>
  (function () {
    function vbar(id, d, xname) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis" },
        grid: { left: 16, right: 16, top: 32, bottom: 32, containLabel: true },
        xAxis: { type: "category", data: d.names, name: xname, nameLocation: "middle", nameGap: 28 },
        yAxis: { type: "value", name: "בקשות" },
        series: [{ type: "bar", name: "בקשות", data: d.values }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    vbar("chart-per-app", {{ model.charts.per_app | tojson }}, "סיווגים בבקשה");
    vbar("chart-nsec", {{ model.charts.nsec | tojson }}, "סעיפים שונים");
  })();
</script>

<script>
  (function () {
    var h = {{ model.charts.cooc | tojson }};
    var c = echarts.init(document.getElementById("chart-cooc"));
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return h.names[p.value[1]] + " + " + h.names[p.value[0]] + ": " + p.value[2].toLocaleString("he-IL") + " בקשות";
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true } },
      yAxis: { type: "category", data: h.y, inverse: true, splitArea: { show: true } },
      visualMap: {
        dimension: 2, min: 0, max: h.max, calculable: true,
        orient: "horizontal", left: "center", bottom: 8,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells,
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var k = {{ model.charts.kinds | tojson }};
    var c2 = echarts.init(document.getElementById("chart-kinds"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: k.names, inverse: true },
      series: [{ type: "bar", name: "שיעור הבקשות", data: k.values }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>
