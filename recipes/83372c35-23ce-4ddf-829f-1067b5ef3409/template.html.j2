<h1>רשימת השמאים המכריעים</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור שמאי מכריע לפי שם או יישוב ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות הרשימה: שם השמאי, כתובת ויישוב, טלפון, נייד ודוא״ל</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">שמאים מכריעים ברשימה</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.cities.tone }} mb-1" dir="ltr">{{ model.kpis.cities.display }}</div>
    <div class="text-sm text-subtle">יישובים</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.lead.tone }} mb-1" dir="ltr">{{ model.kpis.lead.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.lead_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.own.tone }} mb-1" dir="ltr">{{ model.kpis.own.display }}</div>
    <div class="text-sm text-subtle">עם דוא״ל בדומיין משרדי עצמאי</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">שמאים מכריעים לפי מחוז</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.dist_note }}</p>
  <div id="chart-districts" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.dist_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.dist_caption }}</caption>
      <thead><tr><th scope="col">מחוז</th><th scope="col">שמאים</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.districts %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">שמאים מכריעים לפי יישוב</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cities_note }}</p>
  <div id="chart-cities" class="h-96 md:h-[460px]" role="img" aria-label="{{ model.labels.cities_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.cities_caption }}</caption>
      <thead><tr><th scope="col">יישוב</th><th scope="col">שמאים</th></tr></thead>
      <tbody>
{%- for r in model.tables.cities %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/list.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">ערוצי התקשרות</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.ch_note }}</p>
    <div id="chart-channels" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.ch_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.ch_caption }}</caption>
        <thead><tr><th scope="col">ערוץ</th><th scope="col">רשומות</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.channels %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">סוג כתובת הדוא״ל</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.mail_note }}</p>
    <div id="chart-mail" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.mail_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.mail_caption }}</caption>
        <thead><tr><th scope="col">סוג</th><th scope="col">שמאים</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.mail %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6" id="directory">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">השמאים המכריעים לפי מחוז ויישוב</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.dir_note }}</p>
  <div class="overflow-x-auto relative">
    <table class="w-full text-sm">
      <caption class="sr-only">{{ model.labels.dir_caption }}</caption>
      <thead><tr><th scope="col">שם השמאי</th><th scope="col">יישוב</th><th scope="col">מחוז</th></tr></thead>
      <tbody>
{%- for r in model.tables.directory %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.city }}</td><td>{{ r.district }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">רשימת השמאים המכריעים</p>
</section>

<script>
  (function () {
    var d = {{ model.charts.districts | tojson }};
    var c = echarts.init(document.getElementById("chart-districts"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        return "מחוז " + echarts.format.encodeHTML(String(p[0].name)) + ": " + p[0].value.toLocaleString("he-IL") + " שמאים";
      } },
      grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, fontSize: 11, rotate: window.innerWidth < 640 ? 35 : 0 } },
      yAxis: { type: "value", name: "שמאים", minInterval: 1 },
      series: [{ type: "bar", name: "שמאים", label: { show: true, position: "top" },
        data: d.values.map(function (v, i) { return { value: v, itemStyle: { color: d.colors[i] } }; }) }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.cities | tojson }};
    var c = echarts.init(document.getElementById("chart-cities"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 32, top: 8, bottom: 24, containLabel: true },
      xAxis: { type: "value", minInterval: 1 },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { fontSize: 11 } },
      series: [{ type: "bar", name: "שמאים", data: d.values, label: { show: true, position: "right" },
        itemStyle: { color: "#0068f5" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.channels | tojson }};
    var c = echarts.init(document.getElementById("chart-channels"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        return echarts.format.encodeHTML(String(p[0].name)) + ": " + p[0].value.toLocaleString("he-IL") + " מתוך " + d.total.toLocaleString("he-IL") + " רשומות";
      } },
      grid: { left: 16, right: 32, top: 8, bottom: 24, containLabel: true },
      xAxis: { type: "value", max: d.total, minInterval: 1 },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [{ type: "bar", name: "רשומות", data: d.values, label: { show: true, position: "right" },
        itemStyle: { color: "#0b3668" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.mail | tojson }};
    var c = echarts.init(document.getElementById("chart-mail"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        return echarts.format.encodeHTML(String(p.name)) + ": " + p.value.toLocaleString("he-IL") + " שמאים (" + p.percent + "%)";
      } },
      legend: { bottom: 0 },
      series: [{ type: "pie", radius: ["40%", "68%"], center: ["50%", "44%"], data: d.items,
        label: { formatter: "{c}" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
