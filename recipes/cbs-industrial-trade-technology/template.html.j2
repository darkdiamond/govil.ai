{% import "gov.j2" as gov %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסמה {{ model.release.date }}</p>
{%- if model.release.headline %}
  <p class="m-0 mb-3 font-semibold text-ink-deep">{{ model.release.headline }}</p>
{%- endif %}
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["exports", "imports", "balance", "exp_change", "high_share", "high_bal"] %}
{%- if model.kpis[key] is defined %}
  {{ gov.kpi(model.kpis[key], model.labels[key ~ "_kpi"]) }}
{%- endif %}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

<section class="card p-5 mb-6">
  {{ gov.head("database", "יצוא, יבוא ומאזן הסחר התעשייתי") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.trend_note }}</p>
  {{ gov.chart("chart-trend", model.labels.trend_aria, "h-72 md:h-96") }}
  {{ gov.table("יצוא, יבוא ומאזן תעשייתי לפי שנה (מיליוני דולרים)", ["שנה", "יצוא", "יבוא", "מאזן"], model.tables.trend, ltr=(1, 2, 3)) }}
</section>

{%- if model.flags.groups %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "המאזן לפי עוצמה טכנולוגית: מי בעודף ומי בגירעון") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.groupbal_note }}</p>
  {{ gov.chart("chart-groupbal", model.labels.groupbal_aria, "h-72 md:h-96") }}
  {{ gov.table("מאזן הסחר לפי עוצמה טכנולוגית (מיליוני דולרים)", model.labels.group_cols, model.tables.groupbal, ltr=range(1, model.labels.group_cols | length) | list) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("list", "היצוא התעשייתי לפי עוצמה טכנולוגית") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.expmix_note }}</p>
  {{ gov.chart("chart-expmix", model.labels.expmix_aria, "h-72 md:h-96") }}
  {{ gov.table("יצוא תעשייתי לפי עוצמה טכנולוגית (מיליוני דולרים)", model.labels.group_cols, model.tables.expmix, ltr=range(1, model.labels.group_cols | length) | list) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("list", "היבוא התעשייתי לפי עוצמה טכנולוגית") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.impmix_note }}</p>
  {{ gov.chart("chart-impmix", model.labels.impmix_aria, "h-72 md:h-96") }}
  {{ gov.table("יבוא תעשייתי לפי עוצמה טכנולוגית (מיליוני דולרים)", model.labels.group_cols, model.tables.impmix, ltr=range(1, model.labels.group_cols | length) | list) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("database", "שיעור הכיסוי: היצוא כאחוז מהיבוא") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.ratio_note }}</p>
  {{ gov.chart("chart-ratio", model.labels.ratio_aria, "h-72 md:h-80") }}
  {{ gov.table("היצוא כאחוז מהיבוא לפי עוצמה טכנולוגית", model.labels.ratio_cols, model.tables.ratio, ltr=range(1, model.labels.ratio_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.indbal %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "המאזן לפי ענף תעשייה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.indbal_note }}</p>
  {{ gov.chart("chart-indbal", model.labels.indbal_aria, "h-[560px]") }}
  {{ gov.table("מאזן הסחר לפי ענף (מיליוני דולרים)", ["ענף", "קבוצה", "יצוא", "יבוא", "מאזן"], model.tables.indbal, ltr=(2, 3, 4)) }}
</section>
{%- endif %}

{%- if model.flags.exptree %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "ממה מורכב היצוא התעשייתי") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.exptree_note }}</p>
  {{ gov.chart("chart-exptree", model.labels.exptree_aria, "h-96 md:h-[460px]") }}
  {{ gov.table("ענפי היצוא הגדולים (מיליוני דולרים)", ["ענף", "קבוצה", "יצוא", "חלק מהיצוא"], model.tables.exptree, ltr=(2, 3)) }}
</section>
{%- endif %}

{%- if model.flags.movers %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "הענפים שהיצוא שלהם זז הכי הרבה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.movers_note }}</p>
  {{ gov.chart("chart-movers", model.labels.movers_aria, "h-[460px]") }}
  {{ gov.table("שינוי ביצוא לפי ענף (מיליוני דולרים)", model.labels.movers_cols, model.tables.movers, ltr=(1, 2, 3, 4)) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>הנתונים מתוך ההודעה השנתית לתקשורת של הלשכה המרכזית לסטטיסטיקה על מאזן היצוא והיבוא התעשייתי לפי עוצמה טכנולוגית. הסכומים במיליוני דולרים, ללא יהלומים.</li>
    <li>הענפים מקובצים לפי סיווג העוצמה הטכנולוגית של OECD ו-Eurostat: טכנולוגיה עילית (למשל תרופות, מחשבים ואלקטרוניקה, כלי טיס), מעורבת עילית, מעורבת מסורתית ומסורתית. המאזן הוא היצוא פחות היבוא.</li>
    <li>כל הודעה מציגה את חמש השנים האחרונות. העמוד מצרף את ההודעות האחרונות, ובשנה שמופיעה בכמה הודעות מוצג הנתון מההודעה החדשה ביותר.</li>
  </ul>
</section>

<script>
  (function () {
    const d = {{ model.charts.trend | tojson }};
    const pal = window.GOVIL_PALETTE;
    const fmt = (v) => v == null ? "" : Math.round(v).toLocaleString("he-IL") + " מיליון $";
    const chart = echarts.init(document.getElementById("chart-trend"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[6], "#dc3545"],
      tooltip: { trigger: "axis", valueFormatter: fmt },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value" },
      series: [
        { type: "bar", name: "יצוא", data: d.exp },
        { type: "bar", name: "יבוא", data: d.imp },
        { type: "line", name: "מאזן", data: d.bal, lineStyle: { width: 3 }, symbolSize: 7 }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- if model.flags.groups %}
  (function () {
    const d = {{ model.charts.groupbal | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-groupbal"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1], pal[2], pal[6]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Math.round(v).toLocaleString("he-IL") + " מיליון $" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 56, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value" },
      series: d.series.map((s) => ({ type: "bar", name: s.name, data: s.data }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const pal = window.GOVIL_PALETTE;
    const fmt = (v) => v == null ? "" : Math.round(v).toLocaleString("he-IL") + " מיליון $";
    [["chart-expmix", {{ model.charts.expmix | tojson }}], ["chart-impmix", {{ model.charts.impmix | tojson }}]].forEach(function (p) {
      const d = p[1];
      const chart = echarts.init(document.getElementById(p[0]));
      chart.setOption(window.GovEcharts.option({
        color: [pal[0], pal[1], pal[2], pal[6]],
        tooltip: { trigger: "axis", valueFormatter: fmt },
        legend: { top: 0 },
        grid: { left: 16, right: 16, top: 56, bottom: 24, containLabel: true },
        xAxis: { type: "category", data: d.x },
        yAxis: { type: "value" },
        series: d.series.map((s) => ({ type: "bar", stack: "all", name: s.name, data: s.data }))
      }));
      window.addEventListener("resize", () => chart.resize());
    });
  })();
  (function () {
    const d = {{ model.charts.ratio | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-ratio"));
    const n = d.series.length;
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1], pal[2], pal[6]].slice(0, n - 1).concat(["#dc3545"]),
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : v.toLocaleString("he-IL") + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 56, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
      series: d.series.map((s, i) => ({
        type: "line", name: s.name, data: s.data, symbolSize: 6,
        lineStyle: i === n - 1 ? { width: 3, type: "dashed" } : { width: 2 },
        markLine: i === 0 ? { silent: true, symbol: "none", label: { show: false }, lineStyle: { color: "#6c757d", type: "dotted" }, data: [{ yAxis: 100 }] } : undefined
      }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.indbal %}
  (function () {
    const d = {{ model.charts.indbal | tojson }};
    const chart = echarts.init(document.getElementById("chart-indbal"));
    chart.setOption(window.GovEcharts.option({
      tooltip: {
        trigger: "axis", axisPointer: { type: "shadow" },
        formatter: (ps) => {
          const p = ps[0];
          return echarts.format.encodeHTML(d.full[p.dataIndex]) + "<br/>" + echarts.format.encodeHTML(d.groups[p.dataIndex]) +
            "<br/>" + Math.round(p.value).toLocaleString("he-IL") + " מיליון $";
        }
      },
      grid: { left: 16, right: 16, top: 8, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 3 },
      yAxis: { type: "category", data: d.names, axisLabel: { width: 120, overflow: "truncate" } },
      series: [{
        type: "bar",
        data: d.values.map((v) => ({ value: v, itemStyle: { color: v >= 0 ? "#198754" : "#dc3545" } }))
      }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.exptree %}
  (function () {
    const d = {{ model.charts.exptree | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-exptree"));
    chart.setOption(window.GovEcharts.option({
      color: pal,
      tooltip: {
        formatter: (p) => echarts.format.encodeHTML(p.name) + "<br/>" +
          Math.round(p.value).toLocaleString("he-IL") + " מיליון $"
      },
      series: [{
        type: "treemap", data: d, roam: false, nodeClick: false,
        breadcrumb: { show: false }, left: 0, right: 0, top: 0, bottom: 0,
        levels: [
          { itemStyle: { borderColor: "#ffffff", borderWidth: 3, gapWidth: 3 }, upperLabel: { show: true, height: 22, color: "#ffffff" } },
          { colorSaturation: [0.35, 0.6], itemStyle: { borderColorSaturation: 0.7, gapWidth: 1, borderWidth: 1 } }
        ],
        upperLabel: { show: true, height: 22 },
        label: { show: true, overflow: "truncate", fontSize: 11 }
      }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.movers %}
  (function () {
    const d = {{ model.charts.movers | tojson }};
    const chart = echarts.init(document.getElementById("chart-movers"));
    chart.setOption(window.GovEcharts.option({
      tooltip: {
        trigger: "axis", axisPointer: { type: "shadow" },
        formatter: (ps) => echarts.format.encodeHTML(d.full[ps[0].dataIndex]) + "<br/>" +
          (ps[0].value > 0 ? "+" : "") + Math.round(ps[0].value).toLocaleString("he-IL") + " מיליון $"
      },
      grid: { left: 16, right: 16, top: 8, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 3 },
      yAxis: { type: "category", data: d.names, axisLabel: { width: 120, overflow: "truncate" } },
      series: [{
        type: "bar",
        data: d.values.map((v) => ({ value: v, itemStyle: { color: v >= 0 ? "#0068f5" : "#dc3545" } }))
      }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
</script>
