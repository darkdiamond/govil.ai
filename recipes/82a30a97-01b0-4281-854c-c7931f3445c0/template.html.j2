{%- macro head(icon, title) %}
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/{{ icon }}.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ title }}</h2>
  </div>
{%- endmacro %}
{%- macro tbl(cap, headers, rows, keys) %}
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ cap }}</caption>
      <thead><tr>{% for h_ in headers %}<th scope="col">{{ h_ }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for r in rows %}
        <tr>{% for k in keys %}{% if loop.first %}<th scope="row">{{ r[k] }}</th>{% else %}<td>{{ r[k] }}</td>{% endif %}{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
{%- endmacro %}
<h1>שמות הרחובות בעיר</h1>

<section class="card p-5 mb-6">
{{ head("info", "תקציר") }}
  <p class="m-0 text-subtle leading-relaxed">{{ model.agent_data.summary_he }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
{%- for key, label in [("total", "רשומות (רחובות, כיכרות, גנים ועוד)"), ("unique", "שמות ראשיים שונים"), ("hoods", "שכונות ואזורים"), ("groups", "קבוצות נושא"), ("types", "סוגי מקומות"), ("nocode", "רשומות ללא קוד רחוב")] %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ label }}</div>
  </div>
{%- endfor %}
</div>

<section class="card p-5 mb-6">
{{ head("circle-check", "תובנות עיקריות") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
{{ head("database", "קבוצות נושא של שמות הרחובות") }}
  <p class="m-0 text-sm text-subtle mb-3">כל שם משויך לקבוצה אחת עיקרית, למשל היסטוריה יהודית, תרבות ומדע או לוחמי ישראל.</p>
  <div id="chart-groups" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.groups_aria }}"></div>
{{ tbl(model.labels.groups_aria, ["קבוצה", "מספר שמות", "נתח"], model.tables.groups, ["name", "n", "share"]) }}
</section>

<section class="card p-5 mb-6">
{{ head("database", "מספר השמות לפי שכונה") }}
  <p class="m-0 text-sm text-subtle mb-3">שכונות ואזורים בעיר, מהגדולה לקטנה לפי מספר הרשומות.</p>
  <div id="chart-hoods" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.hoods_aria }}"></div>
{{ tbl(model.labels.hoods_aria, ["שכונה", "מספר שמות", "נתח"], model.tables.hoods, ["name", "n", "share"]) }}
</section>

<section class="card p-5 mb-6">
{{ head("database", "הרכב הנושאים בכל שכונה") }}
  <p class="m-0 text-sm text-subtle mb-3">נתח כל קבוצת נושא מתוך השמות בשכונה, בשכונות הגדולות ביותר. הצביעה משקפת קבוצה, לא ערך טוב או רע.</p>
  <div id="chart-hood-mix" class="h-80 md:h-[460px]" role="img" data-fallback="explorer" aria-label="{{ model.labels.mix_aria }}"></div>
</section>

<section class="card p-5 mb-6">
{{ head("database", "סוגי המקומות") }}
  <p class="m-0 text-sm text-subtle mb-3">רחוב, כיכר, גן, משעול ועוד, כפי שהם רשומים במאגר.</p>
  <div id="chart-types" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.types_aria }}"></div>
{{ tbl(model.labels.types_aria, ["סוג", "מספר מקומות", "נתח"], model.tables.types, ["name", "n", "share"]) }}
</section>

{%- if model.flags.has_extra %}
<section class="card p-5 mb-6">
{{ head("database", "הקבוצה הנוספת") }}
  <p class="m-0 text-sm text-subtle mb-3">חלק מהשמות משתייכים גם לקבוצה שנייה, למשל חתני פרס ישראל או זוכי פרס נובל.</p>
  <div id="chart-extra" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.extra_aria }}"></div>
{{ tbl(model.labels.extra_aria, ["קבוצה נוספת", "מספר שמות"], model.tables.extra, ["name", "n"]) }}
</section>
{%- endif %}

{%- if model.flags.has_titles %}
<section class="card p-5 mb-6">
{{ head("database", "תארים לפני השם") }}
  <p class="m-0 text-sm text-subtle mb-3">התארים הנפוצים בין הרשומות שבהן מצוין תואר.</p>
  <div id="chart-titles" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.titles_aria }}"></div>
{{ tbl(model.labels.titles_aria, ["תואר", "מספר שמות", "נתח מהרשומות עם תואר"], model.tables.titles, ["name", "n", "share"]) }}
</section>
{%- endif %}

{%- if model.flags.has_title_group %}
<section class="card p-5 mb-6">
{{ head("database", "שיעור הרשומות עם תואר לפי קבוצה") }}
  <p class="m-0 text-sm text-subtle mb-3">בקבוצות עם מספר שמות משמעותי: איזה חלק מהשמות כולל תואר.</p>
  <div id="chart-title-group" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.title_group_aria }}"></div>
{{ tbl(model.labels.title_group_aria, ["קבוצה", "מספר שמות", "שיעור עם תואר (אחוז)"], model.tables.title_group, ["name", "n", "share"]) }}
</section>
{%- endif %}

<script>
  window.__hbar = function (id, names, vals, unit) {
    var el = document.getElementById(id);
    if (!el) return;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v.toLocaleString("en") + unit; } },
      grid: { left: 8, right: 24, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", inverse: true, data: names, axisLabel: { width: 140, overflow: "truncate" } },
      series: [{ type: "bar", data: vals, itemStyle: { color: window.GOVIL_PALETTE[0] }, label: { show: true, position: "right" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  };
</script>
<script>
  (function () { var d = {{ model.charts.groups | tojson }}; window.__hbar("chart-groups", d.names, d.values, ""); })();
  (function () { var d = {{ model.charts.hoods | tojson }}; window.__hbar("chart-hoods", d.names, d.values, ""); })();
  (function () { var d = {{ model.charts.types | tojson }}; window.__hbar("chart-types", d.names, d.values, ""); })();
  (function () { var d = {{ model.charts.extra | tojson }}; window.__hbar("chart-extra", d.names, d.values, ""); })();
  (function () { var d = {{ model.charts.titles | tojson }}; window.__hbar("chart-titles", d.names, d.values, ""); })();
  (function () { var d = {{ model.charts.title_group | tojson }}; window.__hbar("chart-title-group", d.names, d.share, "%"); })();
  (function () {
    var d = {{ model.charts.mix | tojson }};
    var el = document.getElementById("chart-hood-mix");
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + "%"; } },
      legend: { type: "scroll", bottom: 0 },
      grid: { left: 8, right: 16, top: 8, bottom: 40, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", inverse: true, data: d.hoods },
      series: d.names.map(function (n, i) { return { type: "bar", stack: "t", name: n, data: d.series[i] }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
