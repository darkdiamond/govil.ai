<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">העיצום הכספי הוא אמצעי רגולטורי בהליך המנהלי, המעניק סמכות לעובד ברשות מנהלית להטיל קנס כספי בסכומים גבוהים על מי שמפר את הוראות החוק. יתרונותיו של העיצום הכספי הם יעילות, זריזות, חיסכון במשאבים ומידתיות בין המעשה לבין העונש. יעילותו ומהירותו יכולה לשמש גורם מרתיע ולהביא לצמצום השכיחות של הפרת החוק.</p>
</section>

<script>
  (function () {
    function fmtM(v) { return v.toLocaleString("he-IL", { maximumFractionDigits: 2 }) + " מיליון ₪"; }

    var y = {{ model.charts.years | tojson }};
    var c1 = echarts.init(document.getElementById("chart-years"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: y.x, axisLabel: { fontSize: 11 } },
      yAxis: [{ type: "value", name: "עיצומים" },
              { type: "value", name: "מיליון ₪", splitLine: { show: false } }],
      series: [
        { type: "bar", name: "עיצומים", data: y.count },
        { type: "line", name: "סכום לאחר הפחתה", yAxisIndex: 1, data: y.amount,
          tooltip: { valueFormatter: fmtM } }
      ]
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    var q = {{ model.charts.quarters | tojson }};
    var c2 = echarts.init(document.getElementById("chart-quarters"));
    var qs = q.series.map(function (s) {
      return { type: "bar", stack: "n", name: s.name, data: s.data };
    });
    qs.push({ type: "line", name: "סכום לאחר הפחתה", yAxisIndex: 1, data: q.amount,
              itemStyle: { color: "#0c3058" }, tooltip: { valueFormatter: fmtM } });
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 56, bottom: 56, containLabel: true },
      dataZoom: [{ type: "inside", startValue: q.zoom_from },
                 { type: "slider", bottom: 8, height: 18, startValue: q.zoom_from }],
      xAxis: { type: "category", data: q.x, axisLabel: { fontSize: 10 } },
      yAxis: [{ type: "value", name: "עיצומים" },
              { type: "value", name: "מיליון ₪", splitLine: { show: false } }],
      series: qs
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    var l = {{ model.charts.law | tojson }};
    var lab = { width: 170, overflow: "truncate", fontSize: 11 };
    var c1 = echarts.init(document.getElementById("chart-law-count"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 24, top: 8, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: l.names, inverse: true, axisLabel: lab },
      series: [{ type: "bar", name: "עיצומים", data: l.count }]
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    var c2 = echarts.init(document.getElementById("chart-law-amount"));
    c2.setOption(window.GovEcharts.option({
      color: ["#0068f5", "#c3cfe7"],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                 valueFormatter: function (v) { return v.toLocaleString("he-IL", { maximumFractionDigits: 2 }) + " מיליון ₪"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 8, bottom: 48, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: l.names, inverse: true, axisLabel: lab },
      series: [{ type: "bar", stack: "a", name: "לאחר הפחתה", data: l.final },
               { type: "bar", stack: "a", name: "הפחתה", data: l.cut }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });

    var s = {{ model.charts.scatter | tojson }};
    var c3 = echarts.init(document.getElementById("chart-scatter"));
    c3.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        return p.seriesName + "<br>" + p.value[0] + ": " + Math.round(p.value[1]).toLocaleString("he-IL") + " ₪";
      } },
      legend: { top: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 48, bottom: 56, containLabel: true },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 18 }],
      xAxis: { type: "time" },
      yAxis: { type: "log", name: "₪", axisLabel: { formatter: function (v) {
        return v >= 1e6 ? (v / 1e6) + " מ׳" : (v >= 1e3 ? (v / 1e3) + " א׳" : v);
      } } },
      series: s.series.map(function (x) {
        return { type: "scatter", name: x.name, data: x.data, symbolSize: 7,
                 itemStyle: { opacity: 0.75 } };
      })
    }));
    window.addEventListener("resize", function () { c3.resize(); });
  })();
</script>

<script>
  (function () {
    function hbar(id, d, unit, opts) {
      opts = opts || {};
      var x = echarts.init(document.getElementById(id));
      x.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                   valueFormatter: opts.fmt },
        grid: { left: 16, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true,
                 axisLabel: { width: opts.w || 120, overflow: "truncate", fontSize: 11 } },
        series: [{ type: "bar", name: unit, data: d.values }]
      }));
      window.addEventListener("resize", function () { x.resize(); });
      return x;
    }
    hbar("chart-top", {{ model.charts.top | tojson }}, "סכום לאחר הפחתה",
         { w: 140, fmt: function (v) { return v.toLocaleString("he-IL", { maximumFractionDigits: 2 }) + " מיליון ₪"; } });
    hbar("chart-occ", {{ model.charts.occ | tojson }}, "עיצומים");
    hbar("chart-reasons", {{ model.charts.reasons | tojson }}, "עיצומים", { w: 140 });
    hbar("chart-courts", {{ model.charts.courts | tojson }}, "הליכים");

    var dt = {{ model.charts.details | tojson }};
    var cd = echarts.init(document.getElementById("chart-details"));
    cd.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        var i = p.dataIndex;
        return "<div style=\"max-width:260px;white-space:normal\">" + dt.full[i] + "<br>" + dt.laws[i] +
               ": " + p.value.toLocaleString("he-IL") + " עיצומים</div>";
      } },
      grid: { left: 16, right: 24, top: 8, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: dt.names, inverse: true,
               axisLabel: { width: 150, overflow: "truncate", fontSize: 11 } },
      series: [{ type: "bar", name: "עיצומים", data: dt.values }]
    }));
    window.addEventListener("resize", function () { cd.resize(); });

    hbar("chart-ded", {{ model.charts.ded | tojson }}, "עיצומים");
    hbar("chart-repeat", {{ model.charts.repeat | tojson }}, "מפרים");

    var a = {{ model.charts.appeal | tojson }};
    var ca = echarts.init(document.getElementById("chart-appeal"));
    ca.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                 valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 8, bottom: 48, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: a.names, inverse: true,
               axisLabel: { width: 110, overflow: "truncate", fontSize: 11 } },
      series: a.series.map(function (s) {
        var o = { type: "bar", stack: "t", name: s.name, data: s.data };
        if (s.color) { o.itemStyle = { color: s.color }; }
        return o;
      })
    }));
    window.addEventListener("resize", function () { ca.resize(); });
  })();
</script>
