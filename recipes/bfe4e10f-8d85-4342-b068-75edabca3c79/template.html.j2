    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.court_note }}</p>
    <div id="chart-courts" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.court_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.court_caption }}</caption>
        <thead><tr><th scope="col">בית משפט</th><th scope="col">הליכים</th></tr></thead>
