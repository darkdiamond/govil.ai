<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">סטטוס משפטי לפי חוק</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.ap_note }}</p>
    <div id="chart-appeal" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.ap_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
        <table class="mt-2 w-full text-sm">
          <caption class="sr-only">{{ model.labels.ap_caption }}</caption>
          <thead><tr><th scope="col">חוק</th><th scope="col">עיצומים</th>{% for c in model.tables.status_cols %}<th scope="col">{{ c }}</th>{% endfor %}</tr></thead>
          <tbody>
{%- for r in model.tables.appeal %}
            <tr><th scope="row">{{ r.name }}</th><td>{{ r.total }}</td>{% for v in r.shares %}<td dir="ltr">{{ v }}</td>{% endfor %}</tr>
{%- endfor %}
          </tbody>
        </table>
