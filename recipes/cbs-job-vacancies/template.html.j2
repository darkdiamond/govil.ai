{% import "gov.j2" as gov %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסמה {{ model.release.date }}</p>
  <p class="m-0 mb-3 font-semibold text-ink-deep">{{ model.release.headline }}</p>
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["total", "rate", "yoy", "base"] %}
{%- if model.kpis[key] is defined %}
  {{ gov.kpi(model.kpis[key], model.labels[key ~ "_kpi"]) }}
{%- endif %}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

<section class="card p-5 mb-6">
  {{ gov.head("database", "מספר המשרות הפנויות לאורך השנים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.total_note }}</p>
  {{ gov.chart("chart-total", model.labels.total_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.total_caption, ["שנה", "אומדן מקורי", "מנוכה עונתיות", "חודשים בנתונים"], model.tables.total, ltr=(1, 2, 3)) }}
</section>

{%- if model.flags.rate %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "שיעור המשרות הפנויות") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.rate_note }}</p>
  {{ gov.chart("chart-rate", model.labels.rate_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.rate_caption, ["שנה", "ממוצע", "החודש הנמוך", "החודש הגבוה"], model.tables.rate, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

{%- if model.flags.season %}
<section class="card p-5 mb-6">
  {{ gov.head("calendar", "משרות פנויות לפי חודש ושנה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.season_note }}</p>
  {{ gov.chart("chart-season", model.labels.season_aria, "h-80 md:h-[460px]") }}
  {{ gov.table(model.labels.season_caption, ["חודש"] + model.labels.season_years, model.tables.season, ltr=range(1, model.labels.season_years | length + 1) | list) }}
</section>
{%- endif %}

{%- if model.flags.sectors %}
<section class="card p-5 mb-6">
  {{ gov.head("chart-bar", "משרות פנויות לפי קבוצת ענפים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.sectors_note }}</p>
  {{ gov.chart("chart-sectors", model.labels.sectors_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.sectors_caption, ["קבוצת ענפים", "משרות פנויות", "חלק מהסך", "שינוי בשנה", "לעומת " ~ model.labels.base_year], model.tables.sectors, ltr=(1, 2, 3, 4)) }}
</section>
{%- endif %}

{%- if model.flags.index %}
<section class="card p-5 mb-6">
  {{ gov.head("trending-up", "באילו ענפים הביקוש לעובדים גדל") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.index_note }}</p>
  {{ gov.chart("chart-index", model.labels.index_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.index_caption, ["קבוצת ענפים", "ממוצע " ~ model.labels.base_year, "ממוצע השנה האחרונה", "שינוי"], model.tables.index, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

{%- if model.flags.size %}
<section class="card p-5 mb-6">
  {{ gov.head("building-2", "משרות פנויות לפי גודל העסק") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.size_note }}</p>
  {{ gov.chart("chart-size", model.labels.size_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.size_caption, ["שנה"] + model.labels.size_cols + ["חודשים בנתונים"], model.tables.size, ltr=range(1, model.labels.size_cols | length + 2) | list) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("chart-bar", "החלוקה לפי גודל העסק בחודש האחרון") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.size_mix_note }}</p>
  {{ gov.chart("chart-size-mix", model.labels.size_mix_aria, "h-72 md:h-80") }}
  {{ gov.table(model.labels.size_mix_caption, ["גודל העסק", "משרות פנויות", "חלק מהסך", "שינוי בשנה"], model.tables.size_mix, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>סקר המשרות הפנויות של הלמ"ס נערך בעסקים שמעסיקים חמש משרות שכיר או יותר. משרה פנויה היא משרה שהמעסיק מחפש לה עובד באופן פעיל, מחוץ לעסק.</li>
    <li>שיעור המשרות הפנויות הוא המשרות הפנויות חלקי סך המשרות (המאוישות והפנויות).</li>
    <li>מנוכה עונתיות: הנתון אחרי נטרול התנודות שחוזרות כל שנה באותו חודש, כך שאפשר להשוות בין חודשים סמוכים. קו המגמה מנטרל גם תנודות חד-פעמיות.</li>
    <li>ההודעה מתפרסמת מדי חודש ומכסה שלושה חודשים אחרונים. נתוני החודשים האחרונים ארעיים והלמ"ס מעדכנת אותם בהודעות הבאות, והעמוד מציג תמיד את הגרסה האחרונה.</li>
  </ul>
</section>

<script>
  (function () {
    const d = {{ model.charts.total | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-total"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[6], pal[0], pal[1]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value" },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 20 }],
      series: [
        { type: "line", name: "אומדן מקורי", data: d.orig, showSymbol: false, lineStyle: { width: 1, type: "dashed" } },
        { type: "line", name: "מנוכה עונתיות", data: d.sa, showSymbol: false, lineStyle: { width: 2 } }
{%- if model.flags.trend %},
        { type: "line", name: "מגמה", data: d.trend, showSymbol: false, lineStyle: { width: 3 } }
{%- endif %}
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- if model.flags.rate %}
  (function () {
    const d = {{ model.charts.rate | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-rate"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[6], pal[2], pal[1]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 2 }) + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: (v) => v + "%" } },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 20 }],
      series: [
        { type: "line", name: "אומדן מקורי", data: d.orig, showSymbol: false, lineStyle: { width: 1, type: "dashed" } },
        { type: "line", name: "מנוכה עונתיות", data: d.sa, showSymbol: false, lineStyle: { width: 2 } }
{%- if model.flags.trend %},
        { type: "line", name: "מגמה", data: d.trend, showSymbol: false, lineStyle: { width: 3 } }
{%- endif %}
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.season %}
  (function () {
    const d = {{ model.charts.season | tojson }};
    const chart = echarts.init(document.getElementById("chart-season"));
    chart.setOption(window.GovEcharts.option({
      tooltip: {
        position: "top",
        formatter: (p) => echarts.format.encodeHTML(d.months[p.value[0]] + " " + d.years[p.value[1]]) +
          "<br>" + Number(p.value[2]).toLocaleString("he-IL") + " משרות פנויות"
      },
      grid: { left: 8, right: 8, top: 8, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: d.months, splitArea: { show: true }, axisLabel: { interval: 0, fontSize: 10 } },
      yAxis: { type: "category", data: d.years, splitArea: { show: true } },
      visualMap: {
        min: d.min, max: d.max, dimension: 2, calculable: false, orient: "horizontal", left: "center", bottom: 0,
        itemHeight: 120, inRange: { color: ["#f1f7ff", "#7fb2fa", "#0068f5", "#0b3668"] },
        formatter: (v) => Number(Math.round(v)).toLocaleString("he-IL")
      },
      series: [{ type: "heatmap", data: d.cells, emphasis: { itemStyle: { borderColor: "#0c3058", borderWidth: 1 } } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.sectors %}
  (function () {
    const d = {{ model.charts.sectors | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-sectors"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1], pal[2], pal[3]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 56, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.x, boundaryGap: false },
      yAxis: { type: "value" },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 20 }],
      series: d.names.map((n, k) => ({
        type: "line", name: n, data: d.series[k], stack: "all", areaStyle: { opacity: 0.6 },
        showSymbol: false, lineStyle: { width: 1 }
      }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.index %}
  (function () {
    const d = {{ model.charts.index | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-index"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1], pal[2], pal[3]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 56, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", scale: true },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 20 }],
      series: d.names.map((n, k) => ({
        type: "line", name: n, data: d.series[k], showSymbol: false, lineStyle: { width: 2 },
        markLine: k === 0 ? { silent: true, symbol: "none", data: [{ yAxis: 100 }], label: { show: false }, lineStyle: { color: "#6c757d", type: "dashed" } } : undefined
      }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.size %}
  (function () {
    const d = {{ model.charts.size | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-size"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[3], pal[2], pal[1], pal[0]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 56, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.years },
      yAxis: { type: "value" },
      series: d.names.map((n, k) => ({ type: "bar", name: n, data: d.series[k], stack: "all" }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.size_mix | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-size-mix"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[3], pal[2], pal[1], pal[0]],
      tooltip: {
        trigger: "item",
        formatter: (p) => echarts.format.encodeHTML(p.name) + "<br>" + Number(p.value).toLocaleString("he-IL") + " (" + p.percent + "%)"
      },
      legend: { bottom: 0 },
      series: [{
        type: "pie", radius: ["40%", "68%"], center: ["50%", "45%"], data: d,
        label: { formatter: (p) => p.percent.toFixed(1) + "%" }
      }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
</script>
