  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.country_note }}</p>
  <div id="chart-country" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.country_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="ki-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.country_aria }}</caption>
        <thead><tr><th scope="col">ארץ מקור</th><th scope="col" class="num">מוצרים</th><th scope="col" class="num">שיעור</th><th scope="col" class="num">תעודות</th></tr></thead>
        <tbody>
{%- for r in model.tables.country %}
          <tr><th scope="row" class="font-normal">{{ r.name }}</th><td class="num">{{ r.n }}</td><td class="num">{{ r.share }}</td><td class="num">{{ r.certs }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>

