{%- macro head(title, icon="database") -%}
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/{{ icon }}.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ title }}</h2>
  </div>
{%- endmacro -%}
{%- macro table(caption, col_name, col_value, chart, fmt="int") -%}
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ caption }}</caption>
      <thead><tr><th scope="col">{{ col_name }}</th><th scope="col">{{ col_value }}</th></tr></thead>
      <tbody>
{%- for name in chart.names %}
        <tr><th scope="row">{{ name }}</th><td>{% if fmt == "int" %}{{ chart["values"][loop.index0] | fmt_int }}{% else %}{{ chart["values"][loop.index0] | fmt_num }}{% endif %}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
{%- endmacro -%}
<h1>רשימת האגודות השיתופיות</h1>

<section class="card p-5 mb-6">
  {{ head("תקציר", "info") }}
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">אגודות שנרשמו אי-פעם</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.active.tone }} mb-1" dir="ltr">{{ model.kpis.active.display }}</div>
    <div class="text-sm text-subtle">אגודות פעילות</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.liquidation.tone }} mb-1" dir="ltr">{{ model.kpis.liquidation.display }}</div>
    <div class="text-sm text-subtle">אגודות בהליך פירוק</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.new_full.tone }} mb-1" dir="ltr">{{ model.kpis.new_full.display }}</div>
    <div class="text-sm text-subtle">אגודות חדשות ב-{{ model.labels.full_year }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.closed_full.tone }} mb-1" dir="ltr">{{ model.kpis.closed_full.display }}</div>
    <div class="text-sm text-subtle">אגודות שנסגרו ב-{{ model.labels.full_year }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  {{ head("תובנות עיקריות", "circle-check") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  {{ head("רישום אגודות לפי שנה, ומצבן היום") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.years_note }}</p>
  <div id="chart-years" class="h-72 md:h-96" role="img" data-fallback="explorer" aria-label="{{ model.labels.years_aria }}"></div>
</section>

<section class="card p-5 mb-6">
  {{ head("תמהיל הסוגים לפי עשור הרישום") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.decades_note }}</p>
  <div id="chart-decades" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.decades_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.decades_aria }}</caption>
        <thead><tr><th scope="col">עשור</th>{% for nm in model.charts.decades.names %}<th scope="col">{{ nm }}</th>{% endfor %}<th scope="col">סה״כ</th></tr></thead>
        <tbody>
{%- for r in model.charts.decades.rows %}
          <tr><th scope="row">{{ r.label }}</th>{% for c in r.cells %}<td>{{ c | fmt_int }}</td>{% endfor %}<td>{{ r.total | fmt_int }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    {{ head("סטטוס האגודות במרשם", "circle-check") }}
    <div id="chart-status" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.status_aria }}"></div>
    {{ table(model.labels.status_aria, "סטטוס", "אגודות", model.charts.status) }}
  </section>
  <section class="card p-5">
    {{ head("סוג האגודה ומצבה", "building-2") }}
    <div id="chart-types" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.types_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.types_aria }}</caption>
        <thead><tr><th scope="col">סוג ראשי</th><th scope="col">נרשמו</th><th scope="col">פעילות</th><th scope="col">פעילות (%)</th></tr></thead>
        <tbody>
{%- for r in model.charts.types.rows %}
          <tr><th scope="row">{{ r.label }}</th><td>{{ r.total | fmt_int }}</td><td>{{ r.active | fmt_int }}</td><td>{{ r.share | fmt_num }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  {{ head("צורת ההתיישבות והסיווג המשני", "tag") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.secondary_note }}</p>
  <div id="chart-secondary" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.secondary_aria }}"></div>
  {{ table(model.labels.secondary_aria, "סיווג משני", "אגודות פעילות", model.charts.secondary) }}
</section>

{%- if model.flags.closures %}
<section class="card p-5 mb-6">
  {{ head("סגירות וכניסה לפירוק לפי שנה", "triangle-alert") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.closures_note }}</p>
  <div id="chart-closures" class="h-72 md:h-96" role="img" data-fallback="explorer" aria-label="{{ model.labels.closures_aria }}"></div>
</section>
{%- endif %}

{%- if model.flags.lifespan %}
<section class="card p-5 mb-6">
  {{ head("כמה זמן פעלו האגודות שנסגרו", "list") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.lifespan_note }}</p>
  <div id="chart-lifespan" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.lifespan_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.lifespan_aria }}</caption>
      <thead><tr><th scope="col">סוג ראשי</th><th scope="col">נסגרו</th><th scope="col">חציון (שנים)</th><th scope="col">רבעון תחתון</th><th scope="col">רבעון עליון</th></tr></thead>
      <tbody>
{%- for r in model.charts.lifespan.rows %}
        <tr><th scope="row">{{ r.label }}</th><td>{{ r.n | fmt_int }}</td><td>{{ r.median | fmt_num }}</td><td>{{ r.q1 | fmt_num }}</td><td>{{ r.q3 | fmt_num }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{%- endif %}

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    {{ head("יישובים", "map-pin") }}
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.towns_note }}</p>
    <div id="chart-towns" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.towns_aria }}"></div>
    {{ table(model.labels.towns_aria, "יישוב", "אגודות פעילות", model.charts.towns) }}
  </section>
  <section class="card p-5">
    {{ head("חודש הרישום", "database") }}
    <p class="m-0 text-sm text-subtle mb-3">כל שנות המרשם יחד.</p>
    <div id="chart-months" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.months_aria }}"></div>
    {{ table(model.labels.months_aria, "חודש", "אגודות", model.charts.months) }}
  </section>
</div>

<section class="card p-5 mb-6">
  {{ head("שלמות פרטי הכתובת והקשר", "list") }}
  <p class="m-0 text-sm text-subtle mb-3">שיעור האגודות הפעילות שיש להן כל פרט במרשם. הפרטים עצמם מופיעים בטבלת הנתונים שבתחתית העמוד.</p>
  <div id="chart-contact" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.contact_aria }}"></div>
  {{ table(model.labels.contact_aria, "פרט", "אגודות פעילות (%)", model.charts.contact, "num") }}
</section>

<section class="card p-5 mb-6">
  {{ head("תיאור מקורי", "list") }}
  <p class="m-0 text-sm text-subtle whitespace-pre-line">המאגר כולל מידע אודות אגודות שיתופיות שרשומות במדינת ישראל</p>
</section>

<script>
  (function () {
    var STATUS_COLORS = { "פעילה": "#0068f5", "בפירוק": "#9a6700", "סגורה": "#c3cfe7" };
    function sc(name, i) { return STATUS_COLORS[name] || window.GOVIL_PALETTE[(i + 3) % window.GOVIL_PALETTE.length]; }
    function bars(id, d, horizontal, name, unit, colorFn) {
      var c = echarts.init(document.getElementById(id));
      var cat = { type: "category", data: d.names, axisLabel: { interval: 0, width: 130, overflow: "truncate" } };
      var val = { type: "value", splitNumber: horizontal ? 3 : 5, axisLabel: unit ? { formatter: "{value}" + unit } : {} };
      var data = colorFn ? d.values.map(function (v, i) { return { value: v, itemStyle: { color: colorFn(d.names[i], i) } }; }) : d.values;
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", valueFormatter: function (v) { return v.toLocaleString("he-IL") + (unit || ""); } },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: horizontal ? val : cat,
        yAxis: horizontal ? Object.assign({ inverse: true }, cat) : val,
        series: [{ type: "bar", name: name, data: data }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    bars("chart-status", {{ model.charts.status | tojson }}, true, "אגודות", "", sc);
    bars("chart-secondary", {{ model.charts.secondary | tojson }}, true, "אגודות פעילות");
    bars("chart-towns", {{ model.charts.towns | tojson }}, true, "אגודות פעילות");
    bars("chart-months", {{ model.charts.months | tojson }}, true, "אגודות");
    var ct = {{ model.charts.contact | tojson }};
    bars("chart-contact", ct, true, "אגודות פעילות", "%");

    var t = {{ model.charts.types | tojson }};
    var c2 = echarts.init(document.getElementById("chart-types"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { type: "scroll", bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 40, containLabel: true },
      xAxis: { type: "value", splitNumber: 3 },
      yAxis: { type: "category", inverse: true, data: t.names, axisLabel: { interval: 0, width: 130, overflow: "truncate" } },
      series: t.series.map(function (s, i) { return { type: "bar", stack: "all", name: s.name, data: s.data, itemStyle: { color: sc(s.name, i) } }; })
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    var STATUS_COLORS = { "פעילה": "#0068f5", "בפירוק": "#9a6700", "סגורה": "#c3cfe7" };
    function sc(name, i) { return STATUS_COLORS[name] || window.GOVIL_PALETTE[(i + 3) % window.GOVIL_PALETTE.length]; }
    function stacked(id, d, zoom) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { type: "scroll", bottom: 0 },
        grid: { left: 16, right: 16, top: 16, bottom: zoom ? 76 : 40, containLabel: true },
        dataZoom: zoom ? [{ type: "inside" }, { type: "slider", height: 14, bottom: 32 }] : [],
        xAxis: { type: "category", data: d.x },
        yAxis: { type: "value" },
        series: d.series.map(function (s, i) { return { type: "bar", stack: "all", name: s.name, data: s.data, itemStyle: { color: sc(s.name, i) } }; })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    stacked("chart-years", {{ model.charts.years | tojson }}, true);
{%- if model.flags.closures %}
    stacked("chart-closures", {{ model.charts.closures | tojson }}, true);
{%- endif %}

    var dc = {{ model.charts.decades | tojson }};
    var c3 = echarts.init(document.getElementById("chart-decades"));
    c3.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + "%"; } },
      legend: { type: "scroll", bottom: 0 },
      grid: { left: 16, right: 16, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", inverse: true, data: dc.x },
      series: dc.series.map(function (s) { return { type: "bar", stack: "all", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c3.resize(); });
{%- if model.flags.lifespan %}

    var lf = {{ model.charts.lifespan | tojson }};
    var c4 = echarts.init(document.getElementById("chart-lifespan"));
    c4.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item" },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", name: "שנים", nameLocation: "middle", nameGap: 26 },
      yAxis: { type: "category", inverse: true, data: lf.names, axisLabel: { interval: 0, width: 130, overflow: "truncate" } },
      series: [{ type: "boxplot", name: "משך חיים (שנים)", data: lf.box,
                 itemStyle: { color: "#dbe8fb", borderColor: "#0068f5" } }]
    }));
    window.addEventListener("resize", function () { c4.resize(); });
{%- endif %}
  })();
</script>
