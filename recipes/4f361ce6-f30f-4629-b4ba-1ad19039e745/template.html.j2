<h1>פנקס העובדים הסוציאליים</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">עובדים סוציאליים רשומים</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.new.tone }} mb-1" dir="ltr">{{ model.kpis.new.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.new_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.median.tone }} mb-1" dir="ltr">{{ model.kpis.median.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.median_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.cities.tone }} mb-1" dir="ltr">{{ model.kpis.cities.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.cities_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">מספר הנרשמים בכל שנה</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.years_note }}</p>
    <div id="chart-years" data-fallback="explorer" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.years_aria }}"></div>
  </section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">גודל הפנקס לאורך השנים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cum_note }}</p>
    <div id="chart-cumulative" data-fallback="explorer" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.cum_aria }}"></div>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">עונתיות: באילו חודשים נרשמים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.season_note }}</p>
    <div id="chart-season" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.season_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.season_caption }}</caption>
        <thead><tr><th scope="col">חודש</th><th scope="col">רישומים</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.season %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
      </div>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">רישומים לפי חודש ושנה</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.heat_note }}</p>
    <div id="chart-heat" data-fallback="explorer" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.heat_aria }}"></div>
  </section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">באילו ימים בשבוע נרשמים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.dow_note }}</p>
    <div id="chart-dow" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.dow_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.dow_caption }}</caption>
        <thead><tr><th scope="col">יום</th><th scope="col">רישומים</th></tr></thead>
        <tbody>
{%- for r in model.tables.dow %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
      </div>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">ותק בפנקס</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.seniority_note }}</p>
    <div id="chart-seniority" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.seniority_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.seniority_caption }}</caption>
        <thead><tr><th scope="col">ותק (שנים)</th><th scope="col">רשומים</th></tr></thead>
        <tbody>
{%- for r in model.tables.seniority %}
          <tr><th scope="row">{{ r.bucket }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
      </div>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">עובדים סוציאליים לפי ישוב</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cities_note }}</p>
    <div id="chart-cities" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.cities_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.cities_caption }}</caption>
        <thead><tr><th scope="col">ישוב</th><th scope="col">רשומים</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.cities %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
      </div>
    </details>
  </section>

{% if model.flags.has_shift %}
<section class="card p-5 mb-6">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">איך משתנה פיזור הנרשמים בין הישובים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.shift_note }}</p>
    <div id="chart-cityshift" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.shift_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.shift_caption }}</caption>
        <thead><tr><th scope="col">ישוב</th>{% for c in model.tables.shift_cols %}<th scope="col">{{ c }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in model.tables.shift %}
          <tr><th scope="row">{{ r.name }}</th>{% for v in r.vals %}<td dir="ltr">{{ v }}</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
      </div>
    </details>
  </section>
{% endif %}
<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">שמות המשפחה הנפוצים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.surnames_note }}</p>
    <div id="chart-surnames" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.surnames_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.surnames_caption }}</caption>
        <thead><tr><th scope="col">שם משפחה</th><th scope="col">רשומים</th></tr></thead>
        <tbody>
{%- for r in model.tables.surnames %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
      </div>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">שמות פרטיים בדור החדש</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.firsts_note }}</p>
    <div id="chart-firsts" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.firsts_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.firsts_caption }}</caption>
        <thead><tr><th scope="col">שם פרטי</th><th scope="col">נרשמים</th></tr></thead>
        <tbody>
{%- for r in model.tables.firsts %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
      </div>
    </details>
  </section>
</div>


<script>
  (function () {
    function R(c) { window.addEventListener("resize", function () { c.resize(); }); }
    var y = {{ model.charts.years | tojson }};
    var c = echarts.init(document.getElementById("chart-years"));
    var yd = y.y.map(function (v, i) {
      return (y.partial_last && i === y.y.length - 1) ? { value: v, itemStyle: { opacity: 0.55 } } : v;
    });
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 48, right: 16, top: 24, bottom: 56, containLabel: true },
      dataZoom: [{ type: "inside", startValue: y.zoom_from }, { type: "slider", bottom: 8, height: 18, startValue: y.zoom_from }],
      xAxis: { type: "category", data: y.x },
      yAxis: { type: "value", name: "נרשמים" },
      series: [{ type: "bar", name: "נרשמים", data: yd }]
    }));
    R(c);

    var m = {{ model.charts.cumulative | tojson }};
    var c2 = echarts.init(document.getElementById("chart-cumulative"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v.toLocaleString("he-IL"); } },
      grid: { left: 48, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: m.x, axisLabel: { hideOverlap: true } },
      yAxis: { type: "value", name: "רשומים" },
      series: [{ type: "line", name: "רשומים מצטבר", data: m.y, showSymbol: false, areaStyle: { opacity: 0.15 }, lineStyle: { width: 2.5 } }]
    }));
    R(c2);
  })();
</script>

<script>
  (function () {
    function R(c) { window.addEventListener("resize", function () { c.resize(); }); }
    var s = {{ model.charts.season | tojson }};
    var c = echarts.init(document.getElementById("chart-season"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      grid: { left: 48, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: s.x, axisLabel: { fontSize: 10 } },
      yAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
      series: [{ type: "bar", name: "חלק מהרישומים", data: s.y }]
    }));
    R(c);

    var h = {{ model.charts.heat | tojson }};
    var c2 = echarts.init(document.getElementById("chart-heat"));
    c2.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return h.x[p.value[0]] + " " + h.y[p.value[1]] + ": " + p.value[2].toLocaleString("he-IL");
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true }, axisLabel: { fontSize: 10 } },
      yAxis: { type: "category", data: h.y, splitArea: { show: true } },
      visualMap: {
        min: 0, max: h.max, calculable: true, dimension: 2,
        orient: "horizontal", left: "center", bottom: 8,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells,
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    R(c2);

    var d = {{ model.charts.dow | tojson }};
    var c3 = echarts.init(document.getElementById("chart-dow"));
    c3.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 48, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", name: "רישומים" },
      series: [{ type: "bar", name: "רישומים", data: d.y }]
    }));
    R(c3);

    var a = {{ model.charts.seniority | tojson }};
    var c4 = echarts.init(document.getElementById("chart-seniority"));
    c4.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 48, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: a.names, name: "שנים" },
      yAxis: { type: "value", name: "רשומים" },
      series: [{ type: "bar", name: "רשומים", data: a.values }]
    }));
    R(c4);
  })();
</script>

<script>
  (function () {
    function R(c) { window.addEventListener("resize", function () { c.resize(); }); }
    function hbar(id, d, unit) {
      var x = echarts.init(document.getElementById(id));
      x.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis" },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 4, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true },
        series: [{ type: "bar", name: unit, data: d.values }]
      }));
      R(x);
    }
    hbar("chart-cities", {{ model.charts.cities | tojson }}, "רשומים");
    hbar("chart-surnames", {{ model.charts.surnames | tojson }}, "רשומים");
    hbar("chart-firsts", {{ model.charts.firsts | tojson }}, "נרשמים");

{%- if model.flags.has_shift %}
    var t = {{ model.charts.cityshift | tojson }};
    var c = echarts.init(document.getElementById("chart-cityshift"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "value", splitNumber: 4, axisLabel: { formatter: "{value}%", hideOverlap: true } },
      yAxis: { type: "category", data: t.names, inverse: true },
      series: t.series.map(function (s) { return { type: "bar", name: s.name, data: s.data }; })
    }));
    R(c);
{%- endif %}
  })();
</script>
