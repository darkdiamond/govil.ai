{%- if model.flags.map %}
{%- for chunk in model.charts.map.chunks %}
<script type="application/json" id="map-pts-{{ loop.index0 }}">{{ chunk | tojson }}</script>
{%- endfor %}
<script>
  (function () {
    var el = document.getElementById("map-localities");
    if (!el || !window.L) { return; }
    var meta = {{ {"n": model.charts.map.chunks | length, "max": model.charts.map.max, "bounds": model.charts.map.bounds, "districts": model.charts.map.districts, "munis": model.charts.map.munis, "nafot": model.charts.map.nafot} | tojson }};
    var map = L.map(el, { preferCanvas: true, scrollWheelZoom: false, zoomSnap: 0.25 });
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 18, attribution: "© OpenStreetMap" }).addTo(map);
    var fmt = function (v) { return Number(v).toLocaleString("he-IL"); };
    for (var c = 0; c < meta.n; c++) {
      var node = document.getElementById("map-pts-" + c);
      if (!node) { continue; }
      JSON.parse(node.textContent).forEach(function (p) {
        var t = Math.sqrt(p[2] / meta.max);
        var mk = L.circleMarker([p[0], p[1]], {
          radius: 3 + 22 * t, color: "#0b3668", weight: 1, fillColor: "#0068f5", fillOpacity: 0.35
        }).addTo(map);
        var box = document.createElement("div");
        var title = document.createElement("strong");
        title.textContent = p[3];
        box.appendChild(title);
        [["סמל יישוב", String(p[4])], ["מחוז", meta.districts[p[5]]], ["נפה", meta.nafot[p[7]]], ["מעמד", meta.munis[p[6]]], ["תושבים", fmt(p[2])]].forEach(function (row) {
          var line = document.createElement("div");
          line.textContent = row[0] + ": " + row[1];
          box.appendChild(line);
        });
        mk.bindPopup(box);
      });
    }
    map.fitBounds(meta.bounds, { padding: [8, 8] });
  })();
</script>
{%- endif %}

<script>
  (function () {
    var d = {{ model.charts.district | tojson }};
    var el = document.getElementById("chart-district");
    if (!el) { return; }
    var narrow = el.clientWidth < 500;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        return echarts.format.encodeHTML(d.names[i]) + "<br>" + d.pop[i].toLocaleString("he-IL") + " תושבים<br>" + d.n[i].toLocaleString("he-IL") + " יישובים";
      } },
      grid: { left: 16, right: 72, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { show: !narrow, formatter: function (v) { return (v / 1e6).toLocaleString("he-IL") + " מ׳"; } } },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [{ type: "bar", name: "תושבים", data: d.pop, barMaxWidth: 28,
        label: { show: true, position: "right", formatter: function (p) { return p.value.toLocaleString("he-IL"); } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

{%- if model.flags.years %}
<script>
  (function () {
    var d = {{ model.charts.years | tojson }};
    var el = document.getElementById("chart-years");
    if (!el) { return; }
    var narrow = el.clientWidth < 500;
    var c = echarts.init(el);
    var data = d.y.map(function (v, i) {
      return d.break && d.x[i] >= d.break ? { value: v, itemStyle: { color: "#9fc3f8" } } : v;
    });
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        var note = d.break && d.x[i] >= d.break ? "<br>(כולל זרים)" : "";
        return d.x[i] + "<br>" + d.y[i].toLocaleString("he-IL") + " תושבים<br>" + d.n[i].toLocaleString("he-IL") + " יישובים מיושבים" + note;
      } },
      grid: { left: 16, right: 16, top: 24, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", scale: true, axisLabel: { formatter: function (v) { return (v / 1e6).toLocaleString("he-IL") + " מ׳"; } } },
      series: [{ type: "bar", name: "תושבים", data: data, barMaxWidth: 48 }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

{%- if model.flags.dgrowth %}
<script>
  (function () {
    var d = {{ model.charts.dgrowth | tojson }};
    var el = document.getElementById("chart-dgrowth");
    if (!el) { return; }
    var narrow = el.clientWidth < 500;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v.toLocaleString("he-IL") + "%"; } },
      grid: { left: 16, right: 56, top: 36, bottom: 16, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { show: !narrow, formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [{ type: "bar", name: "שינוי באוכלוסייה", data: d.g, barMaxWidth: 26,
        label: { show: true, position: "right", formatter: "{c}%" },
        markLine: { symbol: "none", silent: true, lineStyle: { color: "#0b3668", type: "dashed" },
          label: { position: "end", distance: 6, formatter: "ממוצע ארצי", fontFamily: "Rubik", color: "#0b3668" }, data: [{ xAxis: d.nat }] } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

{%- if model.flags.comp %}
<script>
  (function () {
    var d = {{ model.charts.comp | tojson }};
    var foreign = {{ model.flags.foreign | tojson }};
    var el = document.getElementById("chart-comp");
    if (!el) { return; }
    var narrow = el.clientWidth < 500;
    var c = echarts.init(el);
    var parts = [["יהודים ואחרים", d.jo], ["ערבים", d.arab]];
    if (foreign) { parts.push(["זרים", d.foreign]); }
    var tot = d.names.map(function (_, i) { return parts.reduce(function (s, p) { return s + p[1][i]; }, 0); });
    c.setOption(window.GovEcharts.option({
      color: ["#0068f5", "#0b3668", "#9fc3f8"],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex;
        var out = [echarts.format.encodeHTML(d.names[i])];
        parts.forEach(function (p) {
          out.push(p[0] + ": " + p[1][i].toLocaleString("he-IL") + " (" + (tot[i] ? (100 * p[1][i] / tot[i]).toFixed(1) : "0") + "%)");
        });
        return out.join("<br>");
      } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 40, containLabel: true },
      xAxis: { type: "value", max: 100, splitNumber: narrow ? 2 : 5, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: parts.map(function (p) {
        return { type: "bar", stack: "c", name: p[0], barMaxWidth: 28,
          data: p[1].map(function (v, i) { return tot[i] ? Math.round(1000 * v / tot[i]) / 10 : 0; }) };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

