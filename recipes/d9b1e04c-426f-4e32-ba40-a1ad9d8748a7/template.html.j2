{%- macro head(icon, title) %}
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/{{ icon }}.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ title }}</h2>
  </div>
{%- endmacro %}
{%- macro tbl(caption, heads, rows, keys) %}
  <details class="mt-3">
    <summary class="cursor-pointer text-sm text-brand">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ caption }}</caption>
        <thead><tr class="border-b border-rule text-ink-deep">{% for h in heads %}<th scope="col" class="text-start py-1 pe-3">{{ h }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in rows %}
          <tr class="border-b border-rule"><th scope="row" class="text-start font-normal py-1 pe-3">{{ r[keys[0]] }}</th>{% for k in keys[1:] %}<td class="py-1 pe-3">{{ r[k] }}</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
{%- endmacro %}
<h1>יישובים בישראל: קובץ היישובים וסמלי היישובים של הלמ״ס</h1>

<section class="card p-5 mb-6">
{{ head("info", "תקציר") }}
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }} לכל יישוב: סמל יישוב, מחוז ונפה, מעמד מוניציפלי (עירייה, מועצה מקומית או המועצה האזורית), צורת יישוב, שנת ייסוד, גובה, קואורדינטות ואוכלוסייה.</p>
</section>

<a id="lookup" href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור יישוב לפי שם או סמל יישוב ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות קובץ היישובים: שם יישוב, סמל יישוב, שם יישוב באנגלית, שם מחוז, שם נפה, שם מעמד מונציפאלי (המועצה האזורית) ואשכול רשויות מקומיות.</span>
  </span>
</a>

