    <h2 class="m-0 mb-3 text-base font-semibold text-ink-deep">רום הנביעה לפי אקויפר</h2>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.box_note }}</p>
    <div id="chart-box" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.box_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.box_caption }}</caption>
        <thead><tr><th scope="col">אקויפר</th><th scope="col">מעיינות</th><th scope="col">מינימום</th><th scope="col">חציון</th><th scope="col">מקסימום</th></tr></thead>
        <tbody>
{%- for r in model.tables.box %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.n }}</td><td dir="ltr">{{ r.min }}</td><td dir="ltr">{{ r.med }}</td><td dir="ltr">{{ r.max }}</td></tr>
{%- endfor %}
