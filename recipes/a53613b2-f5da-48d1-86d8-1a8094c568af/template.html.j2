      <tbody>
{%- for r in model.tables.aquifer %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.total }}</td><td>{{ r.reg }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
