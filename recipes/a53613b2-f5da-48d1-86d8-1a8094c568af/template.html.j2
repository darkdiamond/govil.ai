<h1>קטלוג מעיינות בישראל</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור מעיין לפי שם, אקויפר או תא דיווח ←</span>
    <span class="block text-sm text-subtle">חיפוש חי ברשימת המעיינות המלאה: שם המעיין בעברית ובאנגלית, מספר זיהוי, סוג מעיין, שם אקויפר ושם תא דיווח.</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
{%- for key in ["total", "regular", "below", "first"] %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.kpi_labels[key] }}</div>
  </div>
{%- endfor %}
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מפת המעיינות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">כל המעיינות בקטלוג לפי נקודת הנביעה. לחיצה על נקודה מציגה את שם המעיין, הסוג, האקויפר ותא הדיווח.</p>
  <div id="map-main" class="h-72 md:h-[420px]" role="region" aria-label="{{ model.labels.map_aria }}"></div>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <h2 class="m-0 mb-3 text-base font-semibold text-ink-deep">סוג המעיין: מי נמדד</h2>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.type_note }}</p>
    <div id="chart-type" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.type_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.type_caption }}</caption>
        <thead><tr><th scope="col">סוג</th><th scope="col">מעיינות</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.type %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.n }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <h2 class="m-0 mb-3 text-base font-semibold text-ink-deep">מעיינות לפי אזור</h2>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.region_note }}</p>
    <div id="chart-region" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.region_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.region_caption }}</caption>
        <thead><tr><th scope="col">אזור</th><th scope="col">מעיינות</th><th scope="col">נמדדים באופן סדיר</th></tr></thead>
        <tbody>
{%- for r in model.tables.region %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.total }}</td><td>{{ r.reg }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">האקויפרים שמזינים את המעיינות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.aq_note }}</p>
  <div id="chart-aquifer" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.aq_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
