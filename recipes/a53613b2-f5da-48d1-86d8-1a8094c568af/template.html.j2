{%- if model.flags.box %}
<script>
  (function () {
    var d = {{ model.charts.box | tojson }};
    var c = echarts.init(document.getElementById("chart-box"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        var i = p.dataIndex, v = d.data[i];
        return echarts.format.encodeHTML(d.cats[i]) + " (" + d.n[i] + " מעיינות)<br>מינימום: " + v[0] +
          " מ׳<br>חציון: " + Math.round(v[2]) + " מ׳<br>מקסימום: " + v[4] + " מ׳";
      } },
      grid: { left: 16, right: 24, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "value", name: "מ׳" },
      yAxis: { type: "category", data: d.cats, inverse: true, axisLabel: { width: 120, overflow: "truncate" } },
      series: [{ type: "boxplot", name: "רום הנביעה", data: d.data,
        itemStyle: { color: "#dbe8fb", borderColor: "#0068f5" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

<script>
  (function () {
    var d = {{ model.charts.profile | tojson }};
    var c = echarts.init(document.getElementById("chart-profile"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        return echarts.format.encodeHTML(p.value[2]) + "<br>" + echarts.format.encodeHTML(p.seriesName) +
          "<br>רום: " + p.value[0].toLocaleString("he-IL") + " מ׳";
      } },
      legend: { top: 0, textStyle: { fontFamily: "Rubik" } },
      grid: { left: 16, right: 24, top: 40, bottom: 16, containLabel: true },
      xAxis: { type: "value", name: "רום (מ׳)", nameLocation: "middle", nameGap: 28 },
      yAxis: { type: "value", name: "צפון (ק״מ)", scale: true },
      series: d.series.map(function (s) { return { type: "scatter", name: s.name, data: s.data, symbolSize: 6,
        itemStyle: { opacity: 0.75 } }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

{%- if model.flags.offset %}
<script>
  (function () {
    var d = {{ model.charts.offset | tojson }};
    var c = echarts.init(document.getElementById("chart-offset"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v.toLocaleString("he-IL") + " מעיינות"; } },
      grid: { left: 16, right: 16, top: 24, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.cats, axisLabel: { interval: 0, width: 70, overflow: "break" } },
      yAxis: { type: "value", min: 0 },
      series: [{ type: "bar", name: "מעיינות", data: d.values, label: { show: true, position: "top", fontFamily: "Rubik" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}
