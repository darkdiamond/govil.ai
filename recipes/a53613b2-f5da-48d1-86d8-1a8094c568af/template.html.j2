    <div id="chart-profile" data-fallback="explorer" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.profile_aria }}"></div>
  </section>
</div>

{%- if model.flags.offset %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">איפה נמדד המעיין</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.offset_note }}</p>
  <div id="chart-offset" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.offset_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.offset_caption }}</caption>
      <thead><tr><th scope="col">מרחק</th><th scope="col">מעיינות</th><th scope="col">שיעור</th></tr></thead>
