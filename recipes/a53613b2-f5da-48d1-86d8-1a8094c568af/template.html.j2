<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">רשימת המעיינות בישראל הנמדדים על ידי השירות ההידרולוגי</p>
</section>

<script>
  GovMap.create({
    container: "#map-main",
    resourceId: {{ inputs.main[0].id | tojson }},
    latField: "נביעה Y .נ.צ",
    lngField: "נביעה X .נ.צ",
    projection: "itm",
    popupTitleField: "שם מעיין",
    popupFields: [
      { field: "סוג מעיין", label: "סוג" },
      { field: "שם אקויפר", label: "אקויפר" },
      { field: "שם תא דיווח", label: "תא דיווח" },
      { field: "רום הנביעה", label: "רום הנביעה (מ׳)" },
      { field: "תחילת תצפית", label: "תחילת תצפית" }
    ]
  });
</script>

<script>
  (function () {
    var d = {{ model.charts.type | tojson }};
    var c = echarts.init(document.getElementById("chart-type"));
    var data = d.names.map(function (n, i) { return { name: n, value: d.values[i] }; });
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        return echarts.format.encodeHTML(p.name) + "<br>" + p.value.toLocaleString("he-IL") + " מעיינות (" + Math.round(p.percent) + "%)";
      } },
      legend: { bottom: 0, textStyle: { fontFamily: "Rubik" } },
      series: [{ type: "pie", radius: ["40%", "68%"], center: ["50%", "45%"], data: data,
        label: { formatter: "{d}%", fontFamily: "Rubik" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    function stack(id, d, horiz) {
      var el = document.getElementById(id);
      if (!el) return;
      var c = echarts.init(el);
      var cat = { type: "category", data: d.cats, axisLabel: { width: 120, overflow: "truncate" } };
      var val = { type: "value", min: 0 };
      if (horiz) { cat.inverse = true; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
          var i = p[0].dataIndex;
          var s = echarts.format.encodeHTML(d.cats[i]) + ": " + d.totals[i].toLocaleString("he-IL") + " מעיינות";
          p.forEach(function (x) { if (x.value) { s += "<br>" + echarts.format.encodeHTML(x.seriesName) + ": " + x.value.toLocaleString("he-IL"); } });
          return s;
        } },
        legend: { top: 0, textStyle: { fontFamily: "Rubik" } },
        grid: { left: 16, right: 24, top: 40, bottom: 16, containLabel: true },
        xAxis: horiz ? val : cat,
        yAxis: horiz ? cat : val,
        series: d.series.map(function (s) { return { type: "bar", stack: "t", name: s.name, data: s.data }; })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    stack("chart-region", {{ model.charts.region | tojson }}, true);
    stack("chart-aquifer", {{ model.charts.aquifer | tojson }}, true);
    stack("chart-cell", {{ model.charts.cell | tojson }}, true);
  })();
</script>

{%- if model.flags.decade %}
<script>
  (function () {
    var d = {{ model.charts.decade | tojson }};
    var c = echarts.init(document.getElementById("chart-decade"));
    var series = d.series.map(function (s) { return { type: "bar", stack: "t", name: s.name, data: s.data }; });
    series.push({ type: "line", name: "מצטבר", yAxisIndex: 1, data: d.cum, symbol: "circle", symbolSize: 6,
      lineStyle: { color: "#0b3668" }, itemStyle: { color: "#0b3668" } });
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0, textStyle: { fontFamily: "Rubik" } },
      grid: { left: 16, right: 16, top: 48, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.cats, axisLabel: { rotate: 45 } },
      yAxis: [{ type: "value", name: "מעיינות", min: 0 }, { type: "value", name: "מצטבר", min: 0, splitLine: { show: false } }],
      series: series
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

