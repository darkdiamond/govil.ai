<h1>דיגום איכות מים בתחנות הידרומטריות בנחלים</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור תוצאות דיגום לפי תחנה או פרמטר ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: מספר תחנה, שם התחנה בעברית או באנגלית, שנה הידרולוגית, תאריך דגימה וסמל הפרמטר (למשל כלוריד או חנקה).</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">תוצאות מדידה במאגר</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.stations.tone }} mb-1" dir="ltr">{{ model.kpis.stations.display }}</div>
    <div class="text-sm text-subtle">תחנות דיגום</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.events.tone }} mb-1" dir="ltr">{{ model.kpis.events.display }}</div>
    <div class="text-sm text-subtle">אירועי דיגום (תחנה ותאריך)</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.span.tone }} mb-1" dir="ltr">{{ model.kpis.span.display }}</div>
    <div class="text-sm text-subtle">טווח שנות הדיגום</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.params.tone }} mb-1" dir="ltr">{{ model.kpis.params.display }}</div>
    <div class="text-sm text-subtle">פרמטרים כימיים ופיזיקליים</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.active.tone }} mb-1" dir="ltr">{{ model.kpis.active.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.active_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.latest.tone }} mb-1" dir="ltr">{{ model.kpis.latest.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.latest_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.cl_median.tone }} mb-1" dir="ltr">{{ model.kpis.cl_median.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.cl_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">היקף הדיגום לאורך השנים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.years_note }}</p>
  <div id="chart-years" data-fallback="explorer" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.years_aria }}"></div>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/list.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">מה נמדד: הפרמטרים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.params_note }}</p>
    <div id="chart-params" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.params_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
        <table class="mt-2 w-full text-sm">
          <caption class="sr-only">{{ model.labels.params_aria }}</caption>
          <thead><tr><th scope="col">פרמטר</th><th scope="col">סמל</th><th scope="col">יחידה</th><th scope="col">מדידות</th><th scope="col">תחנות</th></tr></thead>
          <tbody>
{%- for r in model.tables.params %}
            <tr><th scope="row">{{ r.name }}</th><td dir="ltr">{{ r.code }}</td><td>{{ r.unit }}</td><td>{{ r.n | fmt_int }}</td><td>{{ r.st | fmt_int }}</td></tr>
{%- endfor %}
          </tbody>
        </table>
      </div>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">איפה נמדד: הנחלים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.streams_note }}</p>
    <div id="chart-streams" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.streams_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.streams_aria }}</caption>
        <thead><tr><th scope="col">נחל</th><th scope="col">מדידות</th><th scope="col">תחנות</th></tr></thead>
        <tbody>
{%- for r in model.tables.streams %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.n | fmt_int }}</td><td>{{ r.st | fmt_int }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">התחנות הנדגמות ביותר</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.stations_note }}</p>
  <div id="chart-stations" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.stations_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.stations_aria }}</caption>
        <thead><tr><th scope="col">תחנה</th><th scope="col">מספר זיהוי</th><th scope="col">מדידות</th><th scope="col">אירועי דיגום</th><th scope="col">שנים הידרולוגיות</th></tr></thead>
        <tbody>
{%- for r in model.tables.stations %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.sid }}</td><td>{{ r.n | fmt_int }}</td><td>{{ r.events | fmt_int }}</td><td dir="ltr">{{ r.span }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">תחנות פעילות והיסטוריות</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.activity_note }}</p>
    <div id="chart-activity" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.activity_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.activity_aria }}</caption>
        <thead><tr><th scope="col">עשור הדיגום האחרון</th><th scope="col">תחנות</th></tr></thead>
        <tbody>
{%- for r in model.tables.activity %}
          <tr><th scope="row" dir="ltr">{{ r.dec }}</th><td>{{ r.n | fmt_int }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">עונתיות הדיגום</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.months_note }}</p>
    <div id="chart-months" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.months_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.months_aria }}</caption>
        <thead><tr><th scope="col">חודש</th><th scope="col">אירועי דיגום</th></tr></thead>
        <tbody>
{%- for r in model.tables.months %}
          <tr><th scope="row">{{ r.m }}</th><td>{{ r.n | fmt_int }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

{%- if model.flags.salty %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/triangle-alert.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">המליחות בנחלים: התחנות עם הכלוריד הגבוה ביותר</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.salty_note }}</p>
  <div id="chart-salty" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.salty_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.salty_aria }}</caption>
      <thead><tr><th scope="col">תחנה</th><th scope="col">כלוריד חציוני (מ״ג/ל)</th><th scope="col">דגימות</th></tr></thead>
      <tbody>
{%- for r in model.tables.salty %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.median | fmt_num }}</td><td>{{ r.n | fmt_int }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{%- endif %}

{%- if model.flags.trend %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">כלוריד לאורך עשורים בתחנות הוותיקות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.trend_note }}</p>
  <div id="chart-trend" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.trend_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.trend_aria }}</caption>
        <thead><tr><th scope="col">עשור</th>{% for n in model.tables.trend.names %}<th scope="col">{{ n }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in model.tables.trend.rows %}
          <tr><th scope="row" dir="ltr">{{ r.decade }}</th>{% for v in r.vals %}<td>{% if v is none %}אין{% else %}{{ v | fmt_num }}{% endif %}</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>
{%- endif %}

{%- if model.flags.no3 %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">חנקה בנחלים: התפלגות הריכוזים לפי עשור</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.no3_note }}</p>
  <div id="chart-no3" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.no3_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.no3_aria }}</caption>
        <thead><tr><th scope="col">עשור</th><th scope="col">דגימות</th>{% for b in model.tables.no3.bands %}<th scope="col">{{ b }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in model.tables.no3.rows %}
          <tr><th scope="row" dir="ltr">{{ r.decade }}</th><td>{{ r.n | fmt_int }}</td>{% for v in r.vals %}<td dir="ltr">{{ v | fmt_num }}%</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>
{%- endif %}

{%- if model.flags.heat %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">הרכב היונים הראשיים בתחנות המרכזיות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.heat_note }}</p>
  <div id="chart-heat" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.heat_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.heat_aria }}</caption>
        <thead><tr><th scope="col">תחנה</th>{% for n in model.tables.heat.ions %}<th scope="col">{{ n }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in model.tables.heat.rows %}
          <tr><th scope="row">{{ r.name }}</th>{% for v in r.vals %}<td>{% if v is none %}אין{% else %}{{ v | fmt_num }}{% endif %}</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>
{%- endif %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">מאגר המידע מכיל נתוני איכות מים: פרוט נתונים כימיים עיקריים במי גיאויות וזרימות בסיס בנחלים, אשר נדגמים על ידי השירות ההידרולוגי.</p>
</section>

<script>
  (function () {
    var y = {{ model.charts.years | tojson }};
    var c = echarts.init(document.getElementById("chart-years"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 88, containLabel: true },
      xAxis: { type: "category", data: y.x },
      yAxis: { type: "value", name: "מדידות" },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 32, height: 20 }],
      series: y.series.map(function (s) { return { type: "bar", stack: "all", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var enc = echarts.format.encodeHTML;
    function hbar(id, d, name, extraName, extra, unit) {
      var names = d.names.slice(), values = d.values.slice();
      if (d.other) { names.push("אחר"); values.push(d.other); }
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", formatter: function (ps) {
          var p = ps[0], i = p.dataIndex;
          var s = enc(p.name) + "<br/>" + name + ": " + Number(p.value).toLocaleString("he-IL") + (unit || "");
          if (extra && i < extra.length) { s += "<br/>" + extraName + ": " + Number(extra[i]).toLocaleString("he-IL"); }
          return s;
        } },
        grid: { left: 16, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value" },
        yAxis: { type: "category", data: names, inverse: true,
                 axisLabel: { width: 130, overflow: "truncate" } },
        series: [{ type: "bar", name: name, data: values }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    var st = {{ model.charts.streams | tojson }};
    var ss = {{ model.charts.stations | tojson }};
    hbar("chart-params", {{ model.charts.params | tojson }}, "מדידות", "", null, "");
    hbar("chart-streams", st, "מדידות", "תחנות", st.stations, "");
    hbar("chart-stations", ss, "מדידות", "אירועי דיגום", ss.events, "");
{%- if model.flags.salty %}
    var sl = {{ model.charts.salty | tojson }};
    hbar("chart-salty", sl, "כלוריד חציוני", "דגימות", sl.counts, " מ״ג/ל");
{%- endif %}
  })();
</script>

<script>
  (function () {
    function vbar(id, d, name) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis" },
        grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
        xAxis: { type: "category", data: d.x, axisLabel: { interval: 0, rotate: 45 } },
        yAxis: { type: "value", name: name },
        series: [{ type: "bar", name: name, data: d.y }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    vbar("chart-activity", {{ model.charts.activity | tojson }}, "תחנות");
    vbar("chart-months", {{ model.charts.months | tojson }}, "אירועי דיגום");
  })();
</script>

{%- if model.flags.trend %}
<script>
  (function () {
    var t = {{ model.charts.trend | tojson }};
    var c = echarts.init(document.getElementById("chart-trend"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v === null || v === undefined ? "אין נתון" : Number(v).toLocaleString("he-IL") + " מ״ג/ל"; } },
      legend: { bottom: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 32, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: t.x },
      yAxis: { type: "log", name: "כלוריד, מ״ג/ל" },
      series: t.series.map(function (s) { return { type: "line", name: s.name, data: s.data, connectNulls: false }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

{%- if model.flags.no3 %}
<script>
  (function () {
    var n = {{ model.charts.no3 | tojson }};
    var c = echarts.init(document.getElementById("chart-no3"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return Number(v).toFixed(1) + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: n.x },
      yAxis: { type: "value", max: 100, name: "% מהדגימות" },
      series: n.series.map(function (s) { return { type: "bar", stack: "share", name: s.name + " מ״ג/ל", data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

{%- if model.flags.heat %}
<script>
  (function () {
    var enc = echarts.format.encodeHTML;
    var h = {{ model.charts.heat | tojson }};
    var wide = window.innerWidth >= 768;
    var c = echarts.init(document.getElementById("chart-heat"));
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return enc(h.y[p.value[1]]) + "<br/>" + enc(h.x[p.value[0]]) + ": " + Number(p.value[3]).toLocaleString("he-IL") + " מ״ג/ל";
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true }, axisLabel: { interval: 0, rotate: wide ? 0 : 45 } },
      yAxis: { type: "category", data: h.y, inverse: true, splitArea: { show: true },
               axisLabel: { width: wide ? 160 : 90, overflow: "truncate" } },
      visualMap: {
        min: 0, max: 1, dimension: 2, show: false,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] }
      },
      series: [{ type: "heatmap", data: h.cells,
                 label: { show: wide, fontFamily: "Rubik", fontSize: 10, color: "#0c3058",
                          textBorderColor: "#ffffff", textBorderWidth: 2,
                          formatter: function (p) { return Math.round(p.value[3]).toLocaleString("he-IL"); } },
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}
