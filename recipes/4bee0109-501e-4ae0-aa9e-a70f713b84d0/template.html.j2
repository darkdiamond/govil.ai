<script>
  GovMap.create({
    container: "#map-main",
    resourceId: {{ inputs.main[0].id | tojson }},
    latField: "LAT_START",
    lngField: "LON_START",
    projection: "itm",
    cluster: true,
    popupTitleField: "PTLNAME",
    popupFields: [
      { field: "PTLTYPE", label: "סוג" },
      { field: "AUTHORITY", label: "רשות" },
      { field: "START_", label: "מ" },
      { field: "FINISH", label: "עד" },
      { field: "LENGT", label: "אורך (מטרים)" },
      { field: "FRHR_WK", label: "ימי חול משעה" },
      { field: "TOHR_WK", label: "ימי חול עד שעה" }
    ]
  });
</script>

<script>
  (function () {
    var esc = echarts.format.encodeHTML;
    var fmt = function (v) { return Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }); };
    var P = window.GOVIL_PALETTE;

    var t = {{ model.charts.types | tojson }};
    var c1 = echarts.init(document.getElementById("chart-types"));
    c1.setOption(window.GovEcharts.option({
      color: [P[0], P[4], P[7], P[2]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                 valueFormatter: function (v) { return fmt(v) + " ק\"מ"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 40, containLabel: true },
      xAxis: { type: "value", name: "ק\"מ", splitNumber: 3 },
      yAxis: { type: "category", data: t.names, inverse: true, axisLabel: { interval: 0, fontSize: 11 } },
      series: t.series.map(function (s) {
        return { type: "bar", stack: "t", name: s.name, data: s.data };
      })
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    function hbar(id, d, unit, colors) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: P,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                   formatter: function (ps) {
                     var p = ps[0];
                     var extra = (d.national && d.national[p.dataIndex]) ? " (גוף ארצי או ייעודי)" : "";
                     return esc(p.name) + extra + "<br>" + fmt(p.value) + unit;
                   } },
        grid: { left: 16, right: 56, top: 8, bottom: 16, containLabel: true },
        xAxis: { type: "value", splitNumber: 3 },
        yAxis: { type: "category", data: d.names, inverse: true,
                 axisLabel: { interval: 0, fontSize: 11, width: 130, overflow: "truncate" } },
        series: [{ type: "bar", data: d.values.map(function (v, i) {
                     return colors ? { value: v, itemStyle: { color: colors[i] } } : v;
                   }),
                   label: { show: true, position: "right", fontFamily: "Rubik",
                            formatter: function (p) { return fmt(p.value); } } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }

    hbar("chart-auth", {{ model.charts.auth | tojson }}, " ק\"מ");
    var tr = {{ model.charts.traf | tojson }};
    hbar("chart-traf", tr, " ק\"מ", tr.national.map(function (n) { return n ? P[8] : P[2]; }));
    if (document.getElementById("chart-roads")) {
      hbar("chart-roads", {{ model.charts.roads | tojson }}, " ק\"מ");
    }
    if (document.getElementById("chart-streets")) {
      hbar("chart-streets", {{ model.charts.streets | tojson }}, " ק\"מ");
    }
    hbar("chart-users", {{ model.charts.users | tojson }}, "% מהאורך");
  })();
</script>

<script>
  (function () {
    var esc = echarts.format.encodeHTML;
    var fmt = function (v) { return Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }); };
    var P = window.GOVIL_PALETTE;

    var h = {{ model.charts.hours | tojson }};
    var c = echarts.init(document.getElementById("chart-hours"));
    c.setOption(window.GovEcharts.option({
      color: [P[0], P[4], P[7]],
      tooltip: { trigger: "axis", valueFormatter: function (v) { return fmt(v) + " ק\"מ"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 24, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: h.x, boundaryGap: false, axisLabel: { interval: 2, fontSize: 11 } },
      yAxis: { type: "value", name: "ק\"מ פעילים" },
      series: h.series.map(function (s) {
        return { type: "line", step: "middle", name: s.name, data: s.data, showSymbol: false,
                 areaStyle: { opacity: 0.08 } };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var infra = {{ model.charts.infra | tojson }};
    infra.forEach(function (g, i) {
      var el = document.getElementById("chart-infra-" + (i + 1));
      var ci = echarts.init(el);
      ci.setOption(window.GovEcharts.option({
        color: P,
        tooltip: { trigger: "item", formatter: function (p) {
          return esc(p.name) + "<br>" + fmt(p.value) + " ק\"מ (" + p.percent + "%)";
        } },
        legend: { bottom: 0, type: "scroll" },
        series: [{ type: "pie", radius: ["40%", "68%"], center: ["50%", "42%"],
                   label: { show: false }, data: g.items }]
      }));
      window.addEventListener("resize", function () { ci.resize(); });
    });

    var ln = {{ model.charts.lanes | tojson }};
    var c3 = echarts.init(document.getElementById("chart-lanes"));
    c3.setOption(window.GovEcharts.option({
      color: P,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                 valueFormatter: function (v) { return fmt(v) + " ק\"מ"; } },
      grid: { left: 16, right: 16, top: 24, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: ln.names, axisLabel: { interval: 0, fontSize: 11 } },
      yAxis: { type: "value", name: "ק\"מ" },
      series: [{ type: "bar", name: "אורך", data: ln.values,
                 label: { show: true, position: "top", fontFamily: "Rubik",
                          formatter: function (p) { return fmt(p.value); } } }]
    }));
    window.addEventListener("resize", function () { c3.resize(); });

    var lg = {{ model.charts.length | tojson }};
    var narrow = document.getElementById("chart-length").clientWidth < 500;
    var c4 = echarts.init(document.getElementById("chart-length"));
    c4.setOption(window.GovEcharts.option({
      color: [P[3]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                 valueFormatter: function (v) { return fmt(v) + " מקטעים"; } },
      grid: { left: 16, right: 16, top: 24, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: lg.names, axisLabel: { interval: 0, fontSize: 11, rotate: narrow ? 35 : 0 } },
      yAxis: { type: "value", name: "מקטעים" },
      series: [{ type: "bar", name: "מקטעים", data: lg.values,
                 label: { show: true, position: "top", fontFamily: "Rubik" } }]
    }));
    window.addEventListener("resize", function () { c4.resize(); });

    var tm = {{ model.charts.time | tojson }};
    var el5 = document.getElementById("chart-time");
    if (el5) {
      var c5 = echarts.init(el5);
      c5.setOption(window.GovEcharts.option({
        color: [P[0], P[6]],
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                   valueFormatter: function (v) { return fmt(v) + " מקטעים"; } },
        legend: { bottom: 0 },
        grid: { left: 16, right: 16, top: 24, bottom: 48, containLabel: true },
        xAxis: { type: "category", data: tm.x, axisLabel: { fontSize: 11 } },
        yAxis: { type: "value", name: "מקטעים" },
        series: [{ type: "bar", name: "שנת הפעלה", data: tm.started },
                 { type: "bar", name: "שנת עדכון אחרון", data: tm.changed }]
      }));
      window.addEventListener("resize", function () { c5.resize(); });
    }
  })();
</script>
