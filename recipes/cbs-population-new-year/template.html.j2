{% import "gov.j2" as gov %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסמה {{ model.release.date }}</p>
{%- if model.release.headline %}
  <p class="m-0 mb-3 font-semibold text-ink-deep">{{ model.release.headline }}</p>
{%- endif %}
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in model.kpi_order %}
  {{ gov.kpi(model.kpis[key], model.labels[key ~ "_kpi"]) }}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

<section class="card p-5 mb-6">
  {{ gov.head("database", "מאזן ההגירה הבין-לאומי לפי חודש") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.mig_note }}</p>
  {{ gov.chart("chart-mig", model.labels.mig_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.mig_caption, model.labels.mig_cols, model.tables.mig, ltr=range(1, model.labels.mig_cols | length) | list) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("database", "מאזן ההגירה המצטבר מתחילת השנה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cum_note }}</p>
  {{ gov.chart("chart-cum", model.labels.cum_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.cum_caption, ["שנה", "מאזן הגירה (נפש)", "חודשים בנתונים", "חודשים עם מאזן שלילי"], model.tables.cum, ltr=(1, 2, 3)) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("database", "שיעור התמותה לפי חודש") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.mort_note }}</p>
  {{ gov.chart("chart-mort", model.labels.mort_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.mort_caption, model.labels.mort_cols, model.tables.mort, ltr=range(1, model.labels.mort_cols | length) | list) }}
</section>

{%- if model.flags.dev %}
<section class="card p-5 mb-6">
  {{ gov.head("database", model.labels.dev_head) }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.dev_note }}</p>
  {{ gov.chart("chart-dev", model.labels.dev_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.dev_caption, model.labels.dev_cols, model.tables.dev, ltr=range(1, model.labels.dev_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.avg %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "שיעור התמותה הממוצע לפי תקופה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.avg_note }}</p>
  {{ gov.chart("chart-avg", model.labels.avg_aria, "h-64 md:h-80") }}
  {{ gov.table(model.labels.avg_caption, model.labels.avg_cols, model.tables.avg, ltr=(1, 2)) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>מאזן ההגירה הבין-לאומי: מספר הנכנסים לישראל כדי לגור בה (עולים, תושבים חוזרים ומהגרים אחרים) פחות מספר התושבים שיצאו ממנה לתקופה ממושכת, כפי שאמדה הלמ"ס.</li>
    <li>שיעור התמותה: מספר הפטירות בחודש לכל אלף תושבים. השוואה בין תקופות על אותם חודשים מנטרלת את העונתיות (בחורף שיעור התמותה גבוה יותר).</li>
    <li>נתוני החודשים האחרונים בכל הודעה הם אומדן ראשוני, והלמ"ס מעדכנת אותם בהודעה של השנה הבאה. כשחודש מופיע בכמה הודעות, העמוד מציג את הגרסה העדכנית.</li>
    <li>מספר התושבים הכולל לקוח מהכותרת של ההודעה. פילוח לפי קבוצות אוכלוסייה, לידות ופטירות מופיע בהודעה המלאה ובדוח.</li>
  </ul>
</section>

<script>
  window.__popNum = window.__popNum || function (v) {
    return v == null ? "" : (v < 0 ? "\u200e\u2212" : "") + Math.abs(Number(v)).toLocaleString("he-IL");
  };
  (function () {
    const d = {{ model.charts.mig | tojson }};
    const pal = window.GOVIL_PALETTE;
    const n = d.series.length;
    const chart = echarts.init(document.getElementById("chart-mig"));
    chart.setOption(window.GovEcharts.option({
      color: d.series.map((s, k) => k === n - 1 ? pal[0] : k === n - 2 ? pal[1] : pal[6]),
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : window.__popNum(v) + " נפש" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: (v) => window.__popNum(v) } },
      series: d.series.map((s) => ({ type: "bar", name: s.name, data: s.data }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.cum | tojson }};
    const pal = window.GOVIL_PALETTE;
    const n = d.series.length;
    const chart = echarts.init(document.getElementById("chart-cum"));
    chart.setOption(window.GovEcharts.option({
      color: d.series.map((s, k) => k === n - 1 ? pal[0] : k === n - 2 ? pal[1] : pal[6]),
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : window.__popNum(v) + " נפש" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: (v) => window.__popNum(v) } },
      series: d.series.map((s, k) => ({
        type: "line", name: s.name, data: s.data, showSymbol: false,
        lineStyle: { width: k === n - 1 ? 3 : 2 },
        markLine: k === 0 ? { silent: true, symbol: "none", label: { show: false },
          lineStyle: { color: "#6c757d", type: "dashed" }, data: [{ yAxis: 0 }] } : undefined
      }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.mort | tojson }};
    const pal = window.GOVIL_PALETTE;
    const n = d.series.length;
    const chart = echarts.init(document.getElementById("chart-mort"));
    chart.setOption(window.GovEcharts.option({
      color: d.series.map((s, k) => k === n - 1 ? pal[0] : s.name.indexOf(" ") > 0 ? "#6c757d" : k === n - 2 ? pal[1] : pal[2]),
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toFixed(3) + " לאלף" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 64, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", scale: true },
      series: d.series.map((s, k) => ({
        type: "line", name: s.name, data: s.data, showSymbol: k === n - 1,
        lineStyle: { width: k === n - 1 ? 3 : 2, type: s.name.indexOf(" ") > 0 ? (k === 0 ? "dashed" : "dotted") : "solid" }
      }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- if model.flags.dev %}
  (function () {
    const d = {{ model.charts.dev | tojson }};
    const pal = window.GOVIL_PALETTE;
    const n = d.series.length;
    const chart = echarts.init(document.getElementById("chart-dev"));
    chart.setOption(window.GovEcharts.option({
      color: d.series.map((s, k) => k === n - 1 ? pal[0] : k === n - 2 ? pal[1] : pal[6]),
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : (v > 0 ? "+" : v < 0 ? "\u200e\u2212" : "") + Math.abs(Number(v)).toFixed(1) + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: (v) => (v < 0 ? "\u200e\u2212" : "") + Math.abs(v) + "%" } },
      series: d.series.map((s) => ({ type: "bar", name: s.name, data: s.data }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.avg %}
  (function () {
    const d = {{ model.charts.avg | tojson }};
    const pal = window.GOVIL_PALETTE;
    const n = d.y.length;
    const chart = echarts.init(document.getElementById("chart-avg"));
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toFixed(3) + " לאלף" },
      grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x.map((x) => x.replace(" ", "\n")), axisLabel: { interval: 0, fontSize: 10 } },
      yAxis: { type: "value", min: (v) => Math.floor(v.min * 45) / 50 },
      series: [{
        type: "bar", name: "שיעור תמותה חודשי ממוצע",
        data: d.y.map((v, k) => ({ value: v, itemStyle: { color: k === n - 1 ? pal[0] : pal[6] } })),
        label: { show: true, position: "top", formatter: (p) => Number(p.value).toFixed(3) }
      }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
</script>
