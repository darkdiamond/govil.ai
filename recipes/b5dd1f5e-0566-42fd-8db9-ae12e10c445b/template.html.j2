<h1>ביטוח-נט</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
  <p class="mt-2 mb-0 text-sm text-subtle">{{ model.labels.scope_note }}</p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-brand mb-1">{{ model.kpis.assets.display }}</div>
    <div class="text-sm text-subtle">סך נכסים · {{ model.labels.period }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-brand mb-1">{{ model.kpis.tracks.display }}</div>
    <div class="text-sm text-subtle">מסלולים מדווחים</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-brand mb-1">{{ model.kpis.insurers.display }}</div>
    <div class="text-sm text-subtle">חברות ביטוח</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-brand mb-1">{{ model.kpis.month_yield.display }}</div>
    <div class="text-sm text-subtle">תשואה משוקללת בחודש האחרון</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-brand mb-1">{{ model.kpis.liquid.display }}</div>
    <div class="text-sm text-subtle">נכסים נזילים (משוקלל)</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">היקף הנכסים לפי דור הפוליסות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">סך הנכסים בכל חודש, במיליארדי ₪, לפי תקופת הנפקת הפוליסות.</p>
  <div id="chart-assets" data-fallback="explorer" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.assets_aria }}"></div>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">נתח שוק לפי חברת ביטוח</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">נכסים במיליארדי ₪ בחודש הדיווח האחרון.</p>
    <div id="chart-insurers" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.insurers_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.insurers_caption }}</caption>
        <thead><tr><th scope="col">חברת ביטוח</th><th scope="col">נכסים</th><th scope="col">נתח (%)</th></tr></thead>
        <tbody>
{%- for r in model.tables.insurers %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.assets }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">תשואה שנתית</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">התשואה המצטברת המשוקללת לפי נכסים בכל שנה קלנדרית מלאה. שנים שליליות באדום.</p>
    <div id="chart-annual" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.annual_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.annual_caption }}</caption>
        <thead><tr><th scope="col">שנה</th><th scope="col">תשואה (%)</th></tr></thead>
        <tbody>
{%- for r in model.tables.annual %}
          <tr><th scope="row">{{ r.year }}</th><td>{{ r.ret }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">נכסים לפי סוג מסלול</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">סוג המסלול נגזר משמו (למשל "מניות", "אג״ח ממשלות", "כללי"). מסלולים ששמם אינו מצביע על סוג מסווגים "אחר".</p>
    <div id="chart-types" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.types_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.types_caption }}</caption>
        <thead><tr><th scope="col">סוג מסלול</th><th scope="col">מסלולים</th><th scope="col">נכסים</th><th scope="col">מתחילת השנה (%)</th><th scope="col">חמש שנים (% לשנה)</th></tr></thead>
        <tbody>
{%- for r in model.tables.types %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.tracks }}</td><td>{{ r.assets }}</td><td>{{ r.ytd }}</td><td>{{ r.y5 }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">תשואה לפי סוג מסלול</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">תשואה מתחילת השנה ({{ model.labels.ytd_label }}) ותשואה שנתית ממוצעת לחמש שנים, משוקללות לפי נכסים.</p>
    <div id="chart-type-yield" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.type_yield_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.types_caption }}</caption>
        <thead><tr><th scope="col">סוג מסלול</th><th scope="col">מתחילת השנה (%)</th><th scope="col">חמש שנים (% לשנה)</th></tr></thead>
        <tbody>
{%- for r in model.tables.types %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.ytd }}</td><td>{{ r.y5 }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">דורות הפוליסות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">פוליסות ותיקות ופוליסות חדשות מנוהלות במסלולים נפרדים. תשואה מתחילת השנה ותשואה שנתית ממוצעת לחמש שנים, משוקללות לפי נכסים.</p>
  <div id="chart-vintage" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.vintage_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.vintage_caption }}</caption>
      <thead><tr><th scope="col">דור</th><th scope="col">נכסים</th><th scope="col">מתחילת השנה (%)</th><th scope="col">חמש שנים (% לשנה)</th></tr></thead>
      <tbody>
{%- for r in model.tables.vintage %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.assets }}</td><td>{{ r.ytd }}</td><td>{{ r.y5 }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">תשואה חודשית משוקללת</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">ממוצע תשואות המסלולים, משוקלל לפי נכסים. חודשים שליליים באדום.</p>
    <div id="chart-yields" data-fallback="explorer" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.yields_aria }}"></div>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">תשואה ל-12 חודשים מתגלגלים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">התשואה המצטברת בשנה שהסתיימה בכל חודש.</p>
    <div id="chart-rolling" data-fallback="explorer" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.rolling_aria }}"></div>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">המסלולים הגדולים: תשואה מתחילת השנה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">המסלולים בעלי הנכסים הרבים ביותר בחודש האחרון.</p>
  <div id="chart-tracks" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.tracks_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.tracks_caption }}</caption>
      <thead><tr><th scope="col">מסלול</th><th scope="col">תשואה מתחילת השנה (%)</th><th scope="col">נכסים</th></tr></thead>
      <tbody>
{%- for r in model.tables.tracks %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.ytd }}</td><td>{{ r.assets }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">דמי ניהול</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.fees_note }}</p>
    <div id="chart-fees" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.fees_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.fees_caption }}</caption>
        <thead><tr><th scope="col">שנה</th><th scope="col">מצבירה (%)</th><th scope="col">מהפקדה (%)</th></tr></thead>
        <tbody>
{%- for r in model.tables.fees %}
          <tr><th scope="row">{{ r.year }}</th><td>{{ r.mgmt }}</td><td>{{ r.dep }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">חשיפה למניות, לחו״ל ולמט״ח</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.exposure_note }}</p>
    <div id="chart-exposure" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.exposure_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.exposure_caption }}</caption>
        <thead><tr><th scope="col">תקופה</th>{% for l in model.tables.exposure_labels %}<th scope="col">{{ l }} (%)</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in model.tables.exposure %}
          <tr><th scope="row">{{ r.period }}</th>{% for l in model.tables.exposure_labels %}<td>{{ r[l] }}</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">סיכון מול תשואה (חמש שנים)</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.risk_note }}</p>
    <div id="chart-risk" data-fallback="explorer" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.risk_aria }}"></div>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">תשואה שנתית ממוצעת לפי חברת ביטוח</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">ממוצע שנתי לשלוש ולחמש שנים, משוקלל לפי נכסי המסלולים של כל חברה.</p>
    <div id="chart-ins-yield" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.ins_yield_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.ins_yield_caption }}</caption>
        <thead><tr><th scope="col">חברת ביטוח</th><th scope="col">שלוש שנים (% לשנה)</th><th scope="col">חמש שנים (% לשנה)</th></tr></thead>
        <tbody>
{%- for r in model.tables.ins_yield %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.y3 }}</td><td>{{ r.y5 }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<script>
  (function () {
    function bnFmt(v) { return v === null ? "—" : v.toLocaleString("he-IL") + " מיליארד ₪"; }
    function pctFmt(v) { return v === null ? "—" : v + "%"; }
    function redNeg(arr) { return arr.map(function (v) { return v !== null && v < 0 ? { value: v, itemStyle: { color: "#dc3545" } } : v; }); }

    var a = {{ model.charts.assets | tojson }};
    var c1 = echarts.init(document.getElementById("chart-assets"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: bnFmt },
      legend: { bottom: 0 },
      grid: { left: 56, right: 16, top: 24, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: a.x },
      yAxis: { type: "value", name: "מיליארד ₪" },
      series: a.series.map(function (s) {
        return { type: "line", name: s.name, stack: "total", areaStyle: {}, showSymbol: false, data: s.data };
      })
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    var m = {{ model.charts.insurers | tojson }};
    var c2 = echarts.init(document.getElementById("chart-insurers"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: bnFmt },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", name: "מיליארד ₪" },
      yAxis: { type: "category", data: m.names, inverse: true },
      series: [{ type: "bar", data: m.values }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });

    var y = {{ model.charts.annual | tojson }};
    var c3 = echarts.init(document.getElementById("chart-annual"));
    c3.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: pctFmt },
      grid: { left: 40, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: y.x },
      yAxis: { type: "value", name: "%" },
      series: [{ type: "bar", name: "תשואה שנתית", data: redNeg(y.y) }]
    }));
    window.addEventListener("resize", function () { c3.resize(); });

    var t = {{ model.charts.types | tojson }};
    var c4 = echarts.init(document.getElementById("chart-types"));
    c4.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: bnFmt },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", name: "מיליארד ₪" },
      yAxis: { type: "category", data: t.names, inverse: true },
      series: [{ type: "bar", data: t.values }]
    }));
    window.addEventListener("resize", function () { c4.resize(); });

    var ty = {{ model.charts.type_yield | tojson }};
    var c5 = echarts.init(document.getElementById("chart-type-yield"));
    c5.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: pctFmt },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 56, containLabel: true },
      xAxis: { type: "value", name: "%" },
      yAxis: { type: "category", data: ty.names, inverse: true },
      series: [
        { type: "bar", name: "מתחילת השנה", data: ty.ytd },
        { type: "bar", name: "5 שנים (לשנה)", data: ty.y5 }
      ]
    }));
    window.addEventListener("resize", function () { c5.resize(); });

    var v = {{ model.charts.vintage | tojson }};
    var c6 = echarts.init(document.getElementById("chart-vintage"));
    c6.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: pctFmt },
      legend: { bottom: 0 },
      grid: { left: 40, right: 16, top: 24, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: v.names },
      yAxis: { type: "value", name: "%" },
      series: [
        { type: "bar", name: "מתחילת השנה", data: v.ytd },
        { type: "bar", name: "5 שנים (לשנה)", data: v.y5 }
      ]
    }));
    window.addEventListener("resize", function () { c6.resize(); });
  })();
</script>

<script>
  (function () {
    function pctFmt(v) { return v === null ? "—" : v + "%"; }
    function redNeg(arr) { return arr.map(function (v) { return v !== null && v < 0 ? { value: v, itemStyle: { color: "#dc3545" } } : v; }); }

    var y = {{ model.charts.yields | tojson }};
    var c7 = echarts.init(document.getElementById("chart-yields"));
    c7.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: pctFmt },
      grid: { left: 40, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: y.x },
      yAxis: { type: "value", name: "%" },
      series: [{ type: "bar", name: "תשואה חודשית", data: redNeg(y.y) }]
    }));
    window.addEventListener("resize", function () { c7.resize(); });

    var r = {{ model.charts.rolling | tojson }};
    var c8 = echarts.init(document.getElementById("chart-rolling"));
    c8.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: pctFmt },
      grid: { left: 40, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: r.x },
      yAxis: { type: "value", name: "%" },
      dataZoom: [{ type: "inside" }],
