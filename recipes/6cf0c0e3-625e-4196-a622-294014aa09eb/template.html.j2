  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">ריכוזיות ההיצע</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.lorenz_note }}</p>
    <div id="chart-lorenz" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.lorenz_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.lorenz_caption }}</caption>
        <thead><tr><th scope="col">המוסדות הגדולים</th><th scope="col">שיעור מהמוסדות</th><th scope="col">שיעור מההצעות</th></tr></thead>
        <tbody>
{%- for r in model.tables.lorenz %}
