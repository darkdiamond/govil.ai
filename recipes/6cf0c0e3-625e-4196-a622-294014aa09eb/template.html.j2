<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">איתור קורסים מאושרים למוסדות - חיילים משוחררים</p>
</section>

<script>
  (function () {
    var d = {{ model.charts.district | tojson }};
    var c = echarts.init(document.getElementById("chart-district"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex;
        return d.names[i] + "<br>הצעות: " + d.values[i].toLocaleString("he-IL") +
          "<br>מוסדות: " + d.inst[i].toLocaleString("he-IL") +
          "<br>קורסים שונים: " + d.courses[i].toLocaleString("he-IL") +
          "<br>ישובים: " + d.cities[i].toLocaleString("he-IL");
      } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [{ type: "bar", name: "הצעות קורס", data: d.values, barMaxWidth: 40 }]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var t = {{ model.charts.treemap | tojson }};
    var c2 = echarts.init(document.getElementById("chart-sunburst"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { formatter: function (p) {
        var path = (p.treePathInfo || []).slice(1).map(function (x) { return x.name; }).join(" › ");
        return (path || p.name) + ": " + p.value.toLocaleString("he-IL") + " הצעות";
      } },
      series: [{
        type: "sunburst", data: t, radius: [0, "92%"], center: ["50%", "50%"],
        sort: null, nodeClick: false,
        itemStyle: { borderColor: "#ffffff", borderWidth: 1 },
        levels: [
          {},
          { r0: "0%", r: "42%", label: { rotate: "radial", fontFamily: "Rubik", fontSize: 10, color: "#ffffff",
                                         width: 70, overflow: "break" } },
          { r0: "42%", r: "92%", label: { fontFamily: "Rubik", fontSize: 10, minAngle: 9, color: "#0c3058",
                                          align: "center" },
            itemStyle: { opacity: 0.75 } }
        ]
      }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    function hbar(id, d, unit, extra) {
      var x = echarts.init(document.getElementById(id));
      x.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
          var i = ps[0].dataIndex;
          var s = d.names[i] + "<br>" + unit + ": " + d.values[i].toLocaleString("he-IL");
          return extra ? s + extra(i) : s;
        } },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 4, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true,
                 axisLabel: { width: window.innerWidth < 640 ? 130 : 230, overflow: "truncate" } },
        series: [{ type: "bar", name: unit, data: d.values }]
      }));
      window.addEventListener("resize", function () { x.resize(); });
    }
    var ci = {{ model.charts.cities | tojson }};
    hbar("chart-cities", ci, "הצעות", function (i) {
      return "<br>" + ci.district[i] + "<br>מוסדות: " + ci.inst[i].toLocaleString("he-IL");
    });
    var dm = {{ model.charts.domains | tojson }};
    hbar("chart-domains", dm, "הצעות", function (i) {
      return "<br>קורסים שונים: " + dm.courses[i].toLocaleString("he-IL") +
        "<br>מוסדות: " + dm.inst[i].toLocaleString("he-IL");
    });
    var co = {{ model.charts.courses | tojson }};
    hbar("chart-courses", co, "מוסדות", function (i) {
      return "<br>מחוזות: " + co.reach[i].toLocaleString("he-IL");
    });
    var ins = {{ model.charts.inst | tojson }};
    hbar("chart-inst", ins, "קורסים", function (i) { return "<br>" + ins.city[i]; });
  })();
</script>

<script>
  (function () {
    var h = {{ model.charts.mix | tojson }};
    var c = echarts.init(document.getElementById("chart-mix"));
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return h.y[p.value[1]] + "<br>" + h.x[p.value[0]] + ": " + p.value[2] + "% (" +
          p.value[3].toLocaleString("he-IL") + " הצעות)";
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true },
               axisLabel: { fontSize: 10, interval: 0, width: window.innerWidth < 640 ? 44 : 100, overflow: "break" } },
      yAxis: { type: "category", data: h.y, inverse: true, splitArea: { show: true },
               axisLabel: { fontSize: 10, width: 120, overflow: "truncate" } },
      visualMap: {
        min: 0, max: h.max, calculable: true, dimension: 2,
        orient: "horizontal", left: "center", bottom: 8,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells,
                 label: { show: true, fontSize: 10, color: "#0c3058", textBorderColor: "#ffffff", textBorderWidth: 2,
                          formatter: function (p) { return p.value[2] + "%"; } },
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    function vbar(id, d, xname, yname) {
      var x = echarts.init(document.getElementById(id));
      x.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 40, right: 16, top: 32, bottom: 40, containLabel: true },
        xAxis: { type: "category", data: d.names, name: xname, nameLocation: "middle", nameGap: 36,
                 axisLabel: { interval: 0, fontSize: 10, width: window.innerWidth < 640 ? 32 : 80, overflow: "break" } },
        yAxis: { type: "value", name: yname, min: 0 },
        series: [{ type: "bar", name: yname, data: d.values, barMaxWidth: 48 }]
      }));
      window.addEventListener("resize", function () { x.resize(); });
    }
    vbar("chart-reach", {{ model.charts.reach | tojson }}, "מספר מחוזות", "קורסים");
    vbar("chart-supply", {{ model.charts.supply | tojson }}, "מספר מוסדות", "קורסים");
    vbar("chart-size", {{ model.charts.size | tojson }}, "קורסים מאושרים", "מוסדות");

    var l = {{ model.charts.lorenz | tojson }};
    var c = echarts.init(document.getElementById("chart-lorenz"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", formatter: function (ps) {
        var p = ps[0].value;
        return p[0] + "% מהמוסדות הגדולים<br>" + p[1] + "% מההצעות";
      } },
      grid: { left: 40, right: 16, top: 32, bottom: 40, containLabel: true },
      xAxis: { type: "value", min: 0, max: 100, name: "% מהמוסדות", nameLocation: "middle", nameGap: 28,
               axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "value", min: 0, max: 100, name: "% מההצעות", axisLabel: { formatter: "{value}%" } },
      series: [
        { type: "line", name: "ריכוזיות", data: l.points, showSymbol: false, areaStyle: { opacity: 0.15 } },
        { type: "line", name: "חלוקה שווה", data: [[0, 0], [100, 100]], showSymbol: false,
          lineStyle: { type: "dashed", color: "#6c757d", width: 1 }, itemStyle: { color: "#6c757d" } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
