<h1>איתור קורסים מאושרים למוסדות - חיילים משוחררים</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.offerings.tone }} mb-1" dir="ltr">{{ model.kpis.offerings.display }}</div>
    <div class="text-sm text-subtle">הצעות קורס (מוסד × קורס)</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.courses.tone }} mb-1" dir="ltr">{{ model.kpis.courses.display }}</div>
    <div class="text-sm text-subtle">קורסים שונים</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.institutions.tone }} mb-1" dir="ltr">{{ model.kpis.institutions.display }}</div>
    <div class="text-sm text-subtle">מוסדות מכשירים</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.cities.tone }} mb-1" dir="ltr">{{ model.kpis.cities.display }}</div>
    <div class="text-sm text-subtle">ישובים עם קורס מאושר</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.all_reach.tone }} mb-1" dir="ltr">{{ model.kpis.all_reach.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.all_reach_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.dups.tone }} mb-1" dir="ltr">{{ model.kpis.dups.display }}</div>
    <div class="text-sm text-subtle">רשומות כפולות במקור (נספרו פעם אחת)</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">היצע הקורסים לפי מחוז</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.district_note }}</p>
    <div id="chart-district" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.district_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
        <table class="mt-2 w-full text-sm">
          <caption class="sr-only">{{ model.labels.district_caption }}</caption>
          <thead><tr><th scope="col">מחוז</th><th scope="col">הצעות</th><th scope="col">שיעור</th><th scope="col">מוסדות</th><th scope="col">קורסים שונים</th><th scope="col">ישובים</th></tr></thead>
          <tbody>
{%- for r in model.tables.district %}
            <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td><td>{{ r.inst }}</td><td>{{ r.courses }}</td><td>{{ r.cities }}</td></tr>
{%- endfor %}
          </tbody>
        </table>
      </div>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">מחוזות וישובים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.treemap_note }}</p>
    <div id="chart-sunburst" data-fallback="explorer" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.treemap_aria }}"></div>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
