<h1>ספר סיווג טובין ביבוא</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.lines.tone }} mb-1" dir="ltr">{{ model.kpis.lines.display }}</div>
    <div class="text-sm text-subtle">שורות סיווג בספר המכס</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.chapters.tone }} mb-1" dir="ltr">{{ model.kpis.chapters.display }}</div>
    <div class="text-sm text-subtle">פרקי סיווג</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.exempt.tone }} mb-1" dir="ltr">{{ model.kpis.exempt.display }}</div>
    <div class="text-sm text-subtle">משורות התעריף פטורות ממכס</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.dutiable.tone }} mb-1" dir="ltr">{{ model.kpis.dutiable.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.dut_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.max_rate.tone }} mb-1" dir="ltr">{{ model.kpis.max_rate.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.max_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.ptax.tone }} mb-1" dir="ltr">{{ model.kpis.ptax.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.ptax_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.cond.tone }} mb-1" dir="ltr">{{ model.kpis.cond.display }}</div>
    <div class="text-sm text-subtle">סיווגים מותנים</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.auto.tone }} mb-1" dir="ltr">{{ model.kpis.auto.display }}</div>
    <div class="text-sm text-subtle">שורות בספר האוטונומיה</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מבנה הספר: חלקים ופרקים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.tree_note }}</p>
  <div id="chart-tree" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.tree_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.tree_caption }}</caption>
      <thead><tr><th scope="col">חלק</th><th scope="col">שורות</th><th scope="col">פרקים</th><th scope="col">עם שיעור מכס</th><th scope="col">חייבות במכס</th></tr></thead>
      <tbody>
{%- for r in model.tables.sections %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.lines }}</td><td>{{ r.chapters }}</td><td>{{ r.rated }}</td><td>{{ r.dut }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
