<script>
  (function () {
    var t = {{ model.charts.tree | tojson }};
    var c1 = echarts.init(document.getElementById("chart-tree"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      legend: { show: false },
      tooltip: { formatter: function (p) { return p.name + ": " + Number(p.value).toLocaleString("he-IL") + " שורות"; } },
      series: [{
        type: "treemap", name: "כל הספר", data: t, leafDepth: 1, roam: false,
        top: 8, left: 8, right: 8, bottom: 40,
        breadcrumb: { bottom: 4, itemStyle: { color: "#0068f5" } },
        label: { fontFamily: "Rubik", overflow: "truncate" },
        upperLabel: { show: true, height: 22, fontFamily: "Rubik", color: "#ffffff" },
        levels: [
          { itemStyle: { borderColor: "#ffffff", borderWidth: 2, gapWidth: 2 } },
          { colorSaturation: [0.35, 0.6], itemStyle: { borderColorSaturation: 0.7, gapWidth: 1, borderWidth: 1 } }
        ]
      }]
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    var l = {{ model.charts.levels | tojson }};
    var c2 = echarts.init(document.getElementById("chart-levels"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 3 },
      yAxis: { type: "category", data: l.names, inverse: true, axisLabel: { width: 130, overflow: "truncate" } },
      series: [{ type: "bar", name: "שורות", data: l.values }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });

    var r = {{ model.charts.regime | tojson }};
    var c3 = echarts.init(document.getElementById("chart-regime"));
    c3.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) { return p.name + ": " + Number(p.value).toLocaleString("he-IL") + " (" + p.percent + "%)"; } },
      legend: { bottom: 0, type: "scroll" },
      series: [{ type: "pie", radius: ["40%", "68%"], center: ["50%", "44%"], data: r,
                 label: { show: false }, avoidLabelOverlap: true }]
    }));
    window.addEventListener("resize", function () { c3.resize(); });
  })();
</script>

<script>
  (function () {
    var s = {{ model.charts.sections | tojson }};
    var c = echarts.init(document.getElementById("chart-sections"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex;
        return s.names[i] + "<br>" + s.share[i] + "% · " + Number(s.dut[i]).toLocaleString("he-IL") + " שורות";
      } },
      grid: { left: 16, right: 32, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", max: 100, splitNumber: 4, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: s.names, inverse: true, axisLabel: { interval: 0, width: 140, overflow: "truncate", fontSize: 11 } },
      series: [{ type: "bar", name: "חייבות במכס", data: s.share }]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    function stacked(id, d) {
      var x = echarts.init(document.getElementById(id));
      x.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { bottom: 0, type: "scroll" },
        grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
        xAxis: { type: "value", splitNumber: 3 },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 140, overflow: "truncate", fontSize: 11 } },
        series: d.series.map(function (q) { return { type: "bar", stack: "t", name: q.name, data: q.data }; })
      }));
      window.addEventListener("resize", function () { x.resize(); });
    }
    stacked("chart-chapters", {{ model.charts.chapters | tojson }});
    stacked("chart-ptax", {{ model.charts.ptax | tojson }});
  })();
</script>

