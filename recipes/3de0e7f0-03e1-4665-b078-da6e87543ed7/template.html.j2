        return "מכס: " + h.x[p.value[0]] + "<br>מס קנייה: " + h.y[p.value[1]] + "<br>" + Number(p.value[2]).toLocaleString("he-IL") + " שורות";
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 72, containLabel: true },
