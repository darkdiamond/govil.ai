<script>
  GovMap.create({
    container: "#map-main",
    resourceId: {{ inputs.main[0].id | tojson }},
    latField: "lat",
    lngField: "lon",
    projection: "wgs84",
    popupFields: [
      { field: "streetName", label: "רחוב" },
      { field: "HouseNuber", label: "מספר בית" },
      { field: "letter", label: "סיומת" },
      { field: "StreetCode", label: "קוד רחוב" }
    ]
  });
</script>

<script>
  (function () {
    function mk(id) {
      var el = document.getElementById(id);
      if (!el) { return null; }
      var c = echarts.init(el);
      window.addEventListener("resize", function () { c.resize(); });
      return c;
    }
    function hbar(id, d, unit, lw) {
      var c = mk(id);
      if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value", axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: lw, overflow: "truncate" } },
        series: [{ type: "bar", name: unit, data: d.values.slice().reverse() }]
      }));
    }
    function col(id, d, unit) {
      var c = mk(id);
      if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 16, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, hideOverlap: true } },
        yAxis: { type: "value" },
        series: [{ type: "bar", name: unit, data: d.values }]
      }));
    }
    hbar("chart-top", {{ model.charts.top | tojson }}, "בתים", 120);
    hbar("chart-word", {{ model.charts.word | tojson }}, "רחובות", 100);
    hbar("chart-suf", {{ model.charts.suf | tojson }}, "בתים", 120);
    hbar("chart-qual", {{ model.charts.qual | tojson }}, "רשומות", 150);
    col("chart-size", {{ model.charts.size | tojson }}, "רחובות");
    col("chart-ring", {{ model.charts.ring | tojson }}, "בתים");
    col("chart-orient", {{ model.charts.orient | tojson }}, "רחובות");
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.num | tojson }};
    var el = document.getElementById("chart-num");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0 },
      grid: { left: 8, right: 16, top: 40, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, hideOverlap: true } },
      yAxis: { type: "value" },
      series: [
        { type: "bar", stack: "n", name: "אי-זוגיים", data: d.odd },
        { type: "bar", stack: "n", name: "זוגיים", data: d.even }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var g = {{ model.charts.grid | tojson }};
    var el = document.getElementById("chart-grid");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top" },
      grid: { left: 8, right: 16, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: g.x, splitArea: { show: true }, name: "ק״מ ממערב", nameLocation: "middle", nameGap: 28 },
      yAxis: { type: "category", data: g.y, splitArea: { show: true }, name: "ק״מ מדרום" },
      visualMap: { min: 0, max: g.max, dimension: 2, calculable: false, orient: "horizontal", left: "center", bottom: 0,
                   inRange: { color: ["#f1f7ff", "#0068f5", "#0b3668"] } },
      series: [{ type: "heatmap", name: "בתים", data: g.data, label: { show: false } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var s = {{ model.charts.scatter | tojson }};
    var el = document.getElementById("chart-scatter");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) { return echarts.format.encodeHTML(p.data[2]) + "<br>" + p.data[1] + " בתים, " + p.data[0] + " ק״מ"; } },
      grid: { left: 8, right: 16, top: 16, bottom: 36, containLabel: true },
      xAxis: { type: "value", name: "אורך הפריסה (ק״מ)", nameLocation: "middle", nameGap: 26 },
      yAxis: { type: "value", name: "בתים" },
      series: [{ type: "scatter", name: "רחובות", symbolSize: 6, data: s.data }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
