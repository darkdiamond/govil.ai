      <tr class="border-t border-rule"><th scope="row" class="text-start pe-3 py-1">{{ r.name }}</th><td class="pe-3 py-1">{{ r.holder }}</td><td class="pe-3 py-1 hidden md:table-cell">{{ r.act }}</td><td class="pe-3 py-1">{{ r.crops }}</td><td class="pe-3 py-1">{{ r.uses }}</td></tr>
{%- endfor %}
    </tbody>
  </table>
  </div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">מאגר המכיל את תכשירי הדברה אורגניים, קוטלי עשבים ותכשירים רגילים הניתנים לשימוש בחקלאות. המאגר כולל גם קישור לתווית התכשיר</p>
</section>

<script>
  (function () {
    var t = {{ model.charts.timeline | tojson }};
    var c = echarts.init(document.getElementById("chart-timeline"));
    var last = t.x.length - 1;
    var uses = t.uses.map(function (v, i) {
      return (t.partial && i === last) ? { value: v, itemStyle: { color: "#9a6700" } } : v;
    });
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", formatter: function (ps) {
        var s = ps[0].axisValue + ((t.partial && ps[0].dataIndex === last) ? " (שנה חלקית)" : "");
        ps.forEach(function (p) { s += "<br>" + p.marker + p.seriesName + ": " + Number(p.value).toLocaleString("he-IL"); });
        return s;
      } },
      legend: { bottom: 0 },
      grid: { left: 40, right: 40, top: 32, bottom: 88, containLabel: true },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 28, height: 18 }],
      xAxis: { type: "category", data: t.x },
      yAxis: [{ type: "value", name: "שימושים" }, { type: "value", name: "תכשירים", splitLine: { show: false } }],
      series: [
        { type: "bar", name: "שימושים חדשים", data: uses },
        { type: "line", name: "תכשירים חדשים", yAxisIndex: 1, data: t.products, showSymbol: false }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    function stacked(id, d, unit) {
      var el = document.getElementById(id);
      var ch = echarts.init(el);
      var narrow = el.clientWidth < 500;
      ch.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { bottom: 0, type: "scroll" },
        grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
        xAxis: { type: "value", axisLabel: { rotate: narrow ? 45 : 0, fontSize: narrow ? 10 : 12 } },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 120, overflow: "truncate" } },
        series: d.series.map(function (s) { return { type: "bar", stack: "a", name: s.name, data: s.data }; })
      }));
      window.addEventListener("resize", function () { ch.resize(); });
    }
    stacked("chart-activity", {{ model.charts.activity | tojson }}, "תכשירים");
    stacked("chart-tox", {{ model.charts.tox | tojson }}, "תכשירים");

    var b = {{ model.charts.bees | tojson }};
    var bc = echarts.init(document.getElementById("chart-bees"));
    var beeColors = ["#dc3545", "#e8838d", "#f3c3c8", "#c3cfe7", "#0068f5", "#dbe8fb"];
    bc.setOption(window.GovEcharts.option({
      color: beeColors,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex, s = ps[0].axisValue;
        ps.forEach(function (p, k) { s += "<br>" + p.marker + p.seriesName + ": " + p.value + "% (" + b.counts[i][k].toLocaleString("he-IL") + ")"; });
        return s;
      } },
      legend: { bottom: 0, type: "scroll" },
      grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "value", max: 100, interval: 25, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: b.rows, inverse: true, axisLabel: { width: 120, overflow: "truncate" } },
      series: b.series.map(function (s) { return { type: "bar", stack: "a", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { bc.resize(); });
  })();
</script>

<script>
  (function () {
    function hbar(id, d, unit, tip, lw) {
      var el = document.getElementById(id);
      var c = echarts.init(el);
      var narrow = el.clientWidth < 500;
      lw = lw ? Math.min(lw, Math.round(el.clientWidth * 0.4)) : 130;
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: tip || undefined },
        grid: { left: 16, right: narrow ? 36 : 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", axisLabel: { show: !narrow } },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: lw, overflow: "truncate" } },
        series: [{ type: "bar", name: unit, data: d.values,
                   label: { show: narrow, position: "right", fontSize: 10, color: "#0c3058" } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    hbar("chart-env", {{ model.charts.env | tojson }}, "תכשירים");
    hbar("chart-ai", {{ model.charts.ai | tojson }}, "תכשירים");
    var m = {{ model.charts.moa | tojson }};
    hbar("chart-moa", m, "תכשירים", function (ps) {
      var p = ps[0];
      return p.axisValue + "<br>" + m.desc[p.dataIndex] + "<br>" + p.value.toLocaleString("he-IL") + " תכשירים";
    });
    hbar("chart-crops", {{ model.charts.crops | tojson }}, "תכשירים");
    hbar("chart-pests", {{ model.charts.pests | tojson }}, "תכשירים");
    hbar("chart-reentry", {{ model.charts.reentry | tojson }}, "תכשירים");
    hbar("chart-forms", {{ model.charts.forms | tojson }}, "תכשירים");
    hbar("chart-holders", {{ model.charts.holders | tojson }}, "תכשירים", null, 210);
    hbar("chart-makers", {{ model.charts.makers | tojson }}, "תכשירים", null, 210);
  })();
</script>

<script>
  (function () {
    var h = {{ model.charts.heat | tojson }};
    var el = document.getElementById("chart-heat");
    var narrow = el.clientWidth < 600;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return h.y[p.value[1]] + " · " + h.x[p.value[0]] + ": " + p.value[2].toLocaleString("he-IL") + " תכשירים";
      } },
      grid: { left: 8, right: 8, top: 8, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true },
               axisLabel: narrow ? { interval: 0, rotate: 50, width: 80, overflow: "truncate", fontSize: 10 }
                                 : { interval: 0, width: 90, overflow: "break" } },
      yAxis: { type: "category", data: h.y, inverse: true, splitArea: { show: true },
               axisLabel: { interval: 0, fontSize: narrow ? 10 : 12 } },
      visualMap: {
        min: 0, max: h.max, calculable: true, dimension: 2,
        orient: "horizontal", left: "center", bottom: 4, itemHeight: 120,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells, label: { show: true, fontFamily: "Rubik", fontSize: narrow ? 8 : 11 },
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var p = {{ model.charts.phi | tojson }};
    var c2 = echarts.init(document.getElementById("chart-phi"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 40, right: 16, top: 32, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: p.names, axisLabel: { interval: 0, rotate: 30 } },
      yAxis: { type: "value", name: "שימושים" },
      series: [{ type: "bar", name: "שימושים", data: p.values }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });

    var bx = {{ model.charts.box | tojson }};
    var c3 = echarts.init(document.getElementById("chart-box"));
    c3.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (q) {
        var v = q.value;
        return q.name + "<br>עשירון תחתון: " + v[1] + "<br>רבעון תחתון: " + v[2] + "<br>חציון: " + v[3] +
               "<br>רבעון עליון: " + v[4] + "<br>עשירון עליון: " + v[5] + " (ימים)";
      } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 4, axisLabel: { formatter: "{value}" } },
      yAxis: { type: "category", data: bx.names, inverse: true },
      series: [{ type: "boxplot", name: "ימי המתנה", data: bx.box,
                 itemStyle: { color: "#dbe8fb", borderColor: "#0068f5" } }]
    }));
    window.addEventListener("resize", function () { c3.resize(); });
  })();
</script>
