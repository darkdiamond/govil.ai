{% if model.charts.tree %}
<script>
  (function () {
    const d = {{ model.charts.tree | tojson }};
    const c = echarts.init(document.getElementById("chart-tree"));
    const nf = function (v) { return Number(v).toLocaleString("en-US"); };
    c.setOption(window.GovEcharts.option({
      tooltip: { formatter: function (p) {
        const path = p.treePathInfo || [];
        const raw = path.length ? path[path.length - 1].name : "";
        return echarts.format.encodeHTML(raw) + ": " + nf(p.value);
      } },
      series: [{
        type: "treemap", name: "מסגרות", data: d, leafDepth: 1, roam: false,
        top: 8, left: 4, right: 4, bottom: 32,
        label: { show: true, formatter: "{b}" },
        upperLabel: { show: true, height: 22 },
        breadcrumb: { show: true, bottom: 4 },
        levels: [
          { itemStyle: { borderColor: "#fff", borderWidth: 2, gapWidth: 2 } },
          { colorSaturation: [0.35, 0.6], itemStyle: { borderColorSaturation: 0.7, gapWidth: 1, borderWidth: 1 } }
        ]
      }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
