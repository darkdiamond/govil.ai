<h1>מאגר סימני מסחר — רשם סימני המסחר</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור סימן מסחר לפי שם, מספר סימן או בעלים ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: מספר הסימן, תיאור הסימן בעברית ובאנגלית, שם בעל הסימן, שם מיופה הכוח, סוגי ניצה ורשימת הסחורות.</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">בקשות לסימני מסחר במאגר</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.registered.tone }} mb-1" dir="ltr">{{ model.kpis.registered.display }}</div>
    <div class="text-sm text-subtle">סימנים רשומים ובתוקף</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.pending.tone }} mb-1" dir="ltr">{{ model.kpis.pending.display }}</div>
    <div class="text-sm text-subtle">בקשות בבחינה או בתקופת התנגדות</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.last_year.tone }} mb-1" dir="ltr">{{ model.kpis.last_year.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.last_year_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.intl.tone }} mb-1" dir="ltr">{{ model.kpis.intl.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.intl_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.lag.tone }} mb-1" dir="ltr">{{ model.kpis.lag.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.lag_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.owners.tone }} mb-1" dir="ltr">{{ model.kpis.owners.display }}</div>
    <div class="text-sm text-subtle">בעלי סימנים שונים</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.customs.tone }} mb-1" dir="ltr">{{ model.kpis.customs.display }}</div>
    <div class="text-sm text-subtle">סימנים רשומים עם מייצג לאכיפה במכס</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">בקשות לפי שנת הגשה ומסלול</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.yearly_note }}</p>
  <div id="chart-yearly" data-fallback="explorer" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.yearly_aria }}"></div>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/list.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">מצב התיקים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.status_note }}</p>
    <div id="chart-status" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.status_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.status_aria }}</caption>
        <thead><tr><th scope="col">מצב</th><th scope="col">תיקים</th></tr></thead>
        <tbody>
{%- for r in model.charts.status %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.value | fmt_int }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">מה עלה בגורל הבקשות</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.fate_note }}</p>
    <div id="chart-fate" data-fallback="explorer" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.fate_aria }}"></div>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תחומי המוצרים והשירותים (סיווג ניצה)</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.classes_note }}</p>
  <div id="chart-classes" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.classes_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.classes_aria }}</caption>
      <thead><tr><th scope="col">סוג</th><th scope="col">בקשות</th><th scope="col">אחוז מהבקשות</th></tr></thead>
      <tbody>
{%- for n in model.charts.classes.names %}
        <tr><th scope="row">{{ n }}</th><td>{{ model.charts.classes["values"][loop.index0] | fmt_int }}</td><td>{{ model.charts.classes.shares[loop.index0] | fmt_num }}%</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">התמהיל משתנה: סוגי ניצה לאורך התקופות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.heat_note }}</p>
  <div id="chart-heat" data-fallback="explorer" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.heat_aria }}"></div>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">בעלי הסימנים הגדולים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.owners_note }}</p>
    <div id="chart-owners" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.owners_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.owners_aria }}</caption>
        <thead><tr><th scope="col">בעל הסימן</th><th scope="col">בקשות</th><th scope="col">רשומים כיום</th></tr></thead>
        <tbody>
{%- for n in model.charts.owners.names %}
          <tr><th scope="row">{{ n }}</th><td>{{ model.charts.owners.total[loop.index0] | fmt_int }}</td><td>{{ model.charts.owners.registered[loop.index0] | fmt_int }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">מיופי הכוח המובילים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.agents_note }}</p>
    <div id="chart-agents" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.agents_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.agents_aria }}</caption>
        <thead><tr><th scope="col">מיופה כוח</th><th scope="col">בקשות</th><th scope="col">אחוז</th></tr></thead>
        <tbody>
{%- for n in model.charts.agents.names %}
          <tr><th scope="row">{{ n }}</th><td>{{ model.charts.agents["values"][loop.index0] | fmt_int }}</td><td>{{ model.charts.agents.shares[loop.index0] | fmt_num }}%</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">כמה זמן לוקח לרשום סימן</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.lag_note }}</p>
    <div id="chart-lag" data-fallback="explorer" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.lag_aria }}"></div>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/triangle-alert.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">גל החידושים: תום תוקף הסימנים הרשומים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.expiry_note }}</p>
    <div id="chart-expiry" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.expiry_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.expiry_aria }}</caption>
        <thead><tr><th scope="col">שנת תום תוקף</th><th scope="col">סימנים רשומים</th></tr></thead>
        <tbody>
{%- for x in model.charts.expiry.x %}
          <tr><th scope="row">{{ x }}</th><td>{{ model.charts.expiry.y[loop.index0] | fmt_int }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מאפייני הבקשות לאורך השנים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.features_note }}</p>
  <div id="chart-features" data-fallback="explorer" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.features_aria }}"></div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מה מופיע בלוגו: רכיבים ציוריים (סיווג וינה)</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.vienna_note }}</p>
  <div id="chart-vienna" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.vienna_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.vienna_aria }}</caption>
      <thead><tr><th scope="col">קטגוריה</th><th scope="col">סימנים</th><th scope="col">אחוז מהסימנים שסווגו</th></tr></thead>
      <tbody>
{%- for n in model.charts.vienna.names %}
        <tr><th scope="row">{{ n }}</th><td>{{ model.charts.vienna["values"][loop.index0] | fmt_int }}</td><td>{{ model.charts.vienna.shares[loop.index0] | fmt_num }}%</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
  <p class="m-0 mt-3 text-sm text-subtle">{{ model.labels.extras }}</p>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">בקשות שהוגשו להגנה ישראלית על סימני מסחר</p>
</section>

<script>
  (function () {
    var d = {{ model.charts.yearly | tojson }};
    var c = echarts.init(document.getElementById("chart-yearly"));
    var startPct = d.x.length > 40 ? Math.round((1 - 40 / d.x.length) * 100) : 0;
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var y = ps[0].axisValue, tot = 0, out = "";
        ps.forEach(function (p) { tot += p.value; out += "<br>" + p.marker + echarts.format.encodeHTML(p.seriesName) + ": " + p.value.toLocaleString("he-IL"); });
        return echarts.format.encodeHTML(y) + (y === d.partial_year ? " (שנה חלקית)" : "") + " · סה״כ " + tot.toLocaleString("he-IL") + out;
      } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 88, containLabel: true },
      dataZoom: [{ type: "inside", start: startPct, end: 100 }, { type: "slider", start: startPct, end: 100, bottom: 32, height: 18 }],
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value" },
      series: d.series.map(function (s) {
        return { name: s.name, type: "bar", stack: "all", data: s.data.map(function (v, i) {
          return d.x[i] === d.partial_year ? { value: v, itemStyle: { opacity: 0.55 } } : v;
        }) };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.status | tojson }};
    var c = echarts.init(document.getElementById("chart-status"));
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "item", formatter: function (p) {
        return echarts.format.encodeHTML(p.name) + ": " + p.value.toLocaleString("he-IL") + " (" + p.percent + "%)";
      } },
      legend: { bottom: 0 },
      series: [{ type: "pie", radius: ["42%", "68%"], center: ["50%", "44%"], label: { show: false },
                 data: d.map(function (r) { return { name: r.name, value: r.value, itemStyle: { color: r.color } }; }) }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.fate | tojson }};
    var c = echarts.init(document.getElementById("chart-fate"));
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex, out = echarts.format.encodeHTML(ps[0].axisValue) + " · " + d.totals[i].toLocaleString("he-IL") + " בקשות";
        ps.forEach(function (p) { out += "<br>" + p.marker + echarts.format.encodeHTML(p.seriesName) + ": " + p.value + "%"; });
        return out;
      } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 16, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      series: d.series.map(function (s) {
        return { name: s.name, type: "bar", stack: "fate", barCategoryGap: "15%", itemStyle: { color: s.color }, data: s.data };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.classes | tojson }};
    var c = echarts.init(document.getElementById("chart-classes"));
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "item", formatter: function (p) {
        var i = p.dataIndex;
        return echarts.format.encodeHTML(d.names[i]) + "<br>" + d.values[i].toLocaleString("he-IL") + " בקשות · " + d.shares[i] + "% מהבקשות";
      } },
      grid: { left: 16, right: 16, top: 8, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true, formatter: function (v) { return v >= 1000 ? (v / 1000) + "K" : v; } } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 150, overflow: "truncate", fontSize: 11 } },
      series: [{ type: "bar", data: d.values }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.heat | tojson }};
    var c = echarts.init(document.getElementById("chart-heat"));
    var el = document.getElementById("chart-heat"), wide = el.clientWidth >= 600;
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return echarts.format.encodeHTML(d.y[p.data[1]]) + "<br>" + echarts.format.encodeHTML(d.x[p.data[0]]) + ": " + p.data[2] + "% מהבקשות (" + p.data[3].toLocaleString("he-IL") + ")";
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: d.x, splitArea: { show: true }, axisLabel: { fontSize: 11 } },
      yAxis: { type: "category", data: d.y, inverse: true, splitArea: { show: true }, axisLabel: { width: 140, overflow: "truncate", fontSize: 11 } },
      visualMap: { min: 0, max: d.max, dimension: 2, calculable: true, orient: "horizontal", left: "center", bottom: 8,
                   inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] }, textStyle: { fontFamily: "Rubik", color: "#0c3058" } },
      series: [{ type: "heatmap", data: d.cells, label: { show: wide, fontFamily: "Rubik", fontSize: 10,
                 formatter: function (p) { return p.data[2]; } },
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () {
      var w = el.clientWidth >= 600;
      if (w !== wide) { wide = w; c.setOption({ series: [{ label: { show: wide } }] }); }
      c.resize();
    });
  })();
  (function () {
    var d = {{ model.charts.owners | tojson }};
    var c = echarts.init(document.getElementById("chart-owners"));
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex;
        return echarts.format.encodeHTML(d.names[i]) + "<br>בקשות: " + d.total[i].toLocaleString("he-IL") + "<br>רשומים כיום: " + d.registered[i].toLocaleString("he-IL");
      } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 8, bottom: 40, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 130, overflow: "truncate", fontSize: 11 } },
      series: [
        { name: "רשומים כיום", type: "bar", stack: "o", data: d.registered },
        { name: "סגורים או בטיפול", type: "bar", stack: "o", data: d.total.map(function (t, i) { return t - d.registered[i]; }) }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.agents | tojson }};
    var c = echarts.init(document.getElementById("chart-agents"));
    var last = d.names.length - 1;
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "item", formatter: function (p) {
        var i = p.dataIndex;
        return echarts.format.encodeHTML(d.names[i]) + "<br>" + d.values[i].toLocaleString("he-IL") + " בקשות · " + d.shares[i] + "%";
      } },
      grid: { left: 16, right: 16, top: 8, bottom: 24, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 130, overflow: "truncate", fontSize: 11 } },
      series: [{ type: "bar", data: d.values.map(function (v, i) {
        return i >= last - 1 ? { value: v, itemStyle: { color: "#c3cfe7" } } : v;
      }) }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.lag | tojson }};
    var c = echarts.init(document.getElementById("chart-lag"));
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", formatter: function (ps) {
        var i = ps[0].dataIndex;
        return echarts.format.encodeHTML(d.x[i]) + " · " + d.n[i].toLocaleString("he-IL") + " רישומים<br>חציון: " + d.p50[i] +
          " חודשים<br>רבעון תחתון: " + d.p25[i] + " · רבעון עליון: " + d.p75[i];
      } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", name: "חודשים" },
      series: [
        { name: "רבעון עליון", type: "line", data: d.p75, symbol: "none", lineStyle: { type: "dashed", width: 1 } },
        { name: "חציון", type: "line", data: d.p50, lineStyle: { width: 3 } },
        { name: "רבעון תחתון", type: "line", data: d.p25, symbol: "none", lineStyle: { type: "dashed", width: 1 } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.expiry | tojson }};
    var c = echarts.init(document.getElementById("chart-expiry"));
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        return echarts.format.encodeHTML(ps[0].axisValue) + ": " + ps[0].value.toLocaleString("he-IL") + " סימנים רשומים";
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value" },
      series: [{ type: "bar", data: d.y }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.features | tojson }};
    var c = echarts.init(document.getElementById("chart-features"));
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
      series: [
        { name: "סימן עם דמות", type: "line", data: d.fig },
        { name: "דין קדימה", type: "line", data: d.prio },
        { name: "כיתוב בעברית", type: "line", data: d.heb },
        { name: "על בסיס רישום חיצוני", type: "line", data: d.foreign }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.vienna | tojson }};
    var c = echarts.init(document.getElementById("chart-vienna"));
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "item", formatter: function (p) {
        var i = p.dataIndex;
        return echarts.format.encodeHTML(d.names[i]) + "<br>" + d.values[i].toLocaleString("he-IL") + " סימנים · " + d.shares[i] + "%";
      } },
      grid: { left: 16, right: 16, top: 8, bottom: 24, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 130, overflow: "truncate", fontSize: 11 } },
      series: [{ type: "bar", data: d.values }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
