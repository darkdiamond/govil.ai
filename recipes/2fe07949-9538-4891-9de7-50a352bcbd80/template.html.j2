{%- macro two_col(rows, caption, head1, head2) -%}
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ caption }}</caption>
      <thead><tr><th scope="col">{{ head1 }}</th><th scope="col">{{ head2 }}</th></tr></thead>
      <tbody>
{%- for r in rows %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.v }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
{%- endmacro -%}
{%- macro by_type(rows, caption, head1) -%}
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ caption }}</caption>
      <thead><tr><th scope="col">{{ head1 }}</th>
{%- for t in model.charts.etype.types %}<th scope="col">{{ t }}</th>{%- endfor %}</tr></thead>
      <tbody>
{%- for r in rows %}
        <tr><th scope="row">{{ r.name }}</th>{%- for c in r.c %}<td>{{ c }}</td>{%- endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
{%- endmacro -%}
<h1>אתרי בניה שנסגרו</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.total_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.last12.tone }} mb-1" dir="ltr">{{ model.kpis.last12.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.last12_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.companies.tone }} mb-1" dir="ltr">{{ model.kpis.companies.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.companies_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.repeat.tone }} mb-1" dir="ltr">{{ model.kpis.repeat.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.repeat_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">סגירות לפי שנה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.years_note }}</p>
  <div id="chart-years" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.years_aria }}"></div>
  {{ two_col(model.tables.years, model.labels.years_aria, "שנה", "סגירות") }}
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">קצב חודשי</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.monthly_note }}</p>
  <div id="chart-monthly" data-fallback="explorer" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.monthly_aria }}"></div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">חודש מול שנה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.heat_note }}</p>
  <div id="chart-heat" data-fallback="explorer" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.heat_aria }}"></div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מי המבצע באתרים שנסגרו</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.etype_note }}</p>
  <div id="chart-etype" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.etype_aria }}"></div>
  {{ by_type(model.tables.etype, model.labels.etype_aria, "שנה") }}
</section>
{%- if model.flags.executors %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">חברות הבנייה שאתריהן נסגרו</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.exec_note }}</p>
  <div id="chart-exec" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.exec_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.exec_aria }}</caption>
      <thead><tr><th scope="col">חברה</th><th scope="col">סגירות</th><th scope="col">סגירה אחרונה</th></tr></thead>
      <tbody>
{%- for r in model.tables.executors %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.v }}</td><td dir="ltr">{{ r.last }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{%- endif %}

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
{%- if model.flags.cities %}
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">יישובים מובילים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.city_note }}</p>
    <div id="chart-cities" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.city_aria }}"></div>
    {{ two_col(model.tables.cities, model.labels.city_aria, "יישוב", "סגירות") }}
  </section>
{%- endif %}
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">לפי מחוז</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.dist_note }}</p>
    <div id="chart-districts" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.dist_aria }}"></div>
    {{ two_col(model.tables.districts, model.labels.dist_aria, "מחוז", "סגירות") }}
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">סוג הפרויקט וסוג המבצע</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.kind_note }}</p>
  <div id="chart-kinds" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.kind_aria }}"></div>
  {{ by_type(model.tables.kinds, model.labels.kind_aria, "סוג הפרויקט") }}
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">יום בשבוע</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.weekday_note }}</p>
  <div id="chart-weekday" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.weekday_aria }}"></div>
  {{ two_col(model.tables.weekday, model.labels.weekday_aria, "יום", "סגירות") }}
</section>

<script>
  (function () {
    var narrow = window.innerWidth < 640;
    function vbar(id, x, y, name, colors) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis" },
        grid: { left: 40, right: 16, top: 24, bottom: 16, containLabel: true },
        xAxis: { type: "category", data: x,
                 axisLabel: { interval: 0, fontSize: narrow ? 10 : 12, rotate: narrow && x.length > 8 ? 45 : 0 } },
        yAxis: { type: "value" },
        series: [{ type: "bar", name: name, label: { show: true, position: "top" },
                   data: y.map(function (v, i) {
                     return colors ? { value: v, itemStyle: { color: colors[i] } } : v;
                   }) }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    function hbar(id, d, name) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis" },
        grid: { left: 16, right: 40, top: 8, bottom: 16, containLabel: true },
        xAxis: { type: "value", minInterval: 1 },
        yAxis: { type: "category", data: d.names, inverse: true,
                 axisLabel: { width: narrow ? 110 : 170, overflow: "truncate" } },
        series: [{ type: "bar", name: name, data: d.values,
                   label: { show: true, position: "right" } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    var yr = {{ model.charts.years | tojson }};
    vbar("chart-years", yr.x, yr.y, "סגירות", yr.partial.map(function (p) {
      return p ? "#8fb8f5" : "#0068f5";
    }));
    var wd = {{ model.charts.weekday | tojson }};
    vbar("chart-weekday", wd.names, wd.values, "סגירות");
    hbar("chart-districts", {{ model.charts.districts | tojson }}, "סגירות");
{%- if model.flags.executors %}
    hbar("chart-exec", {{ model.charts.executors | tojson }}, "סגירות");
{%- endif %}
{%- if model.flags.cities %}
    hbar("chart-cities", {{ model.charts.cities | tojson }}, "סגירות");
{%- endif %}
  })();
</script>

<script>
  (function () {
    var m = {{ model.charts.monthly | tojson }};
    var c = echarts.init(document.getElementById("chart-monthly"));
    var start = m.x.length > 48 ? Math.round((1 - 48 / m.x.length) * 100) : 0;
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { top: 0, data: ["סגירות בחודש", "ממוצע נע 12 חודשים"] },
      grid: { left: 40, right: 16, top: 40, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: m.x },
      yAxis: { type: "value", minInterval: 1 },
      dataZoom: [{ type: "inside", start: start, end: 100 }, { type: "slider", bottom: 8, start: start, end: 100 }],
      series: [
        { type: "bar", name: "סגירות בחודש", data: m.y },
        { type: "line", name: "ממוצע נע 12 חודשים", data: m.ma, showSymbol: false, connectNulls: false,
          lineStyle: { width: 2, color: "#0b3668" }, itemStyle: { color: "#0b3668" } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var hm = {{ model.charts.heat | tojson }};
    var c = echarts.init(document.getElementById("chart-heat"));
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return hm.months[p.value[0]] + " " + hm.years[p.value[1]] + ": " + p.value[2];
      } },
      grid: { left: 16, right: 16, top: 8, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: hm.months, splitArea: { show: true },
               axisLabel: { interval: 0, fontSize: 10, rotate: window.innerWidth < 640 ? 90 : 0 } },
      yAxis: { type: "category", data: hm.years, splitArea: { show: true } },
      visualMap: {
        dimension: 2, min: 0, max: hm.max, calculable: true,
        orient: "horizontal", left: "center", bottom: 8,
        inRange: { color: ["#f1f7ff", "#0068f5", "#0b3668"] }
      },
      series: [{ type: "heatmap", name: "סגירות", data: hm.cells,
                 label: { show: true, fontSize: 10 } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var e = {{ model.charts.etype | tojson }};
    var c = echarts.init(document.getElementById("chart-etype"));
    var series = e.types.map(function (t, i) {
      return { type: "bar", stack: "s", name: t, data: e.share[i] };
    });
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0, data: e.types },
      grid: { left: 40, right: 16, top: 16, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: e.years },
      yAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      series: series
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
<script>
  (function () {
    var k = {{ model.charts.kinds | tojson }};
    var c = echarts.init(document.getElementById("chart-kinds"));
    var series = k.types.map(function (t, i) {
      return { type: "bar", stack: "s", name: t, data: k.series[i] };
    });
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0, data: k.types },
      grid: { left: 16, right: 24, top: 8, bottom: 64, containLabel: true },
      xAxis: { type: "value", minInterval: 1 },
      yAxis: { type: "category", data: k.names, inverse: true,
               axisLabel: { width: 130, overflow: "truncate" } },
      series: series
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
