</script>

{%- if model.flags.map %}
<script>
  (function () {
    var d = {{ model.charts.map | tojson }};
    var el = document.getElementById("map-main");
    if (!el || !window.L) { return; }
    var map = L.map(el, { center: [31.9, 35.0], zoom: 7, zoomSnap: 0.25, scrollWheelZoom: false });
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 18, attribution: "© OpenStreetMap"
    }).addTo(map);
    var bounds = [];
    d.points.forEach(function (p) {
      var mk = L.circleMarker([p[0], p[1]], {
        radius: 4 + 2.2 * Math.sqrt(p[2]), color: "#0053c4", weight: 1,
        fillColor: "#0068f5", fillOpacity: 0.45
      }).addTo(map);
      var box = document.createElement("div");
      var t = document.createElement("strong");
      t.textContent = p[3];
      box.appendChild(t);
      [["תחנות", p[2].toLocaleString("he-IL")], ["מחוז", p[4]], ["הגוף המפעיל העיקרי", p[5]]].forEach(function (row) {
        var line = document.createElement("div");
        line.textContent = row[0] + ": " + row[1];
        box.appendChild(line);
      });
      mk.bindPopup(box);
      bounds.push([p[0], p[1]]);
    });
    if (bounds.length) { map.fitBounds(bounds, { padding: [16, 16] }); }
  })();
</script>
{%- endif %}

