  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.total_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.cities.tone }} mb-1" dir="ltr">{{ model.kpis.cities.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.cities_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.ops.tone }} mb-1" dir="ltr">{{ model.kpis.ops.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.ops_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.median_h.tone }} mb-1" dir="ltr">{{ model.kpis.median_h.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.median_h_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.evening.tone }} mb-1" dir="ltr">{{ model.kpis.evening.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.evening_kpi }}</div>
