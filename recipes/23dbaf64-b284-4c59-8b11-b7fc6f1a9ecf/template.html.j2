<script>
  (function () {
    var r = {{ model.charts.years | tojson }};
    var c1 = echarts.init(document.getElementById("chart-years"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: r.x },
      yAxis: { type: "value", name: "מאגרים" },
      series: r.series.map(function (s) { return { type: "bar", stack: "total", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    var m = {{ model.charts.recent | tojson }};
    var c2 = echarts.init(document.getElementById("chart-recent"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 16, right: 16, top: 32, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: m.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value", name: "מאגרים" },
      series: [{ type: "bar", name: "מאגרים חדשים", data: m.y }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    function hbar(id, d, unit, extra) {
      var el = document.getElementById(id);
      var c = echarts.init(el);
      var lw = Math.max(110, Math.min(260, Math.round(el.clientWidth * 0.4)));
      var series = { type: "bar", name: unit, data: d.values };
      if (extra) { Object.assign(series, extra); }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis" },
        grid: { left: 16, right: 32, top: 28, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: el.clientWidth < 500 ? 2 : 4,
                 axisLabel: { hideOverlap: true, rotate: el.clientWidth < 500 ? 45 : 0 } },
        yAxis: { type: "category", data: d.names, inverse: true,
                 axisLabel: { width: lw, overflow: "truncate" } },
        series: [series]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    hbar("chart-status", {{ model.charts.status | tojson }}, "מאגרים");
    hbar("chart-otypes", {{ model.charts.otypes | tojson }}, "מאגרים");
    hbar("chart-owners", {{ model.charts.owners | tojson }}, "מאגרים");
    hbar("chart-types", {{ model.charts.types | tojson }}, "מאגרים");
    hbar("chart-purposes", {{ model.charts.purposes | tojson }}, "מאגרים");
    hbar("chart-holders", {{ model.charts.holders | tojson }}, "מאגרים");
    hbar("chart-cities", {{ model.charts.cities | tojson }}, "מאגרים");
    hbar("chart-names", {{ model.charts.names | tojson }}, "מאגרים");

    var a = {{ model.charts.abroad | tojson }};
    hbar("chart-abroad", a, "שיעור מעבירים לחו״ל (%)", {
      markLine: { symbol: "none", lineStyle: { type: "dashed", color: "#0b3668" },
                  label: { show: false }, data: [{ xAxis: a.avg }] }
    });

    var nt = {{ model.charts.ntypes | tojson }};
    var c3 = echarts.init(document.getElementById("chart-ntypes"));
    c3.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 16, right: 16, top: 32, bottom: 32, containLabel: true },
      xAxis: { type: "category", data: nt.names, name: "סוגים" },
      yAxis: { type: "value", name: "מאגרים" },
      series: [{ type: "bar", name: "מאגרים", data: nt.values }]
    }));
    window.addEventListener("resize", function () { c3.resize(); });

    var h = {{ model.charts.heat | tojson }};
    var c4 = echarts.init(document.getElementById("chart-heat"));
    c4.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return h.y[p.value[1]] + " · " + h.x[p.value[0]] + ": " + p.value[2] + "%";
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true },
               axisLabel: { rotate: 40, width: 110, overflow: "truncate" } },
      yAxis: { type: "category", data: h.y, inverse: true, splitArea: { show: true },
               axisLabel: { width: 140, overflow: "truncate" } },
      visualMap: {
        min: 0, max: h.max, calculable: true, dimension: 2,
        orient: "horizontal", left: "center", bottom: 0,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells,
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c4.resize(); });
  })();
</script>
