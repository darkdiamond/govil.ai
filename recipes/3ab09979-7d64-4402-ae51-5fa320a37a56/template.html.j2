<h1>עיצומים כספיים למעסיקים - הפרת חוקי עבודה</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-brand mb-1">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">סך העיצומים</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-brand mb-1">{{ model.kpis.decisions.display }}</div>
    <div class="text-sm text-subtle">החלטות על עיצום</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-brand mb-1">{{ model.kpis.employers.display }}</div>
    <div class="text-sm text-subtle">מעסיקים</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-brand mb-1">{{ model.kpis.median.display }}</div>
    <div class="text-sm text-subtle">חציון עיצום להחלטה</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
  <p class="mt-3 mb-0 text-sm text-subtle">{{ model.labels.amount_note }}</p>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">החלטות וסכומים לפי שנה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.partial }}</p>
  <div id="chart-yearly" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.yearly_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.year_caption }}</caption>
      <thead><tr><th scope="col">שנה</th><th scope="col">החלטות</th><th scope="col">סך עיצומים</th></tr></thead>
      <tbody>
{%- for r in model.tables.years %}
        <tr><th scope="row">{{ r.year }}</th><td>{{ r.n }}</td><td>{{ r.amt }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">אילו חוקים הופרו</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.multi_law_note }}</p>
    <div id="chart-laws" class="h-80 md:h-96" role="img" aria-label="{{ model.labels.laws_aria }}"></div>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">גובה העיצום להחלטה</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">מספר ההחלטות לפי הסכום הכולל שהוטל בהן.</p>
    <div id="chart-buckets" class="h-80 md:h-96" role="img" aria-label="{{ model.labels.buckets_aria }}"></div>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">עיצומים לפי ענף</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">סך העיצומים במיליוני ₪ ומספר ההחלטות בענפים המובילים.</p>
  <div id="chart-ind" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.ind_aria }}"></div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מקור הבדיקה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">האם הבדיקה שהובילה לעיצום הייתה יזומה, או בעקבות תלונה או פנייה.</p>
  <div id="chart-reasons" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.reasons_aria }}"></div>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">תאגידים עם הסכום הגבוה ביותר</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.emp_note }}</p>
    <div id="chart-emp" class="h-80 md:h-96" role="img" aria-label="{{ model.labels.emp_aria }}"></div>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">יישובים מובילים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">מספר ההחלטות לפי יישוב המעסיק (כשצוין).</p>
    <div id="chart-cities" class="h-80 md:h-96" role="img" aria-label="{{ model.labels.cities_aria }}"></div>
  </section>
</div>

<p class="text-sm text-subtle mb-6">הנתונים המלאים זמינים להורדה בעמוד המאגר ב-<a class="text-brand underline" href="https://data.gov.il/dataset/3ab09979-7d64-4402-ae51-5fa320a37a56" target="_blank" rel="noopener">data.gov.il</a>.</p>

<script>
  (function () {
    var y = {{ model.charts.yearly | tojson }};
    var c1 = echarts.init(document.getElementById("chart-yearly"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0, data: ["החלטות", "סך עיצומים (מיליוני ₪)"] },
      grid: { left: 48, right: 48, top: 32, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: y.years },
      yAxis: [{ type: "value", name: "החלטות" }, { type: "value", name: "מיליוני ₪" }],
      series: [
        { type: "bar", name: "החלטות", data: y.decisions },
        { type: "line", name: "סך עיצומים (מיליוני ₪)", yAxisIndex: 1, data: y.millions }
      ]
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    var r = {{ model.charts.reasons | tojson }};
    var c2 = echarts.init(document.getElementById("chart-reasons"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 48, right: 16, top: 24, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: r.years },
      yAxis: { type: "value" },
      series: r.series.map(function (s) { return { type: "bar", stack: "all", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c2.resize(); });

    var b = {{ model.charts.buckets | tojson }};
    var c3 = echarts.init(document.getElementById("chart-buckets"));
    c3.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 48, right: 16, top: 24, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: b.names, axisLabel: { interval: 0, rotate: 30 } },
      yAxis: { type: "value", name: "החלטות" },
      series: [{ type: "bar", name: "החלטות", data: b.values, label: { show: true, position: "top" } }]
    }));
    window.addEventListener("resize", function () { c3.resize(); });
  })();
</script>

<script>
  (function () {
    function hbar(id, names, values, name, unit) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", valueFormatter: function (v) { return v + unit; } },
        grid: { left: 16, right: 56, top: 8, bottom: 16, containLabel: true },
        xAxis: { type: "value" },
        yAxis: { type: "category", data: names, inverse: true,
                 axisLabel: { width: 150, overflow: "truncate" } },
        series: [{ type: "bar", name: name, data: values,
                   label: { show: true, position: "right" } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    var l = {{ model.charts.laws | tojson }};
    hbar("chart-laws", l.names, l.values, "הפרות", "");
    var e = {{ model.charts.employers | tojson }};
    hbar("chart-emp", e.names, e.millions, "מיליוני ₪", " מיליון ₪");
    var ct = {{ model.charts.cities | tojson }};
    hbar("chart-cities", ct.names, ct.values, "החלטות", "");

    var ind = {{ model.charts.industries | tojson }};
    var c4 = echarts.init(document.getElementById("chart-ind"));
    c4.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0, data: ["מיליוני ₪", "החלטות"] },
      grid: { left: 16, right: 40, top: 8, bottom: 40, containLabel: true },
      xAxis: [{ type: "value", name: "מיליוני ₪" }, { type: "value", name: "החלטות", show: false }],
      yAxis: { type: "category", data: ind.names, inverse: true,
               axisLabel: { width: 150, overflow: "truncate" } },
      series: [
        { type: "bar", name: "מיליוני ₪", data: ind.millions, label: { show: true, position: "right" } },
        { type: "bar", name: "החלטות", xAxisIndex: 1, data: ind.decisions }
      ]
    }));
    window.addEventListener("resize", function () { c4.resize(); });
  })();
</script>
