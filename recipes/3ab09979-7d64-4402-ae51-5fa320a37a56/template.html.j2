<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">הפחתות בעיצום</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.red_note }}</p>
    <div id="chart-reductions" class="h-80 md:h-96" role="img" aria-label="{{ model.labels.red_aria }}"></div>
    {{ two_col(model.tables.reductions, model.labels.red_aria, "נימוק", "החלטות") }}
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
