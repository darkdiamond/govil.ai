<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">תאגידים עם הסכום הגבוה ביותר</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.emp_note }}</p>
    <div id="chart-emp" class="h-80 md:h-96" role="img" aria-label="{{ model.labels.emp_aria }}"></div>
    {{ two_col(model.tables.employers, model.labels.emp_aria, "תאגיד", "סך עיצומים") }}
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">יישובים מובילים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">מספר ההחלטות לפי יישוב המעסיק (כשצוין).</p>
    <div id="chart-cities" class="h-80 md:h-96" role="img" aria-label="{{ model.labels.cities_aria }}"></div>
    {{ two_col(model.tables.cities, model.labels.cities_aria, "יישוב", "החלטות") }}
  </section>
</div>


<script>
  (function () {
    var y = {{ model.charts.yearly | tojson }};
    var c1 = echarts.init(document.getElementById("chart-yearly"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0, data: ["החלטות", "סך עיצומים (מיליוני ₪)"] },
      grid: { left: 48, right: 48, top: 32, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: y.years },
      yAxis: [{ type: "value", name: "החלטות" }, { type: "value", name: "מיליוני ₪" }],
      series: [
        { type: "bar", name: "החלטות", data: y.decisions },
        { type: "line", name: "סך עיצומים (מיליוני ₪)", yAxisIndex: 1, data: y.millions }
      ]
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    var r = {{ model.charts.reasons | tojson }};
    var c2 = echarts.init(document.getElementById("chart-reasons"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 48, right: 16, top: 24, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: r.years },
      yAxis: { type: "value" },
      series: r.series.map(function (s) { return { type: "bar", stack: "all", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c2.resize(); });

    var b = {{ model.charts.buckets | tojson }};
    var c3 = echarts.init(document.getElementById("chart-buckets"));
    c3.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 48, right: 16, top: 24, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: b.names, axisLabel: { interval: 0, rotate: 30 } },
      yAxis: { type: "value", name: "החלטות" },
      series: [{ type: "bar", name: "החלטות", data: b.values, label: { show: true, position: "top" } }]
    }));
    window.addEventListener("resize", function () { c3.resize(); });
  })();
</script>

<script>
  (function () {
    function hbar(id, names, values, name, unit) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", valueFormatter: function (v) { return v + unit; } },
        grid: { left: 16, right: 56, top: 8, bottom: 16, containLabel: true },
        xAxis: { type: "value" },
        yAxis: { type: "category", data: names, inverse: true,
                 axisLabel: { width: 150, overflow: "truncate" } },
        series: [{ type: "bar", name: name, data: values,
                   label: { show: true, position: "right" } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    var l = {{ model.charts.laws | tojson }};
    hbar("chart-laws", l.names, l.values, "הפרות", "");
    var e = {{ model.charts.employers | tojson }};
    hbar("chart-emp", e.names, e.millions, "מיליוני ₪", " מיליון ₪");
    var ct = {{ model.charts.cities | tojson }};
    hbar("chart-cities", ct.names, ct.values, "החלטות", "");

    var ind = {{ model.charts.industries | tojson }};
    var c4 = echarts.init(document.getElementById("chart-ind"));
    c4.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0, data: ["מיליוני ₪", "החלטות"] },
      grid: { left: 16, right: 40, top: 8, bottom: 40, containLabel: true },
      xAxis: [{ type: "value", name: "מיליוני ₪" }, { type: "value", name: "החלטות", show: false }],
      yAxis: { type: "category", data: ind.names, inverse: true,
               axisLabel: { width: 150, overflow: "truncate" } },
      series: [
        { type: "bar", name: "מיליוני ₪", data: ind.millions, label: { show: true, position: "right" } },
        { type: "bar", name: "החלטות", xAxisIndex: 1, data: ind.decisions }
      ]
    }));
    window.addEventListener("resize", function () { c4.resize(); });
  })();
</script>
{%- if model.flags.detail %}

<script>
  (function () {
    var s = {{ model.charts.sizes | tojson }};
    var c5 = echarts.init(document.getElementById("chart-sizes"));
    c5.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0, data: ["החלטות", "חציון עיצום (₪)"] },
      grid: { left: 48, right: 56, top: 32, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: s.names, name: "עובדים" },
      yAxis: [{ type: "value", name: "החלטות" }, { type: "value", name: "₪" }],
      series: [
        { type: "bar", name: "החלטות", data: s.decisions },
        { type: "line", name: "חציון עיצום (₪)", yAxisIndex: 1, data: s.median }
      ]
    }));
    window.addEventListener("resize", function () { c5.resize(); });

    var rd = {{ model.charts.reductions | tojson }};
    var c6 = echarts.init(document.getElementById("chart-reductions"));
    var lastR = rd.values.length - 1;
    c6.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 16, right: 48, top: 8, bottom: 16, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: rd.names, inverse: true,
               axisLabel: { width: 150, overflow: "truncate" } },
      series: [{ type: "bar", name: "החלטות", label: { show: true, position: "right" },
                 data: rd.values.map(function (v, i) {
                   return i === lastR ? { value: v, itemStyle: { color: "#6c757d" } } : v;
                 }) }]
    }));
    window.addEventListener("resize", function () { c6.resize(); });

    var ap = {{ model.charts.appeals | tojson }};
    var c7 = echarts.init(document.getElementById("chart-appeals"));
    c7.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { type: "scroll", bottom: 0 },
      grid: { left: 16, right: 24, top: 8, bottom: 48, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: ap.stages, inverse: true,
               axisLabel: { width: 120, overflow: "truncate" } },
      series: ap.series.map(function (x) {
        return { type: "bar", stack: "all", name: x.name, data: x.data };
      })
    }));
    window.addEventListener("resize", function () { c7.resize(); });
  })();
</script>
{%- endif %}
