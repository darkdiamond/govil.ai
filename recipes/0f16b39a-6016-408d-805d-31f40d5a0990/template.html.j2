      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 8, right: 8, top: 32, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: [{ type: "value", name: "כלים" }, { type: "value", name: "%", axisLabel: { formatter: "{value}%" }, splitLine: { show: false } }],
      series: [{ type: "bar", name: "חשמליים", data: d.ev },
               { type: "line", name: "חלק מכלי השנה", yAxisIndex: 1, data: d.share, symbolSize: 5,
                 tooltip: { valueFormatter: function (v) { return v + "%"; } } }]
    }));
