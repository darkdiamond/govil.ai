{% import "gov.j2" as gov %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסמה {{ model.release.date }}</p>
{%- if model.release.headline %}
  <p class="m-0 mb-3 font-semibold text-ink-deep">{{ model.release.headline }}</p>
{%- endif %}
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["total", "chg", "lead", "indirect", "diam"] %}
{%- if model.kpis[key] is defined %}
  {{ gov.kpi(model.kpis[key], model.labels[key ~ "_kpi"]) }}
{%- endif %}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

<section class="card p-5 mb-6">
  {{ gov.head("database", "יבוא הסחורות לישראל לאורך השנים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.trend_note }}</p>
  {{ gov.chart("chart-trend", model.labels.trend_aria, "h-72 md:h-80") }}
  {{ gov.table("יבוא סחורות לפי שנה (מיליארדי דולרים)", model.labels.trend_cols, model.tables.trend, ltr=range(1, model.labels.trend_cols | length) | list) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("list", "ארצות המקור המובילות") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.top_note }}</p>
  {{ gov.chart("chart-top", model.labels.top_aria, "h-[520px]") }}
  {{ gov.table("ארצות המקור המובילות ביבוא", model.labels.top_cols, model.tables.top, ltr=(1, 2, 3)) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("database", "היבוא מארצות המקור הגדולות לאורך השנים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.lines_note }}</p>
  {{ gov.chart("chart-lines", model.labels.lines_aria, "h-72 md:h-96") }}
  {{ gov.table("יבוא מארצות המקור הגדולות לפי שנה (מיליארדי דולרים)", model.labels.lines_cols, model.tables.lines, ltr=range(1, model.labels.lines_cols | length) | list) }}
</section>

{%- if model.flags.movers %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "איפה היבוא גדל ואיפה הצטמצם") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.movers_note }}</p>
  {{ gov.chart("chart-movers", model.labels.movers_aria, "h-[440px]") }}
  {{ gov.table("השינוי ביבוא לפי ארץ מקור", model.labels.movers_cols, model.tables.movers, ltr=(1, 2, 3, 4)) }}
</section>
{%- endif %}

{%- if model.flags.continents %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "יבוא לפי יבשת המקור") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.continents_note }}</p>
  {{ gov.chart("chart-continents", model.labels.continents_aria, "h-72 md:h-96") }}
  {{ gov.table("יבוא לפי יבשת מקור ושנה (מיליארדי דולרים)", model.labels.continents_cols, model.tables.continents, ltr=range(1, model.labels.continents_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.compare %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "ארץ מקור מול ארץ קנייה, לפי יבשת") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.compare_note }}</p>
  {{ gov.chart("chart-compare", model.labels.compare_aria, "h-80 md:h-96") }}
  {{ gov.table("יבוא לפי יבשת מקור ויבשת קנייה (מיליארדי דולרים)", model.labels.compare_cols, model.tables.compare, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

{%- if model.flags.gap %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "תחנות ביניים: איפה נקנה מה שיוצר במקום אחר") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.gap_note }}</p>
  {{ gov.chart("chart-gap", model.labels.gap_aria, "h-[520px]") }}
  {{ gov.table("הפרש בין יבוא לפי ארץ קנייה ולפי ארץ מקור (מיליוני דולרים)", model.labels.gap_cols, model.tables.gap, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

{%- if model.flags.dcountries %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "יבוא יהלומים לפי ארץ") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.dcountries_note }}</p>
  {{ gov.chart("chart-dcountries", model.labels.dcountries_aria, "h-80 md:h-96") }}
  {{ gov.table("יבוא יהלומים לפי ארץ (מיליוני דולרים)", model.labels.dcountries_cols, model.tables.dcountries, ltr=range(1, model.labels.dcountries_cols | length) | list) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>הנתונים מתוך ההודעה השנתית לתקשורת של הלשכה המרכזית לסטטיסטיקה על יבוא הסחורות לפי ארץ מקור. הערכים במיליוני דולרים, במחירים שוטפים.</li>
    <li>ארץ המקור היא הארץ שבה יוצרה הסחורה. ארץ הקנייה היא הארץ שממנה נקנתה, ולעיתים זו ארץ מתווכת. סחר החוץ החודשי של הלמ"ס מוצג לפי ארץ הקנייה.</li>
    <li>יבוא היהלומים מחושב כהפרש בין היבוא הכולל ליבוא ללא יהלומים. נתוני השנים הקודמות בהודעה עשויים להיות מעודכנים לעומת הודעות קודמות.</li>
  </ul>
</section>

<script>
  (function () {
    const d = {{ model.charts.trend | tojson }};
    const pal = window.GOVIL_PALETTE;
    const bn = (v) => v == null ? "" : (v / 1000).toLocaleString("he-IL", { maximumFractionDigits: 1 }) + " מיליארד $";
    const chart = echarts.init(document.getElementById("chart-trend"));
    const series = d.nd ? [
      { type: "bar", name: "ללא יהלומים", stack: "t", data: d.nd, barMaxWidth: 48 },
      { type: "bar", name: "יהלומים", stack: "t", data: d.diam, barMaxWidth: 48 }
    ] : [{ type: "bar", name: "סך היבוא", data: d.total, barMaxWidth: 48 }];
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2]],
      tooltip: { trigger: "axis", valueFormatter: bn },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: (v) => (v / 1000).toLocaleString("he-IL") } },
      series: series
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.top | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-top"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
        formatter: (ps) => { const p = ps[0]; const e = echarts.format.encodeHTML;
          return e(p.name) + "<br>" + Math.round(p.value).toLocaleString("he-IL") + " מיליון $ (" + d.share[p.dataIndex] + "%)"; } },
      grid: { left: 16, right: 56, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: false }, splitLine: { show: false } },
      yAxis: { type: "category", data: d.names, axisLabel: { width: 110, overflow: "break" } },
      series: [{ type: "bar", data: d.values, barMaxWidth: 22,
        label: { show: true, position: "right", formatter: (p) => Math.round(p.value).toLocaleString("he-IL") } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.lines | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-lines"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1], pal[2], pal[5], pal[3], pal[7]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Math.round(v).toLocaleString("he-IL") + " מיליון $" },
      legend: { top: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 48, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: (v) => v.toLocaleString("he-IL") } },
      series: d.series.map((s, i) => ({ type: "line", name: s.name, data: s.data, symbolSize: 6,
        lineStyle: { width: i === 0 ? 3 : 2 } }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- if model.flags.movers %}
  (function () {
    const d = {{ model.charts.movers | tojson }};
    const chart = echarts.init(document.getElementById("chart-movers"));
    const fmtv = (v) => (v > 0 ? "+" : "−") + Math.round(Math.abs(v)).toLocaleString("he-IL");
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => fmtv(v) + " מיליון $" },
      grid: { left: 16, right: 16, top: 8, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true, formatter: (v) => v.toLocaleString("he-IL") } },
      yAxis: { type: "category", data: d.names, axisLabel: { width: 110, overflow: "break" } },
      series: [{ type: "bar", barMaxWidth: 22,
        data: d.values.map((v) => ({ value: v, itemStyle: { color: v >= 0 ? "#0068f5" : "#dc3545" } })) }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.continents %}
  (function () {
    const d = {{ model.charts.continents | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-continents"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1], pal[2], pal[5], pal[6], "#6c757d"],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
        valueFormatter: (v) => v == null ? "" : (v / 1000).toLocaleString("he-IL", { maximumFractionDigits: 1 }) + " מיליארד $" },
      legend: { top: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 48, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: (v) => (v / 1000).toLocaleString("he-IL") } },
      series: d.series.map((s) => ({ type: "bar", stack: "c", name: s.name, data: s.data, barMaxWidth: 48 }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.compare %}
  (function () {
    const d = {{ model.charts.compare | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-compare"));
    const bn = (v) => v == null ? "" : (v / 1000).toLocaleString("he-IL", { maximumFractionDigits: 1 }) + " מיליארד $";
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: bn },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 24, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: (v) => (v / 1000).toLocaleString("he-IL") } },
      yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 110, overflow: "break" } },
      series: [
        { type: "bar", name: "לפי ארץ מקור", data: d.origin.slice().reverse(), barMaxWidth: 18 },
        { type: "bar", name: "לפי ארץ קנייה", data: d.purchase.slice().reverse(), barMaxWidth: 18 }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.gap %}
  (function () {
    const d = {{ model.charts.gap | tojson }};
    const chart = echarts.init(document.getElementById("chart-gap"));
    const fmtv = (v) => (v > 0 ? "+" : "−") + Math.round(Math.abs(v)).toLocaleString("he-IL");
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => fmtv(v) + " מיליון $" },
      grid: { left: 16, right: 16, top: 8, bottom: 24, containLabel: true },
      xAxis: { type: "value", name: "מיליארד $", nameLocation: "middle", nameGap: 28, splitNumber: 4, axisLabel: { hideOverlap: true, formatter: (v) => (v / 1000).toLocaleString("he-IL") } },
      yAxis: { type: "category", data: d.names, axisLabel: { width: 110, overflow: "break" } },
      series: [{ type: "bar", barMaxWidth: 22,
        data: d.values.map((v) => ({ value: v, itemStyle: { color: v >= 0 ? "#0b3668" : "#6c9fd8" } })) }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.dcountries %}
  (function () {
    const d = {{ model.charts.dcountries | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-dcountries"));
    const series = [{ type: "bar", name: "לפי ארץ מקור", data: d.origin, barMaxWidth: 18 }];
    if (d.purchase) series.push({ type: "bar", name: "לפי ארץ קנייה", data: d.purchase, barMaxWidth: 18 });
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
        valueFormatter: (v) => v == null ? "" : Math.round(v).toLocaleString("he-IL") + " מיליון $" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 24, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: (v) => v.toLocaleString("he-IL") } },
      yAxis: { type: "category", data: d.names, axisLabel: { width: 110, overflow: "break" } },
      series: series
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
</script>
