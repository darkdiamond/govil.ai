<script>
  GovMap.create({
    container: "#map-main",
    resourceId: {{ inputs.names[0].id | tojson }},
    latField: "Y",
    lngField: "X",
    projection: "itm",
    popupTitleField: "HEBREW",
    popupFields: [
      { field: "CURRENT", label: "צורה" },
      { field: "STATUS", label: "מצב" },
      { field: "RAODS", label: "כבישים" },
      { field: "LATIN", label: "שם באותיות לטיניות" },
      { field: "ARABIC", label: "שם בערבית" }
    ]
  });
</script>

<script>
  (function () {
    function mk(id) {
      var el = document.getElementById(id);
      if (!el) { return null; }
      var c = echarts.init(el);
      window.addEventListener("resize", function () { c.resize(); });
      return c;
    }
    function hbar(id, names, series, stacked) {
      var c = mk(id);
      if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: stacked ? { bottom: 0, type: "scroll" } : undefined,
        grid: { left: 8, right: 24, top: 8, bottom: stacked ? 40 : 24, containLabel: true },
        xAxis: { type: "value" },
        yAxis: { type: "category", data: names.slice().reverse(), axisLabel: { width: 150, overflow: "truncate" } },
        series: series.map(function (s) {
          return { type: "bar", name: s.name, stack: stacked ? "t" : undefined, data: s.data.slice().reverse() };
        })
      }));
    }

    var t = {{ model.charts.type | tojson }};
    var ct = mk("chart-type");
    if (ct) {
      ct.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "item", formatter: "{b}: {c} ({d}%)" },
        legend: { bottom: 0, type: "scroll" },
        series: [{
          type: "pie", radius: ["40%", "68%"], center: ["50%", "45%"],
          label: { formatter: "{b}\n{c}", fontFamily: "Rubik" },
          data: t.names.map(function (n, i) { return { name: n, value: t.values[i] }; })
        }]
      }));
    }

    var f = {{ model.charts.flow | tojson }};
    var cf = mk("chart-flow");
    if (cf) {
      cf.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "item" },
        series: [{
          type: "sankey", left: 16, right: 120, top: 16, bottom: 16,
          nodeAlign: "justify", emphasis: { focus: "adjacency" },
          lineStyle: { color: "gradient", opacity: 0.4 },
          label: { fontFamily: "Rubik", color: "#0c3058" },
          data: f.nodes, links: f.links
        }]
      }));
    }

    var r = {{ model.charts.roads | tojson }};
    hbar("chart-roads", r.names, r.series, true);

    var b = {{ model.charts.bands | tojson }};
    hbar("chart-bands", b.names, b.series, true);

    var l = {{ model.charts.legs | tojson }};
    hbar("chart-legs", l.names, [{ name: "נקודות", data: l.values }], false);

    var w = {{ model.charts.words | tojson }};
    hbar("chart-words", w.names, [{ name: "שמות", data: w.values }], false);

    var k = {{ model.charts.classes | tojson }};
    var ck = mk("chart-classes");
    if (ck) {
      ck.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: {
          trigger: "axis",
          formatter: function (ps) {
            var i = ps[0].dataIndex;
            return [k.long[i]].concat(ps.map(function (p) { return p.marker + p.seriesName + ": " + p.value; })).join("<br/>");
          }
        },
        legend: { bottom: 0 },
        grid: { left: 8, right: 8, top: 24, bottom: 48, containLabel: true },
        xAxis: { type: "category", data: k.names, axisLabel: { interval: 0, lineHeight: 16, formatter: function (v) { return String(v).split(" ").join("\n"); } } },
        yAxis: [
          { type: "value", name: "נקודות" },
          { type: "value", name: "% מחלפים", max: 100, splitLine: { show: false } }
        ],
        series: [
          { type: "bar", name: "נקודות", data: k.points },
          { type: "line", name: "% מחלפים", yAxisIndex: 1, data: k.share, symbolSize: 8 }
        ]
      }));
    }

    var n = {{ model.charts.near | tojson }};
    var cn = mk("chart-near");
    if (cn) {
      cn.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 8, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "category", data: n.names },
        yAxis: { type: "value" },
        series: [{ type: "bar", name: "נקודות", data: n.values }]
      }));
    }

    var v = {{ model.charts.vaada | tojson }};
    var cv = mk("chart-vaada");
    if (cv) {
      cv.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { bottom: 0 },
        grid: { left: 8, right: 8, top: 16, bottom: 40, containLabel: true },
        xAxis: { type: "category", data: v.names },
        yAxis: { type: "value" },
        series: v.series.map(function (s) { return { type: "bar", stack: "t", name: s.name, data: s.data }; })
      }));
    }
  })();
</script>
