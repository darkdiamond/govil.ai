<h1>מסגרות הרווחה שבפיקוח משרד הרווחה והביטחון החברתי</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
{%- for k, lbl in [("total", "total_kpi"), ("capacity", "capacity_kpi"), ("authorities", "auth_kpi"), ("types", "types_kpi"),
                   ("local", "local_kpi"), ("median_cap", "median_cap_kpi"), ("operators", "operators_kpi"), ("unreported", "unreported_kpi")] %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[k].tone }} mb-1" dir="ltr">{{ model.kpis[k].display }}</div>
    <div class="text-sm text-subtle">{{ model.labels[lbl] }}</div>
  </div>
{%- endfor %}
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מסגרות לפי אגף מפקח</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.dept_note }}</p>
  <div id="chart-dept" class="h-96 md:h-[460px]" role="img" aria-label="{{ model.labels.dept_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.dept_caption }}</caption>
      <thead><tr><th scope="col">אגף</th><th scope="col">מסגרות</th><th scope="col">תפוסה בפועל</th></tr></thead>
      <tbody>
{%- for r in model.tables.dept %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.n }}</td><td>{{ r.cap }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">סוגי המסגרות הנפוצים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.types_note }}</p>
  <div id="chart-types" class="h-96 md:h-[460px]" role="img" aria-label="{{ model.labels.types_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.types_caption }}</caption>
      <thead><tr><th scope="col">סוג מסגרת</th><th scope="col">מסגרות</th><th scope="col">תפוסה בפועל</th></tr></thead>
      <tbody>
{%- for r in model.tables.types %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.n }}</td><td>{{ r.cap }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">אגפים וסוגי מסגרות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.tree_note }}</p>
  <div id="chart-tree" data-fallback="explorer" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.tree_aria }}"></div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">בעלות על המסגרות לפי אגף</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.owner_note }}</p>
  <div id="chart-owner" class="h-96 md:h-[460px]" role="img" aria-label="{{ model.labels.owner_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.owner_caption }}</caption>
      <thead><tr><th scope="col">אגף</th>{% for o in model.owners %}<th scope="col">{{ o }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for r in model.tables.owner %}
        <tr><th scope="row">{{ r.name }}</th>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">מסגרות לפי מחוז</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.region_note }}</p>
    <div id="chart-region" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.region_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.region_caption }}</caption>
        <thead><tr><th scope="col">מחוז</th><th scope="col">מסגרות</th><th scope="col">תפוסה בפועל</th></tr></thead>
        <tbody>
{%- for r in model.tables.region %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.n }}</td><td>{{ r.cap }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">פריסת האגפים בין המחוזות</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.heat_note }}</p>
    <div id="chart-heat" class="h-96 md:h-[460px]" role="img" aria-label="{{ model.labels.heat_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.heat_caption }}</caption>
        <thead><tr><th scope="col">אגף</th>{% for r in model.regions %}<th scope="col">{{ r }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in model.tables.heat %}
          <tr><th scope="row">{{ r.name }}</th>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">הרשויות עם הכי הרבה מסגרות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.auth_note }}</p>
  <div id="chart-auth" class="h-96 md:h-[460px]" role="img" aria-label="{{ model.labels.auth_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.auth_caption }}</caption>
      <thead><tr><th scope="col">רשות</th><th scope="col">מחוז</th><th scope="col">מסגרות</th><th scope="col">תפוסה בפועל</th></tr></thead>
      <tbody>
{%- for r in model.tables.auth %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.region }}</td><td>{{ r.n }}</td><td>{{ r.cap }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

{% if model.show.years %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מתי החלו לפעול המסגרות הקיימות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.years_note }}</p>
  <div id="chart-years" data-fallback="explorer" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.years_aria }}"></div>
</section>
{% endif %}

{% if model.show.box %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">גודל המסגרות: תפוסה בפועל לפי סוג</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.box_note }}</p>
  <div id="chart-box" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.box_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.box_caption }}</caption>
      <thead><tr><th scope="col">סוג מסגרת</th><th scope="col">מסגרות מדווחות</th><th scope="col">רבעון תחתון</th><th scope="col">חציון</th><th scope="col">רבעון עליון</th><th scope="col">אחוזון עליון</th></tr></thead>
      <tbody>
{%- for r in model.tables.box %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.n }}</td><td>{{ r.p25 }}</td><td>{{ r.med }}</td><td>{{ r.p75 }}</td><td>{{ r.p95 }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{% endif %}

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
{% if model.show.net %}
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">רשתות וארגונים מפעילים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.net_note }}</p>
    <div id="chart-net" class="h-80 md:h-96" role="img" aria-label="{{ model.labels.net_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.net_caption }}</caption>
        <thead><tr><th scope="col">רשת / ארגון</th><th scope="col">מסגרות</th><th scope="col">סוג עיקרי</th></tr></thead>
        <tbody>
{%- for r in model.tables.net %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.n }}</td><td>{{ r.type }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
{% endif %}
{% if model.show.gender %}
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">מסגרות לפי מגדר</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.gender_note }}</p>
    <div id="chart-gender" class="h-80 md:h-96" role="img" aria-label="{{ model.labels.gender_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.gender_caption }}</caption>
        <thead><tr><th scope="col">אגף</th><th scope="col">זכרים בלבד</th><th scope="col">נקבות בלבד</th></tr></thead>
        <tbody>
{%- for r in model.tables.gender %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.boys }}</td><td>{{ r.girls }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
{% endif %}
</div>

{% if model.show.map %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מפת מסגרות היום והקהילה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.map_note }}</p>
  <div id="map-main" class="h-72 md:h-[420px]" role="region" aria-label="{{ model.labels.map_aria }}"></div>
</section>
{% endif %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">מסגרת היא מתקן המופעל ישירות על ידי המשרד או על ידי רשות מקומית או על ידי ספק חיצוני והוא מפוקח על ידי המשרד בו ניתנים שירותי רווחה.
קיימות מסגרות בקהילה, מסגרות חוץ ביתיות, מעונות ממגוון סוגים, המסגרות מסווגות בהתאמה לסוגי אוכלוסיות שונים ובהתאמה לכל שכבת גיל.</p>
</section>

<script>
  (function () {
    var d = {{ model.charts.dept | tojson }};
    var c = echarts.init(document.getElementById("chart-dept"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                 valueFormatter: function (v) { return Number(v).toLocaleString("he-IL"); } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 28, bottom: 40, containLabel: true },
      xAxis: [
        { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
        { type: "value", position: "top", splitNumber: 3, splitLine: { show: false },
          axisLabel: { hideOverlap: true } }
      ],
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 120, overflow: "truncate" } },
      series: [
        { type: "bar", name: "מסגרות", data: d.n },
        { type: "bar", name: "תפוסה בפועל", xAxisIndex: 1, data: d.cap, itemStyle: { color: "#c3cfe7" } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.types | tojson }};
    var c = echarts.init(document.getElementById("chart-types"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                 valueFormatter: function (v) { return Number(v).toLocaleString("he-IL") + " מסגרות"; } },
      grid: { left: 16, right: 40, top: 8, bottom: 16, containLabel: true },
      xAxis: { type: "value", splitNumber: 2, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 130, overflow: "truncate" } },
      series: [{ type: "bar", name: "מסגרות", data: d.n,
                 label: { show: true, position: "right", fontFamily: "Rubik, sans-serif" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var t = {{ model.charts.tree | tojson }};
    var c = echarts.init(document.getElementById("chart-tree"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { formatter: function (p) { return p.name + ": " + Number(p.value).toLocaleString("he-IL") + " מסגרות"; } },
      series: [{
        type: "treemap", data: t, leafDepth: 1, roam: false,
        top: 8, left: 8, right: 8, bottom: 40,
        breadcrumb: { bottom: 4, itemStyle: { color: "#0068f5" } },
        label: { fontFamily: "Rubik", overflow: "truncate" },
        upperLabel: { show: true, height: 22, fontFamily: "Rubik", color: "#ffffff" },
        levels: [
          { itemStyle: { borderColor: "#ffffff", borderWidth: 2, gapWidth: 2 } },
          { colorSaturation: [0.35, 0.6], itemStyle: { borderColorSaturation: 0.7, gapWidth: 1, borderWidth: 1 } }
        ]
      }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.owner | tojson }};
    var c = echarts.init(document.getElementById("chart-owner"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                 valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 8, bottom: 56, containLabel: true },
      xAxis: { type: "value", min: 0, max: 100, interval: 25, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 120, overflow: "truncate" } },
      series: d.series.map(function (s) { return { type: "bar", stack: "t", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.region | tojson }};
    var c = echarts.init(document.getElementById("chart-region"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return Number(v).toLocaleString("he-IL"); } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, width: 64, overflow: "break", fontSize: 11 } },
      yAxis: [
        { type: "value", name: "מסגרות" },
        { type: "value", name: "תפוסה", splitLine: { show: false } }
      ],
      series: [
        { type: "bar", name: "מסגרות", data: d.n },
        { type: "bar", name: "תפוסה בפועל", yAxisIndex: 1, data: d.cap, itemStyle: { color: "#c3cfe7" } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var h = {{ model.charts.heat | tojson }};
    var c2 = echarts.init(document.getElementById("chart-heat"));
    c2.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return echarts.format.encodeHTML(h.y[p.value[1]]) + " · " + echarts.format.encodeHTML(h.x[p.value[0]]) + ": " + p.value[2] + "% ממסגרות האגף (" +
          p.value[3].toLocaleString("he-IL") + ")";
      } },
      grid: { left: 16, right: 16, top: 8, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true }, axisLabel: { interval: 0, width: 56, overflow: "break", fontSize: 10 } },
      yAxis: { type: "category", data: h.y, inverse: true, splitArea: { show: true },
               axisLabel: { width: 110, overflow: "truncate" } },
      visualMap: {
        min: h.min, max: h.max, dimension: 2, calculable: true,
        orient: "horizontal", left: "center", bottom: 8,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik, sans-serif", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells,
                 label: { show: true, fontFamily: "Rubik, sans-serif", formatter: function (p) { return String(Math.round(p.value[2])); } },
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.auth | tojson }};
    var c = echarts.init(document.getElementById("chart-auth"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                 formatter: function (ps) { var i = ps[0].dataIndex;
                   return d.names[i] + "<br>" + d.n[i].toLocaleString("he-IL") + " מסגרות · תפוסה " +
                     d.cap[i].toLocaleString("he-IL"); } },
      grid: { left: 16, right: 40, top: 8, bottom: 16, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 110, overflow: "truncate" } },
      series: [{ type: "bar", name: "מסגרות", data: d.n,
                 label: { show: true, position: "right", fontFamily: "Rubik, sans-serif" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

{% if model.show.years %}
<script>
  (function () {
    var d = {{ model.charts.years | tojson }};
