      } },
      grid: { left: 16, right: 24, top: 32, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: b.names, axisLabel: { interval: 0, rotate: 35, width: 90, overflow: "truncate" } },
      yAxis: { type: "value", name: "מקבלי שירות" },
      series: [{ type: "boxplot", name: "תפוסה בפועל", data: b.boxes,
                 itemStyle: { color: "#dbe8fb", borderColor: "#0068f5" } }]
    }));
