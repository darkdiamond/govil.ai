{%- if model.flags.map %}
{%- for chunk in model.charts.map.chunks %}
<script type="application/json" id="map-lines-{{ loop.index0 }}">{{ chunk | tojson }}</script>
{%- endfor %}
<script>
  (function () {
    var el = document.getElementById("map-main");
    if (!el || !window.L || !window.GovMap) { return; }
    var meta = {{ {"origin": model.charts.map.origin, "scale": model.charts.map.scale, "kinds": model.charts.map.kinds, "colors": model.charts.map.colors, "weights": model.charts.map.weights, "ramp": model.charts.map.ramp, "bounds": model.charts.map.bounds} | tojson }};
    var map = L.map(el, { scrollWheelZoom: false, zoomSnap: 0.25, preferCanvas: true });
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 18, attribution: "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>" }).addTo(map);
    function base(k) { return { color: meta.colors[k], weight: meta.weights[k], opacity: k === meta.ramp ? 0.7 : 0.9 }; }
    var byRoad = {}, ramps = [], roads = [];
    GovMap.islands("map-lines").forEach(function (f) {
      var line = L.polyline(GovMap.ring(f[2], meta.origin, meta.scale), base(f[0]));
      line._k = f[0];
      (f[0] === meta.ramp ? ramps : roads).push(line);
      if (f[1] > 0) { (byRoad[f[1]] = byRoad[f[1]] || []).push(line); }
      line.bindPopup(function () {
        return GovMap.popup(f[1] > 0 ? "כביש " + f[1] : meta.kinds[f[0]], [["סוג", meta.kinds[f[0]]]]);
      });
    });
    ramps.concat(roads).forEach(function (l) { l.addTo(map); });
    map.fitBounds(meta.bounds, { padding: [8, 8] });
    var msg = document.getElementById("map-msg"), input = document.getElementById("map-road"), lit = [];
    function clear() {
      lit.forEach(function (l) { l.setStyle(base(l._k)); });
      lit = [];
      msg.textContent = "";
    }
    function find() {
      clear();
      var v = String(input.value || "").replace(/[^0-9]/g, "").replace(/^0+/, "");
      var ls = v ? byRoad[v] : null;
      if (!ls) { msg.textContent = v ? "כביש " + v + " לא נמצא במפה" : ""; return; }
      ls.forEach(function (l) { l.setStyle({ color: "#dc3545", weight: 6, opacity: 1 }); l.bringToFront(); });
      lit = ls;
      map.fitBounds(L.featureGroup(ls).getBounds(), { padding: [16, 16], maxZoom: 14 });
      msg.textContent = "כביש " + v + " מודגש באדום";
    }
    document.getElementById("map-go").addEventListener("click", find);
    input.addEventListener("keydown", function (e) { if (e.key === "Enter") { e.preventDefault(); find(); } });
    document.getElementById("map-reset").addEventListener("click", function () {
      clear();
      input.value = "";
      map.fitBounds(meta.bounds, { padding: [8, 8] });
    });
  })();
</script>
{%- endif %}

