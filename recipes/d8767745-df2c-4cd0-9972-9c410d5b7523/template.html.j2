<h1>{{ model.agent_data.seo.name }}</h1>

<style>
  .road-table th, .road-table td { padding: 0.35rem 0.5rem; text-align: start; vertical-align: top; }
  .road-table tbody tr { border-top: 1px solid #c3cfe7; }
  .road-table summary { cursor: pointer; }
</style>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור כביש לפי מספר דרך ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל מקטעי המאגר: מספר הדרך, דרגת הדרך (מהירה, ראשית, אזורית, מקומית), סוג הקישור (דרך ממוספרת, רמפה, דרך שירות) ושם או קוד הרמפה.</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.roads.tone }} mb-1" dir="ltr">{{ model.kpis.roads.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.roads_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.km.tone }} mb-1" dir="ltr">{{ model.kpis.km.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.km_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.ramps.tone }} mb-1" dir="ltr">{{ model.kpis.ramps.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.ramps_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.changes.tone }} mb-1" dir="ltr">{{ model.kpis.changes.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.changes_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

{%- if model.flags.map %}
<section class="card p-5 mb-6" id="road-map">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מפת הדרכים הארציות לפי מספר ודרגה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.map_note }}</p>
  <div id="map-find" class="flex flex-wrap items-center gap-2 mb-3">
    <label for="map-road" class="text-sm text-ink">הצג כביש מספר</label>
    <input id="map-road" type="text" inputmode="numeric" autocomplete="off" class="rounded-gov border border-rule px-3 py-1 text-sm w-28" dir="ltr" />
    <button type="button" id="map-go" class="rounded-gov-pill border border-rule px-3 py-1 text-sm text-ink bg-surface">הצג</button>
    <button type="button" id="map-reset" class="rounded-gov-pill border border-rule px-3 py-1 text-sm text-ink bg-surface">כל הארץ</button>
    <span id="map-msg" class="text-sm text-subtle" role="status"></span>
  </div>
  <div id="map-main" class="h-[480px] md:h-[640px]" role="region" aria-label="{{ model.labels.map_aria }}" data-fallback="explorer"></div>
  <ul class="flex flex-wrap gap-x-4 gap-y-2 mt-3 mb-0 ps-0 list-none text-sm text-subtle">
{%- for t in model.tables.legend %}
    <li class="flex items-center gap-2"><span style="display:inline-block;width:24px;height:4px;border-radius:2px;background:{{ t.color }}"></span>{{ t.name }}</li>
{%- endfor %}
  </ul>
</section>
{%- endif %}

<section class="card p-5 mb-6" id="road-list">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">רשימת הכבישים הראשיים (מספר בן ספרה אחת או שתיים)</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.main_note }}</p>
  <div class="overflow-x-auto">
    <table class="road-table w-full text-sm" id="table-main">
      <caption class="sr-only">{{ model.labels.main_caption }}</caption>
      <thead><tr><th scope="col">כביש</th><th scope="col">דרגה</th><th scope="col">אורך (ק"מ)</th><th scope="col">מקטעים</th></tr></thead>
      <tbody>
{%- for r in model.tables.main %}
        <tr><th scope="row">כביש {{ r.num }}</th><td>{{ r.cls }}{% if r.mixed %} <span class="text-subtle">(דרגה משתנה)</span>{% endif %}</td><td dir="ltr" class="text-start">{{ r.km }}</td><td>{{ r.segs }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </div>
{%- if model.flags.regional %}
  <details class="mt-4">
    <summary class="text-sm font-semibold text-ink-deep cursor-pointer">{{ model.labels.reg_summary }}</summary>
    <div class="overflow-x-auto">
      <table class="road-table mt-2 w-full text-sm" id="table-regional">
        <caption class="sr-only">{{ model.labels.reg_caption }}</caption>
        <thead><tr><th scope="col">כביש</th><th scope="col">דרגה</th><th scope="col">אורך (ק"מ)</th><th scope="col">מקטעים</th></tr></thead>
        <tbody>
{%- for r in model.tables.regional %}
          <tr><th scope="row">כביש {{ r.num }}</th><td>{{ r.cls }}{% if r.mixed %} <span class="text-subtle">(דרגה משתנה)</span>{% endif %}</td><td dir="ltr" class="text-start">{{ r.km }}</td><td>{{ r.segs }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
{%- endif %}
  <p class="m-0 mt-3 text-sm text-subtle">{{ model.labels.local_note }}</p>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">הכבישים הארוכים בישראל</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.top_note }}</p>
  <style>@media (max-width: 640px) { #chart-top { height: 540px; } }</style>
  <div id="chart-top" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.top_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="road-table mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.top_caption }}</caption>
      <thead><tr><th scope="col">כביש</th><th scope="col">דרגה</th><th scope="col">אורך (ק"מ)</th><th scope="col">מקטעים</th></tr></thead>
      <tbody>
{%- for r in model.tables.top %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.cls }}</td><td dir="ltr" class="text-start">{{ r.km }}</td><td>{{ r.segs }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

{%- if model.flags.lat %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מצפון לדרום: היכן עוברים הכבישים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.lat_note }}</p>
  <div id="chart-lat" class="h-[420px] md:h-[460px]" role="img" aria-label="{{ model.labels.lat_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="road-table mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.lat_caption }}</caption>
      <thead><tr><th scope="col">קו רוחב (מעלות)</th><th scope="col">ק"מ</th><th scope="col">שיעור מהאורך</th></tr></thead>
      <tbody>
{%- for r in model.tables.lat %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.km }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{%- endif %}

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">דרגות הדרכים: מהירה, ראשית, אזורית, מקומית</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.class_note }}</p>
    <div id="chart-class" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.class_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="road-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.class_caption }}</caption>
        <thead><tr><th scope="col">דרגה</th><th scope="col">כבישים</th><th scope="col">ק"מ</th><th scope="col">שיעור מהאורך</th></tr></thead>
        <tbody>
{%- for r in model.tables.cls %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.roads }}</td><td>{{ r.km }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/list.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">מה מספר הספרות אומר על הכביש</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.digit_note }}</p>
    <div id="chart-digits" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.digit_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
      <table class="road-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.digit_caption }}</caption>
        <thead><tr><th scope="col">ספרות</th><th scope="col">כבישים</th><th scope="col">ק"מ</th><th scope="col">דרגה מובילה</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.digits %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.roads }}</td><td>{{ r.km }}</td><td>{{ r.lead }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
      </div>
    </details>
  </section>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">כמה ארוך כביש טיפוסי</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.len_note }}</p>
    <div id="chart-len" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.len_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="road-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.len_caption }}</caption>
        <thead><tr><th scope="col">אורך (ק"מ)</th><th scope="col">כבישים</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.len %}
          <tr><th scope="row" dir="ltr" class="text-start">{{ r.name }}</th><td>{{ r.roads }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">דרכים, רמפות ודרכי שירות</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.link_note }}</p>
    <div id="chart-link" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.link_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="road-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.link_caption }}</caption>
        <thead><tr><th scope="col">סוג קישור</th><th scope="col">מקטעים</th><th scope="col">ק"מ</th></tr></thead>
        <tbody>
{%- for r in model.tables.link %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.segs }}</td><td>{{ r.km }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מרחב המספרים: אילו מספרי דרך תפוסים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.space_note }}</p>
  <div id="chart-space" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.space_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="road-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.space_caption }}</caption>
        <thead><tr><th scope="col">ספרות</th>{% for x in model.tables.space_x %}<th scope="col">מתחיל ב-{{ x }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in model.tables.space %}
          <tr><th scope="row">{{ r.name }}</th>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>

{%- if model.flags.changes %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/triangle-alert.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">שינויי מספור דרכים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.change_note }}</p>
  <div id="chart-change" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.change_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="road-table mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.change_caption }}</caption>
      <thead><tr><th scope="col">חודש</th><th scope="col">מקטעים</th><th scope="col">דרכים</th></tr></thead>
      <tbody>
{%- for r in model.tables.change %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.segs }}</td><td>{{ r.roads }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{%- endif %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">שכבת מספרי דרכים ארציות מציגה מקטעי כביש שלהם הוקצה מספר דרך ארצית. דרכים אלה לרבות המספרים מופיעות במפת מספרי דרכים ארציות אשר נחתמה ע"י המפקח הארצי על התעבורה. מפות אלה זמינות באתר משרד התחבורה</p>
  <p class="m-0 mt-3 text-sm text-subtle">{{ model.labels.method }}</p>
</section>

<script>
  (function () {
    var d = {{ model.charts.top | tojson }};
    var el = document.getElementById("chart-top"), narrow = el.clientWidth < 500;
    var c = echarts.init(el);
    var series = d.classes.map(function (k) {
      return { type: "bar", name: k, stack: "road", barMaxWidth: 22,
               data: d.km.map(function (v, i) { return d.cls[i] === k ? v : null; }),
               label: { show: true, position: "right", formatter: function (p) { return p.value == null ? "" : p.value.toLocaleString("he-IL"); } } };
    });
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        return echarts.format.encodeHTML(d.names[i]) + "<br>" + echarts.format.encodeHTML(d.cls[i]) + ": " + d.km[i].toLocaleString("he-IL") + " ק\"מ";
      } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 48, top: 8, bottom: narrow ? 56 : 40, containLabel: true },
      xAxis: { type: "value", name: narrow ? "" : "ק\"מ", axisLabel: { show: !narrow } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { interval: 0, fontSize: narrow ? 10 : 12 } },
      series: series
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.cls | tojson }};
    var el = document.getElementById("chart-class"), narrow = el.clientWidth < 500;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: narrow ? { interval: 0, rotate: 30, fontSize: 10 } : { interval: 0 } },
      yAxis: [{ type: "value", name: "ק\"מ" }, { type: "value", name: "כבישים", splitLine: { show: false } }],
      series: [
        { type: "bar", name: "ק\"מ מקטעים", data: d.km },
        { type: "bar", name: "כבישים", yAxisIndex: 1, data: d.roads }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.digits | tojson }};
    var el = document.getElementById("chart-digits"), narrow = el.clientWidth < 500;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: narrow ? 32 : 24, bottom: narrow ? 64 : 40, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: narrow ? { interval: 0, rotate: 30, fontSize: 10 } : { interval: 0 } },
      yAxis: { type: "value", name: "כבישים", minInterval: 1 },
      series: d.series.map(function (s) { return { type: "bar", name: s.name, stack: "dig", data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.len | tojson }};
    var el = document.getElementById("chart-len");
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        return echarts.format.encodeHTML(d.names[p[0].dataIndex]) + " ק\"מ: " + p[0].value.toLocaleString("he-IL") + " כבישים";
      } },
      grid: { left: 16, right: 24, top: 36, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.names, name: el.clientWidth < 500 ? "" : "ק\"מ", axisLabel: { interval: 0, rotate: 30 } },
      yAxis: { type: "value", name: "כבישים", minInterval: 1 },
      series: [{ type: "bar", name: "כבישים", data: d.roads, label: { show: true, position: "top" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.link | tojson }};
    var el = document.getElementById("chart-link"), narrow = el.clientWidth < 500;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
