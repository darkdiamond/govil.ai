<h1>הליכי בתי הדין ברשות הפטנטים</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.procs.tone }} mb-1" dir="ltr">{{ model.kpis.procs.display }}</div>
    <div class="text-sm text-subtle">הליכים במאגר</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.active.tone }} mb-1" dir="ltr">{{ model.kpis.active.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.active_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.opened.tone }} mb-1" dir="ltr">{{ model.kpis.opened.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.opened_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.clearance.tone }} mb-1" dir="ltr">{{ model.kpis.clearance.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.clearance_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">הליכים חדשים בכל שנה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.years_note }}</p>
  <div id="chart-years" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.years_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.years_aria }}</caption>
      <thead><tr><th scope="col">שנת פתיחה</th>{% for h in model.tables.years_heads %}<th scope="col">{{ h }}</th>{% endfor %}<th scope="col">סך הכול</th></tr></thead>
      <tbody>
{%- for r in model.tables.years %}
        <tr><th scope="row">{{ r.year }}</th>{% for v in r.vals %}<td>{{ v }}</td>{% endfor %}<td>{{ r.total }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">נפתחו מול נסגרו</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.flow_note }}</p>
    <div id="chart-flow" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.flow_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.flow_aria }}</caption>
        <thead><tr><th scope="col">שנה</th><th scope="col">נפתחו</th><th scope="col">נסגרו או אוחדו</th><th scope="col">הפרש</th></tr></thead>
        <tbody>
{%- for r in model.tables.flow %}
          <tr><th scope="row">{{ r.year }}</th><td>{{ r.opened }}</td><td>{{ r.resolved }}</td><td dir="ltr">{{ r.net }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">סטטוס ההליכים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.status_note }}</p>
    <div id="chart-status" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.status_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.status_aria }}</caption>
        <thead><tr><th scope="col">סטטוס</th><th scope="col">הליכים</th><th scope="col">שיעור (%)</th></tr></thead>
        <tbody>
{%- for r in model.tables.status %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.n }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">הליכים לפי מחלקה</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.dept_note }}</p>
    <div id="chart-dept" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.dept_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.dept_aria }}</caption>
        <thead><tr><th scope="col">מחלקה</th><th scope="col">הליכים</th><th scope="col">שיעור (%)</th><th scope="col">פעילים</th></tr></thead>
        <tbody>
{%- for r in model.tables.dept %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.n }}</td><td>{{ r.share }}</td><td>{{ r.active }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/list.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">כמה תיקים בכל הליך</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.files_note }}</p>
    <div id="chart-files" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.files_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.files_aria }}</caption>
        <thead><tr><th scope="col">תיקים בהליך</th><th scope="col">הליכים</th><th scope="col">שיעור (%)</th></tr></thead>
        <tbody>
{%- for r in model.tables.files %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.n }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">סוגי ההליכים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.types_note }}</p>
  <div id="chart-types" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.types_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.types_aria }}</caption>
      <thead><tr><th scope="col">סוג הליך</th><th scope="col">הליכים</th><th scope="col">שיעור (%)</th>{% for h in model.tables.types_heads %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for r in model.tables.types %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.n }}</td><td>{{ r.share }}</td>{% for v in r.vals %}<td>{{ v }}</td>{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תמהיל ההליכים במחלקה המובילה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.mix_note }}</p>
  <div id="chart-mix" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.mix_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה (%)</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.mix_aria }}</caption>
      <thead><tr><th scope="col">שנת פתיחה</th>{% for h in model.tables.mix_heads %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for r in model.tables.mix %}
        <tr><th scope="row">{{ r.year }}</th>{% for v in r.vals %}<td>{{ v }}</td>{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

{% if model.flags.backlog or model.flags.dur %}
<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
{% if model.flags.backlog %}
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/triangle-alert.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">ההליכים הפעילים לפי ותק</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.backlog_note }}</p>
    <div id="chart-backlog" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.backlog_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.backlog_aria }}</caption>
        <thead><tr><th scope="col">שנת פתיחה</th><th scope="col">פעילים</th>{% for h in model.tables.backlog_heads %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in model.tables.backlog %}
          <tr><th scope="row">{{ r.year }}</th><td>{{ r.n }}</td>{% for v in r.vals %}<td>{{ v }}</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
      </div>
    </details>
  </section>
{% endif %}
{% if model.flags.dur %}
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">כמה זמן נמשך הליך</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.dur_note }}</p>
    <div id="chart-dur" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.dur_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה (%)</summary>
      <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.dur_aria }}</caption>
        <thead><tr><th scope="col">מחלקה</th><th scope="col">נסגרו</th>{% for h in model.charts.dur.x %}<th scope="col">{{ h }}</th>{% endfor %}<th scope="col">עדיין פעילים</th></tr></thead>
        <tbody>
{%- for r in model.tables.dur %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.n }}</td>{% for v in r.vals %}<td>{{ v }}</td>{% endfor %}<td>{{ r.still }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
      </div>
    </details>
  </section>
{% endif %}
</div>
{% endif %}

{% if model.flags.heat %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מתי נסגרים ההליכים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.heat_note }}</p>
  <div id="chart-heat" data-fallback="explorer" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.heat_aria }}"></div>
</section>
{% endif %}

{% if model.flags.top %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">ההליכים הגדולים ביותר</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.top_note }}</p>
  <div class="overflow-x-auto">
  <table class="w-full text-sm">
    <caption class="sr-only">{{ model.labels.top_note }}</caption>
    <thead><tr><th scope="col" class="py-1 pe-3 text-start">הליך</th><th scope="col" class="py-1 text-start">שם ההליך</th></tr></thead>
    <tbody>
{%- for r in model.tables.top %}
      <tr class="border-t border-rule"><th scope="row" class="py-2 pe-3 text-start align-top"><span class="block whitespace-nowrap">{{ r.id }}</span><span class="block text-xs font-normal text-subtle">{{ r.files }} תיקים · {{ r.typ }} · {{ r.st }}</span></th><td class="py-2 align-top">{{ r.name }}</td></tr>
{%- endfor %}
    </tbody>
  </table>
  </div>
</section>
{% endif %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">המאגר מציג את ההליכים הקיימים ברשם הפטנטים במחלקות פטנטים, סימני מסחר ועיצובים (מדגמים).</p>
</section>

<script>
  (function () {
    var narrow = window.innerWidth < 640;
    var DEPT = ["#0068f5", "#0b3668", "#9fc3f7", "#5a9bf6", "#6c757d"];
    var y = {{ model.charts.years | tojson }};
    var c1 = echarts.init(document.getElementById("chart-years"));
    c1.setOption(window.GovEcharts.option({
      color: DEPT,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: y.x, axisLabel: { rotate: narrow ? 60 : 0 } },
      yAxis: { type: "value", name: "הליכים" },
      series: y.series.map(function (s) { return { type: "bar", stack: "d", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    var f = {{ model.charts.flow | tojson }};
    var c2 = echarts.init(document.getElementById("chart-flow"));
    c2.setOption(window.GovEcharts.option({
      color: ["#0068f5", "#0b3668"],
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: f.x, axisLabel: { rotate: 60 } },
      yAxis: { type: "value" },
      series: [
        { type: "line", name: "נפתחו", data: f.opened, symbolSize: 6 },
        { type: "line", name: "נסגרו או אוחדו", data: f.resolved, symbolSize: 6, lineStyle: { type: "dashed" } }
      ]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    var narrow = window.innerWidth < 640;
    var s = {{ model.charts.status | tojson }};
    var c3 = echarts.init(document.getElementById("chart-status"));
    c3.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 48, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: narrow ? 2 : 4, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: s.names.slice().reverse(), axisLabel: { width: narrow ? 100 : 130, overflow: "truncate" } },
      series: [{ type: "bar", name: "הליכים", label: { show: true, position: "right", color: "#0c3058", formatter: function (p) { return p.value.toLocaleString("en-US"); } }, data: s.values.slice().reverse().map(function (v, i, a) {
        return { value: v, itemStyle: { color: s.colors[a.length - 1 - i] } };
      }) }]
    }));
    window.addEventListener("resize", function () { c3.resize(); });

    function hbar(id, d, name, w) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: narrow ? 2 : 5, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: narrow ? Math.min(w, 110) : w, overflow: "truncate" } },
        series: [{ type: "bar", name: name, data: d.values.slice().reverse() }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    hbar("chart-dept", {{ model.charts.dept | tojson }}, "הליכים", 150);

    var fl = {{ model.charts.files | tojson }};
    var c4 = echarts.init(document.getElementById("chart-files"));
    c4.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 16, top: 24, bottom: narrow ? 48 : 32, containLabel: true },
      xAxis: { type: "category", data: fl.names, name: "תיקים בהליך", nameLocation: "middle", nameGap: narrow ? 44 : 28, axisLabel: { interval: 0, rotate: narrow ? 35 : 0 } },
      yAxis: { type: "log", min: 1 },
      series: [{ type: "bar", name: "הליכים", data: fl.values.map(function (v) { return v > 0 ? v : null; }) }]
    }));
    window.addEventListener("resize", function () { c4.resize(); });
  })();
</script>

<script>
  (function () {
    var narrow = window.innerWidth < 640;
    var t = {{ model.charts.types | tojson }};
    var c5 = echarts.init(document.getElementById("chart-types"));
    c5.setOption(window.GovEcharts.option({
      color: ["#0068f5", "#0b3668", "#9fc3f7", "#5a9bf6", "#6c757d"],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 56, containLabel: true },
      xAxis: { type: "value", splitNumber: narrow ? 2 : 5, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: t.names.slice().reverse(), axisLabel: { width: narrow ? 110 : 220, overflow: "truncate" } },
      series: t.series.map(function (s) { return { type: "bar", stack: "d", name: s.name, data: s.data.slice().reverse() }; })
    }));
    window.addEventListener("resize", function () { c5.resize(); });

    var m = {{ model.charts.mix | tojson }};
    var c6 = echarts.init(document.getElementById("chart-mix"));
    c6.setOption(window.GovEcharts.option({
      color: ["#0068f5", "#0b3668", "#9fc3f7", "#5a9bf6", "#c3cfe7"],
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: narrow ? 96 : 72, containLabel: true },
      xAxis: { type: "category", data: m.x, axisLabel: { rotate: narrow ? 60 : 0 } },
      yAxis: { type: "value", max: 100, name: "%" },
      series: m.series.map(function (s) { return { type: "bar", stack: "s", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c6.resize(); });
  })();
</script>

{% if model.flags.backlog %}
<script>
  (function () {
    var b = {{ model.charts.backlog | tojson }};
    var c7 = echarts.init(document.getElementById("chart-backlog"));
    c7.setOption(window.GovEcharts.option({
      color: ["#0068f5", "#0b3668", "#9fc3f7", "#5a9bf6", "#6c757d"],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: b.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value" },
      series: b.series.map(function (s) { return { type: "bar", stack: "d", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c7.resize(); });
  })();
</script>
{% endif %}

