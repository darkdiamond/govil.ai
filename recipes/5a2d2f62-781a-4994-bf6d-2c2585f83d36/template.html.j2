      } },
      grid: { left: 16, right: 16, top: 16, bottom: 80, containLabel: true },
      xAxis: { type: "category", data: h.months, axisLabel: { rotate: window.innerWidth < 640 ? 60 : 0 }, splitArea: { show: true } },
      yAxis: { type: "category", data: h.years, splitArea: { show: true } },
      visualMap: {
        min: 0, max: h.max, calculable: true, dimension: 2,
