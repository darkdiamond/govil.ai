{%- for key in ["c", "f", "b", "e"] %}
{%- for chunk in model.map[key] %}
<script type="application/json" id="map-{{ key }}-{{ loop.index0 }}">{{ chunk | tojson }}</script>
{%- endfor %}
{%- endfor %}
<script>
  (function () {
    var el = document.getElementById("map-preservation");
    if (!el || !window.L) { return; }
    var M = {{ model.map.meta | tojson }};
    var N = {{ {"b": model.map.b | length, "c": model.map.c | length, "f": model.map.f | length, "e": model.map.e | length} | tojson }};
    var ox = M.origin[0], oy = M.origin[1], k = M.scale;
    var ramp = ["#0c1f3d", "#0053c4", "#3d70b0", "#6c9fd8", "#9fc0ee"];
    function color(g) { var r = M.rank[g]; return r < ramp.length ? ramp[r] : "#6c757d"; }
    function feats(key) {
      var out = [];
      for (var c = 0; c < N[key]; c++) {
        var node = document.getElementById("map-" + key + "-" + c);
        if (node) { out = out.concat(JSON.parse(node.textContent)); }
      }
      return out;
    }
    function path(flat) {
      var out = [], x = ox, y = oy;
      for (var i = 0; i + 1 < flat.length; i += 2) { x += flat[i]; y += flat[i + 1]; out.push([y / k, x / k]); }
      return out;
    }
    function polys(p) { return p.map(function (rings) { return rings.map(path); }); }
    function pt(x, y) { return [(y + oy) / k, (x + ox) / k]; }
    function num(v) { return Number(v).toLocaleString("en-US"); }
    function popup(title, rows) {
      var box = document.createElement("div");
      var t = document.createElement("strong");
      t.textContent = title;
      box.appendChild(t);
      rows.forEach(function (r) {
        if (r[1] === "" || r[1] === null) { return; }
        var d = document.createElement("div");
        d.textContent = r[0] + ": " + r[1];
        box.appendChild(d);
      });
      return box;
    }
    var map = L.map(el, { scrollWheelZoom: false, zoomSnap: 0.25, preferCanvas: true });
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 19, attribution: "© OpenStreetMap" }).addTo(map);

    var cx = L.featureGroup();
    feats("c").forEach(function (f) {
      L.polygon(polys(f[4]), { color: "#0c3058", weight: 2, dashArray: "6 4", fillColor: color(f[0]), fillOpacity: 0.12 })
        .bindPopup(popup(f[1], [["דרגה", M.grades[f[0]]], ["שטח", f[2] + " דונם"], ["מבנים לשימור בתוכו", num(f[3])]]))
        .addTo(cx);
    });
    var fe = L.featureGroup();
    feats("f").forEach(function (f) {
      L.polyline(f[2].map(path), { color: color(f[0]), weight: 3, opacity: 0.9 })
        .bindPopup(popup("קטע גדר לשימור", [["דרגה", M.grades[f[0]]], ["אורך", num(f[1]) + " מ׳"]]))
        .addTo(fe);
    });
    var bShapes = L.featureGroup(), bDots = L.featureGroup();
    feats("b").forEach(function (f) {
      var info = popup("מבנה לשימור", [
        ["דרגה", M.grades[f[0]]],
        ["תקופה או הערה", f[1] >= 0 ? M.years[f[1]] : ""],
        ["כרטיס סקר", f[2] > 0 ? String(f[2]) : ""],
        ["שטח", f[3] >= 0 ? num(f[3]) + " מ״ר" : ""]
      ]);
      var c = color(f[0]);
      L.polygon(polys(f[6]), { color: c, weight: 1, fillColor: c, fillOpacity: 0.6 }).bindPopup(info).addTo(bShapes);
      L.circleMarker(pt(f[4], f[5]), { radius: 3.5, stroke: false, fillColor: c, fillOpacity: 0.85 }).bindPopup(info).addTo(bDots);
    });
    var bld = L.layerGroup();
    var el2 = L.featureGroup();
    feats("e").forEach(function (f) {
      L.circleMarker(pt(f[3], f[4]), { radius: 6, color: "#ffffff", weight: 2, fillColor: color(f[0]), fillOpacity: 1 })
        .bindPopup(popup(f[1], [["דרגה", M.grades[f[0]]], ["הערה", f[2]]]))
        .addTo(el2);
    });
    function syncBuildings() {
      var near = map.getZoom() >= 16;
      bld.clearLayers();
      bld.addLayer(near ? bShapes : bDots);
    }
    cx.addTo(map);
    fe.addTo(map);
    bld.addTo(map);
    el2.addTo(map);
    var overlays = {};
    overlays[M.layers[1]] = cx;
    overlays[M.layers[2]] = fe;
    overlays[M.layers[0]] = bld;
    overlays[M.layers[3]] = el2;
    L.control.layers(null, overlays, { collapsed: window.innerWidth < 640 }).addTo(map);
    map.on("zoomend", syncBuildings);
    map.fitBounds(M.bounds, { padding: [8, 8] });
    syncBuildings();

    var legend = document.getElementById("map-legend");
    function item(css, text) {
      var li = document.createElement("li");
      li.className = "flex items-center gap-2";
      var sw = document.createElement("span");
      sw.style.cssText = "display:inline-block;" + css;
      li.appendChild(sw);
      li.appendChild(document.createTextNode(text));
      legend.appendChild(li);
    }
    M.grades.forEach(function (g, i) {
      item("width:12px;height:12px;border-radius:2px;background:" + color(i), g);
    });
    item("width:18px;height:12px;border:2px dashed #0c3058;border-radius:2px", M.layers[1]);
    item("width:12px;height:12px;border-radius:50%;border:2px solid #ffffff;box-shadow:0 0 0 1px #0c3058;background:#3d70b0", M.layers[3]);
  })();
</script>

<script>
  (function () {
    function mk(id) {
      var el = document.getElementById(id);
      if (!el) { return null; }
      var c = echarts.init(el);
      window.addEventListener("resize", function () { c.resize(); });
      return c;
    }
    window.__mk = mk;
    window.__hbar = function (id, d, unit) {
      var c = mk(id); if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 4 },
        yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 130, overflow: "truncate" } },
        series: [{ type: "bar", name: unit, data: d.values.slice().reverse() }]
      }));
    };
    window.__vbar = function (id, d, unit) {
      var c = mk(id); if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 16, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, fontSize: 11, rotate: window.innerWidth < 500 ? 35 : 0 } },
        yAxis: { type: "value" },
        series: [{ type: "bar", name: unit, data: d.values }]
      }));
    };
    window.__stack = function (id, cats, names, series, unit) {
      var c = mk(id); if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { bottom: 0 },
        grid: { left: 8, right: 16, top: 16, bottom: 48, containLabel: true },
        xAxis: { type: "category", data: cats, axisLabel: { interval: 0, fontSize: 11, rotate: window.innerWidth < 500 ? 35 : 0 } },
        yAxis: { type: "value" },
        series: names.map(function (n, i) { return { type: "bar", stack: "t", name: n, data: series[i] }; })
      }));
    };
  })();
</script>

<script>
  (function () {
    var L1 = {{ model.charts.layers | tojson }};
    window.__hbar("chart-layers", L1, "פריטים");
    var S = {{ model.charts.standards | tojson }};
    window.__vbar("chart-standards", S, "מבנים");
  })();
</script>

<script>
  (function () {
    var E = {{ model.charts.eras | tojson }};
    window.__vbar("chart-eras", E, "מבנים");
    var SE = {{ model.charts.std_era | tojson }};
    window.__stack("chart-std-era", SE.eras, SE.names, SE.series);
  })();
</script>

<script>
  (function () {
    var A = {{ model.charts.areas | tojson }};
    window.__stack("chart-areas", A.bands, A.names, A.series);
    var D = {{ model.charts.dist | tojson }};
    window.__stack("chart-dist", D.bands, D.names, D.series);
  })();
</script>

<script>
  (function () {
    var C = {{ model.charts.cards | tojson }};
    window.__vbar("chart-cards", C, "אחוז מהמבנים");
    var T = {{ model.charts.top_cards | tojson }};
    window.__hbar("chart-top-cards", T, "מבנים");
  })();
</script>

<script>
  (function () {
    var X = {{ model.charts.cx_top | tojson }};
    window.__hbar("chart-cx-top", X, "דונם");
    var XB = {{ model.charts.cx_bld | tojson }};
    window.__hbar("chart-cx-bld", XB, "מבנים");
    var Y = {{ model.charts.cx_std | tojson }};
    var c = window.__mk("chart-cx-std");
    if (c) {
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { bottom: 0 },
        grid: { left: 8, right: 8, top: 16, bottom: 48, containLabel: true },
        xAxis: { type: "category", data: Y.names, axisLabel: { interval: 0, fontSize: 11, rotate: window.innerWidth < 500 ? 35 : 0 } },
        yAxis: [{ type: "value", name: "מתחמים" }, { type: "value", name: "דונם", splitLine: { show: false } }],
        series: [
          { type: "bar", name: "מתחמים", data: Y.counts },
          { type: "bar", name: "שטח (דונם)", yAxisIndex: 1, data: Y.areas }
        ]
      }));
    }
  })();
</script>

<script>
  (function () {
    var F = {{ model.charts.fe_std | tojson }};
    window.__vbar("chart-fe-std", { names: F.names, values: F.km }, "ק״מ");
    var G = {{ model.charts.fe_len | tojson }};
    window.__stack("chart-fe-len", G.bands, G.names, G.series);
    var H = {{ model.charts.el_std | tojson }};
    window.__vbar("chart-el-std", H, "אלמנטים");
  })();
</script>
