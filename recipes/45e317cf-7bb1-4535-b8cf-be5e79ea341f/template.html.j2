<script>
  (function () {
    function lines(id, d, unit, yname, scale) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", valueFormatter: function (v) { return v === null || v === undefined ? "—" : v.toLocaleString("he-IL") + unit; } },
        legend: { bottom: 0 },
        grid: { left: 40, right: 16, top: 32, bottom: 88, containLabel: true },
        xAxis: { type: "category", data: d.x },
        yAxis: { type: "value", name: yname, scale: scale },
        series: d.series.map(function (s) { return { type: "line", name: s.name, data: s.data, showSymbol: false, connectNulls: false }; })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
{%- if model.flags.local %}
    lines("chart-local", {{ model.charts.local | tojson }}, "%", "% מקומי", false);
{%- endif %}
    lines("chart-co2", {{ model.charts.co2 | tojson }}, "", "גרם לק״מ", true);
    var n = {{ model.charts.nox | tojson }};
    lines("chart-nox", { x: n.x, series: [{ name: "בנזין", data: n.p }, { name: "דיזל", data: n.d }] }, "", "מ״ג לק״מ", false);
    lines("chart-comfort", {{ model.charts.comfort | tojson }}, "%", "%", false);
    var b = {{ model.charts.body_trend | tojson }};
    lines("chart-body-trend", { x: b.x, series: [{ name: "פנאי-שטח", data: b.suv }, { name: "הנעה 4X4", data: b.awd }] }, "%", "%", false);
    var sp = {{ model.charts.specs | tojson }};
    sp.series.forEach(function (s) {
      var c = echarts.init(document.getElementById("chart-spec-" + s.key));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", valueFormatter: function (v) { return v === null ? "—" : v.toLocaleString("he-IL"); } },
        grid: { left: 40, right: 16, top: 24, bottom: 32, containLabel: true },
        xAxis: { type: "category", data: sp.x },
        yAxis: { type: "value", scale: true },
        series: [{ type: "line", name: s.name, data: s.data, showSymbol: false, lineStyle: { width: 3 } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    });
  })();
</script>

