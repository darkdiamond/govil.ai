<script>
  (function () {
    var f = {{ model.charts.fleet_year | tojson }};
    var c = echarts.init(document.getElementById("chart-fleet"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v.toLocaleString("he-IL"); } },
      legend: { bottom: 0 },
      grid: { left: 48, right: 16, top: 24, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: f.x },
      yAxis: { type: "value", name: "כלי רכב" },
      series: f.series.map(function (s) { return { type: "bar", stack: "t", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    function stack100(id, d, kind) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
        legend: { bottom: 0 },
        grid: { left: 40, right: 16, top: 24, bottom: 96, containLabel: true },
        xAxis: { type: "category", data: d.x, boundaryGap: kind === "bar" },
        yAxis: { type: "value", max: 100, name: "%" },
        series: d.series.map(function (s) {
          var o = { type: kind, stack: "t", name: s.name, data: s.data, showSymbol: false };
          if (kind === "line") { o.areaStyle = {}; o.lineStyle = { width: 1 }; }
          return o;
        })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    stack100("chart-mix", {{ model.charts.mix | tojson }}, "line");
    stack100("chart-origin", {{ model.charts.origin | tojson }}, "bar");
{%- if model.flags.safety %}
    stack100("chart-safety", {{ model.charts.safety | tojson }}, "bar");
{%- endif %}
{%- if model.flags.zihum %}
    stack100("chart-zihum", {{ model.charts.zihum | tojson }}, "bar");
{%- endif %}
  })();
</script>

<script>
  (function () {
    var m = {{ model.charts.makes | tojson }};
    var c = echarts.init(document.getElementById("chart-makes"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v.toLocaleString("he-IL"); } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "value", axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: m.names, inverse: true, axisLabel: { interval: 0 } },
      series: m.series.map(function (s) { return { type: "bar", stack: "t", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });

    function hbar(id, d) {
      var h = echarts.init(document.getElementById(id));
      h.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v.toLocaleString("he-IL"); } },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { interval: 0 } },
        series: [{ type: "bar", name: "כלי רכב פעילים", data: d.values }]
      }));
      window.addEventListener("resize", function () { h.resize(); });
    }
    hbar("chart-models", {{ model.charts.models | tojson }});
    hbar("chart-ev", {{ model.charts.ev | tojson }});
    hbar("chart-body", {{ model.charts.body | tojson }});
  })();
</script>

<script>
  (function () {
    var s = {{ model.charts.survival | tojson }};
    var c = echarts.init(document.getElementById("chart-survival"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 48, right: 48, top: 32, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: s.x },
      yAxis: [
        { type: "value", name: "% פעילים", max: 100 },
        { type: "value", name: "לא פעילים", splitLine: { show: false } }
      ],
      series: [
        { type: "bar", name: "כלי רכב שאינם פעילים", yAxisIndex: 1, data: s.inactive, itemStyle: { color: "#c3cfe7" },
          tooltip: { valueFormatter: function (v) { return v.toLocaleString("he-IL"); } } },
        { type: "line", name: "% עדיין פעילים", data: s.share, showSymbol: false, lineStyle: { width: 3 },
          tooltip: { valueFormatter: function (v) { return v === null ? "—" : v + "%"; } } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
