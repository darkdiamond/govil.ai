<script>
  (function () {
    var d = {{ model.charts.yearly | tojson }};
    var c = echarts.init(document.getElementById("chart-yearly"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", name: "מספר" },
      series: [
        { type: "bar", name: "החלטות", data: d.decisions },
        { type: "line", name: "מוחזקים שונים", data: d.persons, showSymbol: false }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.monthly | tojson }};
    var c = echarts.init(document.getElementById("chart-monthly"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 16, right: 16, top: 32, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", name: "החלטות" },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 20 }],
      series: [{ type: "line", name: "החלטות", data: d.y, showSymbol: false, areaStyle: { opacity: 0.15 } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.mix | tojson }};
    var c = echarts.init(document.getElementById("chart-mix"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 24, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: d.x, boundaryGap: false },
      yAxis: { type: "value", max: 100, name: "%" },
      series: d.series.map(function (s) {
        var o = { type: "line", name: s.name, data: s.data, stack: "mix", areaStyle: {}, showSymbol: false, lineStyle: { width: 1 } };
        if (s.name === "אחר") { o.itemStyle = { color: "#c3cfe7" }; }
        return o;
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    function hbar(id, d, unit) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis" },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true },
        series: [{ type: "bar", name: unit, data: d.values }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    hbar("chart-countries", {{ model.charts.countries | tojson }}, "החלטות");
    hbar("chart-judges", {{ model.charts.judges | tojson }}, "החלטות");
    hbar("chart-judges-recent", {{ model.charts.judges_recent | tojson }}, "החלטות");
  })();
</script>

<script>
  (function () {
    function heat(id, h) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        tooltip: { position: "top", formatter: function (p) {
          return h.y[p.value[1]] + " · " + h.x[p.value[0]] + ": " + p.value[2].toLocaleString("he-IL");
        } },
        grid: { left: 16, right: 16, top: 16, bottom: 72, containLabel: true },
        xAxis: { type: "category", data: h.x, splitArea: { show: true } },
        yAxis: { type: "category", data: h.y, inverse: true, splitArea: { show: true } },
        visualMap: {
          min: 0, max: h.max, calculable: true, dimension: 2,
          orient: "horizontal", left: "center", bottom: 8,
          inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
          textStyle: { fontFamily: "Rubik", color: "#0c3058" }
        },
        series: [{ type: "heatmap", data: h.cells,
                   emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    heat("chart-cheat", {{ model.charts.cheat | tojson }});
    heat("chart-jheat", {{ model.charts.jheat | tojson }});
  })();
</script>

<script>
  (function () {
    function vbar(id, d, xname, yname) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis" },
        grid: { left: 16, right: 16, top: 32, bottom: 32, containLabel: true },
        xAxis: { type: "category", data: d.names, name: xname, nameLocation: "middle", nameGap: 28 },
        yAxis: { type: "value", name: yname },
        series: [{ type: "bar", name: yname, data: d.values }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    vbar("chart-pp", {{ model.charts.pp | tojson }}, "החלטות למוחזק", "מוחזקים");
    vbar("chart-gap", {{ model.charts.gap | tojson }}, "ימים", "מרווחים");

    var r = {{ model.charts.repeat | tojson }};
    var c1 = echarts.init(document.getElementById("chart-repeat"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: r.names, inverse: true },
      series: [{ type: "bar", name: "ממוצע החלטות למוחזק", data: r.mean }]
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    var h = {{ model.charts.cohort | tojson }};
    var c2 = echarts.init(document.getElementById("chart-cohort"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: h.x },
      yAxis: [
        { type: "value", name: "ממוצע החלטות", scale: true },
        { type: "value", name: "%", max: 100, splitLine: { show: false } }
      ],
      series: [
        { type: "line", name: "ממוצע החלטות למוחזק", data: h.mean },
        { type: "line", name: "שיעור עם יותר מהחלטה אחת (%)", yAxisIndex: 1, data: h.multi }
      ]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>
