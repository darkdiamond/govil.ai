  })();
</script>

<script>
  (function () {
    var h = {{ model.charts.heat | tojson }};
    var c = echarts.init(document.getElementById("chart-heat"));
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return h.x[p.value[0]] + " " + h.y[p.value[1]] + ": " + p.value[2].toLocaleString("he-IL") + " הודעות";
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true }, axisLabel: { interval: 0, rotate: 45 } },
      yAxis: { type: "category", data: h.y, splitArea: { show: true } },
      visualMap: {
        min: 0, max: h.max, calculable: true, dimension: 2,
        orient: "horizontal", left: "center", bottom: 8,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells, label: { show: false },
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var w = {{ model.charts.weekday | tojson }};
    var c2 = echarts.init(document.getElementById("chart-weekday"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: w.x },
      yAxis: { type: "value", name: "הודעות" },
      series: [{ type: "bar", name: "הודעות", data: w.y }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

{%- if model.flags.map %}
<script>
  (function () {
    var d = {{ model.charts.map | tojson }};
    var el = document.getElementById("map-main");
    if (!el || !window.L) { return; }
    var map = L.map(el, { center: [31.9, 35.0], zoom: 7, zoomSnap: 0.25, scrollWheelZoom: false });
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 18, attribution: "© OpenStreetMap"
    }).addTo(map);
    var bounds = [];
    d.points.forEach(function (p) {
      var mk = L.circleMarker([p[0], p[1]], {
        radius: 3 + 1.1 * Math.sqrt(p[2]), color: "#0053c4", weight: 1,
        fillColor: "#0068f5", fillOpacity: 0.4
      }).addTo(map);
      var box = document.createElement("div");
      var t = document.createElement("strong");
      t.textContent = p[3];
      box.appendChild(t);
      [["הודעות", p[2].toLocaleString("he-IL")], ["אזור", p[4]], ["בית הדין העיקרי", p[5]]].forEach(function (row) {
        var line = document.createElement("div");
        line.textContent = row[0] + ": " + row[1];
        box.appendChild(line);
      });
      mk.bindPopup(box);
      bounds.push([p[0], p[1]]);
    });
    if (bounds.length) { map.fitBounds(bounds, { padding: [16, 16] }); }
  })();
</script>
{%- endif %}

