      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 40, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: d.x, inverse: true },
      series: d.series.map(function (s) { return { type: "bar", name: s.name, data: s.data }; })
    }));
