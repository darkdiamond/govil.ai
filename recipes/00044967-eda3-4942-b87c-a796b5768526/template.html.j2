    var el = document.getElementById("chart-lag-court");
    if (el) {
      var g = {{ model.charts.lag_court | tojson }};
      var c2 = echarts.init(el);
      c2.setOption(window.GovEcharts.option({
        color: ["#9ec5fe", "#4d94ff", "#0053c4", "#0b3668"],
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + "%"; } },
        legend: { bottom: 0, type: "scroll" },
        grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
        xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
        yAxis: { type: "category", data: g.y, inverse: true },
        series: g.series.map(function (s) { return { type: "bar", stack: "all", name: s.name, data: s.data }; })
      }));
      window.addEventListener("resize", function () { c2.resize(); });
    }
  })();
</script>

<script>
  (function () {
    var e1 = document.getElementById("chart-death");
    if (e1) {
      var d = {{ model.charts.death | tojson }};
      var c = echarts.init(e1);
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
        xAxis: { type: "category", data: d.x, axisLabel: { hideOverlap: true } },
        yAxis: { type: "value", name: "הודעות" },
        series: [{ type: "bar", name: "הודעות", data: d.y }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    var e2 = document.getElementById("chart-season");
    if (e2) {
      var s = {{ model.charts.season | tojson }};
      var c2 = echarts.init(e2);
      c2.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
        xAxis: { type: "category", data: s.x, axisLabel: { interval: 0, rotate: 45 } },
        yAxis: { type: "value", name: "פטירות" },
        series: [{ type: "bar", name: "פטירות", data: s.y.map(function (v, i) {
          return s.winter[i] ? { value: v, itemStyle: { color: "#0b3668" } } : { value: v, itemStyle: { color: "#7fb0f7" } };
        }) }]
      }));
      window.addEventListener("resize", function () { c2.resize(); });
    }
  })();
</script>
