{%- if model.flags.langs %}
<script>
  (function () {
    var d = {{ model.charts.langs | tojson }};
    var el = document.getElementById("chart-langs");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex;
        var out = [echarts.format.encodeHTML(d.years[i])];
        ps.forEach(function (p) {
          out.push(echarts.format.encodeHTML(p.seriesName) + ": " + p.value.toLocaleString("he-IL"));
        });
        out.push("שיעור שאינו עברית: " + d.share[i].toLocaleString("he-IL") + "%");
        return out.join("<br>");
      } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: d.years, axisLabel: { interval: 0, fontSize: 11 } },
      yAxis: { type: "value", minInterval: 1 },
      series: d.langs.map(function (l) {
        return { type: "bar", stack: "l", name: l, data: d.n[l], barMaxWidth: 48 };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

