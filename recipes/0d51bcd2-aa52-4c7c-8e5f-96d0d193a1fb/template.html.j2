<script>
  (function () {
    var d = {{ model.charts.price | tojson }};
    var el = document.getElementById("chart-price");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        var i = p.dataIndex;
        var b = d.box[i];
        return echarts.format.encodeHTML(d.years[i]) + "<br>חציון: " + b[2].toLocaleString("he-IL") + " ₪<br>רבעונים: " + b[1].toLocaleString("he-IL") + " עד " + b[3].toLocaleString("he-IL") + " ₪<br>טווח: " + b[0].toLocaleString("he-IL") + " עד " + b[4].toLocaleString("he-IL") + " ₪<br>ממוצע: " + d.mean[i].toLocaleString("he-IL") + " ₪";
      } },
      grid: { left: 16, right: 16, top: 24, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.years, axisLabel: { interval: 0, fontSize: 11 } },
      yAxis: { type: "value", axisLabel: { formatter: "{value} ₪" } },
      series: [
        { type: "boxplot", name: "מחיר", data: d.box, itemStyle: { color: "#f1f7ff", borderColor: "#0068f5" } },
        { type: "scatter", name: "ממוצע", data: d.mean, symbolSize: 9, itemStyle: { color: "#0b3668" } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

{%- if model.flags.ptype %}
<script>
  (function () {
    var d = {{ model.charts.ptype | tojson }};
    var el = document.getElementById("chart-ptype");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        return echarts.format.encodeHTML(d.x[i]) + "<br>מחיר ממוצע: " + d.mean[i].toLocaleString("he-IL") + " ₪<br>" + d.n[i].toLocaleString("he-IL") + " השתלמויות";
      } },
      grid: { left: 16, right: 64, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: false } },
      yAxis: { type: "category", data: d.x, inverse: true, axisLabel: { width: 130, overflow: "truncate", fontSize: 11 } },
      series: [{ type: "bar", name: "מחיר ממוצע", data: d.mean, barMaxWidth: 26,
        label: { show: true, position: "right", formatter: function (p) { return p.value.toLocaleString("he-IL") + " ₪"; } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

