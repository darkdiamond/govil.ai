<h1>רשימת ישובים בישראל</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.total_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.council_share.tone }} mb-1" dir="ltr">{{ model.kpis.council_share.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.share_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.councils.tone }} mb-1" dir="ltr">{{ model.kpis.councils.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.councils_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.net.tone }} mb-1" dir="ltr">{{ model.kpis.net.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.net_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">ישובים לפי מחוז</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.districts_note }}</p>
    <div id="chart-districts" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.districts_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.districts_caption }}</caption>
        <thead><tr><th scope="col">מחוז</th><th scope="col">ישובים</th><th scope="col">במועצה אזורית</th><th scope="col">ללא מועצה אזורית</th><th scope="col">שיעור מהרשימה</th></tr></thead>
        <tbody>
{%- for r in model.tables.districts %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.total }}</td><td>{{ r.in }}</td><td>{{ r.out }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">המועצות האזוריות הגדולות</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.councils_note }}</p>
    <div id="chart-councils" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.councils_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.councils_caption }}</caption>
        <thead><tr><th scope="col">מועצה אזורית</th><th scope="col">מחוז</th><th scope="col">ישובים</th><th scope="col">נפות</th></tr></thead>
        <tbody>
{%- for r in model.tables.councils %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.district }}</td><td>{{ r.count }}</td><td>{{ r.nafot }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">ישובים לפי נפה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.nafot_note }}</p>
  <div id="chart-nafot" class="h-[640px]" role="img" aria-label="{{ model.labels.nafot_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.nafot_caption }}</caption>
      <thead><tr><th scope="col">נפה</th><th scope="col">מחוז</th><th scope="col">ישובים</th><th scope="col">במועצה אזורית</th><th scope="col">ללא מועצה אזורית</th></tr></thead>
      <tbody>
{%- for r in model.tables.nafot %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.district }}</td><td>{{ r.total }}</td><td>{{ r.in }}</td><td>{{ r.out }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מחוז, נפה ומועצה אזורית</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.tree_note }}</p>
  <div id="chart-tree" data-fallback="explorer" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.tree_aria }}"></div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">לשכות רשות האוכלוסין</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.bureaus_note }}</p>
  <div id="chart-bureaus" class="h-[560px]" role="img" aria-label="{{ model.labels.bureaus_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.bureaus_caption }}</caption>
      <thead><tr><th scope="col">לשכה</th><th scope="col">ישובים</th><th scope="col">מחוז הלשכה</th><th scope="col">מחוזות</th></tr></thead>
      <tbody>
{%- for r in model.tables.bureaus %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.home }}</td><td>{{ r.districts }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

{%- if model.flags.changes %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">שינויים לעומת הקובץ הקודם</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.changes_note }}</p>
  <div id="chart-changes" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.changes_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.changes_caption }}</caption>
      <thead><tr><th scope="col">מחוז</th><th scope="col">נוספו</th><th scope="col">הוסרו</th></tr></thead>
      <tbody>
{%- for r in model.tables.changes %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.added }}</td><td>{{ r.removed }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
{%- if model.tables.added_councils %}
    <table class="mt-4 w-full text-sm">
      <caption class="text-start text-sm font-semibold text-ink-deep mb-2">{{ model.labels.added_caption }}</caption>
      <thead><tr><th scope="col">מועצה אזורית</th><th scope="col">ישובים שנוספו</th></tr></thead>
      <tbody>
{%- for r in model.tables.added_councils %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
{%- endif %}
  </details>
</section>
{%- endif %}

{%- if model.flags.renames %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">ישובים ששינו את שמם</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.renames_note }}</p>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <caption class="sr-only">{{ model.labels.renames_caption }}</caption>
      <thead><tr><th scope="col" class="text-start pe-4">שם נוכחי</th><th scope="col" class="text-start pe-4">שם בקובץ הקודם</th><th scope="col" class="text-start">סמל ישוב</th></tr></thead>
      <tbody>
{%- for r in model.tables.renames %}
        <tr class="border-t border-rule"><th scope="row" class="text-start py-1 pe-4">{{ r.new }}</th><td class="py-1 pe-4">{{ r.old }}</td><td class="py-1">{{ r.code }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </div>
</section>
{%- endif %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">איך נקראים הישובים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.words_note }}</p>
  <div id="chart-words" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.words_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.words_caption }}</caption>
      <thead><tr><th scope="col">מילה פותחת</th><th scope="col">שמות</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.words %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">רשות האוכלוסין וההגירה מפרסמת מידי תקופה רשימת ישובים לשימוש חופשי של הציבור.</p>
</section>

<script>
  (function () {
    var P = window.GOVIL_PALETTE;
    var d = {{ model.charts.districts | tojson }};
    var c = echarts.init(document.getElementById("chart-districts"));
    c.setOption(window.GovEcharts.option({
      color: P,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: { fontSize: 10, interval: 0, rotate: 30 } },
      yAxis: { type: "value", name: "ישובים" },
      series: [
        { type: "bar", stack: "t", name: "במועצה אזורית", data: d["in"], itemStyle: { color: "#0068f5" } },
        { type: "bar", stack: "t", name: "ללא מועצה אזורית", data: d.out, itemStyle: { color: "#0b3668" } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var k = {{ model.charts.councils | tojson }};
    var c2 = echarts.init(document.getElementById("chart-councils"));
    c2.setOption(window.GovEcharts.option({
      color: P,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 32, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 4, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: k.names, inverse: true, axisLabel: { fontSize: 11, interval: 0 } },
      series: [{ type: "bar", name: "ישובים", label: { show: true, position: "right", fontSize: 10 },
                 data: k.values, itemStyle: { color: "#0068f5" } }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.nafot | tojson }};
    var c = echarts.init(document.getElementById("chart-nafot"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0 },
      grid: { left: 16, right: 24, top: 32, bottom: 16, containLabel: true },
      xAxis: { type: "value", splitNumber: 4, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { fontSize: 11, interval: 0 } },
      series: [
        { type: "bar", stack: "t", name: "במועצה אזורית", data: d["in"], itemStyle: { color: "#0068f5" } },
        { type: "bar", stack: "t", name: "ללא מועצה אזורית", data: d.out, itemStyle: { color: "#0b3668" } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var t = {{ model.charts.tree | tojson }};
    var c = echarts.init(document.getElementById("chart-tree"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { formatter: function (p) {
        var path = (p.treePathInfo || []).slice(1).map(function (x) { return x.name; }).join(" ← ");
        return path + ": " + p.value.toLocaleString("he-IL") + " ישובים";
      } },
      series: [{
        type: "treemap", name: "כל הישובים", data: t, leafDepth: 2, roam: false,
        top: 32, left: 4, right: 4, bottom: 4,
        breadcrumb: { show: true, top: 0, itemStyle: { color: "#0068f5" } },
        label: { show: true, fontFamily: "Rubik", fontSize: 11 },
        upperLabel: { show: true, height: 20, fontFamily: "Rubik", color: "#ffffff" },
        levels: [
          { itemStyle: { borderColor: "#ffffff", borderWidth: 3, gapWidth: 3 } },
          { colorSaturation: [0.35, 0.6], itemStyle: { borderColorSaturation: 0.7, gapWidth: 1, borderWidth: 1 } },
          { colorSaturation: [0.3, 0.55], itemStyle: { gapWidth: 1 } }
        ]
      }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var P = window.GOVIL_PALETTE;
    var b = {{ model.charts.bureaus | tojson }};
    var c = echarts.init(document.getElementById("chart-bureaus"));
    c.setOption(window.GovEcharts.option({
      color: P,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0, type: "scroll" },
      grid: { left: 16, right: 24, top: 40, bottom: 16, containLabel: true },
      xAxis: { type: "value", splitNumber: 4, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: b.names, inverse: true, axisLabel: { fontSize: 11, interval: 0 } },
      series: b.series.map(function (s) {
        return { type: "bar", stack: "t", name: s.name, data: s.data, itemStyle: { color: P[s.ci % P.length] } };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

{%- if model.flags.changes %}
<script>
  (function () {
    var d = {{ model.charts.changes | tojson }};
    var c = echarts.init(document.getElementById("chart-changes"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                 valueFormatter: function (v) { return Math.abs(v).toLocaleString("he-IL"); } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: { fontSize: 10, interval: 0, rotate: 30 } },
      yAxis: { type: "value", name: "ישובים", axisLabel: { formatter: function (v) { return Math.abs(v); } } },
      series: [
        { type: "bar", stack: "t", name: "נוספו", data: d.added, itemStyle: { color: "#0068f5" } },
        { type: "bar", stack: "t", name: "הוסרו", data: d.removed, itemStyle: { color: "#6c757d" } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

<script>
  (function () {
    var w = {{ model.charts.words | tojson }};
    var c = echarts.init(document.getElementById("chart-words"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 32, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 4, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: w.names, inverse: true, axisLabel: { fontSize: 12, interval: 0 } },
      series: [{ type: "bar", name: "שמות", data: w.values, itemStyle: { color: "#0068f5" },
                 label: { show: true, position: "right", fontSize: 10 } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
