<h1>הוצאות בכרטיסי אשראי בישראל: נתונים יומיים לפי ענף</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
{%- for key in ["level", "yoy", "m4", "base"] %}
{%- if model.kpis[key] is defined %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.labels[key ~ "_kpi"] }}</div>
  </div>
{%- endif %}
{%- endfor %}
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

{%- if model.flags.total %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">סך הרכישות היומי</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.total_note }}</p>
  <div id="chart-total" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.total_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה (ממוצע יומי לפי שנה)</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.year_caption }}</caption>
      <thead><tr><th scope="col">שנה</th><th scope="col">ממוצע יומי (מיליון ₪)</th><th scope="col">שינוי משנה קודמת</th></tr></thead>
      <tbody>
{%- for r in model.tables.years %}
        <tr><th scope="row">{{ r.year }}{% if r.partial %} (חלקית){% endif %}</th><td dir="ltr">{{ r.mean }}</td><td dir="ltr">{{ r.change }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{%- endif %}

{%- if model.flags.sectors %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">שינוי שנתי לפי ענף</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.yoy_note }}</p>
  <div id="chart-yoy" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.yoy_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.yoy_caption }}</caption>
      <thead><tr><th scope="col">ענף</th><th scope="col">שינוי שנתי</th><th scope="col">ממוצע יומי (מיליון ₪)</th></tr></thead>
      <tbody>
{%- for r in model.tables.yoy %}
        <tr><th scope="row">{{ r.name }}</th><td dir="ltr">{{ r.yoy }}</td><td dir="ltr">{{ r.level }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{%- endif %}

{%- if model.flags.tree %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">על מה מוציאים: חלוקה לענפים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.share_note }}</p>
  <div id="chart-tree" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.share_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.share_caption }}</caption>
      <thead><tr><th scope="col">ענף</th><th scope="col">קבוצה</th><th scope="col">ממוצע יומי (מיליון ₪)</th><th scope="col">חלק</th></tr></thead>
      <tbody>
{%- for r in model.tables.shares %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.group }}</td><td dir="ltr">{{ r.level }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{%- endif %}

{%- if model.flags.growth %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מי צמח יותר מאז לפני הקורונה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.growth_note }}</p>
  <div id="chart-growth" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.growth_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.growth_caption }}</caption>
      <thead><tr><th scope="col">ענף</th><th scope="col">שינוי</th></tr></thead>
      <tbody>
{%- for r in model.tables.growth %}
        <tr><th scope="row">{{ r.name }}</th><td dir="ltr">{{ r.growth }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{%- endif %}

{%- if model.flags.sub %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תת-ענפים: דלק, ביגוד, תיירות ועוד</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.sub_note }}</p>
  <div id="chart-sub" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.sub_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.sub_caption }}</caption>
      <thead><tr><th scope="col">תת-ענף</th><th scope="col">ענף</th><th scope="col">שינוי שנתי</th></tr></thead>
      <tbody>
{%- for r in model.tables.sub %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.parent }}</td><td dir="ltr">{{ r.yoy }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{%- endif %}

{%- if model.flags.drops %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/triangle-alert.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">הירידות החדות ביותר</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.drops_note }}</p>
  <table class="w-full text-sm">
    <caption class="sr-only">{{ model.labels.drops_caption }}</caption>
    <thead><tr><th scope="col">שיא</th><th scope="col">שפל</th><th scope="col">ירידה</th><th scope="col">ביום השיא (מיליון ₪)</th><th scope="col">ביום השפל</th></tr></thead>
    <tbody>
{%- for r in model.tables.drops %}
      <tr><th scope="row">{{ r["from"] }}</th><td>{{ r.to }}</td><td dir="ltr">{{ r.pct }}</td><td dir="ltr">{{ r.peak }}</td><td dir="ltr">{{ r.low }}</td></tr>
{%- endfor %}
    </tbody>
  </table>
</section>
{%- endif %}

<script>
{%- if model.flags.total %}
  (function () {
    const d = {{ model.charts.total | tojson }};
    const chart = echarts.init(document.getElementById("chart-total"));
    chart.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: (v) => Number(v).toLocaleString("he-IL") + " מיליון ₪" },
      grid: { left: 16, right: 16, top: 24, bottom: 64, containLabel: true },
      xAxis: { type: "time" },
      yAxis: { type: "value" },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 20 }],
      series: [{ type: "line", name: "סך הרכישות ביום", showSymbol: false, areaStyle: { opacity: 0.08 },
                 data: d.x.map((x, i) => [x, d.y[i]]) }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- for key in ["yoy", "growth", "sub"] %}
{%- if model.flags[key] %}
  (function () {
    const d = {{ model.charts[key] | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-{{ key }}"));
    const series = {
      type: "bar",
      data: d.y.map((v) => ({ value: v, itemStyle: { color: v >= 0 ? pal[0] : pal[5] } })),
      label: { show: true, position: "right", formatter: (p) => (p.value > 0 ? "+" : "") + p.value.toFixed(1) + "%" }
    };
    if (d.total != null) {
      series.markLine = { symbol: "none", data: [{ xAxis: d.total, name: "סך הרכישות" }],
                          label: { formatter: "סך הרכישות" }, lineStyle: { type: "dashed" } };
    }
    chart.setOption(window.GovEcharts.option({
      color: pal,
      tooltip: {
        trigger: "axis",
        formatter: (ps) => {
          const i = ps[0].dataIndex;
          return echarts.format.encodeHTML(d.names[i]) + (d.group ? " (" + echarts.format.encodeHTML(d.group[i]) + ")" : "") +
            "<br>" + (d.y[i] > 0 ? "+" : "") + d.y[i].toFixed(1) + "%";
        }
      },
      grid: { left: 16, right: 56, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: (v) => v + "%" } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 150, overflow: "truncate" } },
      series: [series]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- endfor %}
{%- if model.flags.tree %}
  (function () {
    const d = {{ model.charts.tree | tojson }};
    const chart = echarts.init(document.getElementById("chart-tree"));
    chart.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: {
        formatter: (p) => echarts.format.encodeHTML(p.name) + "<br>" +
          Number(p.value).toLocaleString("he-IL") + " מיליון ₪ ביום"
      },
      series: [{
        type: "treemap", data: d, roam: false, nodeClick: "zoomToNode",
        breadcrumb: { show: true, bottom: 4 },
        label: { show: true, formatter: "{b}" },
        upperLabel: { show: true, height: 22 },
        levels: [
          { itemStyle: { borderColor: "#ffffff", borderWidth: 2, gapWidth: 2 } },
          { colorSaturation: [0.35, 0.6], itemStyle: { borderColorSaturation: 0.7, gapWidth: 1, borderWidth: 1 } }
        ]
      }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
</script>
