{%- macro head(icon, title) %}
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/{{ icon }}.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ title }}</h2>
  </div>
{%- endmacro %}
{%- macro table(caption, col, rows, ncol="אישורים", with_pct=true) %}
  <details class="mt-3">
    <summary class="text-sm text-subtle cursor-pointer">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ caption }}</caption>
      <thead><tr class="border-b border-rule text-ink-deep"><th scope="col" class="text-start py-1 pe-3">{{ col }}</th><th scope="col" class="text-start py-1 pe-3">{{ ncol }}</th>{% if with_pct %}<th scope="col" class="text-start py-1">שיעור</th>{% endif %}</tr></thead>
      <tbody>
{%- for r in rows %}
        <tr class="border-b border-rule"><th scope="row" class="text-start font-normal py-1 pe-3 break-words">{{ r.name }}</th><td class="py-1 pe-3">{{ r.n | fmt_int }}</td>{% if with_pct %}<td class="py-1" dir="ltr">{{ r.pct }}</td>{% endif %}</tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
{%- endmacro %}
<h1>רשימת ציוד אלחוטי מאושר ליבוא מסחרי: אישור על סמך אישור</h1>

<section class="card p-5 mb-6">
{{ head("info", "תקציר") }}
  <p class="m-0 text-subtle leading-relaxed">{{ model.agent_data.summary_he }} הרשימה של משרד התקשורת מפרטת פריטי ציוד אלחוטי (נתבים, רחפנים, צעצועים על שלט, מערכות אזעקה, רכיבי רכב ועוד) שקיבלו אישור התאמה ושאישורם עדיין בתוקף. יבואן מסחרי של דגם זהה יכול להיעזר בה כדי להגיש בקשה לאישור ייבוא על סמך אישור קיים, ולמצוא את מספר האישור ואת תאריך התוקף שלו.</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">בדיקת דגם לפי קוד דגם, יצרן או מספר אישור ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות הרשימה: מספר אישור, קוד דגם, יצרן ותאריך תוקף.</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
{%- for key in ["total", "makers", "models", "first", "last"] %}
{%- if model.kpis[key] is defined %}
  <div class="card p-4 text-center">
    <div class="text-2xl md:text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.labels["kpi_" ~ key] }}</div>
  </div>
{%- endif %}
{%- endfor %}
</div>

<section class="card p-5 mb-6">
{{ head("circle-check", "תובנות עיקריות") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

{%- if model.flags.has_expiry %}
<section class="card p-5 mb-6">
{{ head("database", "מתי פוקע התוקף של האישורים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.expiry_lede }}</p>
  <div id="chart-expiry" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.expiry_aria }}"{% if not model.flags.expiry_table %} data-fallback="explorer"{% endif %}></div>
{%- if model.flags.expiry_table %}
{{ table(model.labels.expiry_aria, model.labels.expiry_col, model.tables.expiry) }}
{%- endif %}
</section>
{%- endif %}

<section class="card p-5 mb-6">
{{ head("building-2", "היצרנים עם הכי הרבה אישורים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.makers_lede }}</p>
  <div id="chart-makers" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.makers_aria }}"></div>
{{ table(model.labels.makers_aria, "יצרן", model.tables.makers) }}
</section>

{%- if model.flags.has_pareto %}
<section class="card p-5 mb-6">
{{ head("list", "ריכוזיות: כמה מהרשימה בידי היצרנים הגדולים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.pareto_lede }}</p>
  <div id="chart-pareto" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.pareto_aria }}"></div>
{{ table(model.labels.pareto_aria, "קבוצת יצרנים", model.tables.milestones, "אישורים (מצטבר)") }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
{{ head("building-2", "יצרנים לפי מספר האישורים שלהם") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.buckets_lede }}</p>
  <div id="chart-buckets" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.buckets_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle cursor-pointer">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.buckets_aria }}</caption>
      <thead><tr class="border-b border-rule text-ink-deep"><th scope="col" class="text-start py-1 pe-3">גודל היצרן</th><th scope="col" class="text-start py-1 pe-3">יצרנים</th><th scope="col" class="text-start py-1 pe-3">אישורים</th><th scope="col" class="text-start py-1">שיעור מהאישורים</th></tr></thead>
      <tbody>
{%- for r in model.tables.buckets %}
        <tr class="border-b border-rule"><th scope="row" class="text-start font-normal py-1 pe-3">{{ r.name }}</th><td class="py-1 pe-3">{{ r.makers | fmt_int }}</td><td class="py-1 pe-3">{{ r.n | fmt_int }}</td><td class="py-1" dir="ltr">{{ r.pct }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

{%- if model.flags.has_models %}
<section class="card p-5 mb-6">
{{ head("tag", "דגמים שמופיעים ביותר מאישור אחד") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.models_lede }}</p>
  <div id="chart-models" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.models_aria }}"></div>
{{ table(model.labels.models_aria, "דגם (יצרן)", model.tables.models, "אישורים", false) }}
</section>
{%- endif %}

{%- if model.flags.has_heat %}
<section class="card p-5 mb-6">
{{ head("database", "פקיעת התוקף אצל היצרנים הגדולים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.heat_lede }}</p>
  <div id="chart-heat" data-fallback="explorer" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.heat_aria }}"></div>
</section>
{%- endif %}

<section class="card p-5 mb-6">
{{ head("list", "על הרשימה") }}
  <p class="m-0 text-sm text-subtle leading-relaxed mb-3">רשימת פריטים שקיבלו אישורי התאמה ממשרד התקשורת. הרשימה המחייבת של מכשירים אלחוטיים המותרים בייבוא אישי קבועה בחקיקה. הרשימה המפורטת באתר היא אינה הרשימה המחייבת.</p>
  <p class="m-0 text-sm text-subtle leading-relaxed">למידע נוסף על שירות בקשה לאישור ציוד אלחוטי, ראו <a href="https://www.gov.il/he/service/approval_of_wireless_equipment_imported" target="_blank" rel="noopener" class="text-primary">אתר משרד התקשורת</a>. שמות היצרנים ברשימה מוצגים כפי שנרשמו, אחרי איחוד איותים שונים של אותו שם.</p>
</section>

<script>
  (function () {
    const enc = function (s) { return echarts.format.encodeHTML(String(s)); };
    const fmt = function (v) { return Number(v).toLocaleString("he-IL"); };
    function init(id) { const el = document.getElementById(id); if (!el) return null; const c = echarts.init(el); window.addEventListener("resize", function () { c.resize(); }); return c; }

    const ex = {{ model.charts.expiry | tojson }};
    const c1 = init("chart-expiry");
    if (c1) {
      c1.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
          formatter: function (ps) { const p = ps[0]; return enc(p.name) + "<br/>" + fmt(p.value) + " אישורים פוקעים"; } },
        grid: { left: 8, right: 8, top: 16, bottom: 8, containLabel: true },
        xAxis: { type: "category", data: ex.x, axisLabel: { rotate: 45, fontSize: 11 } },
        yAxis: { type: "value", minInterval: 1 },
        series: [{ type: "bar", data: ex.y, barMaxWidth: 28 }]
      }));
    }

    function hbar(id, d, unit) {
      const c = init(id);
      if (!c) return;
      const narrow = c.getDom().clientWidth < 520;
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
          formatter: function (ps) { const p = ps[0]; return enc(p.name) + "<br/>" + fmt(p.value) + " " + unit; } },
        grid: { left: 8, right: 36, top: 8, bottom: 8, containLabel: true },
        xAxis: { type: "value", minInterval: 1 },
        yAxis: { type: "category", inverse: true, data: d.names,
          axisLabel: { width: narrow ? 120 : 260, overflow: "truncate", ellipsis: "…", fontSize: narrow ? 10 : 12 } },
        series: [{ type: "bar", data: d.values, barMaxWidth: 22,
          label: { show: true, position: "right", fontFamily: "Rubik", color: "#0c3058" } }]
      }));
    }
    hbar("chart-makers", {{ model.charts.makers | tojson }}, "אישורים");
    hbar("chart-models", {{ model.charts.models | tojson }}, "אישורים");
  })();
</script>
{%- if model.flags.has_pareto %}
<script>
  (function () {
    const enc = function (s) { return echarts.format.encodeHTML(String(s)); };
    const d = {{ model.charts.pareto | tojson }};
    const el = document.getElementById("chart-pareto");
    if (!el) return;
    const c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis",
        formatter: function (ps) { const p = ps[0]; return enc(p.name) + " היצרנים הגדולים: " + enc(p.value) + "% מהאישורים"; } },
      grid: { left: 8, right: 16, top: 16, bottom: 28, containLabel: true },
      xAxis: { type: "category", data: d.x, name: "דירוג היצרן", nameLocation: "middle", nameGap: 26, boundaryGap: false },
      yAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      series: [{ type: "line", data: d.y, showSymbol: false, areaStyle: { opacity: 0.15 } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}
<script>
  (function () {
    const enc = function (s) { return echarts.format.encodeHTML(String(s)); };
    const d = {{ model.charts.buckets | tojson }};
    const el = document.getElementById("chart-buckets");
    if (!el) return;
    const c = echarts.init(el);
    const narrow = el.clientWidth < 520;
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      legend: { top: 0 },
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
        formatter: function (ps) { return enc(ps[0].name) + ps.map(function (p) { return "<br/>" + enc(p.seriesName) + ": " + Number(p.value).toLocaleString("he-IL"); }).join(""); } },
      grid: { left: 8, right: 8, top: 36, bottom: 8, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, width: narrow ? 60 : 120, overflow: "break", fontSize: narrow ? 10 : 12 } },
      yAxis: { type: "value", minInterval: 1 },
      series: [
        { type: "bar", name: "יצרנים", data: d.makers, barMaxWidth: 36 },
        { type: "bar", name: "אישורים", data: d.approvals, barMaxWidth: 36 }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- if model.flags.has_heat %}
<script>
  (function () {
    const enc = function (s) { return echarts.format.encodeHTML(String(s)); };
    const h = {{ model.charts.heat | tojson }};
    const el = document.getElementById("chart-heat");
    if (!el) return;
    const c = echarts.init(el);
    const narrow = el.clientWidth < 520;
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return enc(h.y[p.value[1]]) + "<br/>" + enc(h.x[p.value[0]]) + ": " + enc(p.value[2]) + " אישורים";
      } },
      grid: { left: 8, right: 8, top: 8, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true },
               axisLabel: { interval: 0, rotate: 45, fontSize: narrow ? 9 : 11 } },
      yAxis: { type: "category", inverse: true, data: h.y, splitArea: { show: true },
               axisLabel: { width: narrow ? 90 : 200, overflow: "truncate", ellipsis: "…", fontSize: narrow ? 9 : 11 } },
      visualMap: {
        min: 0, max: h.max, calculable: true, dimension: 2,
        orient: "horizontal", left: "center", bottom: 0, itemHeight: narrow ? 100 : 140,
        inRange: { color: ["#f1f7ff", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}
