    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">{{ model.labels.notes }}</p>
</section>

<script>
  (function () {
    var d = {{ model.charts.reg_year | tojson }};
    var last = d.x.length - 1;
    var data = d.y.map(function (v, i) {
      return (d.partial && i === last) ? { value: v, itemStyle: { color: "#9ec5fb" } } : v;
    });
    var c = echarts.init(document.getElementById("chart-reg-year"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
        formatter: function (p) {
          var s = p[0].name + ": " + Number(p[0].value).toLocaleString("he-IL") + " רכבים";
          return (d.partial && p[0].dataIndex === last) ? s + " (שנה חלקית)" : s;
        } },
      grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", name: "רכבים" },
      series: [{ type: "bar", data: data }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.heat | tojson }};
    var c = echarts.init(document.getElementById("chart-reg-heat"));
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return d.x[p.value[0]] + " " + d.y[p.value[1]] + ": " + Number(p.value[2]).toLocaleString("he-IL") + " רכבים";
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.x, splitArea: { show: true }, axisLabel: { interval: 0, rotate: 45 } },
      yAxis: { type: "category", data: d.y, splitArea: { show: true } },
      visualMap: { min: 0, max: d.max, dimension: 2, calculable: true, orient: "horizontal", left: "center", bottom: 4,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" } },
      series: [{ type: "heatmap", data: d.cells, label: { show: false },
        emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.origin | tojson }};
    var c = echarts.init(document.getElementById("chart-origin"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 24, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", name: "רכבים" },
      series: d.series.map(function (s) { return { type: "bar", stack: "all", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.first_owner | tojson }};
    var c = echarts.init(document.getElementById("chart-first-owner"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
        valueFormatter: function (v) { return Number(v).toFixed(1) + "%"; } },
      legend: { bottom: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 24, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      series: d.series.map(function (s) {
        return { type: "bar", stack: "all", name: s.name, data: s.data.map(function (v, i) {
          return d.totals[i] ? Math.round(v / d.totals[i] * 1000) / 10 : 0; }) };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

