<script>
  (function () {
    var M = function (v) { return v === null || v === undefined ? "—" : v.toLocaleString("he-IL") + " מיליון ₪"; };
    var d = {{ model.charts.dep_year | tojson }};
    var c1 = echarts.init(document.getElementById("chart-dep-year"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 64, containLabel: true },
      dataZoom: [{ type: "inside" }],
      xAxis: { type: "category", data: d.x },
      yAxis: [{ type: "value", name: "מיליוני ₪" }, { type: "value", name: "הפקדות", splitLine: { show: false } }],
      series: [
        { type: "bar", name: "סכום (מיליוני ₪)", data: d.ils, tooltip: { valueFormatter: M } },
        { type: "line", name: "מספר הפקדות", yAxisIndex: 1, data: d.n, showSymbol: false, color: "#0b3668" }
      ]
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    function hbar(id, names, values, unit, fmt) {
      var c = echarts.init(document.getElementById(id));
