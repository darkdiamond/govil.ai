    <div class="text-3xl font-bold text-{{ model.kpis.institutions.tone }} mb-1" dir="ltr">{{ model.kpis.institutions.display }}</div>
    <div class="text-sm text-subtle">מוסדות מבקשים</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.rate.tone }} mb-1" dir="ltr">{{ model.kpis.rate.display }}</div>
    <div class="text-sm text-subtle">מהבקשות שהוכרעו אושרו</div>
  </div>
