    <div class="text-3xl font-bold text-{{ model.kpis.last_rate.tone }} mb-1" dir="ltr">{{ model.kpis.last_rate.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.last_rate_kpi }}</div>
