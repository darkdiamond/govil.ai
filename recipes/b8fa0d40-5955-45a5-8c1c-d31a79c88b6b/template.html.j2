        <thead><tr><th scope="col">שנת תמיכה</th><th scope="col">רבעון תחתון (ימים)</th><th scope="col">חציון (ימים)</th><th scope="col">רבעון עליון (ימים)</th></tr></thead>
        <tbody>
{%- for r in model.tables.lag %}
          <tr><th scope="row">{{ r.year }}</th><td>{{ r.p25 }}</td><td>{{ r.p50 }}</td><td>{{ r.p75 }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
      </div>
    </details>
</section>

<script>
  (function () {
    var M = function (v) { return v === null || v === undefined ? "—" : v.toLocaleString("he-IL") + " מיליון ₪"; };
    var P = function (v) { return v === null || v === undefined ? "—" : v + "%"; };
    var y = {{ model.charts.year | tojson }};
    var c1 = echarts.init(document.getElementById("chart-year"));
    var ys = [
      { type: "bar", stack: "s", name: "אושרו", data: y.ok },
      { type: "bar", stack: "s", name: "נדחו", data: y.rej, color: "#c3cfe7" }
    ];
    if (y.has_other) { ys.push({ type: "bar", stack: "s", name: "ללא החלטה סופית", data: y.other, color: "#9a6700" }); }
    ys.push({ type: "line", name: "שיעור אישור", yAxisIndex: 1, data: y.rate, color: "#0b3668",
              tooltip: { valueFormatter: P } });
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: y.x },
      yAxis: [{ type: "value", name: "בקשות" },
              { type: "value", name: "%", min: 0, max: 100, splitLine: { show: false } }],
      series: ys
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    var m = {{ model.charts.money | tojson }};
    var c2 = echarts.init(document.getElementById("chart-money"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: m.x },
      yAxis: [{ type: "value", name: "מיליוני ₪" },
              { type: "value", name: "%", min: 0, splitLine: { show: false } }],
      series: [
        { type: "bar", name: "התבקש", data: m.req, color: "#c3cfe7", tooltip: { valueFormatter: M } },
        { type: "bar", name: "אושר", data: m.appr, tooltip: { valueFormatter: M } },
        { type: "line", name: "שיעור מאושר", yAxisIndex: 1, data: m.granted, color: "#0b3668",
          tooltip: { valueFormatter: P } }
      ]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    var P = function (v) { return v === null || v === undefined ? "—" : v + "%"; };
    var g = {{ model.charts.grants | tojson }};
    var c1 = echarts.init(document.getElementById("chart-grants"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: P },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "value", name: "%", splitNumber: 3 },
      yAxis: { type: "category", data: g.names, inverse: true, axisLabel: { width: 120, overflow: "truncate" } },
      series: [
        { type: "bar", name: "שיעור מהמענקים", data: g.count },
        { type: "bar", name: "שיעור מהכסף", data: g.sum, color: "#0b3668" }
      ]
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    function combo(id, d, barName) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis" },
        legend: { bottom: 0 },
        grid: { left: 16, right: 16, top: 40, bottom: 56, containLabel: true },
        xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, rotate: 35, fontSize: 11 } },
        yAxis: [{ type: "value", name: "בקשות" },
                { type: "value", name: "%", min: 0, max: 100, splitLine: { show: false } }],
        series: [
          { type: "bar", name: barName, data: d.done, color: "#c3cfe7" },
          { type: "line", name: "שיעור אישור", yAxisIndex: 1, data: d.rate, color: "#0068f5",
            tooltip: { valueFormatter: P } }
        ]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    combo("chart-ask", {{ model.charts.ask | tojson }}, "בקשות שהוכרעו");
    combo("chart-parts", {{ model.charts.parts | tojson }}, "בקשות שהוכרעו");

    var f = {{ model.charts.features | tojson }};
    var c2 = echarts.init(document.getElementById("chart-features"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: P },
