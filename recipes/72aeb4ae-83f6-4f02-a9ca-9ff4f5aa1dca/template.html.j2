    <div class="text-3xl font-bold text-{{ model.kpis.wells.tone }} mb-1" dir="ltr">{{ model.kpis.wells.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.kpi_wells }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.span.tone }} mb-1" dir="ltr">{{ model.kpis.span.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.kpi_span }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.wells_last.tone }} mb-1" dir="ltr">{{ model.kpis.wells_last.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.kpi_wells_last }}</div>
  </div>
{%- if model.kpis.cmp_median %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.cmp_median.tone }} mb-1" dir="ltr">{{ model.kpis.cmp_median.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.kpi_cmp_median }}</div>
  </div>
