{%- if model.flags.index %}
<script>
  (function () {
    var d = {{ model.charts.index | tojson }};
    var c = echarts.init(document.getElementById("chart-index"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", formatter: function (ps) {
        var i = ps[0].dataIndex;
        var v = d.d[i];
        var word = v > 0 ? "עלייה" : (v < 0 ? "ירידה" : "ללא שינוי");
        return d.x[i] + "<br>שינוי שנתי חציוני: " + v.toFixed(2) + " מ׳ (" + word + ")" +
          "<br>מדד מצטבר: " + d.cum[i].toFixed(2) + " מ׳" +
          "<br>קידוחים משווים: " + d.n[i].toLocaleString("he-IL");
      } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 88, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { hideOverlap: true } },
      yAxis: [
        { type: "value", name: "שינוי שנתי (מ׳)" },
        { type: "value", name: "מצטבר (מ׳)", scale: true, splitLine: { show: false } }
      ],
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 32, height: 18 }],
      series: [
        { type: "bar", name: "שינוי שנתי חציוני", data: d.d.map(function (v) {
            return { value: v, itemStyle: { color: v >= 0 ? "#0068f5" : "#dc3545" } };
          }) },
        { type: "line", name: "מדד מצטבר", yAxisIndex: 1, data: d.cum, symbol: "none",
          lineStyle: { width: 2, color: "#0b3668" }, itemStyle: { color: "#0b3668" } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

{%- if model.flags.change %}
<script>
  (function () {
    var d = {{ model.charts.change | tojson }};
    var tones = ["#dc3545", "#6c757d", "#0068f5"];
    var c = echarts.init(document.getElementById("chart-change"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex;
        return d.x[i] + ": " + d.y[i].toLocaleString("he-IL") + " קידוחים (" + d.rows[i].share + ")";
      } },
      grid: { left: 16, right: 16, top: 24, bottom: 16, containLabel: true },
      xAxis: { type: "value", name: "קידוחים" },
      yAxis: { type: "category", data: d.x },
      series: [{ type: "bar", name: "קידוחים", data: d.y.map(function (v, i) {
        return { value: v, itemStyle: { color: tones[d.tone[i]] } };
      }), label: { show: true, position: "right", fontFamily: "Rubik" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

<script>
