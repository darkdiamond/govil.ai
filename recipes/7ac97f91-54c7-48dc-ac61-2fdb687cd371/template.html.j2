      <caption class="sr-only">{{ model.labels.countries_aria }}</caption>
      <thead><tr><th scope="col">ארץ מוצא</th><th scope="col">עולים בכל התקופה</th><th scope="col">אחוז מהעולים</th><th scope="col">ב-{{ model.labels.last_year }}</th></tr></thead>
      <tbody>
{%- for n in model.charts.countries.names %}
        <tr><th scope="row">{{ n }}</th><td>{{ model.charts.countries["values"][loop.index0] | fmt_int }}</td><td>{{ model.charts.countries.shares[loop.index0] | fmt_num }}%</td><td>{{ model.charts.countries.last[loop.index0] | fmt_int }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">ארצות המוצא הגדולות לאורך השנים</h2>
