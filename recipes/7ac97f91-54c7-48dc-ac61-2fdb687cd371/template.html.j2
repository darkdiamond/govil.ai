<h1>עולים חדשים לפי שנים: נתוני העלייה לישראל</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.total_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.last.tone }} mb-1" dir="ltr">{{ model.kpis.last.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.last_kpi }}</div>
  </div>
{%- if model.kpis.change %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.change.tone }} mb-1" dir="ltr">{{ model.kpis.change.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.change_kpi }}</div>
  </div>
{%- endif %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.peak.tone }} mb-1" dir="ltr">{{ model.kpis.peak.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.peak_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.women.tone }} mb-1" dir="ltr">{{ model.kpis.women.display }}</div>
    <div class="text-sm text-subtle">נשים מכלל העולים</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.median_age.tone }} mb-1" dir="ltr">{{ model.kpis.median_age.display }}</div>
    <div class="text-sm text-subtle">גיל חציוני ביום העלייה</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.countries.tone }} mb-1" dir="ltr">{{ model.kpis.countries.display }}</div>
    <div class="text-sm text-subtle">ארצות מוצא</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.cities.tone }} mb-1" dir="ltr">{{ model.kpis.cities.display }}</div>
    <div class="text-sm text-subtle">יישובי קליטה</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">כמה עולים עלו לישראל בכל שנה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.yearly_note }}</p>
  <div id="chart-yearly" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.yearly_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.yearly_aria }}</caption>
      <thead><tr><th scope="col">שנה</th><th scope="col">עולים</th><th scope="col">שינוי משנה קודמת</th></tr></thead>
      <tbody>
{%- for x in model.charts.yearly.x %}
        <tr><th scope="row">{{ x }}{% if x == model.charts.yearly.partial %} (חלקית){% endif %}</th><td>{{ model.charts.yearly.y[loop.index0] | fmt_int }}</td><td dir="ltr">{{ model.charts.yearly.yoy[loop.index0] }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">עונתיות: עולים לפי חודש ושנה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.heat_note }}</p>
  <div id="chart-heat" data-fallback="explorer" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.heat_aria }}"></div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מאיפה מגיעים העולים: אזורי מוצא לאורך השנים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.regions_note }}</p>
  <div id="chart-regions" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.regions_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.regions_aria }}</caption>
      <thead><tr><th scope="col">אזור מוצא</th><th scope="col">עולים בכל התקופה</th><th scope="col">אחוז ב-{{ model.labels.first_year }}</th><th scope="col">אחוז ב-{{ model.labels.last_year }}</th></tr></thead>
      <tbody>
{%- for r in model.tables.regions %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.total | fmt_int }}</td><td>{{ r.first | fmt_num }}%</td><td>{{ r.last | fmt_num }}%</td></tr>
{%- endfor %}
