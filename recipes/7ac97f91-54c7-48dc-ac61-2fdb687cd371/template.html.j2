      <caption class="sr-only">{{ model.labels.districts_aria }}</caption>
      <thead><tr><th scope="col">שנה</th>{% for s in model.charts.districts.series %}<th scope="col">{{ s.name }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for r in model.charts.districts.table %}
        <tr><th scope="row">{{ r.year }}</th>{% for v in r.vals %}<td>{{ v | fmt_int }}</td>{% endfor %}</tr>
{%- endfor %}
      </tbody>
