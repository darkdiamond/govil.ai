    <div id="chart-occ" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.occ_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.occ_aria }}</caption>
        <thead><tr><th scope="col">עיסוק</th><th scope="col">עולים</th><th scope="col">אחוז</th></tr></thead>
        <tbody>
{%- for r in model.charts.occ %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.value | fmt_int }}</td><td>{{ r.share | fmt_num }}%</td></tr>
{%- endfor %}
