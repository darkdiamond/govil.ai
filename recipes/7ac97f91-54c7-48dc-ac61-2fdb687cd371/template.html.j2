    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">כל מאגר מציג מידע לגבי לפי חודש עלייה, גיל בעת העלייה, מין, ארץ מוצא, אזור מוצא, יישוב קולט, מחוז קולט, מקצוע</p>
</section>

<script>
  (function () {
    var d = {{ model.charts.yearly | tojson }};
    var el = document.getElementById("chart-yearly"), narrow = el.clientWidth < 500;
    var c = echarts.init(el);
    var peak = Math.max.apply(null, d.y);
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex, y = d.x[i];
        return echarts.format.encodeHTML(y) + (y === d.partial ? " (שנה חלקית)" : "") + "<br>" + d.y[i].toLocaleString("he-IL") + " עולים" +
          (d.yoy[i] ? "<br>שינוי משנה קודמת: " + echarts.format.encodeHTML(d.yoy[i]) : "");
      } },
      grid: { left: 16, right: 16, top: narrow ? 36 : 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value" },
      series: [{ type: "bar", barCategoryGap: "25%", data: d.y.map(function (v, i) {
        if (d.x[i] === d.partial) { return { value: v, itemStyle: { opacity: 0.45 } }; }
        if (v === peak) { return { value: v, itemStyle: { color: "#0b3668" } }; }
        return v;
      }), label: { show: true, position: "top", fontSize: narrow ? 9 : 10, rotate: narrow ? 90 : 0, align: narrow ? "left" : "center", verticalAlign: "middle", distance: narrow ? 4 : 5, formatter: function (p) { return (p.value / 1000).toFixed(1) + "K"; } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
<script>
  (function () {
    var d = {{ model.charts.heat | tojson }};
    var el = document.getElementById("chart-heat"), wide = el.clientWidth >= 600;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return echarts.format.encodeHTML(d.x[p.data[0]]) + " " + echarts.format.encodeHTML(d.y[p.data[1]]) + ": " + p.data[2].toLocaleString("he-IL") + " עולים";
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: d.x, splitArea: { show: true }, axisLabel: { fontSize: 10, interval: 0, rotate: wide ? 0 : 45 } },
      yAxis: { type: "category", data: d.y, splitArea: { show: true }, axisLabel: { fontSize: 11 } },
      visualMap: { min: 0, max: d.max, dimension: 2, calculable: true, orient: "horizontal", left: "center", bottom: 8,
                   inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] }, textStyle: { fontFamily: "Rubik", color: "#0c3058" } },
      series: [{ type: "heatmap", data: d.cells, label: { show: wide, fontFamily: "Rubik", fontSize: 9,
                 formatter: function (p) { return p.data[2] >= 1000 ? (p.data[2] / 1000).toFixed(1) + "K" : p.data[2]; } },
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () {
      var w = el.clientWidth >= 600;
      if (w !== wide) { wide = w; c.setOption({ series: [{ label: { show: wide } }], xAxis: { axisLabel: { rotate: wide ? 0 : 45 } } }); }
      c.resize();
    });
  })();
</script>
<script>
  (function () {
    var d = {{ model.charts.regions | tojson }};
    var c = echarts.init(document.getElementById("chart-regions"));
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex, out = echarts.format.encodeHTML(d.x[i]);
        ps.forEach(function (p) {
          var s = d.series[p.seriesIndex];
          out += "<br>" + p.marker + echarts.format.encodeHTML(s.name) + ": " + s.data[i] + "% (" + s.counts[i].toLocaleString("he-IL") + ")";
        });
        return out;
      } },
      legend: { bottom: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
