        <caption class="sr-only">{{ model.labels.profile_aria }}</caption>
        <thead><tr><th scope="col">שנה</th><th scope="col">גיל חציוני</th><th scope="col">{{ model.labels.u18_label }}</th><th scope="col">{{ model.labels.o65_label }}</th><th scope="col">נשים</th></tr></thead>
        <tbody>
{%- for x in model.charts.profile.x %}
