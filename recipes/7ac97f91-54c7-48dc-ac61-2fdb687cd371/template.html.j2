  <section class="card p-5">
    <h2 class="m-0 mb-3 text-base font-semibold text-ink-deep">המקצועות הנפוצים בקרב העולים</h2>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.prof_note }}</p>
    <div id="chart-prof" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.prof_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.prof_aria }}</caption>
        <thead><tr><th scope="col">מקצוע</th><th scope="col">עולים</th><th scope="col">אחוז מבעלי מקצוע מוצהר</th></tr></thead>
        <tbody>
{%- for n in model.charts.prof.names %}
          <tr><th scope="row">{{ n }}</th><td>{{ model.charts.prof["values"][loop.index0] | fmt_int }}</td><td>{{ model.charts.prof.shares[loop.index0] | fmt_num }}%</td></tr>
{%- endfor %}
