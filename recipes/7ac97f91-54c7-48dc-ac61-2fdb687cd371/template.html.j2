</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">יישובי הקליטה המובילים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cities_note }}</p>
  <div id="chart-cities" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.cities_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.cities_aria }}</caption>
      <thead><tr><th scope="col">יישוב</th><th scope="col">עולים בכל התקופה</th><th scope="col">אחוז מהעולים</th><th scope="col">ב-{{ model.labels.last_year }}</th></tr></thead>
      <tbody>
{%- for n in model.charts.cities.names %}
        <tr><th scope="row">{{ n }}</th><td>{{ model.charts.cities["values"][loop.index0] | fmt_int }}</td><td>{{ model.charts.cities.shares[loop.index0] | fmt_num }}%</td><td>{{ model.charts.cities.last[loop.index0] | fmt_int }}</td></tr>
{%- endfor %}
      </tbody>
