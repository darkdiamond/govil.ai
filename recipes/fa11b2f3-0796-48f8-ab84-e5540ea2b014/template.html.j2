      <caption class="sr-only">{{ model.labels.roles_caption }}</caption>
      <thead><tr><th scope="col">סוג תקן</th><th scope="col">תקנים</th><th scope="col">מאוישים</th><th scope="col">פנויים</th></tr></thead>
      <tbody>
{%- for r in model.tables.roles %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.tot }}</td><td>{{ r.fil }}</td><td>{{ r.vac }}</td></tr>
{%- endfor %}
