</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">גודל הרשות מול שיעור האיוש</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.scatter_note }}</p>
  <div id="chart-scatter" data-fallback="explorer" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.scatter_aria }}"></div>
</section>

<script>
  (function () {
    var d = {{ model.charts.district | tojson }};
    var c = echarts.init(document.getElementById("chart-district"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, width: 54, overflow: "break", fontSize: 11 } },
      yAxis: [
        { type: "value", name: "תקנים" },
        { type: "value", name: "% איוש", min: 0, max: 100, splitLine: { show: false } }
      ],
      series: [
        { type: "bar", stack: "t", name: "מאוישים", data: d.fil },
        { type: "bar", stack: "t", name: "פנויים", data: d.vac, itemStyle: { color: "#c3cfe7" } },
        { type: "line", name: "שיעור איוש", yAxisIndex: 1, data: d.rate, itemStyle: { color: "#0b3668" },
          label: { show: true, formatter: "{c}%", fontFamily: "Rubik, sans-serif" },
          tooltip: { valueFormatter: function (v) { return v + "%"; } } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var s = {{ model.charts.sw | tojson }};
    var c = echarts.init(document.getElementById("chart-sw"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v === null ? "—" : v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: s.names, axisLabel: { interval: 0, width: 46, overflow: "break", fontSize: 10 } },
      yAxis: { type: "value", name: "% איוש", min: 0, max: 100 },
      series: [
        { type: "bar", name: "תקני עו״ס", data: s.sw },
        { type: "bar", name: "שאר התקנים", data: s.ns }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var t = {{ model.charts.types | tojson }};
    var c2 = echarts.init(document.getElementById("chart-types"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: t.names, axisLabel: { interval: 0, width: 60, overflow: "break", fontSize: 11 } },
      yAxis: [
        { type: "value", name: "תקנים" },
        { type: "value", name: "% איוש", min: 0, max: 100, splitLine: { show: false } }
      ],
      series: [
        { type: "bar", name: "תקנים", data: t.tot },
        { type: "line", name: "שיעור איוש", yAxisIndex: 1, data: t.rate, itemStyle: { color: "#0b3668" },
          label: { show: true, formatter: "{c}%", fontFamily: "Rubik, sans-serif" },
          tooltip: { valueFormatter: function (v) { return v + "%"; } } }
      ]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    function stacked(id, d) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { bottom: 0 },
        grid: { left: 16, right: 24, top: 8, bottom: 40, containLabel: true },
        xAxis: { type: "value", splitNumber: 4, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true,
                 axisLabel: { width: 130, overflow: "truncate" } },
        series: [
          { type: "bar", stack: "t", name: "מאוישים", data: d.fil },
          { type: "bar", stack: "t", name: "פנויים", data: d.vac, itemStyle: { color: "#c3cfe7" } }
        ]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    stacked("chart-roles", {{ model.charts.roles | tojson }});
    stacked("chart-auth-top", {{ model.charts.auth_top | tojson }});

    function low(id, d) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                   valueFormatter: function (v) { return v + "%"; } },
        grid: { left: 16, right: 40, top: 28, bottom: 16, containLabel: true },
        xAxis: { type: "value", min: 0, max: 100, interval: 25, axisLabel: { formatter: "{value}%", hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true,
                 axisLabel: { width: 130, overflow: "truncate" } },
        series: [{
          type: "bar", name: "שיעור איוש", data: d.rate,
          label: { show: true, position: "right", formatter: "{c}%", fontFamily: "Rubik, sans-serif" },
          markLine: { symbol: "none", silent: true,
                      lineStyle: { color: "#0b3668", type: "dashed" },
                      label: { position: "start", formatter: "ממוצע {c}%", fontFamily: "Rubik, sans-serif", color: "#0b3668" },
                      data: [{ xAxis: d.overall }] }
        }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    low("chart-role-low", {{ model.charts.role_low | tojson }});
    low("chart-auth-low", {{ model.charts.auth_low | tojson }});
  })();
</script>

<script>
  (function () {
    var h = {{ model.charts.heat | tojson }};
    var c = echarts.init(document.getElementById("chart-heat"));
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return h.y[p.value[1]] + " · " + h.x[p.value[0]] + ": " + p.value[2] + "% איוש (" +
          p.value[3].toLocaleString("he-IL") + " תקנים)";
      } },
      grid: { left: 16, right: 16, top: 8, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true }, axisLabel: { interval: 0, width: 40, overflow: "break", fontSize: 10 } },
      yAxis: { type: "category", data: h.y, inverse: true, splitArea: { show: true },
               axisLabel: { width: 120, overflow: "truncate" } },
      visualMap: {
        min: h.min, max: h.max, dimension: 2, calculable: true,
        orient: "horizontal", left: "center", bottom: 8,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik, sans-serif", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells,
                 label: { show: true, fontFamily: "Rubik, sans-serif", formatter: function (p) { return String(Math.round(p.value[2])); } },
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var h = {{ model.charts.hist | tojson }};
    var c = echarts.init(document.getElementById("chart-hist"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: h.names, axisLabel: { interval: 0, rotate: 30 } },
      yAxis: { type: "value", name: "רשויות", minInterval: 1 },
      series: h.series.map(function (s) { return { type: "bar", stack: "t", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var st = {{ model.charts.status | tojson }};
    var c2 = echarts.init(document.getElementById("chart-status"));
    var colors = ["#0068f5", "#7fb0f5", "#c3cfe7"];
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        return p.name + ": " + p.value.toLocaleString("he-IL") + " הקצאות (" + p.percent + "%), " +
          st.fte[p.dataIndex].toLocaleString("he-IL") + " תקנים";
      } },
      legend: { bottom: 0, formatter: function (n) {
        var i = st.names.indexOf(n);
        var tot = st.rows.reduce(function (a, b) { return a + b; }, 0);
        return n + " " + (tot ? (st.rows[i] / tot * 100).toFixed(1) : "0") + "%";
      } },
      series: [{
        type: "pie", radius: ["34%", "58%"], center: ["50%", "40%"],
        label: { show: false },
        data: st.names.map(function (n, i) { return { name: n, value: st.rows[i], itemStyle: { color: colors[i % colors.length] } }; })
      }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    var s = {{ model.charts.scatter | tojson }};
    var c = echarts.init(document.getElementById("chart-scatter"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        return p.value[2] + " (" + p.seriesName + ")<br>" + p.value[0].toLocaleString("he-IL") +
          " תקנים · " + p.value[1] + "% איוש";
      } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 32, bottom: 72, containLabel: true },
      xAxis: { type: "log", name: "תקנים", nameLocation: "middle", nameGap: 28 },
      yAxis: { type: "value", name: "% איוש", min: function (v) { return Math.max(0, Math.floor(v.min / 10) * 10); }, max: 100 },
      dataZoom: [{ type: "inside", xAxisIndex: 0 }],
      series: s.series.map(function (x) {
        return { type: "scatter", name: x.name, data: x.data, symbolSize: 8, itemStyle: { opacity: 0.75 } };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
