  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/triangle-alert.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">סוגי התקנים עם האיוש הנמוך ביותר</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.role_low_note }}</p>
  <div id="chart-role-low" class="h-96 md:h-[460px]" role="img" aria-label="{{ model.labels.role_low_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.role_low_caption }}</caption>
      <thead><tr><th scope="col">סוג תקן</th><th scope="col">שיעור איוש</th><th scope="col">תקנים</th><th scope="col">רשויות</th></tr></thead>
      <tbody>
{%- for r in model.tables.role_low %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.rate }}</td><td>{{ r.tot }}</td><td>{{ r.n }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">איוש לפי סוג תקן ומחוז</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.heat_note }}</p>
  <div id="chart-heat" class="h-96 md:h-[460px]" role="img" aria-label="{{ model.labels.heat_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
