      <caption class="sr-only">{{ model.labels.heat_caption }}</caption>
      <thead><tr><th scope="col">סוג תקן</th>{% for d in model.districts %}<th scope="col">{{ d }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for r in model.tables.heat %}
        <tr><th scope="row">{{ r.role }}</th>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">רשויות הרווחה הגדולות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.auth_top_note }}</p>
  <div id="chart-auth-top" class="h-96 md:h-[460px]" role="img" aria-label="{{ model.labels.auth_top_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.auth_top_caption }}</caption>
      <thead><tr><th scope="col">רשות</th><th scope="col">מחוז</th><th scope="col">תקנים</th><th scope="col">פנויים</th><th scope="col">שיעור איוש</th></tr></thead>
      <tbody>
{%- for r in model.tables.auth_top %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.district }}</td><td>{{ r.tot }}</td><td>{{ r.vac }}</td><td>{{ r.rate }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/triangle-alert.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">רשויות עם האיוש הנמוך ביותר</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.auth_low_note }}</p>
  <div id="chart-auth-low" class="h-96 md:h-[460px]" role="img" aria-label="{{ model.labels.auth_low_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.auth_low_caption }}</caption>
      <thead><tr><th scope="col">רשות</th><th scope="col">מחוז</th><th scope="col">תקנים</th><th scope="col">שיעור איוש</th></tr></thead>
      <tbody>
{%- for r in model.tables.auth_low %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.district }}</td><td>{{ r.tot }}</td><td>{{ r.rate }}</td></tr>
{%- endfor %}
      </tbody>
