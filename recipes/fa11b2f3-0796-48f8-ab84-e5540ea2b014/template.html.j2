<h1>מאגר כוח אדם ברשויות הרווחה</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
{%- for k, lbl in [("total", "total_kpi"), ("filled", "filled_kpi"), ("vacant", "vacant_kpi"), ("rate", "rate_kpi"),
                   ("sw_share", "sw_share_kpi"), ("sw_rate", "sw_rate_kpi"), ("authorities", "auth_kpi"), ("roles", "roles_kpi")] %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[k].tone }} mb-1" dir="ltr">{{ model.kpis[k].display }}</div>
    <div class="text-sm text-subtle">{{ model.labels[lbl] }}</div>
  </div>
{%- endfor %}
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקנים ואיוש לפי מחוז</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.district_note }}</p>
  <div id="chart-district" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.district_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.district_caption }}</caption>
      <thead><tr><th scope="col">מחוז</th><th scope="col">תקנים</th><th scope="col">מאוישים</th><th scope="col">פנויים</th><th scope="col">שיעור איוש</th></tr></thead>
      <tbody>
{%- for r in model.tables.district %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.tot }}</td><td>{{ r.fil }}</td><td>{{ r.vac }}</td><td>{{ r.rate }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">עובדים סוציאליים מול שאר התקנים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.sw_note }}</p>
    <div id="chart-sw" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.sw_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.sw_caption }}</caption>
        <thead><tr><th scope="col">מחוז</th><th scope="col">תקני עו״ס</th><th scope="col">שאר התקנים</th></tr></thead>
        <tbody>
{%- for r in model.tables.sw %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.sw }}</td><td>{{ r.ns }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">לפי סוג רשות</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.types_note }}</p>
    <div id="chart-types" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.types_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.types_caption }}</caption>
        <thead><tr><th scope="col">סוג רשות</th><th scope="col">רשויות</th><th scope="col">תקנים</th><th scope="col">שיעור איוש</th></tr></thead>
        <tbody>
{%- for r in model.tables.types %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.n }}</td><td>{{ r.tot }}</td><td>{{ r.rate }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">סוגי התקנים הגדולים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.roles_note }}</p>
  <div id="chart-roles" class="h-96 md:h-[460px]" role="img" aria-label="{{ model.labels.roles_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
