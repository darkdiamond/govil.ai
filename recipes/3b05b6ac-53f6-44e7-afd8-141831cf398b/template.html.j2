{%- macro head(icon, title) %}
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/{{ icon }}.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ title }}</h2>
  </div>
{%- endmacro %}
<h1>קאדים בבתי הדין הדרוזיים: רשימת הקאדים</h1>

<section class="card p-5 mb-6">
{{ head("info", "תקציר") }}
  <p class="m-0 text-subtle leading-relaxed">{{ model.agent_data.summary_he }} הקאדי הוא השופט בבית הדין הדתי הדרוזי, הערכאה שדנה בענייני המעמד האישי של בני העדה הדרוזית בישראל, ובהם נישואין וגירושין. משרד המשפטים מפרסם את רשימת הקאדים בערכאות השונות של בתי הדין הדרוזים.</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור קאדי דרוזי לפי שם ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: שם הקאדי כפי שהוא כתוב ברשימה.</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
{%- for key in model.kpi_order %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.labels["kpi_" ~ key] }}</div>
  </div>
{%- endfor %}
</div>

<section class="card p-5 mb-6">
{{ head("circle-check", "תובנות עיקריות") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
{{ head("list", "רשימת הקאדים בבתי הדין הדרוזים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.roster_lede }}</p>
  <div class="overflow-x-auto relative">
    <table id="table-roster" class="w-full text-sm">
      <caption class="sr-only">{{ model.labels.roster_caption }}</caption>
      <thead>
        <tr class="border-b border-rule text-ink-deep">
          <th scope="col" class="text-start py-2 pe-3">שם</th>
          <th scope="col" class="text-start py-2 pe-3">סוג רשומה</th>
          <th scope="col" class="text-start py-2">הערה</th>
        </tr>
      </thead>
      <tbody>
{%- for r in model.tables.roster %}
        <tr class="border-b border-rule{% if r.admin %} bg-surface-alt{% endif %}">
          <th scope="row" class="text-start py-2 pe-3 {% if r.admin %}font-normal text-subtle{% else %}font-semibold text-ink-deep{% endif %}">{{ r.name }}</th>
          <td class="py-2 pe-3">{{ r.kind }}</td>
          <td class="py-2 text-subtle">{{ r.note }}</td>
        </tr>
{%- endfor %}
      </tbody>
    </table>
  </div>
</section>

{%- if model.flags.has_chart %}
<section class="card p-5 mb-6">
{{ head("building-2", "הרכב רשומות המאגר") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.composition_lede }}</p>
  <div id="chart-composition" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.composition_aria }}"></div>
  <details class="mt-3">
    <summary class="cursor-pointer text-sm text-brand">הצג כטבלה</summary>
    <div class="overflow-x-auto relative">
      <table class="w-full text-sm mt-2">
        <caption class="sr-only">{{ model.labels.composition_aria }}</caption>
        <thead>
          <tr class="border-b border-rule text-ink-deep">
            <th scope="col" class="text-start py-2 pe-3">סוג רשומה</th>
            <th scope="col" class="text-start py-2">מספר</th>
          </tr>
        </thead>
        <tbody>
{%- for r in model.tables.composition %}
          <tr class="border-b border-rule">
            <th scope="row" class="text-start font-normal py-2 pe-3">{{ r.name }}</th>
            <td class="py-2">{{ r.n | fmt_int }}</td>
          </tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>
{%- endif %}

<section class="card p-5 mb-6">
{{ head("info", "על בתי הדין הדתיים הדרוזיים") }}
  <p class="m-0 text-sm text-subtle leading-relaxed">בתי הדין הדתיים הדרוזיים הם בתי הדין של העדה הדרוזית בישראל, ופועלים במסגרת משרד המשפטים. הם דנים בעיקר בענייני נישואין וגירושין של בני העדה, ובעניינים נוספים של המעמד האישי לפי החוק. המערכת כוללת בית דין של ערכאה ראשונה ובית דין לערעורים, והקאדים מכהנים בהם. ברשימה מופיעים גם ערכים שאינם שמות, כמו החלטות מנהליות, כפי שהם רשומים במאגר.</p>
</section>

{%- if model.flags.has_chart %}
<script>
  (function () {
    const d = {{ model.charts.composition | tojson }};
    const el = document.getElementById("chart-composition");
    if (!el) return;
    const narrow = el.clientWidth < 520;
    const chart = echarts.init(el);
    chart.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: {
        trigger: "axis",
        axisPointer: { type: "shadow" },
        formatter: function (ps) {
          const i = ps[0].dataIndex;
          return echarts.format.encodeHTML(d.names[i]) + ": " + d.values[i];
        }
      },
      grid: { left: 8, right: 36, top: 8, bottom: 24, containLabel: true },
      xAxis: { type: "value", minInterval: 1 },
      yAxis: {
        type: "category",
        inverse: true,
        data: d.names,
        axisLabel: { interval: 0, fontSize: narrow ? 11 : 12 }
      },
      series: [{
        type: "bar",
        data: d.values,
        barMaxWidth: 28,
        label: { show: true, position: "right", fontFamily: "Rubik", color: "#0c3058" }
      }]
    }));
    window.addEventListener("resize", function () { chart.resize(); });
  })();
</script>
{%- endif %}
