{%- macro head(title, icon="database") -%}
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/{{ icon }}.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ title }}</h2>
  </div>
{%- endmacro -%}
{%- macro kpi(k, label) -%}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ k.tone }} mb-1" dir="ltr">{{ k.display }}</div>
    <div class="text-sm text-subtle">{{ label }}</div>
  </div>
{%- endmacro -%}
{%- macro table(caption, col_name, col_value, chart) -%}
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ caption }}</caption>
      <thead><tr><th scope="col">{{ col_name }}</th><th scope="col">{{ col_value }}</th></tr></thead>
      <tbody>
{%- for name in chart.names %}
        <tr><th scope="row">{{ name }}</th><td>{{ chart["values"][loop.index0] | fmt_int }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
{%- endmacro -%}
{%- macro tender_list(rows, show_winner) -%}
  <ul class="list-none m-0 ps-0 divide-y divide-rule">
{%- for r in rows %}
    <li class="py-3">
      <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2">
        <div class="min-w-0">
          {%- if r.link %}
          <a href="{{ r.link }}" target="_blank" rel="noopener" class="font-medium text-brand hover:underline break-words">{{ r.name }}</a>
          {%- else %}
          <span class="font-medium text-ink-deep break-words">{{ r.name }}</span>
          {%- endif %}
          <div class="flex flex-wrap gap-2 mt-1 text-xs">
            <span class="badge">{{ r.ptype }}</span>
            <span class="badge">מספר: <span dir="ltr">{{ r.number }}</span></span>
            {%- if r.pay %}<span class="badge">תשלום מקוון</span>{% endif %}
            {%- if show_winner and r.winner %}<span class="badge">זוכה: {{ r.winner }}</span>{% endif %}
          </div>
        </div>
        <div class="shrink-0 text-sm text-ink md:text-end">
          <span class="text-subtle">מועד הגשה:</span>
          <span class="font-semibold" dir="ltr">{{ r.deadline }}</span>
          <span class="text-subtle" dir="ltr">{{ r.time }}</span>
        </div>
      </div>
    </li>
{%- endfor %}
  </ul>
{%- endmacro -%}
<h1>מכרזי עיריית באר שבע</h1>

<section class="card p-5 mb-6">
  {{ head("תקציר", "info") }}
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">חיפוש מכרז לפי שם, מספר מכרז או זוכה ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: שם המכרז, מספר המכרז, מועד ההגשה, תאריך העדכון והזוכה במכרז.</span>
  </span>
</a>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
  {{ kpi(model.kpis.open, model.labels.open_kpi) }}
  {{ kpi(model.kpis.next, model.labels.next_kpi) }}
  {{ kpi(model.kpis.ytd, model.labels.ytd_kpi) }}
  {{ kpi(model.kpis.total, "הליכים במאגר") }}
  {{ kpi(model.kpis.years, "טווח שנות מועד ההגשה") }}
  {{ kpi(model.kpis.winner, "הליכים שנסגרו לפני יותר מחצי שנה ופורסם בהם זוכה") }}
  {{ kpi(model.kpis.pay, "הליכים עם קישור לתשלום מקוון") }}
</div>

<section class="card p-5 mb-6">
  {{ head("מכרזים פתוחים להגשה", "list") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.open_lede }}</p>
  {%- if model.flags.has_open %}
  {{ tender_list(model.tables.open, false) }}
  {%- endif %}
</section>

<section class="card p-5 mb-6">
  {{ head("הליכים שנסגרו לאחרונה", "list") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.closed_lede }}</p>
  {{ tender_list(model.tables.closed, true) }}
</section>

<section class="card p-5 mb-6">
  {{ head("תובנות עיקריות", "circle-check") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  {{ head("הליכים לפי שנה וסוג הליך") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.yearly_lede }}</p>
  <div id="chart-yearly" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.yearly_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.yearly_aria }}</caption>
      <thead><tr><th scope="col">שנה</th>{% for s in model.charts.yearly.series %}<th scope="col">{{ s.name }}</th>{% endfor %}<th scope="col">סה״כ</th></tr></thead>
      <tbody>
{%- for x in model.charts.yearly.x %}
        {%- set i = loop.index0 %}
        <tr><th scope="row">{{ x }}</th>{% for s in model.charts.yearly.series %}<td>{{ s.data[i] | fmt_int }}</td>{% endfor %}<td>{{ model.charts.yearly.totals[i] | fmt_int }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<section class="card p-5 mb-6">
  {{ head("תחומי ההליכים", "tag") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.topics_lede }}</p>
  <div id="chart-topics" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.topics_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.topics_aria }}</caption>
      <thead><tr><th scope="col">תחום</th><th scope="col">כל ההליכים</th><th scope="col">פתוחים כעת</th></tr></thead>
      <tbody>
{%- for name in model.charts.topics.names %}
        <tr><th scope="row">{{ name }}</th><td>{{ model.charts.topics["values"][loop.index0] | fmt_int }}</td><td>{{ model.charts.topics.open[loop.index0] | fmt_int }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  {{ head("עונתיות: מועדי הגשה לפי חודש ושנה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.heat_lede }}</p>
  <div id="chart-heat" class="h-80 md:h-[460px]" role="img" data-fallback="explorer" aria-label="{{ model.labels.heat_aria }}"></div>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <h2 class="m-0 mb-3 text-base font-semibold text-ink-deep">יום ההגשה בשבוע</h2>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.weekday_lede }}</p>
    <div id="chart-weekday" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.weekday_aria }}"></div>
    {{ table(model.labels.weekday_aria, "יום", "מועדי הגשה", model.charts.weekday) }}
  </section>
  <section class="card p-5">
    <h2 class="m-0 mb-3 text-base font-semibold text-ink-deep">כמה זמן ניתן להגשה</h2>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.lead_lede }}</p>
    <div id="chart-lead" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.lead_aria }}"></div>
    {{ table(model.labels.lead_aria, "פרק זמן", "הליכים", model.charts.lead) }}
  </section>
</div>

<section class="card p-5 mb-6">
  {{ head("פרסום הזוכים", "circle-check") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.winner_lede }}</p>
  <div id="chart-winner" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.winner_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.winner_aria }}</caption>
      <thead><tr><th scope="col">שנה</th><th scope="col">עם זוכה</th><th scope="col">ללא זוכה</th><th scope="col">שיעור עם זוכה</th></tr></thead>
      <tbody>
{%- for x in model.charts.winner.x %}
        <tr><th scope="row">{{ x }}</th><td>{{ model.charts.winner.with[loop.index0] | fmt_int }}</td><td>{{ model.charts.winner.without[loop.index0] | fmt_int }}</td><td>{{ model.charts.winner.share[loop.index0] | fmt_num }}%</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

{%- if model.flags.has_winners %}
<section class="card p-5 mb-6">
  {{ head("הזוכים התכופים", "building-2") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.winners_lede }}</p>
  <div id="chart-winners" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.winners_aria }}"></div>
  {{ table(model.labels.winners_aria, "זוכה", "הליכים", model.charts.winners) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ head("תשלום מקוון לפי שנה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.pay_lede }} {{ model.labels.files_note }}</p>
  <div id="chart-pay" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.pay_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.pay_aria }}</caption>
      <thead><tr><th scope="col">שנה</th>{% for s in model.charts.pay.series %}<th scope="col">{{ s.name }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for x in model.charts.pay.x %}
        {%- set i = loop.index0 %}
        <tr><th scope="row">{{ x }}</th>{% for s in model.charts.pay.series %}<td>{{ s.data[i] | fmt_int }}</td>{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<section class="card p-5 mb-6">
  {{ head("תיאור מקורי", "list") }}
  <p class="m-0 text-sm text-subtle whitespace-pre-line">מכרזים ופניות לקבלת הצעות מחיר פעילים והיסטוריים בעיר.</p>
</section>

<script>
  (function () {
    const d = {{ model.charts.yearly | tojson }};
    const c = echarts.init(document.getElementById("chart-yearly"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { type: "scroll", bottom: 0 },
      grid: { left: 16, right: 16, top: 16, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { hideOverlap: true } },
      yAxis: { type: "value", name: "הליכים" },
      dataZoom: d.x.length > 16 ? [{ type: "inside", startValue: d.x.length - 16 }] : [],
      series: d.series.map(function (s) { return { type: "bar", stack: "all", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    const d = {{ model.charts.topics | tojson }};
    const c = echarts.init(document.getElementById("chart-topics"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0, data: ["כל ההליכים", "פתוחים כעת"] },
      grid: { left: 16, right: 24, top: 16, bottom: 40, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 140, overflow: "truncate" } },
      series: [
        { type: "bar", name: "כל ההליכים", data: d.values },
        { type: "bar", name: "פתוחים כעת", data: d.open }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    const h = {{ model.charts.heat | tojson }};
    const c = echarts.init(document.getElementById("chart-heat"));
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return echarts.format.encodeHTML(h.months[p.value[0]] + " " + h.years[p.value[1]]) + ": " + p.value[2] + " מועדי הגשה";
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: h.months, splitArea: { show: true }, axisLabel: { rotate: 45 } },
      yAxis: { type: "category", data: h.years, inverse: true, splitArea: { show: true } },
      visualMap: {
        min: 0, max: h.max, calculable: true, dimension: 2,
        orient: "horizontal", left: "center", bottom: 8,
        inRange: { color: ["#f1f7ff", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells, label: { show: false },
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    const d = {{ model.charts.weekday | tojson }};
    const c = echarts.init(document.getElementById("chart-weekday"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 16, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: { interval: 0 } },
      yAxis: { type: "value" },
      series: [{ type: "bar", name: "מועדי הגשה", data: d.values }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    const d = {{ model.charts.lead | tojson }};
    const c = echarts.init(document.getElementById("chart-lead"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 16, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, rotate: 30 } },
      yAxis: { type: "value" },
      series: [{ type: "bar", name: "הליכים", data: d.values }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    const d = {{ model.charts.winner | tojson }};
    const c = echarts.init(document.getElementById("chart-winner"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { hideOverlap: true } },
      yAxis: [{ type: "value", name: "הליכים" },
              { type: "value", name: "שיעור עם זוכה", min: 0, max: 100, axisLabel: { formatter: "{value}%" }, splitLine: { show: false } }],
      series: [
        { type: "bar", stack: "all", name: "עם זוכה מפורסם", data: d.with },
        { type: "bar", stack: "all", name: "ללא זוכה", data: d.without, itemStyle: { color: "#c3cfe7" } },
        { type: "line", name: "שיעור עם זוכה", yAxisIndex: 1, data: d.share, symbolSize: 6,
          lineStyle: { color: "#0b3668" }, itemStyle: { color: "#0b3668" },
          tooltip: { valueFormatter: function (v) { return v + "%"; } } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
{%- if model.flags.has_winners %}
  (function () {
    const d = {{ model.charts.winners | tojson }};
    const c = echarts.init(document.getElementById("chart-winners"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", minInterval: 1 },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 150, overflow: "truncate" } },
      series: [{ type: "bar", name: "הליכים", data: d.values }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
{%- endif %}
  (function () {
    const d = {{ model.charts.pay | tojson }};
    const c = echarts.init(document.getElementById("chart-pay"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { type: "scroll", bottom: 0 },
      grid: { left: 16, right: 16, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { hideOverlap: true } },
      yAxis: { type: "value", name: "הליכים" },
      series: d.series.map(function (s) {
        const o = { type: "bar", stack: "all", name: s.name, data: s.data };
        if (s.name === "ללא קישור לתשלום") { o.itemStyle = { color: "#c3cfe7" }; }
        return o;
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
