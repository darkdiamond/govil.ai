<script>
  (function () {
    const d = {{ model.charts.contact | tojson }};
    const el = document.getElementById("chart-contact");
    if (!el) return;
    const chart = echarts.init(el);
    const pct = function (v) { return v.toFixed(1) + "%"; };
    chart.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: pct },
      legend: { top: 0, type: "scroll" },
      grid: { left: 16, right: 24, top: 40, bottom: 16, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.types, inverse: true, axisLabel: { width: 130, overflow: "truncate" } },
      series: [
        { name: "טלפון", type: "bar", data: d.phone },
        { name: "דוא״ל", type: "bar", data: d.email },
        { name: "שם בעל אתר", type: "bar", data: d.owner }
      ]
    }));
    window.addEventListener("resize", function () { chart.resize(); });
  })();
</script>
