{% import "gov.j2" as gov %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסמה {{ model.release.date }}</p>
{%- if model.release.headline %}
  <p class="m-0 mb-3 font-semibold text-ink-deep">{{ model.release.headline }}</p>
{%- endif %}
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["unemp", "lfpr", "emp_rate", "employed", "unemployed", "broad"] %}
  {{ gov.kpi(model.kpis[key], model.labels[key ~ "_kpi"]) }}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

<section class="card p-5 mb-6">
  {{ gov.head("database", "שיעור האבטלה לאורך השנים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.long_note }}</p>
  {{ gov.chart("chart-long", model.labels.long_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.long_caption, ["שנה", "ממוצע", "הנמוך בשנה", "הגבוה בשנה", "חודשים בנתונים"], model.tables.long, ltr=(1, 2, 3, 4)) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("database", "אבטלה, נעדרים ומועסקים בחודשים האחרונים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.recent_note }}</p>
  {{ gov.chart("chart-recent", model.labels.recent_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.recent_caption, ["חודש", "השתתפות בכוח העבודה", "שיעור תעסוקה", "שיעור אבטלה", "אבטלה רחבה", "מועסקים (אלפים)"], model.tables.recent, ltr=(1, 2, 3, 4, 5)) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("database", "אבטלה בקרב נשים וגברים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.usex_note }}</p>
  {{ gov.chart("chart-usex", model.labels.usex_aria, "h-72 md:h-80") }}
  {{ gov.table(model.labels.usex_caption, ["שנה", "נשים", "גברים"], model.tables.usex, ltr=(1, 2)) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("database", "השתתפות בכוח העבודה לפי מין") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.lsex_note }}</p>
  {{ gov.chart("chart-lsex", model.labels.lsex_aria, "h-72 md:h-80") }}
  {{ gov.table(model.labels.lsex_caption, ["שנה", "נשים", "גברים"], model.tables.lsex, ltr=(1, 2)) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("database", "שיעור התעסוקה לפי מין וגיל") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.esex_note }}</p>
  {{ gov.chart("chart-esex", model.labels.esex_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.esex_caption, model.labels.esex_cols, model.tables.esex, ltr=(1, 2, 3, 4)) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("list", "אבטלה לפי גיל") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.age_note }}</p>
  {{ gov.chart("chart-age", model.labels.age_aria, "h-80 md:h-[460px]") }}
  {{ gov.table(model.labels.age_caption, model.labels.age_cols, model.tables.age, ltr=(0, 1, 2, 3, 4)) }}
</section>

{%- if model.flags.district %}
<section class="card p-5 mb-6">
  {{ gov.head("map-pin", "אבטלה ותעסוקה לפי מחוז") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.district_note }}</p>
  {{ gov.chart("chart-district", model.labels.district_aria, "h-80 md:h-[460px]") }}
  {{ gov.table(model.labels.district_caption, ["מחוז", "שיעור אבטלה", "השתתפות בכוח העבודה", "שיעור תעסוקה"], model.tables.district, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

{%- if model.flags.industry %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "מועסקים לפי ענף כלכלי") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.industry_note }}</p>
  {{ gov.chart("chart-industry", model.labels.industry_aria, "h-[560px] md:h-[620px]") }}
  {{ gov.table(model.labels.industry_caption, model.labels.ind_cols, model.tables.industry, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

{%- if model.flags.reasons %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "למה הפסיקו לעבוד") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.reasons_note }}</p>
  {{ gov.chart("chart-reasons", model.labels.reasons_aria, "h-[560px] md:h-[620px]") }}
  {{ gov.table(model.labels.reasons_caption, model.labels.reasons_cols, model.tables.reasons, ltr=(1, 2, 3, 4)) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>סקר כוח אדם הוא סקר מדגמי חודשי של הלמ"ס בקרב משקי בית. בכוח העבודה נכללים המועסקים והבלתי מועסקים: מי שלא עבדו, חיפשו עבודה באופן פעיל ויכלו להתחיל לעבוד.</li>
    <li>שיעור האבטלה הוא אחוז הבלתי מועסקים מכוח העבודה. שיעור ההשתתפות הוא אחוז כוח העבודה מכלל בני 15 ומעלה, ושיעור התעסוקה הוא אחוז המועסקים מכלל בני 15 ומעלה.</li>
    <li>אבטלה רחבה: בלתי מועסקים יחד עם מועסקים שנעדרו מהעבודה כל השבוע מסיבות כלכליות, כמו חופשה ללא תשלום, צמצום או השבתה של מקום העבודה. בתקופות מלחמה המדד הזה מראה את הפגיעה בשוק העבודה טוב יותר משיעור האבטלה הרגיל.</li>
    <li>נתונים מנוכי עונתיות מאפשרים להשוות חודשים סמוכים. הנתונים המקוריים מושפעים מחגים ומעונות השנה, ובקבוצות קטנות (גיל, מחוז) הם תנודתיים.</li>
    <li>הלמ"ס מפרסמת כל חודש גם הודעה מקוצרת של נתונים עיקריים, כשבוע לפני ההודעה המלאה. העמוד מתעדכן מההודעה המלאה, שבה אותם נתונים עיקריים ועוד פירוטים.</li>
  </ul>
</section>

<script>
  (function () {
    const d = {{ model.charts.long | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-long"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[6], pal[2], pal[1]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 20 }],
      series: [
        { type: "line", name: "נתון מקורי", data: d.orig, showSymbol: false, lineStyle: { width: 1 } },
        { type: "line", name: "מנוכה עונתיות", data: d.sa, showSymbol: false },
        { type: "line", name: "מגמה", data: d.trend, showSymbol: false, lineStyle: { width: 3 } }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.recent | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-recent"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[3]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
      series: [
        { type: "line", name: "שיעור אבטלה", data: d.unemp, lineStyle: { width: 3 } },
        { type: "line", name: "אבטלה רחבה", data: d.broad, areaStyle: { opacity: 0.15 } }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const charts = [
      ["chart-usex", {{ model.charts.usex | tojson }}, ["נשים", "גברים"]],
      ["chart-lsex", {{ model.charts.lsex | tojson }}, ["נשים", "גברים"]],
      ["chart-esex", {{ model.charts.esex | tojson }}, {{ model.labels.esex_series | tojson }}]
    ];
    const pal = window.GOVIL_PALETTE;
    charts.forEach(([id, d, names]) => {
      const chart = echarts.init(document.getElementById(id));
      chart.setOption(window.GovEcharts.option({
        color: [pal[3], pal[0], pal[5], pal[2]],
        tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
        legend: { top: 0 },
        grid: { left: 16, right: 16, top: names.length > 2 ? 56 : 40, bottom: 64, containLabel: true },
        xAxis: { type: "category", data: d.x },
        yAxis: { type: "value", scale: true, axisLabel: { formatter: "{value}%" } },
        dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 20 }],
        series: names.map((n, k) => ({
          type: "line", name: n, data: d["s" + k], showSymbol: false,
          lineStyle: { width: k < 2 ? 2.5 : 1.5, type: k < 2 ? "solid" : "dashed" }
        }))
      }));
      window.addEventListener("resize", () => chart.resize());
    });
  })();
  (function () {
    const d = {{ model.charts.age | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-age"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[6]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 48, top: 40, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [
        { type: "bar", name: d.cur_label, data: d.cur },
        { type: "bar", name: d.yago_label, data: d.yago }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- if model.flags.district %}
  (function () {
    const d = {{ model.charts.district | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-district"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[3], pal[0], pal[2]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      legend: { top: 0 },
      grid: [
        { left: 16, right: 16, top: 48, height: "28%", containLabel: true },
        { left: 16, right: 16, top: "52%", bottom: 8, containLabel: true }
      ],
      xAxis: [
        { type: "category", data: d.names, gridIndex: 0 },
        { type: "category", data: d.names, gridIndex: 1 }
      ],
      yAxis: [
        { type: "value", gridIndex: 0, axisLabel: { formatter: "{value}%" } },
        { type: "value", gridIndex: 1, scale: true, axisLabel: { formatter: "{value}%" } }
      ],
      series: [
        { type: "bar", name: "שיעור אבטלה", data: d.unemp, xAxisIndex: 0, yAxisIndex: 0 },
        { type: "bar", name: "השתתפות בכוח העבודה", data: d.lfpr, xAxisIndex: 1, yAxisIndex: 1 },
        { type: "bar", name: "שיעור תעסוקה", data: d.emp, xAxisIndex: 1, yAxisIndex: 1 }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.industry %}
  (function () {
    const d = {{ model.charts.industry | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-industry"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: {
        trigger: "axis",
        formatter: (ps) => {
          const i = ps[0].dataIndex, c = d.chg[i];
          return echarts.format.encodeHTML(d.names[i]) + "<br>" + Number(d.cur[i]).toLocaleString("he-IL") + " אלף מועסקים" +
            (c == null ? "" : "<br>שינוי בחודש: " + (c > 0 ? "+" : "") + Number(c).toLocaleString("he-IL") + " אלף");
        }
      },
      grid: { left: 16, right: 56, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: false }, splitLine: { show: false } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 150, overflow: "break" } },
      series: [{ type: "bar", data: d.cur, label: { show: true, position: "right", formatter: (p) => Number(p.value).toLocaleString("he-IL") } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.reasons %}
  (function () {
    const d = {{ model.charts.reasons | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-reasons"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[3], pal[6]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") + " אלף" },
      legend: { top: 0 },
      grid: { left: 16, right: 24, top: 40, bottom: 8, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 150, overflow: "break" } },
      series: [
        { type: "bar", name: "בלתי מועסקים", stack: "a", data: d.unemp },
        { type: "bar", name: "אינם בכוח העבודה", stack: "a", data: d.notlf }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
</script>
