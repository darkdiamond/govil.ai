<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">המשרד להגנת הסביבה מקיים במהלך השנה פעולות ניטור ומעקב שוטף אחר הנחלים בישראל. בנחלים מבוצעים שני סוגים של ניטור: ניטור כימי וניטור ביולוגי. ניטור כימי הינו נקודתי ומתבצע פעמיים בשנה (בסתיו ובאביב). בכל דיגום נבדקים יותר מעשרה פרמטרים קבועים, הניטור מבוצע על ידי רשות הטבע והגנים עבור המשרד להגנת הסביבה. ניטור ביולוגי בוחן את מצבם של הנחלים לאורך זמן באמצעות מעקב אחר שינויים בהרכב חברות של בעלי חיים וצמחים בנחלים. הניטור מבוצע במרכז הלאומי לאקולוגיה אקווטית, מוזיאון הטבע ע״ש שטיינהרדט, אוניברסיטת תל אביב.</p>
</section>

<script>
  (function () {
    var P = window.GOVIL_PALETTE;
    window.__riverColors = [P[0], P[2], P[1], P[6], P[5], P[3], P[7], P[4], P[8], P[9]];
    window.__riverFmt = function (v) {
      if (v === null || v === undefined || isNaN(v)) return "-";
      var a = Math.abs(v);
      if (a >= 100) return Math.round(v).toLocaleString("en-US");
      if (a >= 10) return String(Math.round(v * 10) / 10);
      if (a >= 1) return String(Math.round(v * 100) / 100);
      return String(Number(v.toPrecision(2)));
    };
    window.__riverAxis = function (v) {
      var a = Math.abs(v);
      if (a >= 1e6) return window.__riverFmt(v / 1e6) + "M";
      if (a >= 1e3) return window.__riverFmt(v / 1e3) + "K";
      return window.__riverFmt(v);
    };
    window.__riverNarrow = function (el) { return el.clientWidth < 500; };
  })();
</script>
<script>
  (function () {
    var d = {{ model.charts.by_year | tojson }};
    var C = window.__riverColors;
    var el = document.getElementById("chart-years");
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: C,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0, type: "plain" },
      grid: { left: 8, right: 16, top: window.__riverNarrow(el) ? 64 : 40, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: d.years },
      yAxis: { type: "value" },
      dataZoom: [{ type: "inside" }, { type: "slider", height: 18, bottom: 8 }],
      series: d.series.map(function (s) { return { type: "bar", stack: "all", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
<script>
  (function () {
    var all = {{ model.charts.trend | tojson }};
    var years = {{ model.charts.by_year.years | tojson }};
    var C = window.__riverColors, F = window.__riverFmt, E = echarts.format.encodeHTML;
    var el = document.getElementById("chart-trend");
    var c = echarts.init(el);
    function draw(key) {
      var d = all[key];
      c.setOption(window.GovEcharts.option({
        color: C,
        tooltip: { trigger: "axis", formatter: function (ps) {
          var out = E(String(ps[0].axisValue));
          ps.forEach(function (p) {
            if (p.value === null || p.value === undefined) return;
            var n = d.series[p.seriesIndex].n[p.dataIndex];
            out += "<br>" + p.marker + E(p.seriesName) + ": " + F(p.value) + " " + E(d.unit) + " (" + n + " דגימות)";
          });
          return out;
        } },
        legend: { top: 0, type: "plain" },
        grid: { left: 8, right: 16, top: window.__riverNarrow(el) ? 64 : 40, bottom: 56, containLabel: true },
        xAxis: { type: "category", data: years },
        yAxis: { type: "log", axisLabel: { formatter: window.__riverAxis, hideOverlap: true } },
        dataZoom: [{ type: "inside" }, { type: "slider", height: 18, bottom: 8 }],
        series: d.series.map(function (s) {
          return { type: "line", name: s.name, data: s.data, connectNulls: true, symbolSize: 5 };
        })
      }), true);
      el.setAttribute("aria-label", "גרף קווים: חציון שנתי של " + d.label + " בכל נחל, בציר לוגריתמי.");
      document.getElementById("trend-unit").textContent = "יחידות: " + d.unit;
    }
    var sel = document.getElementById("sel-trend");
    sel.addEventListener("change", function () { draw(sel.value); });
    draw(sel.value);
    window.addEventListener("resize", function () { draw(sel.value); c.resize(); });
  })();
{%- if model.charts.change.cells %}
</script>
<script>
  (function () {
    var d = {{ model.charts.change | tojson }};
    var E = echarts.format.encodeHTML;
    var el = document.getElementById("chart-change");
    var c = echarts.init(el);
    function signed(v) { return "\u200E" + (v > 0 ? "+" : v < 0 ? "\u2212" : "") + Math.abs(v) + "%"; }
    function draw() {
      var narrow = window.__riverNarrow(el);
      // narrow screens: parameters as rows, streams as columns
      var cells = d.cells.map(function (v) {
        var o = v.slice();
        if (narrow) { o[0] = v[1]; o[1] = v[0]; }
        return o;
      });
      var px = narrow ? d.streams : d.params, py = narrow ? d.params : d.streams;
      c.setOption(window.GovEcharts.option({
        tooltip: { position: "top", formatter: function (p) {
          var v = p.data, pi = narrow ? v[1] : v[0], si = narrow ? v[0] : v[1];
          return E(d.streams[si]) + ", " + E(d.params[pi]) + "<br>" + E(v[6]) + ": " + E(v[4]) + " (" + v[7] + " דגימות)" +
            "<br>" + "חמש השנים האחרונות: " + E(v[5]) + " (" + v[8] + " דגימות)<br>" + "שינוי: " + signed(v[3]);
        } },
        grid: { left: 8, right: 16, top: 8, bottom: 8, containLabel: true },
        xAxis: { type: "category", data: px, splitArea: { show: true },
                 axisLabel: narrow ? { interval: 0, width: 48, overflow: "break", fontSize: 10, lineHeight: 12 }
                                   : { interval: 0, rotate: 45, width: 90, overflow: "truncate" } },
        yAxis: { type: "category", data: py, splitArea: { show: true }, axisLabel: { width: 110, overflow: "truncate" } },
        visualMap: { min: -3, max: 3, dimension: 2, show: false,
                     inRange: { color: ["#198754", "#d9efe2", "#ffffff", "#f7d6da", "#dc3545"] } },
        series: [{ type: "heatmap", data: cells,
                   label: { show: true, fontSize: 10, formatter: function (p) { return signed(p.data[3]); } } }]
      }), true);
    }
    draw();
    window.addEventListener("resize", function () { draw(); c.resize(); });
  })();
{%- endif %}
</script>
<script>
  (function () {
    var all = {{ model.charts.box | tojson }};
    var F = window.__riverFmt, E = echarts.format.encodeHTML;
    Object.keys(all).forEach(function (k) {
      var b = all[k];
      var el = document.getElementById("chart-box-" + k);
      if (!el || !b.names.length) return;
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option({
        tooltip: { trigger: "item", formatter: function (p) {
          var o = p.data.slice(-5);
          return E(p.name) + " (" + b.n[p.dataIndex] + " דגימות)<br>חציון: " + F(o[2]) + " " + E(b.unit) +
            "<br>רבעונים: ⁦" + F(o[1]) + " - " + F(o[3]) + "⁩<br>אחוזון 5 עד 95: ⁦" + F(o[0]) + " - " + F(o[4]) + "⁩";
        } },
        grid: { left: 8, right: 16, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "log", axisLabel: { formatter: window.__riverAxis, hideOverlap: true } },
        yAxis: { type: "category", data: b.names },
        series: [{ type: "boxplot", name: b.label, data: b.data,
                   itemStyle: { color: "#dbe8fb", borderColor: "#0068f5" } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    });
  })();
</script>
<script>
  (function () {
    var all = {{ model.charts.stations | tojson }};
    var streams = {{ model.streams | tojson }};
    var C = window.__riverColors, F = window.__riverFmt, E = echarts.format.encodeHTML;
    var el = document.getElementById("chart-stations");
    var c = echarts.init(el);
    function draw(key) {
      var d = all[key];
      var names = d.names.slice().reverse(), vals = d.values.slice().reverse();
      var st = d.streams.slice().reverse(), ns = d.n.slice().reverse();
      c.setOption(window.GovEcharts.option({
        tooltip: { trigger: "item", formatter: function (p) {
          return E(names[p.dataIndex]) + " (" + E(st[p.dataIndex]) + ")<br>חציון: " + F(p.value) + " " + E(d.unit) +
            "<br>" + ns[p.dataIndex] + " דגימות";
        } },
        legend: { show: false },
        grid: { left: 8, right: 48, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "log", name: d.unit, nameLocation: "middle", nameGap: 28, axisLabel: { formatter: window.__riverAxis, hideOverlap: true } },
        yAxis: { type: "category", data: names, axisLabel: { width: 130, overflow: "truncate" } },
        series: [{ type: "bar", data: vals.map(function (v, i) {
          var j = streams.indexOf(st[i]);
          return { value: v, itemStyle: { color: C[(j < 0 ? 0 : j) % C.length] } };
        }), label: { show: true, position: "right", formatter: function (p) { return F(p.value); } } }]
      }), true);
      el.setAttribute("aria-label", "גרף עמודות אופקי: התחנות עם חציון " + d.label + " הגבוה ביותר.");
    }
    var sel = document.getElementById("sel-stations");
    sel.addEventListener("change", function () { draw(sel.value); });
    draw(sel.value);
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
<script>
  (function () {
    var all = {{ model.charts.season | tojson }};
    var F = window.__riverFmt, E = echarts.format.encodeHTML;
    var el = document.getElementById("chart-season");
    var c = echarts.init(el);
    function draw(key) {
      var d = all[key];
      c.setOption(window.GovEcharts.option({
        color: ["#6c9fd8", "#0b3668"],
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
          var i = ps[0].dataIndex;
          var out = E(d.names[i]);
          ps.forEach(function (p) {
            var n = p.seriesIndex === 0 ? d.ns[i] : d.na[i];
            out += "<br>" + p.marker + E(p.seriesName) + ": " + F(p.value) + " " + E(d.unit) + " (" + n + " דגימות)";
          });
          return out;
        } },
        legend: { top: 0 },
        grid: { left: 8, right: 16, top: 32, bottom: 8, containLabel: true },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 90, overflow: "truncate" } },
        xAxis: { type: "log", axisLabel: { formatter: window.__riverAxis, hideOverlap: true } },
        series: [
          { type: "bar", name: "אביב", data: d.spring },
          { type: "bar", name: "סתיו", data: d.autumn }
        ]
      }), true);
      el.setAttribute("aria-label", "גרף עמודות: חציון " + d.label + " באביב ובסתיו בכל נחל, בציר לוגריתמי.");
      document.getElementById("season-unit").textContent = "יחידות: " + d.unit;
    }
    var sel = document.getElementById("sel-season");
    sel.addEventListener("change", function () { draw(sel.value); });
    draw(sel.value);
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
<script>
  (function () {
    var d = {{ model.charts.heatmap | tojson }};
    var E = echarts.format.encodeHTML;
    var c = echarts.init(document.getElementById("chart-heat"));
    var cells = d.cells.map(function (v) { return [v[0], v[1], v[2] === null ? d.min - 1 : v[2], v[3], v[4]]; });
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        var v = p.data;
        return E(d.stations[v[1]]) + " (" + E(d.streams[v[1]]) + "), " + d.years[v[0]] + "<br>" + v[3] + " דגימות" +
          (v[4] ? "<br>חציון BOD: " + E(v[4]) + " מ״ג/ל׳" : "<br>ללא מדידת BOD");
      } },
      grid: { left: 8, right: 16, top: 8, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: d.years, splitArea: { show: true } },
      yAxis: { type: "category", data: d.stations, inverse: true, axisLabel: { fontSize: 10, width: 120, overflow: "truncate" } },
      dataZoom: [{ type: "inside", xAxisIndex: 0 }],
      visualMap: { min: d.min, max: d.max, dimension: 2, calculable: true, orient: "horizontal", left: "center", bottom: 8,
                   itemHeight: 120, text: ["עומס גבוה", "נמוך"],
                   formatter: function (v) { return window.__riverFmt(Math.pow(10, v)); },
                   inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] }, outOfRange: { color: "#c3cfe7" } },
      series: [{ type: "heatmap", data: cells }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
{%- if model.charts.field %}
</script>
<script>
  (function () {
    var f = {{ model.charts.field | tojson }};
    var F = window.__riverFmt, E = echarts.format.encodeHTML;
    var c = echarts.init(document.getElementById("chart-field"));
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "item", formatter: function (p) {
        if (p.seriesType !== "boxplot") return "";
        var o = p.data.slice(-5), i = p.dataIndex;
        return E(p.name) + " (" + f.n[i] + " מדידות)<br>חציון רוויה: " + F(o[2]) + "%<br>רבעונים: ⁦" + F(o[1]) + "% - " + F(o[3]) +
          "%⁩<br>אחוזון 5 עד 95: ⁦" + F(o[0]) + "% - " + F(o[4]) + "%⁩<br>מתחת לסף: ⁦" + Math.round(f.low_share[i] * 100) + "%⁩";
      } },
      grid: { left: 8, right: 16, top: 16, bottom: 32, containLabel: true },
      xAxis: { type: "value", name: "% רוויה", nameLocation: "middle", nameGap: 24 },
      yAxis: { type: "category", data: f.names },
      series: [{ type: "boxplot", name: "רוויית חמצן", data: f.data,
                 itemStyle: { color: "#dbe8fb", borderColor: "#0068f5" },
                 markLine: { symbol: "none", silent: true, lineStyle: { color: "#dc3545", type: "dashed" },
                             label: { formatter: {{ model.labels.low_do | tojson }} },
                             data: [{ xAxis: {{ model.charts.field_threshold | tojson }} }] } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
{%- endif %}
</script>
