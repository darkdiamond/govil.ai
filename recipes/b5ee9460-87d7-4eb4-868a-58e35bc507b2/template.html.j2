<h1>רשימת קלפיות נגישות להצבעת בוחרים המוגבלים בניידות</h1>

<style>
  .poll-table th, .poll-table td { padding: 0.35rem 0.5rem; text-align: start; vertical-align: top; }
  .poll-table tbody tr { border-top: 1px solid #c3cfe7; }
  .poll-dir summary { cursor: pointer; }
</style>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור קלפי נגישה לפי עיר, יישוב או כתובת ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: שם הרשות, היישוב, הרחוב, הכתובת ומקום הקלפי.</span>
  </span>
</a>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 {% if model.flags.missing %}text-warn{% else %}text-brand{% endif %}">
    <img src="/icons/{% if model.flags.missing %}triangle-alert{% else %}map-pin{% endif %}.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ model.labels.cover_title }}</h2>
  </div>
  <p class="m-0 mb-2 text-sm leading-relaxed">{{ model.labels.cover_text }}</p>
{%- if model.flags.missing %}
  <p class="m-0 mb-2 text-sm leading-relaxed">{{ model.labels.cover_missing }}</p>
{%- endif %}
  <p class="m-0 text-sm text-subtle leading-relaxed">ראו גם: <a href="{{ model.links.managers }}" class="text-brand underline">פרטי קשר עם מנהלי הבחירות</a> · <a href="{{ model.links.special }}" class="text-brand underline">קלפיות מיוחדות בפריסה ארצית</a>.</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.total_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.auth.tone }} mb-1" dir="ltr">{{ model.kpis.auth.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.auth_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.loc.tone }} mb-1" dir="ltr">{{ model.kpis.loc.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.loc_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.reg.tone }} mb-1" dir="ltr">{{ model.kpis.reg.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.reg_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">הקלפיות הנגישות לפי רשות ויישוב</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.dir_note }}</p>
  <div class="poll-dir">
{%- for a in model.directory %}
    <details class="border-t border-rule py-2">
      <summary class="text-sm"><span class="font-semibold text-ink-deep">{{ a.name }}</span> <span class="text-subtle">· {{ a.kind }} · {{ a.count }} קלפיות ב-{{ a.loc_count }} יישובים</span>
        <span class="block text-xs text-subtle mt-1">{{ a.localities }}</span>
      </summary>
{%- if a.rows %}
      <div class="overflow-x-auto mt-2">
        <table class="poll-table w-full text-sm">
          <caption class="sr-only">{{ model.labels.dir_caption }} — {{ a.name }}</caption>
          <thead><tr><th scope="col">יישוב</th><th scope="col">כתובת</th><th scope="col">מקום הקלפי</th><th scope="col">מספר קלפי</th></tr></thead>
          <tbody>
{%- for r in a.rows %}
            <tr><th scope="row">{{ r.locality }}</th><td>{% if r.address %}{{ r.address }}{% else %}<span class="text-subtle">—</span>{% endif %}</td><td>{{ r.venue }}</td><td dir="ltr" class="text-start">{{ r.ballot }}</td></tr>
{%- endfor %}
          </tbody>
        </table>
      </div>
{%- endif %}
    </details>
{%- endfor %}
  </div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">קלפיות נגישות לפי רשות מקומית</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.auth_note }}</p>
  <div id="chart-auth" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.auth_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="poll-table mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.auth_caption }}</caption>
      <thead><tr><th scope="col">רשות</th><th scope="col">קלפיות נגישות</th><th scope="col">יישובים</th></tr></thead>
      <tbody>
{%- for r in model.tables.auth %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.stations }}</td><td>{{ r.localities }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">באיזה מבנה נמצאת הקלפי?</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.venue_note }}</p>
    <div id="chart-venue" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.venue_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="poll-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.venue_caption }}</caption>
        <thead><tr><th scope="col">סוג מבנה</th><th scope="col">קלפיות</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.venue %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
{%- if model.flags.mix %}
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">סוגי המבנים בכל רשות</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.mix_note }}</p>
    <div id="chart-mix" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.mix_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
        <table class="poll-table mt-2 w-full text-sm">
          <caption class="sr-only">{{ model.labels.mix_caption }}</caption>
          <thead><tr><th scope="col">רשות</th>{% for v in model.charts.venue.names %}<th scope="col">{{ v }}</th>{% endfor %}<th scope="col">סה״כ</th></tr></thead>
          <tbody>
{%- for r in model.tables.mix %}
            <tr><th scope="row">{{ r.name }}</th>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}<td>{{ r.total }}</td></tr>
{%- endfor %}
          </tbody>
        </table>
      </div>
    </details>
  </section>
{%- endif %}
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">רשימת קלפיות נגישות</p>
</section>

<script>
  (function () {
    var d = {{ model.charts.auth | tojson }};
    var c = echarts.init(document.getElementById("chart-auth"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 40, containLabel: true },
      xAxis: { type: "value", minInterval: 1 },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [
        { type: "bar", name: "קלפיות נגישות", data: d.stations, label: { show: true, position: "right" } },
        { type: "bar", name: "יישובים", data: d.localities, itemStyle: { color: "#9fc3f8" } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.venue | tojson }};
    var c = echarts.init(document.getElementById("chart-venue"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 32, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "value", minInterval: 1 },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [{ type: "bar", name: "קלפיות", data: d.values, label: { show: true, position: "right" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var el = document.getElementById("chart-mix");
    if (!el) { return; }
    var d = {{ model.charts.mix | tojson }};
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        var out = [echarts.format.encodeHTML(d.names[i])];
        p.forEach(function (s) {
          var ser = d.series[s.seriesIndex];
          if (ser.count[i] > 0) {
            out.push(echarts.format.encodeHTML(ser.name) + ": " + ser.count[i] + " (" + ser.share[i] + "%)");
          }
        });
        return out.join("<br>");
      } },
      legend: { bottom: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: d.series.map(function (s) {
        return { type: "bar", name: s.name, stack: "mix", data: s.share };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
