<h1>יבואני מזון בעלי תעודות רישום יבואן בתוקף</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.total_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.holders.tone }} mb-1" dir="ltr">{{ model.kpis.holders.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.holders_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.multi.tone }} mb-1" dir="ltr">{{ model.kpis.multi.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.multi_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.cities.tone }} mb-1" dir="ltr">{{ model.kpis.cities.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.cities_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תעודות לפי סוג יבואן</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.types_note }}</p>
  <div id="chart-types" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.types_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">תעודות רישום לפי סוג יבואן</caption>
      <thead><tr><th scope="col">סוג יבואן</th><th scope="col">תעודות</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.types %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">ותק הרישומים: תעודות לפי טווח מספר רישום</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.bands_note }}</p>
  <div id="chart-bands" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.bands_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">תעודות בתוקף לפי טווח מספר רישום וסוג יבואן</caption>
      <thead><tr><th scope="col">טווח מספרי רישום</th>{% for t in model.tables.type_names %}<th scope="col">{{ t }}</th>{% endfor %}<th scope="col">סה״כ</th></tr></thead>
      <tbody>
{%- for r in model.tables.bands %}
        <tr><th scope="row" dir="ltr">{{ r.band }}</th>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}<td>{{ r.total }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">מחזיקים בכמה תעודות</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.combos_note }}</p>
    <div id="chart-combos" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.combos_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">מחזיקי תעודות מרובות לפי צירוף סוגים</caption>
        <thead><tr><th scope="col">צירוף סוגי תעודות</th><th scope="col">מחזיקים</th></tr></thead>
        <tbody>
{%- for r in model.tables.combos %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">צורה משפטית של המחזיקים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.legal_note }}</p>
    <div id="chart-legal" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.legal_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">מחזיקי תעודות לפי צורה משפטית</caption>
        <thead><tr><th scope="col">צורה משפטית</th><th scope="col">מחזיקים</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.legal %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">היישובים המובילים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cities_note }}</p>
  <div id="chart-cities" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.cities_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">תעודות לפי יישוב וסוג יבואן</caption>
      <thead><tr><th scope="col">יישוב</th>{% for t in model.tables.type_names %}<th scope="col">{{ t }}</th>{% endfor %}<th scope="col">סה״כ</th></tr></thead>
      <tbody>
{%- for r in model.tables.cities %}
        <tr><th scope="row">{{ r.name }}</th>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}<td>{{ r.total }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">תמהיל הסוגים לפי יישוב</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.mix_note }}</p>
    <div id="chart-mix" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.mix_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">שיעור כל סוג תעודה לפי יישוב</caption>
        <thead><tr><th scope="col">יישוב</th>{% for t in model.tables.type_names %}<th scope="col">{{ t }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in model.tables.mix %}
          <tr><th scope="row">{{ r.name }}</th>{% for c in r.cells %}<td dir="ltr">{{ c }}</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
      </div>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">מה יש בשם: נושאים בשמות היבואנים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.themes_note }}</p>
    <div id="chart-themes" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.themes_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">נושאים בשמות היבואנים</caption>
        <thead><tr><th scope="col">נושא</th><th scope="col">מחזיקים</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.themes %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

{% if model.tables.multi %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">התאגידים עם הכי הרבה תעודות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.multi_note }}</p>
  <div class="overflow-x-auto">
  <table id="table-multi" class="w-full text-sm">
    <caption class="sr-only">תאגידים המחזיקים ביותר מתעודה אחת</caption>
    <thead><tr><th scope="col">שם</th><th scope="col">תעודות</th><th scope="col">סוגים</th></tr></thead>
    <tbody>
{%- for r in model.tables.multi %}
      <tr><th scope="row">{{ r.name }}</th><td>{{ r.n }}</td><td>{{ r.types }}</td></tr>
{%- endfor %}
    </tbody>
  </table>
  </div>
</section>
{% endif %}

<script>
  (function () {
    function mk(id, opt) {
      var c = echarts.init(document.getElementById(id));
      var P = window.GOVIL_PALETTE;
      c.setOption(window.GovEcharts.option(Object.assign({ color: [P[0], P[1], P[2], P[6]].concat(P.slice(3, 6), P.slice(7)) }, opt)));
      window.addEventListener("resize", function () { c.resize(); });
    }
    function fmt(v) { return v == null ? "—" : v.toLocaleString("he-IL"); }
    var t = {{ model.charts.types | tojson }};
    mk("chart-types", {
      tooltip: { trigger: "axis", valueFormatter: fmt },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: t.names, inverse: true },
      series: [{ type: "bar", name: "תעודות", data: t.values, colorBy: "data",
                 label: { show: true, position: "right", formatter: function (p) { return fmt(p.value); }, color: "#0c3058" } }]
    });
    var b = {{ model.charts.bands | tojson }};
    mk("chart-bands", {
      tooltip: { trigger: "axis", valueFormatter: fmt },
      legend: { bottom: 0 },
      grid: { left: 40, right: 16, top: 24, bottom: 88, containLabel: true },
      xAxis: { type: "category", data: b.x, name: "מספר רישום", nameLocation: "middle", nameGap: 44, axisLabel: { rotate: 45, hideOverlap: true } },
      yAxis: { type: "value", name: "תעודות" },
      series: b.series.map(function (s) { return { type: "bar", stack: "t", name: s.name, data: s.data }; })
    });
  })();
</script>

<script>
  (function () {
    function fmt(v) { return v == null ? "—" : v.toLocaleString("he-IL"); }
    function hbar(id, d, name, colorIdx) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: [window.GOVIL_PALETTE[colorIdx || 0]],
        tooltip: { trigger: "axis", valueFormatter: fmt },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true,
                 axisLabel: { width: 150, overflow: "truncate" } },
        series: [{ type: "bar", name: name, data: d.values }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    hbar("chart-combos", {{ model.charts.combos | tojson }}, "מחזיקים", 0);
    hbar("chart-legal", {{ model.charts.legal | tojson }}, "מחזיקים", 1);
    hbar("chart-themes", {{ model.charts.themes | tojson }}, "מחזיקים", 2);
  })();
</script>

<script>
  (function () {
    function mk(id, opt) {
      var c = echarts.init(document.getElementById(id));
      var P = window.GOVIL_PALETTE;
      c.setOption(window.GovEcharts.option(Object.assign({ color: [P[0], P[1], P[2], P[6]].concat(P.slice(3, 6), P.slice(7)) }, opt)));
      window.addEventListener("resize", function () { c.resize(); });
    }
    function fmt(v) { return v == null ? "—" : v.toLocaleString("he-IL"); }
    var c = {{ model.charts.cities | tojson }};
    mk("chart-cities", {
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: fmt },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 56, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: c.names, inverse: true },
      series: c.series.map(function (s) { return { type: "bar", stack: "t", name: s.name, data: s.data }; })
    });
    var m = {{ model.charts.mix | tojson }};
    mk("chart-mix", {
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 56, containLabel: true },
      xAxis: { type: "value", max: 100, splitNumber: 4, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: m.names, inverse: true },
      series: m.series.map(function (s) { return { type: "bar", stack: "t", name: s.name, data: s.data }; })
    });
  })();
</script>
