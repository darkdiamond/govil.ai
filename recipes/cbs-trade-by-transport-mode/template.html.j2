{% import "gov.j2" as gov %}
{%- macro callout(key) -%}
{%- if model.callouts[key] is defined %}
  <p class="m-0 mb-3 text-sm font-semibold text-ink-deep">{{ model.callouts[key] }}</p>
{%- endif %}
{%- endmacro %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסמה {{ model.release.date }}</p>
{%- if model.release.headline %}
  <p class="m-0 mb-3 font-semibold text-ink-deep">{{ model.release.headline }}</p>
{%- endif %}
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["exports", "imports", "air_exp", "sea_imp"] %}
{%- if model.kpis[key] is defined %}
  {{ gov.kpi(model.kpis[key], model.labels[key ~ "_kpi"]) }}
{%- endif %}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

{%- if model.flags.mode_trend %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "יבוא ויצוא בים ובאוויר לאורך השנים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.mode_trend_note }}</p>
  {{ callout("peak") }}{{ callout("change") }}
  {{ gov.chart("chart-mode-trend", model.labels.mode_trend_aria, "h-72 md:h-96") }}
  {{ gov.table("יבוא ויצוא לפי סוג הובלה ושנה (מיליארדי דולרים)", model.tables.mode_trend_cols, model.tables.mode_trend, ltr=range(1, model.tables.mode_trend_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.mode_mix %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "חלקו של כל סוג הובלה ביבוא וביצוא") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.mode_mix_note }}</p>
  {{ callout("air_exports") }}{{ callout("sea_imports") }}
  {{ gov.chart("chart-mode-mix", model.labels.mode_mix_aria, "h-64 md:h-80") }}
  {{ gov.table("יבוא ויצוא לפי סוג הובלה (מיליוני דולרים ואחוזים)", ["סוג הובלה", "יבוא", "חלק מהיבוא", "יצוא", "חלק מהיצוא"], model.tables.mode_mix, ltr=(1, 2, 3, 4)) }}
</section>
{%- endif %}

{%- if model.flags.regions %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "הסחר לפי יבשת וסוג הובלה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.regions_note }}</p>
  {{ gov.chart("chart-regions", model.labels.regions_aria, "h-80 md:h-96") }}
  {{ gov.table("יבוא ויצוא לפי יבשת וסוג הובלה (מיליוני דולרים)", model.tables.regions_cols, model.tables.regions, ltr=range(1, model.tables.regions_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.air_countries %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "ארצות הסחר בהובלה אווירית") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.air_countries_note }}</p>
  {{ callout("air_dest") }}
  {{ gov.chart("chart-air-countries", model.labels.air_countries_aria, "h-[520px]") }}
  {{ gov.table("יבוא ויצוא בהובלה אווירית לפי ארץ (מיליוני דולרים)", ["ארץ", "יבוא", "יצוא"], model.tables.air_countries, ltr=(1, 2)) }}
</section>
{%- endif %}

{%- if model.flags.sea_countries %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "ארצות הסחר בהובלה ימית") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.sea_countries_note }}</p>
  {{ callout("sea_origin") }}
  {{ gov.chart("chart-sea-countries", model.labels.sea_countries_aria, "h-[520px]") }}
  {{ gov.table("יבוא ויצוא בהובלה ימית לפי ארץ (מיליוני דולרים)", ["ארץ", "יבוא", "יצוא"], model.tables.sea_countries, ltr=(1, 2)) }}
</section>
{%- endif %}

{%- if model.flags.partners %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "שותפות הסחר הגדולות: אוויר מול ים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.partners_note }}</p>
  {{ callout("partners") }}
  {{ gov.chart("chart-partners", model.labels.partners_aria, "h-[460px]") }}
  {{ gov.table("סך הסחר עם שותפות הסחר הגדולות לפי סוג הובלה", ["ארץ", "אווירית (מיליוני דולרים)", "ימית (מיליוני דולרים)", "חלק האוויר"], model.tables.partners, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

{%- if model.flags.movers %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "לאן היצוא גדל ולאן ירד") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.movers_note }}</p>
  {{ callout("movers") }}
  {{ gov.chart("chart-movers", model.labels.movers_aria, "h-[440px]") }}
  {{ gov.table("השינוי ביצוא לפי ארץ יעד (מיליוני דולרים)", model.labels.movers_cols, model.tables.movers, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

{%- if model.flags.air_chapters %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "מה נשלח באוויר: פרקי הסחורות") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.air_chapters_note }}</p>
  {{ callout("air_chapter") }}
  {{ gov.chart("chart-air-chapters", model.labels.air_chapters_aria, "h-[480px]") }}
  {{ gov.table("יבוא ויצוא בהובלה אווירית לפי פרק סחורות (מיליוני דולרים)", ["פרק", "יבוא", "יצוא"], model.tables.air_chapters, ltr=(1, 2)) }}
</section>
{%- endif %}

{%- if model.flags.sea_chapters %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "מה מגיע בים: פרקי הסחורות") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.sea_chapters_note }}</p>
  {{ callout("sea_chapter") }}
  {{ gov.chart("chart-sea-chapters", model.labels.sea_chapters_aria, "h-[480px]") }}
  {{ gov.table("יבוא ויצוא בהובלה ימית לפי פרק סחורות (מיליוני דולרים)", ["פרק", "יבוא", "יצוא"], model.tables.sea_chapters, ltr=(1, 2)) }}
</section>
{%- endif %}

{%- if model.flags.chapter_trend %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "היצוא האווירי לפי פרק סחורות לאורך השנים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.chapter_trend_note }}</p>
  {{ callout("chapter_shift") }}
  {{ gov.chart("chart-chapter-trend", model.labels.chapter_trend_aria, "h-72 md:h-96") }}
  {{ gov.table("יצוא בהובלה אווירית לפי פרק סחורות ושנה (מיליוני דולרים)", model.tables.chapter_trend_cols, model.tables.chapter_trend, ltr=range(1, model.tables.chapter_trend_cols | length) | list) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>הנתונים מתוך ההודעה השנתית לתקשורת של הלשכה המרכזית לסטטיסטיקה על יצוא ויבוא סחורות לפי סוג הובלה, המבוססת על נתוני הסחורות שעברו במכס. הערכים בדולרים, במחירים שוטפים.</li>
    <li>היצוא מסווג לפי היעד האחרון הידוע, והיבוא לפי ארץ המקור. "הנעה עצמית" היא סחורה שהיא עצמה כלי תחבורה, כמו אונייה או מטוס שנמכרו. ההובלה היבשתית קטנה מאוד ואינה מפורטת לפי ארץ ופרק.</li>
    <li>פרקי הסחורות הם פרקי תעריף המכס (השיטה המתואמת). כל הודעה מציגה חמש שנים, ונתוני השנים הקודמות בה עשויים להיות מעודכנים לעומת הודעות קודמות.</li>
  </ul>
</section>

<script>
(function () {
  function bar(id, d, opts) {
      const pal = window.GOVIL_PALETTE;
      const chart = echarts.init(document.getElementById(id));
      chart.setOption(window.GovEcharts.option({
        color: [pal[2], pal[0]],
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") + " מיליון $" },
        legend: { top: 0 },
        grid: { left: 16, right: 16, top: 40, bottom: 32, containLabel: true },
        xAxis: { type: "value", splitNumber: 3, name: "מיליארדי דולרים", nameLocation: "middle", nameGap: 26, axisLabel: { hideOverlap: true, formatter: (v) => (v / 1000).toLocaleString("he-IL") } },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: opts.w || 96, overflow: opts.w ? "break" : "truncate", lineHeight: 14 } },
        series: [
          { type: "bar", name: "יבוא", data: d.imp },
          { type: "bar", name: "יצוא", data: d.exp }
        ]
      }));
      window.addEventListener("resize", () => chart.resize());
  }
{%- if model.flags.mode_trend %}
  (function () {
    const d = {{ model.charts.mode_trend | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-mode-trend"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[1], pal[2], pal[0], pal[6]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) + " מיליארד $" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 56, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: "{value}" } },
      series: d.series.map((s, k) => ({ type: "line", name: s.name, data: s.data, symbolSize: 7, lineStyle: { width: 3, type: k % 2 ? "dashed" : "solid" } }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.mode_mix %}
  (function () {
    const d = {{ model.charts.mode_mix | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-mode-mix"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[1], pal[0], pal[6], pal[2]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 48, bottom: 8, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.cats, inverse: true },
      series: d.series.map((s) => ({ type: "bar", stack: "a", name: s.name, data: s.data, barWidth: "50%",
        label: { show: true, formatter: (p) => p.value >= 8 ? Number(p.value).toFixed(0) + "%" : "", color: "#fff" } }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.regions %}
  (function () {
    const d = {{ model.charts.regions | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-regions"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[1], pal[5], pal[0], pal[6]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") + " מיליון $" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 56, bottom: 32, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, name: "מיליארדי דולרים", nameLocation: "middle", nameGap: 26, axisLabel: { hideOverlap: true, formatter: (v) => (v / 1000).toLocaleString("he-IL") } },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: d.series.map((s) => ({ type: "bar", name: s.name, data: s.data }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.air_countries %}
  bar("chart-air-countries", {{ model.charts.air_countries | tojson }}, {});
{%- endif %}
{%- if model.flags.sea_countries %}
  bar("chart-sea-countries", {{ model.charts.sea_countries | tojson }}, {});
{%- endif %}
{%- if model.flags.partners %}
  (function () {
    const d = {{ model.charts.partners | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-partners"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") + " מיליון $" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 32, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, name: "מיליארדי דולרים", nameLocation: "middle", nameGap: 26, axisLabel: { hideOverlap: true, formatter: (v) => (v / 1000).toLocaleString("he-IL") } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 96, overflow: "truncate" } },
      series: [
        { type: "bar", stack: "a", name: "אווירית", data: d.air },
        { type: "bar", stack: "a", name: "ימית", data: d.sea }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.movers %}
  (function () {
    const d = {{ model.charts.movers | tojson }};
    const chart = echarts.init(document.getElementById("chart-movers"));
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => (v > 0 ? "+" : "") + Number(v).toLocaleString("he-IL") + " מיליון $" },
      grid: { left: 16, right: 16, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 96, overflow: "truncate" } },
      series: [{
        type: "bar",
        data: d.delta.map((v) => ({ value: v, itemStyle: { color: v >= 0 ? "#198754" : "#dc3545" } }))
      }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.air_chapters %}
  bar("chart-air-chapters", {{ model.charts.air_chapters | tojson }}, { w: 110 });
{%- endif %}
{%- if model.flags.sea_chapters %}
  bar("chart-sea-chapters", {{ model.charts.sea_chapters | tojson }}, { w: 110 });
{%- endif %}
{%- if model.flags.chapter_trend %}
  (function () {
    const d = {{ model.charts.chapter_trend | tojson }};
    const chart = echarts.init(document.getElementById("chart-chapter-trend"));
    chart.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") + " מיליון $" },
      legend: { top: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 48, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: (v) => v >= 1000 ? (v / 1000).toLocaleString("he-IL") + " מיליארד" : v } },
      series: d.series.map((s) => ({ type: "line", name: s.name, data: s.data, symbolSize: 7, lineStyle: { width: 3 } }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
})();
</script>
