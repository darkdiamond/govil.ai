<h1>ממציאים לבקשות פטנטים</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.apps.tone }} mb-1" dir="ltr">{{ model.kpis.apps.display }}</div>
    <div class="text-sm text-subtle">בקשות פטנט במאגר</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.inventors.tone }} mb-1" dir="ltr">{{ model.kpis.inventors.display }}</div>
    <div class="text-sm text-subtle">שמות ממציאים שונים</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.team_last.tone }} mb-1" dir="ltr">{{ model.kpis.team_last.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.team_last_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.il_share.tone }} mb-1" dir="ltr">{{ model.kpis.il_share.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.il_share_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">בקשות לפי טווח מספרי בקשה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.bands_note }}</p>
  <div id="chart-bands" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.bands_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.bands_aria }}</caption>
      <thead><tr><th scope="col">מספרי בקשה</th><th scope="col">בקשות</th><th scope="col">ממציאים בממוצע</th><th scope="col">ממציא יחיד (%)</th></tr></thead>
      <tbody>
{%- for r in model.tables.bands %}
        <tr><th scope="row" dir="ltr">{{ r.range }}</th><td>{{ r.apps }}</td><td>{{ r.mean }}</td><td>{{ r.solo }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
