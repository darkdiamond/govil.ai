      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.trend_aria }}</caption>
        <thead><tr><th scope="col">מספרי בקשה</th><th scope="col">ממציאים בממוצע</th><th scope="col">ממציא יחיד (%)</th></tr></thead>
        <tbody>
{%- for r in model.tables.bands %}
          <tr><th scope="row" dir="ltr">{{ r.range }}</th><td>{{ r.mean }}</td><td>{{ r.solo }}</td></tr>
{%- endfor %}
