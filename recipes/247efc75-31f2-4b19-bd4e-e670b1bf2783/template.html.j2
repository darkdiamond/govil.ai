  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">שמות ממציאים לבקשות להגנה ישראלית על פטנט</p>
</section>

<script>
  (function () {
    var b = {{ model.charts.bands | tojson }};
    var last = b.y.length - 1;
    var c1 = echarts.init(document.getElementById("chart-bands"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 40, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: b.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value" },
      series: [{ type: "bar", name: "בקשות", data: b.y.map(function (v, i) {
        return (b.partial && i === last) ? { value: v, itemStyle: { color: "#9fc3f7" } } : v;
      }) }]
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    var t = {{ model.charts.team_dist | tojson }};
    var c2 = echarts.init(document.getElementById("chart-team"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 40, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: t.names, name: "ממציאים", nameLocation: "middle", nameGap: 28 },
      yAxis: { type: "value" },
      series: [{ type: "bar", name: "בקשות", data: t.values }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });

    var tr = {{ model.charts.team_trend | tojson }};
    var c3 = echarts.init(document.getElementById("chart-trend"));
    c3.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 40, right: 40, top: 32, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: tr.x, axisLabel: { rotate: 45 } },
      yAxis: [
        { type: "value", scale: true, name: "ממציאים" },
        { type: "value", name: "%", min: 0, splitLine: { show: false } }
      ],
      series: [
        { type: "line", name: "ממציאים בממוצע לבקשה", data: tr.mean },
        { type: "line", name: "ממציא יחיד (%)", yAxisIndex: 1, data: tr.solo, lineStyle: { type: "dashed" } }
      ]
    }));
    window.addEventListener("resize", function () { c3.resize(); });
  })();
</script>

<script>
  (function () {
    var narrow = window.innerWidth < 640;
    function hbar(id, d, name, w) {
      if (narrow) { w = Math.min(w, 120); }
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis" },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: narrow ? 2 : 5, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: w, overflow: "truncate" } },
        series: [{ type: "bar", name: name, data: d.values.slice().reverse() }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    hbar("chart-top", {{ model.charts.top | tojson }}, "בקשות", 150);
    hbar("chart-pairs", {{ model.charts.pairs | tojson }}, "בקשות משותפות", 170);
    hbar("chart-types", {{ model.charts.types | tojson }}, "בקשות", 180);

    var p = {{ model.charts.prolific | tojson }};
    var c4 = echarts.init(document.getElementById("chart-prolific"));
    c4.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 40, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: p.names, name: "בקשות לממציא", nameLocation: "middle", nameGap: 28 },
      yAxis: { type: "log", min: 1 },
      series: [{ type: "bar", name: "ממציאים", data: p.values }]
    }));
    window.addEventListener("resize", function () { c4.resize(); });
  })();
</script>

{% if model.flags.countries %}
<script>
  (function () {
    var cn = {{ model.charts.countries | tojson }};
    var c5 = echarts.init(document.getElementById("chart-countries"));
    c5.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: window.innerWidth < 640 ? 2 : 5, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: cn.names.slice().reverse() },
      series: [{ type: "bar", name: "רשומות ממציאים", data: cn.values.slice().reverse().map(function (v, i, a) {
        return cn.names[a.length - 1 - i] === "ישראל" ? { value: v, itemStyle: { color: "#0b3668" } } : v;
      }) }]
    }));
    window.addEventListener("resize", function () { c5.resize(); });

    function stack100(id, d, colors) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: colors,
        tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
        legend: { bottom: 0 },
        grid: { left: 40, right: 16, top: 24, bottom: 88, containLabel: true },
        xAxis: { type: "category", data: d.x, axisLabel: { interval: 0, formatter: function (v) { return v.replace(" (", "\n("); } } },
        yAxis: { type: "value", max: 100, name: "%" },
        series: d.series.map(function (s) { return { type: "bar", stack: "s", name: s.name, data: s.data }; })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    stack100("chart-mix", {{ model.charts.mix | tojson }}, ["#0068f5", "#0b3668", "#9fc3f7", "#5a9bf6", "#c3cfe7", "#6c757d"]);
    stack100("chart-comp", {{ model.charts.comp | tojson }}, ["#0068f5", "#0b3668", "#9fc3f7"]);
  })();
</script>
{% endif %}

<script>
  (function () {
    var tm = {{ model.charts.type_mix | tojson }};
    var c6 = echarts.init(document.getElementById("chart-type-mix"));
    c6.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return tm.types[p.value[1]] + ", " + tm.x[p.value[0]] + ": " + p.value[2] + "%";
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 80, containLabel: true },
      xAxis: { type: "category", data: tm.x, axisLabel: { rotate: 45 }, splitArea: { show: true } },
      yAxis: { type: "category", data: tm.types, axisLabel: { width: 120, overflow: "truncate" }, splitArea: { show: true } },
      visualMap: {
        min: 0, max: tm.max, calculable: true, dimension: 2,
        orient: "horizontal", left: "center", bottom: 0, itemHeight: 120,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", name: "שיעור", data: tm.cells }]
    }));
    window.addEventListener("resize", function () { c6.resize(); });
  })();
</script>
