<h1>כינויי מקור</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">בקשות לכינויי מקור</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.reg_share.tone }} mb-1" dir="ltr">{{ model.kpis.reg_share.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.reg_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.span.tone }} mb-1" dir="ltr">{{ model.kpis.span.display }}</div>
    <div class="text-sm text-subtle">שנות ההגשה במאגר</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.national.tone }} mb-1" dir="ltr">{{ model.kpis.national.display }}</div>
    <div class="text-sm text-subtle">בקשות לאומיות ישראליות</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">בקשות לפי שנת הגשה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.years_note }}</p>
  <div id="chart-years" data-fallback="explorer" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.years_aria }}"></div>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">מצב הבקשות</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.status_note }}</p>
    <div id="chart-status" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.status_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.status_caption }}</caption>
        <thead><tr><th scope="col">מצב</th><th scope="col">בקשות</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.status %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">רשומות וסגורות לפי עשור</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.dec_note }}</p>
    <div id="chart-dec" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.dec_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
        <table class="mt-2 w-full text-sm">
          <caption class="sr-only">{{ model.labels.dec_caption }}</caption>
          <thead><tr><th scope="col">עשור</th><th scope="col">בקשות</th>{% for h in model.tables.statuses %}<th scope="col">{{ h }}</th>{% endfor %}<th scope="col">שיעור הסגורות</th></tr></thead>
          <tbody>
{%- for r in model.tables.dec %}
            <tr><th scope="row">{{ r.dec }}</th><td>{{ r.total }}</td>{% for v in r.v %}<td>{{ v }}</td>{% endfor %}<td dir="ltr">{{ r.closed }}</td></tr>
{%- endfor %}
          </tbody>
        </table>
      </div>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">סוגי הסחורות (סיווג ניצה)</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cls_note }}</p>
  <div id="chart-cls" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.cls_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.cls_caption }}</caption>
        <thead><tr><th scope="col">סוג ניצה</th><th scope="col">בקשות</th>{% for h in model.tables.statuses %}<th scope="col">{{ h }}</th>{% endfor %}<th scope="col">שיעור הסגורות</th></tr></thead>
        <tbody>
{%- for r in model.tables.cls %}
          <tr><th scope="row">{{ r.cls }}</th><td>{{ r.total }}</td>{% for v in r.v %}<td>{{ v }}</td>{% endfor %}<td dir="ltr">{{ r.closed }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">סוגי הסחורות לאורך העשורים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.heat_note }}</p>
  <div id="chart-heat" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.heat_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.heat_caption }}</caption>
        <thead><tr><th scope="col">סוג ניצה</th>{% for h in model.tables.heat_x %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in model.tables.heat %}
          <tr><th scope="row">{{ r.cls }}</th>{% for v in r.v %}<td>{{ v }}</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
{%- if model.flags.waves %}
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">ימי ההגשה העמוסים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.waves_note }}</p>
    <div id="chart-waves" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.waves_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
        <table class="mt-2 w-full text-sm">
          <caption class="sr-only">{{ model.labels.waves_caption }}</caption>
          <thead><tr><th scope="col">תאריך הגשה</th><th scope="col">בקשות</th><th scope="col">מהן רשומות</th><th scope="col">סוג ניצה עיקרי</th></tr></thead>
          <tbody>
{%- for r in model.tables.waves %}
            <tr><th scope="row" dir="ltr">{{ r.date }}</th><td>{{ r.count }}</td><td>{{ r.reg }}</td><td>{{ r.cls }}</td></tr>
{%- endfor %}
          </tbody>
        </table>
      </div>
    </details>
  </section>
{%- endif %}
{%- if model.flags.lag %}
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">מהבקשה ועד הרישום</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.lag_note }}</p>
    <div id="chart-lag" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.lag_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.lag_caption }}</caption>
        <thead><tr><th scope="col">זמן עד הרישום</th>{% for h in model.tables.lag_heads %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in model.tables.lag %}
          <tr><th scope="row">{{ r.b }}</th>{% for v in r.v %}<td>{{ v }}</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
{%- endif %}
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">באיזה כתב נרשם הכינוי</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.script_note }}</p>
  <div id="chart-script" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.script_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.script_caption }}</caption>
        <thead><tr><th scope="col">עשור</th>{% for h in model.tables.script_heads %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in model.tables.script %}
          <tr><th scope="row">{{ r.dec }}</th>{% for v in r.v %}<td>{{ v }}</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>

{% if model.flags.national %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">כינויי מקור ישראליים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.national_note }}</p>
  <div class="overflow-x-auto">
    <table id="table-national" class="w-full text-sm">
      <caption class="sr-only">{{ model.labels.national_caption }}</caption>
      <thead><tr><th scope="col" class="pe-3 py-1">מספר</th><th scope="col" class="pe-3 py-1">כינוי המקור</th><th scope="col" class="pe-3 py-1">סוג ניצה</th><th scope="col" class="pe-3 py-1">מצב</th><th scope="col" class="pe-3 py-1">הגשה</th><th scope="col" class="pe-3 py-1">רישום</th></tr></thead>
      <tbody>
{%- for r in model.tables.national %}
        <tr><th scope="row" dir="ltr" class="pe-3 py-1 text-start align-top">{{ r.num }}</th><td class="pe-3 py-1 align-top"><bdi>{{ r.name }}</bdi>{% if r.alt %}<div class="text-xs text-subtle text-end" dir="ltr">{{ r.alt }}</div>{% endif %}</td><td class="pe-3 py-1 align-top">{{ r.cls }}</td><td class="pe-3 py-1 align-top">{{ r.status }}</td><td dir="ltr" class="pe-3 py-1 align-top whitespace-nowrap">{{ r.app }}</td><td dir="ltr" class="pe-3 py-1 align-top whitespace-nowrap">{{ r.reg }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endif %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">הבקשות האחרונות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.latest_note }}</p>
  <div class="overflow-x-auto">
    <table id="table-latest" class="w-full text-sm">
      <caption class="sr-only">{{ model.labels.latest_caption }}</caption>
      <thead><tr><th scope="col" class="pe-3 py-1">מספר</th><th scope="col" class="pe-3 py-1">כינוי המקור</th><th scope="col" class="pe-3 py-1">סוג ניצה</th><th scope="col" class="pe-3 py-1">מצב</th><th scope="col" class="pe-3 py-1">הגשה</th><th scope="col" class="pe-3 py-1">רישום</th></tr></thead>
      <tbody>
{%- for r in model.tables.latest %}
        <tr><th scope="row" dir="ltr" class="pe-3 py-1 text-start align-top">{{ r.num }}</th><td class="pe-3 py-1 align-top"><bdi>{{ r.name }}</bdi>{% if r.alt %}<div class="text-xs text-subtle text-end" dir="ltr">{{ r.alt }}</div>{% endif %}</td><td class="pe-3 py-1 align-top">{{ r.cls }}</td><td class="pe-3 py-1 align-top">{{ r.status }}</td><td dir="ltr" class="pe-3 py-1 align-top whitespace-nowrap">{{ r.app }}</td><td dir="ltr" class="pe-3 py-1 align-top whitespace-nowrap">{{ r.reg }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle">בקשות שהוגשו להגנה ישראלית על כינויי מקור</p>
</section>

<script>
  (function () {
    var d = {{ model.charts.years | tojson }};
    var c = echarts.init(document.getElementById("chart-years"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0 },
      grid: { left: 40, right: 16, top: 40, bottom: 64, containLabel: true },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 20 }],
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", name: "בקשות" },
      series: d.series.map(function (s) { return { type: "bar", stack: "y", name: s.name, data: s.data, barMaxWidth: 24 }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var s = {{ model.charts.status | tojson }};
    var c = echarts.init(document.getElementById("chart-status"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        return p.name + ": " + p.value.toLocaleString("he-IL") + " (" + p.percent + "%)";
      } },
      legend: { bottom: 0 },
      series: [{ type: "pie", radius: ["45%", "72%"], center: ["50%", "45%"], name: "מצב",
                 label: { formatter: "{d}%", fontFamily: "Rubik" }, data: s }]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var d = {{ model.charts.dec | tojson }};
    var c2 = echarts.init(document.getElementById("chart-dec"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      legend: { bottom: 0 },
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex, out = d.x[i];
        ps.forEach(function (p) {
          var x = d.series[p.seriesIndex];
          out += "<br>" + p.marker + x.name + ": " + x.share[i] + "% (" + x.data[i].toLocaleString("he-IL") + ")";
        });
        return out;
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "value", max: 100, interval: 50, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.x, inverse: true },
      series: d.series.map(function (x) { return { type: "bar", stack: "d", name: x.name, data: x.share }; })
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.cls | tojson }};
    var c = echarts.init(document.getElementById("chart-cls"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "value", splitNumber: 3 },
      yAxis: { type: "category", data: d.x, inverse: true,
               axisLabel: { width: 140, overflow: "truncate", interval: 0, fontSize: 11 } },
      series: d.series.map(function (x) { return { type: "bar", stack: "c", name: x.name, data: x.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var h = {{ model.charts.heat | tojson }};
    var c2 = echarts.init(document.getElementById("chart-heat"));
    c2.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return h.y[p.data[1]] + "<br>" + h.x[p.data[0]] + ": " + p.data[2].toLocaleString("he-IL") + " בקשות";
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true },
               axisLabel: { interval: 0, rotate: 30, fontSize: 10 } },
      yAxis: { type: "category", data: h.y, inverse: true, splitArea: { show: true },
               axisLabel: { width: 120, overflow: "truncate", fontSize: 11 } },
      visualMap: { min: 0, max: h.max, calculable: true, dimension: 2,
                   orient: "horizontal", left: "center", bottom: 0, itemHeight: 120,
                   inRange: { color: ["#f1f7ff", "#0068f5", "#0b3668"] },
                   textStyle: { fontFamily: "Rubik", color: "#0c3058" } },
      series: [{ type: "heatmap", name: "בקשות", data: h.cells,
                 label: { show: true, fontFamily: "Rubik", fontSize: 10, color: "#0c3058", textBorderColor: "#ffffff", textBorderWidth: 2,
                          formatter: function (p) { return p.data[2] ? String(p.data[2]) : ""; } },
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    var w = {{ model.charts.waves | tojson }};
    var el = document.getElementById("chart-waves");
    if (el) {
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
          var i = ps[0].dataIndex;
          return w.x[i] + "<br>" + w.y[i].toLocaleString("he-IL") + " בקשות<br>" + w.cls[i];
        } },
        grid: { left: 16, right: 32, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 3 },
        yAxis: { type: "category", data: w.x, inverse: true },
        series: [{ type: "bar", name: "בקשות", data: w.y,
                   label: { show: true, position: "right", fontFamily: "Rubik" } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }

    var l = {{ model.charts.lag | tojson }};
    var el2 = document.getElementById("chart-lag");
    if (el2) {
      var c2 = echarts.init(el2);
      c2.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { bottom: 0 },
        grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
        xAxis: { type: "value", splitNumber: 3 },
        yAxis: { type: "category", data: l.x, inverse: true,
                 axisLabel: { width: 110, overflow: "truncate", fontSize: 11 } },
        series: l.series.map(function (x) { return { type: "bar", name: x.name, data: x.data }; })
      }));
      window.addEventListener("resize", function () { c2.resize(); });
    }
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.script | tojson }};
    var c = echarts.init(document.getElementById("chart-script"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 40, right: 16, top: 24, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { interval: 0, rotate: 45, fontSize: 10 } },
      yAxis: { type: "value", name: "בקשות" },
      series: d.series.map(function (x) { return { type: "bar", stack: "s", name: x.name, data: x.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
