<h1>פנסיה-נט</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
  <p class="mt-2 mb-0 text-sm text-subtle">{{ model.labels.scope_note }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-brand mb-1">{{ model.kpis.assets.display }}</div>
    <div class="text-sm text-subtle">סך נכסים · {{ model.labels.period }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-brand mb-1">{{ model.kpis.tracks.display }}</div>
    <div class="text-sm text-subtle">מסלולים מדווחים</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-brand mb-1">{{ model.kpis.managers.display }}</div>
    <div class="text-sm text-subtle">גופים מנהלים</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-brand mb-1">{{ model.kpis.month_yield.display }}</div>
    <div class="text-sm text-subtle">תשואה משוקללת בחודש האחרון</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">היקף הנכסים לאורך זמן</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">סך הנכסים בכל חודש לפי סוג קרן, במיליארדי ₪.</p>
  <div id="chart-assets" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.assets_aria }}"></div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">נתח שוק לפי גוף מנהל</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">נכסים במיליארדי ₪ בחודש הדיווח האחרון.</p>
  <div id="chart-managers" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.managers_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.table_caption }}</caption>
      <thead><tr><th scope="col">גוף מנהל</th><th scope="col">נכסים</th><th scope="col">נתח</th></tr></thead>
      <tbody>
{%- for r in model.tables.managers %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.assets }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">תשואה חודשית משוקללת</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">ממוצע תשואות המסלולים, משוקלל לפי נכסים. חודשים שליליים באדום.</p>
    <div id="chart-yields" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.yields_aria }}"></div>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">תשואה ל-12 חודשים מתגלגלים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">התשואה המצטברת בשנה שהסתיימה בכל חודש.</p>
    <div id="chart-rolling" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.rolling_aria }}"></div>
  </section>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">דמי ניהול</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.fees_note }}</p>
    <div id="chart-fees" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.fees_aria }}"></div>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">הפקדות נטו</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">הפקדות פחות משיכות והעברות, במיליארדי ₪, במסלולים שדיווחו עליהן.</p>
    <div id="chart-net" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.net_aria }}"></div>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">המסלולים הגדולים: תשואה מתחילת השנה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">המסלולים בעלי הנכסים הרבים ביותר בחודש האחרון.</p>
  <div id="chart-tracks" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.tracks_aria }}"></div>
  <p class="mt-3 text-sm text-subtle">הנתונים המלאים זמינים להורדה בעמוד המאגר ב-<a class="text-brand underline" href="https://data.gov.il/dataset/3a1ca8fa-738b-4890-b52f-e8f7ce1e6145" target="_blank" rel="noopener">data.gov.il</a>.</p>
</section>

<script>
  (function () {
    var a = {{ model.charts.assets | tojson }};
    var c1 = echarts.init(document.getElementById("chart-assets"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v.toLocaleString("he-IL") + " מיליארד ₪"; } },
      legend: { bottom: 0 },
      grid: { left: 56, right: 16, top: 24, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: a.x },
      yAxis: { type: "value", name: "מיליארד ₪" },
      series: a.series.map(function (s) {
        return { type: "line", name: s.name, stack: "total", areaStyle: {}, showSymbol: false, data: s.data };
      })
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    var m = {{ model.charts.managers | tojson }};
    var c2 = echarts.init(document.getElementById("chart-managers"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v.toLocaleString("he-IL") + " מיליארד ₪"; } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", name: "מיליארד ₪" },
      yAxis: { type: "category", data: m.names, inverse: true },
      series: [{ type: "bar", data: m.values }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    var y = {{ model.charts.yields | tojson }};
    var c3 = echarts.init(document.getElementById("chart-yields"));
    c3.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      grid: { left: 40, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: y.x },
      yAxis: { type: "value", name: "%" },
      series: [{ type: "bar", name: "תשואה חודשית", data: y.y.map(function (v) {
        return v < 0 ? { value: v, itemStyle: { color: "#dc3545" } } : v;
      }) }]
    }));
    window.addEventListener("resize", function () { c3.resize(); });

    var r = {{ model.charts.rolling | tojson }};
    var c4 = echarts.init(document.getElementById("chart-rolling"));
    c4.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      grid: { left: 40, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: r.x },
      yAxis: { type: "value", name: "%" },
      series: [{ type: "line", name: "תשואה ל-12 חודשים", data: r.y, showSymbol: false,
                 markLine: { silent: true, symbol: "none", data: [{ yAxis: 0 }], lineStyle: { color: "#6c757d" } } }]
    }));
    window.addEventListener("resize", function () { c4.resize(); });

    var f = {{ model.charts.fees | tojson }};
    var c5 = echarts.init(document.getElementById("chart-fees"));
    c5.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v === null ? "—" : v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 40, right: 16, top: 24, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: f.x },
      yAxis: { type: "value", scale: true, name: "%" },
      series: [
        { type: "line", name: "מצבירה", data: f.mgmt },
        { type: "line", name: "מהפקדה", data: f.deposit }
      ]
    }));
    window.addEventListener("resize", function () { c5.resize(); });

    var n = {{ model.charts.net | tojson }};
    var c6 = echarts.init(document.getElementById("chart-net"));
    c6.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + " מיליארד ₪"; } },
      grid: { left: 40, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: n.x },
      yAxis: { type: "value", name: "מיליארד ₪" },
      series: [{ type: "bar", name: "הפקדות נטו", data: n.y.map(function (v) {
        return v < 0 ? { value: v, itemStyle: { color: "#dc3545" } } : v;
      }) }]
    }));
    window.addEventListener("resize", function () { c6.resize(); });

    var t = {{ model.charts.tracks | tojson }};
    var c7 = echarts.init(document.getElementById("chart-tracks"));
    c7.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", name: "%" },
      yAxis: { type: "category", data: t.names, inverse: true },
      series: [{ type: "bar", name: "תשואה מתחילת השנה", data: t.values.map(function (v) {
        return v < 0 ? { value: v, itemStyle: { color: "#dc3545" } } : v;
      }) }]
    }));
    window.addEventListener("resize", function () { c7.resize(); });
  })();
</script>
