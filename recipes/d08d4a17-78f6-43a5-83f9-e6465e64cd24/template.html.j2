<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">המאגר מכיל את רשימת הנוטריונים הפעילים.</p>
</section>

<script>
  (function () {
    function hbar(id, d, unit, fmt) {
      var x = echarts.init(document.getElementById(id));
      x.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 120, overflow: "truncate" } },
        series: [{ type: "bar", name: unit, data: d.values }]
      }));
      window.addEventListener("resize", function () { x.resize(); });
    }
    hbar("chart-cities", {{ model.charts.cities | tojson }}, "נוטריונים");
    hbar("chart-langs", {{ model.charts.langs | tojson }}, "נוטריונים");
    hbar("chart-pairs", {{ model.charts.pairs | tojson }}, "נוטריונים");
    hbar("chart-surnames", {{ model.charts.surnames | tojson }}, "נוטריונים");
    hbar("chart-firsts", {{ model.charts.firsts | tojson }}, "נוטריונים");
  })();
</script>

<script>
  (function () {
    var k = {{ model.charts.curve | tojson }};
    var c = echarts.init(document.getElementById("chart-curve"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", formatter: function (p) {
        return "ישובים מובילים: " + p[0].axisValue + "<br>" + p[0].value + "% מהנוטריונים";
      } },
      grid: { left: 48, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: k.x, name: "דירוג הישוב", nameLocation: "middle", nameGap: 28,
               axisLabel: { hideOverlap: true } },
      yAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      series: [{ type: "line", data: k.y, showSymbol: false, areaStyle: { opacity: 0.2 } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var s = {{ model.charts.sizes | tojson }};
    var c2 = echarts.init(document.getElementById("chart-sizes"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: s.names, inverse: true, name: "נוטריונים בישוב", nameLocation: "start" },
      series: [
        { type: "bar", name: "שיעור הישובים", data: s.cities },
        { type: "bar", name: "שיעור הנוטריונים", data: s.notaries }
      ]
    }));
    window.addEventListener("resize", function () { c2.resize(); });

    var l = {{ model.charts.nl | tojson }};
    var c3 = echarts.init(document.getElementById("chart-nl"));
    c3.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 40, right: 16, top: 40, bottom: 32, containLabel: true },
      xAxis: { type: "category", data: l.names, axisLabel: { interval: 0, fontSize: 11 } },
      yAxis: { type: "value", name: "נוטריונים" },
      series: [{ type: "bar", name: "נוטריונים", data: l.values }]
    }));
    window.addEventListener("resize", function () { c3.resize(); });
  })();
</script>

<script>
  (function () {
    var a = {{ model.charts.share | tojson }};
    var c = echarts.init(document.getElementById("chart-share"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + "%"; } },
      grid: { left: 16, right: 32, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: "{value}%" }, splitNumber: 3 },
      yAxis: { type: "category", data: a.names, inverse: true },
      series: [{ type: "bar", name: "עם שפה נוספת", data: a.values,
                 markLine: { symbol: "none", lineStyle: { type: "dashed", color: "#0b3668" },
                             label: { show: false }, data: [{ xAxis: a.avg }] } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var h = {{ model.charts.heat | tojson }};
    var c2 = echarts.init(document.getElementById("chart-heat"));
    c2.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return h.y[p.value[1]] + " · " + h.x[p.value[0]] + ": " + p.value[2] + "% (" +
          p.value[3].toLocaleString("he-IL") + " נוטריונים)";
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true }, axisLabel: { interval: 0, rotate: 45, fontSize: 10 } },
      yAxis: { type: "category", data: h.y, inverse: true, splitArea: { show: true }, axisLabel: { fontSize: 11 } },
      visualMap: {
        min: 0, max: h.max, calculable: true, dimension: 2,
        orient: "horizontal", left: "center", bottom: 4, itemHeight: 120,
        inRange: { color: ["#f1f7ff", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells,
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>
