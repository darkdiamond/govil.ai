        <tbody>
{%- for r in model.tables.heat %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.total }}</td>{% for v in r.vals %}<td dir="ltr">{{ v }}</td>{% endfor %}</tr>
{%- endfor %}
