<h1>מאגר הנוטריונים</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">נוטריונים פעילים</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.cities.tone }} mb-1" dir="ltr">{{ model.kpis.cities.display }}</div>
    <div class="text-sm text-subtle">ישובים</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.foreign.tone }} mb-1" dir="ltr">{{ model.kpis.foreign.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.foreign_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.langs.tone }} mb-1" dir="ltr">{{ model.kpis.langs.display }}</div>
    <div class="text-sm text-subtle">שפות שירות מלבד עברית</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">נוטריונים לפי ישוב</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cities_note }}</p>
  <div id="chart-cities" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.cities_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.cities_caption }}</caption>
      <thead><tr><th scope="col">ישוב</th><th scope="col">נוטריונים</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.cities %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">ריכוז גאוגרפי</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.curve_note }}</p>
    <div id="chart-curve" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.curve_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.curve_caption }}</caption>
        <thead><tr><th scope="col">מספר הישובים המובילים</th><th scope="col">שיעור הנוטריונים</th></tr></thead>
        <tbody>
{%- for r in model.tables.curve %}
          <tr><th scope="row">{{ r.k }}</th><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">ישובים לפי מספר הנוטריונים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.sizes_note }}</p>
    <div id="chart-sizes" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.sizes_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.sizes_caption }}</caption>
        <thead><tr><th scope="col">נוטריונים בישוב</th><th scope="col">ישובים</th><th scope="col">נוטריונים</th></tr></thead>
        <tbody>
{%- for r in model.tables.sizes %}
          <tr><th scope="row">{{ r.label }}</th><td>{{ r.cities }}</td><td>{{ r.notaries }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">שפות השירות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.langs_note }}</p>
