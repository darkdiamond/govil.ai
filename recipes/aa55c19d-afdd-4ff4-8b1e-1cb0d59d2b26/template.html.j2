<script>
  (function () {
    function bars(id, d, color) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 4, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { fontSize: 11 } },
        series: [{ type: "bar", name: "מורי דרך", data: d.values, itemStyle: { color: color } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    bars("chart-firsts", {{ model.charts.firsts | tojson }}, "#0068f5");
    bars("chart-lasts", {{ model.charts.lasts | tojson }}, "#0b3668");
  })();
</script>
