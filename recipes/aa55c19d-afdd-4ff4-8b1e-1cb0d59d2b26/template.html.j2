        <thead><tr><th scope="col">סוג וקידומת</th><th scope="col">מורי דרך</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.prefixes %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
{%- if model.flags.regions %}
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">אזורי חיוג של מספרים קוויים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.region_note }}</p>
    <div id="chart-regions" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.region_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
