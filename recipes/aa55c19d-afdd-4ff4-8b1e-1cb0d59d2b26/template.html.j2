        <thead><tr><th scope="col">אזור חיוג</th><th scope="col">מורי דרך</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.regions %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
