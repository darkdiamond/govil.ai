<h1>מורי דרך מורשים בישראל</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
{%- if model.flags.excluded %}
  <p class="m-0 mt-2 text-sm text-subtle">{{ model.labels.excluded }}</p>
{%- endif %}
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.total_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.contact.tone }} mb-1" dir="ltr">{{ model.kpis.contact.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.contact_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.multi.tone }} mb-1" dir="ltr">{{ model.kpis.multi.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.multi_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.titled.tone }} mb-1" dir="ltr">{{ model.kpis.titled.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.titled_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מורי דרך לפי טווח מספרי רישיון</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.fine_note }}</p>
  <div id="chart-fine" data-fallback="explorer" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.fine_aria }}"></div>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">זמינות פרטי קשר</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.contact_note }}</p>
    <div id="chart-contact" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.contact_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.contact_caption }}</caption>
        <thead><tr><th scope="col">מצב</th><th scope="col">מורי דרך</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.contact %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">ללא פרטי קשר, לפי טווח</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cband_note }}</p>
    <div id="chart-cband" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.cband_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.bands_caption }}</caption>
        <thead><tr><th scope="col">טווח מספרים</th><th scope="col">מורי דרך</th><th scope="col">שיעור מילוי</th><th scope="col">ללא פרטי קשר</th><th scope="col">עם תואר</th></tr></thead>
        <tbody>
{%- for r in model.tables.bands %}
          <tr><th scope="row" dir="ltr">{{ r.range }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.fill }}</td><td dir="ltr">{{ r.none }}</td><td dir="ltr">{{ r.titled }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">ספקיות הדוא״ל</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.prov_note }}</p>
    <div id="chart-providers" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.prov_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.prov_caption }}</caption>
        <thead><tr><th scope="col">ספקית</th><th scope="col">כתובות</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.providers %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">סוג הדוא״ל לפי טווח</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.kind_note }}</p>
    <div id="chart-kinds" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.kind_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.kind_caption }}</caption>
        <thead><tr><th scope="col">טווח מספרים</th>{% for c in model.tables.kind_cols %}<th scope="col">{{ c }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in model.tables.kinds %}
          <tr><th scope="row" dir="ltr">{{ r.range }}</th>{% for v in r.vals %}<td dir="ltr">{{ v }}</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">הטלפון הראשי</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.prefix_note }}</p>
