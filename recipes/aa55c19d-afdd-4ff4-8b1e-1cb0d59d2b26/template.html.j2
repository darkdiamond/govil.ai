<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">השמות הנפוצים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.names_note }}</p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <div>
      <h3 class="text-base font-semibold text-ink-deep mb-2">שמות פרטיים</h3>
      <div id="chart-firsts" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.firsts_aria }}"></div>
      <details class="mt-3">
        <summary class="text-sm text-subtle">הצג כטבלה</summary>
        <table class="mt-2 w-full text-sm">
          <caption class="sr-only">{{ model.labels.firsts_caption }}</caption>
          <thead><tr><th scope="col">שם פרטי</th><th scope="col">מורי דרך</th></tr></thead>
          <tbody>
{%- for r in model.tables.firsts %}
            <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
          </tbody>
        </table>
      </details>
    </div>
    <div>
      <h3 class="text-base font-semibold text-ink-deep mb-2">שמות משפחה</h3>
      <div id="chart-lasts" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.lasts_aria }}"></div>
      <details class="mt-3">
        <summary class="text-sm text-subtle">הצג כטבלה</summary>
        <table class="mt-2 w-full text-sm">
          <caption class="sr-only">{{ model.labels.lasts_caption }}</caption>
          <thead><tr><th scope="col">שם משפחה</th><th scope="col">מורי דרך</th></tr></thead>
          <tbody>
{%- for r in model.tables.lasts %}
            <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
          </tbody>
        </table>
      </details>
    </div>
  </div>
</section>

<script>
  (function () {
    var f = {{ model.charts.fine | tojson }};
    var c = echarts.init(document.getElementById("chart-fine"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", formatter: function (ps) {
        var i = ps[0].dataIndex;
        var s = f.ranges[i] + "<br>מורי דרך: " + f.counts[i].toLocaleString("he-IL");
        s += f.fill[i] === null ? "<br>(טווח חלקי — ללא שיעור)" : "<br>שיעור מילוי: " + f.fill[i] + "%";
        return s;
      } },
      grid: { left: 16, right: 16, top: 40, bottom: 56, containLabel: true },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 18 }],
      xAxis: { type: "category", data: f.x, name: "תחילת הטווח", nameLocation: "middle", nameGap: 28,
               axisLabel: { fontSize: 10, hideOverlap: true } },
      yAxis: { type: "value", name: "מורי דרך" },
      series: [{ type: "bar", name: "מורי דרך", data: f.counts, itemStyle: { color: "#0068f5" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.contact | tojson }};
    var colors = ["#0068f5", "#0b3668", "#0dcaf0", "#ffc107", "#dc3545"];
    var c = echarts.init(document.getElementById("chart-contact"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        return p.name + ": " + p.value.toLocaleString("he-IL") + " (" + p.percent + "%)";
      } },
      legend: { bottom: 0 },
      series: [{ type: "pie", radius: ["42%", "68%"], center: ["50%", "44%"],
        label: { formatter: "{d}%" },
        data: d.names.map(function (n, i) {
          var col = n === "ללא פרטי קשר" ? "#dc3545" : colors[i % 4];
          return { name: n, value: d.values[i], itemStyle: { color: col } };
        }) }]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var b = {{ model.charts.contact_band | tojson }};
    var c2 = echarts.init(document.getElementById("chart-cband"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", formatter: function (ps) {
        var i = ps[0].dataIndex;
        return b.ranges[i] + "<br>ללא פרטי קשר: " + b.none[i] + "%<br>מורי דרך בטווח: " + b.counts[i].toLocaleString("he-IL");
      } },
      grid: { left: 16, right: 16, top: 32, bottom: 32, containLabel: true },
      xAxis: { type: "category", data: b.x, name: "תחילת הטווח", nameLocation: "middle", nameGap: 40,
               axisLabel: { fontSize: 10, interval: 0, rotate: 40 } },
      yAxis: { type: "value", name: "% ללא פרטי קשר", axisLabel: { formatter: "{value}%" } },
      series: [{ type: "bar", name: "ללא פרטי קשר", data: b.none, itemStyle: { color: "#dc3545" } }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    var p = {{ model.charts.providers | tojson }};
    var c = echarts.init(document.getElementById("chart-providers"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "log", logBase: 10, min: 1, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: p.names, inverse: true, axisLabel: { fontSize: 11 } },
      series: [{ type: "bar", name: "כתובות", data: p.values, itemStyle: { color: "#0068f5" },
        label: { show: true, position: "right", fontSize: 10 } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var k = {{ model.charts.kind_band | tojson }};
    var kc = ["#0068f5", "#ffc107", "#198754", "#0b3668"];
    var c2 = echarts.init(document.getElementById("chart-kinds"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: k.x, inverse: true, axisLabel: { fontSize: 10 } },
      series: k.series.map(function (s, i) {
        return { type: "bar", stack: "k", name: s.name, data: s.data, itemStyle: { color: kc[i % kc.length] } };
      })
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    var p = {{ model.charts.prefixes | tojson }};
    var c = echarts.init(document.getElementById("chart-prefixes"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 4, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: p.names, inverse: true, axisLabel: { fontSize: 11 } },
      series: [{ type: "bar", name: "מורי דרך", data: p.values, itemStyle: { color: "#0b3668" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

