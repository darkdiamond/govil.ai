{%- endif %}
</div>

{%- if model.flags.langs %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">שפות ההדרכה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.langs_note }}</p>
  <div id="chart-langs" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.langs_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.langs_caption }}</caption>
      <thead><tr><th scope="col">שפה</th><th scope="col">מורי דרך</th></tr></thead>
      <tbody>
{%- for r in model.tables.langs %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
      </tbody>
