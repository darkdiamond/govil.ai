<script>
  (function () {
    function hbar(id, d, name) {
      var el = document.getElementById(id);
      if (!el) return;
      var c = echarts.init(el);
      var lw = Math.min(150, Math.round(el.clientWidth * 0.42));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true,
                 axisLabel: { width: lw, overflow: "truncate" } },
        series: [{ type: "bar", name: name, data: d.values }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    hbar("chart-types", {{ model.charts.types | tojson }}, "מתקנים");
    hbar("chart-settlements", {{ model.charts.settlements | tojson }}, "מתקנים");
    hbar("chart-specialties", {{ model.charts.specialties | tojson }}, "מתקנים");
    hbar("chart-chains", {{ model.charts.chains | tojson }}, "מתקנים");

    var b = {{ model.charts.breadth | tojson }};
    var cb = echarts.init(document.getElementById("chart-breadth"));
    cb.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 40, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: b.x, name: "תחומים" },
      yAxis: { type: "value", name: "מתקנים" },
      series: [{ type: "bar", name: "מתקנים", data: b.y }]
    }));
    window.addEventListener("resize", function () { cb.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.districts | tojson }};
    var c = echarts.init(document.getElementById("chart-districts"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: d.series.map(function (s) { return { type: "bar", stack: "t", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var sel = document.getElementById("chart-stations");
    if (sel) {
      var s = {{ model.charts.stations | tojson }};
      var cs = echarts.init(sel);
      cs.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
          var i = p[0].dataIndex;
          return s.names[i] + "<br>מכוני רישוי: " + s.values[i] +
            (s.ratio[i] === null ? "" : "<br>מתקנים לכל מכון: " + s.ratio[i].toLocaleString("he-IL"));
        } },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", minInterval: 1, splitNumber: 4 },
        yAxis: { type: "category", data: s.names, inverse: true },
        series: [{ type: "bar", name: "מכוני רישוי", data: s.values }]
      }));
      window.addEventListener("resize", function () { cs.resize(); });
    }
  })();
</script>

<script>
  (function () {
    var t = {{ model.charts.families | tojson }};
    var c = echarts.init(document.getElementById("chart-families"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        return p.name + ": " + p.value.toLocaleString("he-IL") + " הרשאות";
      } },
      series: [{
        type: "sunburst", data: t, radius: ["12%", "92%"], sort: null,
        nodeClick: "rootToNode",
        itemStyle: { borderColor: "#fff", borderWidth: 1 },
        levels: [{},
                 { r0: "12%", r: "48%", label: { rotate: 0, fontSize: 11, width: 64, overflow: "truncate", minAngle: 18 } },
                 { r0: "48%", r: "92%", label: { rotate: "radial", fontSize: 9, width: 70, overflow: "truncate", minAngle: 7 } }]
      }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    function heat(id, h, unit) {
      var el = document.getElementById(id);
      if (!el) return;
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option({
        tooltip: { position: "top", formatter: function (p) {
          return h.y[p.value[1]] + " · " + h.x[p.value[0]] + ": " + p.value[2] + "% (" +
            p.value[3].toLocaleString("he-IL") + " " + unit + ")";
        } },
        grid: { left: 16, right: 16, top: 16, bottom: 64, containLabel: true },
        xAxis: { type: "category", data: h.x, splitArea: { show: true },
                 axisLabel: { interval: 0, rotate: 45, width: 90, overflow: "truncate", fontSize: 10 } },
        yAxis: { type: "category", data: h.y, inverse: true, splitArea: { show: true },
                 axisLabel: { width: Math.min(110, Math.round(el.clientWidth * 0.3)), overflow: "truncate", fontSize: 11 } },
        visualMap: {
          min: 0, max: h.max, dimension: 2, calculable: true,
          orient: "horizontal", left: "center", bottom: 0, itemHeight: 120,
          inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
          textStyle: { fontFamily: "Rubik", color: "#0c3058" }
        },
        series: [{ type: "heatmap", data: h.cells,
                   emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    heat("chart-cooc", {{ model.charts.cooc | tojson }}, "מתקנים");
    heat("chart-heat", {{ model.charts.heat | tojson }}, "מתקנים");
  })();
</script>

<script>
  (function () {
    var el = document.getElementById("chart-ev");
    if (!el) return;
    var e = {{ model.charts.ev | tojson }};
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        return e.names[i] + ": " + e.values[i] + "%<br>" + e.counts[i].toLocaleString("he-IL") +
          " מתוך " + e.totals[i].toLocaleString("he-IL") + " מתקנים";
      } },
      grid: { left: 16, right: 24, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: e.names, inverse: true },
      series: [{ type: "bar", name: "שיעור מורשים", data: e.values,
                 markLine: { symbol: "none", silent: true, label: { show: false },
                             lineStyle: { type: "dashed", color: "#6c757d" },
                             data: [{ xAxis: e.national }] } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
