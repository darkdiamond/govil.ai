<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">רשימת חברות ממשלתיות ודירקטורים מכהנים</p>
</section>

<script>
  (function () {
    var narrow = window.innerWidth < 640;
    function stacked(id, d, opts) {
      opts = opts || {};
      var el = document.getElementById(id);
      if (!el) { return; }
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                   valueFormatter: opts.pct ? function (v) { return v + "%"; } : undefined },
        legend: { bottom: 0 },
        grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
        xAxis: opts.pct ? { type: "value", max: 100, axisLabel: { formatter: "{value}%" } }
                        : { type: "value", minInterval: 1, splitNumber: 4, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true,
                 axisLabel: { width: narrow ? 140 : 230, overflow: "truncate" } },
        series: d.series.map(function (s) {
          var o = { type: "bar", stack: "total", name: s.name, data: s.data, barMaxWidth: 28 };
          if (s.color) { o.itemStyle = { color: s.color }; }
          return o;
        })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    stacked("chart-status", {{ model.charts.status | tojson }});
    stacked("chart-office", {{ model.charts.office | tojson }});
    stacked("chart-gaps", {{ model.charts.gaps | tojson }});

    var r = {{ model.charts.roles | tojson }};
    var c2 = echarts.init(document.getElementById("chart-roles"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: r.names, axisLabel: { interval: 0, fontSize: 11 } },
      yAxis: { type: "value", name: "רשומות", minInterval: 1 },
      series: [{ type: "bar", name: "רשומות", data: r.values, barMaxWidth: 48 }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    var narrow = window.innerWidth < 640;
    var b = {{ model.charts.boards | tojson }};
    var c = echarts.init(document.getElementById("chart-boards"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex, t = 0, lines = [];
        ps.forEach(function (p) { t += p.value; if (p.value) { lines.push(p.marker + p.seriesName + ": " + p.value); } });
        return b.full[i] + "<br>" + lines.join("<br>") + "<br>סה״כ: " + t;
      } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "value", minInterval: 1, splitNumber: 4 },
      yAxis: { type: "category", data: b.names, inverse: true,
               axisLabel: { width: narrow ? 140 : 230, overflow: "truncate" } },
      series: b.series.map(function (s) {
        return { type: "bar", stack: "total", name: s.name, data: s.data, barMaxWidth: 24,
                 itemStyle: { color: s.color } };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var z = {{ model.charts.size | tojson }};
    var c2 = echarts.init(document.getElementById("chart-size"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 16, right: 16, top: 32, bottom: 44, containLabel: true },
      xAxis: { type: "category", data: z.names, name: "חברים בדירקטוריון", nameLocation: "middle", nameGap: 40,
               axisLabel: { interval: 0, fontSize: narrow ? 10 : 11, lineHeight: 13 } },
      yAxis: { type: "value", name: "חברות", minInterval: 1 },
      series: [{ type: "bar", name: "חברות", data: z.values, barMaxWidth: 40 }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

{% if model.flags.gender %}
<script>
  (function () {
    var narrow = window.innerWidth < 640;
    function gbar(id, d, pct) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
          var lines = [ps[0].name];
          ps.forEach(function (p) {
            var s = d.series[p.seriesIndex];
            var v = pct ? (s.counts[p.dataIndex] + " (" + p.value + "%)") : p.value;
            lines.push(p.marker + p.seriesName + ": " + v);
          });
          return lines.join("<br>");
        } },
        legend: { bottom: 0 },
        grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
        xAxis: pct ? { type: "value", max: 100, axisLabel: { formatter: "{value}%" } }
                   : { type: "value", minInterval: 1, splitNumber: 4 },
        yAxis: { type: "category", data: d.names, inverse: true,
                 axisLabel: { width: narrow ? 140 : 200, overflow: "truncate" } },
        series: d.series.map(function (s) {
          return { type: "bar", stack: "total", name: s.name, data: s.data, barMaxWidth: 28,
                   itemStyle: { color: s.color } };
        })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    gbar("chart-grole", {{ model.charts.grole | tojson }}, true);
    gbar("chart-gboards", {{ model.charts.gboards | tojson }}, false);
    gbar("chart-goffice", {{ model.charts.goffice | tojson }}, false);
  })();
</script>
{% endif %}
