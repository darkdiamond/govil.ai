    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.status_note }}</p>
    <div id="chart-status" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.status_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.status_caption }}</caption>
        <thead><tr><th scope="col">סטטוס</th><th scope="col">חברות</th><th scope="col">שיעור</th><th scope="col">עם דירקטורים</th></tr></thead>
        <tbody>
{%- for r in model.tables.status %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td><td>{{ r.listed }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/list.svg" alt="" class="w-5 h-5" />
