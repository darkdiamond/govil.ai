<h1>רשימת חברות ממשלתיות ודירקטורים מכהנים</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.companies.tone }} mb-1" dir="ltr">{{ model.kpis.companies.display }}</div>
    <div class="text-sm text-subtle">חברות ממשלתיות ברשימה</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.listed.tone }} mb-1" dir="ltr">{{ model.kpis.listed.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.listed_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.seats.tone }} mb-1" dir="ltr">{{ model.kpis.seats.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.seats_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.women.tone }} mb-1" dir="ltr">{{ model.kpis.women.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.women_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
