    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.roles_note }}</p>
    <div id="chart-roles" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.roles_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.roles_caption }}</caption>
        <thead><tr><th scope="col">תפקיד</th><th scope="col">רשומות</th></tr></thead>
        <tbody>
{%- for r in model.tables.roles %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
