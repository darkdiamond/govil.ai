          "<br>נפח שנתי (חציון): " + p.value[0].toLocaleString("he-IL") + " מיליון מ״ק" +
          "<br>ספיקת שיא (חציון): " + p.value[1].toLocaleString("he-IL") + " מ״ק בשנייה";
      } },
      legend: { top: 0, type: "scroll" },
      grid: { left: 40, right: 24, top: 48, bottom: 40, containLabel: true },
      xAxis: { type: "log", name: "נפח שנתי (מיליון מ״ק)", nameLocation: "middle", nameGap: 28 },
      yAxis: { type: "log", name: "ספיקת שיא (מ״ק בשנייה)" },
      series: d.series.map(function (s) { return { type: "scatter", name: s.name, data: s.data, symbolSize: 8 }; })
    }));
