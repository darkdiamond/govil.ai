    <img src="/icons/triangle-alert.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">ספיקות השיא הגבוהות במאגר</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.peaks_note }}</p>
  <div id="chart-peaks" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.peaks_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.peaks_caption }}</caption>
      <thead><tr><th scope="col">תחנה</th><th scope="col">שנה הידרולוגית</th><th scope="col">תאריך</th><th scope="col">מ״ק בשנייה</th><th scope="col">אזור</th></tr></thead>
      <tbody>
{%- for r in model.tables.peaks %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.year }}</td><td>{{ r.date }}</td><td>{{ r.q }}</td><td>{{ r.region }}</td></tr>
{%- endfor %}
