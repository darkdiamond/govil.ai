{%- if model.flags.index %}
<script>
  (function () {
    var d = {{ model.charts.index | tojson }};
    var c = echarts.init(document.getElementById("chart-index"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", formatter: function (p) {
        var i = p[0].dataIndex, v = d.v[i], q = d.q[i];
        var s = d.x[i];
        if (v !== null) {
          var tag = v < d.dry ? " (שנה שחונה)" : (v >= d.wet ? " (שנה גשומה)" : "");
          s += "<br>נפח שנתי: " + v + "% מהרגיל" + tag + " (" + d.vn[i] + " תחנות)";
        }
        if (q !== null) {
          s += "<br>ספיקת שיא: " + q + "% מהרגיל" + (q >= d.flood ? " (שנת שיטפון)" : "") + " (" + d.qn[i] + " תחנות)";
        }
        return s;
      } },
      legend: { top: 0 },
      grid: { left: 48, right: 16, top: 40, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", name: "% מהרגיל", min: 0 },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 16 }],
      series: [
        { type: "bar", name: "נפח שנתי", data: d.v.map(function (v) {
          if (v === null) return null;
          if (v < d.dry) return { value: v, itemStyle: { color: "#dc3545" } };
          if (v >= d.wet) return { value: v, itemStyle: { color: "#0b3668" } };
          return v;
        }), markLine: { silent: true, symbol: "none", data: [{ yAxis: 100, name: "רגיל" }],
          lineStyle: { color: "#6c757d", type: "dashed" },
          label: { formatter: "{b}", position: "insideEndTop", fontFamily: "Rubik" } } },
        { type: "line", name: "ספיקת שיא", data: d.q, connectNulls: false, symbolSize: 4,
          lineStyle: { width: 1.5 } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

<script>
  (function () {
    var d = {{ model.charts.peaks | tojson }};
    var c = echarts.init(document.getElementById("chart-peaks"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        return echarts.format.encodeHTML(d.names[i]) + "<br>" + echarts.format.encodeHTML(d.region[i]) +
          "<br>" + d.q[i].toLocaleString("he-IL") + " מ״ק בשנייה";
      } },
      grid: { left: 16, right: 48, top: 16, bottom: 32, containLabel: true },
      xAxis: { type: "value", name: "מ״ק בשנייה", min: 0 },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 150, overflow: "truncate" } },
      series: [{ type: "bar", name: "ספיקת שיא", data: d.q,
        label: { show: true, position: "right", fontFamily: "Rubik" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.month | tojson }};
    var c = echarts.init(document.getElementById("chart-month"));
    var mx = Math.max.apply(null, d.n);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v.toLocaleString("he-IL") + " שיאים"; } },
      grid: { left: 40, right: 16, top: 24, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.months, axisLabel: { rotate: 30 } },
      yAxis: { type: "value", name: "שיאים", minInterval: 1 },
      series: [{ type: "bar", name: "שיאי ספיקה", data: d.n.map(function (v) {
        return v === mx ? { value: v, itemStyle: { color: "#0b3668" } } : v;
      }) }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

{%- if model.flags.latest %}
<script>
  (function () {
    var d = {{ model.charts.latest | tojson }};
    var c = echarts.init(document.getElementById("chart-latest"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        var s = echarts.format.encodeHTML(d.names[i]) + "<br>" + d.dates[i] + ": " + d.q[i].toLocaleString("he-IL") + " מ״ק בשנייה";
        if (d.base[i] !== null) s += "<br>חציון רב-שנתי: " + d.base[i].toLocaleString("he-IL");
        return s;
      } },
      legend: { top: 0 },
      grid: { left: 16, right: 24, top: 36, bottom: 32, containLabel: true },
      xAxis: { type: "value", name: "מ״ק בשנייה", min: 0 },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 130, overflow: "truncate" } },
      series: [
        { type: "bar", name: "השנה האחרונה", data: d.q },
        { type: "scatter", name: "חציון רב-שנתי", data: d.base, symbol: "diamond", symbolSize: 12, itemStyle: { color: "#0b3668" } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

<script>
