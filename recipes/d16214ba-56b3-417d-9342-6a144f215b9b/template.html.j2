{%- if model.flags.db %}
<script>
  (function () {
    var d = {{ model.charts.db | tojson }};
    var c = echarts.init(document.getElementById("chart-db"));
    var links = d.names.map(function (n, i) { return [[d.e[i], i], [d.r[i], i]]; });
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        var ch = d.chg[i];
        return echarts.format.encodeHTML(d.names[i]) + "<br>" + d.el + ": " + d.e[i].toLocaleString("he-IL") +
          "<br>" + d.rl + ": " + d.r[i].toLocaleString("he-IL") + "<br>שינוי: " + (ch > 0 ? "+" : "") + ch + "%" +
          (ch <= -d.shift ? " (ירידה חדה)" : (ch >= d.shift ? " (עלייה חדה)" : ""));
      } },
      legend: { top: 0 },
      grid: { left: 16, right: 24, top: 36, bottom: 32, containLabel: true },
      xAxis: { type: "value", name: "מיליון מ״ק", min: 0 },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 130, overflow: "truncate" } },
      series: [
        { type: "lines", coordinateSystem: "cartesian2d", silent: true, data: links.map(function (l) { return { coords: l }; }),
          lineStyle: { color: "#c3cfe7", width: 3, opacity: 1 } },
        { type: "scatter", name: d.el, data: d.e, symbolSize: 12, itemStyle: { color: "#6c757d" } },
        { type: "scatter", name: d.rl, data: d.r, symbolSize: 12, itemStyle: { color: "#0068f5" } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

<script>
  (function () {
    var d = {{ model.charts.region | tojson }};
    var c = echarts.init(document.getElementById("chart-region"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        return echarts.format.encodeHTML(d.names[i]) + "<br>" + (d.zero[i] === null ? "אין נתוני נפח" : d.zero[i] + "% מהשנים ללא זרימה") +
          "<br>חציון ספיקת שיא: " + (d.q[i] === null ? "אין" : d.q[i].toLocaleString("he-IL") + " מ״ק בשנייה") + "<br>" + d.stations[i] + " תחנות";
      } },
      grid: { left: 16, right: 40, top: 16, bottom: 32, containLabel: true },
      xAxis: { type: "value", name: "% שנים ללא זרימה", min: 0 },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 140, overflow: "truncate" } },
      series: [{ type: "bar", name: "שנים ללא זרימה", data: d.zero,
        label: { show: true, position: "right", formatter: function (p) { return p.value + "%"; }, fontFamily: "Rubik" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

{%- if model.flags.flash %}
<script>
