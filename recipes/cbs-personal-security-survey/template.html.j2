{% import "gov.j2" as gov %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסמה {{ model.release.date }}</p>
{%- if model.release.headline %}
  <p class="m-0 mb-3 font-semibold text-ink-deep">{{ model.release.headline }}</p>
{%- endif %}
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

{%- set kpi_labels = {
  "rate": "בני 20 ומעלה שנפגעו מעבירה כלשהי",
  "persons": "נפגעי עבירה בני 20 ומעלה (אלפים)",
  "reported": "מהנפגעים דיווחו למשטרה",
  "household": "משקי בית שנפגעו מעבירות רכוש",
  "safe_dark": "מרגישים בטוחים ללכת לבד בחשכה",
  "fear_terror": "חוששים מטרור באזור המגורים",
} %}
<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["rate", "persons", "reported", "household", "safe_dark", "fear_terror"] %}
{%- if model.kpis[key] is defined %}
  {{ gov.kpi(model.kpis[key], kpi_labels[key] ~ " (סקר " ~ model.labels.latest_year ~ ")") }}
{%- endif %}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

{%- if model.flags.get("types") %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "נפגעי עבירות לפי סוג עבירה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.types_note }}</p>
  {{ gov.chart("chart-types", model.labels.types_aria, "h-72 md:h-96") }}
  {{ gov.table("אחוז בני 20 ומעלה שנפגעו לפי סוג עבירה וסקר", model.labels.types_cols, model.tables.types, ltr=range(1, model.labels.types_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.get("groups") %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "מי נפגע: גברים, נשים וקבוצות אוכלוסייה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.groups_note }}</p>
  {{ gov.chart("chart-groups", model.labels.groups_aria, "h-72 md:h-96") }}
  {{ gov.table("אחוז הנפגעים לפי סוג עבירה וקבוצה", model.labels.groups_cols, model.tables.groups, ltr=range(1, model.labels.groups_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.get("report") %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "דיווח למשטרה לפי סוג עבירה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.report_note }}</p>
  {{ gov.chart("chart-report", model.labels.report_aria, "h-72 md:h-80") }}
  {{ gov.table("דיווח ואי-דיווח למשטרה לפי סוג עבירה", model.labels.report_cols, model.tables.report, ltr=range(1, model.labels.report_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.get("vharm") %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "הנזק שנגרם לנפגעי אלימות") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.vharm_note }}</p>
  {{ gov.chart("chart-vharm", model.labels.vharm_aria, "h-80 md:h-96") }}
  {{ gov.table("סוגי הנזק שנגרם לנפגעי אלימות או איום באלימות", model.labels.vharm_cols, model.tables.vharm, ltr=range(1, model.labels.vharm_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.get("online") %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "עבירות מקוונות לפי סוג") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.online_note }}</p>
  {{ gov.chart("chart-online", model.labels.online_aria, "h-[520px]") }}
  {{ gov.table("נפגעי עבירה מקוונת לפי סוג העבירה", model.labels.online_cols, model.tables.online, ltr=range(1, model.labels.online_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.get("property") %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "עבירות רכוש נגד משקי בית") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.property_note }}</p>
  {{ gov.chart("chart-property", model.labels.property_aria, "h-[520px]") }}
  {{ gov.table("משקי בית שנפגעו מעבירות רכוש לפי סוג עבירה", model.labels.property_cols, model.tables.property, ltr=range(1, model.labels.property_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.get("preport") %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "דיווח למשטרה על עבירות רכוש") }}
  <p class="m-0 text-sm text-subtle mb-3">מתוך משקי הבית שנפגעו מכל סוג עבירת רכוש, כמה דיווחו למשטרה (סקר {{ model.labels.latest_year }}). תא ריק: הנתון אינו מתפרסם בשל מיעוט מקרים.</p>
  {{ gov.chart("chart-preport", model.labels.preport_aria, "h-72 md:h-80") }}
  {{ gov.table("דיווח למשטרה על עבירות רכוש של משק הבית", ["סוג עבירה", "דיווחו למשטרה", "לא דיווחו למשטרה", "שיעור ההיפגעות"], model.tables.preport, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

{%- if model.flags.get("children") %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "ילדים שנפגעו מעבירות") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.children_note }}</p>
  {{ gov.chart("chart-children", model.labels.children_aria, "h-80 md:h-96") }}
  {{ gov.table("משקי בית עם ילדים שילד בהם נפגע מעבירה", model.labels.children_cols, model.tables.children, ltr=range(1, model.labels.children_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.get("safety") %}
<section class="card p-5 mb-6">
  {{ gov.head("circle-check", "תחושת ביטחון אישי באזור המגורים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.safety_note }}</p>
  {{ gov.chart("chart-safety", model.labels.safety_aria, "h-72 md:h-80") }}
  {{ gov.table("תחושת ביטחון אישי לפי מין וקבוצת אוכלוסייה (אחוזים)", model.labels.safety_cols, model.tables.safety, ltr=range(1, model.labels.safety_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.get("fear") %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "חשש מפשיעה, מאלימות ומטרור") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.fear_note }}</p>
  {{ gov.chart("chart-fear", model.labels.fear_aria, "h-72 md:h-80") }}
  {{ gov.table("חשש להיפגע באזור המגורים לפי מין וקבוצת אוכלוסייה (אחוזים)", model.labels.fear_cols, model.tables.fear, ltr=range(1, model.labels.fear_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.get("district") %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "שינוי בתחושת הביטחון לפי מחוז") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.district_note }}</p>
  {{ gov.chart("chart-district", model.labels.district_aria, "h-80 md:h-96") }}
  {{ gov.table("שינוי בתחושת הביטחון לעומת השנה הקודמת לפי מחוז", ["מחוז", "שינוי לרעה", "לא חל שינוי", "שינוי לטובה"], model.tables.district, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

{%- if model.flags.get("district_trend") %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "שינוי לרעה בתחושת הביטחון לאורך הסקרים") }}
  <p class="m-0 text-sm text-subtle mb-3">אחוז המדווחים שתחושת הביטחון שלהם השתנתה לרעה לעומת השנה הקודמת, בכל מחוז ובכל סקר.</p>
  {{ gov.chart("chart-district-trend", model.labels.district_trend_aria, "h-80 md:h-96") }}
  {{ gov.table("אחוז המדווחים על שינוי לרעה לפי מחוז וסקר", model.labels.district_trend_cols, model.tables.district_trend, ltr=range(1, model.labels.district_trend_cols | length) | list) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>הנתונים מתוך ההודעות לתקשורת "ממצאים ראשונים מתוך סקר ביטחון אישי" של הלשכה המרכזית לסטטיסטיקה (הלמ"ס). הסקר נערך בקרב בני 20 ומעלה, ושואל על היפגעות מעבירות בשנה שקדמה לסקר. סקרים בעמוד: {{ model.labels.survey_years }}.</li>
    <li>עבירות רכוש נמדדות ברמת משק הבית. תחושת ביטחון וחשש הם אחוז העונים "במידה רבה" או "במידה רבה מאוד".</li>
    <li>זהו סקר מדגמי: להפרשים קטנים בין סקרים או בין קבוצות עשויה להיות טעות דגימה. נתון שהלמ"ס אינה מפרסמת בשל מיעוט מקרים מופיע כתא ריק.</li>
    <li>התרשימים בהודעה משתנים משנה לשנה. העמוד מציג את התרשימים שבהודעה האחרונה, ומשווה לסקרים קודמים רק במה שהופיע גם בהם.</li>
  </ul>
</section>

<script>
  (function () {
    const pal = window.GOVIL_PALETTE;
    const pct = (v) => v == null ? "לא מתפרסם" : v.toFixed(1) + "%";
    function grouped(id, d, horizontal, colors) {
      const el = document.getElementById(id);
      if (!el) return;
      const chart = echarts.init(el);
      const cat = { type: "category", data: d.x, axisLabel: horizontal ? { width: 130, overflow: "break" } : { interval: 0, width: Math.max(40, Math.floor((el.clientWidth - 60) / d.x.length) - 8), overflow: "break" } };
      const val = { type: "value", splitNumber: 4, axisLabel: { formatter: (v) => v + "%", hideOverlap: true } };
      chart.setOption(window.GovEcharts.option({
        color: colors || [pal[3], pal[1], pal[0], pal[2]],
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: pct },
        legend: { top: 0 },
        grid: { left: 16, right: 24, top: 40, bottom: 16, containLabel: true },
        xAxis: horizontal ? val : cat,
        yAxis: horizontal ? Object.assign({ inverse: true }, cat) : val,
        series: d.series.map((s) => ({ type: "bar", name: s.name, data: s.data, barMaxWidth: 28 }))
      }));
      window.addEventListener("resize", () => chart.resize());
    }
    function stacked(id, d, parts) {
      const el = document.getElementById(id);
      if (!el) return;
      const chart = echarts.init(el);
      chart.setOption(window.GovEcharts.option({
        color: parts.map((p) => p[2]),
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: pct },
        legend: { top: 0 },
        grid: { left: 16, right: 24, top: 40, bottom: 16, containLabel: true },
        xAxis: { type: "value", max: 100, interval: 25, axisLabel: { formatter: (v) => v + "%", hideOverlap: true } },
        yAxis: { type: "category", inverse: true, data: d.x, axisLabel: { width: 130, overflow: "break" } },
        series: parts.map((p) => ({ type: "bar", stack: "s", name: p[1], data: d[p[0]], barMaxWidth: 28 }))
      }));
      window.addEventListener("resize", () => chart.resize());
    }
{%- if model.flags.get("types") %}
    grouped("chart-types", {{ model.charts.types | tojson }}, false);
{%- endif %}
{%- if model.flags.get("groups") %}
    grouped("chart-groups", {{ model.charts.groups | tojson }}, false, [pal[0], pal[2], pal[1], pal[3]]);
{%- endif %}
{%- if model.flags.get("report") %}
    stacked("chart-report", {{ model.charts.report | tojson }}, [["yes", "דיווחו למשטרה", pal[0]], ["no", "לא דיווחו", "#c3cfe7"]]);
{%- endif %}
{%- if model.flags.get("vharm") %}
    grouped("chart-vharm", {{ model.charts.vharm | tojson }}, true);
{%- endif %}
{%- if model.flags.get("online") %}
    grouped("chart-online", {{ model.charts.online | tojson }}, true);
{%- endif %}
{%- if model.flags.get("property") %}
    grouped("chart-property", {{ model.charts.property | tojson }}, true);
{%- endif %}
{%- if model.flags.get("preport") %}
    stacked("chart-preport", {{ model.charts.preport | tojson }}, [["yes", "דיווחו למשטרה", pal[0]], ["no", "לא דיווחו", "#c3cfe7"]]);
{%- endif %}
{%- if model.flags.get("children") %}
    grouped("chart-children", {{ model.charts.children | tojson }}, true, [pal[0], pal[2]]);
{%- endif %}
{%- if model.flags.get("safety") %}
    grouped("chart-safety", {{ model.charts.safety | tojson }}, false, [pal[0], pal[2]]);
{%- endif %}
{%- if model.flags.get("fear") %}
    grouped("chart-fear", {{ model.charts.fear | tojson }}, false, [pal[1], pal[3]]);
{%- endif %}
{%- if model.flags.get("district") %}
    stacked("chart-district", {{ model.charts.district | tojson }}, [["worse", "שינוי לרעה", "#dc3545"], ["same", "לא חל שינוי", "#c3cfe7"], ["better", "שינוי לטובה", "#198754"]]);
{%- endif %}
{%- if model.flags.get("district_trend") %}
    grouped("chart-district-trend", {{ model.charts.district_trend | tojson }}, true);
{%- endif %}
  })();
</script>
