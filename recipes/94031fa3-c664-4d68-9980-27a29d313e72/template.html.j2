<script>
  (function () {
    var d = {{ model.charts.years | tojson }};
    var c = echarts.init(document.getElementById("chart-years"));
    var series = d.series.map(function (s) { return { type: "bar", stack: "s", name: s.name, data: s.data }; });
    series.push({ type: "line", name: "שיעור הממתינות לרישום", yAxisIndex: 1, data: d.pend, connectNulls: false,
      itemStyle: { color: "#9a6700" }, lineStyle: { color: "#9a6700" } });
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: [
        { type: "value", name: "תוכניות", minInterval: 1 },
        { type: "value", name: "% ממתינות", min: 0, max: 100, splitLine: { show: false } }
      ],
      series: series
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var el = document.getElementById("chart-muni");
    if (!el) { return; }
    var d = {{ model.charts.muni | tojson }};
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + " תוכניות"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 40, containLabel: true },
      xAxis: { type: "value", name: "תוכניות", minInterval: 1 },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 130, overflow: "truncate" } },
      series: d.series.map(function (s) { return { type: "bar", stack: "s", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

