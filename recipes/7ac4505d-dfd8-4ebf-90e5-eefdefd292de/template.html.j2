{% import "gov.j2" as gov %}
{%- macro rtable(caption, cols, rows, ltr=()) -%}
<details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ caption }}</caption>
        <thead><tr>{% for c in cols %}<th scope="col">{{ c }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in rows %}
          <tr>{% for v in r %}{% if loop.first %}<th scope="row"{% if 0 in ltr %} dir="ltr"{% endif %}>{{ v }}</th>{% else %}<td{% if loop.index0 in ltr %} dir="ltr"{% endif %}>{{ v }}</td>{% endif %}{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
{%- endmacro %}
<h1>תאונות דרכים לפי רשות מקומית ויישוב</h1>

{{ gov.lede(model.agent_data.summary_he) }}

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור נתוני תאונות דרכים בעיר, במועצה או ביישוב ←</span>
    <span class="block text-sm text-subtle">{{ model.labels.lookup_note }}</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
  {{ gov.kpi(model.kpis.acc, model.labels.acc_kpi) }}
  {{ gov.kpi(model.kpis.inj, "נפגעים (הרוגים ופצועים)") }}
  {{ gov.kpi(model.kpis.dead, "הרוגים") }}
  {{ gov.kpi(model.kpis.severe, "פצועים קשה") }}
  {{ gov.kpi(model.kpis.dead1000, model.labels.dead1000_kpi) }}
  {{ gov.kpi(model.kpis.auth, model.labels.auth_kpi) }}
</div>

{{ gov.insights(model.insights) }}

{%- if model.flags.map %}
<section class="card p-5 mb-6">
  {{ gov.head("map-pin", "מפת התאונות לפי רשות") }}
  <p class="m-0 mb-3 text-sm text-subtle">{{ model.labels.map_lede }}</p>
  <div id="map-muni" class="h-96 md:h-[560px]" role="region" aria-label="{{ model.labels.map_aria }}" data-fallback="explorer"></div>
  <div class="mt-3 text-sm text-subtle">
    <span class="font-semibold">{{ model.labels.map_legend }}</span>
    <ul id="map-legend" class="flex flex-wrap gap-x-4 gap-y-1 mt-1 mb-0 ps-0 list-none"></ul>
  </div>
</section>
{%- for chunk in model.charts.map.chunks %}
<script type="application/json" id="map-pts-{{ loop.index0 }}">{{ chunk | tojson }}</script>
{%- endfor %}
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("database", "הרשויות עם הכי הרבה תאונות") }}
  <p class="m-0 mb-3 text-sm text-subtle">{{ model.labels.top_acc_lede }}</p>
  {{ gov.chart("chart-top-acc", model.labels.top_acc_aria, h="h-[30rem] md:h-[480px]") }}
  {{ rtable(model.labels.top_acc_aria, ["דירוג", "רשות", "סוג רשות", "תאונות", "הרוגים", "פצועים קשה"], model.tables.top_acc, ltr=(3, 4, 5)) }}
</section>

{%- if model.flags.dead %}
<section class="card p-5 mb-6">
  {{ gov.head("triangle-alert", "הרשויות עם הכי הרבה הרוגים") }}
  <p class="m-0 mb-3 text-sm text-subtle">{{ model.labels.top_dead_lede }}</p>
  {{ gov.chart("chart-top-dead", model.labels.top_dead_aria, h="h-[30rem] md:h-[480px]") }}
  {{ rtable(model.labels.top_dead_aria, ["דירוג", "רשות", "הרוגים", "תאונות", model.labels.col_dead1000], model.tables.top_dead, ltr=(2, 3, 4)) }}
</section>
{%- endif %}

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
