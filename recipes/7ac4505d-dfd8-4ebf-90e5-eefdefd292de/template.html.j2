<section class="card p-5 mb-6">
  {{ gov.head("list", "תיאור מקורי") }}
  <p class="m-0 text-sm text-subtle whitespace-pre-line">תאונות דרכים, שנחקרו על ידי המשטרה, ונאספו על ידי הלמ"ס (מאגרים: ת.ד. מורחב וכללי), בחמשת השנים האחרונות. מיפוי בכל הרמות וסכימה לפי שטח רשות מוניציפלית.</p>
</section>

<script>
  (function () {
    var esc = function (s) { return echarts.format.encodeHTML(String(s)); };
    var num = function (v) { return Number(v).toLocaleString("he-IL"); };
    var short = function (s) { s = String(s); return s.length > 22 ? s.slice(0, 21) + "…" : s; };
    window.AccMuni = {
      esc: esc, num: num,
      hbar: function (id, names, series, o) {
        var el = document.getElementById(id);
        if (!el || !window.echarts) { return; }
        o = o || {};
        var c = echarts.init(el);
        var unit = o.unit || "";
        var s = series.map(function (x, i) {
          var out = { name: x.name, type: "bar", data: x.data, barMaxWidth: 22, itemStyle: { color: x.color } };
          if (i > 0 && o.overlay) { out.barGap = "-100%"; }
          if (i === 0 && o.mark != null) {
            out.markLine = { symbol: "none", silent: true, lineStyle: { color: "#dc3545", type: "dashed" },
              label: { formatter: o.markLabel || "", color: "#dc3545", fontFamily: "Rubik" }, data: [{ xAxis: o.mark }] };
          }
          return out;
        });
        c.setOption(window.GovEcharts.option({
          color: window.GOVIL_PALETTE,
          legend: series.length > 1 ? { top: 0, textStyle: { fontFamily: "Rubik" } } : undefined,
          tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
            var lines = ["<strong>" + esc(ps[0].name) + "</strong>"];
            ps.forEach(function (p) { lines.push(esc(p.seriesName) + ": " + num(p.value) + unit); });
            if (o.extra) { lines.push(esc(o.extra.label) + ": " + num(o.extra.data[ps[0].dataIndex])); }
            return lines.join("<br>");
          } },
          grid: { left: 8, right: 16, top: series.length > 1 ? 32 : 8, bottom: 24, containLabel: true },
          xAxis: { type: "value", splitNumber: 3, axisLabel: { formatter: function (v) { return num(v) + unit; } } },
          yAxis: { type: "category", inverse: true, data: names,
            axisLabel: { interval: 0, fontSize: 11, formatter: short, width: el.clientWidth < 520 ? 110 : 200, overflow: "truncate" } },
          series: s
        }));
        window.addEventListener("resize", function () { c.resize(); });
      }
    };
  })();
</script>

{%- if model.flags.map %}
<script>
  (function () {
    var el = document.getElementById("map-muni");
    if (!el || !window.L) { return; }
    var meta = {{ {"n": model.charts.map.chunks | length, "bounds": model.charts.map.bounds, "classes": model.charts.map.classes, "unit": model.labels.sev_unit} | tojson }};
    var colors = ["#9aa5b1", "#a9c8f5", "#4d8ff0", "#0b3668", "#dc3545"];
    var pts = [];
    for (var i = 0; i < meta.n; i++) {
      var node = document.getElementById("map-pts-" + i);
      if (node) { pts = pts.concat(JSON.parse(node.textContent)); }
    }
    var max = 1;
    pts.forEach(function (p) { if (p[3] > max) { max = p[3]; } });
    var maxR = el.clientWidth < 520 ? Math.max(8, el.clientWidth / 22) : 26;
    pts.sort(function (a, b) { return b[3] - a[3]; });
    var map = L.map(el, { scrollWheelZoom: false, zoomSnap: 0.25 });
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 18, attribution: "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>" }).addTo(map);
    pts.forEach(function (p) {
      var m = L.circleMarker([p[0], p[1]], {
        radius: 2 + maxR * Math.sqrt(p[3] / max), color: "#ffffff", weight: 0.75,
        fillColor: colors[p[7]] || colors[0], fillOpacity: 0.8
      }).addTo(map);
      var box = document.createElement("div");
      var t = document.createElement("strong");
      t.textContent = p[2];
      box.appendChild(t);
      [["תאונות", p[3].toLocaleString("he-IL")], ["הרוגים", p[4].toLocaleString("he-IL")],
       ["פצועים קשה", p[5].toLocaleString("he-IL")], ["הרוגים ופצועים קשה", p[6] + " " + meta.unit]].forEach(function (r) {
        var d = document.createElement("div");
        d.textContent = r[0] + ": " + r[1];
        box.appendChild(d);
      });
      m.bindPopup(box);
    });
    if (meta.bounds.length) { map.fitBounds(meta.bounds, { padding: [10, 10] }); }
    var legend = document.getElementById("map-legend");
    meta.classes.forEach(function (label, i) {
      var li = document.createElement("li");
      li.className = "flex items-center gap-2";
      var sw = document.createElement("span");
      sw.style.cssText = "display:inline-block;width:12px;height:12px;border-radius:50%;background:" + colors[i];
      li.appendChild(sw);
      li.appendChild(document.createTextNode(label));
      legend.appendChild(li);
    });
  })();
</script>
{%- endif %}

<script>
  (function () {
    var d = {{ model.charts.top_acc | tojson }};
    window.AccMuni.hbar("chart-top-acc", d.names, [
      { name: "תאונות", data: d.acc, color: "#0068f5" },
      { name: "הרוגים ופצועים קשה", data: d.ds, color: "#0b3668" }
    ], { overlay: true });
  })();
</script>

{%- if model.flags.dead %}
<script>
  (function () {
    var d = {{ model.charts.top_dead | tojson }};
    window.AccMuni.hbar("chart-top-dead", d.names, [{ name: "הרוגים", data: d.dead, color: "#0b3668" }],
      { extra: { label: "תאונות", data: d.acc } });
  })();
</script>
{%- endif %}

{%- if model.flags.sev %}
<script>
  (function () {
    var d = {{ model.charts.sev | tojson }};
    var lbl = {{ model.labels.col_sev | tojson }};
    window.AccMuni.hbar("chart-sev", d.names, [{ name: lbl, data: d.vals, color: "#0068f5" }],
      { mark: d.nat, markLabel: "ממוצע", extra: { label: "תאונות", data: d.acc } });
  })();
</script>
{%- endif %}

{%- if model.flags.dens %}
<script>
  (function () {
    var d = {{ model.charts.dens | tojson }};
    window.AccMuni.hbar("chart-dens", d.names, [{ name: "תאונות לקמ״ר", data: d.vals, color: "#0068f5" }],
      { extra: { label: "תאונות", data: d.acc } });
  })();
</script>
{%- endif %}

{%- if model.flags.scatter %}
<script>
  (function () {
    var el = document.getElementById("chart-scatter");
    if (!el || !window.echarts) { return; }
    var groups = {{ model.charts.scatter | tojson }};
    var lbl = {{ model.labels.col_sev | tojson }};
    var max = 1;
    groups.forEach(function (g) { g.data.forEach(function (p) { if (p[2] > max) { max = p[2]; } }); });
    var esc = window.AccMuni.esc, num = window.AccMuni.num;
    var scol = ["#0068f5", "#0b3668", "#6c9fd8", "#ffc107", "#6c757d", "#b7d2f7", "#dc3545"];
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: scol,
      legend: { top: 0, type: "scroll", textStyle: { fontFamily: "Rubik" } },
      tooltip: { trigger: "item", formatter: function (p) {
        return "<strong>" + esc(p.value[3]) + "</strong><br>" + esc(p.seriesName) +
          "<br>תאונות: " + num(p.value[2]) + "<br>תאונות לקמ״ר: " + num(p.value[0]) + "<br>" + esc(lbl) + ": " + num(p.value[1]);
      } },
      grid: { left: 8, right: 24, top: 48, bottom: 32, containLabel: true },
      xAxis: { type: "log", name: "תאונות לקמ״ר", nameLocation: "middle", nameGap: 26, axisLabel: { formatter: function (v) { return num(v); } } },
      yAxis: { type: "value", name: lbl, nameTextStyle: { align: "right" } },
      series: groups.map(function (g, gi) {
        return { name: g.name, type: "scatter", data: g.data, itemStyle: { opacity: 0.75, color: scol[gi % scol.length] },
          symbolSize: function (v) { return 5 + 28 * Math.sqrt(v[2] / max); } };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

<script>
  (function () {
    var el = document.getElementById("chart-types");
    if (!el || !window.echarts) { return; }
    var d = {{ model.charts.types | tojson }};
    var esc = window.AccMuni.esc;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: ["#0068f5", "#dc3545"],
      legend: { top: 0, textStyle: { fontFamily: "Rubik" } },
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex;
        return "<strong>" + esc(ps[0].name) + "</strong><br>" + ps.map(function (p) { return esc(p.seriesName) + ": " + p.value + "%"; }).join("<br>") +
          "<br>" + esc({{ model.labels.col_dead1000 | tojson }}) + ": " + d.dead1000[i];
      } },
      grid: { left: 8, right: 16, top: 32, bottom: 24, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", inverse: true, data: d.names, axisLabel: { interval: 0, fontSize: 11, width: el.clientWidth < 520 ? 100 : 160, overflow: "truncate" } },
      series: [
        { name: "נתח מהתאונות", type: "bar", data: d.acc_share, barMaxWidth: 18 },
        { name: "נתח מההרוגים", type: "bar", data: d.dead_share, barMaxWidth: 18 }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var el = document.getElementById("chart-districts");
    if (!el || !window.echarts) { return; }
    var d = {{ model.charts.districts | tojson }};
    var lbl = {{ model.labels.col_sev | tojson }};
    var esc = window.AccMuni.esc, num = window.AccMuni.num;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      legend: { top: 0, textStyle: { fontFamily: "Rubik" } },
      tooltip: { trigger: "axis", formatter: function (ps) {
        return "<strong>" + esc(ps[0].name) + "</strong><br>" + ps.map(function (p) { return esc(p.seriesName) + ": " + num(p.value); }).join("<br>");
      } },
      grid: { left: 8, right: 8, top: 40, bottom: 8, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, rotate: 40, fontSize: 11, formatter: function (s) { return s.length > 12 ? s.slice(0, 11) + "…" : s; } } },
      yAxis: [{ type: "value", splitNumber: 4 }, { type: "value", splitNumber: 4, splitLine: { show: false } }],
      series: [
        { name: "תאונות", type: "bar", data: d.acc, barMaxWidth: 28 },
        { name: lbl, type: "line", yAxisIndex: 1, data: d.sev, itemStyle: { color: "#dc3545" }, lineStyle: { color: "#dc3545" } }
      ]
    }));
