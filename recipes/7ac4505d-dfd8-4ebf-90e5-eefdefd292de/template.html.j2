{%- if model.flags.shares %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "מי נפגע איפה: הולכי רגל, דו-גלגלי חשמלי, ילדים ומבוגרים") }}
  <p class="m-0 mb-3 text-sm text-subtle">{{ model.labels.shares_lede }}</p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
{%- for key in ["ped", "elec", "kids", "seniors"] %}
