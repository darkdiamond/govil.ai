  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">ספריית מילונים זו מהווה את הטרמינולוגיה האחודה לערכים הנוגעים ליישות אדם. בספרייה זו ניתן למצוא את מבנה רשומת הנתונים המרכזית וכן אוסף מילונים המכילים את הערכים הרלוונטיים לנתונים שברשומה זו.

מילון (code lists או list of values) הוא רשימת ערכים וסיווגים אחידה. מילוני הקוד עבור היישות אדם מרכזים ערכים סטנדרטיים ואחידים לתיאור מאפיינים שונים של פרטים באוכלוסייה, כגון מאפיינים דמוגרפיים, סטטוסים מנהליים, שיוכים גיאוגרפיים ומאפייני חיים נוספים.

מילונים אלו נועדו לייצר שפה משותפת בין גופים ממשלתיים ובמגזר הציבורי בכללותו, וכן בין מגזרים, לאפשר אינטגרציה בין מערכות ולתמוך בניתוחים סטטיסטיים ותפעוליים על בסיס נתונים עקבי ואיכותי. השימוש במילונים יאפשר אחידות בהגדרות, יקטין כפילויות וחוסר התאמה, ויתרום לשיפור קבלת ההחלטות והתכנון. הספרייה מסומנת על ידי המפרסם כגרסה בהרצה.</p>
</section>

<script>
  (function () {
    function hbar(id, d, opts) {
      opts = opts || {};
      var el = document.getElementById(id);
      if (!el) return;
      var chart = echarts.init(el);
      chart.setOption(window.GovEcharts.option({
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 16, right: 48, top: 16, bottom: 24, containLabel: true },
        xAxis: opts.log ? { type: "log", min: 1, logBase: 10 } : { type: "value", minInterval: 1 },
        yAxis: { type: "category", data: d.names, inverse: true,
                 axisLabel: { width: opts.labelWidth || 130, overflow: "truncate" } },
        series: [{ type: "bar", name: opts.name || "", data: d.values,
                   label: { show: true, position: "right" } }]
      }));
      window.addEventListener("resize", function () { chart.resize(); });
    }
    function donut(id, data) {
      var el = document.getElementById(id);
      if (!el) return;
      var chart = echarts.init(el);
      chart.setOption(window.GovEcharts.option({
        tooltip: { trigger: "item", formatter: "{b}: {c} ({d}%)" },
        legend: { bottom: 0, type: "scroll" },
        series: [{ type: "pie", radius: ["40%", "68%"], center: ["50%", "44%"],
                   label: { formatter: "{c}" }, data: data }]
      }));
      window.addEventListener("resize", function () { chart.resize(); });
    }

    hbar("chart-dicts", {{ model.charts.dicts | tojson }}, { log: true, name: "ערכים", labelWidth: 140 });

    (function () {
      var d = {{ model.charts.categories | tojson }};
      var chart = echarts.init(document.getElementById("chart-categories"));
      chart.setOption(window.GovEcharts.option({
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { top: 0 },
        grid: { left: 16, right: 24, top: 36, bottom: 24, containLabel: true },
        xAxis: { type: "value", minInterval: 1 },
        yAxis: { type: "category", data: d.names, inverse: true,
                 axisLabel: { width: 140, overflow: "truncate" } },
        series: [
          { type: "bar", stack: "f", name: "מקושרים למילון", data: d.linked, itemStyle: { color: "#0068f5" } },
          { type: "bar", stack: "f", name: "שדות חופשיים", data: d.free, itemStyle: { color: "#c3cfe7" } }
        ]
      }));
      window.addEventListener("resize", function () { chart.resize(); });
    })();

    donut("chart-kinds", {{ model.charts.kinds | tojson }});
    hbar("chart-reuse", {{ model.charts.reuse | tojson }}, { name: "שדות", labelWidth: 120 });

    (function () {
      var d = {{ model.charts.continents | tojson }};
      var chart = echarts.init(document.getElementById("chart-continents"));
      chart.setOption(window.GovEcharts.option({
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { top: 0 },
        grid: { left: 16, right: 16, top: 36, bottom: 24, containLabel: true },
        xAxis: { type: "category", data: d.names },
        yAxis: { type: "value", minInterval: 1, name: "ארצות" },
        series: [
          { type: "bar", name: "לפי רשות האוכלוסין", data: d.admin, itemStyle: { color: "#0068f5" } },
          { type: "bar", name: "לפי הגיאוגרפיה", data: d.geo, itemStyle: { color: "#0b3668" } }
        ]
      }));
      window.addEventListener("resize", function () { chart.resize(); });
    })();

    hbar("chart-systems", {{ model.charts.systems | tojson }}, { name: "ארצות", labelWidth: 150 });
    hbar("chart-splits", {{ model.charts.splits | tojson }}, { name: "ארצות", labelWidth: 130 });

    (function () {
      var d = {{ model.charts.loc | tojson }};
      var chart = echarts.init(document.getElementById("chart-loc"));
      chart.setOption(window.GovEcharts.option({
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { top: 0, type: "scroll" },
        grid: { left: 16, right: 24, top: 40, bottom: 24, containLabel: true },
        xAxis: { type: "value", minInterval: 1 },
        yAxis: { type: "category", data: d.districts, inverse: true },
        series: d.series.map(function (s) {
          return { type: "bar", stack: "loc", name: s.name, data: s.data };
        })
      }));
      window.addEventListener("resize", function () { chart.resize(); });
    })();

    donut("chart-authorities", {{ model.charts.authorities | tojson }});
    hbar("chart-councils", {{ model.charts.councils | tojson }}, { name: "יישובים", labelWidth: 110 });
    hbar("chart-neigh", {{ model.charts.neigh | tojson }}, { name: "שכונות", labelWidth: 110 });
    hbar("chart-stypes", {{ model.charts.stypes | tojson }}, { name: "שמות", labelWidth: 130 });
    hbar("chart-snames", {{ model.charts.snames | tojson }}, { name: "הופעות", labelWidth: 100 });
    hbar("chart-prof", {{ model.charts.prof | tojson }}, { name: "מקצועות", labelWidth: 150 });
    hbar("chart-inst", {{ model.charts.inst | tojson }}, { name: "מוסדות", labelWidth: 130 });
  })();
</script>
