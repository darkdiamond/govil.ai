{%- macro stack_table(ch, caption, first_col) -%}
  <details class="mt-3">
    <summary class="text-sm text-subtle cursor-pointer">הצג כטבלה</summary>
    <div class="relative overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ caption }}</caption>
        <thead>
          <tr>
            <th scope="col" class="text-start">{{ first_col }}</th>
{%- for o in ch.owners %}
            <th scope="col" class="text-start">{{ o }}</th>
{%- endfor %}
            <th scope="col" class="text-start">סך הכול</th>
          </tr>
        </thead>
        <tbody>
{%- for c in ch.cats %}
{%- set j = loop.index0 %}
          <tr>
            <th scope="row" class="text-start font-normal">{{ c }}</th>
{%- for o in ch.owners %}
            <td>{{ ch.counts[loop.index0][j] | fmt_int }} <span class="text-subtle">({{ ch.shares[loop.index0][j] }}%)</span></td>
{%- endfor %}
            <td>{{ ch.totals[j] | fmt_int }}</td>
          </tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
{%- endmacro -%}

<h1>סוג בעלות בנכסים הרשומים בפנקסי המקרקעין (טאבו)</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 mb-2 text-subtle leading-relaxed">{{ model.agent_data.summary_he }}</p>
  <p class="m-0 text-sm text-subtle leading-relaxed">המאגר של רשם המקרקעין במשרד המשפטים מסווג כל נכס הרשום בפנקסי המקרקעין (לשכות רישום המקרקעין, הטאבו) לפי סוג הבעלות: פרטית, מדינה, רשות מקומית, מעורבת או אחרת. נכס הוא חלקה שלמה או תת-חלקה, כלומר יחידה בבית משותף. הסיווג אינו נסח טאבו ואינו קובע זכות כלשהי בנכס.</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">בדיקת סוג הבעלות בנכס לפי גוש וחלקה ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: גוש, חלקה, תת חלקה, תיאור שיטה וסוג בעלות</span>
  </span>
</a>

