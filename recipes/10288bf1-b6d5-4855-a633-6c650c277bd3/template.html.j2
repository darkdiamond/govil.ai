האמור לקוח מתוך מאפיינים שנקבעו בהתאם לטבלת סיווג, אין במידע המפורסם האמור באתר data.gov, כדי לקבוע זכות כלשהי בדבר הבעלות או ההערה התכנונית הנחזים כאן.</p>
</section>

<script>
  (function () {
    var enc = echarts.format.encodeHTML;
    function fmt(v) { return Number(v).toLocaleString("he-IL"); }
    function pctStack(id, ch) {
      var el = document.getElementById(id);
      if (!el) { return; }
      var c = echarts.init(el);
      var series = ch.owners.map(function (o, i) {
        return { type: "bar", stack: "s", name: o, data: ch.shares[i], barMaxWidth: 36 };
      });
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: {
          trigger: "axis", axisPointer: { type: "shadow" },
          formatter: function (ps) {
            if (!ps.length) { return ""; }
            var j = ps[0].dataIndex;
            var out = "<b>" + enc(ch.cats[j]) + "</b> (" + fmt(ch.totals[j]) + " נכסים)";
            ps.forEach(function (p) {
              out += "<br/>" + p.marker + enc(p.seriesName) + ": " + fmt(ch.counts[p.seriesIndex][j]) + " (" + p.value + "%)";
            });
            return out;
          }
        },
        legend: { bottom: 0, type: "scroll" },
        grid: { left: 16, right: 8, top: 8, bottom: 40, containLabel: true },
        xAxis: { type: "value", max: 100, inverse: true, axisLabel: { formatter: "{value}%" } },
        yAxis: { type: "category", data: ch.cats, inverse: true, position: "right", axisLabel: { width: 120, overflow: "truncate" } },
        series: series
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    pctStack("chart-unit", {{ model.charts.unit | tojson }});
    pctStack("chart-size-own", {{ model.charts.size_own | tojson }});
    pctStack("chart-bands", {{ model.charts.bands | tojson }});
    pctStack("chart-method", {{ model.charts.method | tojson }});
  })();

  (function () {
    var enc = echarts.format.encodeHTML;
    function fmt(v) { return Number(v).toLocaleString("he-IL"); }
    var ch = {{ model.charts.top | tojson }};
    var el = document.getElementById("chart-top");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: {
        trigger: "axis", axisPointer: { type: "shadow" },
        formatter: function (ps) {
          if (!ps.length) { return ""; }
          var j = ps[0].dataIndex;
          var out = "<b>" + enc(ch.cats[j]) + "</b> (" + fmt(ch.totals[j]) + " נכסים)";
          ps.forEach(function (p) {
            out += "<br/>" + p.marker + enc(p.seriesName) + ": " + fmt(p.value) + " (" + ch.shares[p.seriesIndex][j] + "%)";
          });
          return out;
        }
      },
      legend: { bottom: 0, type: "scroll" },
      grid: { left: 16, right: 8, top: 8, bottom: 40, containLabel: true },
      xAxis: { type: "value", inverse: true },
      yAxis: { type: "category", data: ch.cats, inverse: true, position: "right" },
      series: ch.owners.map(function (o, i) {
        return { type: "bar", stack: "s", name: o, data: ch.counts[i], barMaxWidth: 28 };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();

  (function () {
    var enc = echarts.format.encodeHTML;
    function fmt(v) { return Number(v).toLocaleString("he-IL"); }
    var d = {{ model.charts.owners | tojson }};
    var el = document.getElementById("chart-owners");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: {
        trigger: "item",
        formatter: function (p) {
          return enc(p.name) + ": " + fmt(p.value) + " (" + d.shares[p.dataIndex] + "%)";
        }
      },
      legend: { bottom: 0, type: "scroll" },
      series: [{
        type: "pie", radius: ["40%", "68%"], center: ["50%", "45%"],
        label: { formatter: function (p) { return p.name + "\n" + d.shares[p.dataIndex] + "%"; } },
        data: d.names.map(function (n, i) { return { name: n, value: d.nums[i] }; })
      }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();

  (function () {
    var enc = echarts.format.encodeHTML;
    function fmt(v) { return Number(v).toLocaleString("he-IL"); }
    function vbar(id, cats, values, unit, rotate) {
      var el = document.getElementById(id);
      if (!el) { return; }
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: {
          trigger: "axis", axisPointer: { type: "shadow" },
          formatter: function (ps) { return enc(ps[0].name) + ": " + fmt(ps[0].value) + " " + unit; }
        },
        grid: { left: 16, right: 16, top: 16, bottom: 8, containLabel: true },
        xAxis: { type: "category", data: cats, inverse: true, axisLabel: { interval: 0, rotate: rotate, width: 90, overflow: "break" } },
        yAxis: { type: "value", position: "right" },
        series: [{ type: "bar", name: unit, data: values, barMaxWidth: 40 }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    var s = {{ model.charts.size | tojson }};
    vbar("chart-size", s.cats, s.nums, "בתים משותפים", 0);
    var m = {{ model.charts.mix | tojson }};
    vbar("chart-mix", m.cats, m.nums, "בתים משותפים", 0);

    var b = {{ model.charts.blocks | tojson }};
    var el = document.getElementById("chart-blocks");
    if (el) {
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option({
        color: [window.GOVIL_PALETTE[0], window.GOVIL_PALETTE[1]],
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { bottom: 0 },
        grid: { left: 16, right: 16, top: 16, bottom: 40, containLabel: true },
        xAxis: { type: "category", data: b.names, inverse: true, axisLabel: { interval: 0 } },
        yAxis: { type: "value", position: "right" },
        series: [
          { type: "bar", name: "גושים שבהם זה הסוג המוביל", data: b.dominant, barMaxWidth: 32 },
          { type: "bar", name: "גושים הומוגניים (סוג אחד בלבד)", data: b.homogeneous, barMaxWidth: 32 }
        ]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
  })();
</script>
