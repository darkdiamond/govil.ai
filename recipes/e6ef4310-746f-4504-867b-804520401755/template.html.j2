{% if model.flags.inspections %}
<script>
  (function () {
    var d = {{ model.charts.inspections | tojson }};
    var c = echarts.init(document.getElementById("chart-inspections"));
    var last = d.y.length - 1;
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { fontSize: 11, hideOverlap: true } },
      yAxis: { type: "value", splitNumber: 4, minInterval: 1 },
      series: [{ type: "bar", name: "שורות שנבדקו", data: d.y.map(function (v, i) {
        return (d.partial && i === last) ? { value: v, itemStyle: { color: "#b7d2f7" } } : v;
      }), itemStyle: { color: "#0068f5" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{% endif %}
