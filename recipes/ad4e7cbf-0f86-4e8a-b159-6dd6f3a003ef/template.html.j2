<script>
  (function () {
    function mk(id, opt) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option(Object.assign({ color: window.GOVIL_PALETTE }, opt)));
      window.addEventListener("resize", function () { c.resize(); });
    }
    var y = {{ model.charts.years | tojson }};
    mk("chart-years", {
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 48, right: 16, top: 24, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: y.x },
      yAxis: { type: "value", name: "הכרעות" },
      series: y.series.map(function (s) { return { type: "bar", stack: "t", name: s.name, data: s.data }; })
    });
    var m = {{ model.charts.monthly | tojson }};
    mk("chart-monthly", {
      tooltip: { trigger: "axis" },
      legend: { top: 0 },
      grid: { left: 48, right: 16, top: 40, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: m.x },
      yAxis: { type: "value" },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 20 }],
      series: [
        { type: "bar", name: "הכרעות בחודש", data: m.y },
        { type: "line", name: "ממוצע נע שנתי", data: m.roll, showSymbol: false, lineStyle: { width: 2.5 } }
      ]
    });
    var s = {{ model.charts.season | tojson }};
    mk("chart-season", {
      tooltip: { trigger: "axis" },
      grid: { left: 48, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: s.x, axisLabel: { interval: 0, rotate: 45 } },
      yAxis: { type: "value", name: "ממוצע לחודש" },
      series: [{ type: "bar", name: "ממוצע הכרעות", data: s.y }]
    });
    var c = {{ model.charts.claims | tojson }};
    mk("chart-claims", {
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 40, right: 16, top: 24, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: c.x },
      yAxis: { type: "value", name: "הכרעות" },
      series: c.series.map(function (x) { return { type: "bar", stack: "t", name: x.name, data: x.data }; })
    });
  })();
</script>

<script>
  (function () {
    function hbar(id, d, name) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis" },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true },
        series: [{ type: "bar", name: name, data: d.values }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    hbar("chart-committees", {{ model.charts.committees | tojson }}, "הכרעות");
    hbar("chart-appraisers", {{ model.charts.appraisers | tojson }}, "הכרעות");

    var h = {{ model.charts.heat | tojson }};
    var c4 = echarts.init(document.getElementById("chart-heat"));
    c4.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return h.y[p.value[1]] + " · " + h.x[p.value[0]] + ": " + p.value[2].toLocaleString("he-IL");
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true } },
      yAxis: { type: "category", data: h.y, inverse: true, splitArea: { show: true } },
      visualMap: {
        min: 0, max: h.max, calculable: true, dimension: 2,
        orient: "horizontal", left: "center", bottom: 8,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells,
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c4.resize(); });
  })();
</script>

<script>
  (function () {
    function mk(id, opt) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option(Object.assign({ color: window.GOVIL_PALETTE }, opt)));
      window.addEventListener("resize", function () { c.resize(); });
    }
    var k = {{ model.charts.cohorts | tojson }};
    function ramp(n) {
      var a = [195, 217, 251], b = [11, 54, 104], out = [];
      for (var i = 0; i < n; i++) {
        var t = n > 1 ? i / (n - 1) : 1;
        out.push("rgb(" + a.map(function (v, j) { return Math.round(v + (b[j] - v) * t); }).join(",") + ")");
      }
      return out;
    }
    mk("chart-cohorts", {
      color: ramp(k.series.length),
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 48, right: 16, top: 24, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: k.x },
      yAxis: { type: "value", name: "הכרעות" },
      series: k.series.map(function (x) { return { type: "bar", stack: "t", name: x.name, data: x.data }; })
    });
    var a = {{ model.charts.active | tojson }};
    mk("chart-active", {
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 40, right: 40, top: 32, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: a.x },
      yAxis: [{ type: "value", name: "שמאים" }, { type: "value", name: "הכרעות לשמאי", splitLine: { show: false } }],
      series: [
        { type: "bar", name: "שמאים פעילים", data: a.active },
        { type: "line", name: "הכרעות לשמאי", yAxisIndex: 1, data: a.per, connectNulls: true }
      ]
    });
    var l = {{ model.charts.lag | tojson }};
    mk("chart-lag", {
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v.toLocaleString("he-IL") + " ימים"; } },
      legend: { bottom: 0 },
      grid: { left: 48, right: 40, top: 24, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: l.x, axisLabel: { hideOverlap: true } },
      yAxis: { type: "value", name: "ימים" },
      series: [
        { type: "line", name: "חציון", data: l.med },
        { type: "line", name: "רבעון עליון", data: l.p75, lineStyle: { type: "dashed" } }
      ]
    });
    var d = {{ model.charts.lagdist | tojson }};
    mk("chart-lagdist", {
      tooltip: { trigger: "axis" },
      grid: { left: 48, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { interval: 0, rotate: 30 } },
      yAxis: { type: "value", name: "הכרעות" },
      series: [{ type: "bar", name: "הכרעות", data: d.y }]
    });
    var p = {{ model.charts.corp | tojson }};
    mk("chart-corp", {
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      grid: { left: 40, right: 40, top: 24, bottom: 32, containLabel: true },
      xAxis: { type: "category", data: p.x, axisLabel: { hideOverlap: true } },
      yAxis: { type: "value", name: "%", min: 0 },
      series: [{ type: "line", name: "שיעור תאגידים", data: p.y, areaStyle: { opacity: 0.15 } }]
    });
  })();
</script>
