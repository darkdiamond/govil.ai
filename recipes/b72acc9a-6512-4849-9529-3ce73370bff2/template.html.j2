<h1>רשימת מוהלים ארצית</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור מוהל לפי יישוב או שם ←</span>
    <span class="block text-sm text-subtle">חיפוש חי ברשימה הארצית: שם פרטי, שם משפחה או יישוב</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">מוהלים ברשימה</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.cities.tone }} mb-1" dir="ltr">{{ model.kpis.cities.display }}</div>
    <div class="text-sm text-subtle">ישובים</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.top_city.tone }} mb-1" dir="ltr">{{ model.kpis.top_city.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.top_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.peak.tone }} mb-1" dir="ltr">{{ model.kpis.peak.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.peak_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מוהלים לפי ישוב</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cities_note }}</p>
  <div id="chart-cities" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.cities_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.cities_caption }}</caption>
      <thead><tr><th scope="col">ישוב</th><th scope="col">מוהלים</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.cities %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
<section class="card p-5">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">ישובים לפי מספר המוהלים בהם</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.citysize_note }}</p>
  <div id="chart-citysize" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.citysize_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.citysize_caption }}</caption>
      <thead><tr><th scope="col">מוהלים בישוב</th><th scope="col">ישובים</th><th scope="col">מוהלים</th></tr></thead>
      <tbody>
{%- for r in model.tables.citysize %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.cities }}</td><td>{{ r.mohels }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">פקיעת הסמכות לפי חודש בשנה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.month_note }}</p>
  <div id="chart-month" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.month_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.month_caption }}</caption>
      <thead><tr><th scope="col">חודש</th><th scope="col">מוהלים</th></tr></thead>
      <tbody>
{%- for r in model.tables.month %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">פקיעת הסמכות לפי שנה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.year_note }}</p>
  <div id="chart-year" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.year_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.year_caption }}</caption>
      <thead><tr><th scope="col">שנה</th><th scope="col">מוהלים</th></tr></thead>
      <tbody>
{%- for r in model.tables.year %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">כמה הסמכות עדיין בתוקף, חודש אחר חודש</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.valid_note }}</p>
  <div id="chart-valid" data-fallback="explorer" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.valid_aria }}"></div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">לוח פקיעות: חודש ושנה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.heat_note }}</p>
  <div id="chart-heat" data-fallback="explorer" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.heat_aria }}"></div>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
<section class="card p-5">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">שמות משפחה נפוצים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.surnames_note }}</p>
  <div id="chart-surnames" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.surnames_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.surnames_caption }}</caption>
      <thead><tr><th scope="col">שם משפחה</th><th scope="col">מוהלים</th></tr></thead>
      <tbody>
{%- for r in model.tables.surnames %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">שמות פרטיים נפוצים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.firsts_note }}</p>
  <div id="chart-firsts" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.firsts_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.firsts_caption }}</caption>
      <thead><tr><th scope="col">שם פרטי</th><th scope="col">מוהלים</th></tr></thead>
      <tbody>
{%- for r in model.tables.firsts %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
</div>

<script>
  (function () {
    function hbar(id, d, unit) {
      var x = echarts.init(document.getElementById(id));
      x.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 4, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true },
        series: [{ type: "bar", name: unit, data: d.values }]
      }));
      window.addEventListener("resize", function () { x.resize(); });
    }
    hbar("chart-cities", {{ model.charts.cities | tojson }}, "מוהלים");
    hbar("chart-surnames", {{ model.charts.surnames | tojson }}, "מוהלים");
    hbar("chart-firsts", {{ model.charts.firsts | tojson }}, "מוהלים");

    var s = {{ model.charts.citysize | tojson }};
    var c = echarts.init(document.getElementById("chart-citysize"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 48, right: 16, top: 24, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: s.names, name: "מוהלים בישוב" },
      yAxis: { type: "value" },
      series: [{ type: "bar", name: "ישובים", data: s.cities },
               { type: "bar", name: "מוהלים", data: s.mohels }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var y = {{ model.charts.year | tojson }};
    var c = echarts.init(document.getElementById("chart-year"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 48, right: 16, top: 24, bottom: 32, containLabel: true },
      xAxis: { type: "category", data: y.x },
      yAxis: { type: "value", name: "מוהלים" },
      series: [{ type: "bar", name: "הסמכות שפוקעות", data: y.values }]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var m = {{ model.charts.month | tojson }};
    var c2 = echarts.init(document.getElementById("chart-month"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 48, right: 16, top: 24, bottom: 32, containLabel: true },
      xAxis: { type: "category", data: m.x, axisLabel: { fontSize: 10, interval: 0, rotate: 45 } },
      yAxis: { type: "value", name: "מוהלים" },
      series: [{ type: "bar", name: "הסמכות שפוקעות", data: m.values }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    var v = {{ model.charts.valid | tojson }};
    var c = echarts.init(document.getElementById("chart-valid"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 48, right: 16, top: 24, bottom: 56, containLabel: true },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 18 }],
      xAxis: { type: "category", data: v.x, axisLabel: { fontSize: 10, hideOverlap: true } },
      yAxis: { type: "value", name: "מוהלים", min: 0 },
      series: [{ type: "line", step: "end", name: "הסמכות בתוקף לפחות עד החודש", data: v.values,
                 showSymbol: false, areaStyle: { opacity: 0.12 }, lineStyle: { width: 2 } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var h = {{ model.charts.heat | tojson }};
    var c2 = echarts.init(document.getElementById("chart-heat"));
    c2.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return echarts.format.encodeHTML(h.x[p.value[0]]) + " " + echarts.format.encodeHTML(h.y[p.value[1]]) + ": " + p.value[2].toLocaleString("he-IL");
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true }, axisLabel: { fontSize: 10 } },
      yAxis: { type: "category", data: h.y, splitArea: { show: true } },
      visualMap: {
        min: 0, max: h.max, calculable: true, dimension: 2,
        orient: "horizontal", left: "center", bottom: 8,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells,
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>
