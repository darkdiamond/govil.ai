      series: [{ type: "bar", name: "תחנות פעילות", data: n.y }]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var l = {{ model.charts.long | tojson }};
    var c2 = echarts.init(document.getElementById("chart-long"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex;
        return echarts.format.encodeHTML(l.names[i]) + "<br/>" + l.years[i] + " שנות מדידה (" +
          l.first[i] + "-" + l.last[i] + ")";
      } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", name: "שנים" },
      yAxis: { type: "category", data: l.names, inverse: true, axisLabel: { width: 120, overflow: "truncate" } },
      series: [{ type: "bar", name: "שנות מדידה", data: l.years }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>
