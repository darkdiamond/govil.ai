<h1>פנקס הסניגורים הציבוריים</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-2xl md:text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">מינויים במאגר</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-2xl md:text-3xl font-bold text-{{ model.kpis.last_full.tone }} mb-1" dir="ltr">{{ model.kpis.last_full.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.last_full_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-2xl md:text-3xl font-bold text-{{ model.kpis.ytd.tone }} mb-1" dir="ltr">{{ model.kpis.ytd.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.ytd_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-2xl md:text-3xl font-bold text-{{ model.kpis.attorneys.tone }} mb-1" dir="ltr">{{ model.kpis.attorneys.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.attorneys_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מינויים לפי שנה ומחוז</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.yearly_note }}</p>
  <div id="chart-yearly" data-fallback="explorer" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.yearly_aria }}"></div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">עונתיות: מינויים לפי חודש</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.heat_note }}</p>
  <div id="chart-heat" data-fallback="explorer" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.heat_aria }}"></div>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">מחוזות הסניגוריה</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.dist_note }}</p>
    <div id="chart-dist" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.dist_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.dist_caption }}</caption>
        <thead><tr><th scope="col">מחוז</th><th scope="col">{{ model.charts.dist.base_year }}</th><th scope="col">{{ model.charts.dist.cur_year }}</th></tr></thead>
        <tbody>
{%- for r in model.tables.dist %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.base }}</td><td>{{ r.cur }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/list.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">סוגי התיקים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.codes_note }}</p>
    <div id="chart-codes" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.codes_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.codes_caption }}</caption>
        <thead><tr><th scope="col">סוג תיק</th><th scope="col">מינויים</th></tr></thead>
        <tbody>
{%- for r in model.tables.codes %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תמהיל סוגי התיקים לאורך השנים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.mix_note }}</p>
  <div id="chart-mix" data-fallback="explorer" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.mix_aria }}"></div>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">סוגי התיקים בכל מחוז</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.dmix_note }}</p>
    <div id="chart-dmix" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.dmix_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.dmix_caption }}</caption>
        <thead><tr><th scope="col">מחוז</th>{% for c in model.tables.dmix_cols %}<th scope="col">{{ c }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in model.tables.dmix %}
          <tr><th scope="row">{{ r.name }}</th>{% for c in r.cells %}<td dir="ltr">{{ c }}</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
      </div>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">מינויים לפי יום בשבוע</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.week_note }}</p>
    <div id="chart-week" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.week_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.week_caption }}</caption>
        <thead><tr><th scope="col">יום</th>{% for c in model.tables.week_cols %}<th scope="col">{{ c }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in model.tables.week %}
          <tr><th scope="row">{{ r.name }}</th>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
      </div>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">הסניגורים לאורך השנים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.att_note }}</p>
  <div id="chart-att" data-fallback="explorer" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.att_aria }}"></div>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/list.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">הסניגורים עם מירב המינויים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.top_note }}</p>
    <div id="chart-top" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.top_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.top_caption }}</caption>
        <thead><tr><th scope="col">סניגור</th><th scope="col">מינויים</th><th scope="col">מחוז עיקרי</th><th scope="col">מחוזות</th></tr></thead>
        <tbody>
{%- for r in model.tables.top %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.district }}</td><td>{{ r.ndist }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">עומס המינויים לסניגור</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.load_note }}</p>
    <div id="chart-load" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.load_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.load_caption }}</caption>
        <thead><tr><th scope="col">מינויים לסניגור</th><th scope="col">סניגורים</th><th scope="col">מינויים</th></tr></thead>
        <tbody>
{%- for r in model.tables.load %}
          <tr><th scope="row">{{ r.bucket }}</th><td>{{ r.att }}</td><td>{{ r.appts }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<script>
  (function () {
    var y = {{ model.charts.yearly | tojson }};
    var c = echarts.init(document.getElementById("chart-yearly"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 24, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: y.x },
      yAxis: { type: "value", name: "מינויים" },
      dataZoom: [{ type: "inside" }, { type: "slider", height: 14, bottom: 32 }],
      series: y.series.map(function (s) { return { type: "bar", stack: "total", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var h = {{ model.charts.heat | tojson }};
    var c = echarts.init(document.getElementById("chart-heat"));
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return h.x[p.value[0]] + " " + h.y[p.value[1]] + ": " + p.value[2].toLocaleString("he-IL") + " מינויים";
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true }, axisLabel: { interval: 0, rotate: 45 } },
      yAxis: { type: "category", data: h.y, splitArea: { show: true } },
      visualMap: {
        min: h.min, max: h.max, calculable: true, dimension: 2,
        orient: "horizontal", left: "center", bottom: 8,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells,
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.dist | tojson }};
    var c = echarts.init(document.getElementById("chart-dist"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 40, containLabel: true },
      xAxis: { type: "value", splitNumber: 3 },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [
        { type: "bar", name: d.base_year, data: d.base },
        { type: "bar", name: d.cur_year, data: d.cur }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var k = {{ model.charts.codes | tojson }};
    var c2 = echarts.init(document.getElementById("chart-codes"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        return k.labels[p[0].dataIndex] + ": " + p[0].value.toLocaleString("he-IL") + " מינויים";
      } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { formatter: function (v) { return (v / 1000).toLocaleString("he-IL"); } } },
      yAxis: { type: "category", data: k.names, inverse: true },
      series: [{ type: "bar", name: "מינויים", data: k.values }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    var m = {{ model.charts.mix | tojson }};
    var c = echarts.init(document.getElementById("chart-mix"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 24, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: m.x, boundaryGap: false },
      yAxis: { type: "value", max: 100, name: "%" },
      series: m.series.map(function (s) {
        return { type: "line", stack: "share", name: s.name, data: s.data, areaStyle: {}, showSymbol: false };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.dmix | tojson }};
    var c = echarts.init(document.getElementById("chart-dmix"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 56, containLabel: true },
      xAxis: { type: "value", max: 100 },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: d.series.map(function (s) { return { type: "bar", stack: "mix", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var w = {{ model.charts.week | tojson }};
    var c2 = echarts.init(document.getElementById("chart-week"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: w.names },
      yAxis: { type: "value", name: "מינויים" },
      series: w.series.map(function (s) { return { type: "bar", stack: "day", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    var a = {{ model.charts.att | tojson }};
    var c = echarts.init(document.getElementById("chart-att"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: a.x },
      yAxis: [
        { type: "value", name: "סניגורים" },
        { type: "value", name: "חציון מינויים", splitLine: { show: false } }
      ],
      series: [
        { type: "line", name: "סניגורים שקיבלו מינוי", data: a.active, showSymbol: false },
        { type: "line", name: "חציון מינויים לסניגור", yAxisIndex: 1, data: a.median, showSymbol: false }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var t = {{ model.charts.top | tojson }};
    var c = echarts.init(document.getElementById("chart-top"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 3 },
      yAxis: { type: "category", data: t.names, inverse: true },
      series: [{ type: "bar", name: "מינויים", data: t.values }]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var l = {{ model.charts.load | tojson }};
    var c2 = echarts.init(document.getElementById("chart-load"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: l.names, axisLabel: { interval: 0, rotate: 30 } },
      yAxis: [
        { type: "value", name: "סניגורים" },
        { type: "value", name: "מינויים", splitLine: { show: false } }
      ],
      series: [
        { type: "bar", name: "סניגורים", data: l.att },
        { type: "bar", name: "מינויים", yAxisIndex: 1, data: l.appts }
      ]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>
