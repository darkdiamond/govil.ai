<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי (בתרגום)</h2>
  </div>
  <p class="m-0 text-sm text-subtle">הודעה על בקשות לצו ירושה בבתי הדין הדרוזיים. הנתונים במקור בערבית; שמות בתי הדין והיישובים תורגמו לעברית.</p>
</section>

<script>
  (function () {
    var d = {{ model.charts.monthly | tojson }};
    var c = echarts.init(document.getElementById("chart-monthly"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 88, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value" },
      dataZoom: [{ type: "inside", startValue: d.zoom_start }, { type: "slider", startValue: d.zoom_start, bottom: 32, height: 18 }],
      series: d.series.map(function (s) { return { type: "bar", stack: "all", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.years | tojson }};
    var c = echarts.init(document.getElementById("chart-years"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { interval: 0, fontSize: 11 } },
      yAxis: { type: "value" },
      series: d.series.map(function (s) { return { type: "bar", stack: "all", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.weekday | tojson }};
    var c = echarts.init(document.getElementById("chart-weekday"));
    var mx = Math.max.apply(null, d.y);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 16, top: 24, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value" },
      series: [{ type: "bar", name: "הודעות", data: d.y.map(function (v) {
        return v === mx ? { value: v, itemStyle: { color: "#0b3668" } } : v;
      }), label: { show: true, position: "top" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

{%- if model.flags.map %}
<script>
  (function () {
    var d = {{ model.charts.map | tojson }};
    var el = document.getElementById("map-places");
    if (!el || !window.L) { return; }
    var map = L.map(el, { center: [32.95, 35.3], zoom: 9, zoomSnap: 0.25, scrollWheelZoom: false });
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 18, attribution: "© OpenStreetMap"
    }).addTo(map);
    var mx = 1;
    d.points.forEach(function (p) { if (p[2] > mx) { mx = p[2]; } });
    var bounds = [];
    d.points.forEach(function (p) {
      var mk = L.circleMarker([p[0], p[1]], {
        radius: 5 + 20 * Math.sqrt(p[2] / mx), color: "#0b3668", weight: 1,
        fillColor: "#0068f5", fillOpacity: 0.45
      }).addTo(map);
      var box = document.createElement("div");
      var t = document.createElement("strong");
      t.textContent = p[3];
      box.appendChild(t);
      [["תיקים", p[2].toLocaleString("he-IL")], ["אזור", p[4]], ["בית דין", p[5]]].forEach(function (row) {
        var line = document.createElement("div");
        line.textContent = row[0] + ": " + row[1];
        box.appendChild(line);
      });
      mk.bindPopup(box);
      mk.bindTooltip(p[3]);
      bounds.push([p[0], p[1]]);
    });
    if (bounds.length) { map.fitBounds(bounds, { padding: [24, 24] }); }
  })();
</script>
{%- endif %}

<script>
  (function () {
    var d = {{ model.charts.places | tojson }};
    var c = echarts.init(document.getElementById("chart-places"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
        formatter: function (ps) {
          var p = ps.filter(function (x) { return x.value > 0; })[0] || ps[0];
          return p.name + "<br>" + p.seriesName + ": " + p.value.toLocaleString("he-IL") + " תיקים";
        } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 8, bottom: 40, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: d.y, axisLabel: { interval: 0 } },
      series: d.series.map(function (s, i) {
        var o = { type: "bar", stack: "all", name: s.name, data: s.data, barMaxWidth: 22 };
        if (i === d.series.length - 1 && d.y[0] === s.name) { o.itemStyle = { color: "#b7d2f7" }; }
        return o;
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.lag | tojson }};
    var c = echarts.init(document.getElementById("chart-lag"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
