    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}{% if model.labels.dups %} {{ model.labels.dups }}{% endif %}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.notice_count }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.ytd.tone }} mb-1" dir="ltr">{{ model.kpis.ytd.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.ytd_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.ytd_change.tone }} mb-1" dir="ltr">{{ model.kpis.ytd_change.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.ytd_change_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.lag.tone }} mb-1" dir="ltr">{{ model.kpis.lag.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.lag_median_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.old.tone }} mb-1" dir="ltr">{{ model.kpis.old.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.old_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.places.tone }} mb-1" dir="ltr">{{ model.kpis.places.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.places_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">הודעות לפי חודש</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.monthly_note }}</p>
  <div id="chart-monthly" data-fallback="explorer" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.monthly_aria }}"></div>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <h2 class="m-0 mb-3 text-base font-semibold text-ink-deep">הודעות לפי שנה ובית דין</h2>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.years_note }}</p>
    <div id="chart-years" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.years_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.years_caption }}</caption>
        <thead><tr><th scope="col">שנה</th>{% for c in model.tables.courts %}<th scope="col">{{ c }}</th>{% endfor %}<th scope="col">סה״כ</th></tr></thead>
        <tbody>
{%- for r in model.tables.years %}
          <tr><th scope="row">{{ r.year }}</th>{% for v in r.cells %}<td>{{ v }}</td>{% endfor %}<td>{{ r.total }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <h2 class="m-0 mb-3 text-base font-semibold text-ink-deep">יום הפרסום בשבוע</h2>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.weekday_note }}</p>
    <div id="chart-weekday" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.weekday_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.weekday_caption }}</caption>
        <thead><tr><th scope="col">יום</th><th scope="col">הודעות</th><th scope="col">מועדי פרסום</th></tr></thead>
        <tbody>
{%- for r in model.tables.weekday %}
          <tr><th scope="row">{{ r.day }}</th><td>{{ r.notices }}</td><td>{{ r.dates }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

