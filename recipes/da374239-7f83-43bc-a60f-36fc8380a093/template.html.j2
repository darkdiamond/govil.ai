      xAxis: { type: "value", axisLabel: { show: false } },
      yAxis: { type: "category", data: d.x, inverse: true, axisLabel: { interval: 0 } },
      series: [{ type: "bar", name: "תיקים", data: d.y, label: { show: true, position: "right" }, barMaxWidth: 22 }]
