        <caption class="sr-only">{{ model.labels.models_aria }}</caption>
        <thead><tr><th scope="col">דגם</th><th scope="col">תוצר</th><th scope="col">כלי רכב חדשים</th></tr></thead>
        <tbody>
{%- for r in model.tables.models %}
          <tr><th scope="row" dir="ltr">{{ r.model }}</th><td>{{ r.brand }}</td><td>{{ r.count }}</td></tr>
{%- endfor %}
