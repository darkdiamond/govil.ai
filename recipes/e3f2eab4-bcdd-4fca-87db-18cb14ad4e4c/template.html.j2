      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v.toLocaleString("he-IL"); } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "value", axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: b.names, inverse: true, axisLabel: { interval: 0 } },
      series: series
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.brand_lines | tojson }};
    var c = echarts.init(document.getElementById("chart-brand-lines"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 40, right: 16, top: 24, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", name: "%" },
      series: d.series.map(function (s) { return { type: "line", name: s.name, data: s.data, showSymbol: false, lineStyle: { width: 2 } }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
