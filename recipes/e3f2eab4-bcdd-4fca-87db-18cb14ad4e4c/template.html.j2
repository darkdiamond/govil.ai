</section>

<script>
  (function () {
    var m = {{ model.charts.monthly | tojson }};
    var c = echarts.init(document.getElementById("chart-monthly"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v.toLocaleString("he-IL"); } },
      legend: { top: 0 },
      grid: { left: 48, right: 16, top: 40, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: m.x },
      yAxis: { type: "value", name: "כלי רכב" },
      dataZoom: [{ type: "inside", startValue: Math.max(0, m.x.length - 60) }, { type: "slider", bottom: 8, height: 18, startValue: Math.max(0, m.x.length - 60) }],
      series: m.series.map(function (s) { return { type: "bar", stack: "t", name: s.name, data: s.data, barCategoryGap: "20%" }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var y = {{ model.charts.yearly | tojson }};
    var c = echarts.init(document.getElementById("chart-yearly"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v === null || v === undefined ? "-" : v.toLocaleString("he-IL"); } },
      legend: { bottom: 0 },
      grid: { left: 48, right: 16, top: 24, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: y.x },
      yAxis: { type: "value", name: "כלי רכב" },
      series: [
        { type: "bar", name: "שנה מלאה", stack: "y", data: y.full },
        { type: "bar", name: "שנה חלקית", stack: "y", data: y.partial, itemStyle: { color: "#c3cfe7" } },
        { type: "line", name: {{ model.labels.ytd_series | tojson }}, data: y.ytd, showSymbol: true, lineStyle: { width: 2 } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var h = {{ model.charts.heat | tojson }};
    var enc = echarts.format.encodeHTML;
    var c = echarts.init(document.getElementById("chart-season"));
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return enc(h.x[p.value[0]]) + " " + enc(h.y[p.value[1]]) + ": " + p.value[2].toLocaleString("he-IL");
      } },
      grid: { left: 8, right: 8, top: 8, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true }, axisLabel: { rotate: 45, interval: 0 } },
      yAxis: { type: "category", data: h.y, inverse: true, splitArea: { show: true } },
      visualMap: {
        min: 0, max: h.max, calculable: true, dimension: 2,
        orient: "horizontal", left: "center", bottom: 4,
        inRange: { color: ["#f0f4fa", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells,
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var t = {{ model.charts.types | tojson }};
    var c = echarts.init(document.getElementById("chart-types"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v.toLocaleString("he-IL"); } },
      legend: { bottom: 0 },
      grid: { left: 48, right: 16, top: 24, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: t.x },
      yAxis: { type: "value", name: "כלי רכב" },
      series: t.series.map(function (s) { return { type: "bar", stack: "t", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.country_share | tojson }};
