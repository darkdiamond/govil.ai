<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">כמה מותגים ודגמים בשוק</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.diversity_note }}</p>
