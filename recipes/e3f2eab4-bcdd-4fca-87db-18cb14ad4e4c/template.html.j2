<script>
  (function () {
    var d = {{ model.charts.country_cmp | tojson }};
    var c = echarts.init(document.getElementById("chart-country-cmp"));
    c.setOption(window.GovEcharts.option({
      color: ["#c3cfe7", "#0068f5"],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "value", name: "%", axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { interval: 0 } },
      series: [
        { type: "bar", name: d.base_year, data: d.base },
        { type: "bar", name: d.last_year, data: d.last }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var b = {{ model.charts.brands | tojson }};
    var c = echarts.init(document.getElementById("chart-brands"));
    var series = [{ type: "bar", name: {{ model.labels.brand_now | tojson }}, data: b.values }];
{%- if model.flags.brand_prev %}
    series.push({ type: "bar", name: {{ model.labels.brand_prev | tojson }}, data: b.prev, itemStyle: { color: "#c3cfe7" } });
{%- endif %}
