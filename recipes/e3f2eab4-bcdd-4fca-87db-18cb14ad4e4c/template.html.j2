</script>

<script>
  (function () {
    function hbar(id, d, name) {
      var h = echarts.init(document.getElementById(id));
      h.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v.toLocaleString("he-IL"); } },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { interval: 0, width: 150, overflow: "truncate" } },
        series: [{ type: "bar", name: name, data: d.values }]
      }));
      window.addEventListener("resize", function () { h.resize(); });
    }
    hbar("chart-models", {{ model.charts.models | tojson }}, "כלי רכב חדשים");
{%- if model.flags.two %}
    hbar("chart-two", {{ model.charts.two | tojson }}, "כלי רכב חדשים");
{%- endif %}
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.diversity | tojson }};
    var c = echarts.init(document.getElementById("chart-diversity"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v.toLocaleString("he-IL"); } },
      legend: { bottom: 0 },
      grid: { left: 48, right: 48, top: 32, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: [
        { type: "value", name: "מותגים" },
        { type: "value", name: "קודי דגם", splitLine: { show: false } }
      ],
      series: [
        { type: "line", name: "מותגים", data: d.brands, showSymbol: true, lineStyle: { width: 3 } },
        { type: "bar", name: "קודי דגם", yAxisIndex: 1, data: d.models, itemStyle: { color: "#c3cfe7" } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
