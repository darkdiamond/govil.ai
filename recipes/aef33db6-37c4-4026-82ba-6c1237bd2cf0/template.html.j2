<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">סוג הבעלות</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">הבעלות הרשומה האחרונה, מחולקת לרכב פרטי ומסחרי.</p>
    <div id="chart-owner" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.owner_aria }}"></div>
    {{ rank_table(model.tables.owner, model.labels.owner_aria, "בעלות") }}
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">קבוצת זיהום</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.pollution_note }}</p>
    <div id="chart-pollution" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.pollution_aria }}"></div>
    {{ rank_table(model.tables.pollution, model.labels.pollution_aria, "קבוצה") }}
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">צבע הרכב</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">הצבעים כפי שנרשמו; גוונים מטאליים מופיעים בנפרד.</p>
  <div id="chart-colors" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.colors_aria }}"></div>
  {{ rank_table(model.tables.colors, model.labels.colors_aria, "צבע") }}
</section>

<script>
  (function () {
    var d = {{ model.charts.lapse | tojson }};
    var c = echarts.init(document.getElementById("chart-lapse"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 40, right: 16, top: 24, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.x, boundaryGap: false },
      yAxis: { type: "value" },
      dataZoom: [{ type: "inside", start: d.zoom_start, end: 100 },
                 { type: "slider", start: d.zoom_start, end: 100, bottom: 8, height: 20 }],
      series: [{ type: "line", name: "כלי רכב", data: d.y, showSymbol: false, areaStyle: { opacity: 0.15 } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    function stacked(id, d, horizontal) {
      var c = echarts.init(document.getElementById(id));
      var cat = { type: "category", data: horizontal ? d.names.slice().reverse() : d.x };
      var val = { type: "value", axisLabel: { hideOverlap: true }, splitNumber: horizontal ? 3 : 5 };
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { bottom: 0 },
        grid: { left: 8, right: horizontal ? 28 : 16, top: 24, bottom: 40, containLabel: true },
        xAxis: horizontal ? val : cat,
        yAxis: horizontal ? cat : val,
        series: d.series.map(function (s) {
          return { type: "bar", stack: "t", name: s.name, data: horizontal ? s.data.slice().reverse() : s.data };
        })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    function hbar(id, d) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 140, overflow: "truncate" } },
        series: [{ type: "bar", name: "כלי רכב", data: d.values.slice().reverse() }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    function vbar(id, x, y, name) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 16, top: 24, bottom: 24, containLabel: true },
        xAxis: { type: "category", data: x },
        yAxis: { type: "value" },
        series: [{ type: "bar", name: name, data: y }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    stacked("chart-vintage", {{ model.charts.vintage | tojson }}, false);
    var a = {{ model.charts.age | tojson }};
    vbar("chart-age", a.x, a.y, "כלי רכב");
    hbar("chart-brands", {{ model.charts.brands | tojson }});
    hbar("chart-models", {{ model.charts.models | tojson }});
    var f = {{ model.charts.fuel | tojson }};
    vbar("chart-fuel", f.names, f.values, "כלי רכב");
    stacked("chart-ev", {{ model.charts.ev | tojson }}, false);
    stacked("chart-owner", {{ model.charts.owner | tojson }}, true);
    var p = {{ model.charts.pollution | tojson }};
    vbar("chart-pollution", p.x, p.y, "כלי רכב");
    hbar("chart-colors", {{ model.charts.colors | tojson }});
  })();
</script>

<script>
  (function () {
    var b = {{ model.charts.box | tojson }};
    var c = echarts.init(document.getElementById("chart-box"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        var v = p.data.value || p.data;
        var o = v.length > 5 ? v.slice(1) : v;
        return b.names[p.dataIndex] + "<br>חציון: " + o[2] + "<br>רבעונים: " + o[1] + "–" + o[3] + "<br>אחוזון 5–95: " + o[0] + "–" + o[4];
      } },
      grid: { left: 8, right: 16, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", name: "שנים" },
      yAxis: { type: "category", data: b.names, axisLabel: { width: 110, overflow: "truncate" } },
      series: [{ type: "boxplot", name: "גיל בעת הפקיעה", data: b.data,
                 itemStyle: { color: "#dbe8fb", borderColor: "#0068f5" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
