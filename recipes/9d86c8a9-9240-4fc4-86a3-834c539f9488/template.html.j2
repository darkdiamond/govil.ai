      <thead><tr><th scope="col">ישוב</th><th scope="col">בני 18 עד 34</th><th scope="col">כלל התושבים</th><th scope="col">שיעור הצעירים</th></tr></thead>
      <tbody>
{%- for r in model.tables.top %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ "{:,}".format(r.young) }}</td><td>{{ "{:,}".format(r.total) }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
