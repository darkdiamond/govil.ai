<script>
  (function () {
    function draw(id, d) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
          var i = p[0].dataIndex;
          return echarts.format.encodeHTML(d.names[i]) + "<br>" + d.young[i].toLocaleString("he-IL") + " צעירים · " + d.share[i] + "%";
        } },
        grid: { left: 16, right: 40, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { fontSize: 11, interval: 0 } },
        series: [{ type: "bar", name: "בני 18 עד 34", data: d.young, itemStyle: { color: "#0068f5" } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
{%- if model.flags.councils %}
    draw("chart-councils", {{ model.charts.councils | tojson }});
{%- endif %}
    draw("chart-bureaus", {{ model.charts.bureaus | tojson }});
  })();
</script>

<script>
