  <p class="m-0 text-sm text-subtle whitespace-pre-line">תושבים צעירים בישראל לפי ישובים</p>
</section>

<script>
  (function () {
    var d = {{ model.charts.top | tojson }};
    var c = echarts.init(document.getElementById("chart-top"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0 },
      grid: { left: 16, right: 24, top: 36, bottom: 24, containLabel: true },
      xAxis: [
        { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
        { type: "value", position: "top", min: 0, axisLabel: { formatter: "{value}%" }, splitLine: { show: false } }
      ],
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { fontSize: 11, interval: 0 } },
      series: [
        { type: "bar", name: "בני 18 עד 34", data: d.young, itemStyle: { color: "#0068f5" } },
        { type: "line", name: "שיעור הצעירים", xAxisIndex: 1, data: d.share, symbolSize: 7,
          lineStyle: { width: 0 }, itemStyle: { color: "#0b3668" },
          tooltip: { valueFormatter: function (v) { return v + "%"; } } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

{%- if model.flags.extremes %}
<script>
  (function () {
    var nat = {{ model.charts.nat | tojson }};
    function draw(id, d, color) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
          var i = p[0].dataIndex;
          return echarts.format.encodeHTML(d.names[i]) + "<br>" + d.share[i] + "% · " + d.young[i].toLocaleString("he-IL") +
            " מתוך " + d.total[i].toLocaleString("he-IL");
        } },
        grid: { left: 16, right: 40, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", min: 0, splitNumber: 4, axisLabel: { formatter: "{value}%" } },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { fontSize: 11, interval: 0 } },
        series: [{ type: "bar", name: "שיעור הצעירים", data: d.share, itemStyle: { color: color },
                   label: { show: true, position: "right", fontSize: 10, formatter: "{c}%" },
                   markLine: { symbol: "none", silent: true, data: [{ xAxis: nat }],
                               lineStyle: { type: "dashed", color: "#6c757d" }, label: { show: false } } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    draw("chart-high", {{ model.charts.high | tojson }}, "#0068f5");
    draw("chart-low", {{ model.charts.low | tojson }}, "#6c757d");
  })();
</script>
{%- endif %}

<script>
  (function () {
    var h = {{ model.charts.hist | tojson }};
    var c = echarts.init(document.getElementById("chart-hist"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: h.labels, axisLabel: { fontSize: 10, rotate: 30, interval: 0 } },
      yAxis: { type: "value", name: "ישובים" },
      series: [{ type: "bar", name: "ישובים", data: h.counts.map(function (v, i) {
        return i === h.nat_bin ? { value: v, itemStyle: { color: "#0b3668" } } : v;
      }), itemStyle: { color: "#0068f5" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var s = {{ model.charts.size | tojson }};
    var c2 = echarts.init(document.getElementById("chart-size"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: s.labels, axisLabel: { fontSize: 10, rotate: 30, interval: 0 } },
      yAxis: [
        { type: "value", name: "שיעור הצעירים", min: 0, axisLabel: { formatter: "{value}%" } },
        { type: "value", name: "ישובים", splitLine: { show: false } }
      ],
      series: [
        { type: "bar", name: "שיעור הצעירים", data: s.share, itemStyle: { color: "#0068f5" },
          label: { show: true, position: "top", fontSize: 10, formatter: "{c}%" },
          tooltip: { valueFormatter: function (v) { return v + "%"; } } },
        { type: "line", name: "ישובים", yAxisIndex: 1, data: s.count, itemStyle: { color: "#0b3668" } }
      ]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

