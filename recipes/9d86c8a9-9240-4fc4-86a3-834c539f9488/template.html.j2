{%- if model.flags.scatter %}
<script>
  (function () {
    var P = window.GOVIL_PALETTE;
    var SYM = ["circle", "rect", "triangle", "diamond"];
    var s = {{ model.charts.scatter | tojson }};
    var c = echarts.init(document.getElementById("chart-scatter"));
    c.setOption(window.GovEcharts.option({
      color: P,
      tooltip: { trigger: "item", formatter: function (p) {
        return echarts.format.encodeHTML(p.data[2]) + "<br>" + p.data[0].toLocaleString("he-IL") + " תושבים · " + p.data[1] + "% צעירים";
      } },
      legend: { top: 0, type: "scroll" },
      grid: { left: 16, right: 24, top: 40, bottom: 40, containLabel: true },
      xAxis: { type: "log", name: "תושבים בישוב", nameLocation: "middle", nameGap: 28,
               min: function (v) { return Math.pow(10, Math.floor(Math.log10(v.min))); },
               max: function (v) { return Math.round(v.max * 1.5); },
               axisLabel: { showMaxLabel: false, formatter: function (v) { return v >= 1000000 ? (v / 1000000) + "M" : v >= 1000 ? (v / 1000) + "K" : v; } } },
      yAxis: { type: "value", scale: true, axisLabel: { formatter: "{value}%" } },
      series: s.map(function (g) {
        return { type: "scatter", name: g.name, data: g.data, symbolSize: 7, symbol: SYM[g.ci % SYM.length],
                 itemStyle: { color: P[g.ci % P.length], opacity: 0.8 } };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}
