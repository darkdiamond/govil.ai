      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: { fontSize: 10, interval: 0, rotate: 30 } },
      yAxis: [
        { type: "value", name: "תושבים (מיליונים)", axisLabel: { formatter: function (v) { return v / 1000000; } } },
        { type: "value", name: "שיעור", min: 0, axisLabel: { formatter: "{value}%" }, splitLine: { show: false } }
      ],
      series: [
        { type: "bar", stack: "t", name: "בני 18 עד 34", data: d.young, itemStyle: { color: "#0068f5" } },
        { type: "bar", stack: "t", name: "שאר התושבים", data: d.old, itemStyle: { color: "#c3cfe7" } },
        { type: "line", name: "שיעור הצעירים", yAxisIndex: 1, data: d.share, itemStyle: { color: "#0b3668" },
          tooltip: { valueFormatter: function (v) { return v + "%"; } } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var b = {{ model.charts.box | tojson }};
    var c2 = echarts.init(document.getElementById("chart-box"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        var v = p.data.slice(-5);
        return p.name + "<br>חציון " + v[2] + "%<br>רבעונים " + v[1] + "% · " + v[3] + "%<br>טווח " + v[0] + "% · " + v[4] + "%";
      } },
      grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: b.names, axisLabel: { fontSize: 10, interval: 0, rotate: 30 } },
      yAxis: { type: "value", min: 0, axisLabel: { formatter: "{value}%" } },
      series: [{ type: "boxplot", name: "שיעור הצעירים", data: b.data,
                 itemStyle: { color: "#f1f7ff", borderColor: "#0068f5" } }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

