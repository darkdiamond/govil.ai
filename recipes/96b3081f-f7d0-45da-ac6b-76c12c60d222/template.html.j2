<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">סטטוס הטיפול</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.status_note }}</p>
  <div id="chart-status" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.status_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.status_caption }}</caption>
      <thead><tr><th scope="col">סטטוס</th><th scope="col">תיקים</th><th scope="col">פניות</th></tr></thead>
      <tbody>
{%- for r in model.tables.status %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.case }}</td><td>{{ r.ref }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">על המאגר</h2>
  </div>
  <p class="m-0 text-sm text-subtle">רשימת התיקים והפניות שבטיפול היחידה לתיאום המאבק בסחר בבני אדם במשרד המשפטים: פניות ובקשות מקרבנות סחר, מארגונים לא ממשלתיים, ממשרדי ממשלה, מיחידות משרד המשפטים ומגופים בינלאומיים, וכן אירועים — כנסים, ימי עיון, סמינרים והכשרות — שהיחידה יזמה או השתתפה בהם. לכל רשומה מצוינים נושא, סוג, גורם פונה, סטטוס ומועדים. המאגר אינו כולל פרטים מזהים של קרבנות או של חשודים.</p>
</section>
<script>
  (function () {
    var d = {{ model.charts.yearly | tojson }};
    var colors = { "פתוח": "#0068f5", "במעקב": "#ffc107", "סגור": "#198754" };
    var c = echarts.init(document.getElementById("chart-yearly"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", name: "תיקים" },
      series: d.series.map(function (s) {
        var o = { type: "bar", name: s.name, data: s.data, stack: "st" };
        if (colors[s.name]) { o.itemStyle = { color: colors[s.name] }; }
        return o;
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var h = {{ model.charts.mheat | tojson }};
    var c = echarts.init(document.getElementById("chart-mheat"));
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return h.x[p.value[0]] + " " + h.y[p.value[1]] + ": " + p.value[2].toLocaleString("he-IL");
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true } },
      yAxis: { type: "category", data: h.y, splitArea: { show: true } },
      visualMap: {
        min: 0, max: h.max, calculable: true, dimension: 2,
        orient: "horizontal", left: "center", bottom: 8,
        inRange: { color: ["#f1f7ff", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells, label: { show: false } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    function hbar(id, d, unit) {
      var el = document.getElementById(id);
      if (!el) { return; }
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis" },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 130, overflow: "truncate" } },
        series: [{ type: "bar", name: unit, data: d.values }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    hbar("chart-topics", {{ model.charts.topics | tojson }}, "תיקים");
    hbar("chart-types", {{ model.charts.types | tojson }}, "תיקים");
    hbar("chart-sources", {{ model.charts.sources | tojson }}, "תיקים");
    hbar("chart-victims", {{ model.charts.victims | tojson }}, "תיקים");
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.ttrend | tojson }};
    var c = echarts.init(document.getElementById("chart-ttrend"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 32, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", name: "תיקים" },
      series: d.series.map(function (s) {
        var o = { type: "bar", name: s.name, data: s.data, stack: "t" };
        if (s.name === "אחר") { o.itemStyle = { color: "#c3cfe7" }; }
        return o;
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.strend | tojson }};
    var c = echarts.init(document.getElementById("chart-strend"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 24, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: d.x, boundaryGap: false },
      yAxis: { type: "value", max: 100, name: "%" },
      series: d.series.map(function (s) {
        var o = { type: "line", name: s.name, data: s.data, stack: "mix", areaStyle: {}, showSymbol: false, lineStyle: { width: 1 } };
        if (s.name === "אחר") { o.itemStyle = { color: "#c3cfe7" }; }
        return o;
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var h = {{ model.charts.theat | tojson }};
    var c = echarts.init(document.getElementById("chart-theat"));
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        var v = p.seriesIndex === 1 ? h.low_label : p.value[2].toLocaleString("he-IL");
        return h.y[p.value[1]] + " · " + h.x[p.value[0]] + ": " + v;
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: h.x, axisLabel: { rotate: 45, interval: 0 }, splitArea: { show: true } },
      yAxis: { type: "category", data: h.y, inverse: true, axisLabel: { width: 110, overflow: "truncate", interval: 0, fontSize: 11 }, splitArea: { show: true } },
      visualMap: {
        min: 0, max: h.max, calculable: true, dimension: 2, seriesIndex: 0,
        orient: "horizontal", left: "center", bottom: 8,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [
        { type: "heatmap", data: h.cells },
        { type: "heatmap", data: h.low, itemStyle: { color: "#e9ecef" } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.lag | tojson }};
    var c = echarts.init(document.getElementById("chart-lag"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 16, right: 16, top: 32, bottom: 32, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, rotate: 30 } },
      yAxis: { type: "value", name: "תיקים" },
      series: [{ type: "bar", name: "תיקים", data: d.values }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.status | tojson }};
    var colors = { "פתוח": "#0068f5", "במעקב": "#ffc107", "סגור": "#198754", "לא צוין": "#c3cfe7" };
    var c = echarts.init(document.getElementById("chart-status"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: d.cats, inverse: true },
      series: d.series.map(function (s) {
        var o = { type: "bar", name: s.name, data: s.data, stack: "s" };
        if (colors[s.name]) { o.itemStyle = { color: colors[s.name] }; }
        return o;
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
