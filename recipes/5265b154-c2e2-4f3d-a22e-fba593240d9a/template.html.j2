<script>
  (function () {
    var r = {{ model.charts.risk | tojson }};
    var c14 = echarts.init(document.getElementById("chart-risk"));
    c14.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        var d = p.data;
        return echarts.format.encodeHTML(d[3]) + "<br>סטיית תקן: " + d[0] + "<br>תשואה שנתית: " + d[1] + "%<br>נכסים: " + d[2] + " מיליארד ₪";
      } },
      legend: { type: "scroll", bottom: 0 },
      grid: { left: 48, right: 24, top: 24, bottom: 56, containLabel: true },
      xAxis: { type: "value", name: "סטיית תקן", scale: true },
      yAxis: { type: "value", name: "% לשנה", scale: true },
      series: r.classes.map(function (c) {
        return { type: "scatter", name: c, data: r.points.filter(function (p) { return p[4] === c; }),
                 symbolSize: function (d) { return Math.max(4, Math.sqrt(d[2]) * 4); } };
      })
    }));
    window.addEventListener("resize", function () { c14.resize(); });
  })();
</script>
