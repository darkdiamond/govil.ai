{% import "gov.j2" as gov %}
{%- macro callout(key) -%}
{%- if model.callouts[key] is defined %}
  <p class="m-0 mb-3 text-sm font-semibold text-ink-deep">{{ model.callouts[key] }}</p>
{%- endif %}
{%- endmacro %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסמה {{ model.release.date }}</p>
{%- if model.release.headline %}
  <p class="m-0 mb-3 text-ink-deep">{{ model.release.headline }}</p>
{%- endif %}
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["total", "growth", "transfers", "parts", "gov", "real"] %}
{%- if model.kpis[key] is defined %}
  {{ gov.kpi(model.kpis[key], model.labels[key ~ "_kpi"]) }}
{%- endif %}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

<section class="card p-5 mb-6">
  {{ gov.head("database", "ההוצאה לרווחה לאורך השנים, לפי מגזר מממן") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.trend_note }}</p>
  {{ callout("trend") }}
  {{ gov.chart("chart-trend", model.labels.trend_aria, "h-80 md:h-96") }}
  {{ gov.table("ההוצאה הלאומית לרווחה לפי מגזר מממן (מיליארדי ש\"ח)", model.labels.trend_cols, model.tables.trend, ltr=range(1, model.labels.trend_cols | length) | list) }}
</section>

{%- if model.flags.service %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "על מה מוציאים: ההוצאה לפי סוג שירות") }}
  <p class="m-0 text-sm text-subtle mb-3">ההוצאה הלאומית לרווחה ב-{{ model.labels.service_year }} לפי סוג השירות, במיליארדי ש"ח: העברות כספיות למשקי בית (קצבאות, פנסיות, דמי אבטלה) והוצאה על הפעלת שירותים (מעונות, מסגרות, טיפול וליווי).</p>
  {{ callout("service") }}
  {{ gov.chart("chart-service", model.labels.service_aria, "h-[440px]") }}
  {{ gov.table("ההוצאה הלאומית לרווחה לפי סוג שירות (מיליארדי ש\"ח)", ["סוג שירות", "סך הכול", "הפעלת שירותים", "העברות למשקי בית", "חלק מהסך"], model.tables.service, ltr=(1, 2, 3, 4)) }}
</section>
{%- endif %}

{%- if model.flags.parts %}
<section class="card p-5 mb-6">
  {{ gov.head("list", model.labels.parts_title) }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.parts_note }}</p>
  {{ callout("parts") }}
  {{ gov.chart("chart-parts", model.labels.parts_aria, "h-64 md:h-72") }}
  {{ gov.table(model.labels.parts_title, ["רכיב", "מיליארדי ש\"ח", "חלק מהקבוצה"], model.tables.parts, ltr=(1, 2)) }}
</section>
{%- endif %}

{%- if model.flags.flows %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "מי מעביר כסף למי") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.flows_note }}</p>
  {{ callout("flows") }}
  {{ gov.chart("chart-flows", model.labels.flows_aria, "h-[460px] md:h-[520px]") }}
  {{ gov.table("העברות כספיות בין המגזרים בתחום הרווחה (מיליוני ש\"ח)", ["מגזר מעביר", "מגזר מקבל", "מיליוני ש\"ח"], model.tables.flows, ltr=(2,)) }}
</section>
{%- endif %}

{%- if model.flags.finsvc %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "מי מממן כל סוג שירות") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.finsvc_note }}</p>
  {{ callout("finsvc") }}
  {{ gov.chart("chart-finsvc", model.labels.finsvc_aria, "h-[560px]") }}
  {{ gov.table("מימון כל סוג שירות לפי מגזר מממן (אחוזים)", model.labels.finsvc_cols, model.tables.finsvc, ltr=range(1, model.labels.finsvc_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.real %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "ההוצאה על שירותי רווחה במחירים קבועים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.real_note }}</p>
  {{ callout("real") }}
  {{ gov.chart("chart-real", model.labels.real_aria, "h-72 md:h-80") }}
  {{ gov.table("ההוצאה על שירותי רווחה במחירים קבועים (מיליארדי ש\"ח)", ["שנה", "מיליארדי ש\"ח", "שינוי ריאלי"], model.tables.real, ltr=(1, 2)) }}
</section>
{%- endif %}

{%- if model.flags.optrend %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "מי מפעיל את שירותי הרווחה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.optrend_note }}</p>
  {{ callout("optrend") }}
  {{ gov.chart("chart-optrend", model.labels.optrend_aria, "h-72 md:h-96") }}
  {{ gov.table("ההוצאה על שירותי רווחה לפי מגזר מבצע (מיליארדי ש\"ח)", model.labels.optrend_cols, model.tables.optrend, ltr=range(1, model.labels.optrend_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.opsvc %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "מי מפעיל כל סוג שירות") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.opsvc_note }}</p>
  {{ gov.chart("chart-opsvc", model.labels.opsvc_aria, "h-[520px]") }}
  {{ gov.table("הפעלת כל סוג שירות לפי מגזר מבצע (אחוזים)", model.labels.opsvc_cols, model.tables.opsvc, ltr=range(1, model.labels.opsvc_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.cost %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "על מה מוציאים מפעילי השירותים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cost_note }}</p>
  {{ callout("cost") }}
  {{ gov.chart("chart-cost", model.labels.cost_aria, "h-80 md:h-96") }}
  {{ gov.table("ההוצאה על שירותי רווחה לפי סוג הוצאה ומגזר מבצע (מיליארדי ש\"ח)", model.labels.cost_cols, model.tables.cost, ltr=range(1, model.labels.cost_cols | length) | list) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>הנתונים מתוך ההודעה השנתית לתקשורת של הלשכה המרכזית לסטטיסטיקה על ההוצאה הלאומית לרווחה. ההוצאה כוללת אספקת שירותי רווחה, השקעות בנכסים קבועים והעברות כספיות בתחום הרווחה, של הממשלה, הביטוח הלאומי, הרשויות המקומיות, המלכ"רים, העסקים ומשקי הבית.</li>
    <li>"מגזר מממן" הוא מי שנושא בעלות בפועל (נטו, אחרי העברות בין המגזרים); "מגזר מבצע" הוא מי שמפעיל את השירות.</li>
    <li>הסכומים במחירים שוטפים, אלא אם צוין "מחירים קבועים". הלמ"ס מעדכנת את השנים הקודמות בכל הודעה, ונתון השנה האחרונה בסדרת המחירים הקבועים הוא אומדן מוקדם.</li>
    <li>הלוחות בהודעה עשויים להשתנות משנה לשנה. העמוד מציג את הלוחות שמופיעים בהודעה האחרונה.</li>
  </ul>
</section>

<script>
  (function () {
    const d = {{ model.charts.trend | tojson }};
    const pal = window.GOVIL_PALETTE;
    const bn = (v) => v == null ? "" : Number(v).toFixed(1) + " מיליארד ש\"ח";
    const series = d.names.map((n, k) => ({ type: "bar", stack: "a", name: n, data: d.series[k], barMaxWidth: 36 }));
    series.push({ type: "line", name: "סך הכול", data: d.total, symbolSize: 6, lineStyle: { width: 0 }, itemStyle: { color: "#0c3058" },
      label: { show: true, position: "top", fontSize: 10, formatter: (p) => narrow && (d.total.length - 1 - p.dataIndex) % 2 !== 0 ? "" : String(Math.round(p.value)) } });
    const el = document.getElementById("chart-trend");
    const narrow = el.clientWidth < 520;
    const chart = echarts.init(el);
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[3], pal[5], pal[2], pal[1], pal[7]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: bn },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: narrow ? 92 : 56, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: (v) => Number(v).toLocaleString("he-IL") } },
      series: series
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- if model.flags.service %}
  (function () {
    const d = {{ model.charts.service | tojson }};
    const pal = window.GOVIL_PALETTE;
    const el = document.getElementById("chart-service");
    const narrow = el.clientWidth < 520;
    const chart = echarts.init(el);
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + " מיליארד ש\"ח" },
      legend: { top: 0 },
      grid: { left: 16, right: 24, top: 32, bottom: 8, containLabel: true },
      xAxis: { type: "value", splitNumber: narrow ? 3 : 5 },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 110, overflow: "break", fontSize: 11 } },
      series: [
        { type: "bar", stack: "a", name: "העברות למשקי בית", data: d.trans },
        { type: "bar", stack: "a", name: "הפעלת שירותים", data: d.prod }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.parts %}
  (function () {
    const d = {{ model.charts.parts | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-parts"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + " מיליארד ש\"ח" },
      grid: { left: 16, right: 48, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 110, overflow: "break", fontSize: 11 } },
      series: [{ type: "bar", name: "מיליארדי ש\"ח", data: d.values, barMaxWidth: 32,
        label: { show: true, position: "right", formatter: (p) => Number(p.value).toFixed(1) } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.flows %}
  (function () {
    const d = {{ model.charts.flows | tojson }};
    const pal = window.GOVIL_PALETTE;
    const enc = echarts.format.encodeHTML;
    const strip = (n) => n.replace(/^(מ|אל):/, "");
    const narrow = document.getElementById("chart-flows").clientWidth < 520;
    const chart = echarts.init(document.getElementById("chart-flows"));
    chart.setOption(window.GovEcharts.option({
      color: pal,
      tooltip: { trigger: "item", formatter: (p) => p.dataType === "edge"
        ? "מ" + enc(strip(p.data.source)) + " אל " + enc(strip(p.data.target)) + ": " + Math.round(p.data.value).toLocaleString("he-IL") + " מיליון ש\"ח"
        : enc(strip(p.name)) + ": " + Math.round(p.value).toLocaleString("he-IL") + " מיליון ש\"ח" },
      series: [{
        type: "sankey", left: 8, right: narrow ? 92 : 140, top: 8, bottom: 8,
        nodeWidth: 12, nodeGap: 10, layoutIterations: 0, draggable: false,
        data: d.nodes, links: d.links,
        label: { fontSize: narrow ? 10 : 12, formatter: (p) => strip(p.name) },
        lineStyle: { color: "source", opacity: 0.35 },
        emphasis: { focus: "adjacency" }
      }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.finsvc %}
  (function () {
    const d = {{ model.charts.finsvc | tojson }};
    const shade = (v) => v < 0 ? "#f8d7da" : v < 10 ? "#eef4fd" : v < 25 ? "#c6dafa" : v < 50 ? "#7fb0f5" : v < 75 ? "#0068f5" : "#0b3668";
    const cells = d.cells.map((c) => ({ value: c, itemStyle: { color: shade(c[2]) },
      label: { color: c[2] >= 50 ? "#ffffff" : "#0c3058" } }));
    const narrow = document.getElementById("chart-finsvc").clientWidth < 520;
    const chart = echarts.init(document.getElementById("chart-finsvc"));
    chart.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: (p) => echarts.format.encodeHTML(d.rows[p.value[1]] + ", " + d.cols[p.value[0]]) + ": " + Number(p.value[2]).toFixed(1) + "%" },
      grid: { left: 8, right: 8, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "category", data: d.cols, position: "top", axisLabel: { interval: 0, rotate: narrow ? 60 : 30, fontSize: narrow ? 10 : 11 } },
      yAxis: { type: "category", data: d.rows, inverse: true, axisLabel: { width: narrow ? 84 : 150, overflow: "break", lineHeight: 12, fontSize: narrow ? 10 : 11 } },
      series: [{ type: "heatmap", data: cells, itemStyle: { borderColor: "#ffffff", borderWidth: 1 },
        label: { show: true, fontSize: narrow ? 9 : 11, formatter: (p) => (p.value[2] < 0 ? "\u200e-" : "") + String(Math.abs(Math.round(p.value[2]))) } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.real %}
  (function () {
    const d = {{ model.charts.real | tojson }};
    const pal = window.GOVIL_PALETTE;
    const data = d.y.map((v, i) => d.prelim[i] ? { value: v, itemStyle: { color: "#c6dafa", borderColor: pal[0], borderType: "dashed", borderWidth: 1 } } : v);
    const el = document.getElementById("chart-real");
    const narrow = el.clientWidth < 520;
    const n = d.y.length;
    const chart = echarts.init(el);
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + " מיליארד ש\"ח" },
      grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value" },
      series: [{ type: "bar", name: "מחירים קבועים", data: data, barMaxWidth: 36,
        label: { show: true, position: "top", fontSize: 10, formatter: (p) => narrow && (n - 1 - p.dataIndex) % 3 !== 0 ? "" : Number(p.value).toFixed(1) } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.optrend %}
  (function () {
    const d = {{ model.charts.optrend | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-optrend"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[3], pal[5], pal[2]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + " מיליארד ש\"ח" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 48, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value" },
      series: d.names.map((n, k) => ({ type: "line", name: n, data: d.series[k], symbolSize: 5, lineStyle: { width: 2.5 } }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.opsvc %}
  (function () {
    const d = {{ model.charts.opsvc | tojson }};
    const pal = window.GOVIL_PALETTE;
    const el = document.getElementById("chart-opsvc");
    const narrow = el.clientWidth < 520;
    const chart = echarts.init(el);
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1], pal[2], pal[3], pal[5], pal[7]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: narrow ? 92 : 40, bottom: 8, containLabel: true },
      xAxis: { type: "value", max: 100, splitNumber: narrow ? 4 : 5, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 110, overflow: "break", fontSize: 11 } },
      series: d.keys.map((n, k) => ({ type: "bar", stack: "a", name: n, data: d.series[k] }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.cost %}
  (function () {
    const d = {{ model.charts.cost | tojson }};
    const pal = window.GOVIL_PALETTE;
    const el = document.getElementById("chart-cost");
    const narrow = el.clientWidth < 520;
    const chart = echarts.init(el);
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2], pal[4], pal[6], pal[8]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(2) + " מיליארד ש\"ח" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: narrow ? 72 : 40, bottom: 8, containLabel: true },
      xAxis: { type: "value", min: (v) => (v.min > -0.5 ? 0 : Math.floor(v.min)), splitNumber: narrow ? 4 : 5 },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 100, overflow: "break", fontSize: 11 } },
      series: d.keys.map((n, k) => ({ type: "bar", stack: "a", name: n, data: d.series[k] }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
</script>
