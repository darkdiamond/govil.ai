<section class="card p-5 mb-6">
  {{ head("database", "אורך מקטע חציוני לפי מרחק") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.med_note }}</p>
  <div id="chart-med" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.med_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.ring_caption }}</caption>
      <thead><tr><th scope="col">מרחק (ק״מ)</th><th scope="col">אורך חציוני (מטר)</th></tr></thead>
      <tbody>
{%- for r in model.tables.ring %}
        <tr><th scope="row" dir="ltr">{{ r.name }}</th><td>{{ r.med }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  {{ head("map-pin", "לפי כיוון מהמרכז") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.sec_note }}</p>
  <div id="chart-sec" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.sec_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.sec_caption }}</caption>
      <thead><tr><th scope="col">כיוון</th><th scope="col">מקטעים</th><th scope="col">ק״מ קווים</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.sec %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.km }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  {{ head("map-pin", "המקטעים הארוכים: שלד הצירים הראשיים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.long_note }}</p>
  <div id="chart-long" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.long_aria }}" data-fallback="explorer"></div>
</section>

<section class="card p-5 mb-6">
  {{ head("triangle-alert", "איכות השכבה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.qual_note }}</p>
  <div id="chart-qual" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.qual_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.qual_caption }}</caption>
      <thead><tr><th scope="col">בדיקה</th><th scope="col">שורות</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.qual %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<script>
  (function () {
    function mk(id) {
      var el = document.getElementById(id);
      if (!el) { return null; }
      var c = echarts.init(el);
      window.addEventListener("resize", function () { c.resize(); });
      return c;
    }
    function hbar(id, d, unit, lw) {
      var c = mk(id);
      if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value", axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: lw, overflow: "truncate" } },
        series: [{ type: "bar", name: unit, data: d.values.slice().reverse() }]
      }));
    }
    hbar("chart-cells", {{ model.charts.cells | tojson }}, "ק״מ לקמ״ר", 130);
    hbar("chart-qual", {{ model.charts.qual | tojson }}, "שורות", 150);
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.len | tojson }};
    var el = document.getElementById("chart-len");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + "%"; } },
      legend: { top: 0 },
      grid: { left: 8, right: 16, top: 40, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: d.names, name: "מטר", nameLocation: "middle", nameGap: 44, axisLabel: { interval: 0, rotate: 40 } },
      yAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
      series: [
        { type: "bar", name: "שיעור מהמקטעים", data: d.seg },
        { type: "bar", name: "שיעור מהאורך", data: d.len }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.lorenz | tojson }};
    var el = document.getElementById("chart-lorenz");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", formatter: function (p) { return echarts.format.encodeHTML(String(p[0].axisValue)) + "% מהמקטעים הארוכים: " + echarts.format.encodeHTML(String(p[0].data)) + "% מהאורך"; } },
      grid: { left: 8, right: 16, top: 16, bottom: 40, containLabel: true },
      xAxis: { type: "category", boundaryGap: false, data: d.x, name: "% מהמקטעים (מהארוך לקצר)", nameLocation: "middle", nameGap: 28 },
      yAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      series: [{ type: "line", name: "שיעור מהאורך", data: d.y, areaStyle: { opacity: 0.15 }, symbolSize: 6 }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var g = {{ model.charts.grid | tojson }};
    var el = document.getElementById("chart-grid");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) { return p.data[2] + " ק״מ קווים, " + p.data[3] + " מקטעים"; } },
      grid: { left: 8, right: 16, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: g.x, splitArea: { show: true }, name: "ק״מ ממערב", nameLocation: "middle", nameGap: 28 },
      yAxis: { type: "category", data: g.y, splitArea: { show: true }, name: "ק״מ מדרום" },
      visualMap: { min: 0, max: g.max, dimension: 2, calculable: false, orient: "horizontal", left: "center", bottom: 0,
                   inRange: { color: ["#f1f7ff", "#0068f5", "#0b3668"] } },
      series: [{ type: "heatmap", name: "ק״מ קווים", data: g.data, label: { show: false } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.ring | tojson }};
    var el = document.getElementById("chart-ring");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0 },
      grid: { left: 8, right: 8, top: 40, bottom: 36, containLabel: true },
      xAxis: { type: "category", data: d.names, name: "ק״מ מהמרכז", nameLocation: "middle", nameGap: 26 },
      yAxis: [{ type: "value", name: "ק״מ" }, { type: "value", name: "ק״מ לקמ״ר" }],
      series: [
        { type: "bar", name: "ק״מ קווים", data: d.km },
        { type: "line", name: "צפיפות", yAxisIndex: 1, data: d.dens, symbolSize: 7 }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.ring | tojson }};
    var el = document.getElementById("chart-med");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + " מטר"; } },
      grid: { left: 8, right: 16, top: 16, bottom: 36, containLabel: true },
      xAxis: { type: "category", data: d.names, name: "ק״מ מהמרכז", nameLocation: "middle", nameGap: 26 },
      yAxis: { type: "value", name: "מטר" },
      series: [{ type: "bar", name: "אורך חציוני", data: d.med }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.sec | tojson }};
    var el = document.getElementById("chart-sec");
    if (!el) { return; }
    var c = echarts.init(el);
    var mx = Math.max.apply(null, d.values);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item" },
      radar: { radius: "65%", indicator: d.names.map(function (n) { return { name: n, max: mx }; }) },
      series: [{ type: "radar", name: "ק״מ קווים", data: [{ value: d.values, name: "ק״מ קווים" }], areaStyle: { opacity: 0.2 } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.long | tojson }};
    var el = document.getElementById("chart-long");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) { return p.data[2].toLocaleString("he-IL") + " מטר"; } },
      grid: { left: 8, right: 16, top: 16, bottom: 36, containLabel: true },
      xAxis: { type: "value", scale: true, name: "קו אורך", nameLocation: "middle", nameGap: 26, axisLabel: { hideOverlap: true } },
      yAxis: { type: "value", scale: true, name: "קו רוחב" },
      series: [{ type: "scatter", name: "מקטעים", data: d.data,
                 symbolSize: function (v) { return 4 + 14 * Math.sqrt(v[2] / d.max); }, itemStyle: { opacity: 0.6 } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
