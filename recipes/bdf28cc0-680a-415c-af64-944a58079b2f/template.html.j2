{%- for chunk in model.charts.map.chunks %}
<script type="application/json" id="map-lines-{{ loop.index0 }}">{{ chunk | tojson }}</script>
{%- endfor %}
<script type="application/json" id="map-cells">{{ model.charts.map.cells | tojson }}</script>
<script>
  (function () {
    var el = document.getElementById("map-roads");
    if (!el || !window.L || !window.GovMap) { return; }
    var meta = {{ {"grid": model.charts.map.meta, "origin": model.charts.map.origin, "scale": model.charts.map.scale} | tojson }};
    var g = meta.grid;
    var shades = ["#f1f7ff", "#cfe2ff", "#9ec5fe", "#6ea8fe", "#3d8bfd", "#0068f5", "#0053c4"];
    function shade(v) {
      var r = g.max > 0 ? Math.sqrt(v / g.max) : 0;
      return shades[Math.min(shades.length - 1, Math.floor(r * shades.length))];
    }
    function box(rows) {
      var b = document.createElement("div");
      rows.forEach(function (t, i) {
        var e = document.createElement(i === 0 ? "strong" : "div");
        e.textContent = t;
        b.appendChild(e);
      });
      return b;
    }
    var map = L.map(el, { scrollWheelZoom: false, zoomSnap: 0.25, preferCanvas: true });
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 19, attribution: "© OpenStreetMap" }).addTo(map);
    var cellsNode = document.getElementById("map-cells");
    var cells = cellsNode ? JSON.parse(cellsNode.textContent) : [];
    var cellLayer = L.layerGroup();
    cells.forEach(function (c) {
      var s = g.y0 + c[1] * g.dy, w = g.x0 + c[0] * g.dx;
      L.rectangle([[s, w], [s + g.dy, w + g.dx]], {
        stroke: false, fillColor: shade(c[2]), fillOpacity: 0.55
      }).bindPopup(box([
        c[2].toLocaleString("he-IL") + " ק״מ קווים במשבצת",
        (c[2] / g.area).toLocaleString("he-IL", { maximumFractionDigits: 1 }) + " ק״מ לקמ״ר",
        c[3].toLocaleString("he-IL") + " מקטעים שמרכזם כאן"
      ])).addTo(cellLayer);
    });
    cellLayer.addTo(map);
    var lineLayer = L.layerGroup();
    GovMap.islands("map-lines").forEach(function (f) {
      L.polyline(GovMap.ring(f[2], meta.origin, meta.scale), {
        color: "#0c3058", weight: 3, opacity: 0.9
      }).bindPopup(box([
        "מקטע ארוך מספר " + f[0].toLocaleString("he-IL"),
        "אורך: " + f[1].toLocaleString("he-IL") + " מטר"
      ])).addTo(lineLayer);
    });
    lineLayer.addTo(map);
    L.control.layers(null, { "צפיפות לפי משבצת": cellLayer, "המקטעים הארוכים": lineLayer }, { collapsed: true }).addTo(map);
    map.fitBounds(g.bounds, { padding: [8, 8] });
  })();
</script>
