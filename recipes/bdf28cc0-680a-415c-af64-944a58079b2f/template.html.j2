{%- macro head(icon, title) -%}
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/{{ icon }}.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ title }}</h2>
  </div>
{%- endmacro -%}
<h1>דרכים בבאר שבע: קצה אספלט, אבני שפה וקצה דרך</h1>

<section class="card p-5 mb-6">
  {{ head("info", "תקציר") }}
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
{%- for key in ["segments", "km", "median", "dups"] %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.kpis[key].label }}</div>
  </div>
{%- endfor %}
</div>

<section class="card p-5 mb-6">
  {{ head("circle-check", "תובנות עיקריות") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  {{ head("map-pin", "מפת קווי הדרך: צפיפות והמקטעים הארוכים") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.labels.map_note }}</p>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.geo_note }}</p>
  <div id="map-roads" class="h-80 md:h-[460px]" role="region" aria-label="{{ model.labels.map_aria }}" data-fallback="explorer"></div>
  <ul id="map-legend" class="flex flex-wrap gap-x-4 gap-y-2 mt-3 mb-0 ps-0 list-none text-sm text-subtle">
    <li class="flex items-center gap-2"><span class="inline-block w-12 h-3 rounded-gov-sm" style="background:linear-gradient(to left,#0053c4,#9ec5fe,#f1f7ff)"></span>ק״מ קווים במשבצת (כהה יותר: צפוף יותר)</li>
    <li class="flex items-center gap-2"><span class="inline-block w-6 h-1 rounded-gov-sm" style="background:#0c3058"></span>מקטע ארוך, בקו האמיתי שלו</li>
  </ul>
</section>

<section class="card p-5 mb-6">
