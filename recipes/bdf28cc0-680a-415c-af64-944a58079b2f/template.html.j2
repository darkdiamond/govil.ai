{%- macro head(icon, title) -%}
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/{{ icon }}.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ title }}</h2>
  </div>
{%- endmacro -%}
<h1>דרכים בבאר שבע: קצה אספלט, אבני שפה וקצה דרך</h1>

<section class="card p-5 mb-6">
  {{ head("info", "תקציר") }}
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
{%- for key in ["segments", "km", "median", "dups"] %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.kpis[key].label }}</div>
  </div>
{%- endfor %}
</div>

<section class="card p-5 mb-6">
  {{ head("circle-check", "תובנות עיקריות") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  {{ head("database", "אורכי המקטעים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.len_note }}</p>
  <div id="chart-len" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.len_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.len_caption }}</caption>
      <thead><tr><th scope="col">אורך (מטר)</th><th scope="col">מקטעים</th><th scope="col">שיעור מהמקטעים</th><th scope="col">ק״מ</th><th scope="col">שיעור מהאורך</th></tr></thead>
      <tbody>
{%- for r in model.tables.len %}
        <tr><th scope="row" dir="ltr">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.seg_share }}</td><td>{{ r.km }}</td><td>{{ r.len_share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  {{ head("database", "ריכוז האורך במקטעים הארוכים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.lorenz_note }}</p>
  <div id="chart-lorenz" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.lorenz_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.lorenz_caption }}</caption>
      <thead><tr><th scope="col">המקטעים הארוכים ביותר</th><th scope="col">שיעור מהאורך הכולל</th></tr></thead>
      <tbody>
{%- for r in model.tables.lorenz %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  {{ head("map-pin", "צפיפות קווי הדרך לפי אזור") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.labels.grid_note }}</p>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.geo_note }}</p>
  <div id="chart-grid" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.grid_aria }}" data-fallback="explorer"></div>
</section>

<section class="card p-5 mb-6">
  {{ head("map-pin", "האזורים הצפופים ביותר") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cells_note }}</p>
  <div id="chart-cells" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.cells_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.cells_caption }}</caption>
      <thead><tr><th scope="col">דירוג</th><th scope="col">מיקום ביחס למרכז</th><th scope="col">ק״מ קווים</th><th scope="col">ק״מ לקמ״ר</th><th scope="col">מקטעים</th></tr></thead>
      <tbody>
{%- for r in model.tables.cells %}
        <tr><th scope="row">{{ r.rank }}</th><td>{{ r.name }}</td><td>{{ r.km }}</td><td>{{ r.dens }}</td><td>{{ r.count }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  {{ head("map-pin", "מרחק מהמרכז") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.ring_note }}</p>
  <div id="chart-ring" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.ring_aria }}"></div>
