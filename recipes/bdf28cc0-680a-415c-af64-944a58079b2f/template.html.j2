    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.ring_caption }}</caption>
      <thead><tr><th scope="col">מרחק (ק״מ)</th><th scope="col">מקטעים</th><th scope="col">ק״מ קווים</th><th scope="col">ק״מ לקמ״ר</th></tr></thead>
      <tbody>
{%- for r in model.tables.ring %}
        <tr><th scope="row" dir="ltr">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.km }}</td><td>{{ r.dens }}</td></tr>
{%- endfor %}
