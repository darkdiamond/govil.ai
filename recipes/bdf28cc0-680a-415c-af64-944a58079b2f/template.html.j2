    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + "%"; } },
      legend: { top: 0 },
      grid: { left: 8, right: 16, top: 40, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: d.names, name: "מטר", nameLocation: "middle", nameGap: 44, axisLabel: { interval: 0, rotate: 40 } },
      yAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
      series: [
        { type: "bar", name: "שיעור מהמקטעים", data: d.seg },
        { type: "bar", name: "שיעור מהאורך", data: d.len }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

