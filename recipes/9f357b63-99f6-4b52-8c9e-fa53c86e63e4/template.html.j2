        <tbody>
{%- for r in model.tables.cities %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td><td>{{ r.regular }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">איזה גוף נוכח באיזה יישוב</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.presence_note }}</p>
    <div id="chart-presence" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.presence_aria }}"></div>
    {{ matrix_table(model.tables.presence, model.labels.presence_caption, "יישוב") }}
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">פתיחות וסגירות לפי שנה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.flow_note }}</p>
  <div id="chart-flow" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.flow_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה (השנים האחרונות)</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.flow_caption }}</caption>
      <thead><tr><th scope="col">שנה</th><th scope="col">נפתחו</th><th scope="col">רישום מרוכז</th><th scope="col">נסגרו</th></tr></thead>
      <tbody>
{%- for r in model.tables.flow %}
        <tr><th scope="row">{{ r.year }}</th><td>{{ r.opened }}</td><td>{{ r.bulk }}</td><td>{{ r.closed }}</td></tr>
{%- endfor %}
      </tbody>
