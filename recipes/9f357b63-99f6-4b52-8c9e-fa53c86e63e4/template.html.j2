{% macro matrix_table(t, caption, head, summary="הצג כטבלה") -%}
<details class="mt-3">
  <summary class="text-sm text-subtle">{{ summary }}</summary>
  <div class="overflow-x-auto">
  <table class="mt-2 w-full text-sm">
    <caption class="sr-only">{{ caption }}</caption>
    <thead><tr><th scope="col">{{ head }}</th>{% for c in t.cols %}<th scope="col">{{ c }}</th>{% endfor %}</tr></thead>
    <tbody>
{%- for r in t.rows %}
      <tr><th scope="row">{{ r.name }}</th>{% for v in r.vals %}<td>{{ v }}</td>{% endfor %}</tr>
{%- endfor %}
    </tbody>
  </table>
  </div>
</details>
{%- endmacro %}

<h1>סניפים לסליקה</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
{%- for key in ["active", "banks", "cities", "regular", "redirected", "closed"] %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.kpis[key].label }}</div>
  </div>
{%- endfor %}
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">קודי סליקה לפי גוף וסוג סניף</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.banks_note }}</p>
  <div id="chart-banks" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.banks_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה (כל הגופים)</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.banks_caption }}</caption>
      <thead><tr><th scope="col">גוף</th><th scope="col">קודים פעילים</th><th scope="col">שיעור</th><th scope="col">יישובים</th><th scope="col">סוג נפוץ</th></tr></thead>
      <tbody>
{%- for r in model.tables.banks %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td><td>{{ r.cities }}</td><td>{{ r.main }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">סוגי הסניפים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">סניף רגיל משרת לקוחות; יחידת ביצוע וסניף מיוחד הם יחידות תפעול, עסקים או מטה; חוץ בנקאי — גוף פיננסי שאינו בנק.</p>
    <div id="chart-types" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.types_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.types_caption }}</caption>
        <thead><tr><th scope="col">סוג</th><th scope="col">קודים פעילים</th><th scope="col">שיעור</th><th scope="col">גופים</th></tr></thead>
        <tbody>
{%- for r in model.tables.types %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td><td>{{ r.banks }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">פריסה: בכמה יישובים כל גוף</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.footprint_note }}</p>
    <div id="chart-footprint" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.footprint_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.footprint_caption }}</caption>
        <thead><tr><th scope="col">גוף</th><th scope="col">יישובים</th><th scope="col">קודים</th><th scope="col">קודים ליישוב</th></tr></thead>
        <tbody>
{%- for r in model.tables.footprint %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.cities }}</td><td>{{ r.codes }}</td><td>{{ r.per_city }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
