{% if model.flags.status %}
<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">קודים מופנים וסגורים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.status_note }}</p>
    <div id="chart-status" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.status_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.status_caption }}</caption>
        <thead><tr><th scope="col">גוף</th><th scope="col">מופנים</th><th scope="col">נסגרו</th><th scope="col">פעילים</th></tr></thead>
        <tbody>
{%- for r in model.tables.status %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.redirected }}</td><td>{{ r.closed }}</td><td>{{ r.active }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/list.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">סגירות אחרונות</h2>
    </div>
{%- if model.flags.closed %}
    <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <caption class="sr-only">{{ model.labels.closed_caption }}</caption>
      <thead><tr><th scope="col">תאריך סגירה</th><th scope="col">גוף</th><th scope="col">סניף</th><th scope="col">יישוב</th></tr></thead>
      <tbody>
{%- for r in model.tables.closed %}
        <tr><th scope="row">{{ r.date }}</th><td>{{ r.bank }}</td><td>{{ r.branch }}</td><td>{{ r.city }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
{%- else %}
    <p class="m-0 text-sm text-subtle">אין במאגר קודים עם תאריך סגירה.</p>
{%- endif %}
  </section>
</div>
{% endif %}

{% if model.flags.shared %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">קודים הרשומים תחת שני גופים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.shared_note }}</p>
  <div class="overflow-x-auto">
  <table class="w-full text-sm">
    <caption class="sr-only">{{ model.labels.shared_caption }}</caption>
    <thead><tr><th scope="col">גוף א</th><th scope="col">גוף ב</th><th scope="col">קודים משותפים</th></tr></thead>
    <tbody>
{%- for r in model.tables.shared %}
      <tr><th scope="row">{{ r.a }}</th><td>{{ r.b }}</td><td>{{ r.count }}</td></tr>
{%- endfor %}
    </tbody>
  </table>
  </div>
</section>
{% endif %}

<script>
  (function () {
    function stackedH(id, d, opts) {
      var el = document.getElementById(id);
      if (!el) return;
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { bottom: 0, show: d.series.length > 1 },
        grid: { left: 8, right: 24, top: 8, bottom: d.series.length > 1 ? 56 : 8, containLabel: true },
        xAxis: { type: "value" },
        yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 120, overflow: "truncate" } },
        series: d.series.map(function (s) {
          return { type: "bar", stack: "t", name: s.name, data: s.data.slice().reverse() };
        })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    stackedH("chart-banks", {{ model.charts.banks | tojson }});
    stackedH("chart-cities", {{ model.charts.cities | tojson }});
    stackedH("chart-status", {{ model.charts.status | tojson }});

    var fp = {{ model.charts.footprint | tojson }};
    stackedH("chart-footprint", { names: fp.names, series: [{ name: "יישובים", data: fp.cities }] });
  })();
</script>

<script>
  (function () {
    var t = {{ model.charts.types | tojson }};
    var c = echarts.init(document.getElementById("chart-types"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: "{b}: {c} ({d}%)" },
      legend: { bottom: 0 },
      series: [{
        type: "pie", radius: ["40%", "68%"], center: ["50%", "44%"],
        label: { position: "inside", color: "#ffffff", fontFamily: "Rubik",
                 formatter: function (p) { return p.percent >= 5 ? Math.round(p.percent) + "%" : ""; } },
        data: t
      }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var pr = {{ model.charts.presence | tojson }};
    var c = echarts.init(document.getElementById("chart-presence"));
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return echarts.format.encodeHTML(pr.cities[p.value[1]]) + " · " + echarts.format.encodeHTML(pr.banks[p.value[0]]) + ": " + p.value[2];
      } },
      grid: { left: 8, right: 16, top: 8, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: pr.banks, splitArea: { show: true },
               axisLabel: { interval: 0, rotate: 30, width: 90, overflow: "truncate" } },
      yAxis: { type: "category", data: pr.cities, inverse: true, splitArea: { show: true } },
      visualMap: {
        dimension: 2, min: 0, max: pr.max, calculable: true,
        orient: "horizontal", left: "center", bottom: 0,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: pr.cells, label: { show: true, fontFamily: "Rubik" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var f = {{ model.charts.flow | tojson }};
    var c = echarts.init(document.getElementById("chart-flow"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 8, right: 16, top: 24, bottom: 88, containLabel: true },
      dataZoom: [{ type: "inside", start: f.zoom_start, end: 100 },
                 { type: "slider", start: f.zoom_start, end: 100, bottom: 32, height: 18 }],
      xAxis: { type: "category", data: f.x },
      yAxis: { type: "value" },
      series: [
        { type: "bar", stack: "o", name: "נפתחו", data: f.opened },
        { type: "bar", stack: "o", name: "רישום מרוכז", data: f.bulk, itemStyle: { color: "#c3cfe7" } },
        { type: "bar", name: "נסגרו", data: f.closed, itemStyle: { color: "#dc3545" } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
