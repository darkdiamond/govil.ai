{%- macro head(icon, title) %}
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/{{ icon }}.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ title }}</h2>
  </div>
{%- endmacro %}
<h1>האפוטרופוס הכללי: רשימת נעדרים ונכסים עזובים</h1>

<section class="card p-5 mb-6">
{{ head("info", "תקציר") }}
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור קרוב משפחה ברשימת הנעדרים לפי שם או מספר תיק ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: שם משפחה, שם פרטי, מספר תיק, תאריך, סוג הנכס וסטטוס הטיפול.</span>
  </span>
</a>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in model.kpi_order %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.labels["kpi_" ~ key] }}</div>
  </div>
{%- endfor %}
</div>

<section class="card p-5 mb-6">
{{ head("circle-check", "תובנות עיקריות") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

{%- if model.flags.has_years %}
<section class="card p-5 mb-6">
{{ head("database", "רשומות לפי שנת התיק וסטטוס") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.yearly_lede }}</p>
  <div id="chart-yearly" data-fallback="explorer" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.yearly_aria }}"></div>
</section>
{%- endif %}

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <h2 class="m-0 mb-3 text-base font-semibold text-ink-deep">סטטוס הטיפול בתיקים</h2>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.status_lede }}</p>
    <div id="chart-status" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.status_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.status_aria }}</caption>
        <thead><tr><th scope="col" class="text-start">סטטוס</th><th scope="col" class="text-start">רשומות</th><th scope="col" class="text-start">אחוז</th></tr></thead>
        <tbody>
{%- for r in model.charts.status %}
          <tr class="border-b border-rule"><th scope="row" class="text-start font-normal py-1">{{ r.name }}</th><td>{{ r.value | fmt_int }}</td><td>{{ r.share | fmt_num }}%</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <h2 class="m-0 mb-3 text-base font-semibold text-ink-deep">סוגי הנכסים העזובים</h2>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.assets_lede }}</p>
    <div id="chart-assets" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.assets_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.assets_aria }}</caption>
        <thead><tr><th scope="col" class="text-start">סוג הנכס</th><th scope="col" class="text-start">רשומות</th><th scope="col" class="text-start">אחוז</th></tr></thead>
        <tbody>
{%- for a in model.charts.assets.names %}
          <tr class="border-b border-rule"><th scope="row" class="text-start font-normal py-1">{{ a }}</th><td>{{ model.charts.assets["values"][loop.index0] | fmt_int }}</td><td>{{ model.charts.assets.shares[loop.index0] | fmt_num }}%</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
{{ head("tag", "סטטוס הטיפול לפי סוג הנכס") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.asset_status_lede }}</p>
  <div id="chart-asset-status" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.asset_status_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.asset_status_aria }}</caption>
      <thead><tr><th scope="col" class="text-start">סוג הנכס</th><th scope="col" class="text-start">רשומות</th>
{%- for s in model.charts.asset_status.series %}<th scope="col" class="text-start">{{ s.name }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for a in model.charts.asset_status.names %}
{%- set i = loop.index0 %}
        <tr class="border-b border-rule"><th scope="row" class="text-start font-normal py-1">{{ a }}</th><td>{{ model.charts.asset_status.totals[i] | fmt_int }}</td>
{%- for s in model.charts.asset_status.series %}<td>{{ s.data[i] | fmt_num }}%</td>{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

{%- if model.flags.has_decades %}
<section class="card p-5 mb-6">
{{ head("database", "סטטוס הטיפול לפי עשור") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.decstat_lede }}</p>
  <div id="chart-dec-status" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.decstat_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.decstat_aria }}</caption>
      <thead><tr><th scope="col" class="text-start">עשור</th><th scope="col" class="text-start">רשומות</th>
{%- for s in model.tables.statuses %}<th scope="col" class="text-start">{{ s }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for r in model.tables.decades %}
        <tr class="border-b border-rule"><th scope="row" class="text-start font-normal py-1">{{ r.label }}</th><td>{{ r.total | fmt_int }}</td>
{%- for v in r.status %}<td>{{ v | fmt_num }}%</td>{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<section class="card p-5 mb-6">
{{ head("database", "תמהיל סוגי הנכסים לפי עשור") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.decassets_lede }}</p>
  <div id="chart-dec-assets" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.decassets_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.decassets_aria }}</caption>
      <thead><tr><th scope="col" class="text-start">עשור</th><th scope="col" class="text-start">רשומות</th>
{%- for a in model.tables.assets %}<th scope="col" class="text-start">{{ a }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for r in model.tables.decades %}
        <tr class="border-b border-rule"><th scope="row" class="text-start font-normal py-1">{{ r.label }}</th><td>{{ r.total | fmt_int }}</td>
{%- for v in r.assets %}<td>{{ v | fmt_num }}%</td>{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>
{%- endif %}

<section class="card p-5 mb-6">
{{ head("list", "כמה בעלים רשומים בכל תיק") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.owners_lede }}</p>
  <div id="chart-owners" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.owners_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.owners_aria }}</caption>
      <thead><tr><th scope="col" class="text-start">בעלים בתיק</th><th scope="col" class="text-start">תיקים</th><th scope="col" class="text-start">שמות</th></tr></thead>
      <tbody>
{%- for b in model.charts.owners.names %}
        <tr class="border-b border-rule"><th scope="row" class="text-start font-normal py-1" dir="ltr">{{ b }}</th><td>{{ model.charts.owners.cases[loop.index0] | fmt_int }}</td><td>{{ model.charts.owners.rows[loop.index0] | fmt_int }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
{{ head("info", "על רשימת הנעדרים") }}
  <p class="m-0 text-sm text-subtle leading-relaxed">האפוטרופוס הכללי מופקד על ניהולם של נכסים עזובים: דירות ובתים, קרקעות, כספים וזכויות שבעליהם אינם ידועים או שמקום הימצאם אינו ידוע. הרשימה מתפרסמת כדי לאתר את בעלי הרכוש או את יורשיהם. כל רשומה היא שם של בעל רכוש בתיק מסוים; מי שמזהה ברשימה את עצמו או קרוב משפחה יכול לפנות לאפוטרופוס הכללי במשרד המשפטים ולציין את מספר התיק. הסטטוס "הועבר לקניין המדינה" מציין נכס שהועבר לבעלות המדינה.</p>
</section>

<script>
  (function () {
    var el = document.getElementById("chart-yearly");
    if (!el) return;
    var d = {{ model.charts.yearly | tojson }};
    var c = echarts.init(el);
    var narrow = el.clientWidth < 520;
    var win = narrow ? 30 : 60;
    var startPct = d.x.length > win ? Math.round((1 - win / d.x.length) * 100) : 0;
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var y = ps[0].axisValue, tot = 0, out = "";
        ps.forEach(function (p) { var v = typeof p.value === "object" ? p.value.value : p.value; tot += v; out += "<br>" + p.marker + echarts.format.encodeHTML(p.seriesName) + ": " + Number(v).toLocaleString("he-IL"); });
        return echarts.format.encodeHTML(y) + (y === d.partial ? " (שנה חלקית)" : "") + " · סה״כ " + tot.toLocaleString("he-IL") + out;
      } },
      legend: { bottom: 0, type: "scroll", textStyle: el.clientWidth < 500 ? { width: 200, overflow: "truncate" } : {} },
      grid: { left: 16, right: 16, top: 24, bottom: 92, containLabel: true },
      dataZoom: [{ type: "inside", start: startPct, end: 100 }, { type: "slider", start: startPct, end: 100, bottom: 36, height: 18 }],
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value" },
      series: d.series.map(function (s) {
        return { name: s.name, type: "bar", stack: "all", itemStyle: { color: s.color }, data: s.data.map(function (v, i) {
          return d.x[i] === d.partial ? { value: v, itemStyle: { opacity: 0.5 } } : v;
        }) };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var el = document.getElementById("chart-status");
    if (!el) return;
    var d = {{ model.charts.status | tojson }};
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        return echarts.format.encodeHTML(p.name) + ": " + p.value.toLocaleString("he-IL") + " (" + p.percent + "%)";
      } },
      legend: { bottom: 0, type: "scroll", textStyle: el.clientWidth < 500 ? { width: 200, overflow: "truncate" } : {}, orient: "horizontal" },
      series: [{ type: "pie", radius: ["40%", "66%"], center: ["50%", "42%"], label: { show: false },
                 data: d.map(function (r) { return { name: r.name, value: r.value, itemStyle: { color: r.color } }; }) }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var el = document.getElementById("chart-assets");
    if (!el) return;
    var d = {{ model.charts.assets | tojson }};
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        var i = p.dataIndex;
        return echarts.format.encodeHTML(d.names[i]) + "<br>" + d.values[i].toLocaleString("he-IL") + " רשומות · " + d.shares[i] + "%";
      } },
      grid: { left: 16, right: 48, top: 8, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 130, overflow: "truncate", fontSize: 11 } },
      series: [{ type: "bar", data: d.values, barMaxWidth: 28,
                 label: { show: true, position: "right", fontFamily: "Rubik", color: "#0c3058", formatter: function (p) { return p.value.toLocaleString("he-IL"); } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var el = document.getElementById("chart-asset-status");
    if (!el) return;
    var d = {{ model.charts.asset_status | tojson }};
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex, out = echarts.format.encodeHTML(d.names[i]) + " · " + d.totals[i].toLocaleString("he-IL") + " רשומות";
        ps.forEach(function (p) { out += "<br>" + p.marker + echarts.format.encodeHTML(p.seriesName) + ": " + p.value + "%"; });
        return out;
      } },
      legend: { bottom: 0, type: "scroll", textStyle: el.clientWidth < 500 ? { width: 200, overflow: "truncate" } : {} },
      grid: { left: 16, right: 16, top: 8, bottom: 56, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 130, overflow: "truncate", fontSize: 11 } },
      series: d.series.map(function (s) {
        return { name: s.name, type: "bar", stack: "st", barMaxWidth: 28, itemStyle: { color: s.color }, data: s.data };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var el = document.getElementById("chart-dec-status");
    if (!el) return;
    var d = {{ model.charts.dec_status | tojson }};
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex, out = echarts.format.encodeHTML(d.x[i]) + " · " + d.totals[i].toLocaleString("he-IL") + " רשומות";
        ps.forEach(function (p) { out += "<br>" + p.marker + echarts.format.encodeHTML(p.seriesName) + ": " + p.value + "%"; });
        return out;
      } },
      legend: { bottom: 0, type: "scroll", textStyle: el.clientWidth < 500 ? { width: 200, overflow: "truncate" } : {} },
      grid: { left: 16, right: 16, top: 16, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: el.clientWidth < 500 ? { fontSize: 10, interval: 0, rotate: 45 } : { fontSize: 11, hideOverlap: true } },
      yAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      series: d.series.map(function (s) {
        return { name: s.name, type: "bar", stack: "st", barCategoryGap: "20%", itemStyle: { color: s.color }, data: s.data };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var el = document.getElementById("chart-dec-assets");
    if (!el) return;
    var d = {{ model.charts.dec_assets | tojson }};
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex, out = echarts.format.encodeHTML(d.x[i]) + " · " + d.totals[i].toLocaleString("he-IL") + " רשומות";
        ps.forEach(function (p) { if (p.value > 0) { out += "<br>" + p.marker + echarts.format.encodeHTML(p.seriesName) + ": " + p.value + "%"; } });
        return out;
      } },
      legend: { bottom: 0, type: "scroll", textStyle: el.clientWidth < 500 ? { width: 200, overflow: "truncate" } : {} },
      grid: { left: 16, right: 16, top: 16, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: el.clientWidth < 500 ? { fontSize: 10, interval: 0, rotate: 45 } : { fontSize: 11, hideOverlap: true } },
      yAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      series: d.series.map(function (s) {
        return { name: s.name, type: "bar", stack: "as", barCategoryGap: "20%", data: s.data };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var el = document.getElementById("chart-owners");
    if (!el) return;
    var d = {{ model.charts.owners | tojson }};
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex;
        return "בעלים בתיק: " + echarts.format.encodeHTML(d.names[i]) + "<br>" + d.cases[i].toLocaleString("he-IL") + " תיקים · " + d.rows[i].toLocaleString("he-IL") + " שמות";
      } },
      grid: { left: 16, right: 16, top: 24, bottom: 32, containLabel: true },
      xAxis: { type: "category", data: d.names, name: "בעלים בתיק", nameLocation: "middle", nameGap: 26 },
      yAxis: { type: "value", axisLabel: { hideOverlap: true } },
      series: [{ type: "bar", data: d.cases, barMaxWidth: 40,
                 label: { show: true, position: "top", fontFamily: "Rubik", color: "#0c3058", formatter: function (p) { return p.value.toLocaleString("he-IL"); } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
