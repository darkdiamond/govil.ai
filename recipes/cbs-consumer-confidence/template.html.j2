{% import "gov.j2" as gov %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 mb-3 font-semibold text-ink-deep">{{ model.release.title }}</p>
  <p class="m-0 text-sm text-subtle mb-2">פורסמה {{ model.release.date }}</p>
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["index", "mom", "yoy", "relative", "rank"] %}
{%- if model.kpis[key] is defined %}
  {{ gov.kpi(model.kpis[key], model.labels[key ~ "_kpi"]) }}
{%- endif %}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

<section class="card p-5 mb-6">
  {{ gov.head("database", "מדד אמון הצרכנים לפי חודש") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.monthly_note }}</p>
  {{ gov.chart("chart-monthly", model.labels.monthly_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.monthly_caption, ["חודש", "המדד", "שינוי מהחודש הקודם"], model.tables.monthly, ltr=(1, 2)) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("list", "ממה בנוי המדד: ארבע השאלות") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.latest_note }}</p>
  {{ gov.chart("chart-latest", model.labels.latest_aria, "h-80 md:h-96") }}
  {{ gov.table(model.labels.latest_caption, ["מרכיב", model.charts.latest.now_name, model.charts.latest.ago_name, "שינוי בנקודות"], model.tables.latest, ltr=(1, 2, 3)) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("database", "המרכיבים לאורך זמן") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.parts_note }}</p>
  {{ gov.chart("chart-parts", model.labels.parts_aria, "h-80 md:h-[460px]") }}
  {{ gov.table(model.labels.parts_caption, ["חודש"] + model.charts.parts.names, model.tables.parts, ltr=(1, 2, 3, 4)) }}
</section>

{%- if model.flags.annual %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "ממוצע שנתי לאורך השנים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.annual_note }}</p>
  {{ gov.chart("chart-annual", model.labels.annual_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.annual_caption, ["שנה", "המדד"] + model.charts.parts.names, model.tables.annual, ltr=(0, 1, 2, 3, 4, 5)) }}
</section>
{%- endif %}

{%- if model.flags.relative %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "מדד אמון הצרכנים היחסי") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.relative_note }}</p>
  {{ gov.chart("chart-relative", model.labels.relative_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.relative_caption, ["תקופה", "המדד היחסי"], model.tables.relative, ltr=(1,)) }}
</section>
{%- endif %}

{%- if model.flags.oecd %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "ישראל מול מדינות OECD") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.oecd_note }}</p>
  {{ gov.chart("chart-oecd", model.labels.oecd_aria, "h-[560px] md:h-[620px]") }}
  {{ gov.table(model.labels.oecd_caption, ["מדינה", "המדד"], model.tables.oecd, ltr=(1,)) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>המדד מבוסס על סקר חודשי של הלמ"ס בקרב משקי בית. הנשאלים מעריכים את השינוי במצבם הכלכלי בשנה האחרונה, את השינוי הצפוי בשנה הקרובה במצבם ובמצב המדינה, ואת כוונתם לבצע רכישות גדולות.</li>
    <li>לכל שאלה מחושב מאזן: אחוז התשובות החיוביות פחות אחוז התשובות השליליות. מדד אמון הצרכנים הוא ממוצע ארבעת המאזנים.</li>
    <li>ערך שלילי אינו בהכרח משבר: המדד בישראל שלילי ברוב השנים. כדאי להשוות לחודשים ולשנים קודמים.</li>
    <li>העמוד מציג תמיד את הגרסה האחרונה של הלוחות, כולל עדכונים של הלמ"ס לנתוני עבר.</li>
  </ul>
</section>

<script>
  (function () {
    const d = {{ model.charts.monthly | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-monthly"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : "\u200e" + Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) },
      grid: { left: 16, right: 16, top: 24, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.x, boundaryGap: false },
      yAxis: { type: "value", scale: true, axisLabel: { formatter: (v) => "\u200e" + Number(v).toLocaleString("he-IL") } },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 20 }],
      series: [{ type: "line", name: "מדד אמון הצרכנים", data: d.y, showSymbol: false, lineStyle: { width: 3 } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.latest | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-latest"));
    const fmtv = (v) => v == null ? "" : "\u200e" + Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 });
    const series = [{ type: "bar", name: d.now_name, data: d.now }];
    if (d.ago) series.push({ type: "bar", name: d.ago_name, data: d.ago });
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[6]],
      tooltip: { trigger: "axis", valueFormatter: fmtv },
      legend: { top: 0 },
      grid: { left: 16, right: 48, top: 40, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: fmtv } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 120, overflow: "break" } },
      series: series
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.parts | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-parts"));
    const dash = ["solid", "dashed", "solid", "dotted"];
    chart.setOption(window.GovEcharts.option({
      color: [pal[1], pal[0], pal[2], pal[5]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : "\u200e" + Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 72, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.x, boundaryGap: false },
      yAxis: { type: "value", axisLabel: { formatter: (v) => "\u200e" + Number(v).toLocaleString("he-IL") } },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 20 }],
      series: d.names.map((n, k) => ({
        type: "line", name: n, data: d.series[k], showSymbol: false,
        lineStyle: { width: 2, type: dash[k % dash.length] }
      }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- if model.flags.annual %}
  (function () {
    const d = {{ model.charts.annual | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-annual"));
    const last = d.y.length - 1;
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : "\u200e" + Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) },
      grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value", axisLabel: { formatter: (v) => "\u200e" + Number(v).toLocaleString("he-IL") } },
      series: [{
        type: "bar", name: "ממוצע שנתי",
        data: d.y.map((v, i) => ({ value: v, itemStyle: { color: i === last ? pal[1] : pal[0] } }))
      }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.relative %}
  (function () {
    const d = {{ model.charts.relative | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-relative"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : "\u200e" + Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) },
      grid: { left: 16, right: 16, top: 24, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value", scale: true, axisLabel: { formatter: (v) => "\u200e" + Number(v).toLocaleString("he-IL") } },
      dataZoom: [{ type: "inside" }],
      series: [{
        type: "line", name: "המדד היחסי", data: d.y, showSymbol: true, symbolSize: 5, lineStyle: { width: 2.5 },
        markLine: { silent: true, symbol: "none", data: [{ yAxis: d.base }], label: { show: false }, lineStyle: { color: pal[1], type: "dashed" } }
      }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.oecd %}
  (function () {
    const d = {{ model.charts.oecd | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-oecd"));
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", valueFormatter: (v) => "\u200e" + Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) },
      grid: { left: 16, right: 48, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: false }, splitLine: { show: false } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 130, overflow: "break" } },
      series: [{
        type: "bar",
        data: d.values.map((v, i) => ({
          value: v,
          itemStyle: { color: d.names[i] === "ישראל" ? pal[0] : d.names[i].indexOf("גוש") === 0 ? pal[1] : pal[6] }
        })),
        label: { show: true, position: "right", formatter: (p) => "\u200e" + Number(p.value).toLocaleString("he-IL", { maximumFractionDigits: 1 }) }
      }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
</script>
