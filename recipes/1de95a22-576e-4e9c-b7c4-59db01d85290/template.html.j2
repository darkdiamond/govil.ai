        return echarts.format.encodeHTML(d.names[i]) + "<br>מכפיל חציוני: פי " + d.med[i].toFixed(1) + "<br>מתחמים: " + d.n[i].toLocaleString("he-IL");
      } },
      grid: { left: 16, right: 48, top: 24, bottom: 16, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [{ type: "bar", name: "מכפיל חציוני", data: d.med, barMaxWidth: 24,
        label: { show: true, position: "right", formatter: function (p) { return p.value.toFixed(1); } },
        markLine: { symbol: "none", label: { formatter: "חציון כללי" }, lineStyle: { color: "#9a6700", type: "dashed" }, data: [{ xAxis: d.overall }] } }]
    }));
