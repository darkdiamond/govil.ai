{%- macro head(icon, title) %}
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/{{ icon }}.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ title }}</h2>
  </div>
{%- endmacro %}
{%- macro subhead(title) %}
  <h2 class="m-0 mb-3 text-base font-semibold text-ink-deep">{{ title }}</h2>
{%- endmacro %}
{%- macro tbl(caption, heads, rows, keys, summary="הצג כטבלה") %}
  <details class="mt-3">
    <summary class="cursor-pointer text-sm text-brand">{{ summary }}</summary>
    <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ caption }}</caption>
        <thead><tr class="border-b border-rule text-ink-deep">{% for h in heads %}<th scope="col" class="text-start py-1 pe-3">{{ h }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in rows %}
          <tr class="border-b border-rule"><th scope="row" class="text-start font-normal py-1 pe-3">{{ r[keys[0]] }}</th>{% for k in keys[1:] %}<td class="py-1 pe-3">{{ r[k] }}</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
{%- endmacro %}
<h1>מפת התחדשות עירונית: מתחמי פינוי בינוי מוכרזים ותוכניות מתאר (שכבות GIS)</h1>

<section class="card p-5 mb-6">
{{ head("info", "תקציר") }}
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }} השכבות של משרד הבינוי והשיכון מציגות לכל מתחם את שמו, היישוב, מסלול ההכרזה (מיסוי או רשויות), סוג ההתחדשות (פינוי בינוי, עיבוי ועוד), מספר התוכנית, תאריך כניסתה לתוקף ויחידות הדיור הקיימות והמוצעות.</p>
{%- if model.labels.dup_note %}
  <p class="m-0 mt-2 text-sm text-subtle">{{ model.labels.dup_note }}</p>
{%- endif %}
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in model.kpi_order %}
