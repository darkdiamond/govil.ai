{%- if model.flags.map %}
{%- for chunk in model.charts.map.chunks %}
<script type="application/json" id="map-pts-{{ loop.index0 }}">{{ chunk | tojson }}</script>
{%- endfor %}
{%- for chunk in model.charts.map.polys %}
<script type="application/json" id="map-mp-{{ loop.index0 }}">{{ chunk | tojson }}</script>
{%- endfor %}
<script>
  (function () {
    var el = document.getElementById("map-renewal");
    if (!el || !window.L) { return; }
    var meta = {{ {"n": model.charts.map.chunks | length, "np": model.charts.map.polys | length, "bounds": model.charts.map.bounds, "cities": model.charts.map.cities, "tracks": model.charts.map.tracks} | tojson }};
    var pal = window.GOVIL_PALETTE || ["#0068f5", "#0b3668", "#6c9fd8"];
    var colors = [pal[0], pal[1], pal[2], pal[5], pal[7], pal[3]];
    var map = L.map(el, { preferCanvas: true, scrollWheelZoom: false, zoomSnap: 0.25 });
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 18, attribution: "© OpenStreetMap" }).addTo(map);
    var fmt = function (v) { return Number(v).toLocaleString("he-IL"); };
    var popup = function (title, rows) {
      var box = document.createElement("div");
      var t = document.createElement("strong");
      t.textContent = title;
      box.appendChild(t);
      rows.forEach(function (row) {
        if (row[1] === "" || row[1] === null) { return; }
        var line = document.createElement("div");
        line.textContent = row[0] + ": " + row[1];
        box.appendChild(line);
      });
      return box;
    };
    var mpLayer = L.featureGroup();
    for (var j = 0; j < meta.np; j++) {
      var pn = document.getElementById("map-mp-" + j);
      if (!pn) { continue; }
      JSON.parse(pn.textContent).forEach(function (p) {
        var lyr = L.geoJSON(p.g, { style: { color: "#0b3668", weight: 2, dashArray: "6 4", fillColor: "#6c9fd8", fillOpacity: 0.12 } });
        lyr.bindPopup(popup(p.n, [["סוג", "תוכנית מתאר להתחדשות עירונית"], ["יישוב", p.c], ["סטטוס תכנון", p.s]]));
        lyr.addTo(mpLayer);
      });
    }
    mpLayer.addTo(map);
    var groups = meta.tracks.map(function () { return L.featureGroup().addTo(map); });
    for (var c = 0; c < meta.n; c++) {
      var node = document.getElementById("map-pts-" + c);
      if (!node) { continue; }
      JSON.parse(node.textContent).forEach(function (p) {
        var mk = L.circleMarker([p[0], p[1]], {
          radius: 4 + Math.min(10, Math.sqrt(p[7]) / 5), color: "#ffffff", weight: 1,
          fillColor: colors[p[4] % colors.length], fillOpacity: 0.85
        });
        mk.bindPopup(popup(p[2], [
          ["יישוב", meta.cities[p[3]]], ["מסלול הכרזה", meta.tracks[p[4]]], ["סוג התחדשות", p[5]],
          ["יח״ד קיימות", fmt(p[6])], ["יח״ד מוצעות", fmt(p[7])], ["מספר תוכנית", p[8]],
          ["תוכנית בתוקף מיום", p[9]], ["שטח (דונם)", fmt(p[10])]
        ]));
        mk.addTo(groups[p[4]]);
      });
    }
    // Leaflet's layer control writes names with innerHTML: escape the data-derived track names.
    var esc = function (s) { var n = document.createElement("span"); n.textContent = s; return n.innerHTML; };
    var overlays = {};
    meta.tracks.forEach(function (t, i) { overlays["מתחמים: " + esc(t)] = groups[i]; });
    if (meta.np) { overlays["תוכניות מתאר"] = mpLayer; }
    L.control.layers(null, overlays, { collapsed: true }).addTo(map);
    var lg = document.getElementById("map-legend");
    if (lg) {
      meta.tracks.forEach(function (t, i) {
        var s = document.createElement("span");
        s.className = "inline-flex items-center gap-1";
        var dot = document.createElement("span");
        dot.className = "inline-block w-3 h-3 rounded-gov-pill";
        dot.style.background = colors[i % colors.length];
        s.appendChild(dot);
        s.appendChild(document.createTextNode("מתחם: " + t));
        lg.appendChild(s);
      });
      if (meta.np) {
        var s2 = document.createElement("span");
        s2.className = "inline-flex items-center gap-1";
        var box = document.createElement("span");
        box.className = "inline-block w-3 h-3 border-2 border-dashed border-ink-deep";
        s2.appendChild(box);
        s2.appendChild(document.createTextNode("תחום תוכנית מתאר"));
        lg.appendChild(s2);
      }
    }
    map.fitBounds(meta.bounds, { padding: [8, 8] });
  })();
</script>
{%- endif %}

<script>
  (function () {
    var d = {{ model.charts.cities | tojson }};
    var el = document.getElementById("chart-cities");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0, data: d.series.map(function (s) { return s.name; }) },
      grid: { left: 16, right: 24, top: 40, bottom: 16, containLabel: true },
      xAxis: { type: "value", minInterval: 1 },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: d.series.map(function (s) { return { type: "bar", stack: "t", name: s.name, data: s.data, barMaxWidth: 26 }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.units_city | tojson }};
    var el = document.getElementById("chart-units");
    if (!el) { return; }
    var narrow = el.clientWidth < 500;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: [window.GOVIL_PALETTE[1], window.GOVIL_PALETTE[0]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        return echarts.format.encodeHTML(d.names[i]) + "<br>קיימות: " + d.kaya[i].toLocaleString("he-IL") +
          "<br>תוספת: " + d.tosa[i].toLocaleString("he-IL") + "<br>מוצעות: " + d.mutz[i].toLocaleString("he-IL");
      } },
      legend: { top: 0, data: ["יח״ד קיימות", "תוספת מתוכננת"] },
      grid: { left: 16, right: 24, top: 40, bottom: 16, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: !narrow } },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [
        { type: "bar", stack: "u", name: "יח״ד קיימות", data: d.kaya, barMaxWidth: 26 },
        { type: "bar", stack: "u", name: "תוספת מתוכננת", data: d.tosa, barMaxWidth: 26 }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.track | tojson }};
    var el = document.getElementById("chart-track");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        return echarts.format.encodeHTML(p.name) + "<br>" + p.value.toLocaleString("he-IL") + " מתחמים (" + p.percent + "%)";
      } },
      legend: { bottom: 0 },
      series: [{ type: "pie", radius: ["40%", "68%"], center: ["50%", "45%"], data: d,
        label: { formatter: "{d}%" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.maslul | tojson }};
    var el = document.getElementById("chart-maslul");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 48, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "value", minInterval: 1 },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [{ type: "bar", name: "מתחמים", data: d.n, barMaxWidth: 26,
        label: { show: true, position: "right" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

{%- if model.flags.years %}
<script>
  (function () {
    var d = {{ model.charts.years | tojson }};
    var el = document.getElementById("chart-years");
    if (!el) { return; }
    var last = d.x.length - 1;
    var bars = d.n.map(function (v, i) {
      return (d.partial && i === last) ? { value: v, itemStyle: { color: "#b7d2f7" } } : v;
    });
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: [window.GOVIL_PALETTE[0], window.GOVIL_PALETTE[1]],
      tooltip: { trigger: "axis", formatter: function (p) {
        var i = p[0].dataIndex;
        return echarts.format.encodeHTML(d.x[i]) + ((d.partial && i === last) ? " (שנה חלקית)" : "") +
          "<br>מתחמים: " + d.n[i].toLocaleString("he-IL") + "<br>תוספת יח״ד: " + d.tosa[i].toLocaleString("he-IL");
      } },
      legend: { top: 0, data: ["מתחמים", "תוספת יח״ד"] },
      grid: { left: 16, right: 16, top: 40, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: 45 } },
      yAxis: [{ type: "value", minInterval: 1, name: "מתחמים" }, { type: "value", name: "יח״ד", splitLine: { show: false } }],
      series: [
        { type: "bar", name: "מתחמים", data: bars, barMaxWidth: 28 },
        { type: "line", name: "תוספת יח״ד", yAxisIndex: 1, data: d.tosa, symbolSize: 6 }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

<script>
  (function () {
    var d = {{ model.charts.appr_track | tojson }};
    var el = document.getElementById("chart-appr");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: [window.GOVIL_PALETTE[0], window.GOVIL_PALETTE[6]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0, data: ["תוכנית בתוקף", "ללא תוכנית בתוקף"] },
      grid: { left: 16, right: 24, top: 40, bottom: 16, containLabel: true },
      xAxis: { type: "value", minInterval: 1 },
