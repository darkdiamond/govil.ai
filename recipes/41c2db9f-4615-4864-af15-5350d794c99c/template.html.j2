      return {
        color: ["#0068f5", "#0b3668"],
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { bottom: 0, left: "center" },
        grid: { left: 16, right: 24, top: 8, bottom: 36, containLabel: true },
