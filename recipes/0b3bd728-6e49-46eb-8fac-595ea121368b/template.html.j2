{%- macro fallback(tbl, cap) %}
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ cap }}</caption>
      <thead><tr>{% for h_ in tbl.headers %}<th scope="col">{{ h_ }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for r in tbl.rows %}
        <tr>{% for c in r %}{% if loop.first %}<th scope="row">{{ c }}</th>{% else %}<td>{{ c }}</td>{% endif %}{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
{%- endmacro %}
{%- macro chart_section(cid, icon, title, note, aria, cap, tbl, h="h-64 md:h-80") %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/{{ icon }}.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ title }}</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ note }}</p>
  <div id="{{ cid }}" class="{{ h }}" role="img" aria-label="{{ aria }}"></div>
{{ fallback(tbl, cap) }}
</section>
{%- endmacro %}
<h1>מרכזי מסחר, קניונים ואזורי תעשייה בבאר שבע</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מתחמי מרכזים מסחריים: תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור מרכז מסחרי או קניון לפי שם ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: שם המתחם, סוג המתחם ותיאור.</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
{%- for key in ["areas", "total", "types", "median"] %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.kpis[key].label }}</div>
  </div>
{%- endfor %}
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מפת המתחמים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.map_note }}</p>
  <div id="map-areas" class="h-72 md:h-[420px]"></div>
</section>

{{ chart_section("chart-types", "list", "מתחמים לפי סוג", model.labels.types_note, model.labels.types_aria, model.labels.types_cap, model.tables.types, "h-72 md:h-96") }}

{{ chart_section("chart-share", "database", "חלק במספר המתחמים מול חלק בשטח", model.labels.share_note, model.labels.share_aria, model.labels.share_cap, model.tables.share, "h-80 md:h-[460px]") }}

{{ chart_section("chart-tree", "building-2", "שטח המתחמים לפי משפחה", model.labels.tree_note, model.labels.tree_aria, model.labels.tree_cap, model.tables.fam, "h-80 md:h-[460px]") }}

{{ chart_section("chart-top", "database", "המתחמים הגדולים ביותר", model.labels.top_note, model.labels.top_aria, model.labels.top_cap, model.tables.top, "h-80 md:h-[460px]") }}

{{ chart_section("chart-size", "database", "התפלגות גודל המתחמים", model.labels.size_note, model.labels.size_aria, model.labels.size_cap, model.tables.size) }}

{% if model.flags.comp %}
{{ chart_section("chart-comp", "building-2", "צורת המתחמים: קומפקטי או מוארך", model.labels.comp_note, model.labels.comp_aria, model.labels.comp_cap, model.tables.comp, "h-72 md:h-96") }}
{% endif %}

{% if model.flags.dist %}
{{ chart_section("chart-dist", "map-pin", "מרחק מהמרכז", model.labels.dist_note, model.labels.dist_aria, model.labels.dist_cap, model.tables.dist) }}
{% endif %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">רשימת המתחמים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.list_note }}</p>
  <div class="overflow-x-auto">
  <table class="w-full text-sm">
    <caption class="sr-only">{{ model.labels.list_cap }}</caption>
    <thead><tr>{% for h_ in model.tables.list.headers %}<th scope="col">{{ h_ }}</th>{% endfor %}</tr></thead>
    <tbody>
{%- for r in model.tables.list.rows %}
      <tr><th scope="row">{{ r[0] }}</th><td>{{ r[1] }}</td><td>{{ r[2] }}</td><td>{{ r[3] }}</td></tr>
{%- endfor %}
    </tbody>
  </table>
  </div>
</section>

<script>
  GovMap.create({
    container: "#map-areas",
    resourceId: {{ inputs.areas[0].id | tojson }},
    latField: "lat",
    lngField: "lon",
    projection: "wgs84",
    cluster: false,
    popupTitleField: "Name",
    popupFields: [{ field: "remarks", label: "סוג המתחם" }]
  });
</script>

<script>
  (function () {
    function mk(id) {
      var el = document.getElementById(id);
      if (!el) { return null; }
      var c = echarts.init(el);
      window.addEventListener("resize", function () { c.resize(); });
      return c;
    }
    window.__mk = mk;
    window.__hbar = function (id, names, values, unit) {
      var c = mk(id); if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v.toLocaleString("he-IL") + " " + unit; } },
        grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 4 },
        yAxis: { type: "category", data: names.slice().reverse(), axisLabel: { width: 120, overflow: "truncate" } },
        series: [{ type: "bar", name: unit, data: values.slice().reverse() }]
      }));
    };
    window.__stack = function (id, d, unit) {
      var c = mk(id); if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { top: 0 },
        grid: { left: 8, right: 16, top: 48, bottom: 24, containLabel: true },
        xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, fontSize: 11, rotate: window.innerWidth < 500 ? 30 : 0 } },
        yAxis: { type: "value", minInterval: 1 },
        series: d.series.map(function (s) { return { type: "bar", stack: "t", name: s.name, data: s.data }; })
      }));
    };
  })();
</script>

<script>
  (function () {
    var T = {{ model.charts.types | tojson }};
    window.__hbar("chart-types", T.names, T.values, "מתחמים");
    var P = {{ model.charts.top | tojson }};
    window.__hbar("chart-top", P.names, P.values, "דונם");
  })();
</script>

<script>
  (function () {
    var S = {{ model.charts.share | tojson }};
    var c = window.__mk("chart-share");
    if (!c) { return; }
    var n = S.names.slice().reverse();
    c.setOption(window.GovEcharts.option({
      color: [window.GOVIL_PALETTE[0], window.GOVIL_PALETTE[4]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v.toLocaleString("he-IL") + "%"; } },
      legend: { top: 0 },
      grid: { left: 8, right: 24, top: 40, bottom: 24, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: n, axisLabel: { width: 120, overflow: "truncate" } },
      series: [
        { type: "bar", name: "שיעור מהשטח", data: S.area_pct.slice().reverse() },
        { type: "bar", name: "שיעור מהמתחמים", data: S.count_pct.slice().reverse() }
      ]
    }));
  })();
</script>

<script>
  (function () {
    var R = {{ model.charts.tree | tojson }};
    var c = window.__mk("chart-tree");
    if (!c) { return; }
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: {
        formatter: function (p) {
          var t = p.data && p.data.type ? " (" + echarts.format.encodeHTML(p.data.type) + ")" : "";
          return echarts.format.encodeHTML(p.name) + t + "<br>" + p.value.toLocaleString("he-IL") + " דונם";
        }
      },
      series: [{
        type: "treemap", data: R, roam: false, nodeClick: false, breadcrumb: { show: false },
        width: "100%", height: "100%", top: 0, left: 0,
        label: { show: true, fontSize: 11, overflow: "truncate" },
        upperLabel: { show: true, height: 22, color: "#fff", fontWeight: 600 },
        levels: [
          { itemStyle: { borderColor: "#fff", borderWidth: 3, gapWidth: 3 } },
          { colorSaturation: [0.35, 0.6], itemStyle: { borderColorSaturation: 0.7, gapWidth: 1, borderWidth: 1 } }
        ]
      }]
    }));
  })();
</script>

<script>
  (function () {
    window.__stack("chart-size", {{ model.charts.size | tojson }}, "מתחמים");
    window.__stack("chart-dist", {{ model.charts.dist | tojson }}, "מתחמים");
  })();
</script>

<script>
  (function () {
    var M = {{ model.charts.comp | tojson }};
    var c = window.__mk("chart-comp");
    if (!c) { return; }
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
      xAxis: { type: "value", min: 0, max: 1 },
      yAxis: { type: "category", data: M.names, axisLabel: { width: 120, overflow: "truncate" } },
      series: [{ type: "bar", name: "מדד קומפקטיות חציוני", data: M.values }]
    }));
  })();
</script>
