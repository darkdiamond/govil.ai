<h1>מדבירים מורשים</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">בדיקת רישיון מדביר ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המרשם: שם פרטי, שם משפחה, מספר רישיון או יישוב</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
{%- for k in ["licences", "holders", "in_force", "cities", "single", "peak_year"] %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[k].tone }} mb-1" dir="ltr">{{ model.kpis[k].display }}</div>
    <div class="text-sm text-subtle">{{ model.labels[k ~ "_kpi"] }}</div>
  </div>
{%- endfor %}
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">סוגי הרישיון</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.types_note }}</p>
  <div id="chart-types" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.types_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.types_caption }}</caption>
      <thead><tr><th scope="col">סוג רישיון</th><th scope="col">משפחה</th><th scope="col">רישיונות</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.types %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.fam }}</td><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

{% if model.flags.expiry %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מתי פוקעים הרישיונות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.year_note }}</p>
  <div id="chart-year" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.year_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.year_caption }}</caption>
      <thead><tr><th scope="col">שנת פקיעה</th>{% for f in model.tables.fams %}<th scope="col">{{ f }}</th>{% endfor %}<th scope="col">סה״כ</th></tr></thead>
      <tbody>
{%- for r in model.tables.year %}
        <tr><th scope="row">{{ r.name }}</th>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}<td>{{ r.total }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">גלי חידוש: פקיעה לפי חודש</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.heat_note }}</p>
  <div id="chart-heat" class="h-72 md:h-96" role="img" data-fallback="explorer" aria-label="{{ model.labels.heat_aria }}"></div>
</section>
{% endif %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">היישובים המובילים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cities_note }}</p>
  <div id="chart-cities" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.cities_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.cities_caption }}</caption>
      <thead><tr><th scope="col">יישוב</th>{% for f in model.tables.fams %}<th scope="col">{{ f }}</th>{% endfor %}<th scope="col">סה״כ</th></tr></thead>
      <tbody>
{%- for r in model.tables.cities %}
        <tr><th scope="row">{{ r.name }}</th>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}<td>{{ r.total }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">פיזור בין יישובים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.spread_note }}</p>
    <div id="chart-spread" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.spread_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.spread_caption }}</caption>
        <thead><tr><th scope="col">רישיונות ביישוב</th><th scope="col">יישובים</th><th scope="col">רישיונות</th></tr></thead>
        <tbody>
{%- for r in model.tables.spread %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.cities }}</td><td>{{ r.lics }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
{% if model.flags.bands %}
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/list.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">ותק לפי מספר רישיון</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.bands_note }}</p>
    <div id="chart-bands" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.bands_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.bands_caption }}</caption>
        <thead><tr><th scope="col">טווח מספרים</th>{% for f in model.tables.fams %}<th scope="col">{{ f }}</th>{% endfor %}<th scope="col">סה״כ</th></tr></thead>
        <tbody>
{%- for r in model.tables.bands %}
          <tr><th scope="row">{{ r.name }}</th>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}<td>{{ r.total }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
      </div>
    </details>
  </section>
{% endif %}
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle">המאגר מכיל את כלל המדבירים המורשים בישראל, אשר עברו הסמכה וקיבלו רישיון מהמשרד להגנת הסביבה. במאגר ניתן למצוא את פרטי המדביר, תוקף הרישיון וסוג הרישיון.</p>
</section>

<script>
  (function () {
    var P = window.GOVIL_PALETTE;
    var FP = {{ model.charts.fam_pal | tojson }};
    var FC = FP.map(function (i) { return P[i % P.length]; });
    function fmt(v) { return Number(v).toLocaleString("he-IL"); }

    function stacked(id, d, opts) {
      opts = opts || {};
      var el = document.getElementById(id);
      if (!el) return;
      var c = echarts.init(el);
      var narrow = el.clientWidth < 500;
      var tip = { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var s = ps[0].axisValue, t = 0;
        ps.forEach(function (p) { if (p.value) { t += p.value; s += "<br>" + p.marker + p.seriesName + ": " + fmt(p.value); } });
        return s + "<br>סה״כ: " + fmt(t) + " רישיונות";
      } };
      var cat = { type: "category", data: d.names };
      var val = { type: "value", minInterval: 1, axisLabel: { fontSize: narrow ? 10 : 12 } };
      if (opts.horizontal) {
        var lw = Math.min(opts.lw || 120, Math.round(el.clientWidth * 0.35));
        cat.inverse = true;
        cat.axisLabel = { width: lw, overflow: "truncate", fontSize: narrow ? 10 : 12, interval: 0 };
      } else {
        cat.axisLabel = { interval: 0, rotate: narrow ? 45 : 0, fontSize: narrow ? 9 : 11 };
      }
      c.setOption(window.GovEcharts.option({
        color: FC,
        tooltip: tip,
        legend: { bottom: 0, itemGap: narrow ? 8 : 14, textStyle: { fontSize: narrow ? 10 : 12 } },
        grid: { left: 16, right: 24, top: 16, bottom: narrow ? 84 : 52, containLabel: true },
        xAxis: opts.horizontal ? val : cat,
        yAxis: opts.horizontal ? cat : val,
        series: d.series.map(function (s) { return { type: "bar", stack: "a", name: s.name, data: s.data, barMaxWidth: 32 }; })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    {% if model.flags.expiry %}stacked("chart-year", {{ model.charts.year | tojson }});{% endif %}
    stacked("chart-cities", {{ model.charts.cities | tojson }}, { horizontal: true, lw: 120 });
    {% if model.flags.bands %}stacked("chart-bands", {{ model.charts.bands | tojson }});{% endif %}

    var t = {{ model.charts.types | tojson }};
    var tel = document.getElementById("chart-types");
    var tn = tel.clientWidth < 500;
    var tc = echarts.init(tel);
    tc.setOption(window.GovEcharts.option({
      color: P,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        return ps[0].axisValue + ": " + fmt(ps[0].value) + " רישיונות";
      } },
      grid: { left: 16, right: 48, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", minInterval: 1, splitNumber: tn ? 2 : 5, axisLabel: { show: !tn, fontSize: 12 } },
      yAxis: { type: "category", data: t.names, inverse: true,
               axisLabel: { interval: 0, width: Math.min(230, Math.round(tel.clientWidth * 0.45)), overflow: "truncate", fontSize: tn ? 10 : 12 } },
      series: [{ type: "bar", name: "רישיונות", barMaxWidth: 28,
                 label: { show: true, position: "right", color: "#0c3058", fontSize: 11, formatter: function (p) { return fmt(p.value); } },
                 data: t.values.map(function (v, i) { return { value: v, itemStyle: { color: FC[t.fam_idx[i] % FC.length] } }; }) }]
    }));
    window.addEventListener("resize", function () { tc.resize(); });

    var s = {{ model.charts.spread | tojson }};
    var sel = document.getElementById("chart-spread");
    var sn = sel.clientWidth < 500;
    var sc = echarts.init(sel);
    sc.setOption(window.GovEcharts.option({
      color: [P[0], P[1]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0, data: ["יישובים", "רישיונות"] },
      grid: { left: 16, right: 16, top: 24, bottom: sn ? 72 : 48, containLabel: true },
      xAxis: { type: "category", data: s.names, axisLabel: { interval: 0, rotate: sn ? 35 : 0, fontSize: sn ? 10 : 12 } },
      yAxis: { type: "value", minInterval: 1 },
      series: [
        { type: "bar", name: "יישובים", data: s.cities, barMaxWidth: 28, label: { show: true, position: "top", fontSize: 10, color: "#0c3058" } },
        { type: "bar", name: "רישיונות", data: s.lics, barMaxWidth: 28, label: { show: !sn, position: "top", fontSize: 10, color: "#0c3058" } }
      ]
    }));
    window.addEventListener("resize", function () { sc.resize(); });
  })();
</script>

{% if model.flags.expiry %}
<script>
  (function () {
    var h = {{ model.charts.heat | tojson }};
    var el = document.getElementById("chart-heat");
    var narrow = el.clientWidth < 600;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return h.x[p.value[0]] + " " + h.y[p.value[1]] + ": " + Number(p.value[2]).toLocaleString("he-IL") + " רישיונות";
      } },
      grid: { left: 8, right: 8, top: 8, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true },
               axisLabel: { interval: 0, rotate: narrow ? 60 : 0, fontSize: narrow ? 9 : 11 } },
      yAxis: { type: "category", data: h.y, inverse: true, splitArea: { show: true },
               axisLabel: { interval: 0, fontSize: narrow ? 10 : 12 } },
      visualMap: {
        min: 0, max: h.max, calculable: true, dimension: 2,
        orient: "horizontal", left: "center", bottom: 4, itemHeight: 120,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells, label: { show: !narrow, fontFamily: "Rubik", fontSize: 10 },
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{% endif %}
