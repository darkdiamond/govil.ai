{%- macro head(icon, title) -%}
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/{{ icon }}.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ title }}</h2>
  </div>
{%- endmacro -%}
<h1>מאגר עסקים קולטי קהל</h1>

<section class="card p-5 mb-6">
  {{ head("info", "תקציר") }}
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
{%- for key in ["total", "signs", "typed", "center"] %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.kpis[key].label }}</div>
  </div>
{%- endfor %}
</div>

<section class="card p-5 mb-6">
  {{ head("circle-check", "תובנות עיקריות") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  {{ head("map-pin", "מפת העסקים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.map_note }}</p>
  <div id="map-main" class="h-72 md:h-[420px]"></div>
</section>

<section class="card p-5 mb-6">
  {{ head("database", "קבוצות סוג העסק") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cats_note }}</p>
  <div id="chart-cats" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.cats_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.cats_caption }}</caption>
      <thead><tr><th scope="col">קבוצה</th><th scope="col">עסקים</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.cats %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  {{ head("database", "הניסוחים הנפוצים בשדה סוג העסק") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.kinds_note }}</p>
  <div id="chart-kinds" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.kinds_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.kinds_caption }}</caption>
      <thead><tr><th scope="col">סוג כפי שנרשם</th><th scope="col">רשומות</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.kinds %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  {{ head("map-pin", "הרחובות עם הכי הרבה עסקים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.streets_note }}</p>
  <div id="chart-streets" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.streets_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.streets_caption }}</caption>
      <thead><tr><th scope="col">רחוב</th><th scope="col">עסקים</th><th scope="col">שיעור</th><th scope="col">שלטים</th></tr></thead>
      <tbody>
{%- for r in model.tables.streets %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td><td>{{ r.signs }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{% if model.has_geo %}
<section class="card p-5 mb-6">
  {{ head("map-pin", "צפיפות לפי אזור") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.grid_note }}</p>
  <div id="chart-grid" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.grid_aria }}" data-fallback="explorer"></div>
</section>

<section class="card p-5 mb-6">
  {{ head("database", "מה יש במרכז ומה בשוליים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.ring_note }}</p>
  <div id="chart-ring" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.ring_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.ring_caption }}</caption>
      <thead><tr><th scope="col">קבוצה</th>
{%- for h in model.tables.ring_head %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for r in model.tables.ring %}
        <tr><th scope="row">{{ r.name }}</th>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>
{% endif %}
<section class="card p-5 mb-6">
  {{ head("database", "כמה שלטים לכל עסק") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.signs_note }}</p>
  <div id="chart-signs" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.signs_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.signs_caption }}</caption>
      <thead><tr><th scope="col">שלטים לעסק</th><th scope="col">עסקים</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.signs %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  {{ head("database", "מה כתוב על השלטים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.sign_types_note }}</p>
  <div id="chart-sign-types" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.sign_types_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.sign_types_caption }}</caption>
      <thead><tr><th scope="col">סוג תוכן</th><th scope="col">שלטים</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.sign_types %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{% if model.has_mean %}
<section class="card p-5 mb-6">
  {{ head("database", "אילו עסקים מציבים הכי הרבה שלטים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.mean_note }}</p>
  <div id="chart-mean" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.mean_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.mean_caption }}</caption>
      <thead><tr><th scope="col">קבוצה</th><th scope="col">שלטים לעסק (ממוצע)</th><th scope="col">עסקים</th></tr></thead>
      <tbody>
{%- for r in model.tables.mean %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.mean }}</td><td>{{ r.count }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{% endif %}
{% if model.has_names %}
<section class="card p-5 mb-6">
  {{ head("database", "שמות עם כמה כתובות") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.names_note }}</p>
  <div id="chart-names" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.names_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.names_caption }}</caption>
      <thead><tr><th scope="col">שם</th><th scope="col">רשומות</th><th scope="col">שלטים</th></tr></thead>
      <tbody>
{%- for r in model.tables.names %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.signs }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{% endif %}
<section class="card p-5 mb-6">
  {{ head("database", "כמה מהרשומות מלאות") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.fields_note }}</p>
  <div id="chart-fields" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.fields_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.fields_caption }}</caption>
      <thead><tr><th scope="col">שדה</th><th scope="col">רשומות</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.fields %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<script>
  (function () {
    function mk(id) {
      var el = document.getElementById(id);
      if (!el) { return null; }
      var c = echarts.init(el);
      window.addEventListener("resize", function () { c.resize(); });
      return c;
    }
    function hbar(id, d, unit) {
      var c = mk(id);
      if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value", axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 130, overflow: "truncate" } },
        series: [{ type: "bar", name: unit, data: d.values.slice().reverse() }]
      }));
    }
    function col(id, d, unit) {
      var c = mk(id);
      if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 16, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, hideOverlap: true } },
        yAxis: { type: "value" },
        series: [{ type: "bar", name: unit, data: d.values }]
      }));
    }
    hbar("chart-cats", {{ model.charts.cats | tojson }}, "עסקים");
    hbar("chart-kinds", {{ model.charts.kinds | tojson }}, "רשומות");
    hbar("chart-streets", {{ model.charts.streets | tojson }}, "עסקים");
    col("chart-signs", {{ model.charts.signs | tojson }}, "עסקים");
    hbar("chart-sign-types", {{ model.charts.sign_types | tojson }}, "שלטים");
    hbar("chart-mean", {{ model.charts.mean | tojson }}, "שלטים לעסק");
    hbar("chart-names", {{ model.charts.names | tojson }}, "רשומות");
    var f = {{ model.charts.fields | tojson }};
    var cf = mk("chart-fields");
    if (cf) {
      cf.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + "%"; } },
        grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
        yAxis: { type: "category", data: f.names.slice().reverse() },
        series: [{ type: "bar", name: "אחוז", data: f.pct.slice().reverse() }]
      }));
    }
  })();
</script>
{% if model.has_geo %}
<script>
  (function () {
    var g = {{ model.charts.grid | tojson }};
    var el = document.getElementById("chart-grid");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top" },
      grid: { left: 8, right: 16, top: 16, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: g.x, splitArea: { show: true }, name: "קו אורך", nameLocation: "middle", nameGap: 28 },
      yAxis: { type: "category", data: g.y, splitArea: { show: true }, name: "קו רוחב" },
      visualMap: { min: 0, max: g.max, dimension: 2, calculable: false, orient: "horizontal", left: "center", bottom: 0,
                   inRange: { color: ["#f1f7ff", "#0068f5", "#0b3668"] } },
      series: [{ type: "heatmap", name: "עסקים", data: g.data, label: { show: false } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.ring | tojson }};
    var el = document.getElementById("chart-ring");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + "%"; } },
      legend: { type: "scroll", bottom: 0 },
      grid: { left: 8, right: 16, top: 16, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: d.rings, name: "מרחק מהמרכז (ק״מ)", nameLocation: "middle", nameGap: 28 },
      yAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      series: d.series.map(function (s) {
        return { type: "bar", stack: "mix", name: s.name, data: s.data };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{% endif %}
<script>
  GovMap.create({
    container: "#map-main",
    resourceId: {{ inputs.main[0].id | tojson }},
    latField: "location_lat",
    lngField: "location_lng",
    projection: "wgs84",
    fitBounds: false,
    initialView: {{ model.map_view | tojson }},
    popupTitleField: "business_name",
    popupFields: [
      { field: "full_address", label: "כתובת" },
      { field: "business_kind", label: "סוג" }
    ]
  });
</script>
