  {{ callout("business") }}
  {{ gov.chart("chart-sector", model.labels.sector_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.sector_table, ["מגזר מבצע", "מיליוני ₪", "חלק מההוצאה"], model.tables.sector, ltr=(1, 2)) }}
</section>

