      color: [pal[0], pal[2], pal[1], pal[5], pal[6], pal[3], pal[8]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 124, bottom: 24, containLabel: true },
      xAxis: { type: "category", boundaryGap: false, data: d.x },
      yAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      series: d.names.map((n, k) => ({ type: "line", stack: "a", areaStyle: {}, showSymbol: false, name: n, data: d.series[k] }))
