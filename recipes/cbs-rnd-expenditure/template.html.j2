  {{ gov.table(model.labels.oecd_table, ["מדינה", "מו\"פ כאחוז מהתמ\"ג", "הוצאה למו\"פ לנפש (דולרים)"], model.tables.oecd, ltr=(1, 2)) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>הנתונים מתוך ההודעה השנתית לתקשורת של הלשכה המרכזית לסטטיסטיקה על ההוצאה הלאומית למחקר ופיתוח. ההוצאה הלאומית כוללת מו"פ שבוצע בישראל במגזר העסקי, במוסדות להשכלה גבוהה, בממשלה ובמלכ"רים פרטיים, לרבות מרכזי פיתוח של חברות זרות.</li>
    <li>"מגזר מבצע" הוא מי שעושה את המחקר בפועל, ו"מגזר מממן" הוא מי שמשלם עליו. המגזר העסקי כולל בתי חולים, ובשנים האחרונות גם מו"פ ביטחוני שמבוצע בחברות.</li>
    <li>נתוני השנה האחרונה ארעיים, והלמ"ס מעדכנת את נתוני השנים הקודמות בכל הודעה, ולכן לוחות שונים בהודעה עשויים להציג ערכים מעט שונים לאותה שנה. העמוד מציג את ההודעה האחרונה.</li>
  </ul>
</section>

<script>
  (function () {
    const d = {{ model.charts.trend | tojson }};
    const pal = window.GOVIL_PALETTE;
    const series = [{ type: "line", name: "מחירים שוטפים", data: d.cur, showSymbol: false }];
    if (d.base) series.unshift({ type: "line", name: "מחירי " + d.base, data: d.real, showSymbol: false, lineStyle: { width: 3 } });
    const chart = echarts.init(document.getElementById("chart-trend"));
    chart.setOption(window.GovEcharts.option({
      color: d.base ? [pal[0], pal[2]] : [pal[2]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) + " מיליארד ₪" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: (v) => v.toLocaleString("he-IL") } },
      series: series
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- if model.flags.growth %}
  (function () {
    const d = {{ model.charts.growth | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-growth"));
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : (v > 0 ? "+" : "") + Number(v).toFixed(1) + "%" },
      grid: { left: 16, right: 16, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
      series: [{
        type: "bar",
        data: d.y.map((v) => ({ value: v, itemStyle: { color: v != null && v < 0 ? "#dc3545" : pal[0] } }))
      }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
  (function () {
    const d = {{ model.charts.sector | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-sector"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2], pal[1], pal[6]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 2 }) + " מיליארד ₪" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 56, bottom: 24, containLabel: true },
      xAxis: { type: "category", boundaryGap: false, data: d.x },
      yAxis: { type: "value" },
      series: d.names.map((n, k) => ({ type: "line", stack: "a", areaStyle: {}, showSymbol: false, name: n, data: d.series[k] }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- if model.flags.financing %}
  (function () {
    const d = {{ model.charts.financing | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-financing"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1], pal[2], pal[5], pal[6]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 2 }) + " מיליארד ₪" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 56, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value" },
      series: d.names.map((n, k) => ({ type: "bar", stack: "a", name: n, data: d.series[k] }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.exptype %}
  (function () {
    const d = {{ model.charts.exptype | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-exptype"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2], pal[6]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 8, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 90, overflow: "break" } },
      series: d.types.map((n, k) => ({ type: "bar", stack: "a", name: n, data: d.series[k] }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.govtype %}
  (function () {
    const d = {{ model.charts.govtype | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-govtype"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2], pal[1]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Math.round(v).toLocaleString("he-IL") + " מיליון ₪" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 56, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: (v) => v.toLocaleString("he-IL") } },
      series: d.names.map((n, k) => ({ type: "bar", stack: "a", name: n, data: d.series[k] }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.flows %}
  (function () {
    const d = {{ model.charts.flows | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-flows"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2], pal[1], pal[6], pal[5]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Math.round(v).toLocaleString("he-IL") + " מיליון ₪" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 56, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: (v) => v.toLocaleString("he-IL") } },
      series: d.names.map((n, k) => ({ type: "bar", stack: "a", name: n, data: d.series[k] }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.ministries %}
  (function () {
    const d = {{ model.charts.ministries | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-ministries"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2], pal[1], pal[5], pal[6], pal[8]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Math.round(v).toLocaleString("he-IL") + " מיליון ₪" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 108, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: (v) => v.toLocaleString("he-IL") } },
      series: d.names.map((n, k) => ({ type: "bar", stack: "a", name: n, data: d.series[k] }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.objective %}
  (function () {
    const d = {{ model.charts.objective | tojson }};
    const pal = window.GOVIL_PALETTE;
    const n = d.years.length;
    const chart = echarts.init(document.getElementById("chart-objective"));
    chart.setOption(window.GovEcharts.option({
      color: d.years.map((y, k) => k === n - 1 ? pal[0] : pal[6]),
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 48, top: 32, bottom: 8, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 120, overflow: "break", fontSize: 11 } },
      series: d.years.map((y, k) => ({ type: "bar", name: y, data: d.series[k],
        label: { show: k === n - 1, position: "right", formatter: (p) => p.value == null ? "" : Number(p.value).toFixed(1) + "%" } }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.industry %}
  (function () {
    const d = {{ model.charts.industry | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-industry"));
