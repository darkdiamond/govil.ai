{%- if model.flags.npi %}
  (function () {
    const d = {{ model.charts.npi | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-npi"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2], pal[1], pal[6], pal[5]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + " מיליון ₪" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 64, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value" },
      series: d.names.map((n, k) => ({ type: "bar", stack: "a", name: n, data: d.series[k] }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.oecd %}
  (function () {
    const d = {{ model.charts.oecd | tojson }};
    const pal = window.GOVIL_PALETTE;
    const s = {
      type: "bar",
      data: d.gdp.map((v, i) => d.names[i] === "ישראל" ? { value: v, itemStyle: { color: pal[0] } } : v),
      label: { show: true, position: "right", formatter: (p) => Number(p.value).toFixed(1) + "%" }
    };
    if (d.avg != null) s.markLine = { symbol: "none", lineStyle: { type: "dashed", color: pal[1] }, label: { formatter: "OECD" }, data: [{ xAxis: d.avg }] };
    const chart = echarts.init(document.getElementById("chart-oecd"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[6]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => Number(v).toFixed(1) + "% מהתמ\"ג" },
      grid: { left: 16, right: 48, top: 24, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 90, overflow: "break" } },
      series: [s]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
</script>
