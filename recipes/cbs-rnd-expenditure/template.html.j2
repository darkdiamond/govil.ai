{%- if model.flags.oecd %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "ישראל מול מדינות OECD: מו\"פ כאחוז מהתמ\"ג") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.oecd_note }}</p>
  {{ callout("oecd") }}
{%- if model.labels.oecd_pc is defined %}
  <p class="m-0 mb-3 text-sm text-subtle">{{ model.labels.oecd_pc }}</p>
{%- endif %}
