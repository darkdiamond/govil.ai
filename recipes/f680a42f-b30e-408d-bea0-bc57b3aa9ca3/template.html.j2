<h1>מאגר מעונות יום: מעונות, משפחתונים וצהרונים מוכרים</h1>

<style>
  .daycare-table th, .daycare-table td { padding: 0.35rem 0.5rem; text-align: start; vertical-align: top; }
  .daycare-table tbody tr { border-top: 1px solid #c3cfe7; }
  .daycare-table thead th { font-weight: 600; color: #0b3668; }
  .daycare-table th[scope="row"] { font-weight: 600; }
</style>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור מעון יום, משפחתון או צהרון לפי שם, יישוב או סמל מעון ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: שם המעון, סמל המעון, יישוב, רחוב, הארגון המפעיל, שם המנהל וסוג המסגרת.</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.total_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.seats.tone }} mb-1" dir="ltr">{{ model.kpis.seats.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.seats_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.cities.tone }} mb-1" dir="ltr">{{ model.kpis.cities.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.cities_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.opened.tone }} mb-1" dir="ltr">{{ model.kpis.opened.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.opened_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">סוגי המסגרות: מעון, משפחתון, צהרון</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.type_note }}</p>
    <div id="chart-types" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.type_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="daycare-table mt-2 w-full text-sm">
        <caption class="sr-only">מסגרות לפי סוג</caption>
        <thead><tr><th scope="col">סוג מסגרת</th><th scope="col">מסגרות</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.types %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr" class="text-start">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">מסגרות לפי מחוז</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.dist_note }}</p>
    <div id="chart-districts" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.dist_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
        <table class="daycare-table mt-2 w-full text-sm">
          <caption class="sr-only">מסגרות לפי מחוז וסוג</caption>
          <thead><tr><th scope="col">מחוז</th><th scope="col">סה״כ</th>{% for t in model.tables.type_names %}<th scope="col">{{ t }}</th>{% endfor %}</tr></thead>
          <tbody>
{%- for r in model.tables.districts %}
            <tr><th scope="row">{{ r.name }}</th><td>{{ r.total }}</td>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}</tr>
{%- endfor %}
          </tbody>
        </table>
      </div>
    </details>
  </section>
</div>

