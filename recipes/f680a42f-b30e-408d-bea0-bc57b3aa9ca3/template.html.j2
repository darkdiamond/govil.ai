    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">מאגר מעונות יום</p>
</section>

<script>
  (function () {
    var el = document.getElementById("chart-types");
    var d = {{ model.charts.types | tojson }};
    var c = echarts.init(el);
    var narrow = el.clientWidth < 500;
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        return echarts.format.encodeHTML(p.name) + ": " + p.value.toLocaleString("he-IL") + " מסגרות (" + p.percent + "%)";
      } },
      legend: { bottom: 0, type: "plain" },
      series: [{
        type: "pie", radius: narrow ? ["32%", "58%"] : ["40%", "70%"], center: ["50%", "45%"],
        label: { show: true, formatter: function (p) { return p.value.toLocaleString("he-IL"); } },
        data: d.names.map(function (n, i) { return { name: n, value: d.values[i] }; })
      }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    function stacked(id, d, unit) {
      var el = document.getElementById(id);
      if (!el || !d) { return; }
      var c = echarts.init(el);
      var narrow = el.clientWidth < 500;
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
          var tot = 0;
          p.forEach(function (s) { tot += s.value; });
          var out = [echarts.format.encodeHTML(d.names[p[0].dataIndex]) + ": " + tot.toLocaleString("he-IL") + " " + unit];
          p.forEach(function (s) {
            if (s.value > 0) { out.push(echarts.format.encodeHTML(s.seriesName) + ": " + s.value.toLocaleString("he-IL")); }
          });
          return out.join("<br>");
        } },
        legend: { bottom: 0, type: "plain" },
        grid: { left: 12, right: 16, top: 8, bottom: 36, containLabel: true },
        xAxis: { type: "value", splitNumber: narrow ? 3 : 5 },
        yAxis: { type: "category", data: d.names, inverse: true,
          axisLabel: { width: narrow ? 110 : 200, overflow: "truncate", fontSize: narrow ? 11 : 12 } },
        series: d.series.map(function (s) {
          return { type: "bar", name: s.name, stack: "s", data: s.data };
        })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    stacked("chart-districts", {{ model.charts.districts | tojson }}, "מסגרות");
    stacked("chart-cities", {{ model.charts.cities | tojson }}, "מסגרות");
    stacked("chart-orgs", {{ model.charts.orgs | tojson }}, "מסגרות");
    stacked("chart-seat-cities", {{ model.charts.seat_cities | tojson }}, "מקומות");
    stacked("chart-seat-districts", {{ model.charts.seat_districts | tojson }}, "מקומות");
  })();
</script>

<script>
  (function () {
    var el = document.getElementById("chart-sizes");
    if (!el) { return; }
    var d = {{ model.charts.sizes | tojson }};
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 12, right: 12, top: 24, bottom: 8, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, fontSize: 11 } },
      yAxis: { type: "value" },
      series: [{ type: "bar", name: "מסגרות", data: d.values, label: { show: true, position: "top" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var el = document.getElementById("chart-opened");
    if (!el) { return; }
    var d = {{ model.charts.opened | tojson }};
    var c = echarts.init(el);
    var narrow = el.clientWidth < 500;
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        var out = [echarts.format.encodeHTML(d.names[i]) + ": " + d.totals[i].toLocaleString("he-IL") + " מסגרות"];
        p.forEach(function (s) {
          if (s.value > 0) { out.push(echarts.format.encodeHTML(s.seriesName) + ": " + s.value.toLocaleString("he-IL")); }
        });
        return out.join("<br>");
      } },
      legend: { bottom: 0, type: "plain" },
      grid: { left: 12, right: 12, top: 16, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: { fontSize: narrow ? 10 : 12, rotate: narrow ? 45 : 0 } },
      yAxis: { type: "value" },
      series: d.series.map(function (s) {
        return { type: "bar", name: s.name, stack: "o", data: s.data };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
