<h1>דו"ח מהירות השחרור: זמני שחרור טובין מהמכס</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.total_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.comm_n.tone }} mb-1" dir="ltr">{{ model.kpis.comm_n.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.comm_n_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.hc.tone }} mb-1" dir="ltr">{{ model.kpis.hc.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.hc_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.hp.tone }} mb-1" dir="ltr">{{ model.kpis.hp.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.hp_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.queue.tone }} mb-1" dir="ltr">{{ model.kpis.queue.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.queue_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.span.tone }} mb-1" dir="ltr">{{ model.kpis.span.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.span_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">זמן השחרור הממוצע לאורך זמן</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.time_note }}</p>
  <div id="chart-time" data-fallback="explorer" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.time_aria }}"></div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">כמה הצהרות יבוא מוגשות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.vol_note }}</p>
  <div id="chart-volume" data-fallback="explorer" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.vol_aria }}"></div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">סיכום שנתי</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.yearly_note }}</p>
  <div id="chart-yearly" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.yearly_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.yearly_aria }}</caption>
      <thead><tr><th scope="col">שנה</th><th scope="col">כל ההצהרות</th><th scope="col">הצהרות מסחריות</th><th scope="col">שעות, מסחרי</th><th scope="col">שעות, אישי</th><th scope="col">מסחרי בתור חובה</th></tr></thead>
      <tbody>
{%- for r in model.tables.yearly %}
        <tr><th scope="row">{{ r.year }}</th><td>{{ r.total }}</td><td>{{ r.comm }}</td><td>{{ r.hc }}</td><td>{{ r.hp }}</td><td>{{ r.qc }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">עונתיות ביבוא מסחרי: חודש ושנה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.heat_note }}</p>
  <div id="chart-heat" data-fallback="explorer" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.heat_aria }}"></div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">הצהרות לפי בית מכס</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.houses_note }}</p>
  <div id="chart-houses" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.houses_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.houses_aria }}</caption>
      <thead><tr><th scope="col">בית מכס</th><th scope="col">הצהרות</th><th scope="col">חלק</th><th scope="col">מתוכן מסחריות</th><th scope="col">שעות, מסחרי</th><th scope="col">בתור חובה</th></tr></thead>
      <tbody>
{%- for r in model.tables.houses %}
        <tr><th scope="row">{{ r.house }}</th><td>{{ r.n }}</td><td>{{ r.share }}</td><td>{{ r.nc }}</td><td>{{ r.hc }}</td><td>{{ r.qs }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
{%- if model.flags.house_time %}
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">זמן שחרור ביבוא מסחרי לפי בית מכס</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.house_time_note }}</p>
    <div id="chart-house-time" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.house_time_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.house_time_aria }}</caption>
        <thead><tr><th scope="col">בית מכס</th><th scope="col">שעות</th><th scope="col">ימים</th><th scope="col">הצהרות מסחריות</th></tr></thead>
        <tbody>
{%- for r in model.tables.house_time %}
          <tr><th scope="row">{{ r.house }}</th><td>{{ r.h }}</td><td>{{ r.d }}</td><td>{{ r.n }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
{%- endif %}
{%- if model.flags.house_queue %}
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/triangle-alert.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">תור חובה לפי בית מכס</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.queue_note }}</p>
    <div id="chart-house-queue" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.queue_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.queue_aria }}</caption>
        <thead><tr><th scope="col">בית מכס</th><th scope="col">בתור חובה</th><th scope="col">הצהרות</th></tr></thead>
        <tbody>
{%- for r in model.tables.house_queue %}
          <tr><th scope="row">{{ r.house }}</th><td>{{ r.s }}</td><td>{{ r.n }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
{%- endif %}
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">זמן שחרור לפי תהליך הצהרה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.proc_note }}</p>
  <div id="chart-proc" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.proc_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.proc_aria }}</caption>
      <thead><tr><th scope="col">תהליך</th><th scope="col">סוג</th><th scope="col">הצהרות</th><th scope="col">שעות בממוצע</th><th scope="col">ימים בממוצע</th><th scope="col">מינימום חודשי טיפוסי (דקות)</th><th scope="col">מקסימום חודשי טיפוסי (ימים)</th><th scope="col">בתור חובה</th></tr></thead>
      <tbody>
{%- for r in model.tables.processes %}
        <tr><th scope="row">{{ r.proc }}</th><td>{{ r.ptype }}</td><td>{{ r.n }}</td><td>{{ r.h }}</td><td>{{ r.d }}</td><td>{{ r.mn }}</td><td>{{ r.mx }}</td><td>{{ r.qs }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תמהיל ההצהרות לפי תהליך</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.mix_note }}</p>
  <div id="chart-mix" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.mix_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.mix_aria }}</caption>
      <thead><tr><th scope="col">תהליך</th><th scope="col">הצהרות</th><th scope="col">חלק</th></tr></thead>
      <tbody>
{%- for r in model.tables.mix %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.n }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

{%- if model.flags.autonomy %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">אוטונומיה לעומת מסלול רגיל</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.auto_note }}</p>
  <div id="chart-autonomy" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.auto_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.auto_aria }}</caption>
      <thead><tr><th scope="col">שנה</th><th scope="col">הצהרות, רגיל</th><th scope="col">שעות, רגיל</th><th scope="col">תור חובה, רגיל</th><th scope="col">הצהרות, אוטונומיה</th><th scope="col">שעות, אוטונומיה</th><th scope="col">תור חובה, אוטונומיה</th></tr></thead>
      <tbody>
{%- for r in model.tables.autonomy %}
        <tr><th scope="row">{{ r.year }}</th><td>{{ r.nr }}</td><td>{{ r.hr }}</td><td>{{ r.qr }}</td><td>{{ r.na }}</td><td>{{ r.ha }}</td><td>{{ r.qa }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>
{%- endif %}

<script>
  (function () {
    var d = {{ model.charts.time | tojson }};
    var c = echarts.init(document.getElementById("chart-time"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v == null ? "" : v.toLocaleString("he-IL") + " שעות"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 88, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { hideOverlap: true } },
      yAxis: { type: "value", name: "שעות" },
      dataZoom: [{ type: "inside", startValue: d.zoom_start }, { type: "slider", startValue: d.zoom_start, bottom: 32, height: 18 }],
      series: [
        { type: "line", name: "יבוא מסחרי", data: d.commercial, showSymbol: false },
        { type: "line", name: "יבוא אישי", data: d.personal, showSymbol: false }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
<script>
  (function () {
    var d = {{ model.charts.volume | tojson }};
    var c = echarts.init(document.getElementById("chart-volume"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v == null ? "" : v.toLocaleString("he-IL") + " הצהרות"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 88, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { hideOverlap: true } },
      yAxis: [
        { type: "value", name: "אישי", position: "right", axisLabel: { formatter: function (v) { return (v / 1e6).toLocaleString("he-IL") + "M"; } } },
        { type: "value", name: "מסחרי", position: "left", splitLine: { show: false }, axisLabel: { formatter: function (v) { return (v / 1e3).toLocaleString("he-IL") + "K"; } } }
      ],
      dataZoom: [{ type: "inside", startValue: d.zoom_start }, { type: "slider", startValue: d.zoom_start, bottom: 32, height: 18 }],
      series: [
        { type: "line", name: "יבוא אישי", yAxisIndex: 0, data: d.personal, showSymbol: false },
        { type: "line", name: "יבוא מסחרי", yAxisIndex: 1, data: d.commercial, showSymbol: false }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
<script>
  (function () {
    var d = {{ model.charts.yearly | tojson }};
    var c = echarts.init(document.getElementById("chart-yearly"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v == null ? "" : v.toLocaleString("he-IL") + " שעות"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", name: "שעות" },
      series: [
        { type: "bar", name: "יבוא מסחרי", data: d.commercial },
        { type: "bar", name: "יבוא אישי", data: d.personal }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
<script>
  (function () {
    var h = {{ model.charts.heat | tojson }};
    var c = echarts.init(document.getElementById("chart-heat"));
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return echarts.format.encodeHTML(String(h.x[p.value[0]])) + " " + echarts.format.encodeHTML(String(h.y[p.value[1]])) + ": " + p.value[2].toLocaleString("he-IL") + " שעות (" + p.value[3].toLocaleString("he-IL") + " הצהרות)";
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true }, axisLabel: { interval: 0, rotate: 45 } },
      yAxis: { type: "category", data: h.y, splitArea: { show: true } },
      visualMap: {
        min: 0, max: h.max, calculable: true, dimension: 2,
        orient: "horizontal", left: "center", bottom: 8,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells, label: { show: false },
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
<script>
  (function () {
    var d = {{ model.charts.houses | tojson }};
    var c = echarts.init(document.getElementById("chart-houses"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v.toLocaleString("he-IL") + " הצהרות"; } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "log", name: "הצהרות", axisLabel: { formatter: function (v) { return v >= 1e6 ? (v / 1e6) + "M" : (v >= 1e3 ? (v / 1e3) + "K" : v); } } },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [{ type: "bar", name: "הצהרות", data: d.values }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- if model.flags.house_time %}
<script>
  (function () {
    var d = {{ model.charts.house_time | tojson }};
    var c = echarts.init(document.getElementById("chart-house-time"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex;
        return echarts.format.encodeHTML(String(d.names[i])) + ": " + d.values[i].toLocaleString("he-IL") + " שעות (" + d.n[i].toLocaleString("he-IL") + " הצהרות מסחריות)";
      } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", name: "שעות" },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [{ type: "bar", name: "שעות", data: d.values }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}
{%- if model.flags.house_queue %}
<script>
  (function () {
    var d = {{ model.charts.house_queue | tojson }};
    var c = echarts.init(document.getElementById("chart-house-queue"));
    c.setOption(window.GovEcharts.option({
      color: ["#0053c4"],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex;
        return echarts.format.encodeHTML(String(d.names[i])) + ": " + d.values[i].toLocaleString("he-IL") + "% בתור חובה (" + d.n[i].toLocaleString("he-IL") + " הצהרות)";
      } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", name: "%", max: 100 },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [{ type: "bar", name: "תור חובה", data: d.values }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}
<script>
  (function () {
    var d = {{ model.charts.proc_time | tojson }};
    var c = echarts.init(document.getElementById("chart-proc"));
    var colors = window.GOVIL_PALETTE;
    var kinds = [];
    d.types.forEach(function (t) { if (kinds.indexOf(t) < 0) { kinds.push(t); } });
    c.setOption(window.GovEcharts.option({
      color: colors,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex;
        return echarts.format.encodeHTML(String(d.names[i])) + " (" + echarts.format.encodeHTML(String(d.types[i])) + "): " + d.values[i].toLocaleString("he-IL") + " שעות, " + d.n[i].toLocaleString("he-IL") + " הצהרות";
      } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "log", name: "שעות" },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 150, overflow: "truncate" } },
      series: [{ type: "bar", name: "שעות", data: d.values.map(function (v, i) {
        return { value: v, itemStyle: { color: colors[kinds.indexOf(d.types[i]) % colors.length] } };
      }) }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
<script>
  (function () {
    var d = {{ model.charts.mix | tojson }};
    var c = echarts.init(document.getElementById("chart-mix"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) { return echarts.format.encodeHTML(String(p.name)) + ": " + p.value.toLocaleString("he-IL") + " הצהרות (" + p.percent + "%)"; } },
      legend: { bottom: 0, type: "scroll" },
      series: [{ type: "pie", radius: ["40%", "68%"], center: ["50%", "44%"], label: { show: false },
                 data: d.names.map(function (n, i) { return { name: n, value: d.values[i] }; }) }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- if model.flags.autonomy %}
<script>
  (function () {
    var d = {{ model.charts.autonomy | tojson }};
    var c = echarts.init(document.getElementById("chart-autonomy"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v == null ? "" : v.toLocaleString("he-IL") + " שעות"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", name: "שעות" },
      series: [
        { type: "bar", name: "מסלול רגיל", data: d.regular },
        { type: "bar", name: "אוטונומיה", data: d.autonomy }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}
