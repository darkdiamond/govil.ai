<script>
  (function () {
    function mk(id, opt) {
      var el = document.getElementById(id);
      if (!el) return;
      var c = echarts.init(el);
      opt.color = window.GOVIL_PALETTE;
      c.setOption(window.GovEcharts.option(opt));
      window.addEventListener("resize", function () { c.resize(); });
    }
    var h = {{ model.charts.history | tojson }};
    mk("chart-history", {
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: h.x, boundaryGap: false },
      yAxis: { type: "value", name: "יישובים ואזורים" },
      dataZoom: [{ type: "inside" }],
      series: h.series.map(function (s) {
        return { type: "line", stack: "all", name: s.name, data: s.data, areaStyle: {}, showSymbol: false };
      })
    });
    var w = {{ model.charts.waves | tojson }};
    var we = document.getElementById("chart-waves");
    var narrow = we && we.clientWidth < 520;
    mk("chart-waves", {
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: w.x, axisLabel: { interval: 0, rotate: narrow ? 45 : 0 } },
      yAxis: { type: "value", name: "סיווגים" },
      series: w.series.map(function (s) { return { type: "bar", stack: "all", name: s.name, data: s.data }; })
    });
  })();
</script>

<script>
  (function () {
    var t = {{ model.charts.trans | tojson }};
    var el = document.getElementById("chart-trans");
    if (!t || !el) return;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return "קודם: " + t.labels[p.value[1]] + " · היום: " + t.labels[p.value[0]] + " — " + p.value[2].toLocaleString("he-IL");
      } },
      grid: { left: 16, right: 16, top: 32, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: t.labels, position: "top", splitArea: { show: true } },
      yAxis: { type: "category", data: t.labels, inverse: true, splitArea: { show: true } },
      visualMap: {
        min: 0, max: t.max, calculable: true, dimension: 2,
        orient: "horizontal", left: "center", bottom: 8,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: t.cells, label: { show: true, fontFamily: "Rubik" },
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    function mk(id, opt) {
      var el = document.getElementById(id);
      if (!el) return;
      var c = echarts.init(el);
      opt.color = window.GOVIL_PALETTE;
      c.setOption(window.GovEcharts.option(opt));
      window.addEventListener("resize", function () { c.resize(); });
    }
    function hbar(id, d, unit) {
      mk(id, {
        tooltip: { trigger: "axis" },
        grid: { left: 16, right: 32, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 4 },
        yAxis: { type: "category", data: d.names, inverse: true,
                 axisLabel: { width: 170, overflow: "break" } },
        series: [{ type: "bar", name: unit, data: d.values, label: { show: true, position: "right" } }]
      });
    }
    function hstack(id, d) {
      mk(id, {
        tooltip: { trigger: "axis" },
        legend: { bottom: 0 },
        grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
        xAxis: { type: "value", splitNumber: 4 },
        yAxis: { type: "category", data: d.names, inverse: true },
        series: d.series.map(function (s) { return { type: "bar", stack: "all", name: s.name, data: s.data }; })
      });
    }
    hbar("chart-profile", {{ model.charts.profile | tojson }}, "יישובים ואזורים");
    var s = {{ model.charts.status | tojson }};
    mk("chart-status", {
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: s.x },
      yAxis: { type: "value", name: "סיווגים" },
      series: s.series.map(function (x) { return { type: "bar", stack: "all", name: x.name, data: x.data }; })
    });
    hstack("chart-sub", {{ model.charts.sub | tojson }});
    hbar("chart-nap-sub", {{ model.charts.nap_sub | tojson }}, "יישובים ואזורים");
    var nd = {{ model.charts.nap_dates | tojson }};
    mk("chart-nap-dates", {
      tooltip: { trigger: "axis" },
      grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: nd.names },
      yAxis: { type: "value", name: "רשומות" },
      series: [{ type: "bar", name: "רשומות", data: nd.values, label: { show: true, position: "top" } }]
    });
    hbar("chart-overlap", {{ model.charts.overlap | tojson }}, "יישובים ואזורים");
    hstack("chart-rev", {{ model.charts.rev | tojson }});
    hstack("chart-kinds", {{ model.charts.kinds | tojson }});
  })();
</script>
