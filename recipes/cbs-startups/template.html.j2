{%- if model.flags.mature %}
  (function () {
    const d = {{ model.charts.mature | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-mature"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[6], pal[2], pal[0]],
