      yAxis: [
        { type: "value", name: "חברות", position: "right" },
        { type: "value", name: "משרות", position: "left", splitLine: { show: false },
          axisLabel: { formatter: (v) => v >= 1000 ? (v / 1000).toLocaleString("he-IL") + " אלף" : v } }
      ],
      series: [
        { type: "bar", stack: "a", name: "חברות עד 25 משרות", data: d.small },
        { type: "bar", stack: "a", name: "חברות מעל 25 משרות", data: d.big },
        { type: "line", name: "משרות בחברות מעל 25", data: d.jobs_big, yAxisIndex: 1, lineStyle: { width: 3 } }
