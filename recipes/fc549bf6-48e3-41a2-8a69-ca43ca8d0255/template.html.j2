  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.basin_lede }}</p>
  <div id="chart-basin" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.basin_aria }}"></div>
{{ tbl(model.labels.basin_aria, ["אגן", "קידוחים", "פעילים"], model.tables.basin, ["name", "total", "active"]) }}
