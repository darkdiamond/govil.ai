{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

{%- if model.flags.map %}
<section class="card p-5 mb-6">
{{ head("map-pin", "מפת הקידוחים") }}
