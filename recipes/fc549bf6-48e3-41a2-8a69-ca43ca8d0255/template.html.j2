{%- macro head(icon, title) %}
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/{{ icon }}.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ title }}</h2>
  </div>
{%- endmacro %}
{%- macro tbl(caption, heads, rows, keys) %}
  <details class="mt-3">
    <summary class="cursor-pointer text-sm text-brand">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ caption }}</caption>
        <thead><tr class="border-b border-rule text-ink-deep">{% for h in heads %}<th scope="col" class="text-start py-1 pe-3">{{ h }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in rows %}
          <tr class="border-b border-rule"><th scope="row" class="text-start font-normal py-1 pe-3">{{ r[keys[0]] }}</th>{% for k in keys[1:] %}<td class="py-1 pe-3">{{ r[k] }}</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
{%- endmacro %}
<h1>{{ model.agent_data.seo.name }}</h1>

<section class="card p-5 mb-6">
{{ head("info", "תקציר") }}
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }} לכל קידוח (בארות מים ומתקני הפקה): סטטוס, בעלות, קבוצת מים, אקוויפר, ספיקה שעתית מקסימלית, מספר ארצי ואזורי הפקה, חקלאות ותכנון.</p>
</section>

<a id="lookup" href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור קידוח לפי שם, בעלים או מספר ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: שם מתקן, מספר מתקן, שם צרכן בעל המתקן, מספר הפקה, מספר ארצי, אקוויפר ואזור אדמיניסטרטיבי.</span>
  </span>
</a>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in model.kpi_order %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.labels["kpi_" ~ key] }}</div>
  </div>
{%- endfor %}
</div>

<section class="card p-5 mb-6">
{{ head("circle-check", "תובנות עיקריות") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

{%- if model.flags.map %}
<section class="card p-5 mb-6">
{{ head("map-pin", "מפת הקידוחים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.map_lede }}</p>
  <div id="map-wells" class="h-80 md:h-[460px]" role="region" aria-label="{{ model.labels.map_aria }}" data-fallback="explorer"></div>
  <p id="well-hint" class="m-0 mt-3 text-sm text-subtle">לחצו על עיגול במפה כדי לראות כאן את רשימת הקידוחים בריבוע ואת מפלסי מי התהום שנמדדו בהם.</p>
  <div id="well-detail" class="hidden mt-4" aria-live="polite">
    <h3 id="well-detail-title" class="m-0 mb-2 text-base font-semibold text-ink-deep"></h3>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <caption class="sr-only">הקידוחים בריבוע שנבחר במפה</caption>
        <thead><tr class="border-b border-rule text-ink-deep"><th scope="col" class="text-start py-1 pe-3">שם מתקן</th><th scope="col" class="text-start py-1 pe-3">מספר מתקן</th><th scope="col" class="text-start py-1 pe-3">סטטוס</th><th scope="col" class="text-start py-1 pe-3">סוג מים</th><th scope="col" class="hidden md:table-cell text-start py-1 pe-3">אקוויפר</th><th scope="col" class="hidden md:table-cell text-start py-1 pe-3">בעלות</th><th scope="col" class="text-start py-1 pe-3">מדידות מפלס</th></tr></thead>
        <tbody id="well-detail-rows"></tbody>
      </table>
    </div>
    <p id="levels-state" class="m-0 mt-4 mb-2 text-sm text-subtle"></p>
    <div id="chart-levels" class="hidden h-72 md:h-96" role="img" aria-label="מפלסי מי התהום שנמדדו בקידוחי הריבוע שנבחר, במטרים ביחס לפני הים, לאורך זמן"></div>
    <p class="m-0 mt-2 text-xs text-subtle">מפלס מי התהום במטרים ביחס לפני הים; קו נקטע כשעברו יותר משלוש שנים בין מדידות. המפלסים נטענים בזמן הלחיצה מתוך המאגר <a href="{{ model.charts.map.levels_page }}">מפלסי קידוחים</a> של רשות המים, לפי מספר המתקן. רק לחלק מהקידוחים יש מדידות מפלס.</p>
  </div>
</section>
{%- endif %}

