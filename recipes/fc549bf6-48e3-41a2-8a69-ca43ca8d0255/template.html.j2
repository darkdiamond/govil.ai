{%- if model.flags.map %}
{%- for chunk in model.charts.map.chunks %}
<script type="application/json" id="map-pts-{{ loop.index0 }}">{{ chunk | tojson }}</script>
{%- endfor %}
<script>
  (function () {
    var el = document.getElementById("map-wells");
    if (!el || !window.L) { return; }
    var meta = {{ {"n": model.charts.map.chunks | length, "max": model.charts.map.max, "bounds": model.charts.map.bounds, "admins": model.charts.map.admins} | tojson }};
    var map = L.map(el, { preferCanvas: true, scrollWheelZoom: false, zoomSnap: 0.25 });
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 18, attribution: "© OpenStreetMap" }).addTo(map);
    var fmt = function (v) { return Number(v).toLocaleString("he-IL"); };
    for (var c = 0; c < meta.n; c++) {
      var node = document.getElementById("map-pts-" + c);
      if (!node) { continue; }
      JSON.parse(node.textContent).forEach(function (p) {
        var t = Math.sqrt(p[2] / meta.max);
        var on = p[3] > 0;
        var mk = L.circleMarker([p[0], p[1]], {
          radius: 3 + 11 * t, color: on ? "#0b3668" : "#6c757d", weight: 1,
          fillColor: on ? "#0068f5" : "#adb5bd", fillOpacity: 0.55
        }).addTo(map);
        var box = document.createElement("div");
        if (p[4] >= 0) {
          var title = document.createElement("strong");
          title.textContent = meta.admins[p[4]];
          box.appendChild(title);
        }
        [["קידוחים בריבוע", fmt(p[2])], ["מתוכם פעילים", fmt(p[3])]].forEach(function (row) {
          var line = document.createElement("div");
          line.textContent = row[0] + ": " + row[1];
          box.appendChild(line);
        });
        mk.bindPopup(box);
      });
    }
    map.fitBounds(meta.bounds, { padding: [8, 8] });
  })();
</script>
{%- endif %}

<script>
  (function () {
    var d = {{ model.charts.status | tojson }};
    var el = document.getElementById("chart-status");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        return echarts.format.encodeHTML(p[0].name) + "<br>" + p[0].value.toLocaleString("he-IL") + " קידוחים";
      } },
      grid: { left: 16, right: 56, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", show: false },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [{ type: "bar", name: "קידוחים", data: d.values, barMaxWidth: 28,
        label: { show: true, position: "right", formatter: function (p) { return p.value.toLocaleString("he-IL"); } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var specs = [
      ["chart-ownership", {{ model.charts.ownership | tojson }}],
      ["chart-water", {{ model.charts.water | tojson }}],
      ["chart-aquifer", {{ model.charts.aquifer | tojson }}],
      ["chart-region", {{ model.charts.region | tojson }}]
    ];
    specs.forEach(function (s) {
      var el = document.getElementById(s[0]);
      if (!el) { return; }
      var d = s[1];
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        legend: { top: 0, type: "scroll" },
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
          var i = p[0].dataIndex;
          var out = echarts.format.encodeHTML(d.cats[i]) + "<br>סה״כ " + d.total[i].toLocaleString("he-IL") + " קידוחים";
          p.forEach(function (q) { if (q.value) { out += "<br>" + q.marker + echarts.format.encodeHTML(q.seriesName) + ": " + q.value.toLocaleString("he-IL"); } });
          return out;
        } },
        grid: { left: 16, right: 24, top: 40, bottom: 8, containLabel: true },
        xAxis: { type: "value", splitNumber: 3 },
        yAxis: { type: "category", data: d.cats, inverse: true, axisLabel: { width: 120, overflow: "truncate" } },
        series: d.series.map(function (sr) {
          return { type: "bar", stack: "s", name: sr.name, data: sr.data, barMaxWidth: 26 };
        })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    });
  })();
</script>

{%- if model.flags.heat %}
<script>
  (function () {
    var d = {{ model.charts.heat | tojson }};
    var el = document.getElementById("chart-heat");
    if (!el) { return; }
    var narrow = el.clientWidth < 500;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return echarts.format.encodeHTML(d.y[p.value[1]]) + "<br>" + echarts.format.encodeHTML(d.x[p.value[0]]) + ": " + p.value[2].toLocaleString("he-IL") + " קידוחים";
      } },
      grid: { left: 8, right: 8, top: 8, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.x, splitArea: { show: true }, axisLabel: { rotate: 35, interval: 0, width: 90, overflow: "truncate", fontSize: narrow ? 9 : 12 } },
      yAxis: { type: "category", data: d.y, inverse: true, splitArea: { show: true }, axisLabel: { fontSize: narrow ? 10 : 12 } },
      visualMap: { min: 0, max: d.max, dimension: 2, calculable: true, orient: "horizontal", left: "center", bottom: 0,
        itemHeight: 100, inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] }, textStyle: { fontFamily: "Rubik", color: "#0c3058" } },
      series: [{ type: "heatmap", data: d.cells, label: { show: !narrow, fontFamily: "Rubik" },
        emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

<script>
  (function () {
    var specs = [
      ["chart-admin", {{ model.charts.admin | tojson }}],
      ["chart-owners", {{ model.charts.owners | tojson }}],
      ["chart-basin", {{ model.charts.basin | tojson }}]
    ];
    specs.forEach(function (s) {
      var el = document.getElementById(s[0]);
      if (!el) { return; }
      var d = s[1];
      var other = d.total.map(function (v, i) { return v - d.active[i]; });
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        legend: { top: 0 },
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
          var i = p[0].dataIndex;
          return echarts.format.encodeHTML(d.names[i]) + "<br>" + d.total[i].toLocaleString("he-IL") + " קידוחים, מתוכם " + d.active[i].toLocaleString("he-IL") + " פעילים";
        } },
        grid: { left: 16, right: 24, top: 36, bottom: 8, containLabel: true },
        xAxis: { type: "value", splitNumber: 3 },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 130, overflow: "truncate" } },
        series: [
          { type: "bar", stack: "s", name: "פעילים", data: d.active, barMaxWidth: 24 },
          { type: "bar", stack: "s", name: "לא פעילים ואחרים", data: other, barMaxWidth: 24 }
        ]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    });
  })();
</script>

{%- if model.flags.flow %}
<script>
  (function () {
    var d = {{ model.charts.flow | tojson }};
    var el = document.getElementById("chart-flow");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      legend: { top: 0 },
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        return echarts.format.encodeHTML(d.labels[i]) + " מ״ק לשעה<br>פעילים: " + d.active[i].toLocaleString("he-IL") + "<br>אחרים: " + d.other[i].toLocaleString("he-IL");
      } },
      grid: { left: 16, right: 16, top: 36, bottom: 8, containLabel: true },
      xAxis: { type: "category", data: d.labels, axisLabel: { interval: 0 } },
      yAxis: { type: "value", splitNumber: 3 },
      series: [
        { type: "bar", stack: "s", name: "פעילים", data: d.active, barMaxWidth: 40 },
        { type: "bar", stack: "s", name: "לא פעילים ואחרים", data: d.other, barMaxWidth: 40 }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}
