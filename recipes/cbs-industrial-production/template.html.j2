{%- if model.flags.inputs %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "ייצור, משרות ושעות עבודה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.inputs_note }}</p>
  {{ gov.chart("chart-inputs", model.labels.inputs_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.inputs_caption, ["שנה", "ייצור", "משרות שכיר", "שעות עבודה"], model.tables.inputs, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

{%- if model.flags.techjobs %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "משרות השכיר לפי עוצמה טכנולוגית") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.techjobs_note }}</p>
  {{ gov.chart("chart-techjobs", model.labels.techjobs_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.techjobs_caption, ["עוצמה טכנולוגית", "מדד אחרון", "שינוי בשנה", model.labels.techjobs_since], model.tables.techjobs, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>מדד הייצור התעשייתי מודד את היקף הייצור הפיזי של ענפי התעשייה, הכרייה והחציבה, ביחס לממוצע של שנת הבסיס. מדד של מאה ועשרים פירושו ייצור גבוה בחמישית משנת הבסיס.</li>
    <li>מנוכה עונתיות: הנתון אחרי ניכוי השפעות של עונות, חגים ומספר ימי העבודה בחודש. קו המגמה מחליק גם את התנודות האקראיות, ולכן הוא מתאים להשוואה לאורך זמן.</li>
    <li>עוצמה טכנולוגית: הלמ"ס מחלקת את ענפי התעשייה לארבע קבוצות לפי שיעור ההוצאה על מחקר ופיתוח. טכנולוגיה עילית כוללת למשל תרופות, אלקטרוניקה ותעשייה אווירית.</li>
    <li>נתוני החודשים האחרונים ארעיים, והלמ"ס מעדכנת אותם בהודעות הבאות. העמוד מציג תמיד את הגרסה האחרונה.</li>
  </ul>
</section>

<script>
  (function () {
    const d = {{ model.charts.recent | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-recent"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[6], pal[2], pal[0]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value", scale: true },
      series: [
        { type: "bar", name: "נתון מקורי", data: d.orig },
        { type: "line", name: "מנוכה עונתיות", data: d.sa, showSymbol: false },
        { type: "line", name: "מגמה", data: d.trend, showSymbol: false, lineStyle: { width: 3 } }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
</script>
{%- if model.flags.long %}
<script>
  (function () {
    const d = {{ model.charts.long | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-long"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[3], pal[0]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", scale: true },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 20 }],
      series: [
        { type: "line", name: "מנוכה עונתיות", data: d.sa, showSymbol: false },
        { type: "line", name: "מגמה", data: d.trend, showSymbol: false, lineStyle: { width: 3 } }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
</script>
{%- endif %}
<script>
  window.govTechChart = function (id, d) {
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById(id));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2], pal[4], pal[7]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 56, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", scale: true },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 20 }],
      series: d.names.map((n, k) => ({
        type: "line", name: n, data: d.series[k], showSymbol: false,
        lineStyle: { width: k === 0 ? 3 : 2 }
      }))
    }));
    window.addEventListener("resize", () => chart.resize());
  };
</script>
{%- if model.flags.tech %}
<script>
  window.govTechChart("chart-tech", {{ model.charts.tech | tojson }});
</script>
{%- endif %}
{%- if model.flags.excl %}
<script>
  (function () {
    const d = {{ model.charts.excl | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-excl"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[5]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value", scale: true },
      series: [
        { type: "line", name: "כל התעשייה", data: d.all, showSymbol: false, lineStyle: { width: 3 } },
        { type: "line", name: "ללא טכנולוגיה עילית", data: d.excl, showSymbol: false, lineStyle: { width: 3, type: "dashed" } }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
</script>
{%- endif %}
{%- if model.flags.market %}
<script>
  (function () {
    const d = {{ model.charts.market | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-market"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[5], pal[0], pal[5]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) },
      legend: { top: 0, data: ["יצוא, מגמה", "שוק מקומי, מגמה"] },
      grid: { left: 16, right: 16, top: 40, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value", scale: true },
      series: [
        { type: "line", name: "יצוא, מגמה", data: d.exp, showSymbol: false, lineStyle: { width: 3 } },
        { type: "line", name: "שוק מקומי, מגמה", data: d.loc, showSymbol: false, lineStyle: { width: 3 } },
        { type: "line", name: "יצוא, מנוכה עונתיות", data: d.exp_sa, showSymbol: false, lineStyle: { width: 1, opacity: 0.6 } },
        { type: "line", name: "שוק מקומי, מנוכה עונתיות", data: d.loc_sa, showSymbol: false, lineStyle: { width: 1, opacity: 0.6 } }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
</script>
{%- endif %}
{%- if model.flags.techexp %}
<script>
  window.govTechChart("chart-techexp", {{ model.charts.techexp | tojson }});
</script>
{%- endif %}
{%- if model.flags.matrix %}
<script>
  (function () {
    const d = {{ model.charts.matrix | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-matrix"));
    const fmt = (v) => v == null ? "" : (v > 0 ? "+" : v < 0 ? "−" : "") + Math.abs(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) + "%";
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2], pal[4], pal[7]],
      tooltip: { trigger: "axis", valueFormatter: fmt },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 56, bottom: 8, containLabel: true },
      xAxis: { type: "category", data: d.groups, axisLabel: { interval: 0, width: 80, overflow: "break" } },
      yAxis: { type: "value", axisLabel: { formatter: (v) => v + "%" } },
      series: d.measures.map((m, k) => ({ type: "bar", name: m, data: d.series[k] }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
</script>
{%- endif %}
{%- if model.flags.inputs %}
<script>
  (function () {
    const d = {{ model.charts.inputs | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-inputs"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[4], pal[7]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", scale: true },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 20 }],
      series: [
        { type: "line", name: "ייצור", data: d.prod, showSymbol: false, lineStyle: { width: 3 } },
        { type: "line", name: "משרות שכיר", data: d.jobs, showSymbol: false },
        { type: "line", name: "שעות עבודה", data: d.hours, showSymbol: false }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
</script>
{%- endif %}
{%- if model.flags.techjobs %}
<script>
  window.govTechChart("chart-techjobs", {{ model.charts.techjobs | tojson }});
</script>
{%- endif %}
