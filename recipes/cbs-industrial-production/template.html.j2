  {{ gov.chart("chart-excl", model.labels.excl_aria, "h-64 md:h-80") }}
  {{ gov.table(model.labels.excl_caption, ["חודש", "כל התעשייה", "ללא טכנולוגיה עילית"], model.tables.excl, ltr=(1, 2)) }}
</section>
{%- endif %}

{%- if model.flags.market %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "יצוא מול שוק מקומי") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.market_note }}</p>
  {{ gov.chart("chart-market", model.labels.market_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.market_caption, ["חודש", "מקומי, מנוכה עונתיות", "מקומי, מגמה", "יצוא, מנוכה עונתיות", "יצוא, מגמה"], model.tables.market, ltr=(1, 2, 3, 4)) }}
</section>
