{%- if model.flags.matrix %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "מי צומח במה: שינוי שנתי לפי עוצמה טכנולוגית") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.matrix_note }}</p>
