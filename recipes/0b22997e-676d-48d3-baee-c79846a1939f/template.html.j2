{%- if model.flags.streets %}
<section class="card p-5 mb-6">
  {{ gov.head("map-pin", "הרחובות שבהם עוברת הרכבת הקלה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.st_lede }}</p>
  {{ gov.chart("chart-streets", model.labels.st_aria, h="h-80 md:h-[460px]") }}
  {{ gov.table(model.labels.st_aria, ["רחוב", "רשויות", "ק״מ", "שיעור מהרשת"], model.tables.streets, ltr=(3,)) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "סוג המסילה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.track_lede }}</p>
  <div class="overflow-x-auto">
    <table id="table-track" class="w-full text-sm">
      <caption class="sr-only">{{ model.labels.track_caption }}</caption>
      <thead><tr><th scope="col">מאפיין</th><th scope="col">ערך</th><th scope="col">מקטעים</th><th scope="col">ק״מ</th><th scope="col">שיעור מהרשת</th></tr></thead>
      <tbody>
{%- for r in model.tables.track %}
        <tr><th scope="row">{{ r[0] }}</th><td>{{ r[1] }}</td><td>{{ r[2] }}</td><td>{{ r[3] }}</td><td dir="ltr">{{ r[4] }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </div>
</section>

<section class="card p-5 mb-6">
  {{ gov.head("list", "תיאור מקורי") }}
  <p class="m-0 text-sm text-subtle whitespace-pre-line">מיפוי מקטעי המסילה של רשת הרכבת הקלה הפעילה בישראל, הכולל את הקו האדום בירושלים ואת הקו האדום בגוש דן</p>
</section>

{%- if model.flags.map %}
{%- for chunk in model.charts.map.chunks %}
<script type="application/json" id="map-s-{{ loop.index0 }}">{{ chunk | tojson }}</script>
{%- endfor %}
<script>
  (function () {
    var el = document.getElementById("map-network");
    if (!el || !window.L || !window.GovMap) { return; }
    var meta = {{ {"origin": model.charts.map.origin, "scale": model.charts.map.scale, "lines": model.charts.map.lines, "levels": model.charts.map.levels, "cities": model.charts.map.cities, "zoom": model.charts.map.zoom, "bounds": model.charts.map.bounds, "under": model.charts.map.under, "above": model.charts.map.above} | tojson }};
    var P = window.GOVIL_PALETTE || ["#0068f5", "#0b3668", "#6c9fd8"];
    var color = function (i) { return P[i % P.length]; };
    document.querySelectorAll("#map-legend .map-swatch").forEach(function (sw) {
      sw.style.background = color(Number(sw.getAttribute("data-i")));
    });
    var map = L.map(el, { scrollWheelZoom: false, zoomSnap: 0.25, preferCanvas: true });
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 18, attribution: "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>" }).addTo(map);
    GovMap.islands("map-s").forEach(function (f) {
      var style = { color: color(f[0]), weight: f[1] === meta.above ? 7 : 4, opacity: 0.85 };
      if (f[1] === meta.under) { style.dashArray = "6 6"; }
      var line = L.polyline(GovMap.ring(f[6], meta.origin, meta.scale), style).addTo(map);
      line.bindPopup(function () {
        return GovMap.popup(f[3], [["קו", meta.lines[f[0]]], ["רחוב", f[4]], ["רשות", meta.cities[f[2]]], ["מפלס", meta.levels[f[1]]], ["אורך", f[5] + " ק״מ"]]);
      });
    });
    map.fitBounds(meta.bounds, { padding: [8, 8] });
    document.querySelectorAll("#map-zoom button").forEach(function (b) {
      b.addEventListener("click", function () {
        var i = Number(b.getAttribute("data-zoom"));
        map.fitBounds(i < 0 ? meta.bounds : meta.zoom[i].bounds, { padding: [12, 12], maxZoom: 15 });
      });
    });
  })();
</script>
{%- endif %}

<script>
  (function () {
    var d = {{ model.charts.lines | tojson }};
    var fmt = function (v) { return Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }); };
    var c = echarts.init(document.getElementById("chart-lines"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return fmt(v) + " ק״מ"; } },
      legend: { bottom: 0 },
      grid: { left: 12, right: 24, top: 8, bottom: 48, containLabel: true },
      xAxis: { type: "value", splitNumber: 3 },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { interval: 0, fontSize: 11, width: 120, overflow: "break", lineHeight: 14 } },
      series: d.series.map(function (s) { return { type: "bar", stack: "l", name: s.name, data: s.data, barMaxWidth: 48 }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.cities | tojson }};
    var fmt = function (v) { return Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }); };
    var c = echarts.init(document.getElementById("chart-cities"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return fmt(v) + " ק״מ"; } },
      legend: { bottom: 0 },
      grid: { left: 12, right: 24, top: 8, bottom: 48, containLabel: true },
      xAxis: { type: "value", splitNumber: 3 },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { interval: 0, fontSize: 11, width: 90, overflow: "truncate" } },
      series: d.series.map(function (s) { return { type: "bar", stack: "c", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.place | tojson }};
    var fmt = function (v) { return Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }); };
    var c = echarts.init(document.getElementById("chart-place"));
