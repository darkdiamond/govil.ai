{% import "gov.j2" as gov %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור מקטע מסילה לפי רחוב, תחנה או עיר ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל מקטעי המאגר: שם הקו, שם הקטע (בין תחנות וצמתים), רחוב, רשות מקומית, מפלס וכיוון נסיעה</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
{%- for k in model.kpi_order %}
  {{ gov.kpi(model.kpis[k], model.labels["kpi_" ~ k]) }}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

{%- if model.flags.map %}
<section class="card p-5 mb-6">
  {{ gov.head("map-pin", "מפת תוואי הרכבת הקלה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.map_note }}</p>
{%- if model.charts.map.zoom %}
  <div class="flex flex-wrap gap-2 mb-3" id="map-zoom">
    <button type="button" class="rounded-gov-pill border border-rule px-3 py-1 text-sm text-ink bg-surface" data-zoom="-1">כל הרשת</button>
{%- for z in model.charts.map.zoom %}
    <button type="button" class="rounded-gov-pill border border-rule px-3 py-1 text-sm text-ink bg-surface" data-zoom="{{ loop.index0 }}">{{ z.name }}</button>
{%- endfor %}
  </div>
{%- endif %}
  <div id="map-network" class="h-80 md:h-[460px]" role="region" aria-label="{{ model.labels.map_aria }}" data-fallback="explorer"></div>
  <ul id="map-legend" class="flex flex-wrap gap-x-4 gap-y-2 mt-3 mb-0 ps-0 list-none text-sm text-subtle">
{%- for t in model.charts.map.legend %}
    <li class="flex items-center gap-2"><span class="map-swatch" data-i="{{ loop.index0 }}" style="display:inline-block;width:24px;height:4px;border-radius:2px"></span>{{ t.name }} ({{ t.km }} ק״מ)</li>
{%- endfor %}
{%- for lv in model.charts.map.level_legend %}
{%- if lv.dash %}
    <li class="flex items-center gap-2"><span style="display:inline-block;width:24px;border-top:3px dashed #0c3058"></span>{{ lv.name }}</li>
{%- elif lv.thick %}
    <li class="flex items-center gap-2"><span style="display:inline-block;width:24px;height:7px;border-radius:2px;background:#0c3058"></span>{{ lv.name }}</li>
{%- endif %}
{%- endfor %}
  </ul>
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("database", "אורך המסילה בכל קו") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.lines_lede }}</p>
  {{ gov.chart("chart-lines", model.labels.lines_aria, h="h-72 md:h-96") }}
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.lines_caption }}</caption>
      <thead><tr><th scope="col">קו</th><th scope="col">מטרופולין</th><th scope="col">ק״מ מסילה</th><th scope="col">מקטעים</th><th scope="col">קטעים</th><th scope="col">שנת פתיחה רשומה</th><th scope="col">קווי שירות</th><th scope="col">מפעיל</th><th scope="col">חברה מנהלת</th><th scope="col">עדכון אחרון</th></tr></thead>
      <tbody>
{%- for r in model.tables.lines %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.metro }}</td><td>{{ r.km }}</td><td>{{ r.n }}</td><td>{{ r.sections }}</td><td>{{ r.years }}</td><td>{{ r.services }}</td><td>{{ r.operator }}</td><td>{{ r.manager }}</td><td>{{ r.updated }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<section class="card p-5 mb-6">
  {{ gov.head("building-2", "מסילה לפי רשות מקומית") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cities_lede }}</p>
  {{ gov.chart("chart-cities", model.labels.cities_aria, h="h-72 md:h-96") }}
  <div class="overflow-x-auto">
  {{ gov.table(model.labels.cities_aria, ["רשות", "ק״מ", "שיעור מהרשת"] + model.labels.levels, model.tables.cities, ltr=(2,)) }}
  </div>
</section>

<section class="card p-5 mb-6">
  {{ gov.head("map-pin", "מסילה תת-קרקעית, במפלס הרחוב ועל גשרים: מיקום בזכות הדרך") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.place_lede }}</p>
  {{ gov.chart("chart-place", model.labels.place_aria, h="h-72 md:h-96") }}
  <div class="overflow-x-auto">
  {{ gov.table(model.labels.place_aria, ["מיקום בזכות הדרך"] + model.labels.metro_cols + ["סך הכול"], model.tables.place) }}
  </div>
</section>

<section class="card p-5 mb-6">
  {{ gov.head("list", "קווי השירות על המסילה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.svc_lede }}</p>
  {{ gov.chart("chart-svc", model.labels.svc_aria, h="h-64 md:h-80") }}
  {{ gov.table(model.labels.svc_aria, ["קווי שירות", "מטרופולין", "מספר קווים", "ק״מ", "מקטעים"], model.tables.svc) }}
</section>



<section class="card p-5 mb-6">
  {{ gov.head("map-pin", "תחנות, צמתים ופיצולים: היכן מקטע מתחיל ונגמר") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.nodes_lede }}</p>
  {{ gov.chart("chart-nodes", model.labels.nodes_aria, h="h-72 md:h-96") }}
  <div class="overflow-x-auto">
  {{ gov.table(model.labels.nodes_aria, ["סוג נקודה"] + model.labels.metro_cols + ["סך הכול"], model.tables.nodes) }}
  </div>
</section>

<section class="card p-5 mb-6">
  {{ gov.head("map-pin", "כיווני הנסיעה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.dirs_lede }}</p>
  {{ gov.chart("chart-dirs", model.labels.dirs_aria, h="h-80 md:h-[460px]") }}
  <div class="overflow-x-auto">
  {{ gov.table(model.labels.dirs_aria, ["כיוון"] + model.labels.metro_cols, model.tables.dirs) }}
  </div>
</section>

<section class="card p-5 mb-6">
  {{ gov.head("database", "אורך המקטעים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.len_lede }}</p>
  {{ gov.chart("chart-len", model.labels.len_aria, h="h-64 md:h-80") }}
  <div class="overflow-x-auto">
