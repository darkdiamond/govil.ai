      legend: { bottom: 0 },
      grid: { left: 12, right: 12, top: 32, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, fontSize: 10, width: 52, overflow: "break" } },
      yAxis: { type: "value", name: "מקטעים" },
      series: d.series.map(function (s) { return { type: "bar", name: s.name, data: s.data }; })
