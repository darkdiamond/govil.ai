      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return fmt(v) + " ק״מ"; } },
      legend: { bottom: 0 },
      grid: { left: 12, right: 24, top: 8, bottom: 48, containLabel: true },
      xAxis: { type: "value", splitNumber: 3 },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { interval: 0, fontSize: 11, width: 110, overflow: "break" } },
      series: d.series.map(function (s) { return { type: "bar", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.svc | tojson }};
    var esc = echarts.format.encodeHTML;
    var fmt = function (v) { return Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }); };
    var P = window.GOVIL_PALETTE;
    var c = echarts.init(document.getElementById("chart-svc"));
    c.setOption(window.GovEcharts.option({
      color: P,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                 formatter: function (ps) {
                   var p = ps[0];
                   return esc(p.name) + (d.multi[p.dataIndex] ? " (כמה קווי שירות)" : "") + "<br>" + fmt(p.value) + " ק״מ";
                 } },
      grid: { left: 12, right: 48, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: false }, splitLine: { show: false } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { interval: 0, fontSize: 11, width: 120, overflow: "truncate" } },
      series: [{ type: "bar", data: d.values.map(function (v, i) { return { value: v, itemStyle: { color: d.multi[i] ? P[1] : P[2] } }; }),
                 label: { show: true, position: "right", fontFamily: "Rubik", formatter: function (p) { return fmt(p.value); } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>



<script>
  (function () {
    var d = {{ model.charts.nodes | tojson }};
    var c = echarts.init(document.getElementById("chart-nodes"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 12, right: 24, top: 8, bottom: 48, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { interval: 0, fontSize: 11, width: 90, overflow: "break" } },
      series: d.series.map(function (s) { return { type: "bar", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.dirs | tojson }};
    var esc = echarts.format.encodeHTML;
    var fmt = function (v) { return Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }); };
    var c = echarts.init(document.getElementById("chart-dirs"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        var s = esc(p.name);
        p.value.forEach(function (v, i) { s += "<br>" + esc(d.indicators[i]) + ": " + fmt(v) + " ק״מ"; });
        return s;
      } },
      legend: { bottom: 0 },
      radar: { center: ["50%", "46%"], radius: "62%", splitNumber: 4,
               axisName: { color: "#0c3058", fontFamily: "Rubik", fontSize: 11 },
               indicator: d.indicators.map(function (n) { return { name: n, max: d.max }; }) },
      series: [{ type: "radar", areaStyle: { opacity: 0.15 }, data: d.series }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.len | tojson }};
    var c = echarts.init(document.getElementById("chart-len"));
    c.setOption(window.GovEcharts.option({
