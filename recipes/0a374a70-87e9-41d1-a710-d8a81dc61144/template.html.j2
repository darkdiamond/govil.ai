      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 40, right: 16, top: 24, bottom: narrow ? 64 : 48, containLabel: true },
      xAxis: { type: "category", data: pl.names, name: "חודשים", nameLocation: "middle", nameGap: narrow ? 52 : 30, axisLabel: { interval: 0, fontSize: 11, rotate: narrow ? 45 : 0 } },
      yAxis: { type: "value" },
      series: [{ type: "bar", name: "בקשות", data: pl.values }]
    }));
    window.addEventListener("resize", function () { c6.resize(); });

    var lg = {{ model.charts.lag | tojson }};
    var c7 = echarts.init(document.getElementById("chart-lag"));
    var band = lg.p75.map(function (v, i) { return (v === null || lg.p25[i] === null) ? null : Math.round((v - lg.p25[i]) * 10) / 10; });
    c7.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", formatter: function (ps) {
        var i = ps[0].dataIndex;
        return lg.x[i] + "<br>חציון: " + lg.p50[i] + " חודשים<br>רבעונים: " + lg.p25[i] + " עד " + lg.p75[i];
      } },
      grid: { left: 40, right: 16, top: 32, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: lg.x },
      yAxis: { type: "value", name: "חודשים", min: 0 },
      dataZoom: [{ type: "inside" }, { type: "slider", height: 18, bottom: 8 }],
      series: [
        { type: "line", name: "רבעון תחתון", data: lg.p25, stack: "b", lineStyle: { opacity: 0 }, symbol: "none" },
        { type: "line", name: "טווח בין־רבעוני", data: band, stack: "b", lineStyle: { opacity: 0 }, symbol: "none", areaStyle: { color: "#c3cfe7", opacity: 0.6 } },
        { type: "line", name: "חציון", data: lg.p50, symbolSize: 4, itemStyle: { color: "#0068f5" } }
      ]
    }));
    window.addEventListener("resize", function () { c7.resize(); });

    var pr = {{ model.charts.prolific | tojson }};
    var c8 = echarts.init(document.getElementById("chart-prolific"));
    c8.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 40, right: 16, top: 24, bottom: narrow ? 56 : 40, containLabel: true },
      xAxis: { type: "category", data: pr.names, name: "בקשות למגיש", nameLocation: "middle", nameGap: narrow ? 44 : 28, axisLabel: { interval: 0, fontSize: 11, rotate: narrow ? 45 : 0 } },
      yAxis: { type: "log", min: 1 },
      series: [{ type: "bar", name: "מגישים", data: pr.values }]
    }));
    window.addEventListener("resize", function () { c8.resize(); });
  })();
</script>
