<script>
  (function () {
    var narrow = window.innerWidth < 640;
    var STATUS_COLOR = { reg: "#0068f5", unpaid: "#9fc3f7", exam: "#0b3668", expired: "#c3cfe7", closed: "#6c757d", other: "#5a9bf6" };

    var y = {{ model.charts.years | tojson }};
    var last = y.y.length - 1;
    var c1 = echarts.init(document.getElementById("chart-years"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 40, right: 40, top: 32, bottom: 88, containLabel: true },
      xAxis: { type: "category", data: y.x },
      yAxis: [{ type: "value", name: "בקשות" }, { type: "value", name: "%", max: 100, splitLine: { show: false } }],
      dataZoom: [{ type: "inside" }, { type: "slider", height: 18, bottom: 28 }],
      series: [
        { type: "bar", name: "בקשות", data: y.y.map(function (v, i) {
          return (y.partial && i === last) ? { value: v, itemStyle: { color: "#9fc3f7" } } : v;
        }) },
        { type: "line", name: "עם דין קדימה מחו״ל (%)", yAxisIndex: 1, data: y.share, symbolSize: 4, itemStyle: { color: "#0b3668" } }
      ]
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    var s = {{ model.charts.status | tojson }};
    var c2 = echarts.init(document.getElementById("chart-status"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: narrow ? 2 : 4, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: s.names.slice().reverse() },
      series: [{ type: "bar", name: "בקשות", data: s.values.slice().reverse().map(function (v, i, a) {
        return { value: v, itemStyle: { color: STATUS_COLOR[s.keys[a.length - 1 - i]] } };
      }) }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });

    var co = {{ model.charts.cohort | tojson }};
    var c3 = echarts.init(document.getElementById("chart-cohort"));
    c3.setOption(window.GovEcharts.option({
      color: co.series.map(function (x) { return STATUS_COLOR[x.key]; }),
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 40, right: 16, top: 24, bottom: narrow ? 120 : 96, containLabel: true },
      xAxis: { type: "category", data: co.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value", max: 100, name: "%" },
      series: co.series.map(function (x) { return { type: "bar", stack: "s", name: x.name, data: x.data }; })
    }));
    window.addEventListener("resize", function () { c3.resize(); });
  })();
</script>

<script>
  (function () {
    var narrow = window.innerWidth < 640;
    function hbar(id, d, name, w, hi) {
      if (narrow) { w = Math.min(w, 120); }
      var n = d.names.length;
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis" },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: narrow ? 2 : 4, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: w, overflow: "truncate" } },
        series: [{ type: "bar", name: name, data: d.values.slice().reverse().map(function (v, i) {
          return (hi && hi[n - 1 - i]) ? { value: v, itemStyle: { color: "#0b3668" } } : v;
        }) }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    hbar("chart-classes", {{ model.charts.classes | tojson }}, "בקשות", 200, null);
    hbar("chart-words", {{ model.charts.words | tojson }}, "בקשות", 140, null);
    hbar("chart-offices", {{ model.charts.offices | tojson }}, "בקשות", 150, null);
    var tp = {{ model.charts.top | tojson }};
    hbar("chart-top", tp, "בקשות", 220, tp.foreign);

    var h = {{ model.charts.heat | tojson }};
    var c4 = echarts.init(document.getElementById("chart-heat"));
    c4.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return h.y[p.value[1]] + " · " + h.x[p.value[0]] + ": " + p.value[2] + "%";
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 96, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true }, axisLabel: { rotate: 45, fontSize: 11 } },
      yAxis: { type: "category", data: h.y, inverse: true, splitArea: { show: true }, axisLabel: { width: narrow ? 100 : 200, overflow: "truncate", fontSize: 11 } },
      visualMap: {
        min: 0, max: h.max, calculable: true, dimension: 2,
        orient: "horizontal", left: "center", bottom: 8,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells, label: { show: !narrow, fontSize: 10, fontFamily: "Rubik" },
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c4.resize(); });
  })();
</script>

