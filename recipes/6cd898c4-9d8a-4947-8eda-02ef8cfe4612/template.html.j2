<h1>רמזורים באר שבע</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
{%- for key in ["heads", "junctions", "numbered", "spacing"] %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.kpis[key].label }}</div>
  </div>
{%- endfor %}
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מפת הרמזורים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.map_note }}</p>
  <div id="map-main" class="h-72 md:h-[420px]"></div>
</section>
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">כמה רחוק מהמרכז</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.radial_note }}</p>
  <div id="chart-radial" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.radial_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.radial_caption }}</caption>
      <thead><tr><th scope="col">מרחק (ק״מ)</th><th scope="col">עם מספר</th><th scope="col">בלי מספר</th><th scope="col">סך הכול</th></tr></thead>
      <tbody>
{%- for r in model.tables.radial %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.numbered }}</td><td>{{ r.unnumbered }}</td><td>{{ r.total }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

{% if model.has_grid %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">צפיפות בליבת העיר</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.grid_note }}</p>
  <div id="chart-grid" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.grid_aria }}" data-fallback="explorer"></div>
</section>
{% endif %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">כמה רמזורים בכל צומת</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.sizes_note }}</p>
  <div id="chart-sizes" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.sizes_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.sizes_caption }}</caption>
      <thead><tr><th scope="col">רמזורים בצומת</th><th scope="col">צמתים</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.sizes %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

{% if model.has_span %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">רוחב הצומת</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.span_note }}</p>
  <div id="chart-span" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.span_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.span_caption }}</caption>
      <thead><tr><th scope="col">מרחק (מטרים)</th><th scope="col">צמתים</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.span %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{% endif %}

{% if model.has_spacing %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">המרחק בין צמתים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.spacing_note }}</p>
  <div id="chart-spacing" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.spacing_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.spacing_caption }}</caption>
      <thead><tr><th scope="col">מרחק (מטרים)</th><th scope="col">צמתים</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.spacing %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{% endif %}

{% if model.has_numbers %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">פערי המספור</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.numbers_note }}</p>
  <div id="chart-numbers" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.numbers_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.numbers_caption }}</caption>
      <thead><tr><th scope="col">טווח מספרים</th><th scope="col">בשימוש</th><th scope="col">חסרים</th></tr></thead>
      <tbody>
{%- for r in model.tables.numbers %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.used }}</td><td>{{ r.gap }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{% endif %}

<script>
  GovMap.create({
    container: "#map-main",
    resourceId: {{ inputs.main[0].id | tojson }},
    latField: "lat",
    lngField: "lon",
    projection: "wgs84",
    popupFields: [
      { field: "LightNumbe", label: "מספר רמזור" }
    ]
  });
</script>

<script>
  (function () {
    function mk(id) {
      var el = document.getElementById(id);
      if (!el) { return null; }
      var c = echarts.init(el);
      window.addEventListener("resize", function () { c.resize(); });
      return c;
    }
    function col(id, d, unit) {
      var c = mk(id);
      if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 16, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, hideOverlap: true } },
        yAxis: { type: "value" },
        series: [{ type: "bar", name: unit, data: d.values }]
      }));
    }
    function stack(id, names, a, b, la, lb) {
      var c = mk(id);
      if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { top: 0 },
        grid: { left: 8, right: 16, top: 40, bottom: 24, containLabel: true },
        xAxis: { type: "category", data: names, axisLabel: { interval: 0, hideOverlap: true } },
        yAxis: { type: "value" },
        series: [
          { type: "bar", stack: "s", name: la, data: a },
          { type: "bar", stack: "s", name: lb, data: b }
        ]
      }));
    }
    var r = {{ model.charts.radial | tojson }};
    stack("chart-radial", r.names, r.numbered, r.unnumbered, "עם מספר", "בלי מספר");
    col("chart-sizes", {{ model.charts.sizes | tojson }}, "צמתים");
    col("chart-span", {{ model.charts.span | tojson }}, "צמתים");
    col("chart-spacing", {{ model.charts.spacing | tojson }}, "צמתים");
    var n = {{ model.charts.numbers | tojson }};
    stack("chart-numbers", n.names, n.used, n.gap, "בשימוש", "חסרים");
  })();
</script>

<script>
  (function () {
    var g = {{ model.charts.grid | tojson }};
    var el = document.getElementById("chart-grid");
    if (!el || !g.data.length) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top" },
      grid: { left: 8, right: 16, top: 16, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: g.x, splitArea: { show: true }, name: "קו אורך", nameLocation: "middle", nameGap: 28 },
      yAxis: { type: "category", data: g.y, splitArea: { show: true }, name: "קו רוחב" },
      visualMap: { min: 0, max: g.max, dimension: 2, calculable: false, orient: "horizontal", left: "center", bottom: 0,
                   inRange: { color: ["#f1f7ff", "#0068f5", "#0b3668"] } },
      series: [{ type: "heatmap", name: "רמזורים", data: g.data, label: { show: false } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
