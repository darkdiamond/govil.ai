{% macro rank_table(rows, caption, head, unit="כלי רכב", share=true) -%}
<details class="mt-3">
  <summary class="text-sm text-subtle">הצג כטבלה</summary>
  <table class="mt-2 w-full text-sm">
    <caption class="sr-only">{{ caption }}</caption>
    <thead><tr><th scope="col">{{ head }}</th><th scope="col">{{ unit }}</th>{% if share %}<th scope="col">שיעור (%)</th>{% endif %}</tr></thead>
    <tbody>
{%- for r in rows %}
      <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td>{% if share %}<td>{{ r.share }}</td>{% endif %}</tr>
{%- endfor %}
    </tbody>
  </table>
</details>
{%- endmacro %}

{% macro col_table(rows, cols, caption, head) -%}
<details class="mt-3">
  <summary class="text-sm text-subtle">הצג כטבלה</summary>
  <div class="overflow-x-auto">
  <table class="mt-2 w-full text-sm">
    <caption class="sr-only">{{ caption }}</caption>
    <thead><tr><th scope="col">{{ head }}</th>{% for c in cols %}<th scope="col">{{ c }}</th>{% endfor %}</tr></thead>
    <tbody>
{%- for r in rows %}
      <tr><th scope="row">{{ r.name }}</th>{% for v in r.cols %}<td>{{ v }}</td>{% endfor %}</tr>
{%- endfor %}
    </tbody>
  </table>
  </div>
</details>
{%- endmacro %}

{% macro box_table(rows, caption, head, unit) -%}
<details class="mt-3">
  <summary class="text-sm text-subtle">הצג כטבלה</summary>
  <table class="mt-2 w-full text-sm">
    <caption class="sr-only">{{ caption }}</caption>
    <thead><tr><th scope="col">{{ head }}</th>{% if rows and rows[0].n is defined %}<th scope="col">כלי רכב</th>{% endif %}<th scope="col">רבעון תחתון ({{ unit }})</th><th scope="col">חציון ({{ unit }})</th><th scope="col">רבעון עליון ({{ unit }})</th></tr></thead>
    <tbody>
{%- for r in rows %}
      <tr><th scope="row">{{ r.name }}</th>{% if r.n is defined %}<td>{{ r.n }}</td>{% endif %}<td>{{ r.q1 }}</td><td>{{ r.med }}</td><td>{{ r.q3 }}</td></tr>
{%- endfor %}
    </tbody>
  </table>
</details>
{%- endmacro %}

