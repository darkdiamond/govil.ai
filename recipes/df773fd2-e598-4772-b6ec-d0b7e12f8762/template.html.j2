      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0, type: "scroll" },
      grid: { left: 8, right: 16, top: 40, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value" },
      dataZoom: [{ type: "inside", start: d.zoom, end: 100 },
                 { type: "slider", start: d.zoom, end: 100, bottom: 8, height: 16 }],
      series: d.series.map(function (s) { return { type: "bar", stack: "t", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    function box(id, b, unit, fmt, axisFmt) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "item", formatter: function (p) {
          var v = p.data.value || p.data;
          var o = v.length > 5 ? v.slice(1) : v;
          return b.names[p.dataIndex] + "<br>חציון: " + fmt(o[2]) + unit + "<br>רבעונים: " + fmt(o[1]) + " עד " + fmt(o[3]) +
            "<br>אחוזון 5 עד 95: " + fmt(o[0]) + " עד " + fmt(o[4]);
        } },
        grid: { left: 8, right: 16, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", scale: true, axisLabel: { hideOverlap: true, fontSize: 10, formatter: axisFmt } },
        yAxis: { type: "category", data: b.names, axisLabel: { width: 90, overflow: "truncate" } },
        series: [{ type: "boxplot", name: "התפלגות", data: b.data,
                   itemStyle: { color: "#dbe8fb", borderColor: "#0068f5" } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    function plain(v) { return String(v); }
    function num(v) { return v.toLocaleString("he-IL"); }
    box("chart-age", {{ model.charts.age | tojson }}, "", plain, plain);
    box("chart-payload", {{ model.charts.payload | tojson }}, "%", plain, "{value}%");
    box("chart-cc", {{ model.charts.cc | tojson }}, " סמ״ק", num, num);
  })();
</script>

<script>
  (function () {
    function pct100(id, d) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + "%"; } },
        legend: { bottom: 0, type: "scroll" },
        grid: { left: 8, right: 16, top: 8, bottom: 40, containLabel: true },
        xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
        yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 90, overflow: "truncate" } },
        series: d.series.map(function (s) {
          return { type: "bar", stack: "t", name: s.name, data: s.data.slice().reverse() };
        })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    function stackedH(id, d) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { bottom: 0, type: "scroll" },
        grid: { left: 8, right: 24, top: 8, bottom: 40, containLabel: true },
        xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true, fontSize: 10 } },
        yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 110, overflow: "truncate" } },
        series: d.series.map(function (s) {
          return { type: "bar", stack: "t", name: s.name, data: s.data.slice().reverse() };
        })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    function hbar(id, d) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true, fontSize: 10 } },
        yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 150, overflow: "truncate" } },
        series: [{ type: "bar", name: "כלי רכב", data: d.values.slice().reverse() }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    pct100("chart-fuel", {{ model.charts.fuel | tojson }});
    pct100("chart-drive", {{ model.charts.drive | tojson }});
    stackedH("chart-makers", {{ model.charts.makers | tojson }});
    stackedH("chart-countries", {{ model.charts.countries | tojson }});
    hbar("chart-models", {{ model.charts.models | tojson }});
  })();
</script>

