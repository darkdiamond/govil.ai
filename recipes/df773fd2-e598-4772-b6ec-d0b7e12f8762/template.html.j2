<script>
  (function () {
    var t = {{ model.charts.groups | tojson }};
    var c = echarts.init(document.getElementById("chart-groups"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        return p.name + ": " + p.value.toLocaleString("he-IL") + " כלי רכב";
      } },
      series: [{
        type: "sunburst", data: t, radius: ["10%", "92%"], sort: null,
        nodeClick: "rootToNode",
        itemStyle: { borderColor: "#fff", borderWidth: 1 },
        levels: [{},
                 { r0: "10%", r: "56%", label: { rotate: 0, fontSize: 11, width: 70, overflow: "truncate", minAngle: 22 } },
                 { r0: "56%", r: "92%", label: { rotate: "radial", fontSize: 10, minAngle: 8 } }]
      }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
