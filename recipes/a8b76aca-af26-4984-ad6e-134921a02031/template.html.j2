{%- if model.flags.city %}
<script>
  (function () {
    const U = window.__tipat;
    const d = {{ C.city | tojson }};
    const cities = d.cities.slice().reverse();
    const gap = d.gap.slice().reverse();
    const k = d.k.slice().reverse();
    const below = d.below.slice().reverse();
    U.mount("chart-city", function (el) {
      const sm = U.narrow(el);
      return {
        tooltip: { trigger: "item", formatter: function (p) {
          const i = p.dataIndex;
          return U.esc(cities[i]) + "<br/>פער ממוצע: " + U.signed(gap[i]) + " נק׳ אחוז<br/>" + below[i] + " מתוך " + k[i] + " מדדים מתחת לממוצע";
        } },
        grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value", axisLabel: { formatter: function (v) { return U.signed(v); } } },
        yAxis: { type: "category", data: cities, axisLabel: { fontSize: sm ? 10 : 12 } },
        series: [{ type: "bar", barMaxWidth: 18,
                   data: gap.map(function (v) { return { value: v, itemStyle: { color: v < 0 ? "#dc3545" : "#0068f5" } }; }),
                   label: { show: true, position: "right", fontSize: 10, formatter: function (p) { return U.signed(p.value); } } }]
      };
    });
  })();
  (function () {
    const U = window.__tipat;
    const d = {{ C.cityheat | tojson }};
    U.mount("chart-cityheat", function (el) {
      const sm = U.narrow(el);
      return {
        tooltip: { position: "top", formatter: function (p) {
          return U.esc(d.cities[p.value[1]]) + "<br/>" + U.esc(d.measures[p.value[0]]) + ": " + U.signed(p.value[2]) + " נק׳ אחוז מהשיעור הארצי";
        } },
        grid: { left: 8, right: 8, top: 8, bottom: sm ? 190 : 150, containLabel: true },
        xAxis: { type: "category", data: d.measures, splitArea: { show: true },
                 axisLabel: { interval: 0, rotate: 60, width: sm ? 110 : 150, overflow: "truncate", fontSize: sm ? 9 : 11 } },
        yAxis: { type: "category", data: d.cities, splitArea: { show: true }, axisLabel: { fontSize: sm ? 10 : 12 } },
        visualMap: { min: -d.abs, max: d.abs, calculable: true, orient: "horizontal", left: "center", bottom: 0,
                     itemHeight: sm ? 120 : 200, dimension: 2,
                     formatter: function (v) { return U.signed(v); },
                     inRange: { color: ["#dc3545", "#f6d5d8", "#ffffff", "#dbe8fb", "#0068f5"] },
                     textStyle: { fontFamily: "Rubik", color: "#0c3058" } },
        series: [{ type: "heatmap", data: d.cells,
                   label: { show: !sm, fontFamily: "Rubik", fontSize: 9,
                            formatter: function (p) { return p.value[2].toFixed(0); } } }]
      };
    });
  })();
</script>
{%- endif %}

{%- if model.flags.age %}
<script>
  (function () {
    const U = window.__tipat;
    const d = {{ C.age | tojson }};
    U.mount("chart-age", function (el) {
      return {
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", valueFormatter: function (v) { return U.pct(v); } },
        legend: { top: 0 },
        grid: { left: 8, right: 16, top: 40, bottom: 24, containLabel: true },
        xAxis: { type: "category", data: d.bands, name: "גיל", nameLocation: "middle", nameGap: 26 },
        yAxis: { type: "value", scale: true, axisLabel: { formatter: "{value}%" } },
        series: d.series.map(function (s) { return { type: "line", name: s.name, data: s.data, symbolSize: 7 }; })
      };
    });
  })();
</script>
{%- endif %}
