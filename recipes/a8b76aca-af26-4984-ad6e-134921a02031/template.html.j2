{% import "gov.j2" as gov %}
{%- set L = model.labels -%}
{%- set C = model.charts -%}
{%- set T = model.tables -%}
<h1>{{ model.agent_data.seo.name }}</h1>

<section class="card p-5 mb-6">
  {{ gov.head("info", "תקציר") }}
  <p class="m-0 text-subtle leading-relaxed">{{ model.agent_data.summary_he }}</p>
  <p class="mt-3 mb-0 text-sm text-subtle leading-relaxed">התכנית הלאומית למדדי איכות בבריאות בודקת בכל טיפת חלב (תחנה לבריאות המשפחה) אם בוצעה הפעולה הנדרשת לכל תינוק, ילד או אם שזכאים לה. שיעור הביצוע הוא מספר המקרים שבהם תועדה הפעולה חלקי כל המקרים המתאימים. המדדים במאגר: {{ L.intro_measures }}.</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור טיפת חלב לפי שם התחנה או יישוב ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: שם התחנה, יישוב, מחוז או קופת חולים, מדד ושנה</span>
  </span>
</a>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
  {{ gov.kpi(model.kpis.measures, "מדדי איכות במאגר") }}
  {{ gov.kpi(model.kpis.cases, L.cases_kpi) }}
  {{ gov.kpi(model.kpis.years, "שנות מדידה בנתונים") }}
  {{ gov.kpi(model.kpis.providers, "מחוזות וספקי שירות") }}
  {{ gov.kpi(model.kpis.cities, "יישובים עם תחנות") }}
{%- if model.flags.has_met %}
  {{ gov.kpi(model.kpis.met, "מדדים שעומדים ביעד מתוך המדדים שנקבע להם יעד") }}
{%- endif %}
</div>

{{ gov.insights(model.insights) }}

<section class="card p-5 mb-6">
  {{ gov.head("database", "כרטיס ציון: שיעור הביצוע בכל מדד") }}
  <p class="mt-0 mb-3 text-sm text-subtle">{{ L.score_lede }}</p>
  {{ gov.chart("chart-score", L.score_aria, "h-[520px] md:h-[480px]") }}
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ L.score_aria }}</caption>
      <thead><tr><th scope="col">מדד</th><th scope="col">הגדרה</th><th scope="col">שנה</th><th scope="col">מקרים</th><th scope="col">שיעור ביצוע</th><th scope="col">יעד</th><th scope="col">מצב</th><th scope="col">שינוי משנה קודמת (נק׳ אחוז)</th></tr></thead>
      <tbody>
{%- for r in T.score %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.def }}</td><td>{{ r.year }}</td><td dir="ltr">{{ r.n }}</td><td dir="ltr">{{ r.rate }}</td><td dir="ltr">{{ r.target }}</td><td>{{ r.status }}</td><td dir="ltr">{{ r.chg }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<section class="card p-5 mb-6">
  {{ gov.head("database", "מגמה שנתית לפי מדד") }}
  <p class="mt-0 mb-3 text-sm text-subtle">{{ L.trend_lede }}</p>
  {{ gov.chart("chart-trend", L.trend_aria, "h-[520px] md:h-[460px]") }}
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ L.trend_aria }}</caption>
      <thead><tr><th scope="col">מדד</th>{% for y in T.trend.years %}<th scope="col">{{ y }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for r in T.trend.rows %}
        <tr><th scope="row">{{ r.name }}</th>{% for c in r.cells %}<td dir="ltr">{{ c }}</td>{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
{%- if L.partial_note %}
    <p class="text-xs text-subtle mt-1">{{ L.partial_note }}</p>
{%- endif %}
  </details>
</section>

<section class="card p-5 mb-6">
  {{ gov.head("building-2", "משרד הבריאות, קופות החולים והעיריות") }}
  <p class="mt-0 mb-3 text-sm text-subtle">{{ L.owner_lede }}</p>
  {{ gov.chart("chart-owner", L.owner_aria, "h-[520px] md:h-[460px]") }}
