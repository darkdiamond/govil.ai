      <caption class="sr-only">{{ L.owner_aria }}</caption>
      <thead><tr>{% for c in T.owner.cols %}<th scope="col">{{ c }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for r in T.owner.rows %}
        <tr>{% for v in r %}{% if loop.first %}<th scope="row">{{ v }}</th>{% else %}<td dir="ltr">{{ v }}</td>{% endif %}{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<section class="card p-5 mb-6">
  {{ gov.head("map-pin", "השוואת מחוזות וספקי שירות לפי מדד") }}
  <p class="mt-0 mb-3 text-sm text-subtle">{{ L.prov_lede }}</p>
  <div class="flex flex-wrap items-center gap-2 mb-3">
    <label for="sel-prov" class="text-sm text-ink-deep">מדד:</label>
    <select id="sel-prov" class="border border-rule rounded-gov px-2 py-1 text-sm bg-white">
{%- for n in C.prov.measures %}
      <option value="{{ loop.index0 }}"{% if n == L.default_measure %} selected{% endif %}>{{ n }}</option>
{%- endfor %}
    </select>
  </div>
  <div id="chart-prov" class="h-[640px] md:h-[680px]" role="img" data-fallback="explorer" aria-label="{{ L.prov_aria }}"></div>
