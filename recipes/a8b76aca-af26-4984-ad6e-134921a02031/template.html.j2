<script>
  window.__tipat = {
    narrow: function (el) { return (el.clientWidth || 360) < 560; },
    pct: function (v) { return (v === null || v === undefined) ? "" : "‎" + v.toFixed(1) + "%"; },
    signed: function (v) {
      if (v === null || v === undefined) { return ""; }
      return "‎" + (v > 0 ? "+" : (v < 0 ? "−" : "")) + Math.abs(v).toFixed(1);
    },
    esc: function (s) { return echarts.format.encodeHTML(String(s)); },
    mount: function (id, build) {
      const el = document.getElementById(id);
      if (!el) { return null; }
      const chart = echarts.init(el);
      chart.setOption(window.GovEcharts.option(build(el)), true);
      window.addEventListener("resize", function () {
        chart.resize();
        chart.setOption(window.GovEcharts.option(build(el)), true);
      });
      return chart;
    }
  };
</script>

<script>
  (function () {
    const U = window.__tipat;
    const d = {{ C.score | tojson }};
    const colors = { ok: "#198754", below: "#dc3545", none: "#0068f5" };
    const statusText = { ok: "עומד ביעד", below: "מתחת ליעד", none: "ללא יעד" };
    const rows = d.slice().reverse();
    U.mount("chart-score", function (el) {
      const sm = U.narrow(el);
      return {
        color: window.GOVIL_PALETTE,
        tooltip: {
          trigger: "item",
          formatter: function (p) {
            const r = rows[p.dataIndex];
            let s = "<b>" + U.esc(r.name) + "</b><br/>" + U.esc(r.year) + ": " + U.pct(r.rate);
            s += "<br/>" + (r.target !== null ? "יעד: " + U.pct(r.target) + " (" + statusText[r.status] + ")" : "ללא יעד");
            if (r.chg !== null) { s += "<br/>שינוי מ-" + r.prev_year + ": " + U.signed(r.chg) + " נק׳ אחוז"; }
            s += "<br/>מקרים: " + r.n.toLocaleString("he-IL");
            return s;
          }
        },
        grid: { left: 8, right: 16, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value", min: 0, max: 100, axisLabel: { formatter: "{value}%" } },
        yAxis: { type: "category", data: rows.map(function (r) { return r.name; }),
                 axisLabel: { width: sm ? 120 : 220, overflow: "break", fontSize: sm ? 10 : 12 } },
        series: [
          { type: "bar", name: "שיעור ביצוע", barMaxWidth: 22,
            data: rows.map(function (r) { return { value: r.rate, itemStyle: { color: colors[r.status] } }; }),
            label: { show: true, position: "insideRight", color: "#fff", fontSize: 11,
                     formatter: function (p) { return p.value.toFixed(1) + "%"; } } },
          { type: "scatter", name: "יעד", symbol: "rect", symbolSize: [4, 20], itemStyle: { color: "#0b3668" },
            tooltip: { show: false },
            data: rows.map(function (r) { return r.target; }) }
        ]
      };
    });
  })();
</script>

<script>
  (function () {
    const U = window.__tipat;
    const d = {{ C.trend | tojson }};
    U.mount("chart-trend", function (el) {
      const sm = U.narrow(el);
      return {
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", valueFormatter: function (v) { return U.pct(v); } },
        legend: { type: "plain", bottom: 0, left: "center", itemGap: 8, itemWidth: 16, itemHeight: 9,
                  textStyle: { fontSize: sm ? 10 : 12 } },
        grid: { left: 8, right: 16, top: 16, bottom: sm ? 210 : 120, containLabel: true },
        xAxis: { type: "category", data: d.years },
        yAxis: { type: "value", min: 0, max: 100, axisLabel: { formatter: "{value}%" } },
        series: d.series.map(function (s) {
          return { type: "line", name: s.name, data: s.data, connectNulls: false, symbolSize: 7 };
        })
      };
    });
  })();
</script>

<script>
  (function () {
    const U = window.__tipat;
    const d = {{ C.owner | tojson }};
    const cells = [];
    d.rates.forEach(function (row, i) {
      row.forEach(function (v, j) { if (v !== null) { cells.push([i, j, v]); } });
    });
    const vals = cells.map(function (c) { return c[2]; });
    U.mount("chart-owner", function (el) {
      const sm = U.narrow(el);
      return {
        tooltip: { position: "top", formatter: function (p) {
          return U.esc(d.owners[p.value[0]]) + "<br/>" + U.esc(d.measures[p.value[1]]) + ": " + U.pct(p.value[2]);
        } },
        grid: { left: 8, right: 8, top: 8, bottom: 70, containLabel: true },
        xAxis: { type: "category", data: d.owners, splitArea: { show: true },
                 axisLabel: { interval: 0, rotate: sm ? 45 : 0, fontSize: sm ? 10 : 12 } },
        yAxis: { type: "category", data: d.measures, splitArea: { show: true },
                 axisLabel: { width: sm ? 110 : 220, overflow: "truncate", fontSize: sm ? 10 : 12 } },
        visualMap: { min: Math.min.apply(null, vals), max: Math.max.apply(null, vals), calculable: true,
                     orient: "horizontal", left: "center", bottom: 0, itemHeight: sm ? 120 : 200,
                     dimension: 2, formatter: function (v) { return v.toFixed(0) + "%"; },
                     inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
                     textStyle: { fontFamily: "Rubik", color: "#0c3058" } },
        series: [{ type: "heatmap", data: cells,
                   label: { show: !sm, fontFamily: "Rubik", fontSize: 10,
                            formatter: function (p) { return p.value[2].toFixed(0); } } }]
      };
    });
  })();
</script>

<script>
  (function () {
    const U = window.__tipat;
    const d = {{ C.prov | tojson }};
    const sel = document.getElementById("sel-prov");
    const chart = U.mount("chart-prov", function (el) { return build(el); });
    function build(el) {
      const sm = U.narrow(el);
      const name = d.measures[Number(sel.value)];
      const s = d.data[name];
      const labels = s.labels.slice().reverse();
      const rates = s.rates.slice().reverse();
      const ns = s.n.slice().reverse();
      const nat = d.national[name];
      return {
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "item", formatter: function (p) {
          return U.esc(labels[p.dataIndex]) + "<br/>" + U.pct(p.value) + " (מקרים: " + ns[p.dataIndex].toLocaleString("he-IL") + ")";
        } },
        grid: { left: 8, right: 16, top: 24, bottom: 24, containLabel: true },
        xAxis: { type: "value", min: 0, max: 100, axisLabel: { formatter: "{value}%" } },
        yAxis: { type: "category", data: labels, axisLabel: { width: sm ? 130 : 260, overflow: "truncate", fontSize: sm ? 10 : 12 } },
        series: [{ type: "bar", data: rates.map(function (v) {
                     return { value: v, itemStyle: { color: v < nat ? "#7aa7e8" : "#0068f5" } };
                   }), barMaxWidth: 18,
                   label: { show: true, position: "right", fontSize: 10, formatter: function (p) { return p.value.toFixed(1) + "%"; } },
                   markLine: { symbol: "none", lineStyle: { type: "dashed", color: "#0b3668" },
                               label: { formatter: "ארצי " + nat.toFixed(1) + "%", position: "end" },
                               data: [{ xAxis: nat }] } }]
      };
    }
    if (chart) {
      sel.addEventListener("change", function () {
        chart.setOption(window.GovEcharts.option(build(document.getElementById("chart-prov"))), true);
      });
    }
  })();
</script>

