<script>
  (function () {
    function mk(id, opt) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option(Object.assign({ color: window.GOVIL_PALETTE }, opt)));
      window.addEventListener("resize", function () { c.resize(); });
      return c;
    }
    function fmt(v) { return (v == null ? 0 : v).toLocaleString("he-IL"); }
    var P = window.GOVIL_PALETTE;

    var t = {{ model.charts.types | tojson }};
    mk("chart-types", {
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex, v = t.active[i] || t.passive[i] || t.other[i] || 0;
        var kind = t.passive[i] ? " (נוגדנים, חיסון סביל)" : "";
        return t.names[i] + " · " + t.gloss[i] + kind + "<br>" + fmt(v) + " אצוות";
      } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 40, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: t.names, inverse: true, axisLabel: { width: 100, overflow: "truncate", interval: 0, fontSize: 10 } },
      series: [
        { type: "bar", stack: "s", name: "תרכיב", data: t.active, itemStyle: { color: P[0] } },
        { type: "bar", stack: "s", name: "נוגדנים (חיסון סביל)", data: t.passive, itemStyle: { color: P[4] } },
        { type: "bar", stack: "s", name: "סוגים אחרים", data: t.other, itemStyle: { color: "#c3cfe7" } }
      ]
    });

    var tr = {{ model.charts.tree | tojson }};
    mk("chart-tree", {
      tooltip: { formatter: function (p) {
        var g = p.data && p.data.gloss ? " · " + p.data.gloss : "";
        return p.name + g + ": " + fmt(p.value) + " אצוות";
      } },
      series: [{
        type: "treemap", data: tr, roam: false, nodeClick: "zoomToNode", leafDepth: 1,
        top: 8, left: 4, right: 4, bottom: 32,
        breadcrumb: { bottom: 0, itemStyle: { color: "#0068f5" } },
        label: { show: true, fontFamily: "Rubik", formatter: "{b}" },
        upperLabel: { show: true, height: 22, fontFamily: "Rubik", color: "#fff" },
        levels: [
          { itemStyle: { borderColor: "#fff", borderWidth: 2, gapWidth: 2 } },
          { colorSaturation: [0.35, 0.6], itemStyle: { gapWidth: 1, borderColorSaturation: 0.6 } }
        ]
      }]
    });

    var st = {{ model.charts.status | tojson }};
    mk("chart-status", {
      tooltip: { trigger: "item", formatter: function (p) { return p.name + ": " + fmt(p.value) + " סוגי חיסון (" + p.percent + "%)"; } },
      legend: { bottom: 0 },
      series: [{
        type: "pie", radius: ["38%", "62%"], center: ["50%", "45%"],
        label: { show: true, formatter: "{c}", fontFamily: "Rubik" },
        data: st.map(function (d, i) { return { name: d.name, value: d.value, itemStyle: { color: [P[0], P[4], "#c3cfe7"][i] } }; })
      }]
    });
  })();
</script>

<script>
  (function () {
    function mk(id, opt) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option(Object.assign({ color: window.GOVIL_PALETTE }, opt)));
      window.addEventListener("resize", function () { c.resize(); });
      return c;
    }
    function fmt(v) { return (v == null ? 0 : v).toLocaleString("he-IL"); }
    function hbar(id, d, name) {
      mk(id, {
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return fmt(v) + " " + name; } },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 120, overflow: "truncate", interval: 0, fontSize: 11 } },
        series: [{ type: "bar", name: name, data: d.values }]
      });
    }
    hbar("chart-products", {{ model.charts.products | tojson }}, "אצוות");
    hbar("chart-manu", {{ model.charts.manu | tojson }}, "אצוות");

    var pa = {{ model.charts.pareto | tojson }};
    mk("chart-pareto", {
      tooltip: { trigger: "axis", formatter: function (ps) {
        var i = ps[0].dataIndex;
        return "מקום " + pa.x[i] + ": " + pa.names[i] + "<br>" + fmt(pa.values[i]) + " אצוות · מצטבר " + pa.cum[i] + "%";
      } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: pa.x, name: "דירוג", nameLocation: "middle", nameGap: 24, axisLabel: { hideOverlap: true } },
      yAxis: [
        { type: "value", name: "אצוות" },
        { type: "value", name: "% מצטבר", min: 0, max: 100, splitLine: { show: false } }
      ],
      series: [
        { type: "bar", name: "אצוות לשם מסחרי", data: pa.values },
        { type: "line", name: "חלק מצטבר", yAxisIndex: 1, data: pa.cum, showSymbol: false, lineStyle: { width: 2.5 } }
      ]
    });

    var mc = {{ model.charts.manucat | tojson }};
    mk("chart-manucat", {
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 40, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: mc.names, inverse: true, axisLabel: { width: 120, overflow: "truncate", interval: 0, fontSize: 11 } },
      series: [
        { type: "bar", stack: "s", name: "עם אצוות", data: mc.with_b },
        { type: "bar", stack: "s", name: "בלי אצוות", data: mc.without_b, itemStyle: { color: "#c3cfe7" } }
      ]
    });
  })();
</script>

<script>
  (function () {
    function heat(id, h, xname, unit) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        tooltip: { position: "top", formatter: function (p) {
          return h.y[p.value[1]] + " · " + xname + h.x[p.value[0]] + ": " + p.value[2].toLocaleString("he-IL") + " " + unit;
        } },
        grid: { left: 16, right: 16, top: 16, bottom: 72, containLabel: true },
        xAxis: { type: "category", data: h.x, splitArea: { show: true }, axisLabel: { interval: 0, rotate: h.x.length > 10 ? 45 : 0 } },
        yAxis: { type: "category", data: h.y, inverse: true, splitArea: { show: true }, axisLabel: { width: 100, overflow: "truncate", interval: 0, fontSize: 11 } },
        visualMap: {
          min: 0, max: h.max, calculable: true, dimension: 2,
          orient: "horizontal", left: "center", bottom: 0,
          inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
          textStyle: { fontFamily: "Rubik", color: "#0c3058" }
        },
        series: [{ type: "heatmap", data: h.cells,
                   emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    heat("chart-heat", {{ model.charts.heat | tojson }}, "", "אצוות");
    heat("chart-blen", {{ model.charts.blen | tojson }}, "אורך ", "אצוות");
  })();
</script>

<script>
  (function () {
    function mk(id, opt) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option(Object.assign({ color: window.GOVIL_PALETTE }, opt)));
      window.addEventListener("resize", function () { c.resize(); });
      return c;
    }
    var tc = {{ model.charts.typecat | tojson }};
    mk("chart-typecat", {
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 40, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: tc.names, inverse: true, axisLabel: { width: 100, overflow: "truncate", interval: 0, fontSize: 11 } },
      series: [
        { type: "bar", stack: "s", name: "עם אצוות", data: tc.with_b },
        { type: "bar", stack: "s", name: "בלי אצוות", data: tc.without_b, itemStyle: { color: "#c3cfe7" } }
      ]
    });
{%- if model.charts.evo %}
    var ev = {{ model.charts.evo | tojson }};
    mk("chart-evo", {
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex;
        return ev.names[i] + " (" + ev.mf[i] + ")<br>קוד " + ev.codes[i] + " · " + ev.values[i].toLocaleString("he-IL") + " אצוות";
      } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: ev.names, inverse: true, axisLabel: { width: 120, overflow: "truncate", interval: 0, fontSize: 10 } },
      series: [{ type: "bar", name: "אצוות", data: ev.values }]
    });
{%- endif %}
  })();
</script>
