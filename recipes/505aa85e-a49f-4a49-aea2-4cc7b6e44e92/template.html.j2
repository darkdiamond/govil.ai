      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: y.x, axisLabel: { interval: 0, rotate: 40, fontSize: 10 } },
      yAxis: { type: "value", name: "קונסולים", minInterval: 1 },
      series: [
        { type: "bar", name: IL, data: y.il, itemStyle: { color: "#0068f5" } },
        { type: "bar", name: AB, data: y.ab, itemStyle: { color: "#7fb0f8" } }
      ]
    });
    var t = {{ model.charts.titles | tojson }};
    mk("chart-titles", {
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 40, top: 8, bottom: 40, containLabel: true },
      xAxis: { type: "value", minInterval: 1 },
      yAxis: { type: "category", data: t.names, inverse: true, axisLabel: { width: 120, overflow: "truncate" } },
      series: [
        { type: "bar", name: IL, data: t.il, itemStyle: { color: "#0068f5" }, label: { show: true, position: "right" } },
        { type: "bar", name: AB, data: t.ab, itemStyle: { color: "#7fb0f8" }, label: { show: true, position: "right" } }
      ]
    });
    var g = {{ model.charts.gender | tojson }};
    var gc = ["#0b3668", "#0068f5", "#c3cfe7"];
    mk("chart-gender", {
      tooltip: {
        trigger: "axis", axisPointer: { type: "shadow" }, confine: true,
        formatter: function (ps) {
          var out = ps[0].name;
          ps.forEach(function (p) {
            out += "<br>" + p.marker + p.seriesName + ": " + g.series[p.seriesIndex].counts[p.dataIndex] + " (" + p.value + "%)";
          });
          return out;
        }
      },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 8, bottom: 40, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: [IL, AB] },
      series: g.series.map(function (s, i) {
        return { type: "bar", stack: "t", barWidth: 36, name: s.name, data: s.data, itemStyle: { color: gc[i % gc.length] } };
      })
    });
    var k = {{ model.charts.contacts | tojson }};
    mk("chart-contacts", {
      tooltip: {
        trigger: "axis", axisPointer: { type: "shadow" },
        formatter: function (ps) {
          var out = ps[0].name;
          ps.forEach(function (p) {
            var n = p.seriesIndex === 0 ? k.il_n[p.dataIndex] : k.ab_n[p.dataIndex];
            out += "<br>" + p.marker + p.seriesName + ": " + n + " (" + p.value + "%)";
          });
          return out;
        }
      },
      legend: { bottom: 0 },
      grid: { left: 16, right: 48, top: 8, bottom: 40, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: k.names, inverse: true },
      series: [
        { type: "bar", name: IL, data: k.il, itemStyle: { color: "#0068f5" }, label: { show: true, position: "right", formatter: "{c}%" } },
        { type: "bar", name: AB, data: k.ab, itemStyle: { color: "#7fb0f8" }, label: { show: true, position: "right", formatter: "{c}%" } }
      ]
    });
  })();
</script>
