{% if model.flags.has_map %}
<script>
  (function () {
    var d = {{ model.charts.map | tojson }};
    var el = document.getElementById("map-world");
    if (!el || !window.L) { return; }
    var map = L.map(el, { center: [20, 30], zoom: 1, minZoom: 0, zoomSnap: 0.25, scrollWheelZoom: false });
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 10, attribution: "© OpenStreetMap"
    }).addTo(map);
    var col = { il: "#0068f5", ab: "#7fb0f8", both: "#0b3668" };
    var bounds = [];
    d.points.forEach(function (p) {
      var c = col[p[5]];
      var mk = L.circleMarker([p[0], p[1]], {
        radius: 4 + 2.5 * Math.sqrt(p[3] + p[4]), color: "#ffffff", weight: 1,
        fillColor: c, fillOpacity: 0.85
      }).addTo(map);
      var box = document.createElement("div");
      var t = document.createElement("strong");
      t.textContent = p[2];
      box.appendChild(t);
      [["קונסולי כבוד שלה בישראל", String(p[3])], ["קונסולי כבוד של ישראל בה", String(p[4])]].forEach(function (row) {
        var line = document.createElement("div");
        line.textContent = row[0] + ": " + row[1];
        box.appendChild(line);
      });
      mk.bindPopup(box);
      bounds.push([p[0], p[1]]);
    });
    if (bounds.length) { map.fitBounds(bounds, { padding: [12, 12] }); }
  })();
</script>
{% endif %}

<script>
  (function () {
    function mk(id, opt) {
      var el = document.getElementById(id);
      if (!el) { return; }
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option(Object.assign({ color: window.GOVIL_PALETTE }, opt)));
      window.addEventListener("resize", function () { c.resize(); });
    }
    var IL = "בישראל", AB = "בחו״ל";
    var r = {{ model.charts.regions | tojson }};
    mk("chart-regions", {
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: r.x, axisLabel: { interval: 0, fontSize: 11 } },
      yAxis: { type: "value", name: "קונסולים", minInterval: 1 },
      series: [
        { type: "bar", name: IL, data: r.il, itemStyle: { color: "#0068f5" } },
        { type: "bar", name: AB, data: r.ab, itemStyle: { color: "#7fb0f8" } }
      ]
    });
    var o = {{ model.charts.overlap | tojson }};
    mk("chart-overlap", {
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: o.x, axisLabel: { interval: 0, fontSize: 11 } },
      yAxis: { type: "value", name: "מדינות", minInterval: 1 },
      series: [
        { type: "bar", stack: "t", name: "שני הכיוונים", data: o.both, itemStyle: { color: "#0b3668" } },
        { type: "bar", stack: "t", name: "בישראל בלבד", data: o.il, itemStyle: { color: "#0068f5" } },
        { type: "bar", stack: "t", name: "בחו״ל בלבד", data: o.ab, itemStyle: { color: "#7fb0f8" } }
      ]
    });
  })();
</script>

<script>
  (function () {
    function mk(id, opt) {
      var el = document.getElementById(id);
      if (!el) { return; }
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option(Object.assign({ color: window.GOVIL_PALETTE }, opt)));
      window.addEventListener("resize", function () { c.resize(); });
    }
    function hbar(id, d, name, color) {
      mk(id, {
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 16, right: 32, top: 8, bottom: 16, containLabel: true },
        xAxis: { type: "value", minInterval: 1 },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 120, overflow: "truncate" } },
        series: [{ type: "bar", name: name, data: d.values, itemStyle: { color: color }, label: { show: true, position: "right" } }]
      });
    }
    hbar("chart-top-ab", {{ model.charts.top_ab | tojson }}, "קונסולים ישראליים", "#7fb0f8");
    hbar("chart-top-il", {{ model.charts.top_il | tojson }}, "קונסולים בישראל", "#0068f5");
    hbar("chart-areas", {{ model.charts.areas | tojson }}, "קונסולים", "#0068f5");
  })();
</script>

