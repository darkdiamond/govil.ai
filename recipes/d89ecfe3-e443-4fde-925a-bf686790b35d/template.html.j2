<script>
  (function () {
    var el = document.getElementById("chart-protection");
    if (el) {
      var p = {{ model.charts.protection | tojson }};
      var c8 = echarts.init(el);
      c8.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { bottom: 0 },
        grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
        xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: p.names, inverse: true },
        series: [{ type: "bar", name: "ממוגני אבנים", data: p.stone },
                 { type: "bar", name: "ממוגני ירי", data: p.bullet }]
      }));
      window.addEventListener("resize", function () { c8.resize(); });
    }

    var t = {{ model.charts.tree | tojson }};
    var pal = window.GOVIL_PALETTE, light = ["#6c9fd8", "#b7d2f7", "#dbe8fb"];
    t.forEach(function (node, i) {
      var col = pal[i % pal.length];
      var txt = light.indexOf(col.toLowerCase()) >= 0 ? "#0c3058" : "#ffffff";
      node.itemStyle = { color: col };
      node.label = { color: txt };
      node.upperLabel = { color: txt };
      (node.children || []).forEach(function (ch) { ch.label = { color: txt }; });
    });
    var c9 = echarts.init(document.getElementById("chart-tree"));
    c9.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { formatter: function (x) { return x.name + ": " + x.value.toLocaleString("he-IL") + " אוטובוסים"; } },
      series: [{ type: "treemap", data: t, roam: false, leafDepth: 1,
                 breadcrumb: { show: true, bottom: 4 },
                 top: 8, bottom: 40, left: 8, right: 8,
                 label: { fontFamily: "Rubik", fontSize: 12 },
                 upperLabel: { show: true, height: 22, fontFamily: "Rubik" },
                 levels: [{ itemStyle: { borderColor: "#ffffff", borderWidth: 2, gapWidth: 2 } },
                          { itemStyle: { borderColor: "#ffffff", borderWidth: 1, gapWidth: 1 } }] }]
    }));
    window.addEventListener("resize", function () { c9.resize(); });
  })();
</script>
