      xAxis: { type: "category", data: a.names, name: "אלפי ק״מ", nameLocation: "middle", nameGap: 28 },
      yAxis: { type: "value", name: "אוטובוסים" },
      series: a.series.map(function (s) { return { type: "bar", name: s.name, data: s.data }; })
