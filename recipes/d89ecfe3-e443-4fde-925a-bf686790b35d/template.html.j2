      <tbody>
{%- for r in model.tables.clusters %}
        <tr><th scope="row">{{ r.cluster }}</th><td>{{ r.op }}</td><td>{{ r.n }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<script>
  (function () {
    var y = {{ model.charts.by_year | tojson }};
    var c1 = echarts.init(document.getElementById("chart-year"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: y.x },
      yAxis: { type: "value", name: "אוטובוסים" },
      series: y.series.map(function (s) { return { type: "bar", stack: "total", name: s.name, data: s.data,
        itemStyle: s.name === "לא ידוע" ? { color: "#c3cfe7" } : undefined }; })
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    var m = {{ model.charts.mix | tojson }};
    var c2 = echarts.init(document.getElementById("chart-mix"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: m.x },
      yAxis: { type: "value", name: "%", max: 100 },
      series: m.series.map(function (s) { return { type: "line", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    function sty(name) { return name === "לא ידוע" ? { color: "#c3cfe7" } : undefined; }
    function stackH(id, d) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { bottom: 0 },
        grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
        xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true },
        series: d.series.map(function (s) { return { type: "bar", stack: "total", name: s.name, data: s.data, itemStyle: sty(s.name) }; })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    stackH("chart-operators", {{ model.charts.operators | tojson }});
    stackH("chart-countries", {{ model.charts.countries | tojson }});

    var s = {{ model.charts.scatter | tojson }};
    var maxN = Math.max.apply(null, s.points.map(function (p) { return p[2]; }).concat([1]));
    var c3 = echarts.init(document.getElementById("chart-scatter"));
    c3.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        return p.value[3] + "<br>גיל ממוצע: " + p.value[0] + " שנים<br>חשמליים: " + p.value[1] +
          "%<br>אוטובוסים: " + p.value[2].toLocaleString("he-IL");
      } },
      grid: { left: 16, right: 24, top: 32, bottom: 32, containLabel: true },
      xAxis: { type: "value", name: "גיל ממוצע (שנים)", nameLocation: "middle", nameGap: 28, scale: true },
      yAxis: { type: "value", name: "% חשמליים", max: 100 },
      series: [{ type: "scatter", data: s.points,
                 symbolSize: function (v) { return 8 + 34 * Math.sqrt(v[2] / maxN); },
                 itemStyle: { opacity: 0.75 },
                 label: { show: true, position: "top", fontSize: 10, formatter: function (p) { return p.value[2] >= maxN / 3 ? p.value[3] : ""; } },
                 labelLayout: { hideOverlap: true } }]
    }));
    window.addEventListener("resize", function () { c3.resize(); });
  })();
</script>

<script>
  (function () {
    var z = {{ model.charts.size_type | tojson }};
    var c4 = echarts.init(document.getElementById("chart-size"));
    c4.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: z.names, inverse: true },
      series: z.series.map(function (s) { return { type: "bar", stack: "total", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c4.resize(); });

    var b = {{ model.charts.seats | tojson }};
    var c5 = echarts.init(document.getElementById("chart-seats"));
    c5.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        var v = p.value.slice(-5);
        return p.name + "<br>מינימום: " + v[0] + "<br>רבעון תחתון: " + v[1] + "<br>חציון: " + v[2] +
          "<br>רבעון עליון: " + v[3] + "<br>מקסימום: " + v[4];
      } },
      grid: { left: 16, right: 24, top: 32, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: b.names, axisLabel: { interval: 0, rotate: 30 } },
      yAxis: { type: "value", name: "מושבים" },
      series: [{ type: "boxplot", name: "מושבים", data: b.boxes,
                 itemStyle: { color: "#dbe8fb", borderColor: "#0068f5" } }]
    }));
    window.addEventListener("resize", function () { c5.resize(); });
  })();
</script>

<script>
