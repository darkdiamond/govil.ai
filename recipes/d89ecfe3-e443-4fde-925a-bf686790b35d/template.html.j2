    c6.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v === null || v === undefined ? "—" : v.toLocaleString("he-IL") + " ק״מ"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: k.x },
      yAxis: { type: "value", name: "ק״מ", axisLabel: { formatter: function (v) { return (v / 1000) + " א׳"; } } },
      series: k.series.map(function (s) { return { type: "line", name: s.name, data: s.data, connectNulls: false }; })
    }));
    window.addEventListener("resize", function () { c6.resize(); });

    var a = {{ model.charts.annual | tojson }};
    var c7 = echarts.init(document.getElementById("chart-annual"));
