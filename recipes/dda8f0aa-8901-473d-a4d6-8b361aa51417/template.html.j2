<script>
  (function () {
    function hbar(id, d, unit, labels, full) {
      var el = document.getElementById(id);
      var c = echarts.init(el);
      var lw = Math.max(110, Math.min(300, Math.round(el.clientWidth * 0.42)));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", formatter: function (p) {
          var i = p[0].dataIndex;
          return (full ? full[i] : d.names[i]) + "<br/>" + p[0].value.toLocaleString("he-IL") + " " + unit;
        } },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: el.clientWidth < 500 ? 3 : 5 },
        yAxis: { type: "category", data: labels || d.names, inverse: true,
                 axisLabel: { width: lw, overflow: "truncate" } },
        series: [{ type: "bar", name: unit, data: d.values }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    var o = {{ model.charts.orig | tojson }};
    hbar("chart-orig", o, "תקנים");
    var t = {{ model.charts.topics | tojson }};
    hbar("chart-topics", t, "תקנים", t.short, t.names);
    hbar("chart-routes", {{ model.charts.routes | tojson }}, "תקנים");
    hbar("chart-cassis", {{ model.charts.cassis | tojson }}, "מסלולים");
    hbar("chart-bodies", {{ model.charts.bodies | tojson }}, "מסלולים");
    hbar("chart-process", {{ model.charts.process | tojson }}, "תקנים");
    hbar("chart-actions", {{ model.charts.actions | tojson }}, "פרסומים");
    var g = {{ model.charts.gaz_std | tojson }};
    hbar("chart-gaz-std", g, "פרסומים", null, g.names.map(function (x, i) { return x + " " + g.full[i]; }));
    hbar("chart-reform", {{ model.charts.reform | tojson }}, "מספרי תקן");
  })();
</script>

<script>
  (function () {
    function vbar(id, d, unit) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis" },
        grid: { left: 40, right: 16, top: 24, bottom: 32, containLabel: true },
        xAxis: { type: "category", data: d.names },
        yAxis: { type: "value", name: unit },
        series: [{ type: "bar", name: unit, data: d.values }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    vbar("chart-groups", {{ model.charts.groups | tojson }}, "תקנים");
    vbar("chart-amend", {{ model.charts.amend | tojson }}, "תקנים");

    function stacked(id, x, series, unit, zoom) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis" },
        legend: { bottom: 0, type: "scroll" },
        grid: { left: 40, right: 16, top: 24, bottom: 64, containLabel: true },
        xAxis: { type: "category", data: x },
        yAxis: { type: "value", name: unit },
        series: series.map(function (s) { return { type: "bar", stack: "total", name: s.name, data: s.data }; })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    var e = {{ model.charts.editions | tojson }};
    stacked("chart-editions", e.x, [{ name: "מאומצים", data: e.adopt }, { name: "מקוריים", data: e.orig }], "תקנים");
    var gz = {{ model.charts.gazette | tojson }};
    stacked("chart-gazette", gz.x, gz.series, "פרסומים");
    var eu = {{ model.charts.eu | tojson }};
    stacked("chart-eu", eu.x, eu.series, "אסדרות");
  })();
</script>
