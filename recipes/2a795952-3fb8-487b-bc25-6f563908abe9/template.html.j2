<h1>קוד מחלף: רשימת המחלפים בכבישים הבין עירוניים</h1>

<style>
  .mih-table th, .mih-table td { padding: 0.35rem 0.5rem; text-align: start; vertical-align: top; }
  .mih-table tbody tr { border-top: 1px solid #c3cfe7; }
  .mih-table thead th { font-weight: 600; color: #0b3668; }
  .mih-wide { min-width: 560px; }
  .mih-code { font-family: ui-monospace, monospace; }
</style>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור מחלף לפי קוד, שם או מספר כביש ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: קוד המחלף, שם המחלף, סוג המחלף, מספרי הכבישים המתחברים ורשות התמרור.</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.total_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.full.tone }} mb-1" dir="ltr">{{ model.kpis.full.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.full_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.roads.tone }} mb-1" dir="ltr">{{ model.kpis.roads.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.roads_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.lead_auth.tone }} mb-1" dir="ltr">{{ model.kpis.lead_auth.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.lead_auth_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">סוגי המחלפים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.types_note }}</p>
    <div id="chart-types" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.types_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mih-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.types_aria }}</caption>
        <thead><tr><th scope="col">סוג</th><th scope="col">מחלפים</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.types %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr" class="text-start">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/list.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">כמה כבישים מחבר כל מחלף</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.nroads_note }}</p>
    <div id="chart-nroads" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.nroads_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mih-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.nroads_aria }}</caption>
        <thead><tr><th scope="col">כבישים ממוספרים</th><th scope="col">מחלפים</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.nroads %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr" class="text-start">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מי אחראי על המחלפים: רשויות התמרור</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.auth_note }}</p>
  <div id="chart-auth" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.auth_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="mih-table mih-wide mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.auth_aria }}</caption>
        <thead><tr><th scope="col">רשות תמרור</th><th scope="col">סה״כ</th><th scope="col">שיעור</th>{% for t in model.tables.type_cols %}<th scope="col">{{ t }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in model.tables.auth %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.total }}</td><td dir="ltr" class="text-start">{{ r.share }}</td>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>

{% if model.flags.has_roads %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">באילו כבישים הכי הרבה מחלפים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.roads_note }}</p>
  <div id="chart-roads" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.roads_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mih-table mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.roads_aria }}</caption>
      <thead><tr><th scope="col">כביש</th><th scope="col">מחלפים</th><th scope="col">כבישים מתחברים</th></tr></thead>
      <tbody>
{%- for r in model.tables.roads %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.n }}</td><td>{{ r.partners }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">דרגת הכבישים המתחברים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.class_note }}</p>
    <div id="chart-classes" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.class_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mih-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.class_aria }}</caption>
        <thead><tr><th scope="col">דרגת כביש</th><th scope="col">חיבורים</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.classes %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr" class="text-start">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
{% if model.flags.has_pairs %}
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">אילו דרגות כביש נפגשות במחלף</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.pair_note }}</p>
    <div id="chart-pairs" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.pair_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mih-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.pair_aria }}</caption>
        <thead><tr><th scope="col">צירוף דרגות</th><th scope="col">מחלפים</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.pairs %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr" class="text-start">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
{% endif %}
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">המחלפים לאורך הכבישים המרכזיים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.roaddir_note }}</p>
{%- for g in model.tables.road_dirs %}
  <details class="mt-2">
    <summary class="font-semibold text-ink-deep">{{ g.label }} <span class="text-sm font-normal text-subtle">({{ g.count }} מחלפים)</span></summary>
    <div class="overflow-x-auto">
      <table class="mih-table mt-2 w-full text-sm">
        <caption class="sr-only">מחלפים ב{{ g.label }}</caption>
        <thead><tr><th scope="col">מחלף</th><th scope="col">קוד</th><th scope="col">סוג</th><th scope="col">כבישים נוספים</th></tr></thead>
        <tbody>
{%- for r in g.rows %}
          <tr><th scope="row">{{ r.name }}</th><td class="mih-code" dir="ltr">{{ r.code }}</td><td>{{ r.type }}</td><td>{{ r.others }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
{%- endfor %}
</section>
{% endif %}

{% if model.flags.has_junctions %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מחלפים מערכתיים ופיצולים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.junction_note }}</p>
  <div class="overflow-x-auto">
    <table class="mih-table mih-wide w-full text-sm">
      <caption class="sr-only">מחלפים מערכתיים ופיצולים</caption>
      <thead><tr><th scope="col">מחלף</th><th scope="col">קוד</th><th scope="col">סוג</th><th scope="col">כבישים</th><th scope="col">רשות תמרור</th></tr></thead>
      <tbody>
{%- for r in model.tables.junctions %}
        <tr><th scope="row">{{ r.name }}</th><td class="mih-code" dir="ltr">{{ r.code }}</td><td>{{ r.type }}</td><td>{{ r.roads }}</td><td>{{ r.auth }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endif %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">שכבה הכוללת את כל המחלפים ברשת הבין עירונית, כולל מחלפונים וחיבורים אחרים, המקבלים קוד מחלף</p>
</section>

<script>
  (function () {
    function bars(id, d, name, horizontal) {
      var el = document.getElementById(id);
      if (!el) { return; }
      var c = echarts.init(el);
      var narrow = el.clientWidth < 500;
      var cat = { type: "category", data: d.names, inverse: !!horizontal,
        axisLabel: horizontal ? { width: narrow ? 110 : 180, overflow: "truncate" } : { interval: 0, width: narrow ? 60 : 90, overflow: "break", fontSize: narrow ? 10 : 12 } };
      var val = { type: "value", minInterval: 1, axisLabel: { show: !narrow || !horizontal } };
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 12, right: 36, top: 16, bottom: 8, containLabel: true },
        xAxis: horizontal ? val : cat,
        yAxis: horizontal ? cat : val,
        series: [{ type: "bar", name: name, data: d.values, label: { show: true, position: horizontal ? "right" : "top" } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    bars("chart-types", {{ model.charts.types | tojson }}, "מחלפים", true);
    bars("chart-nroads", {{ model.charts.nroads | tojson }}, "מחלפים", false);
    bars("chart-classes", {{ model.charts.classes | tojson }}, "חיבורים", true);
    bars("chart-pairs", {{ model.charts.pairs | tojson }}, "מחלפים", true);
  })();
</script>

<script>
  (function () {
    var el = document.getElementById("chart-auth");
    var d = {{ model.charts.auth | tojson }};
    var c = echarts.init(el);
    var narrow = el.clientWidth < 500;
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        var out = [echarts.format.encodeHTML(d.names[i]) + ": " + d.totals[i]];
        p.forEach(function (s) {
          if (s.value > 0) { out.push(echarts.format.encodeHTML(s.seriesName) + ": " + s.value); }
        });
        return out.join("<br>");
      } },
      legend: narrow ? { bottom: 0, type: "plain", itemWidth: 12, itemHeight: 8, textStyle: { fontSize: 11 } } : { bottom: 0, type: "scroll" },
      grid: { left: 12, right: 16, top: 8, bottom: narrow ? 72 : 40, containLabel: true },
      xAxis: { type: "value", minInterval: 1, splitNumber: narrow ? 3 : 5 },
      yAxis: { type: "category", data: d.names, inverse: true,
        axisLabel: { width: narrow ? 120 : 220, overflow: "truncate", fontSize: narrow ? 11 : 12 } },
      series: d.series.map(function (s) {
        return { type: "bar", name: s.name, stack: "a", data: s.data };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var el = document.getElementById("chart-roads");
    if (!el) { return; }
    var d = {{ model.charts.roads | tojson }};
    var c = echarts.init(el);
    var narrow = el.clientWidth < 500;
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0, type: "plain", itemWidth: 12, itemHeight: 8 },
      grid: { left: 12, right: 36, top: 8, bottom: 32, containLabel: true },
      xAxis: { type: "value", minInterval: 1, axisLabel: { show: !narrow } },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [
        { type: "bar", name: "מחלפים לאורך הכביש", data: d.n, label: { show: true, position: "right" } },
        { type: "bar", name: "כבישים ממוספרים מתחברים", data: d.partners, label: { show: !narrow, position: "right" } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
