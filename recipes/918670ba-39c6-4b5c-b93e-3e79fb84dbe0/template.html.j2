<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מפעלים מדווחים לפי שנה</h2>
  </div>
  <p class="mt-0 mb-3 text-sm text-subtle">{{ model.labels.sites_lede }}</p>
  <div id="chart-sites" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.sites_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.sites_aria }}</caption>
      <thead><tr><th scope="col">שנת דיווח</th><th scope="col">מפעלים</th><th scope="col">פחמן דו-חמצני (מיליון טון)</th><th scope="col">פסולת שהועברה (אלפי טון)</th></tr></thead>
      <tbody>
{%- for r in model.tables.years %}
        <tr><th scope="row">{{ r.year }}</th><td>{{ r.sites | fmt_int }}</td><td>{{ r.co2 | fmt_num(2) }}</td><td>{{ r.waste | fmt_int }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
