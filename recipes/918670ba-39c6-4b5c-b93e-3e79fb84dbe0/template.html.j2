<script>
  (function () {
    var d = {{ model.charts.air | tojson }};
    var c = echarts.init(document.getElementById("chart-air"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", formatter: function (p) {
        var s = p.length ? p[0].axisValueLabel : "";
        p.forEach(function (it) {
          var t = d.series[it.seriesIndex].tonnes[it.dataIndex];
          s += "<br>" + it.marker + echarts.format.encodeHTML(it.seriesName) + ": " + it.value + " (" + t.toLocaleString("he-IL") + " טון)";
        });
        return s;
      } },
      legend: { bottom: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 32, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", name: "מדד" },
      series: d.series.map(function (s) { return { type: "line", name: s.name, data: s.index, symbolSize: 6 }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    function hbar(id, d, unit, color) {
      var el = document.getElementById(id);
      if (!el) { return; }
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option({
        color: [color],
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v.toLocaleString("he-IL") + " " + unit; } },
        grid: { left: 16, right: 16, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value" },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 150, overflow: "truncate", fontSize: 11, interval: 0 } },
        series: [{ type: "bar", data: d.values, barMaxWidth: 24 }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    hbar("chart-co2-top", {{ model.charts.co2_top | tojson }}, "אלפי טון", "#0b3668");
    hbar("chart-activity", {{ model.charts.activity | tojson }}, "מפעלים", "#0068f5");
    hbar("chart-waste-top", {{ model.charts.waste_top | tojson }}, "אלפי טון", "#0b3668");
{%- if model.charts.sea.names %}
    hbar("chart-sea", {{ model.charts.sea | tojson }}, "טון", "#0068f5");
{%- endif %}
{%- if model.charts.sewer.names %}
    hbar("chart-sewer", {{ model.charts.sewer | tojson }}, "טון", "#0068f5");
{%- endif %}
  })();
</script>

<script>
  (function () {
    function dual(id, d) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { bottom: 0 },
        grid: { left: 16, right: 16, top: 16, bottom: 48, containLabel: true },
        xAxis: [{ type: "value", name: "מפעלים", position: "top" }, { type: "value", name: "אלפי טון", position: "bottom", splitLine: { show: false } }],
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 110, overflow: "truncate", fontSize: 11, interval: 0 } },
        series: [
          { type: "bar", name: "מפעלים", data: d.sites, xAxisIndex: 0, barMaxWidth: 16 },
          { type: "bar", name: "פחמן דו-חמצני (אלפי טון)", data: d.co2, xAxisIndex: 1, barMaxWidth: 16 }
        ]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    dual("chart-sector", {{ model.charts.sector | tojson }});
    dual("chart-district", {{ model.charts.district | tojson }});
  })();
</script>

