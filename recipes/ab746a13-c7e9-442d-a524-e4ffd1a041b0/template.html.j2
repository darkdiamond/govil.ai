<h1>תיקופי מסלקה בתחבורה ציבורית: נסיעות ברב-קו לפי יום, שעה, מפעיל וקו</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }} כל תיקוף הוא עלייה לאוטובוס, לרכבת או לרכבת הקלה עם כרטיס רב-קו או אמצעי תשלום אחר שנרשם במסלקה. אלה נתוני כמות הנוסעים בתחבורה הציבורית ברזולוציה של יום ושעה.</p>
  {%- if model.labels.partial_note %}
  <p class="mt-2 mb-0 text-sm text-subtle">{{ model.labels.partial_note }}</p>
  {%- endif %}
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.total_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.avg_weekday.tone }} mb-1" dir="ltr">{{ model.kpis.avg_weekday.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.avg_weekday_kpi }}</div>
  </div>
  {%- if model.flags.mom %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.mom.tone }} mb-1" dir="ltr">{{ model.kpis.mom.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.mom_kpi }}</div>
  </div>
  {%- endif %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.peak_hour.tone }} mb-1" dir="ltr">{{ model.kpis.peak_hour.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.peak_hour_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.rail_share.tone }} mb-1" dir="ltr">{{ model.kpis.rail_share.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.rail_share_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיקופים יומיים</h2>
  </div>
  <p class="mt-0 mb-3 text-sm text-subtle">{{ model.labels.daily_lede }}</p>
  <div id="chart-daily" class="h-72 md:h-96" role="img" data-fallback="explorer" aria-label="{{ model.labels.daily_aria }}"></div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיקופים לפי חודש</h2>
  </div>
  <p class="mt-0 mb-3 text-sm text-subtle">{{ model.labels.monthly_lede }}</p>
  <div id="chart-monthly" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.monthly_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.monthly_aria }}</caption>
      <thead><tr><th scope="col">חודש</th><th scope="col">סך תיקופים</th><th scope="col">חציון יום חול</th><th scope="col">ימים בנתונים</th></tr></thead>
      <tbody>
{%- for x in model.charts.monthly.x %}
        <tr><th scope="row">{{ x }}</th><td>{{ model.charts.monthly.total[loop.index0] | fmt_int }}</td><td>{{ model.charts.monthly.wkavg[loop.index0] | fmt_int }}</td><td>{{ model.charts.monthly.days[loop.index0] }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

{%- if model.flags.modes %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">אוטובוס, רכבת ורכבת קלה</h2>
  </div>
  <p class="mt-0 mb-3 text-sm text-subtle">{{ model.labels.mode_lede }}</p>
  <div id="chart-modes" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.mode_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.mode_aria }}</caption>
      <thead><tr><th scope="col">חודש</th>{% for n in model.charts.modes.names %}<th scope="col">{{ n }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for r in model.charts.modes.table %}
        <tr><th scope="row">{{ r.label }}</th>{% for v in r.vals %}<td>{{ v | fmt_int }} ({{ r.shares[loop.index0] | fmt_pct }})</td>{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{%- endif %}

