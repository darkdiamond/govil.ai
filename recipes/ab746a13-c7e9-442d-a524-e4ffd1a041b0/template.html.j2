<script>
  (function () {
    var h = {{ model.charts.heat | tojson }};
    var c = echarts.init(document.getElementById("chart-heat"));
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return "יום " + echarts.format.encodeHTML(h.days[p.value[1]]) + ", " + h.hours[p.value[0]] + "<br>" + p.value[2].toLocaleString("he-IL") + " תיקופים בממוצע";
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: h.hours, splitArea: { show: true }, axisLabel: { rotate: 45 } },
      yAxis: { type: "category", data: h.days, splitArea: { show: true }, inverse: true },
      visualMap: {
        min: 0, max: h.max, calculable: true, dimension: 2,
        orient: "horizontal", left: "center", bottom: 8,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells, label: { show: false },
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.operators | tojson }};
    var c = echarts.init(document.getElementById("chart-operators"));
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", formatter: function (ps) {
        var i = ps[0].dataIndex;
        return echarts.format.encodeHTML(d.names[i]) + "<br>" + d.vals[i].toLocaleString("he-IL") + " (" + (d.shares[i] * 100).toFixed(1) + "%)";
      } },
      grid: { left: 16, right: 24, top: 16, bottom: 32, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: function (v) { return (v / 1e6).toLocaleString("he-IL") + " מ׳"; } } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 120, overflow: "truncate" } },
      series: [{ type: "bar", name: "תיקופים", data: d.vals }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

