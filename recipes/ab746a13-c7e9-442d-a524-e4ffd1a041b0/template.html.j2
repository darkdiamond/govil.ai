        return echarts.format.encodeHTML(d.names[i]) + "<br>" + d.vals[i].toLocaleString("he-IL") + " (" + (d.shares[i] * 100).toFixed(1) + "%)";
      } },
      grid: { left: 16, right: 24, top: 16, bottom: 32, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: function (v) { return (v / 1e6).toLocaleString("he-IL") + " מ׳"; } } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 120, overflow: "truncate" } },
      series: [{ type: "bar", name: "תיקופים", data: d.vals }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

{%- if model.flags.lines %}
