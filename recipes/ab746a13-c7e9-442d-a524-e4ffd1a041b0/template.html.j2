{%- if model.flags.lines %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">קווי האוטובוס העמוסים ביותר</h2>
  </div>
  <p class="mt-0 mb-3 text-sm text-subtle">{{ model.labels.lines_lede }}</p>
  <div id="chart-lines" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.lines_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.lines_aria }}</caption>
      <thead><tr><th scope="col">קו</th><th scope="col">מפעיל</th><th scope="col">אשכול</th><th scope="col">תיקופים</th></tr></thead>
      <tbody>
{%- for x in model.charts.lines.line %}
        <tr><th scope="row">{{ x }}</th><td>{{ model.charts.lines.ops[loop.index0] }}</td><td>{{ model.charts.lines.cl[loop.index0] }}</td><td>{{ model.charts.lines.vals[loop.index0] | fmt_int }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{%- endif %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">על הנתונים</h2>
  </div>
  <p class="m-0 text-sm text-subtle">המאגר של משרד התחבורה מציג את כמות התיקופים שבוצעו בתחבורה הציבורית בכל אמצעי הכרטוס, לפי מפעיל, אשכול, קו, כיוון, שעה ויום בחודש. הקובץ מתעדכן אחת לחודש עם נתוני החודשים שעברו מתחילת השנה הנוכחית, ולכל שנה קובץ נפרד. הדף מציג את קובץ השנה העדכני. תיקוף אחד הוא עלייה אחת לכלי רכב, כך שנסיעה עם החלפה נספרת יותר מפעם אחת. ימי חול כאן הם ימים ראשון עד חמישי, כולל חגים שחלו בהם.</p>
</section>

<script>
  (function () {
    var d = {{ model.charts.daily | tojson }};
    var c = echarts.init(document.getElementById("chart-daily"));
    var weak = d.y.map(function (v, i) { return d.flag[i] ? v : null; });
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", formatter: function (ps) {
        var p = ps[0]; var i = p.dataIndex;
        return echarts.format.encodeHTML(d.x[i]) + "<br>" + d.y[i].toLocaleString("he-IL") + " תיקופים" + (d.flag[i] ? " (יום חול חלש)" : "");
      } },
      legend: { top: 0, data: ["תיקופים ביום", "יום חול מתחת לסף"] },
      grid: { left: 16, right: 24, top: 40, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: function (v) { return (v / 1e6).toLocaleString("he-IL") + " מיליון"; } } },
      dataZoom: [{ type: "inside", startValue: d.zoom_start }, { type: "slider", startValue: d.zoom_start, bottom: 16, height: 18 }],
      series: [
        { type: "line", name: "תיקופים ביום", data: d.y, showSymbol: false, lineStyle: { width: 1.5 } },
        { type: "scatter", name: "יום חול מתחת לסף", data: weak, symbolSize: 6, itemStyle: { color: "#dc3545" } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.monthly | tojson }};
    var c = echarts.init(document.getElementById("chart-monthly"));
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", valueFormatter: function (v) { return Number(v).toLocaleString("he-IL"); } },
      legend: { top: 0, data: ["סך תיקופים בחודש", "חציון יום חול"] },
      grid: { left: 16, right: 16, top: 40, bottom: 32, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { interval: 0, rotate: d.x.length > 6 ? 40 : 0 } },
      yAxis: [
        { type: "value", name: "חודש", axisLabel: { formatter: function (v) { return (v / 1e6).toLocaleString("he-IL") + " מ׳"; } } },
        { type: "value", name: "יום חול", axisLabel: { formatter: function (v) { return (v / 1e6).toLocaleString("he-IL") + " מ׳"; } } }
      ],
      series: [
        { type: "bar", name: "סך תיקופים בחודש", data: d.total },
        { type: "line", name: "חציון יום חול", yAxisIndex: 1, data: d.wkavg }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

{%- if model.flags.modes %}
<script>
  (function () {
    var d = {{ model.charts.modes | tojson }};
