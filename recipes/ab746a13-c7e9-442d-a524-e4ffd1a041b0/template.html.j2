      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 32, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { interval: 0, rotate: d.x.length > 6 ? 40 : 0 } },
      yAxis: { type: "value", axisLabel: { formatter: function (v) { return (v / 1e6).toLocaleString("he-IL") + " מ׳"; } } },
      series: d.series.map(function (s) { return { type: "bar", stack: "all", name: s.name, data: s.data }; })
    }));
