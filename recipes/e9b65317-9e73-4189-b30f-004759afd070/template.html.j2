      grid: { left: 8, right: 16, top: 40, bottom: 16, containLabel: true },
      xAxis: { type: "value", minInterval: 1 },
      yAxis: { type: "category", data: D.names.slice().reverse(), axisLabel: { width: 110, overflow: "truncate", fontSize: 11 } },
      series: series
    }));
  })();
</script>

<script>
