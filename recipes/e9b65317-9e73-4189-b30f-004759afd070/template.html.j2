<script>
  (function () {
    window.__nkMk = function (id) {
      var el = document.getElementById(id);
      if (!el) { return null; }
      var c = echarts.init(el);
      window.addEventListener("resize", function () { c.resize(); });
      return c;
    };
    window.__nkFmt = function (v) { return Number(v).toLocaleString("he-IL"); };
    window.__nkHbar = function (id, names, values, unit) {
      var c = window.__nkMk(id);
      if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return window.__nkFmt(v) + " " + unit; } },
        grid: { left: 8, right: 40, top: 8, bottom: 16, containLabel: true },
        xAxis: { type: "value", minInterval: 1, splitNumber: 4 },
        yAxis: { type: "category", data: names.slice().reverse(), axisLabel: { width: 140, overflow: "truncate", fontSize: 11 } },
        series: [{ type: "bar", name: unit, data: values.slice().reverse(), barMaxWidth: 22,
          label: { show: true, position: "right", fontSize: 11, formatter: function (p) { return window.__nkFmt(p.value); } } }]
      }));
    };
  })();
</script>

<script>
  (function () {
    var F = {{ model.charts.fields | tojson }};
    var c = window.__nkMk("chart-fields");
    if (!c) { return; }
    var series = F.kinds.map(function (k, i) {
      return { type: "bar", name: k, stack: "f", data: F.series[i].slice().reverse(), barMaxWidth: 28 };
    });
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0, type: "scroll" },
      grid: { left: 8, right: 16, top: 40, bottom: 16, containLabel: true },
      xAxis: { type: "value", minInterval: 1 },
      yAxis: { type: "category", data: F.cats.slice().reverse(), axisLabel: { width: 110, overflow: "truncate", fontSize: 11 } },
      series: series
    }));
  })();
</script>

<script>
  (function () {
    var L = {{ model.charts.lists | tojson }};
    window.__nkHbar("chart-lists", L.names, L.values, "ערכים");
  })();
</script>

<script>
  (function () {
    var U = {{ model.charts.usage | tojson }};
    var c = window.__nkMk("chart-usage");
    if (!c) { return; }
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        var i = U.names.length - 1 - p.dataIndex;
        return "קודים " + U.ranges[i] + ": " + window.__nkFmt(U.values[i]) + " שימושים<br>" +
          U.members[i].map(function (m) { return echarts.format.encodeHTML(m); }).join("<br>");
      } },
      grid: { left: 8, right: 40, top: 8, bottom: 16, containLabel: true },
      xAxis: { type: "value", minInterval: 1 },
      yAxis: { type: "category", data: U.names.slice().reverse(), axisLabel: { width: 140, overflow: "truncate", fontSize: 11 } },
      series: [{ type: "bar", name: "שימושים", data: U.values.slice().reverse(), barMaxWidth: 22,
        label: { show: true, position: "right", fontSize: 11 } }]
    }));
  })();
</script>

<script>
  (function () {
    var T = {{ model.charts.infra | tojson }};
    var c = window.__nkMk("chart-infra");
    if (!c) { return; }
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        var n = echarts.format.encodeHTML(p.name);
        if (p.data && p.data.children) { return n + ": " + window.__nkFmt(p.value) + " תת סוגים"; }
        return n;
      } },
      series: [{
        type: "treemap", name: "סוגי תשתיות", data: T, roam: false, nodeClick: false,
        breadcrumb: { show: false }, width: "100%", height: "100%", top: 0, left: 0,
        label: { show: true, fontSize: 11 },
        upperLabel: { show: true, height: 22, color: "#ffffff", fontWeight: "bold" },
        levels: [
          { itemStyle: { borderColor: "#ffffff", borderWidth: 2, gapWidth: 2 } },
          { colorSaturation: [0.35, 0.6], itemStyle: { borderColorSaturation: 0.7, gapWidth: 1, borderWidth: 1 } }
        ]
      }]
    }));
  })();
</script>

<script>
