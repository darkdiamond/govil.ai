{% import "gov.j2" as gov %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסמה {{ model.release.date }}</p>
{%- if model.release.headline %}
  <p class="m-0 mb-3 font-semibold text-ink-deep">{{ model.release.headline }}</p>
{%- endif %}
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["total", "yoy", "studies", "avg", "top_share"] %}
{%- if model.kpis[key] is defined %}
  {{ gov.kpi(model.kpis[key], model.labels[key ~ "_kpi"]) }}
{%- endif %}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

<section class="card p-5 mb-6">
  {{ gov.head("database", "ההוצאה למחקרים בתקציב נפרד לפי שנה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.total_note }}</p>
  {{ gov.chart("chart-total", model.labels.total_aria, "h-64 md:h-80") }}
  {{ gov.table("הוצאות ומספר מחקרים לפי שנה", ["שנה", "הוצאה (מיליון ש\"ח)", "מספר מחקרים", "הוצאה למחקר (אלפי ש\"ח)"], model.tables.total, ltr=(1, 2, 3)) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("list", "על מה הוצא הכסף: לפי סוג הוצאה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.types_note }}</p>
  {{ gov.chart("chart-types", model.labels.types_aria, "h-80 md:h-96") }}
  {{ gov.table("הוצאות לפי סוג הוצאה", ["סוג הוצאה", "מיליון ש\"ח", "אחוז מההוצאה"], model.tables.types, ltr=(1, 2)) }}
</section>

{%- if model.flags.types_years %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "סעיפי ההוצאה לאורך השנים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.types_years_note }}</p>
  {{ gov.chart("chart-types-years", model.labels.types_years_aria, "h-[460px]") }}
  {{ gov.table("הוצאות לפי סוג הוצאה ושנה (מיליון ש\"ח)", model.labels.types_years_cols, model.tables.types_years, ltr=range(1, model.labels.types_years_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.fields %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "מספר המחקרים לפי תחום מחקר") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.fields_note }}</p>
  {{ gov.chart("chart-fields", model.labels.fields_aria, "h-[520px]") }}
  {{ gov.table("מספר מחקרים לפי תחום מחקר", ["תחום מחקר", "מספר מחקרים", "אחוז מהמחקרים"], model.tables.fields, ltr=(1, 2)) }}
</section>
{%- endif %}

{%- if model.flags.fields and model.flags.fields_change %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "אילו תחומים גדלו ואילו קטנו") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.fields_change_note }}</p>
  {{ gov.chart("chart-fields-change", model.labels.fields_change_aria, "h-[520px]") }}
  {{ gov.table("שינוי במספר המחקרים לפי תחום", model.labels.fields_change_cols, model.tables.fields_change, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>הנתונים מתוך ההודעה השנתית לתקשורת של הלשכה המרכזית לסטטיסטיקה על מחקר ופיתוח באוניברסיטאות בישראל. כל הודעה מציגה שנה אחת, והעמוד מצרף את ההודעות של השנים האחרונות.</li>
    <li>מחקרים בעלי מימון מיוחד הם מחקרים שהמימון שלהם מגיע ממקורות ייעודיים, ומנוהל בתקציב נפרד מהתקציב הרגיל של האוניברסיטה.</li>
    <li>ההוצאה הממוצעת למחקר היא סך ההוצאה בשנה חלקי מספר המחקרים באותה שנה.</li>
    <li>הסכומים במחירים שוטפים, ללא התאמה לאינפלציה. סכום שנה שמופיע ביותר מהודעה אחת נלקח מההודעה החדשה ביותר.</li>
  </ul>
</section>

<script>
  (function () {
    const d = {{ model.charts.total | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-total"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Math.round(v).toLocaleString("he-IL") + " מיליון ש\"ח" },
      grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", min: 0, axisLabel: { formatter: (v) => v.toLocaleString("he-IL") } },
      series: [
        { type: "bar", name: "הוצאה (מיליון ש\"ח)", data: d.exp, barMaxWidth: 64,
          label: { show: true, position: "top", formatter: (p) => Math.round(p.value).toLocaleString("he-IL") } }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.types | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-types"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
        formatter: (ps) => { const i = ps[0].dataIndex; return echarts.format.encodeHTML(d.names[i]) + "<br>" + Math.round(d.values[i]).toLocaleString("he-IL") + " מיליון ש\"ח (" + d.shares[i].toFixed(1) + "%)"; } },
      grid: { left: 16, right: 56, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: false }, splitLine: { show: false } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 110, overflow: "break" } },
      series: [{ type: "bar", data: d.values,
        label: { show: true, position: "right", formatter: (p) => d.shares[p.dataIndex].toFixed(1) + "%" } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- if model.flags.types_years %}
  (function () {
    const d = {{ model.charts.types_years | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-types-years"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[6], pal[3], pal[0], pal[1], pal[8]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Math.round(v).toLocaleString("he-IL") + " מיליון ש\"ח" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: (v) => v.toLocaleString("he-IL") } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 110, overflow: "break" } },
      series: d.years.map((y, k) => ({ type: "bar", name: y, data: d.series[k] }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.fields %}
  (function () {
    const d = {{ model.charts.fields | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-fields"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[1]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v.toLocaleString("he-IL") + " מחקרים" },
      grid: { left: 16, right: 56, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: false }, splitLine: { show: false } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 130, overflow: "truncate" } },
      series: [{ type: "bar", data: d.values,
        label: { show: true, position: "right", formatter: (p) => p.value.toLocaleString("he-IL") } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.fields and model.flags.fields_change %}
  (function () {
    const d = {{ model.charts.fields_change | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-fields-change"));
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => (v > 0 ? "+" : "") + v.toLocaleString("he-IL") + " מחקרים" },
      grid: { left: 16, right: 40, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, min: (e) => e.min < 0 ? Math.floor(e.min * 2.4) : 0,
        max: (e) => e.max > 0 ? Math.ceil(e.max * 1.15) : 0, axisLabel: { formatter: (v) => Math.round(v).toLocaleString("he-IL") } },
      yAxis: { type: "category", data: d.names, axisLine: { onZero: false }, axisLabel: { width: 130, overflow: "truncate" } },
      series: [{ type: "bar",
        data: d.values.map((v) => ({ value: v, itemStyle: { color: v >= 0 ? pal[0] : "#dc3545" },
          label: { position: v >= 0 ? "right" : "left" } })),
        label: { show: true, color: "#0c3058", formatter: (p) => (p.value > 0 ? "+" : "") + p.value.toLocaleString("he-IL") } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
</script>
