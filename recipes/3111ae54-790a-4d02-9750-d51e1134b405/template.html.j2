<h1>רשם המשכונות: בדיקת משכונות ושעבודים רשומים</h1>

<style>
  .pl-table th, .pl-table td { padding: 0.35rem 0.5rem; text-align: start; vertical-align: top; }
  .pl-table tbody tr { border-top: 1px solid #c3cfe7; }
</style>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
  <p class="m-0 mt-2 text-sm text-subtle">במאגר, העמודה &quot;תאריך סיבת סטטוס&quot; מכילה בפועל את סיבת הסטטוס (למשל ביוזמת צד או תום תוקף). משכון שמשעבד כמה נכסים מופיע בשורה נפרדת לכל נכס, ולכן הספירות בעמוד הן של משכונות ייחודיים לפי מזהה המשכון, אלא אם צוין אחרת.</p>
{%- if model.flags.selection %}
  <p class="m-0 mt-2 text-sm text-ink">{{ model.labels.selection_note }}</p>
{%- endif %}
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">בדיקת משכון לפי מספר המשכון ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות פנקס המשכונות: מזהה משכון, תאריך רישום, סטטוס רישום, סיבת הסטטוס ותאריכו, ותאריכי צירוף והסרה של נכסים.</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
{%- for k in ["pledges", "rows", "active", "last_year", "median_life", "expired", "span"] %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[k].tone }} mb-1" dir="ltr">{{ model.kpis[k].display }}</div>
    <div class="text-sm text-subtle">{{ model.labels[k ~ "_kpi"] }}</div>
  </div>
{%- endfor %}
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מחיקת משכונות לפי שנה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.years_note }}</p>
  <div id="chart-years" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.years_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto relative">
      <table class="pl-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.years_aria }}</caption>
        <thead><tr><th scope="col">שנה</th><th scope="col">נמחקו או פקעו</th><th scope="col">משכונות במאגר שנרשמו בשנה זו</th></tr></thead>
        <tbody>
{%- for r in model.tables.years %}
          <tr><th scope="row" class="font-normal">{{ r.year }}</th><td>{{ r.canc }}</td><td>{{ r.reg }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">גלי מחיקה: מחיקות לפי חודש ושנה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.heat_note }}</p>
  <div id="chart-heat" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.heat_aria }}" data-fallback="explorer"></div>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <h2 class="m-0 mb-3 text-base font-semibold text-ink-deep">מחיקות לפי חודש בשנה</h2>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.month_note }}</p>
    <div id="chart-month" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.month_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto relative">
        <table class="pl-table mt-2 w-full text-sm">
          <caption class="sr-only">{{ model.labels.month_aria }}</caption>
          <thead><tr><th scope="col">חודש</th><th scope="col">מחיקות</th></tr></thead>
          <tbody>
  {%- for r in model.tables.month %}
            <tr><th scope="row" class="font-normal">{{ r.name }}</th><td>{{ r.n }}</td></tr>
  {%- endfor %}
          </tbody>
        </table>
      </div>
    </details>
  </section>
  <section class="card p-5">
    <h2 class="m-0 mb-3 text-base font-semibold text-ink-deep">מחיקות לפי יום בשבוע</h2>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.weekday_note }}</p>
    <div id="chart-weekday" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.weekday_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto relative">
        <table class="pl-table mt-2 w-full text-sm">
          <caption class="sr-only">{{ model.labels.weekday_aria }}</caption>
          <thead><tr><th scope="col">יום</th><th scope="col">מחיקות</th><th scope="col">שיעור</th></tr></thead>
          <tbody>
  {%- for r in model.tables.weekday %}
            <tr><th scope="row" class="font-normal">{{ r.name }}</th><td>{{ r.n }}</td><td>{{ r.share }}</td></tr>
  {%- endfor %}
          </tbody>
        </table>
      </div>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">למה נמחקים משכונות: סיבות הסטטוס</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.reasons_note }}</p>
  <div id="chart-reasons" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.reasons_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto relative">
      <table class="pl-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.reasons_aria }}</caption>
        <thead><tr><th scope="col">סיבה</th><th scope="col">משכונות</th><th scope="col">שיעור</th><th scope="col">משך חיים חציוני (שנים)</th></tr></thead>
        <tbody>
  {%- for r in model.tables.reasons %}
          <tr><th scope="row" class="font-normal">{{ r.name }}</th><td>{{ r.n }}</td><td>{{ r.share }}</td><td>{{ r.median }}</td></tr>
  {%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>

{%- if model.flags.mix %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תמהיל סיבות המחיקה לאורך השנים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.mix_note }}</p>
  <div id="chart-mix" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.mix_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto relative">
      <table class="pl-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.mix_aria }}</caption>
        <thead><tr><th scope="col">שנת מחיקה</th><th scope="col">מחיקות</th>
{%- for s in model.charts.mix.series %}<th scope="col">{{ s.name }}</th>{% endfor -%}
        </tr></thead>
        <tbody>
{%- for r in model.tables.mix %}
          <tr><th scope="row" class="font-normal">{{ r.year }}</th><td>{{ r.total }}</td>
{%- for v in r.shares %}<td>{{ v }}</td>{% endfor -%}
          </tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>
{%- endif %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">כמה זמן חי משכון: מהרישום ועד המחיקה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.life_note }}</p>
  <div id="chart-life" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.life_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto relative">
      <table class="pl-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.life_aria }}</caption>
        <thead><tr><th scope="col">משך חיים</th><th scope="col">משכונות שנמחקו</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
  {%- for r in model.tables.life %}
          <tr><th scope="row" class="font-normal">{{ r.name }}</th><td>{{ r.total }}</td><td>{{ r.share }}</td></tr>
  {%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>

{%- if model.flags.terms %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקופת הרישום של משכונות שפקעו בתום תוקף</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.terms_note }}</p>
  <div id="chart-terms" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.terms_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto relative">
      <table class="pl-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.terms_aria }}</caption>
        <thead><tr><th scope="col">תקופת רישום</th><th scope="col">משכונות שפקעו</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
  {%- for r in model.tables.terms %}
          <tr><th scope="row" class="font-normal">{{ r.name }}</th><td>{{ r.n }}</td><td>{{ r.share }}</td></tr>
  {%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>
{%- endif %}

{%- if model.flags.age %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">גיל המשכון ביום מחיקתו</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.age_note }}</p>
  <div id="chart-age" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.age_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto relative">
      <table class="pl-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.age_aria }}</caption>
        <thead><tr><th scope="col">שנת מחיקה</th><th scope="col">מחיקות</th><th scope="col">רבעון תחתון (שנים)</th><th scope="col">חציון (שנים)</th><th scope="col">רבעון עליון (שנים)</th></tr></thead>
        <tbody>
  {%- for r in model.tables.age %}
          <tr><th scope="row" class="font-normal">{{ r.year }}</th><td>{{ r.n }}</td><td>{{ r.p25 }}</td><td>{{ r.median }}</td><td>{{ r.p75 }}</td></tr>
  {%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>
{%- endif %}

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <h2 class="m-0 mb-3 text-base font-semibold text-ink-deep">כמה נכסים משועבדים בכל משכון</h2>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.assets_note }}</p>
    <div id="chart-assets" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.assets_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto relative">
        <table class="pl-table mt-2 w-full text-sm">
          <caption class="sr-only">{{ model.labels.assets_aria }}</caption>
          <thead><tr><th scope="col">נכסים במשכון</th><th scope="col">משכונות</th><th scope="col">שיעור</th><th scope="col">שורות</th></tr></thead>
          <tbody>
  {%- for r in model.tables.assets %}
            <tr><th scope="row" class="font-normal">{{ r.name }}</th><td>{{ r.n }}</td><td>{{ r.share }}</td><td>{{ r.rows }}</td></tr>
  {%- endfor %}
          </tbody>
        </table>
      </div>
    </details>
  </section>
{%- if model.flags.removed %}
  <section class="card p-5">
    <h2 class="m-0 mb-3 text-base font-semibold text-ink-deep">נכסים שהוסרו ממשכון לפי שנה</h2>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.removed_note }}</p>
    <div id="chart-removed" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.removed_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto relative">
        <table class="pl-table mt-2 w-full text-sm">
          <caption class="sr-only">{{ model.labels.removed_aria }}</caption>
          <thead><tr><th scope="col">שנה</th><th scope="col">נכסים שהוסרו</th></tr></thead>
          <tbody>
  {%- for r in model.tables.removed %}
            <tr><th scope="row" class="font-normal">{{ r.year }}</th><td>{{ r.n }}</td></tr>
  {%- endfor %}
          </tbody>
        </table>
      </div>
    </details>
  </section>
{%- endif %}
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">רשימת משכונות כמפורט במאגר רשם המשכונות, הרשימה כוללת משכונות פעילים ומשכונות שבוטלו בשנתיים האחרונות, ובכלל זה את הנתונים הבאים: תאריך רישום, תאריך סטטוס, תאריך צירוף הנכס למשכון, תאריך הסרת הנכס מהמשכון, וסיבת סטטוס.</p>
</section>

<script>
  (function () {
    var d = {{ model.charts.years | tojson }};
    var el = document.getElementById("chart-years");
    var c = echarts.init(el);
    var narrow = el.clientWidth < 500;
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", formatter: function (ps) {
        var out = echarts.format.encodeHTML(ps[0].name);
        ps.forEach(function (p) { out += "<br>" + p.marker + echarts.format.encodeHTML(p.seriesName) + ": " + Number(p.value).toLocaleString("he-IL"); });
        return out;
      } },
      legend: { bottom: 0 },
      grid: { left: 8, right: 16, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: narrow ? 60 : 45 } },
      yAxis: { type: "value", axisLabel: { formatter: function (v) { return v >= 1000 ? (v / 1000).toLocaleString("he-IL") + " אלף" : v; } } },
      dataZoom: narrow ? [{ type: "inside" }] : [],
      series: [
        { name: "נמחקו או פקעו", type: "bar", data: d.canc.map(function (v, i) {
          return (d.partial && i === d.canc.length - 1) ? { value: v, itemStyle: { opacity: 0.45 } } : v; }) },
        { name: "משכונות במאגר לפי שנת רישום", type: "line", data: d.reg, symbolSize: 5 }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.heat | tojson }};
    var el = document.getElementById("chart-heat");
    var c = echarts.init(el);
    var narrow = el.clientWidth < 500;
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return echarts.format.encodeHTML(d.months[p.value[0]] + " " + d.years[p.value[1]]) + "<br>" + p.value[2].toLocaleString("he-IL") + " מחיקות";
      } },
      grid: { left: 8, right: 16, top: 8, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.months, splitArea: { show: true }, axisLabel: { fontSize: narrow ? 9 : 12, interval: 0 } },
      yAxis: { type: "category", data: d.years, inverse: true, splitArea: { show: true }, axisLabel: { fontSize: narrow ? 9 : 11 } },
      visualMap: { min: 0, max: d.max, dimension: 2, calculable: true, orient: "horizontal", left: "center", bottom: 4,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] }, textStyle: { fontFamily: "Rubik", color: "#0c3058" } },
      series: [{ type: "heatmap", data: d.cells,
        emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.month | tojson }};
    var c = echarts.init(document.getElementById("chart-month"));
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 8, right: 16, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: 45, interval: 0 } },
      yAxis: { type: "value" },
      series: [{ name: "מחיקות", type: "bar", data: d.y }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.weekday | tojson }};
    var c = echarts.init(document.getElementById("chart-weekday"));
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 8, right: 16, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { interval: 0 } },
      yAxis: { type: "value" },
      series: [{ name: "מחיקות", type: "bar", data: d.y }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.reasons | tojson }};
    var el = document.getElementById("chart-reasons");
    var c = echarts.init(el);
    var narrow = el.clientWidth < 500;
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "item", formatter: function (p) {
        return echarts.format.encodeHTML(p.name) + "<br>" + p.value.toLocaleString("he-IL") + " משכונות (" + p.percent + "%)";
      } },
      legend: { bottom: 0 },
      series: [{ type: "pie", radius: narrow ? ["35%", "62%"] : ["40%", "68%"], center: ["50%", "45%"],
        data: d.data, label: { show: !narrow, formatter: "{b}: {d}%" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
{%- if model.flags.mix %}
  (function () {
    var d = {{ model.charts.mix | tojson }};
    var el = document.getElementById("chart-mix");
    var c = echarts.init(el);
    var narrow = el.clientWidth < 500;
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var out = echarts.format.encodeHTML(ps[0].name);
        ps.forEach(function (p) { out += "<br>" + p.marker + echarts.format.encodeHTML(p.seriesName) + ": " + Number(p.value).toFixed(1) + "%"; });
        return out;
      } },
      legend: { bottom: 0 },
      grid: { left: 8, right: 16, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: narrow ? 60 : 45 } },
      yAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      series: d.series.map(function (s) { return { name: s.name, type: "bar", stack: "all", data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
{%- endif %}
  (function () {
    var d = {{ model.charts.life | tojson }};
    var el = document.getElementById("chart-life");
    var c = echarts.init(el);
    var narrow = el.clientWidth < 500;
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var tot = 0, out = "";
        ps.forEach(function (p) { tot += p.value; out += "<br>" + p.marker + echarts.format.encodeHTML(p.seriesName) + ": " + p.value.toLocaleString("he-IL"); });
        return echarts.format.encodeHTML(ps[0].name) + "<br>סה״כ " + tot.toLocaleString("he-IL") + out;
      } },
      legend: { bottom: 0 },
      grid: { left: 8, right: 16, top: 16, bottom: 40, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: !narrow } },
      yAxis: { type: "category", data: d.x, inverse: true, axisLabel: { width: narrow ? 90 : 140, overflow: "truncate", ellipsis: "…" } },
      series: d.series.map(function (s) { return { name: s.name, type: "bar", stack: "all", data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
{%- if model.flags.terms %}
  (function () {
    var d = {{ model.charts.terms | tojson }};
    var el = document.getElementById("chart-terms");
    var c = echarts.init(el);
    var narrow = el.clientWidth < 500;
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 8, right: 16, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { interval: 0, rotate: narrow ? 60 : 30 } },
      yAxis: { type: "value" },
      series: [{ name: "משכונות שפקעו", type: "bar", data: d.y }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
{%- endif %}
{%- if model.flags.age %}
  (function () {
    var d = {{ model.charts.age | tojson }};
    var el = document.getElementById("chart-age");
    var c = echarts.init(el);
    var narrow = el.clientWidth < 500;
    var band = d.p75.map(function (v, i) { return Math.round((v - d.p25[i]) * 100) / 100; });
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", formatter: function (ps) {
        var i = ps[0].dataIndex;
        return echarts.format.encodeHTML(ps[0].name) + "<br>חציון: " + d.median[i].toFixed(1) + " שנים<br>רבעונים: "
          + d.p25[i].toFixed(1) + " עד " + d.p75[i].toFixed(1) + " שנים<br>" + d.n[i].toLocaleString("he-IL") + " מחיקות";
      } },
      legend: { bottom: 0, data: ["חציון", "טווח בין הרבעונים"] },
      grid: { left: 8, right: 16, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: narrow ? 60 : 45 } },
      yAxis: { type: "value", name: "שנים", min: 0 },
      series: [
        { name: "בסיס", type: "line", data: d.p25, stack: "band", lineStyle: { opacity: 0 }, symbol: "none", silent: true },
        { name: "טווח בין הרבעונים", type: "line", data: band, stack: "band", lineStyle: { opacity: 0 }, symbol: "none",
          areaStyle: { color: "rgba(0,104,245,0.15)" }, silent: true },
        { name: "חציון", type: "line", data: d.median, symbolSize: 5 }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
{%- endif %}
  (function () {
    var d = {{ model.charts.assets | tojson }};
    var el = document.getElementById("chart-assets");
    var c = echarts.init(el);
    var narrow = el.clientWidth < 500;
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 8, right: 16, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { interval: 0, rotate: narrow ? 45 : 30 } },
      yAxis: { type: "log", min: 1, axisLabel: { formatter: function (v) { return v >= 1000 ? (v / 1000).toLocaleString("he-IL") + " אלף" : v; } } },
      series: [{ name: "משכונות", type: "bar", data: d.y }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
{%- if model.flags.removed %}
  (function () {
    var d = {{ model.charts.removed | tojson }};
    var el = document.getElementById("chart-removed");
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 8, right: 16, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value" },
      series: [{ name: "נכסים שהוסרו", type: "bar", data: d.y }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
{%- endif %}
</script>
