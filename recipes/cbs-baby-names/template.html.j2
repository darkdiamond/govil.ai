      chart.setOption(window.GovEcharts.option({
        color: [pal[0], pal[2], pal[4], pal[6], pal[8]],
        tooltip: { trigger: "axis", valueFormatter: function (v) { return window.__bnFmt(v); } },
        legend: { top: 0 },
        grid: { left: 16, right: 24, top: 48, bottom: 56, containLabel: true },
        xAxis: { type: "category", data: g.years },
        yAxis: { type: "value" },
        dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 20 }],
