      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return window.__bnFmt(v); } },
      legend: { top: 0 },
      grid: { left: 16, right: 24, top: 40, bottom: 8, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [
        { type: "bar", stack: "s", name: "בנות", data: d.girls },
        { type: "bar", stack: "s", name: "בנים", data: d.boys }
      ]
    }));
    window.addEventListener("resize", function () { chart.resize(); });
  })();
</script>
{%- endif %}
{%- if model.flags.trend %}

<script>
  (function () {
    const d = {{ model.charts.trend | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-trend"));
    window.__bnSwitch("sw-trend", function (i) {
