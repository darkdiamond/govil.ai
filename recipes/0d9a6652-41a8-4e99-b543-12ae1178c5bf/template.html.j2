<script>
  (function () {
    var d = {{ model.charts.place | tojson }};
    var el = document.getElementById("chart-place");
    function legendRows(el, names) {
      var avail = Math.max(120, el.clientWidth - 32), row = 0, rows = 1;
      names.forEach(function (n) {
        var w = String(n).length * 7 + 34;
        if (row + w > avail && row > 0) { rows += 1; row = 0; }
        row += w;
      });
      return rows;
    }
    function layout() {
      var rows = legendRows(el, d.names), h = el.clientHeight || 256;
      var legendH = rows * 22 + 8, ch = Math.max(80, h - legendH);
      return { cy: Math.round(ch / 2), r: Math.round(Math.min(ch, el.clientWidth) / 2 - 8) };
    }
    var c = echarts.init(el);
    var lay = layout();
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        return echarts.format.encodeHTML(p.name) + "<br/>" + p.value.toLocaleString("he-IL") + " תיקים (" + p.percent + "%)";
      } },
      legend: { bottom: 0, itemGap: 8 },
      series: [{ type: "pie", radius: [Math.round(lay.r * 0.58), lay.r], center: ["50%", lay.cy], label: { show: false },
                 data: d.names.map(function (n, i) { return { name: n, value: d.values[i] }; }) }]
    }));
    window.addEventListener("resize", function () {
      c.resize();
      var l = layout();
      c.setOption({ series: [{ radius: [Math.round(l.r * 0.58), l.r], center: ["50%", l.cy] }] });
    });
  })();
</script>

