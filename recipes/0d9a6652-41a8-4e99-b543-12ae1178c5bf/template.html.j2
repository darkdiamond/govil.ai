  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.quarterly_lede }} {{ model.labels.dropped }}</p>
  <div id="chart-quarterly" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.quarterly_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
