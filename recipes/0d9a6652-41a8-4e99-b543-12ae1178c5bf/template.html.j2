<script>
  (function () {
    function hbar(id, d, unit, curName, prevName) {
      var el = document.getElementById(id);
      if (!el) { return; }
      var c = echarts.init(el);
      var series = [{ type: "bar", name: curName, data: d.cur }];
      if (d.prev && d.prev.length) { series.push({ type: "bar", name: prevName, data: d.prev }); }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
          var i = ps[0].dataIndex;
          var s = echarts.format.encodeHTML(d.names[i]);
          ps.forEach(function (p) { s += "<br/>" + p.seriesName + ": " + p.value.toLocaleString("he-IL") + " " + unit; });
          return s;
        } },
        legend: { top: 0 },
        grid: { left: 16, right: 24, top: 32, bottom: 16, containLabel: true },
        xAxis: { type: "value", splitNumber: el.clientWidth < 560 ? 3 : 5,
                 axisLabel: { hideOverlap: true, formatter: function (v) {
                   return (el.clientWidth < 560 && v >= 1000) ? (v / 1000) + "K" : v.toLocaleString("he-IL"); } } },
        yAxis: { type: "category", data: d.names, inverse: true,
                 axisLabel: { interval: 0, fontSize: 11, width: Math.min(200, el.clientWidth * 0.45), overflow: "truncate" } },
        series: series
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    var L = {{ model.meta.L | tojson }};
    var P = {{ model.meta.P | tojson }};
    hbar("chart-groups", {{ model.charts.groups | tojson }}, "עבירות", String(L), String(P));
    hbar("chart-types", {{ model.charts.types | tojson }}, "עבירות", String(L), String(P));
    hbar("chart-stations", {{ model.charts.stations | tojson }}, "תיקים", String(L), String(P));
    hbar("chart-cities", {{ model.charts.cities | tojson }}, "תיקים", String(L), String(P));
    hbar("chart-councils", { names: {{ model.charts.councils.names | tojson }}, cur: {{ model.charts.councils["values"] | tojson }}, prev: [] }, "תיקים", String(L), "");
  })();
</script>

