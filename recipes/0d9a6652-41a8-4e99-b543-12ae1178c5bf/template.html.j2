      <thead><tr><th scope="col">רבעון</th><th scope="col">תיקים</th><th scope="col">עבירות</th><th scope="col">הערה</th></tr></thead>
      <tbody>
{%- for r in model.tables.quarterly %}
        <tr><th scope="row">{{ r.label }}</th><td>{{ r.cases }}</td><td>{{ r.off }}</td><td>{{ r.note }}</td></tr>
{%- endfor %}
