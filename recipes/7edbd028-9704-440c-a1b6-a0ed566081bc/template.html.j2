    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.streets_caption }}</caption>
      <thead><tr><th scope="col">רחוב</th><th scope="col">עמודים</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.streets %}
