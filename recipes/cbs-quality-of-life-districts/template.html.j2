{% import "gov.j2" as gov %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }}{% if model.release.date %} · פורסמה {{ model.release.date }}{% endif %}</p>
{%- if model.release.headline %}
  <p class="m-0 mb-3 text-ink-deep">{{ model.release.headline }}</p>
{%- endif %}
  <p class="m-0 text-sm flex flex-wrap gap-4">
{%- if model.release.url %}
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- endif %}
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לפרסום המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- if model.kpis.indicators is defined %}
  {{ gov.kpi(model.kpis.indicators, "מדדי איכות חיים בהשוואה (" ~ model.labels.year ~ ")") }}
  {{ gov.kpi(model.kpis.districts, "מחוזות") }}
  {{ gov.kpi(model.kpis.lead_share, "מהמדדים שבהם " ~ model.labels.lead ~ " טוב מהממוצע הארצי") }}
  {{ gov.kpi(model.kpis.last_below, "מהמדדים שבהם " ~ model.labels.last ~ " פחות טוב מהממוצע הארצי") }}
{%- endif %}
{%- if model.kpis.tables is defined %}
  {{ gov.kpi(model.kpis.tables, "לוחות לפי מחוז בהודעה האחרונה") }}
{%- endif %}
</div>

{{ gov.insights(model.insights) }}

{%- if model.flags.get("profiles") %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "מאזן המדדים בכל מחוז") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.score_note }}</p>
  {{ gov.chart("chart-score", model.labels.score_aria, "h-72 md:h-80") }}
  {{ gov.table("מספר המדדים שבהם כל מחוז טוב, קרוב או פחות טוב מהממוצע הארצי", ["מחוז", "טוב מהממוצע", "קרוב לממוצע", "פחות טוב מהממוצע", "שיעור הטובים מהממוצע"], model.tables.score, ltr=(1, 2, 3, 4)) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("database", "מפת המדדים: כל המחוזות מול הממוצע הארצי") }}
  <p class="m-0 text-sm text-subtle mb-3">כל תא הוא מדד יחסי: ערך המחוז ביחס לממוצע הארצי, שהוא 100. הלמ"ס מכוונת את כל המדדים כך שערך מעל 100 (ירוק) מציין מצב טוב מהממוצע וערך מתחת ל-100 (אדום) מצב פחות טוב, גם במדדים שבהם מספר נמוך הוא הרצוי, כמו אבטלה ממושכת או מקרי רצח. {{ model.labels.n_ind }} מדדים, {{ model.labels.year }}.</p>
  <div id="chart-heat" class="w-full h-[{{ model.charts.heat.height }}px]" role="img" aria-label="{{ model.labels.heat_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">מדד יחסי לכל מדד ומחוז (ממוצע ארצי = 100)</caption>
        <thead><tr>{% for c in model.labels.heat_cols %}<th scope="col">{{ c }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in model.tables.heat %}
          <tr>{% for v in r %}{% if loop.first %}<th scope="row">{{ v }}</th>{% else %}<td dir="ltr">{{ v }}</td>{% endif %}{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>

<section class="card p-5 mb-6">
  {{ gov.head("list", "איפה הפערים בין המחוזות הכי גדולים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.gap_top }} המדדים שבהם המרחק בין המחוז הטוב ביותר (ירוק) לפחות טוב (אדום) הוא הגדול ביותר, במדד יחסי (ממוצע ארצי = 100, הקו המקווקו). הפער מחושב כיחס בין שני הערכים.</p>
  {{ gov.chart("chart-gaps", model.labels.gaps_aria, "h-80 md:h-[460px]") }}
  {{ gov.table("המדדים עם הפער הגדול ביותר בין המחוזות", ["מדד", "המחוז הטוב ביותר", "המחוז הפחות טוב", "יחס ביניהם"], model.tables.gaps, ltr=(3,)) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("circle-check", "החוזקות והחולשות של כל מחוז") }}
  <p class="m-0 text-sm text-subtle mb-3">בכל מחוז, המדדים שבהם הוא רחוק ביותר מעל הממוצע הארצי ומתחתיו (מדד יחסי בסוגריים, ממוצע ארצי = 100).</p>
  <div class="grid gap-4" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));">
{%- for c in model.charts.cards %}
    <div class="border border-rule rounded-gov p-4">
      <h3 class="m-0 mb-1 text-base font-semibold text-ink-deep">{{ c.name }}</h3>
      <p class="m-0 mb-2 text-xs text-subtle">טוב מהממוצע ב-{{ c.above }} מדדים, פחות טוב ממנו ב-{{ c.below }}, מתוך {{ c.n }}</p>
{%- if c.best %}
      <p class="m-0 text-sm font-semibold text-ok">מעל הממוצע</p>
      <ul class="list-disc ps-5 m-0 mb-2 text-sm">
{%- for b in c.best %}
        <li>{{ b.label }} ({{ b.v }})</li>
{%- endfor %}
      </ul>
{%- endif %}
{%- if c.worst %}
      <p class="m-0 text-sm font-semibold text-danger">מתחת לממוצע</p>
      <ul class="list-disc ps-5 m-0 text-sm">
{%- for b in c.worst %}
        <li>{{ b.label }} ({{ b.v }})</li>
{%- endfor %}
      </ul>
{%- endif %}
    </div>
{%- endfor %}
  </div>
</section>
{%- endif %}

{%- for h in model.charts.heads %}
<section class="card p-5 mb-6">
  {{ gov.head("database", h.title ~ (" (" ~ h.year ~ ")" if h.year else "")) }}
  <p class="m-0 text-sm text-subtle mb-3">{% if h.note %}{{ h.note }} {% endif %}הערכים כפי שפורסמו בלוח של הלמ"ס לפי מחוז.</p>
  {{ gov.chart(h.id, h.aria, h.h) }}
  {{ gov.table(h.title ~ " לפי מחוז", h.cols, h.rows, ltr=range(1, h.cols | length) | list) }}
</section>
{%- endfor %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>הנתונים מתוך ההודעה השנתית לתקשורת "מדדי איכות חיים במחוזות" של הלשכה המרכזית לסטטיסטיקה (הלמ"ס). כל הודעה מציגה שנה אחת, והעמוד מתעדכן עם פרסום ההודעה הבאה.</li>
    <li>בלוחות המחוזיים כל מדד מוצג כיחס בין ערך המחוז לממוצע הארצי. במדדים שבהם ערך נמוך הוא הרצוי (כמו אבטלה, תמותה או עלות דיור) היחס הפוך, כך שבכל המדדים ערך מעל 100 מציין מצב טוב מהממוצע.</li>
{%- if model.flags.get("profiles") %}
    <li>מדד נחשב "טוב מהממוצע" או "פחות טוב מהממוצע" כשהוא רחוק ממנו ביותר מ-{{ model.labels.tol }}. הסף הזה הוא כלל של העמוד ולא של הלמ"ס. מדד שהלמ"ס לא פרסמה למחוז מסוים מופיע כתא ריק ואינו נספר.</li>
{%- endif %}
    <li>מדדים מסקרים (שביעות רצון, אמון, תחושות) מבוססים על מדגם, ולהפרשים קטנים בין מחוזות עשויה להיות טעות דגימה. נושאי הלוחות עם הערכים המוחלטים משתנים משנה לשנה.</li>
  </ul>
</section>

<script>
  (function () {
    const pal = window.GOVIL_PALETTE;
    const enc = (s) => echarts.format.encodeHTML(String(s));
    function el(id) { return document.getElementById(id); }
    function mount(id, option) {
      const node = el(id);
      if (!node) return;
      const chart = echarts.init(node);
      chart.setOption(window.GovEcharts.option(option));
      window.addEventListener("resize", () => chart.resize());
    }
{%- if model.flags.get("profiles") %}
    const score = {{ model.charts.score | tojson }};
    mount("chart-score", {
      color: ["#198754", "#c3cfe7", "#dc3545"],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0 },
      grid: { left: 16, right: 24, top: 40, bottom: 16, containLabel: true },
      xAxis: { type: "value", splitNumber: 4, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", inverse: true, data: score.x, axisLabel: { width: 100, overflow: "truncate" } },
      series: [
        { type: "bar", stack: "s", name: "טוב מהממוצע", data: score.above, barMaxWidth: 28 },
        { type: "bar", stack: "s", name: "קרוב לממוצע", data: score.near, barMaxWidth: 28 },
        { type: "bar", stack: "s", name: "פחות טוב מהממוצע", data: score.below, barMaxWidth: 28 }
      ]
    });

    const heat = {{ model.charts.heat | tojson }};
    const narrow = (el("chart-heat") || { clientWidth: 800 }).clientWidth < 520;
    mount("chart-heat", {
      tooltip: {
        position: "top",
        formatter: (p) => enc(heat.y[p.data[1]]) + "<br>" + enc(heat.x[p.data[0]]) + ": " + p.data[2] + " (ממוצע ארצי = 100)"
      },
      grid: { left: 8, right: 8, top: narrow ? 84 : 56, bottom: 48, containLabel: true },
      xAxis: { type: "category", position: "top", data: heat.x, splitArea: { show: true },
               axisLabel: { interval: 0, fontSize: narrow ? 10 : 12, rotate: narrow ? 60 : 0, width: 90, overflow: "truncate" } },
      yAxis: { type: "category", inverse: true, data: heat.y, splitArea: { show: true },
               axisLabel: { interval: 0, fontSize: narrow ? 10 : 12, width: narrow ? 110 : 220, overflow: "truncate" } },
      visualMap: { type: "continuous", min: 50, max: 150, dimension: 2, calculable: false, orient: "horizontal",
                   left: "center", bottom: 0, itemWidth: 12, itemHeight: narrow ? 160 : 240, text: ["150", "50"],
                   inRange: { color: ["#dc3545", "#f5c2c7", "#f1f7ff", "#a3cfbb", "#198754"] } },
      series: [{ type: "heatmap", data: heat.data,
                 label: { show: true, fontSize: narrow ? 9 : 11, color: "#0c3058" },
                 itemStyle: { borderColor: "#ffffff", borderWidth: 1 } }]
    });

    const gaps = {{ model.charts.gaps | tojson }};
    mount("chart-gaps", {
      color: ["#c3cfe7", "#dc3545", "#198754"],
      tooltip: {
        trigger: "axis", axisPointer: { type: "shadow" },
        formatter: (ps) => {
          const i = ps[0].dataIndex;
          return enc(gaps.y[i]) + "<br>" + enc(gaps.hi_d[i]) + ": " + gaps.hi[i] + "<br>" + enc(gaps.lo_d[i]) + ": " + gaps.lo[i];
        }
      },
      legend: { top: 0, data: ["המחוז הפחות טוב", "המחוז הטוב ביותר"] },
      grid: { left: 16, right: 24, top: 40, bottom: 16, containLabel: true },
      xAxis: { type: "value", splitNumber: 4, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", inverse: true, data: gaps.y, axisLabel: { width: 120, overflow: "truncate" } },
      series: [
        { type: "bar", stack: "g", silent: true, itemStyle: { color: "transparent" }, data: gaps.lo, barWidth: 6 },
        { type: "bar", stack: "g", silent: true, itemStyle: { color: "#c3cfe7" }, barWidth: 6,
          data: gaps.hi.map((v, i) => v - gaps.lo[i]),
          markLine: { silent: true, symbol: "none", lineStyle: { color: "#6c757d", type: "dashed" },
                      label: { show: false }, data: [{ xAxis: 100 }] } },
        { type: "scatter", name: "המחוז הפחות טוב", data: gaps.lo, symbolSize: 11, itemStyle: { color: "#dc3545" } },
        { type: "scatter", name: "המחוז הטוב ביותר", data: gaps.hi, symbolSize: 11, itemStyle: { color: "#198754" } }
      ]
    });
{%- endif %}

    const heads = {{ model.charts.heads | tojson }};
    heads.forEach((h) => {
      const fmtv = (v) => v == null ? "לא פורסם" : v.toFixed(h.dec);
      const series = h.series.map((s, k) => {
        const out = { type: "bar", name: s.name, data: s.data, barMaxWidth: h.single ? 24 : 16 };
        if (h.single) {
          out.itemStyle = { color: pal[0] };
          if (h.avg != null) {
            out.markLine = { silent: true, symbol: "none", lineStyle: { color: "#6c757d", type: "dashed" },
                             label: { formatter: "ממוצע ארצי " + fmtv(h.avg) }, data: [{ xAxis: h.avg }] };
          }
        }
        return out;
      });
      mount(h.id, {
        color: [pal[0], pal[1], pal[2], pal[3], pal[4]],
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: fmtv },
        legend: h.single ? { show: false } : { top: 0 },
        grid: { left: 16, right: 32, top: h.single ? 24 : 64, bottom: 16, containLabel: true },
        xAxis: { type: "value", splitNumber: 4, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", inverse: true, data: h.x, axisLabel: { width: 100, overflow: "truncate" } },
        series: series
      });
    });
  })();
</script>
