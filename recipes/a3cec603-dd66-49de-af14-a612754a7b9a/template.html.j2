</section>

<script>
  GovMap.create({
    container: "#map-main",
    resourceId: {{ inputs.main[0].id | tojson }},
    latField: "Y",
    lngField: "X",
    projection: "itm",
    popupTitleField: "municipality_name",
    popupFields: [
      { field: "building_street", label: "רחוב" },
      { field: "main_use_name", label: "שימוש עיקרי" },
      { field: "certification_status", label: "שלב התעדה" },
      { field: "floors_above_ground", label: "קומות" },
      { field: "certificate_stars_b", label: "כוכבים בשלב ב" }
    ]
  });
</script>

<script>
  (function () {
    var s = {{ model.charts.stages | tojson }};
    var c1 = echarts.init(document.getElementById("chart-stages"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 40, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: s.names, inverse: true },
      series: [{ type: "bar", name: "רשומות", label: { show: true, position: "right", fontFamily: "Rubik" },
                 data: s.values.map(function (v, i) { return { value: v, itemStyle: { color: s.colors[i] } }; }) }]
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    var y = {{ model.charts.years | tojson }};
    var c2 = echarts.init(document.getElementById("chart-years"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 40, right: 16, top: 24, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: y.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value", name: "תעודות" },
      series: y.series.map(function (x) { return { type: "bar", name: x.name, data: x.data }; })
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    function mix(id, d) {
      var c = echarts.init(document.getElementById(id));
      var series = d.levels.map(function (lv, i) {
        return { type: "bar", stack: "s", name: lv, itemStyle: { color: d.colors[i] },
                 data: d.rows.map(function (r) { return r.data[i]; }) };
      });
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                   valueFormatter: function (v) { return v + "%"; } },
        legend: { type: "scroll", bottom: 0 },
        grid: { left: 16, right: 16, top: 16, bottom: 48, containLabel: true },
        xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
        yAxis: { type: "category", data: d.rows.map(function (r) { return r.name; }), inverse: true },
        series: series
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    mix("chart-stars", {{ model.charts.stars | tojson }});
    mix("chart-energy", {{ model.charts.energy | tojson }});

    var sc = {{ model.charts.scores | tojson }};
    var c3 = echarts.init(document.getElementById("chart-scores"));
    c3.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 40, right: 16, top: 24, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: sc.x, name: "ציון", axisLabel: { rotate: 45 } },
      yAxis: { type: "value", name: "% מהתעודות" },
      series: sc.series.map(function (x) { return { type: "line", name: x.name, data: x.data }; })
    }));
    window.addEventListener("resize", function () { c3.resize(); });
  })();
</script>

<script>
  (function () {
    function heat(id, h, xName, yName) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        tooltip: { position: "top", formatter: function (p) {
          return yName + ": " + h.y[p.value[1]] + " · " + xName + ": " + h.x[p.value[0]] +
                 " — " + p.value[2].toLocaleString("he-IL");
        } },
        grid: { left: 16, right: 16, top: 32, bottom: 72, containLabel: true },
        xAxis: { type: "category", data: h.x, name: xName, nameLocation: "middle", nameGap: 28,
                 position: "top", axisLabel: { interval: 0 }, splitArea: { show: true } },
        yAxis: { type: "category", data: h.y, inverse: true, axisLabel: { interval: 0 }, splitArea: { show: true } },
        visualMap: {
          min: 0, max: h.max, calculable: true, dimension: 2,
          orient: "horizontal", left: "center", bottom: 8,
          inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
          textStyle: { fontFamily: "Rubik", color: "#0c3058" }
        },
        series: [{ type: "heatmap", data: h.cells, label: { show: true, fontFamily: "Rubik" },
                   emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    heat("chart-etrans", {{ model.charts.etrans | tojson }}, "דירוג בשלב ב", "דירוג מקדמי");
    heat("chart-strans", {{ model.charts.strans | tojson }}, "כוכבים בשלב ב", "כוכבים מקדמי");
  })();
</script>

<script>
  (function () {
    var l = {{ model.charts.lag | tojson }};
    var c1 = echarts.init(document.getElementById("chart-lag"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 40, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: l.names, axisLabel: { interval: 0, rotate: 30, fontSize: 11 } },
      yAxis: { type: "value", name: "מבנים" },
      series: [{ type: "bar", name: "מבנים", data: l.values }]
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    var f = {{ model.charts.floors | tojson }};
    var c2 = echarts.init(document.getElementById("chart-floors"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 40, right: 16, top: 24, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: f.names, axisLabel: { interval: 0, fontSize: 11 } },
      yAxis: { type: "value", name: "רשומות" },
      series: f.series.map(function (x) { return { type: "bar", stack: "f", name: x.name, data: x.data }; })
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    function stacked(id, d, share) {
      var c = echarts.init(document.getElementById(id));
      var xAxis = share ? { type: "value", max: 100, axisLabel: { formatter: "{value}%" } } : { type: "value" };
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                   valueFormatter: function (v) { return share ? v + "%" : v.toLocaleString("he-IL"); } },
        legend: { type: "scroll", bottom: 0 },
        grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
        xAxis: xAxis,
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { interval: 0 } },
        series: d.series.map(function (x) {
          return { type: "bar", stack: "m", name: x.name, data: x.data, itemStyle: { color: x.color } };
        })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    stacked("chart-munis", {{ model.charts.munis | tojson }}, false);
    stacked("chart-uses", {{ model.charts.uses | tojson }}, true);

    var u = {{ model.charts.units | tojson }};
    var c = echarts.init(document.getElementById("chart-units"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 3 },
      yAxis: { type: "category", data: u.names, inverse: true, axisLabel: { interval: 0 } },
      series: [{ type: "bar", name: "יחידות דיור", data: u.values }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
