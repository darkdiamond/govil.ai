<h1>תלונות חופש המידע</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-brand mb-1">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">תלונות במאגר</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-brand mb-1">{{ model.kpis.last_full.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.last_full_label }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-brand mb-1">{{ model.kpis.justified.display }}</div>
    <div class="text-sm text-subtle">מההכרעות: התלונה מוצדקת</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-brand mb-1">{{ model.kpis.median_days.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.median_label }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

{% macro simple_table(rows, aria, head) -%}
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ aria }}</caption>
      <thead><tr><th scope="col">{{ head }}</th><th scope="col">תלונות</th><th scope="col">שיעור (%)</th></tr></thead>
      <tbody>
{%- for r in rows %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.n }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
{%- endmacro %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תלונות לאורך זמן</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.volume_note }}</p>
  <div id="chart-volume" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.volume_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה (לפי שנה)</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.volume_aria }}</caption>
      <thead><tr><th scope="col">שנה</th><th scope="col">תלונות</th></tr></thead>
      <tbody>
{%- for r in model.tables.years %}
        <tr><th scope="row">{{ r.year }}</th><td>{{ r.n }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

