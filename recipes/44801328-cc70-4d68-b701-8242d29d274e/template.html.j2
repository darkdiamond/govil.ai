    <div id="chart-handling" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.handling_aria }}"></div>
    {{ simple_table(model.tables.handling, model.labels.handling_aria, "משך") }}
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
