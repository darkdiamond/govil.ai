<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">כמה זמן מחכים לפני שמתלוננים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.wait_note }}</p>
  <div id="chart-wait" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.wait_aria }}"></div>
  {{ simple_table(model.tables.wait, model.labels.wait_aria, "המתנה") }}
</section>

<script>
  (function () {
    function hbar(id, d, name, unit) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", valueFormatter: function (v) { return v + (unit || ""); } },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value" },
        yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 140, overflow: "truncate" } },
        series: [{ type: "bar", name: name, data: d.values.slice().reverse() }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    function vbar(id, d, name) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis" },
        grid: { left: 40, right: 16, top: 24, bottom: 48, containLabel: true },
        xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, rotate: 25 } },
        yAxis: { type: "value" },
        series: [{ type: "bar", name: name, data: d.values }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    var v = {{ model.charts.volume | tojson }};
    var c1 = echarts.init(document.getElementById("chart-volume"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 40, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: v.x },
      yAxis: { type: "value" },
      series: [{ type: "bar", name: "תלונות", data: v.y }]
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    hbar("chart-bodies", {{ model.charts.bodies | tojson }}, "תלונות");
    hbar("chart-just-body", {{ model.charts.just_body | tojson }}, "מוצדקות", "%");
    hbar("chart-topics", {{ model.charts.topics | tojson }}, "תלונות");
    vbar("chart-ctype", {{ model.charts.ctype | tojson }}, "תלונות");
    hbar("chart-orgs", {{ model.charts.orgs | tojson }}, "תלונות");
    vbar("chart-handling", {{ model.charts.handling | tojson }}, "תלונות");
    vbar("chart-wait", {{ model.charts.wait | tojson }}, "תלונות");
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.decisions | tojson }};
    var c = echarts.init(document.getElementById("chart-decisions"));
    c.setOption(window.GovEcharts.option({
      color: ["#0068f5", "#9fc3f7", "#6c757d", "#c3cfe7", "#e9ecef"],
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      legend: { type: "scroll", bottom: 0 },
      grid: { left: 40, right: 16, top: 24, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", max: 100, name: "%" },
      series: d.series.map(function (s) { return { type: "bar", stack: "d", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var h = {{ model.charts.handling_year | tojson }};
    var c2 = echarts.init(document.getElementById("chart-handling-year"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + " ימים"; } },
      grid: { left: 40, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: h.x },
      yAxis: { type: "value", name: "ימים" },
      series: [{ type: "line", name: "חציון", data: h.y }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>
