    var el = document.getElementById("chart-hubs");
    if (!el) { return; }
    var narrow = el.clientWidth < 500;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      legend: { top: 0 },
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        return echarts.format.encodeHTML(d.names[i]) + "<br>" + d.slow[i] + " רגילות, " + d.fast[i] + " מהירות";
      } },
      grid: { left: 16, right: 24, top: 36, bottom: 16, containLabel: true },
      xAxis: { type: "value", splitNumber: 3 },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: narrow ? 120 : 220, overflow: "truncate" } },
      series: [
        { type: "bar", name: "נקודות רגילות", stack: "h", data: d.slow, barMaxWidth: 22 },
        { type: "bar", name: "נקודות מהירות", stack: "h", data: d.fast, barMaxWidth: 22 }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

{%- if model.flags.fasthubs %}
<script>
  (function () {
    var d = {{ model.charts.fasthubs | tojson }};
    var el = document.getElementById("chart-fasthubs");
    if (!el) { return; }
    var narrow = el.clientWidth < 500;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        return echarts.format.encodeHTML(d.names[p[0].dataIndex]) + "<br>" + p[0].value + " נקודות מהירות";
      } },
      grid: { left: 16, right: 40, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, minInterval: 1 },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: narrow ? 120 : 220, overflow: "truncate" } },
      series: [{ type: "bar", data: d.fast, barMaxWidth: 22, label: { show: true, position: "right" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}
