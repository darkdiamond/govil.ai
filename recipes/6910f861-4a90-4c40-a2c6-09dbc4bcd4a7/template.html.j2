{%- if model.flags.map %}
{%- for chunk in model.charts.map.chunks %}
<script type="application/json" id="map-pts-{{ loop.index0 }}">{{ chunk | tojson }}</script>
{%- endfor %}
<script>
  (function () {
    var el = document.getElementById("map-stations");
    if (!el || !window.L) { return; }
    var meta = {{ {"n": model.charts.map.chunks | length, "ops": model.charts.map.ops, "bounds": model.charts.map.bounds} | tojson }};
    var map = L.map(el, { scrollWheelZoom: false, zoomSnap: 0.25 });
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 18, attribution: "© OpenStreetMap" }).addTo(map);
    var group = L.markerClusterGroup ? L.markerClusterGroup({ showCoverageOnHover: false, maxClusterRadius: 45 }) : L.layerGroup();
    for (var c = 0; c < meta.n; c++) {
      var node = document.getElementById("map-pts-" + c);
      if (!node) { continue; }
      JSON.parse(node.textContent).forEach(function (p) {
        var fast = p[2] > 0;
        var mk = L.circleMarker([p[0], p[1]], {
          radius: fast ? 7 : 5, color: "#0b3668", weight: 1,
          fillColor: fast ? "#0b3668" : "#7fb2fa", fillOpacity: 0.85
        });
        var box = document.createElement("div");
        var title = document.createElement("strong");
        title.textContent = p[4];
        box.appendChild(title);
        var rows = [["מפעילה", meta.ops[p[5]]], ["נקודות מהירות", String(p[2])], ["נקודות רגילות", String(p[3])]];
        if (p[6]) { rows.splice(1, 0, ["כתובת", p[6]]); }
        rows.forEach(function (row) {
          var line = document.createElement("div");
          line.textContent = row[0] + ": " + row[1];
          box.appendChild(line);
        });
        mk.bindPopup(box);
        group.addLayer(mk);
      });
    }
    group.addTo(map);
    map.fitBounds(meta.bounds, { padding: [8, 8] });
  })();
</script>
{%- endif %}

{%- if model.flags.regions %}
<script>
  (function () {
    var d = {{ model.charts.regions | tojson }};
    var el = document.getElementById("chart-regions");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      legend: { top: 0 },
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        return echarts.format.encodeHTML(d.names[i]) + "<br>" + d.sites[i].toLocaleString("he-IL") + " אתרים<br>" +
          d.slow[i].toLocaleString("he-IL") + " נקודות רגילות<br>" + d.fast[i].toLocaleString("he-IL") + " נקודות מהירות";
      } },
      grid: { left: 16, right: 24, top: 36, bottom: 16, containLabel: true },
      xAxis: { type: "value", splitNumber: 3 },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 120, overflow: "break" } },
      series: [
        { type: "bar", name: "נקודות רגילות", stack: "p", data: d.slow, barMaxWidth: 28 },
        { type: "bar", name: "נקודות מהירות", stack: "p", data: d.fast, barMaxWidth: 28 }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
<script>
  (function () {
    var d = {{ model.charts.types | tojson }};
    var el = document.getElementById("chart-types");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      legend: { top: 0 },
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        var out = echarts.format.encodeHTML(d.names[i]);
        p.forEach(function (s) {
          out += "<br>" + echarts.format.encodeHTML(s.seriesName) + ": " + s.value + "% (" + d.counts[s.seriesIndex][i].toLocaleString("he-IL") + " אתרים)";
        });
        return out;
      } },
      grid: { left: 16, right: 24, top: 56, bottom: 16, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 120, overflow: "break" } },
      series: d.labels.map(function (name, k) {
        return { type: "bar", name: name, stack: "t", data: d.series[k], barMaxWidth: 28 };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
<script>
  (function () {
    var d = {{ model.charts.heat | tojson }};
    var el = document.getElementById("chart-heat");
    if (!el) { return; }
    var narrow = el.clientWidth < 500;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return echarts.format.encodeHTML(d.y[p.value[1]]) + "<br>" + echarts.format.encodeHTML(d.x[p.value[0]]) + ": " +
          p.value[2].toLocaleString("he-IL") + " נקודות";
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.x, splitArea: { show: true }, axisLabel: { interval: 0, rotate: narrow ? 45 : 0, width: narrow ? 90 : 110, overflow: "truncate" } },
      yAxis: { type: "category", data: d.y, inverse: true, splitArea: { show: true } },
      visualMap: { min: 0, max: d.max, dimension: 2, calculable: true, orient: "horizontal", left: "center", bottom: 0,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] }, textStyle: { fontFamily: "Rubik", color: "#0c3058" } },
      series: [{ type: "heatmap", data: d.cells, label: { show: !narrow, fontFamily: "Rubik" },
        emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

