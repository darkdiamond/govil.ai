{%- macro head(icon, title) %}
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/{{ icon }}.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ title }}</h2>
  </div>
{%- endmacro %}
{%- macro tbl(caption, heads, rows, keys) %}
  <details class="mt-3">
    <summary class="cursor-pointer text-sm text-brand">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ caption }}</caption>
        <thead><tr class="border-b border-rule text-ink-deep">{% for h in heads %}<th scope="col" class="text-start py-1 pe-3">{{ h }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in rows %}
          <tr class="border-b border-rule"><th scope="row" class="text-start font-normal py-1 pe-3">{{ r[keys[0]] }}</th>{% for k in keys[1:] %}<td class="py-1 pe-3">{{ r[k] }}</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
{%- endmacro %}
<h1>מטרו ירושלים: מפת קווי המטרו המתוכננים במטרופולין ירושלים</h1>

<section class="card p-5 mb-6">
{{ head("info", "תקציר") }}
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));">
{%- for key in model.kpi_order %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.labels["kpi_" ~ key] }}</div>
  </div>
{%- endfor %}
</div>

<section class="card p-5 mb-6">
{{ head("circle-check", "תובנות עיקריות") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
{{ head("map-pin", "מפת תוואי המטרו") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.map_lede }}</p>
  <div id="map-network" class="h-80 md:h-[460px]" role="region" aria-label="{{ model.labels.map_aria }}" data-fallback="explorer"></div>
  <ul id="map-legend" class="flex flex-wrap gap-4 mt-3 mb-0 ps-0 list-none text-sm text-subtle"></ul>
</section>

<section class="card p-5 mb-6">
{{ head("database", "אורך כל קטע") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.len_lede }}</p>
  <div id="chart-len" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.len_aria }}"></div>
{{ tbl(model.labels.len_caption, ["קטע", "קוד בשכבה", "מזהה קו", "סוג", "אורך רשום (מ׳)", "אורך נמדד (מ׳)", "אורך מעוגל (ק״מ)", "שיעור מהרשת", "שנת יעד"], model.tables.len, ["name", "code", "id", "kind", "rec", "measured", "lengt", "share", "year"]) }}
</section>

{%- if model.flags.sys %}
<section class="card p-5 mb-6">
{{ head("list", "קווים ראשיים ושלוחותיהם") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.sys_lede }}</p>
  <div id="chart-sys" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.sys_aria }}"></div>
{{ tbl(model.labels.sys_caption, ["קו", "הקו עצמו (ק״מ)", "שלוחות (ק״מ)", "סך הכול (ק״מ)"], model.tables.sys, ["name", "main", "kids", "total"]) }}
</section>
{%- endif %}

{%- if model.flags.shape %}
<section class="card p-5 mb-6">
{{ head("map-pin", "כמה מתפתל כל תוואי") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.shape_lede }}</p>
  <div id="chart-shape" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.shape_aria }}"></div>
{{ tbl(model.labels.shape_caption, ["קטע", "אורך התוואי (ק״מ)", "קו אווירי (ק״מ)", "יחס", "ציר"], model.tables.shape, ["name", "route", "straight", "ratio", "axis"]) }}
</section>
{%- endif %}

{%- if model.flags.pairs %}
<section class="card p-5 mb-6">
{{ head("list", "היכן הקווים נפגשים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.pairs_lede }}</p>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <caption class="sr-only">{{ model.labels.pairs_caption }}</caption>
      <thead><tr class="border-b border-rule text-ink-deep"><th scope="col" class="text-start py-1 pe-3">זוג קטעים</th><th scope="col" class="text-start py-1 pe-3">יחס</th><th scope="col" class="text-start py-1 pe-3">מרחק מזערי (מ׳)</th><th scope="col" class="text-start py-1 pe-3">היכן</th></tr></thead>
      <tbody>
{%- for r in model.tables.pairs %}
        <tr class="border-b border-rule"><th scope="row" class="text-start font-normal py-1 pe-3">{{ r.pair }}</th><td class="py-1 pe-3">{{ r.kind }}</td><td class="py-1 pe-3">{{ r.dist }}</td><td class="py-1 pe-3">{{ r.where }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </div>
</section>
{%- endif %}

<section class="card p-5 mb-6">
{{ head("list", "מה יש במאגר, ואיפה למצוא עוד") }}
  <p class="m-0 mb-2 text-sm leading-relaxed">המפה נבנית מקובץ ה-SHP של השכבה, שמתעדכן אוטומטית עם כל העלאה חדשה. טבלת הנתונים שבמאגר כוללת את אותם שדות (שם, מזהה קו, שנת יעד ואורך) בלי התוואי עצמו, וקובץ ה-XLSX מכיל את המטא-דאטה של השכבה.</p>
  <p class="m-0 text-sm text-subtle leading-relaxed">ראו גם: <a href="{{ model.links.jlm2050 }}" class="text-brand underline">תוכנית אסטרטגית למתע"ן מטרופולין ירושלים 2050</a> · <a href="{{ model.links.jlm2040 }}" class="text-brand underline">תוכנית אסטרטגית למתע"ן ירושלים 2040</a> · <a href="{{ model.links.lrt }}" class="text-brand underline">קווי רכבת קלה</a> · <a href="{{ model.links.tlv_metro }}" class="text-brand underline">קווי המטרו במטרופולין תל אביב</a>.</p>
</section>

<section class="card p-5 mb-6">
{{ head("list", "תיאור מקורי") }}
  <p class="m-0 text-sm text-subtle whitespace-pre-line">קווי המטרו המתוכננים במטרופולין ירושלים</p>
</section>

{%- for chunk in model.charts.map.chunks %}
<script type="application/json" id="map-lines-{{ loop.index0 }}">{{ chunk | tojson }}</script>
{%- endfor %}
<script type="application/json" id="map-meta">{{ {"n": model.charts.map.chunks | length, "segs": model.charts.map.segs, "bounds": model.charts.map.bounds, "markers": model.charts.map.markers} | tojson }}</script>
<script>
  (function () {
    var el = document.getElementById("map-network");
    var metaNode = document.getElementById("map-meta");
    if (!el || !metaNode || !window.L) { return; }
    var meta = JSON.parse(metaNode.textContent);
    var pal = window.GOVIL_PALETTE || ["#0068f5", "#0b3668"];
    var color = function (k) { return pal[k % pal.length]; };
    var map = L.map(el, { scrollWheelZoom: false, zoomSnap: 0.25 });
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 18, attribution: "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>" }).addTo(map);
    var popup = function (title, rows) {
      var box = document.createElement("div");
      var t = document.createElement("strong");
      t.textContent = title;
      box.appendChild(t);
      rows.forEach(function (row) {
        var d = document.createElement("div");
        d.textContent = row;
        box.appendChild(d);
      });
      return box;
    };
    for (var c = 0; c < meta.n; c++) {
      var node = document.getElementById("map-lines-" + c);
      if (!node) { continue; }
      JSON.parse(node.textContent).forEach(function (f) {
        var s = meta.segs[f[0]];
        var line = L.polyline(f[1].map(function (p) { return [p[1], p[0]]; }), {
          color: color(s.color), weight: s.dash ? 4 : 5, opacity: 0.9, dashArray: s.dash ? "8 6" : null
        }).addTo(map);
        var rows = [];
        if (s.parent) { rows.push("שלוחה של " + s.parent); }
        rows.push("אורך: " + s.km + " ק״מ");
        rows.push("שנת יעד: " + s.year);
        line.bindPopup(popup(s.name, rows));
      });
    }
    meta.markers.forEach(function (m) {
      L.circleMarker([m.pt[1], m.pt[0]], { radius: 7, color: "#0c3058", weight: 2, fillColor: "#ffffff", fillOpacity: 1 })
        .addTo(map).bindPopup(popup(m.kind, [m.text]));
    });
    map.fitBounds(meta.bounds, { padding: [12, 12] });
    var legend = document.getElementById("map-legend");
    meta.segs.forEach(function (s) {
      var li = document.createElement("li");
      li.className = "flex items-center gap-2";
      var sw = document.createElement("span");
      sw.style.cssText = "display:inline-block;width:28px;height:0;border-top:4px " + (s.dash ? "dashed " : "solid ") + color(s.color);
      li.appendChild(sw);
      li.appendChild(document.createTextNode(s.name));
      legend.appendChild(li);
    });
  })();
</script>

<script>
  (function () {
    var el = document.getElementById("chart-len");
    if (!el) { return; }
    var d = {{ model.charts.len | tojson }};
    var pal = window.GOVIL_PALETTE;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: pal,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        return echarts.format.encodeHTML(d.names[i]) + "<br>" + d.km[i] + " ק״מ (" + d.share[i] + "% מהרשת)";
      } },
      grid: { left: 16, right: 48, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "value", name: "ק״מ", nameLocation: "end" },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [{
        type: "bar", name: "אורך (ק״מ)",
        data: d.km.map(function (v, i) {
          var col = d.color[i] >= 0 ? pal[d.color[i] % pal.length] : "#6c757d";
          return { value: v, itemStyle: d.ext[i]
            ? { color: "#ffffff", borderColor: col, borderWidth: 2, borderType: "dashed" }
            : { color: col } };
        }),
        label: { show: true, position: "right", formatter: function (p) { return p.value.toFixed(1); } }
      }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var el = document.getElementById("chart-sys");
    if (!el) { return; }
    var d = {{ model.charts.sys | tojson }};
    var pal = window.GOVIL_PALETTE;
    var c = echarts.init(el);
    var series = [{ type: "bar", stack: "s", name: "הקו עצמו", data: d.main, itemStyle: { color: pal[0] }, barMaxWidth: 40 }];
    d.kids.forEach(function (vals, k) {
      series.push({ type: "bar", stack: "s", name: "שלוחה", data: vals, barMaxWidth: 40,
                    itemStyle: { color: pal[(k + 2) % pal.length] } });
    });
    series[series.length - 1].label = { show: true, position: "right", formatter: function (p) { return d.total[p.dataIndex].toFixed(1); } };
    c.setOption(window.GovEcharts.option({
      color: pal,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        var out = echarts.format.encodeHTML(d.names[i]) + "<br>הקו עצמו: " + d.main[i] + " ק״מ";
        d.kids.forEach(function (vals, k) {
          if (d.kid_names[k][i]) { out += "<br>" + echarts.format.encodeHTML(d.kid_names[k][i]) + ": " + vals[i] + " ק״מ"; }
        });
        return out + "<br>סך הכול: " + d.total[i] + " ק״מ";
      } },
      grid: { left: 16, right: 48, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "value", name: "ק״מ", nameLocation: "end" },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: series
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var el = document.getElementById("chart-shape");
    if (!el) { return; }
    var d = {{ model.charts.shape | tojson }};
    var pal = window.GOVIL_PALETTE;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: [pal[0], pal[6]],
      legend: { bottom: 0 },
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        return echarts.format.encodeHTML(d.names[i]) + "<br>אורך התוואי: " + d.route[i] + " ק״מ<br>קו אווירי: " +
          d.straight[i] + " ק״מ<br>יחס: " + d.ratio[i];
      } },
      grid: { left: 16, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: d.names },
      yAxis: { type: "value", name: "ק״מ" },
      series: [
        { type: "bar", name: "אורך התוואי", data: d.route, barMaxWidth: 36,
          label: { show: true, position: "top", formatter: function (p) { return "×" + d.ratio[p.dataIndex].toFixed(2); } } },
        { type: "bar", name: "מרחק בקו אווירי", data: d.straight, barMaxWidth: 36 }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
