<script>
  (function () {
    var a = {{ model.charts.agents | tojson }};
    var el = document.getElementById("chart-agents");
    var narrow = el.clientWidth < 500;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        return ps[0].axisValue + "<br>" + Number(ps[0].value).toLocaleString("he-IL") + " נגעים";
      } },
      grid: { left: 16, right: narrow ? 40 : 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: !narrow } },
      yAxis: { type: "category", data: a.names, inverse: true, axisLabel: { width: 100, overflow: "truncate" } },
      series: [{ type: "bar", name: "נגעים", data: a.values,
                 label: { show: true, position: "right", fontSize: 11, color: "#0c3058" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var t = {{ model.charts.tax | tojson }};
    var tc = echarts.init(document.getElementById("chart-tax"));
    tc.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        return p.name + "<br>" + Number(p.value).toLocaleString("he-IL") + " נגעים";
      } },
      series: [{ type: "sunburst", data: t, radius: ["12%", "92%"], sort: null,
                 nodeClick: "rootToNode",
                 itemStyle: { borderColor: "#fff", borderWidth: 1 },
                 label: { fontFamily: "Rubik", fontSize: 10, minAngle: 16, rotate: "radial" },
                 levels: [{}, { label: { fontSize: 11 } }, { label: { fontSize: 10 } }, { label: { fontSize: 9 } }] }]
    }));
    window.addEventListener("resize", function () { tc.resize(); });
  })();
</script>

<script>
  (function () {
    var P = {{ model.charts.pal | tojson }}.map(function (i) { return window.GOVIL_PALETTE[i]; });
    var o = {{ model.charts.orders | tojson }};
    var el = document.getElementById("chart-orders");
    var narrow = el.clientWidth < 500;
    var c = echarts.init(el);
    var used = o.legend.filter(function (g) { return o.groups.indexOf(g) >= 0; });
    c.setOption(window.GovEcharts.option({
      color: used.map(function (g) { return P[o.legend.indexOf(g) % P.length]; }),
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex;
        return ps[0].axisValue + " (" + o.groups[i] + ")<br>" + o.values[i].toLocaleString("he-IL") + " נגעים";
      } },
      legend: { bottom: 0 },
      grid: { left: 16, right: narrow ? 40 : 24, top: 16, bottom: narrow ? 64 : 40, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: !narrow } },
      yAxis: { type: "category", data: o.names, inverse: true, axisLabel: { width: 120, overflow: "truncate", fontSize: narrow ? 10 : 12 } },
      series: used.map(function (g) {
        return { type: "bar", stack: "a", name: g,
                 data: o.values.map(function (v, i) { return o.groups[i] === g ? v : "-"; }),
                 label: { show: narrow, position: "right", fontSize: 10, color: "#0c3058" } };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var f = {{ model.charts.families | tojson }};
    var fEl = document.getElementById("chart-families");
    var fNarrow = fEl.clientWidth < 500;
    var fc = echarts.init(fEl);
    fc.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 40, containLabel: true },
      xAxis: { type: "value", splitNumber: fNarrow ? 3 : 5 },
      yAxis: { type: "category", data: f.names, inverse: true, axisLabel: { width: 120, overflow: "truncate", fontSize: fNarrow ? 10 : 12 } },
      series: [
        { type: "bar", name: "נגעים", data: f.values },
        { type: "bar", name: "סוגים", data: f.genera }
      ]
    }));
    window.addEventListener("resize", function () { fc.resize(); });
  })();
</script>

<script>
  (function () {
    var P = {{ model.charts.pal | tojson }}.map(function (i) { return window.GOVIL_PALETTE[i]; });
    var h = {{ model.charts.hosts | tojson }};
    var el = document.getElementById("chart-hosts");
    var narrow = el.clientWidth < 500;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: P,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var s = ps[0].axisValue, sum = 0;
        ps.forEach(function (p) { sum += p.value; s += "<br>" + p.marker + p.seriesName + ": " + p.value.toLocaleString("he-IL"); });
        return s + "<br>סה״כ: " + sum.toLocaleString("he-IL") + " נגעים";
      } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: narrow ? 56 : 40, containLabel: true },
      xAxis: { type: "value", splitNumber: narrow ? 3 : 5 },
      yAxis: { type: "category", data: h.names, inverse: true, axisLabel: { interval: 0, width: 100, overflow: "truncate", fontSize: narrow ? 10 : 12 } },
      series: h.series.map(function (s) { return { type: "bar", stack: "a", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    function heat(id, h, fmt, max) {
      var el = document.getElementById(id);
      var narrow = el.clientWidth < 600;
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option({
        tooltip: { position: "top", formatter: function (p) {
          return h.y[p.value[1]] + " · " + h.x[p.value[0]] + ": " + fmt(p.value[2]);
        } },
        grid: { left: 8, right: 8, top: 8, bottom: 64, containLabel: true },
        xAxis: { type: "category", data: h.x, splitArea: { show: true },
                 axisLabel: narrow ? { interval: 0, rotate: 45, width: 70, overflow: "truncate", fontSize: 10 }
                                   : { interval: 0, width: 90, overflow: "break" } },
        yAxis: { type: "category", data: h.y, inverse: true, splitArea: { show: true },
                 axisLabel: { interval: 0, fontSize: narrow ? 10 : 12, width: narrow ? 80 : 140, overflow: "truncate" } },
        visualMap: {
          min: 0, max: max, calculable: true, dimension: 2,
          orient: "horizontal", left: "center", bottom: 4, itemHeight: 120,
          inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
          textStyle: { fontFamily: "Rubik", color: "#0c3058" }
        },
        series: [{ type: "heatmap", data: h.cells,
                   label: { show: true, fontFamily: "Rubik", fontSize: narrow ? 8 : 11,
                            formatter: function (p) { return narrow ? String(Math.round(p.value[2])) : fmt(p.value[2]); } },
                   emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    var hm = {{ model.charts.heat | tojson }};
    heat("chart-heat", hm, function (v) { return v.toLocaleString("he-IL"); }, hm.max);
    heat("chart-complete", {{ model.charts.complete | tojson }}, function (v) { return v + "%"; }, 100);
  })();
</script>

<script>
  (function () {
    function vbar(id, d, unit) {
      var el = document.getElementById(id);
      var narrow = el.clientWidth < 500;
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
          return "<bdi>" + ps[0].axisValue + "</bdi><br>" + Number(ps[0].value).toLocaleString("he-IL") + " " + unit;
        } },
        grid: { left: 16, right: 16, top: 32, bottom: 24, containLabel: true },
        xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, rotate: narrow ? 45 : 0, fontSize: narrow ? 10 : 11,
                 formatter: function (v) { return "\u2066" + v + "\u2069"; } } },
        yAxis: { type: "value", name: unit },
        series: [{ type: "bar", name: unit, data: d.values }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    vbar("chart-poly", {{ model.charts.poly | tojson }}, "נגעים");
{%- if model.charts.era %}
    vbar("chart-era", {{ model.charts.era | tojson }}, "נגעים");
{%- endif %}

    var a = {{ model.charts.auth | tojson }};
    var el = document.getElementById("chart-auth");
    var narrow = el.clientWidth < 500;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        return ps[0].axisValue + "<br>" + Number(ps[0].value).toLocaleString("he-IL") + " נגעים";
      } },
      grid: { left: 16, right: narrow ? 40 : 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: !narrow } },
      yAxis: { type: "category", data: a.names, inverse: true, axisLabel: { width: 130, overflow: "truncate", fontSize: narrow ? 10 : 12 } },
      series: [{ type: "bar", name: "נגעים", data: a.values,
                 label: { show: true, position: "right", fontSize: 10, color: "#0c3058" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
