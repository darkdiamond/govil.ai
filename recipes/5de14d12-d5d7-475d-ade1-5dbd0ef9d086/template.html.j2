<h1>איכות מים במעיינות: מדידות השירות ההידרולוגי</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
{%- for key in model.kpi_order %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.kpi_labels[key] }}</div>
  </div>
{%- endfor %}
</div>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור תוצאות דיגום של מעיין לפי שם או פרמטר ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: שם המעיין בעברית או באנגלית, מספר זיהוי, סמל הפרמטר (כגון CL לכלוריד), שנה הידרולוגית ותאריך דגימה.</span>
  </span>
</a>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">היקף הדיגום לאורך השנים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.yearly_lede }}</p>
  <div id="chart-yearly" class="h-72 md:h-96" role="img" data-fallback="explorer" aria-label="{{ model.labels.yearly_aria }}"></div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מה נמדד: הפרמטרים במאגר</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.params_lede }}</p>
  <div id="chart-params" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.params_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.params_aria }}</caption>
      <thead><tr><th scope="col">פרמטר</th><th scope="col">סמל</th><th scope="col">יחידה</th><th scope="col">מדידות</th><th scope="col">מעיינות</th></tr></thead>
      <tbody>
{%- for r in model.tables.params %}
        <tr><th scope="row">{{ r.name }}</th><td dir="ltr">{{ r.code }}</td><td dir="ltr">{{ r.unit }}</td><td>{{ r.n | fmt_int }}</td><td>{{ r.springs | fmt_int }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

{%- if model.flags.chloride %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">המעיינות המליחים ביותר (כלוריד)</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.chloride_lede }}</p>
  <div id="chart-chloride" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.chloride_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.chloride_aria }}</caption>
      <thead><tr><th scope="col">מעיין</th><th scope="col">חציון כלוריד (מ״ג/ל)</th><th scope="col">דגימות</th></tr></thead>
      <tbody>
{%- for r in model.tables.chloride %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.median_d }}</td><td>{{ r.n | fmt_int }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{%- endif %}

{%- if model.flags.nitrate %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/triangle-alert.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">חנקה מול תקן מי השתייה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.no3_lede }}</p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <div>
      <h3 class="m-0 mb-3 text-base font-semibold text-ink-deep">התפלגות המעיינות לפי חציון החנקה (מ״ג/ל)</h3>
      <div id="chart-no3-bands" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.no3_bands_aria }}"></div>
      <details class="mt-3">
        <summary class="text-sm text-subtle">הצג כטבלה</summary>
        <table class="mt-2 w-full text-sm">
          <caption class="sr-only">{{ model.labels.no3_bands_aria }}</caption>
          <thead><tr><th scope="col">חציון חנקה (מ״ג/ל)</th><th scope="col">מעיינות</th></tr></thead>
          <tbody>
{%- for r in model.tables.no3_bands %}
            <tr><th scope="row">{{ r.label }}{% if r.over %} (מעל התקן){% endif %}</th><td>{{ r.n | fmt_int }}</td></tr>
{%- endfor %}
          </tbody>
        </table>
      </details>
    </div>
    <div>
      <h3 class="m-0 mb-3 text-base font-semibold text-ink-deep">המעיינות עם החנקה הגבוהה ביותר</h3>
      <div id="chart-no3-top" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.no3_top_aria }}"></div>
      <details class="mt-3">
        <summary class="text-sm text-subtle">הצג כטבלה</summary>
        <table class="mt-2 w-full text-sm">
          <caption class="sr-only">{{ model.labels.no3_top_aria }}</caption>
          <thead><tr><th scope="col">מעיין</th><th scope="col">חציון (מ״ג/ל)</th><th scope="col">מרבי (מ״ג/ל)</th><th scope="col">דגימות</th></tr></thead>
          <tbody>
{%- for r in model.tables.no3_top %}
            <tr><th scope="row">{{ r.name }}</th><td>{{ r.median_d }}{% if r.over %} (מעל התקן){% endif %}</td><td>{{ r.max_d }}</td><td>{{ r.n | fmt_int }}</td></tr>
{%- endfor %}
          </tbody>
        </table>
      </details>
    </div>
  </div>
</section>
{%- endif %}

{%- if model.flags.no3_change %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">החנקה אז והיום</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.no3_change_lede }}</p>
  <div id="chart-no3-change" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.no3_change_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.no3_change_aria }}</caption>
      <thead><tr><th scope="col">מעיין</th><th scope="col">{{ model.labels.no3_change_early }}</th><th scope="col">{{ model.labels.no3_change_recent }}</th><th scope="col">שינוי (מ״ג/ל)</th></tr></thead>
      <tbody>
{%- for r in model.tables.no3_change %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.early_d }}</td><td>{{ r.recent_d }}</td><td dir="ltr">{{ r.delta_d }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
