    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.combos_caption }}</caption>
      <thead><tr><th scope="col">צירוף שפות</th><th scope="col">מלווים</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.combos %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

