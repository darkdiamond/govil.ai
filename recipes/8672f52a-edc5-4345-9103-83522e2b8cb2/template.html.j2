<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">שפות לפי מרחב</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.heat_note }}</p>
  <div id="chart-heat" data-fallback="explorer" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.heat_aria }}"></div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">ערוצי קשר זמינים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.contact_note }}</p>
  <div id="chart-contact" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.contact_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.contact_caption }}</caption>
      <thead><tr><th scope="col">ערוץ</th><th scope="col">מלווים</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.contact %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<script>
  (function () {
    var langs = {{ model.charts.langs | tojson }};
    var c_langs = echarts.init(document.getElementById("chart-langs"));
    c_langs.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 24, top: 16, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: langs.x, axisLabel: { interval: 0, rotate: 30 } }, yAxis: { type: "value", name: "מלווים" },
      series: [{ type: "bar", name: "מלווים", data: langs.y, barMaxWidth: 28 }]
    }));
    window.addEventListener("resize", function () { c_langs.resize(); });

    var combos = {{ model.charts.combos | tojson }};
    var c_combos = echarts.init(document.getElementById("chart-combos"));
    c_combos.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 24, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "value", name: "מלווים" }, yAxis: { type: "category", data: combos.x, inverse: true, axisLabel: { width: 110, overflow: "truncate" } },
      series: [{ type: "bar", name: "מלווים", data: combos.y, barMaxWidth: 28 }]
    }));
    window.addEventListener("resize", function () { c_combos.resize(); });
  })();
</script>

