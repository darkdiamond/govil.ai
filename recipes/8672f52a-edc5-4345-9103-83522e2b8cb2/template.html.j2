<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">יישובים ורשויות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.places_note }}</p>
  <div id="chart-places" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.places_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
