<script>
  (function () {
    var h = {{ model.charts.heat | tojson }};
    var c = echarts.init(document.getElementById("chart-heat"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { position: "top", formatter: function (p) {
        return h.y[p.value[1]] + " · " + h.x[p.value[0]] + ": " + p.value[2];
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true }, axisLabel: { interval: 0, fontSize: 11 } },
      yAxis: { type: "category", data: h.y, inverse: true, axisLabel: { width: 100, overflow: "truncate" } },
      visualMap: { min: 0, max: h.max, dimension: 2, calculable: false, orient: "horizontal", left: "center", bottom: 4,
                   inRange: { color: ["#f1f7ff", "#0068f5", "#0b3668"] } },
      series: [{ type: "heatmap", data: h.data, label: { show: true } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
