      grid: { left: 16, right: 16, top: 32, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.names },
      yAxis: { type: "value", name: "היתרים" },
      series: [{ type: "bar", name: "היתרים", data: d.values }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>
