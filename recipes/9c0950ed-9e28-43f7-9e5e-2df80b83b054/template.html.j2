{%- macro fallback(tbl, cap) %}
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ cap }}</caption>
      <thead><tr>{% for h_ in tbl.headers %}<th scope="col">{{ h_ }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for r in tbl.rows %}
        <tr>{% for c in r %}{% if loop.first %}<th scope="row">{{ c }}</th>{% else %}<td>{{ c }}</td>{% endif %}{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
{%- endmacro %}
{%- macro chart_section(cid, icon, title, note, aria, cap, tbl, h="h-64 md:h-80") %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/{{ icon }}.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ title }}</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ note }}</p>
  <div id="{{ cid }}" class="{{ h }}" role="img" aria-label="{{ aria }}"></div>
{{ fallback(tbl, cap) }}
</section>
{%- endmacro %}
<h1>מתקני עגינת אופניים בבאר שבע</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור חניית אופניים לפי שם המקום ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: שם המקום (מרכז מסחרי, מרפאה, מתנ״ס, פארק) ומספר העמדות בכל מתקן.</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
{%- for key in ["sites", "stands", "marked", "empty"] %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.kpis[key].label }}</div>
  </div>
{%- endfor %}
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מפת חניות האופניים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.map_note }}</p>
  <div id="map-main" class="h-72 md:h-[420px]"></div>
</section>

{{ chart_section("chart-types", "building-2", "באילו מקומות יש עמדות עגינה", model.labels.types_note, model.labels.types_aria, model.labels.types_cap, model.tables.types, "h-80 md:h-[460px]") }}

{{ chart_section("chart-top", "list", "המקומות עם הכי הרבה עמדות", model.labels.top_note, model.labels.top_aria, model.labels.top_cap, model.tables.top, "h-80 md:h-[460px]") }}

{{ chart_section("chart-size", "database", "גודל המתקנים", model.labels.size_note, model.labels.size_aria, model.labels.size_cap, model.tables.size) }}

{{ chart_section("chart-config", "database", "תצורות עמדות נפוצות", model.labels.config_note, model.labels.config_aria, model.labels.config_cap, model.tables.config, "h-72 md:h-96") }}

{{ chart_section("chart-balance", "tag", "עמדות מסומנות מול לא מסומנות", model.labels.balance_note, model.labels.balance_aria, model.labels.balance_cap, model.tables.balance) }}

{% if model.flags.geo %}
{{ chart_section("chart-dist", "map-pin", "מרחק ממרכז הפריסה", model.labels.dist_note, model.labels.dist_aria, model.labels.dist_cap, model.tables.dist) }}

{{ chart_section("chart-sectors", "map-pin", "פריסה לפי כיוון", model.labels.sectors_note, model.labels.sectors_aria, model.labels.sectors_cap, model.tables.sectors, "h-72 md:h-96") }}
{% endif %}

<script>
  GovMap.create({
    container: "#map-main",
    resourceId: {{ inputs.racks[0].id | tojson }},
    latField: "lat",
    lngField: "lon",
    projection: "wgs84",
    popupTitleField: "Address",
    popupFields: [
      { field: "sign", label: "עמדות מסומנות" },
      { field: "NoSign", label: "עמדות ללא סימון" }
    ]
  });
</script>

<script>
  (function () {
    function mk(id) {
      var el = document.getElementById(id);
      if (!el) { return null; }
      var c = echarts.init(el);
      window.addEventListener("resize", function () { c.resize(); });
      return c;
    }
    function stacked(id, d) {
      var c = mk(id); if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: ["#0068f5", "#c3cfe7"],
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { bottom: 0, itemWidth: 12, itemHeight: 10 },
        grid: { left: 8, right: 24, top: 8, bottom: 36, containLabel: true },
        xAxis: { type: "value", minInterval: 1 },
        yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { interval: 0, width: 120, overflow: "truncate" } },
        series: [
          { type: "bar", stack: "t", name: "מסומנות", data: d.s.slice().reverse() },
          { type: "bar", stack: "t", name: "ללא סימון", data: d.n.slice().reverse() }
        ]
      }));
    }
    function vbar(id, d, unit) {
      var c = mk(id); if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 16, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, fontSize: 11, rotate: window.innerWidth < 500 ? 30 : 0 } },
        yAxis: { type: "value", minInterval: 1 },
        series: [{ type: "bar", name: unit, data: d.values }]
      }));
    }
    function hbar(id, d, unit) {
      var c = mk(id); if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value", minInterval: 1 },
        yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { interval: 0, width: 150, overflow: "truncate" } },
        series: [{ type: "bar", name: unit, data: d.values.slice().reverse() }]
      }));
    }
    stacked("chart-types", {{ model.charts.types | tojson }});
    stacked("chart-top", {{ model.charts.top | tojson }});
    vbar("chart-size", {{ model.charts.size | tojson }}, "מתקנים");
    hbar("chart-config", {{ model.charts.config | tojson }}, "מתקנים");
    vbar("chart-balance", {{ model.charts.balance | tojson }}, "מתקנים");
  })();
</script>

{% if model.flags.geo %}
<script>
  (function () {
    var D = {{ model.charts.dist | tojson }};
    var el = document.getElementById("chart-dist");
    if (el) {
      var c = echarts.init(el);
      window.addEventListener("resize", function () { c.resize(); });
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { bottom: 0, itemWidth: 12, itemHeight: 10 },
        grid: { left: 8, right: 8, top: 16, bottom: 36, containLabel: true },
        xAxis: { type: "category", data: D.names },
        yAxis: [{ type: "value", name: "עמדות", minInterval: 1 }, { type: "value", name: "מתקנים", minInterval: 1, splitLine: { show: false } }],
        series: [
          { type: "bar", name: "עמדות", data: D.stands },
          { type: "line", name: "מתקנים", yAxisIndex: 1, data: D.sites, symbolSize: 7 }
        ]
      }));
    }
    var S = {{ model.charts.sectors | tojson }};
    var el2 = document.getElementById("chart-sectors");
    if (el2) {
      var c2 = echarts.init(el2);
      window.addEventListener("resize", function () { c2.resize(); });
      c2.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "item" },
        polar: { radius: ["12%", "72%"] },
        angleAxis: { type: "category", data: S.names, startAngle: 112.5, clockwise: true, axisLabel: { fontSize: 11 } },
        radiusAxis: { type: "value", minInterval: 1, axisLabel: { show: false } },
        series: [{ type: "bar", coordinateSystem: "polar", name: "עמדות", data: S.values }]
      }));
    }
  })();
</script>
{% endif %}
