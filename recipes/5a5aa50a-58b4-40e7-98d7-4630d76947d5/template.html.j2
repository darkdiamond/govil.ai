<script>
  (function () {
    function rs(c) { window.addEventListener("resize", function () { c.resize(); }); }
    function stackedH(id, d, unit) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { bottom: 0 },
        grid: { left: 16, right: 24, top: 16, bottom: 56, containLabel: true },
        xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true,
                 axisLabel: { width: 130, overflow: "truncate" } },
        series: d.series.map(function (s) {
          return { type: "bar", stack: "total", name: s.name, data: s.data, itemStyle: { color: s.color } };
        })
      }));
      rs(c);
    }
    function donut(id, d, colors) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "item", formatter: function (p) {
          return p.name + ": " + p.value.toLocaleString("he-IL") + " (" + p.percent + "%)";
        } },
        legend: { bottom: 0 },
        series: [{
          type: "pie", radius: ["38%", "60%"], center: ["50%", "38%"], label: { show: false },
          data: d.names.map(function (nm, i) {
            var o = { name: nm, value: d.values[i] };
            if (colors) { o.itemStyle = { color: colors[i] }; }
            return o;
          })
        }]
      }));
      rs(c);
    }

    var t = {{ model.charts.types | tojson }};
    var c1 = echarts.init(document.getElementById("chart-types"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        return p.name + " (" + p.data.group + "): " + p.value.toLocaleString("he-IL") + " רישיונות";
      } },
      grid: { left: 16, right: 40, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: t.names, inverse: true },
      series: [{ type: "bar", name: "רישיונות", data: t.values,
                 label: { show: true, position: "right", fontFamily: "Rubik" } }]
    }));
    rs(c1);

    var g = {{ model.charts.groups | tojson }};
    donut("chart-groups", g, g.colors);
    donut("chart-legal", {{ model.charts.legal | tojson }}, null);
    stackedH("chart-districts", {{ model.charts.districts | tojson }}, "רישיונות");
  })();
</script>

<script>
  (function () {
    function rs(c) { window.addEventListener("resize", function () { c.resize(); }); }
    var h = {{ model.charts.lq | tojson }};
    var c = echarts.init(document.getElementById("chart-lq"));
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return h.y[p.value[1]] + " · " + h.x[p.value[0]] + "<br>מדד ריכוז: " + p.value[2].toFixed(2) +
          "<br>רישיונות: " + p.value[3].toLocaleString("he-IL");
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true },
               axisLabel: { interval: 0, rotate: 35, fontSize: 10 } },
      yAxis: { type: "category", data: h.y, splitArea: { show: true } },
      visualMap: {
        min: 0, max: h.max, calculable: true, dimension: 2,
        orient: "horizontal", left: "center", bottom: 0, itemHeight: 120,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells,
                 label: { show: true, fontFamily: "Rubik", fontSize: 10,
                          formatter: function (p) { return p.value[2].toFixed(1); } },
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    rs(c);
  })();
</script>

<script>
