    var m = {{ model.charts.months | tojson }};
    var c3 = echarts.init(document.getElementById("chart-months"));
    c3.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: m.x, axisLabel: { interval: 0, fontSize: 10 } },
      yAxis: { type: "value" },
      series: [{ type: "bar", name: "רישיונות", data: m.values }]
    }));
    rs(c3);
  })();
</script>

{% if model.flags.has_box %}
<script>
  (function () {
    var b = {{ model.charts.box | tojson }};
    function ym(v) {
      var y = Math.floor(v), mo = Math.min(12, Math.floor((v - y) * 12) + 1);
      return (mo < 10 ? "0" : "") + mo + "/" + y;
    }
    var c = echarts.init(document.getElementById("chart-box"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        var v = p.data.slice(-5);
        return p.name + "<br>אחוזון חמישי: " + ym(v[0]) + "<br>רבעון תחתון: " + ym(v[1]) +
          "<br>חציון: " + ym(v[2]) + "<br>רבעון עליון: " + ym(v[3]) + "<br>אחוזון תשעים וחמישה: " + ym(v[4]);
      } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", scale: true, minInterval: 1, splitNumber: 4,
               axisLabel: { hideOverlap: true, formatter: function (v) { return String(Math.round(v)); } } },
      yAxis: { type: "category", data: b.names, inverse: true },
      series: [{ type: "boxplot", name: "תאריך תפוגה", data: b.data,
                 itemStyle: { color: "#dbe8fb", borderColor: "#0068f5" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{% endif %}

{% if model.flags.has_gmp %}
<script>
  (function () {
    var g = {{ model.charts.gmp | tojson }};
    var c = echarts.init(document.getElementById("chart-gmp"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex;
        return g.names[i] + ": " + g.values[i].toLocaleString("he-IL") + " (" + g.shares[i] + "% מהסוג)";
      } },
      grid: { left: 16, right: 56, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: g.names, inverse: true },
      series: [{ type: "bar", name: "רישיונות עם GMP", data: g.values,
                 label: { show: true, position: "right", fontFamily: "Rubik",
                          formatter: function (p) { return g.shares[p.dataIndex] + "%"; } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{% endif %}
