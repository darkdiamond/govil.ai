{%- macro head(icon, title) %}
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/{{ icon }}.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ title }}</h2>
  </div>
{%- endmacro %}
{%- macro table(t, caption) %}
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="pi-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ caption }}</caption>
        <thead><tr>{% for h in t.head %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in t.rows %}
          <tr><th scope="row">{{ r[0] }}</th>{% for c in r[1:] %}<td dir="ltr" class="text-end">{{ c }}</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
{%- endmacro %}
<h1>חוקרים פרטיים: רשימת בעלי רישיון חוקר פרטי</h1>

<style>
  .pi-table th, .pi-table td { padding: 0.35rem 0.5rem; text-align: start; vertical-align: top; }
  .pi-table tbody tr { border-top: 1px solid #c3cfe7; }
  .pi-table tbody th { font-weight: 500; }
</style>

<section class="card p-5 mb-6">
{{ head("info", "תקציר") }}
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">בדיקת רישיון חוקר פרטי לפי שם או מספר רישיון ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: שם משפחה, שם פרטי ומספר רישיון.</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
{%- for key in model.kpi_order %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.labels["kpi_" ~ key] }}</div>
  </div>
{%- endfor %}
</div>

<section class="card p-5 mb-6">
{{ head("circle-check", "תובנות עיקריות") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>
{%- if model.flags.series %}

<section class="card p-5 mb-6">
{{ head("tag", "רישיונות לפי תחילת מספר הרישיון") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.series_note }}</p>
  <div id="chart-series" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.series_aria }}"></div>
{{ table(model.tables.series, model.labels.series_cap) }}
</section>
{%- endif %}

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
{%- if model.flags.last %}
  <section class="card p-5">
    <h2 class="m-0 mb-3 text-base font-semibold text-ink-deep">שמות המשפחה הנפוצים</h2>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.last_note }}</p>
    <div id="chart-last" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.last_aria }}"></div>
{{ table(model.tables.last, model.labels.last_cap) }}
  </section>
{%- endif %}
{%- if model.flags.first %}
  <section class="card p-5">
    <h2 class="m-0 mb-3 text-base font-semibold text-ink-deep">השמות הפרטיים הנפוצים</h2>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.first_note }}</p>
    <div id="chart-first" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.first_aria }}"></div>
{{ table(model.tables.first, model.labels.first_cap) }}
  </section>
{%- endif %}
</div>

<section class="card p-5 mb-6">
{{ head("list", "תיאור מקורי") }}
  <p class="m-0 text-sm text-subtle whitespace-pre-line">רשימת חוקרים פרטיים</p>
</section>
{%- if model.flags.series %}

<script>
  (function () {
    var d = {{ model.charts.series | tojson }};
    var el = document.getElementById("chart-series");
    if (!el) return;
    var narrow = el.clientWidth < 500;
    var c = echarts.init(el);
    var opt = {
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        return "מספר שמתחיל ב-" + echarts.format.encodeHTML(d.labels[i]) + "<br>" + d.values[i].toLocaleString("he-IL") + " רישיונות (מספור בן " + d.lens[i] + " ספרות)";
      } },
      grid: { left: 16, right: 16, top: 16, bottom: d.zoom ? 48 : 16, containLabel: true },
      xAxis: { type: "category", data: d.labels, axisLabel: { rotate: narrow ? 60 : 40, fontSize: narrow ? 10 : 12 } },
      yAxis: { type: "value", minInterval: 1, splitNumber: narrow ? 3 : 5 },
      series: [{ type: "bar", name: "רישיונות", barMaxWidth: 28,
        data: d.values.map(function (v, i) { return { value: v, itemStyle: { color: d.lens[i] === d.lens[0] ? "#0068f5" : "#0b3668" } }; }) }]
    };
    if (d.zoom) { opt.dataZoom = [{ type: "inside" }, { type: "slider", height: 18, bottom: 8 }]; }
    c.setOption(window.GovEcharts.option(opt));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}
{%- for cid in ["last", "first"] %}
{%- if model.flags[cid] %}

<script>
  (function () {
    var d = {{ model.charts[cid] | tojson }};
    var el = document.getElementById("chart-{{ cid }}");
    if (!el) return;
    var narrow = el.clientWidth < 500;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        return echarts.format.encodeHTML(d.names[i]) + "<br>" + d.values[i].toLocaleString("he-IL") + " חוקרים";
      } },
      grid: { left: 16, right: 40, top: 8, bottom: 16, containLabel: true },
      xAxis: { type: "value", minInterval: 1, axisLabel: { show: !narrow } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: narrow ? 90 : 140, overflow: "truncate", ellipsis: "…" } },
      series: [{ type: "bar", name: "חוקרים", data: d.values, barMaxWidth: 22, label: { show: true, position: "right" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}
{%- endfor %}
