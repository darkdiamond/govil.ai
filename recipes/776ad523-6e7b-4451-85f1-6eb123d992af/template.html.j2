      <caption class="sr-only">{{ model.labels.inst_aria }}</caption>
      <thead><tr><th scope="col">מוסד</th><th scope="col">מענקים</th><th scope="col">תקציב (מיליון ₪)</th><th scope="col">שיעור נשים</th></tr></thead>
      <tbody>
{%- for r in model.tables.institutions %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count | fmt_int }}</td><td>{{ r.budget_m | fmt_num }}</td><td>{{ r.female_share | fmt_pct }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">נשים במדע: חוקרות ומלגאיות</h2>
  </div>
  <p class="text-sm text-subtle mb-3">{{ model.labels.gender_lede }}</p>
  <div id="chart-gender-year" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.gender_year_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.gender_year_aria }}</caption>
      <thead><tr><th scope="col">שנת תקציב</th><th scope="col">זוכות</th><th scope="col">זוכים</th><th scope="col">שיעור נשים (%)</th></tr></thead>
      <tbody>
{%- for x in model.charts.gender_year.x %}
        <tr><th scope="row">{{ x }}</th><td>{{ model.charts.gender_year.female[loop.index0] | fmt_int }}</td><td>{{ model.charts.gender_year.male[loop.index0] | fmt_int }}</td><td>{{ model.charts.gender_year.share[loop.index0] | fmt_num }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-5">
    <div>
      <h3 class="m-0 mb-3 text-base font-semibold text-ink-deep">שיעור נשים לפי סוג קול קורא</h3>
      <div id="chart-gender-cat" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.gender_cat_aria }}"></div>
      <details class="mt-3">
        <summary class="text-sm text-subtle">הצג כטבלה</summary>
        <table class="mt-2 w-full text-sm">
          <caption class="sr-only">{{ model.labels.gender_cat_aria }}</caption>
          <thead><tr><th scope="col">סוג קול קורא</th><th scope="col">זוכות</th><th scope="col">סה״כ</th><th scope="col">שיעור (%)</th></tr></thead>
          <tbody>
{%- for r in model.tables.gender_cat %}
            <tr><th scope="row">{{ r.name }}</th><td>{{ r.female | fmt_int }}</td><td>{{ r.total | fmt_int }}</td><td>{{ r.share | fmt_num }}</td></tr>
{%- endfor %}
          </tbody>
        </table>
      </details>
    </div>
    <div>
      <h3 class="m-0 mb-3 text-base font-semibold text-ink-deep">שיעור נשים לפי תחום</h3>
      <div id="chart-gender-field" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.gender_field_aria }}"></div>
      <details class="mt-3">
        <summary class="text-sm text-subtle">הצג כטבלה</summary>
        <table class="mt-2 w-full text-sm">
          <caption class="sr-only">{{ model.labels.gender_field_aria }}</caption>
          <thead><tr><th scope="col">תחום</th><th scope="col">זוכות</th><th scope="col">סה״כ</th><th scope="col">שיעור (%)</th></tr></thead>
          <tbody>
{%- for r in model.tables.gender_field %}
            <tr><th scope="row">{{ r.name }}</th><td>{{ r.female | fmt_int }}</td><td>{{ r.total | fmt_int }}</td><td>{{ r.share | fmt_num }}</td></tr>
{%- endfor %}
          </tbody>
        </table>
      </details>
    </div>
  </div>
</section>

{%- if model.flags.has_intl %}
