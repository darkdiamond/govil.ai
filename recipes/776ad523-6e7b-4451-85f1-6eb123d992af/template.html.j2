<h1>קולות קוראים של משרד החדשנות, המדע והטכנולוגיה: מענקי מחקר ומלגות</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.agent_data.summary_he }}</p>
  <p class="mt-2 mb-0 text-subtle leading-relaxed">כל רשומה במאגר היא הצעת מחקר, מלגה או פרס שזכו במימון של משרד המדע (משרד החדשנות, המדע והטכנולוגיה) במסגרת קול קורא: שם הקול הקורא, המסלול, התחום, המוסד, החוקר או החוקרת, תקופת ההתקשרות והתקציב.</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור מענק מחקר לפי שם חוקר, מוסד או נושא ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: שם החוקר, כותרת המחקר, מוסד, קול קורא, תחום, תת-תחום ומדינה שותפה</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-3">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">מענקים במאגר</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.budget.tone }} mb-1" dir="ltr">{{ model.kpis.budget.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.budget_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.median.tone }} mb-1" dir="ltr">{{ model.kpis.median.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.median_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.years.tone }} mb-1" dir="ltr">{{ model.kpis.years.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.years_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.institutions.tone }} mb-1" dir="ltr">{{ model.kpis.institutions.display }}</div>
    <div class="text-sm text-subtle">מוסדות זוכים</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.researchers.tone }} mb-1" dir="ltr">{{ model.kpis.researchers.display }}</div>
    <div class="text-sm text-subtle">חוקרים וחוקרות (שמות שונים)</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.female.tone }} mb-1" dir="ltr">{{ model.kpis.female.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.female_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.active.tone }} mb-1" dir="ltr">{{ model.kpis.active.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.active_kpi }}</div>
  </div>
</div>
{%- if model.labels.non_ils_note or model.labels.bad_year_note %}
<p class="text-xs text-subtle mb-6">{{ model.labels.non_ils_note }} {{ model.labels.bad_year_note }}</p>
{%- else %}
<div class="mb-6"></div>
{%- endif %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מענקים ותקציב לפי שנת תקציב</h2>
  </div>
  <p class="text-sm text-subtle mb-3">{{ model.labels.yearly_lede }}</p>
  <div id="chart-yearly" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.yearly_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.yearly_aria }}</caption>
      <thead><tr><th scope="col">שנת תקציב</th><th scope="col">מענקים</th><th scope="col">תקציב (מיליון ₪)</th><th scope="col">מענק חציוני (אלפי ₪)</th></tr></thead>
      <tbody>
{%- for x in model.charts.yearly.x %}
        <tr><th scope="row">{{ x }}</th><td>{{ model.charts.yearly.count[loop.index0] | fmt_int }}</td><td>{{ model.charts.yearly.budget_m[loop.index0] | fmt_num }}</td><td>{{ model.charts.yearly.median_k[loop.index0] | fmt_num }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">סוגי קולות קוראים לאורך השנים</h2>
  </div>
  <p class="text-sm text-subtle mb-3">{{ model.labels.cat_lede }}</p>
  <div id="chart-cat-year" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.cat_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.cat_aria }}</caption>
      <thead><tr><th scope="col">שנת תקציב</th>{% for c in model.tables.cat_names %}<th scope="col">{{ c }}</th>{% endfor %}<th scope="col">סה״כ</th></tr></thead>
      <tbody>
{%- for r in model.tables.cat_year %}
        <tr><th scope="row">{{ r.year }}</th>{% for v in r.vals %}<td>{{ v | fmt_int }}</td>{% endfor %}<td>{{ r.total | fmt_int }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">לאן הולך התקציב: סוג קול קורא ומסלול</h2>
  </div>
  <p class="text-sm text-subtle mb-3">{{ model.labels.prog_lede }}</p>
  <div id="chart-treemap" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.prog_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.prog_aria }}</caption>
      <thead><tr><th scope="col">סוג קול קורא</th><th scope="col">מסלול</th><th scope="col">מענקים (בשקלים)</th><th scope="col">תקציב (מיליון ₪)</th></tr></thead>
      <tbody>
{%- for r in model.tables.programs %}
        <tr><th scope="row">{{ r.cat }}</th><td>{{ r.prog }}</td><td>{{ r.count | fmt_int }}</td><td>{{ r.budget_m | fmt_num }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
  <h3 class="mt-5 mb-2 text-base font-semibold text-ink-deep">גודל המענק לפי סוג קול קורא</h3>
  <div class="overflow-x-auto">
  <table class="w-full text-sm">
    <caption class="sr-only">מספר המענקים, התקציב והמענק החציוני לפי סוג קול קורא</caption>
    <thead><tr><th scope="col">סוג קול קורא</th><th scope="col">מענקים</th><th scope="col">תקציב (מיליון ₪)</th><th scope="col">מענק חציוני (אלפי ₪)</th></tr></thead>
    <tbody>
{%- for r in model.tables.cats %}
      <tr><th scope="row">{{ r.name }}</th><td>{{ r.count | fmt_int }}</td><td>{{ r.budget_m | fmt_num }}</td><td>{{ r.median_k | fmt_num }}</td></tr>
{%- endfor %}
    </tbody>
  </table>
  </div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תחומי מחקר</h2>
  </div>
  <p class="text-sm text-subtle mb-3">{{ model.labels.field_lede }}</p>
  <div id="chart-field" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.field_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.field_aria }}</caption>
      <thead><tr><th scope="col">תחום</th><th scope="col">מענקים</th><th scope="col">תקציב (מיליון ₪)</th><th scope="col">מענק חציוני (אלפי ₪)</th></tr></thead>
      <tbody>
{%- for r in model.tables.fields %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count | fmt_int }}</td><td>{{ r.budget_m | fmt_num }}</td><td>{{ r.median_k | fmt_num }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

{%- if model.flags.has_subfield %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
