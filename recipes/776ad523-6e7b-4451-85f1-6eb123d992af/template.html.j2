  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מחקרים לפי סטטוס</h2>
  </div>
  <p class="text-sm text-subtle mb-3">{{ model.labels.status_lede }}</p>
  <div id="chart-status" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.status_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.status_aria }}</caption>
      <thead><tr><th scope="col">שנת תקציב</th>{% for s in model.tables.status_names %}<th scope="col">{{ s }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for r in model.tables.status %}
        <tr><th scope="row">{{ r.year }}</th>{% for v in r.vals %}<td>{{ v | fmt_int }}</td>{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">הקולות הקוראים הגדולים</h2>
  </div>
  <p class="text-sm text-subtle mb-3">{{ model.labels.calls_lede }}</p>
  <div id="chart-calls" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.calls_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.calls_aria }}</caption>
      <thead><tr><th scope="col">קול קורא</th><th scope="col">שנת תקציב</th><th scope="col">מענקים</th><th scope="col">תקציב בשקלים (מיליון ₪)</th></tr></thead>
      <tbody>
{%- for r in model.tables.calls %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.year }}</td><td>{{ r.count | fmt_int }}</td><td>{{ r.budget_m | fmt_num }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<script>
  (function () {
    var d = {{ model.charts.yearly | tojson }};
    var c = echarts.init(document.getElementById("chart-yearly"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 48, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: [
        { type: "value", name: "מענקים", minInterval: 1 },
        { type: "value", name: "מיליון ₪", splitLine: { show: false } }
      ],
      series: [
        { type: "bar", name: "מענקים", data: d.count },
        { type: "line", name: "תקציב (מיליון ₪)", yAxisIndex: 1, data: d.budget_m, symbolSize: 8 }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.cat_year | tojson }};
    var c = echarts.init(document.getElementById("chart-cat-year"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 48, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.years },
      yAxis: { type: "value", minInterval: 1 },
      series: d.series.map(function (s) {
        return { type: "bar", stack: "t", name: s.name, data: s.data, emphasis: { focus: "series" } };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var t = {{ model.charts.treemap | tojson }};
    var c = echarts.init(document.getElementById("chart-treemap"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { formatter: function (p) { return echarts.format.encodeHTML(p.name) + ": " + p.value.toLocaleString("he-IL") + " מיליון ₪"; } },
      series: [{ type: "treemap", data: t, roam: false, nodeClick: false,
                 breadcrumb: { show: false }, width: "100%", height: "100%",
                 upperLabel: { show: true, height: 22, color: "#fff" },
                 label: { show: true, formatter: "{b}\n{c}", overflow: "truncate" },
                 levels: [
                   { colorMappingBy: "index", itemStyle: { borderColor: "#fff", borderWidth: 3, gapWidth: 3 } },
                   { colorSaturation: [0.35, 0.6], itemStyle: { borderColorSaturation: 0.7, gapWidth: 1, borderWidth: 1 } }
                 ] }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.field | tojson }};
    var c = echarts.init(document.getElementById("chart-field"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0 },
      grid: { left: 16, right: 24, top: 40, bottom: 8, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 130, overflow: "truncate" } },
      series: [
        { type: "bar", name: "תקציב (מיליון ₪)", data: d.budget_m.slice().reverse() },
        { type: "bar", name: "מענק חציוני (אלפי ₪)", data: d.median_k.slice().reverse() }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
{%- if model.flags.has_subfield %}
  (function () {
    var d = {{ model.charts.subfield | tojson }};
    var c = echarts.init(document.getElementById("chart-subfield"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 24, top: 16, bottom: 8, containLabel: true },
      xAxis: { type: "value", minInterval: 1 },
      yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 140, overflow: "truncate" } },
      series: [{ type: "bar", name: "מענקים", data: d.count.slice().reverse() }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
{%- endif %}
  (function () {
    var d = {{ model.charts.inst | tojson }};
    var c = echarts.init(document.getElementById("chart-inst"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0 },
      grid: { left: 16, right: 24, top: 40, bottom: 8, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 140, overflow: "truncate" } },
      series: [
        { type: "bar", name: "מענקים", data: d.count.slice().reverse() },
        { type: "bar", name: "תקציב (מיליון ₪)", data: d.budget_m.slice().reverse() }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.gender_year | tojson }};
    var c = echarts.init(document.getElementById("chart-gender-year"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 48, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: [
        { type: "value", name: "זוכים", minInterval: 1 },
        { type: "value", name: "%", min: 0, max: 100, splitLine: { show: false } }
      ],
      series: [
        { type: "bar", stack: "g", name: "זוכות", data: d.female },
        { type: "bar", stack: "g", name: "זוכים", data: d.male },
        { type: "line", name: "שיעור נשים (%)", yAxisIndex: 1, data: d.share, symbolSize: 8 }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.gender_cat | tojson }};
    var c = echarts.init(document.getElementById("chart-gender-cat"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 24, top: 16, bottom: 8, containLabel: true },
      xAxis: { type: "value", min: 0, max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 120, overflow: "truncate" } },
      series: [{ type: "bar", name: "שיעור נשים (%)", data: d.share.slice().reverse() }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.gender_field | tojson }};
    var c = echarts.init(document.getElementById("chart-gender-field"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 24, top: 16, bottom: 8, containLabel: true },
      xAxis: { type: "value", min: 0, max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 120, overflow: "truncate" } },
      series: [{ type: "bar", name: "שיעור נשים (%)", data: d.share.slice().reverse() }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
{%- if model.flags.has_intl %}
  (function () {
    var d = {{ model.charts.country | tojson }};
    var c = echarts.init(document.getElementById("chart-country"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 24, top: 16, bottom: 8, containLabel: true },
      xAxis: { type: "value", minInterval: 1 },
      yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 110, overflow: "truncate" } },
      series: [{ type: "bar", name: "מענקים", data: d.count.slice().reverse() }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.intl_share | tojson }};
    var c = echarts.init(document.getElementById("chart-intl-share"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 16, right: 16, top: 24, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", min: 0, axisLabel: { formatter: "{value}%" } },
      series: [{ type: "line", name: "שיעור בינלאומי (%)", data: d.share, symbolSize: 8, areaStyle: { opacity: 0.15 } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
{%- endif %}
  (function () {
    var d = {{ model.charts.size | tojson }};
    var c = echarts.init(document.getElementById("chart-size"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 16, top: 24, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.labels, axisLabel: { interval: 0, rotate: 30 } },
      yAxis: { type: "value", minInterval: 1 },
      series: [{ type: "bar", name: "מענקים", data: d.count }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.duration | tojson }};
    var c = echarts.init(document.getElementById("chart-duration"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 16, top: 24, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.labels },
      yAxis: { type: "value", minInterval: 1 },
      series: [{ type: "bar", name: "מענקים", data: d.count }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.status | tojson }};
    var c = echarts.init(document.getElementById("chart-status"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.years },
      yAxis: { type: "value", minInterval: 1 },
      series: d.series.map(function (s) {
        return { type: "bar", stack: "s", name: s.name, data: s.data };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.calls | tojson }};
    var c = echarts.init(document.getElementById("chart-calls"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 24, top: 16, bottom: 8, containLabel: true },
      xAxis: { type: "value", minInterval: 1 },
      yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 150, overflow: "truncate" } },
      series: [{ type: "bar", name: "מענקים", data: d.count.slice().reverse() }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
