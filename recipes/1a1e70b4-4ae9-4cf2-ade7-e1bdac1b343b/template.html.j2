<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">יהלומנים</p>
</section>

<script>
  (function () {
    function stackBars(id, d, opts) {
      var c = echarts.init(document.getElementById(id));
      var pctMode = opts && opts.pct;
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                   valueFormatter: function (v) { return pctMode ? v + "%" : Number(v).toLocaleString("he-IL"); } },
        legend: { bottom: 0 },
        grid: { left: 16, right: 24, top: 16, bottom: 64, containLabel: true },
        xAxis: { type: "value", max: pctMode ? 100 : null, splitNumber: 4,
                 axisLabel: { hideOverlap: true, formatter: pctMode ? "{value}%" : null } },
        yAxis: { type: "category", data: d.names, inverse: true,
                 axisLabel: { width: 110, overflow: "break" } },
        series: d.series.map(function (s) {
          var o = { type: "bar", stack: "total", name: s.name, data: s.data };
          if (s.color) { o.itemStyle = { color: s.color }; }
          return o;
        })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }

    var s = {{ model.charts.status | tojson }};
    var c1 = echarts.init(document.getElementById("chart-status"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        return p.name + ": " + p.value.toLocaleString("he-IL") + " (" + p.percent + "%)";
      } },
      legend: { bottom: 0 },
      series: [{
        type: "pie", radius: ["42%", "68%"], center: ["50%", "44%"],
        label: { show: false },
        data: s.names.map(function (nm, i) {
          var o = { name: nm, value: s.values[i] };
          if (s.colors[i]) { o.itemStyle = { color: s.colors[i] }; }
          return o;
        })
      }]
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    var r = {{ model.charts.rate | tojson }};
    var lowest = Math.min.apply(null, r.values);
    var c2 = echarts.init(document.getElementById("chart-rate"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      grid: { left: 16, right: 48, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: r.names },
      yAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
      series: [{
        type: "bar", name: "שיעור פעילים", barMaxWidth: 56,
        label: { show: true, position: "top", formatter: "{c}%" },
        data: r.values.map(function (v) {
          return v === lowest ? { value: v, itemStyle: { color: "#9a6700" } } : v;
        }),
        markLine: { symbol: "none", silent: true, data: [{ yAxis: r.overall }],
                    lineStyle: { type: "dashed", color: "#0b3668" },
                    label: { formatter: "{c}%", position: "end" } }
      }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });

    stackBars("chart-type", {{ model.charts.type | tojson }});
  })();
</script>

<script>
  (function () {
    var m = {{ model.charts.mix | tojson }};
    var c = echarts.init(document.getElementById("chart-mix"));
    c.setOption(window.GovEcharts.option({
      color: ["#0068f5", "#198754", "#6c757d"],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                 valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: m.names },
      yAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
      series: m.series.map(function (s) {
        return { type: "bar", name: s.name, data: s.data, barMaxWidth: 32 };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });

    function pctStack(id, d, colors) {
      var x = echarts.init(document.getElementById(id));
      x.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                   valueFormatter: function (v) { return v + "%"; } },
        legend: { bottom: 0 },
        grid: { left: 16, right: 24, top: 16, bottom: 72, containLabel: true },
        xAxis: { type: "value", max: 100, interval: 25, axisLabel: { formatter: "{value}%" } },
        yAxis: { type: "category", data: d.names, inverse: true,
                 axisLabel: { width: 110, overflow: "break" } },
        series: d.series.map(function (s) {
          var o = { type: "bar", stack: "total", name: s.name, data: s.data };
          if (s.color) { o.itemStyle = { color: s.color }; }
          return o;
        })
      }));
      window.addEventListener("resize", function () { x.resize(); });
    }
    pctStack("chart-form", {{ model.charts.form | tojson }});
    pctStack("chart-formtype", {{ model.charts.formtype | tojson }});
  })();
</script>

{% if model.flags.words %}
