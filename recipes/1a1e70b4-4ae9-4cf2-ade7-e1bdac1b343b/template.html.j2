{% if model.flags.years %}
<script>
  (function () {
    var y = {{ model.charts.years | tojson }};
    var c = echarts.init(document.getElementById("chart-years"));
    var series = y.series.map(function (s) {
      var o = { type: "bar", stack: "total", name: s.name, data: s.data };
      if (s.color) { o.itemStyle = { color: s.color }; }
      return o;
    });
    series.push({ type: "line", name: "שיעור פעילים", yAxisIndex: 1, data: y.rate,
                  itemStyle: { color: "#0b3668" }, lineStyle: { width: 2 },
                  tooltip: { valueFormatter: function (v) { return v + "%"; } } });
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: y.x, axisLabel: { interval: 0, fontSize: 10, hideOverlap: true } },
      yAxis: [{ type: "value", name: "חברות" },
              { type: "value", name: "פעילים", max: 100, axisLabel: { formatter: "{value}%" },
                splitLine: { show: false } }],
      series: series
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{% endif %}
