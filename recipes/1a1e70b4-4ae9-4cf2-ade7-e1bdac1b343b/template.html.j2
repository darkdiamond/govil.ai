    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.rate_caption }}</caption>
        <thead><tr><th scope="col">סוג רישיון</th><th scope="col">רישיונות</th><th scope="col">שיעור פעילים</th></tr></thead>
        <tbody>
{%- for r in model.tables.rate %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.rate }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

