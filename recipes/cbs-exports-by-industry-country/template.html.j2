{% import "gov.j2" as gov %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסמה {{ model.release.date }}</p>
{%- if model.release.headline %}
  <p class="m-0 mb-3 font-semibold text-ink-deep">{{ model.release.headline }}</p>
{%- endif %}
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["total", "yoy", "since_base", "lead", "top_share"] %}
{%- if model.kpis[key] is defined %}
  {{ gov.kpi(model.kpis[key], model.labels[key ~ "_kpi"]) }}
{%- endif %}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

<section class="card p-5 mb-6">
  {{ gov.head("trending-up", "יצוא הסחורות לפי שנה ויבשת יעד") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.trend_note }}</p>
  {{ gov.chart("chart-trend", model.labels.trend_aria, "h-72 md:h-96") }}
  {{ gov.table("יצוא סחורות לפי שנה ויבשת יעד (מיליוני דולרים)", model.labels.trend_cols, model.tables.trend, ltr=range(1, model.labels.trend_cols | length) | list) }}
</section>

{%- if model.flags.dest %}
<section class="card p-5 mb-6">
  {{ gov.head("map-pin", "לאן מייצאים: יבשות ויעדים מרכזיים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.dest_note }}</p>
  {{ gov.chart("chart-dest", model.labels.dest_aria, "h-80 md:h-[420px]") }}
  {{ gov.table("יצוא סחורות לפי יעד (מיליוני דולרים)", model.labels.dest_cols, model.tables.dest, ltr=range(1, model.labels.dest_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.index %}
<section class="card p-5 mb-6">
  {{ gov.head("chart-bar", "שינוי ערך היצוא לכל יעד לאורך זמן") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.index_note }}</p>
  {{ gov.chart("chart-index", model.labels.index_aria, "h-72 md:h-80") }}
  {{ gov.table("מדד ערך היצוא לפי יעד", model.labels.index_cols, model.tables.index, ltr=(1, 2)) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("building-2", "מה מייצאים: הענפים הגדולים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.ind_note }}</p>
  {{ gov.chart("chart-ind", model.labels.ind_aria, "h-[520px]") }}
  {{ gov.table("יצוא סחורות לפי ענף כלכלי", ["ענף", "מיליוני דולרים", "חלק מהיצוא"], model.tables.ind, ltr=(1, 2)) }}
</section>

{%- if model.flags.heat %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "כל ענף לאן: יצוא לפי ענף ויבשת יעד") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.heat_note }}</p>
  {{ gov.chart("chart-heat", model.labels.heat_aria, "h-[480px] md:h-[520px]") }}
  {{ gov.table("יצוא לפי ענף ויבשת יעד: מיליוני דולרים (חלק מיצוא הענף)", model.labels.heat_cols, model.tables.heat, ltr=range(1, model.labels.heat_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.mix %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "מה קונה כל יעד") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.mix_note }}</p>
  {{ gov.chart("chart-mix", model.labels.mix_aria, "h-[460px]") }}
  {{ gov.table("הרכב היצוא לכל יעד לפי ענף (אחוזים)", model.labels.mix_cols, model.tables.mix, ltr=range(1, model.labels.mix_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.chg %}
<section class="card p-5 mb-6">
  {{ gov.head("trending-up", "אילו ענפים צמחו ואילו התכווצו") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.chg_note }}</p>
  {{ gov.chart("chart-chg", model.labels.chg_aria, "h-[480px]") }}
  {{ gov.table("שינוי היצוא לפי ענף (מיליוני דולרים)", model.labels.chg_cols, model.tables.chg, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

{%- if model.flags.share %}
<section class="card p-5 mb-6">
  {{ gov.head("chart-bar", "חלקם של הענפים הגדולים לאורך השנים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.share_note }}</p>
  {{ gov.chart("chart-share", model.labels.share_aria, "h-72 md:h-96") }}
  {{ gov.table("חלק הענפים המובילים מהיצוא (אחוזים)", model.labels.share_cols, model.tables.share, ltr=range(1, model.labels.share_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.subs %}
<section class="card p-5 mb-6">
  {{ gov.head("map-pin", "האיחוד האירופי, ארצות הברית וסין בתוך היבשות") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.subs_note }}</p>
  {{ gov.chart("chart-subs", model.labels.subs_aria, "h-64 md:h-80") }}
  {{ gov.table("חלק היעד הגדול מהיצוא ליבשתו (אחוזים)", model.labels.subs_cols, model.tables.subs, ltr=range(1, model.labels.subs_cols | length) | list) }}
</section>
{%- endif %}

<script>
  (function () {
    const d = {{ model.charts.trend | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-trend"));
    const series = d.names.map((nm, k) => ({ type: "bar", stack: "t", name: nm, data: d.series[k] }));
    series.push({ type: "line", name: "סך הכל", data: d.total, symbolSize: 8, lineStyle: { width: 0 }, itemStyle: { color: pal[9] },
                  label: { show: true, position: "top", formatter: (p) => p.value == null ? "" : Number(p.value).toFixed(1) } });
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1], pal[2], pal[6]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + " מיליארד $" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 48, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: "{value}" } },
      series: series
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- if model.flags.dest %}
  (function () {
    const d = {{ model.charts.dest | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-dest"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[6], pal[0]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + " מיליארד $" },
      legend: { top: 0 },
      grid: { left: 16, right: 40, top: 32, bottom: 8, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 110, overflow: "break" } },
      series: [
        { type: "bar", name: d.years[0], data: d.first },
        { type: "bar", name: d.years[1], data: d.last, label: { show: true, position: "right", fontSize: 11, formatter: (p) => p.value == null ? "" : Number(p.value).toFixed(1) } }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.index %}
  (function () {
    const d = {{ model.charts.index | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-index"));
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : (v > 0 ? "+" : v < 0 ? "−" : "") + Math.abs(v).toFixed(1) + "%" },
      grid: { left: 16, right: 48, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 110, overflow: "break" } },
      series: [{
        type: "bar",
        data: d.values.map((v, i) => ({ value: v, itemStyle: { color: i >= 0 && d.names[i] === "סך כל היצוא" ? pal[1] : (v < 0 ? "#dc3545" : pal[0]) } })),
        label: { show: true, position: "right", fontSize: 11, formatter: (p) => "\u200e" + (p.value > 0 ? "+" : p.value < 0 ? "−" : "") + Math.abs(p.value).toFixed(0) + "%" }
      }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
  (function () {
    const d = {{ model.charts.ind | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-ind"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Math.round(v).toLocaleString("he-IL") + " מיליון $" },
      grid: { left: 16, right: 56, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: (v) => (v / 1000).toLocaleString("he-IL") + " מיליארד" } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 130, overflow: "break", fontSize: 11 } },
      series: [{ type: "bar", data: d.values, label: { show: true, position: "right", fontSize: 11, formatter: (p) => Math.round(p.value).toLocaleString("he-IL") } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- if model.flags.heat %}
  (function () {
    const d = {{ model.charts.heat | tojson }};
    const enc = echarts.format.encodeHTML;
    const chart = echarts.init(document.getElementById("chart-heat"));
    chart.setOption(window.GovEcharts.option({
      tooltip: { formatter: (p) => enc(d.y[p.value[1]]) + "<br>" + enc(d.x[p.value[0]]) + ": " + Number(p.value[2]).toFixed(1) + "% (" + Math.round(p.value[3]).toLocaleString("he-IL") + " מיליון $)" },
      grid: { left: 8, right: 8, top: 28, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: d.x, position: "top", splitArea: { show: true }, axisLabel: { interval: 0, fontSize: 11 } },
      yAxis: { type: "category", data: d.y, inverse: true, splitArea: { show: true }, axisLabel: { interval: 0, width: 125, overflow: "truncate", fontSize: 11 } },
      visualMap: { min: 0, max: 100, dimension: 2, calculable: false, orient: "horizontal", left: "center", bottom: 0, itemHeight: 120,
                   text: ["100%", "0%"], inRange: { color: ["#f1f7ff", "#6c9fd8", "#0b3668"] } },
      series: [{ type: "heatmap", data: d.cells,
                 label: { show: true, fontSize: 11, formatter: (p) => Math.round(p.value[2]) + "%" },
                 emphasis: { itemStyle: { borderColor: "#0c3058", borderWidth: 1 } } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.mix %}
  (function () {
    const d = {{ model.charts.mix | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-mix"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1], pal[2], pal[3], pal[5], pal[6], "#c3cfe7"],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      legend: { top: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 40, bottom: 8, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 100, overflow: "break" } },
      series: d.inds.map((nm, k) => ({ type: "bar", stack: "m", name: nm, data: d.series[k] }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.chg %}
  (function () {
    const d = {{ model.charts.chg | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-chg"));
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : (v > 0 ? "+" : v < 0 ? "−" : "") + Math.abs(v).toFixed(1) + "%" },
      grid: { left: 16, right: 48, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, axisLabel: { interval: 0, width: 130, overflow: "truncate", fontSize: 11 } },
      series: [{
        type: "bar",
        data: d.values.map((v) => ({ value: v, itemStyle: { color: v < 0 ? "#dc3545" : "#198754" } })),
        label: { show: true, position: "right", fontSize: 11, formatter: (p) => "\u200e" + (p.value > 0 ? "+" : p.value < 0 ? "−" : "") + Math.abs(p.value).toFixed(0) + "%" }
      }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.share %}
  (function () {
    const d = {{ model.charts.share | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-share"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1], pal[2], pal[3], pal[6]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      legend: { top: 0, type: "scroll" },
      grid: { left: 16, right: 24, top: 40, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
      series: d.names.map((nm, k) => ({ type: "line", name: nm, data: d.series[k], symbolSize: 7 }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.subs %}
  (function () {
    const d = {{ model.charts.subs | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-subs"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1], pal[2]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      legend: { top: 0, type: "scroll" },
      grid: { left: 16, right: 24, top: 40, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      series: d.names.map((nm, k) => ({ type: "line", name: nm, data: d.series[k], symbolSize: 7 }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
</script>
