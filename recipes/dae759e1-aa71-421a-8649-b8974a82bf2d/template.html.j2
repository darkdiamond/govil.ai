{%- macro fallback(tbl, cap) %}
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ cap }}</caption>
      <thead><tr>{% for h_ in tbl.headers %}<th scope="col">{{ h_ }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for r in tbl.rows %}
        <tr>{% for c in r %}{% if loop.first %}<th scope="row">{{ c }}</th>{% else %}<td>{{ c }}</td>{% endif %}{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
{%- endmacro %}
{%- macro chart_section(cid, icon, title, note, aria, cap, tbl, h="h-64 md:h-80") %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/{{ icon }}.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ title }}</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ note }}</p>
  <div id="{{ cid }}" class="{{ h }}" role="img" aria-label="{{ aria }}"></div>
{{ fallback(tbl, cap) }}
</section>
{%- endmacro %}
<h1>בתי כנסת בבאר שבע</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור בית כנסת לפי שם, שכונה או רחוב ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: שם בית הכנסת, שם נוסף, שכונה, רחוב ומספר בית.</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
{%- for key in ["sites", "neigh", "shelter", "nn"] %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.kpis[key].label }}</div>
  </div>
{%- endfor %}
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מפת בתי הכנסת</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.map_note }}</p>
  <div id="map-syn" class="h-72 md:h-[420px]"></div>
</section>

{{ chart_section("chart-neigh", "map-pin", "בתי כנסת לפי שכונה", model.labels.neigh_note, model.labels.neigh_aria, model.labels.neigh_cap, model.tables.neigh, "h-80 md:h-[460px]") }}

{{ chart_section("chart-type", "list", "סוגי האתרים", model.labels.type_note, model.labels.type_aria, model.labels.type_cap, model.tables.type) }}

{{ chart_section("chart-shelter", "map-pin", "בתי כנסת במקלטים, לפי שכונה", model.labels.shelter_note, model.labels.shelter_aria, model.labels.shelter_cap, model.tables.shelter, "h-80 md:h-[460px]") }}

{% if model.flags.nn %}
{{ chart_section("chart-nn", "map-pin", "המרחק לבית הכנסת הקרוב", model.labels.nn_note, model.labels.nn_aria, model.labels.nn_cap, model.tables.nn) }}
{% endif %}

{% if model.flags.streets %}
{{ chart_section("chart-streets", "list", "רחובות עם כמה בתי כנסת", model.labels.streets_note, model.labels.streets_aria, model.labels.streets_cap, model.tables.streets, "h-72 md:h-96") }}
{% endif %}

{{ chart_section("chart-names", "list", "שם ראשי ושם נוסף", model.labels.names_note, model.labels.names_aria, model.labels.names_cap, model.tables.names) }}

{{ chart_section("chart-addr", "list", "פירוט הכתובות", model.labels.addr_note, model.labels.addr_aria, model.labels.addr_cap, model.tables.addr) }}

<script>
  GovMap.create({
    container: "#map-syn",
    resourceId: {{ inputs.syn[0].id | tojson }},
    latField: "lat",
    lngField: "lon",
    projection: "wgs84",
    cluster: true,
    popupTitleField: "name",
    popupFields: [
      { field: "OtherName", label: "שם נוסף" },
      { field: "neighborho", label: "שכונה" },
      { field: "street", label: "רחוב" },
      { field: "HouseNumbe", label: "מספר בית" }
    ]
  });
</script>

<script>
  (function () {
    function mk(id) {
      var el = document.getElementById(id);
      if (!el) { return null; }
      var c = echarts.init(el);
      window.addEventListener("resize", function () { c.resize(); });
      return c;
    }
    window.__syn_mk = mk;
    window.__syn_vbar = function (id, d, unit) {
      var c = mk(id); if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 16, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, fontSize: 11, rotate: window.innerWidth < 500 ? 35 : 0 } },
        yAxis: { type: "value", minInterval: 1 },
        series: [{ type: "bar", name: unit, data: d.values }]
      }));
    };
    window.__syn_hbar = function (id, d, unit) {
      var c = mk(id); if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value", minInterval: 1 },
        yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 120, overflow: "truncate" } },
        series: [{ type: "bar", name: unit, data: d.values.slice().reverse() }]
      }));
    };
  })();
</script>

<script>
  (function () {
    window.__syn_hbar("chart-neigh", {{ model.charts.neigh | tojson }}, "אתרים");
    window.__syn_vbar("chart-type", {{ model.charts.type | tojson }}, "אתרים");
    window.__syn_vbar("chart-names", {{ model.charts.names | tojson }}, "אתרים");
    window.__syn_vbar("chart-addr", {{ model.charts.addr | tojson }}, "אתרים");
  })();
</script>

{% if model.flags.nn %}
<script>
  (function () {
    window.__syn_vbar("chart-nn", {{ model.charts.nn | tojson }}, "נקודות");
  })();
</script>
{% endif %}

{% if model.flags.streets %}
<script>
  (function () {
    window.__syn_hbar("chart-streets", {{ model.charts.streets | tojson }}, "אתרים");
  })();
</script>
{% endif %}

<script>
  (function () {
    var S = {{ model.charts.shelter | tojson }};
    var c = window.__syn_mk("chart-shelter");
    if (!c) { return; }
    var P = window.GOVIL_PALETTE;
    c.setOption(window.GovEcharts.option({
      color: [P[0], P[5]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0 },
      grid: { left: 8, right: 24, top: 32, bottom: 24, containLabel: true },
      xAxis: { type: "value", minInterval: 1 },
      yAxis: { type: "category", data: S.names.slice().reverse(), axisLabel: { width: 120, overflow: "truncate" } },
      series: [
        { type: "bar", stack: "s", name: "במקלט", data: S.shelter.slice().reverse() },
        { type: "bar", stack: "s", name: "אתרים אחרים", data: S.other.slice().reverse() }
      ]
    }));
  })();
</script>
