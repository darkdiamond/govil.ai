      <tbody>
{%- for r in model.tables.top %}
        <tr><th scope="row" class="px-2">{{ r.name }}</th><td class="px-2">{{ r.type }}</td><td class="px-2">{{ r.place }}</td><td class="px-2">{{ r.acts }}</td><td class="px-2">{{ r.fams }}</td></tr>
{%- endfor %}
