<script>
  (function () {
    var t = {{ model.charts.types | tojson }};
    var ct = echarts.init(document.getElementById("chart-types"));
    ct.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 40, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: t.names, inverse: true,
               axisLabel: { width: 110, overflow: "truncate" } },
      series: [{ type: "bar", name: "עסקים", data: t.biz },
               { type: "bar", name: "רישומי פעילות", data: t.lic }]
    }));
    window.addEventListener("resize", function () { ct.resize(); });

    var b = {{ model.charts.breadth | tojson }};
    var cb = echarts.init(document.getElementById("chart-breadth"));
    cb.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 40, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: b.x, name: "פעילויות" },
      yAxis: { type: "value", name: "עסקים" },
      series: [{ type: "bar", name: "עסקים", data: b.y }]
    }));
    window.addEventListener("resize", function () { cb.resize(); });
  })();
</script>

<script>
  (function () {
    var a = {{ model.charts.activities | tojson }};
    var fams = {{ model.charts.family_order | tojson }};
    var pal = window.GOVIL_PALETTE;
    var el = document.getElementById("chart-activities");
    var c = echarts.init(el);
    var lw = Math.min(240, Math.round(el.clientWidth * 0.45));
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "item", formatter: function (p) {
        return p.name + "<br>" + echarts.format.encodeHTML(a.families[p.dataIndex]) + "<br>" + p.value.toLocaleString("he-IL") + " עסקים";
      } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: a.names, inverse: true,
               axisLabel: { width: lw, overflow: "truncate" } },
      series: [{ type: "bar", name: "עסקים", data: a.values.map(function (v, i) {
        var k = fams.indexOf(a.families[i]);
        return { value: v, itemStyle: { color: pal[(k < 0 ? 0 : k) % pal.length] } };
      }) }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var t = {{ model.charts.families | tojson }};
    var c = echarts.init(document.getElementById("chart-families"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        return p.name + ": " + p.value.toLocaleString("he-IL") + " רישומים";
      } },
      series: [{
        type: "sunburst", data: t, radius: ["12%", "92%"], sort: null,
        nodeClick: "rootToNode",
        itemStyle: { borderColor: "#fff", borderWidth: 1 },
        levels: [{},
                 { r0: "12%", r: "50%", label: { rotate: 0, fontSize: 10, width: 84, overflow: "truncate", minAngle: 18 } },
                 { r0: "50%", r: "92%", label: { rotate: "radial", fontSize: 9, width: 70, overflow: "truncate", minAngle: 7 } }]
      }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    function stacked(id, d) {
      var el = document.getElementById(id);
      if (!el) return;
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { bottom: 0 },
        grid: { left: 16, right: 24, top: 16, bottom: 56, containLabel: true },
        xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true,
                 axisLabel: { width: Math.min(150, Math.round(el.clientWidth * 0.4)), overflow: "truncate" } },
        series: d.series.map(function (s) { return { type: "bar", stack: "t", name: s.name, data: s.data }; })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    stacked("chart-parts", {{ model.charts.parts | tojson }});
    stacked("chart-districts", {{ model.charts.districts | tojson }});
    stacked("chart-settlements", {{ model.charts.settlements | tojson }});
  })();
</script>

<script>
  (function () {
    var el = document.getElementById("chart-used");
    if (!el) return;
    var u = {{ model.charts.used | tojson }};
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        return echarts.format.encodeHTML(u.names[i]) + ": " + u.values[i] + "%<br>" + u.counts[i].toLocaleString("he-IL") +
          " מתוך " + u.totals[i].toLocaleString("he-IL") + " עסקי חלקים";
      } },
      grid: { left: 16, right: 24, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: u.names, inverse: true },
      series: [{ type: "bar", name: "שיעור עם חלקים משומשים", data: u.values,
                 markLine: { symbol: "none", silent: true, label: { show: false },
                             lineStyle: { type: "dashed", color: "#6c757d" },
                             data: [{ xAxis: u.national }] } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    function heat(id, h, unit) {
      var el = document.getElementById(id);
      if (!el) return;
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option({
        tooltip: { position: "top", formatter: function (p) {
          return echarts.format.encodeHTML(h.y[p.value[1]]) + " · " + echarts.format.encodeHTML(h.x[p.value[0]]) + ": " + p.value[2] + "% (" +
            p.value[3].toLocaleString("he-IL") + " " + unit + ")";
        } },
        grid: { left: 16, right: 16, top: 16, bottom: 64, containLabel: true },
        xAxis: { type: "category", data: h.x, splitArea: { show: true },
                 axisLabel: { interval: 0, rotate: 45, width: 90, overflow: "truncate", fontSize: 10 } },
        yAxis: { type: "category", data: h.y, inverse: true, splitArea: { show: true },
                 axisLabel: { width: Math.min(160, Math.round(el.clientWidth * 0.3)), overflow: "truncate", fontSize: 11 } },
        visualMap: {
          min: 0, max: h.max, dimension: 2, calculable: true,
          orient: "horizontal", left: "center", bottom: 0, itemHeight: 120,
          inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
          textStyle: { fontFamily: "Rubik", color: "#0c3058" }
        },
        series: [{ type: "heatmap", data: h.cells,
                   emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    heat("chart-heat", {{ model.charts.heat | tojson }}, "עסקים");
    heat("chart-cooc", {{ model.charts.cooc | tojson }}, "עסקים");
  })();
</script>
