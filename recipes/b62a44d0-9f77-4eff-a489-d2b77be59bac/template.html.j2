      yAxis: { type: "value" },
      series: [{ type: "bar", name: "עבירות להפניה", data: d.values.map(function (v, i) {
        return i === 0 ? { value: v, itemStyle: { color: "#0b3668" } } : v;
      }) }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
