  </div>
  <p class="m-0 text-sm text-subtle leading-relaxed">שירות המבחן לנוער הוא שירות טיפולי-סוציאלי סמכותי הפועל כשירות ארצי במינהל של"מ (שיקום, ליווי ומניעה) במשרד הרווחה והביטחון החברתי, על פי חוק הנוער (שפיטה, ענישה ודרכי טיפול). המאגר כולל מידע מצרפי על הפניות לשירות, על העבירות שיוחסו בהן ועל ההחלטות שהתקבלו בדיונים בבתי המשפט לנוער, לפי מחוז ויישוב.</p>
</section>

<script>
  (function () {
    var d = {{ model.charts.years | tojson }};
    var c = echarts.init(document.getElementById("chart-years"));
    function fmt(v) { return v === null || v === undefined ? "" : v.toLocaleString("he-IL"); }
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex;
        var s = d.x[i];
        if (d.ref_lo[i] !== null) { s += "<br/>הפניות: " + fmt(d.ref_lo[i]) + (d.ref_band[i] ? " עד " + fmt(d.ref_lo[i] + d.ref_band[i]) : ""); }
        if (d.off_lo[i] !== null) { s += "<br/>עבירות: " + fmt(d.off_lo[i]) + (d.off_band[i] ? " עד " + fmt(d.off_lo[i] + d.off_band[i]) : ""); }
        return s;
      } },
      legend: { bottom: 0, data: ["הפניות", "עבירות"] },
      grid: { left: 48, right: 16, top: 24, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value" },
      series: [
        { type: "bar", name: "הפניות", stack: "r", data: d.ref_lo, itemStyle: { color: "#0068f5" } },
        { type: "bar", name: "הפניות: טווח אפשרי", stack: "r", data: d.ref_band, itemStyle: { color: "rgba(0,104,245,0.25)" } },
        { type: "bar", name: "עבירות", stack: "o", data: d.off_lo, itemStyle: { color: "#0b3668" } },
        { type: "bar", name: "עבירות: טווח אפשרי", stack: "o", data: d.off_band, itemStyle: { color: "rgba(11,54,104,0.25)" } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.groups | tojson }};
    var c = echarts.init(document.getElementById("chart-groups"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex;
        var lo = d.lo[i], hi = d.lo[i] + d.band[i];
        return echarts.format.encodeHTML(d.names[i]) + ": " + lo.toLocaleString("he-IL") + (hi > lo ? " עד " + hi.toLocaleString("he-IL") : "") + " הפניות";
      } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 3 },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 110, overflow: "truncate" } },
      series: [
        { type: "bar", name: "הפניות", stack: "g", data: d.lo, itemStyle: { color: "#0068f5" } },
        { type: "bar", name: "טווח אפשרי", stack: "g", data: d.band, itemStyle: { color: "rgba(0,104,245,0.25)" } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

