<script>
  (function () {
    var t = {{ model.charts.tree | tojson }};
    var c = echarts.init(document.getElementById("chart-tree"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      legend: { show: false },
      tooltip: { formatter: function (p) { return echarts.format.encodeHTML(p.name) + ": " + Number(p.value).toLocaleString("he-IL") + " שורות הצהרה"; } },
      series: [{
        type: "treemap", name: "כל הספר", data: t, leafDepth: 1, roam: false,
        top: 8, left: 8, right: 8, bottom: 40,
        breadcrumb: { bottom: 4, itemStyle: { color: "#0068f5" } },
        label: { fontFamily: "Rubik", overflow: "truncate" },
        upperLabel: { show: true, height: 22, fontFamily: "Rubik", color: "#ffffff" },
        levels: [
          { itemStyle: { borderColor: "#ffffff", borderWidth: 2, gapWidth: 2 } },
          { colorSaturation: [0.35, 0.6], itemStyle: { borderColorSaturation: 0.7, gapWidth: 1, borderWidth: 1 } }
        ]
      }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    function hbar(id, d, name, w) {
      var x = echarts.init(document.getElementById(id));
      x.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 3 },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: w, overflow: "truncate" } },
        series: [{ type: "bar", name: name, data: d.values }]
      }));
      window.addEventListener("resize", function () { x.resize(); });
    }
    hbar("chart-levels", {{ model.charts.levels | tojson }}, "שורות", 130);
    hbar("chart-fan", {{ model.charts.fan | tojson }}, "פרטים", 90);
  })();
</script>

<script>
  (function () {
    var a = {{ model.charts.chapters | tojson }};
    var c = echarts.init(document.getElementById("chart-chapters"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0, type: "scroll" },
      grid: { left: 16, right: 24, top: 16, bottom: 56, containLabel: true },
      xAxis: { type: "value", splitNumber: 3 },
      yAxis: { type: "category", data: a.names, inverse: true, axisLabel: { width: 140, overflow: "truncate", fontSize: 11 } },
      series: a.series.map(function (q) { return { type: "bar", stack: "t", name: q.name, data: q.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });

    function pctStack(id, d) {
      var x = echarts.init(document.getElementById(id));
      x.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
          var i = ps[0].dataIndex, out = echarts.format.encodeHTML(d.names[i]);
          ps.forEach(function (p) {
            var s = d.series[p.seriesIndex];
            out += "<br>" + p.marker + echarts.format.encodeHTML(s.name) + ": " + s.data[i] + "% (" + Number(s.counts[i]).toLocaleString("he-IL") + ")";
          });
          return out;
        } },
        legend: { bottom: 0, type: "scroll" },
        grid: { left: 16, right: 24, top: 16, bottom: 56, containLabel: true },
        xAxis: { type: "value", max: 100, splitNumber: 4, axisLabel: { formatter: "{value}%" } },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { interval: 0, width: 140, overflow: "truncate", fontSize: 11 } },
        series: d.series.map(function (q) { return { type: "bar", stack: "t", name: q.name, data: q.data }; })
      }));
      window.addEventListener("resize", function () { x.resize(); });
    }
    pctStack("chart-decl", {{ model.charts.decl | tojson }});
    pctStack("chart-usec", {{ model.charts.usec | tojson }});
  })();
</script>

