{% import "gov.j2" as gov %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסמה {{ model.release.date }}</p>
{%- if model.release.headline %}
  <p class="m-0 mb-3 font-semibold text-ink-deep">{{ model.release.headline }}</p>
{%- endif %}
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["rev", "revchg", "profit", "margin", "wages"] %}
{%- if model.kpis[key] is defined %}
  {{ gov.kpi(model.kpis[key], model.labels[key ~ "_kpi"]) }}
{%- endif %}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

{%- if model.flags.trend %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "הכנסות, הוצאות ורווח לאורך השנים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.trend_note }}</p>
  {{ gov.chart("chart-trend", model.labels.trend_aria, "h-72 md:h-96") }}
  {{ gov.table("הכנסות, הוצאות ורווח מלונות התיירות לפי שנה", ["שנה", "הכנסות (מיליארדי ש\"ח)", "הוצאות (מיליארדי ש\"ח)", "רווח (מיליארדי ש\"ח)", "שיעור רווח"], model.tables.trend, ltr=(1, 2, 3, 4)) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("database", "שיעור הרווח של המלונות") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.margin_note }}</p>
  {{ gov.chart("chart-margin", model.labels.margin_aria, "h-64 md:h-80") }}
  {{ gov.table("שיעור הרווח מההכנסות לפי שנה", ["שנה", "שיעור רווח"], model.tables.margin, ltr=(1,)) }}
</section>
{%- endif %}

{%- if model.flags.struct %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "על מה המלונות מוציאים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.struct_note }} "תמורה למשרות" היא שכר העובדים וההוצאות הנלוות לו.</p>
  {{ gov.chart("chart-struct", model.labels.struct_aria, "h-80 md:h-96") }}
  {{ gov.table("הוצאות ורווח כאחוז מההכנסות", ["סעיף", "אחוז מההכנסות"], model.tables.struct, ltr=(1,)) }}
</section>
{%- endif %}

{%- if model.flags.loc %}
<section class="card p-5 mb-6">
  {{ gov.head("map-pin", "הכנסות המלונות לפי יישוב") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.loc_note }}</p>
  {{ gov.chart("chart-loc", model.labels.loc_aria, "h-80 md:h-96") }}
  {{ gov.table("הכנסות מלונות התיירות לפי יישוב", model.labels.loc_cols, model.tables.loc, ltr=(1, 2)) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("map-pin", "איפה המלונות רווחיים יותר") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.loc_margin_note }}</p>
  {{ gov.chart("chart-loc-margin", model.labels.loc_margin_aria, "h-80 md:h-[460px]") }}
  {{ gov.table("שיעור רווח ושכר כאחוז מההכנסות לפי יישוב", ["יישוב", "שיעור רווח", "שכר (תמורה למשרות)"], model.tables.loc_margin, ltr=(1, 2)) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("database", "הכנסות המלונות ביישובים המובילים לאורך השנים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.loc_trend_note }}</p>
  {{ gov.chart("chart-loc-trend", model.labels.loc_trend_aria, "h-72 md:h-96") }}
  {{ gov.table("הכנסות המלונות לפי יישוב ושנה (מיליוני ש\"ח)", model.labels.loc_trend_cols, model.tables.loc_trend, ltr=range(1, model.labels.loc_trend_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.recovery %}
<section class="card p-5 mb-6">
  {{ gov.head("map-pin", "שינוי ריאלי בהכנסות לפי יישוב") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.recovery_note }}</p>
  {{ gov.chart("chart-recovery", model.labels.recovery_aria, "h-80 md:h-[460px]") }}
  {{ gov.table("שינוי ריאלי בהכנסות המלונות לפי יישוב", model.labels.recovery_cols, model.tables.recovery, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>הנתונים מתוך ההודעה השנתית לתקשורת של הלשכה המרכזית לסטטיסטיקה על הכנסות, הוצאות ורווח מלונות התיירות. הם מבוססים על הדוחות הכספיים שהמלונות מגישים לרשות המסים ועל נתונים משלימים מרשתות המלונות, ולכן מתפרסמים באיחור של כשנתיים וחצי. הסכומים אינם כוללים מע"מ, ואינם כוללים את מלונות מזרח ירושלים.</li>
    <li>כל הסכומים בעמוד הם במחירים קבועים של השנה האחרונה בהודעה (בניכוי עליית המחירים), כך שאפשר להשוות בין השנים. בכל הודעה חדשה הלמ"ס מעדכנת את כל הסדרה למחירי השנה החדשה, ולכן הסכומים של שנים קודמות משתנים מהודעה להודעה.</li>
    <li>"רווח" בעמוד הוא ההכנסות פחות ההוצאות, ומקביל למה שהלמ"ס מכנה "רווח ותמורה להון": הוא כולל גם את התשלום על ההון (פחת, ריבית ודמי שכירות לבעלי ההון), ולכן אינו הרווח הנקי של המלונות.</li>
    <li>ההכנסות הרבעוניות של המלונות ומספר המועסקים בהם מופיעים בעמוד נפרד על פדיון ותעסוקה במלונות תיירות, ומספר הלינות בעמוד על לינות במלונות תיירות.</li>
  </ul>
</section>

<script>
{%- if model.flags.trend %}
  (function () {
    const d = {{ model.charts.trend | tojson }};
    const pal = window.GOVIL_PALETTE;
    const bn = (v) => v == null ? "" : Number(v).toFixed(1) + " מיליארד ש\"ח";
    const chart = echarts.init(document.getElementById("chart-trend"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2], pal[1]],
      tooltip: { trigger: "axis", valueFormatter: bn },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value" },
      dataZoom: [{ type: "inside" }, { type: "slider", height: 18, bottom: 8 }],
      series: [
        { type: "line", name: "הכנסות", data: d.rev, showSymbol: false, lineStyle: { width: 3 } },
        { type: "line", name: "הוצאות", data: d.exp, showSymbol: false, lineStyle: { width: 2.5 } },
        { type: "bar", name: "רווח", data: d.profit, barMaxWidth: 16 }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.margin | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-margin"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      grid: { left: 16, right: 16, top: 24, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
      dataZoom: [{ type: "inside" }, { type: "slider", height: 18, bottom: 8 }],
      series: [{ type: "line", name: "שיעור רווח", data: d.y, showSymbol: false, lineStyle: { width: 3 },
        areaStyle: { opacity: 0.12 } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.struct %}
  (function () {
    const d = {{ model.charts.struct | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-struct"));
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "% מההכנסות" },
      grid: { left: 16, right: 48, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 130, overflow: "truncate" } },
      series: [{ type: "bar", name: "אחוז מההכנסות", barMaxWidth: 22,
        data: d.values.map((v, k) => ({ value: v, itemStyle: { color: d.profit[k] ? pal[1] : pal[0] } })),
        label: { show: true, position: "right", formatter: (p) => Number(p.value).toFixed(1) + "%" } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.loc %}
  (function () {
    const d = {{ model.charts.loc | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-loc"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Math.round(v).toLocaleString("he-IL") + " מיליון ש\"ח" },
      grid: { left: 16, right: 56, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { formatter: (v) => Number(v).toLocaleString("he-IL") } },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [{ type: "bar", name: "הכנסות", data: d.values, barMaxWidth: 22,
        label: { show: true, position: "right", formatter: (p) => Math.round(p.value).toLocaleString("he-IL") } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.loc_margin | tojson }};
    const wages = {{ model.flags.loc_wages | tojson }};
    const pal = window.GOVIL_PALETTE;
    const series = [{ type: "bar", name: "שיעור רווח", data: d.margin, barMaxWidth: 16,
      label: { show: true, position: "right", formatter: (p) => p.value == null ? "" : Number(p.value).toFixed(1) + "%" } }];
    if (wages) series.push({ type: "bar", name: "שכר (תמורה למשרות)", data: d.wages, barMaxWidth: 16 });
    const chart = echarts.init(document.getElementById("chart-loc-margin"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[1], pal[6]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "% מההכנסות" },
      legend: { top: 0 },
      grid: { left: 16, right: 48, top: 40, bottom: 8, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: series
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.loc_trend | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-loc-trend"));
    chart.setOption(window.GovEcharts.option({
      color: pal,
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Math.round(v).toLocaleString("he-IL") + " מיליון ש\"ח" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 64, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: (v) => Number(v).toLocaleString("he-IL") } },
      series: d.names.map((n, k) => ({ type: "line", name: n, data: d.series[k], symbolSize: 6, lineStyle: { width: 2.5 } }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.recovery %}
  (function () {
    const d = {{ model.charts.recovery | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-recovery"));
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : "\u200e" + (v > 0 ? "+" : "") + Number(v).toFixed(1) + "%" },
      grid: { left: 16, right: 56, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [{ type: "bar", name: "שינוי ריאלי", barMaxWidth: 20,
        data: d.values.map((v) => ({ value: v, itemStyle: { color: v >= 0 ? pal[0] : "#dc3545" } })),
        label: { show: true, position: "right", formatter: (p) => "\u200e" + (p.value > 0 ? "+" : "") + Number(p.value).toFixed(1) + "%" } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
</script>
