<script>
  (function () {
    var b = {{ model.charts.bands | tojson }};
    var last = b.y.length - 1;
    var c1 = echarts.init(document.getElementById("chart-bands"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 40, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: b.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value" },
      series: [{ type: "bar", name: "בקשות", data: b.y.map(function (v, i) {
        return (b.partial && i === last) ? { value: v, itemStyle: { color: "#9fc3f7" } } : v;
      }) }]
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    var t = {{ model.charts.types | tojson }};
    var c2 = echarts.init(document.getElementById("chart-types"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: window.innerWidth < 640 ? 2 : 4, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: t.names.slice().reverse() },
      series: [{ type: "bar", name: "רשומות מבקשים", data: t.values.slice().reverse() }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });

    var tm = {{ model.charts.type_mix | tojson }};
    var c3 = echarts.init(document.getElementById("chart-type-mix"));
    c3.setOption(window.GovEcharts.option({
      color: ["#0068f5", "#0b3668", "#c3cfe7", "#9fc3f7"],
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 40, right: 16, top: 24, bottom: 96, containLabel: true },
      xAxis: { type: "category", data: tm.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value", max: 100, name: "%" },
      series: tm.series.map(function (s) { return { type: "bar", stack: "s", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c3.resize(); });
  })();
</script>

<script>
  (function () {
    var narrow = window.innerWidth < 640;
    function hbar(id, d, name, w) {
      if (narrow) { w = Math.min(w, 120); }
      var n = d.names.length;
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis" },
        grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: narrow ? 2 : 4, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: w, overflow: "truncate" } },
        series: [{ type: "bar", name: name, data: d.values.slice().reverse().map(function (v, i) {
          return (d.il && d.il[n - 1 - i]) ? { value: v, itemStyle: { color: "#0b3668" } } : v;
        }) }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    hbar("chart-top", {{ model.charts.top | tojson }}, "בקשות", 200);
    hbar("chart-top-il", {{ model.charts.top_il | tojson }}, "בקשות", 170);
    hbar("chart-acad", {{ model.charts.acad | tojson }}, "בקשות", 170);
    hbar("chart-co", {{ model.charts.co | tojson }}, "בקשות", 170);

    var p = {{ model.charts.prolific | tojson }};
    var c4 = echarts.init(document.getElementById("chart-prolific"));
    c4.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 40, right: 16, top: 24, bottom: narrow ? 52 : 40, containLabel: true },
      xAxis: { type: "category", data: p.names, name: "בקשות למבקש", nameLocation: "middle", nameGap: narrow ? 40 : 28, axisLabel: { interval: 0, fontSize: 11, rotate: narrow ? 45 : 0 } },
      yAxis: { type: "log", min: 1 },
      series: [{ type: "bar", name: "מבקשים", data: p.values }]
    }));
    window.addEventListener("resize", function () { c4.resize(); });

    var cc = {{ model.charts.conc | tojson }};
    var c5 = echarts.init(document.getElementById("chart-conc"));
    c5.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      grid: { left: 40, right: 16, top: 32, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: cc.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value", min: 0, name: "%" },
      series: [{ type: "line", name: "בידי עשרת הגדולים", data: cc.y }]
    }));
    window.addEventListener("resize", function () { c5.resize(); });

    var nc = {{ model.charts.newcomers | tojson }};
    var c6 = echarts.init(document.getElementById("chart-newcomers"));
    c6.setOption(window.GovEcharts.option({
      color: ["#0068f5", "#c3cfe7"],
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 40, right: 16, top: 24, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: nc.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value" },
      series: [
        { type: "bar", stack: "s", name: "מבקשים חדשים", data: nc["new"] },
        { type: "bar", stack: "s", name: "מבקשים חוזרים", data: nc.ret }
      ]
    }));
    window.addEventListener("resize", function () { c6.resize(); });
  })();
</script>

{% if model.flags.countries %}
<script>
  (function () {
    var cn = {{ model.charts.countries | tojson }};
    var c7 = echarts.init(document.getElementById("chart-countries"));
    c7.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: window.innerWidth < 640 ? 2 : 5, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: cn.names.slice().reverse() },
      series: [{ type: "bar", name: "רשומות מבקשים", data: cn.values.slice().reverse().map(function (v, i, a) {
        return cn.names[a.length - 1 - i] === "ישראל" ? { value: v, itemStyle: { color: "#0b3668" } } : v;
      }) }]
    }));
    window.addEventListener("resize", function () { c7.resize(); });

    var cp = {{ model.charts.comp | tojson }};
    var c8 = echarts.init(document.getElementById("chart-comp"));
    c8.setOption(window.GovEcharts.option({
      color: ["#0b3668", "#5a9bf6", "#c3cfe7"],
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 40, right: 16, top: 24, bottom: 96, containLabel: true },
      xAxis: { type: "category", data: cp.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value", max: 100, name: "%" },
      series: cp.series.map(function (s) { return { type: "bar", stack: "s", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c8.resize(); });

    var it = {{ model.charts.il_types | tojson }};
    var c9 = echarts.init(document.getElementById("chart-il-types"));
    c9.setOption(window.GovEcharts.option({
      color: ["#0b3668", "#9fc3f7"],
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 40, right: 16, top: 24, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: it.cats, axisLabel: { interval: 0, fontSize: 11, width: window.innerWidth < 640 ? 56 : 90, overflow: "break" } },
      yAxis: { type: "value", max: 100, name: "%" },
      series: it.series.map(function (s) { return { type: "bar", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c9.resize(); });
  })();
</script>
{% endif %}
