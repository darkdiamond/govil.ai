{% import "gov.j2" as gov %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסמה {{ model.release.date }}</p>
{%- if model.release.headline %}
  <p class="m-0 mb-3 text-ink-deep">{{ model.release.headline }}</p>
{%- endif %}
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["startups", "licences", "granted", "apps", "income", "staff"] %}
{%- if model.kpis[key] is defined %}
  {{ gov.kpi(model.kpis[key], model.labels[key ~ "_kpi"]) }}
{%- endif %}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

{%- if model.flags.startups %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "חברות הזנק שהוקמו על בסיס מחקר") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.startups_note }}</p>
  {{ gov.chart("chart-startups", model.labels.startups_aria) }}
  {{ gov.table("חברות הזנק חדשות לפי שנה", ["שנה", "חברות הזנק"], model.tables.startups, ltr=(1,)) }}
</section>
{%- endif %}

{%- if model.flags.activity %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "הסכמי רישיון ופטנטים מאושרים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.activity_note }}</p>
  {{ gov.chart("chart-activity", model.labels.activity_aria) }}
  {{ gov.table("הסכמי רישיון ופטנטים מאושרים לפי שנה", model.labels.activity_cols, model.tables.activity, ltr=range(1, model.labels.activity_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.apps %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "בקשות לפטנטים מהאוניברסיטאות") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.apps_note }}</p>
  {{ gov.chart("chart-apps", model.labels.apps_aria) }}
  {{ gov.table("בקשות מקוריות לפטנטים לפי שנה", ["שנה", "בקשות"], model.tables.apps, ltr=(1,)) }}
</section>
{%- endif %}

{%- if model.flags.income %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "הכנסות מקניין רוחני: תמלוגים ורישוי") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.income_note }}</p>
  {{ gov.chart("chart-income", model.labels.income_aria) }}
  {{ gov.table("הכנסות מקניין רוחני לפי שנה (מיליוני ש\"ח)", ["שנה", "מיליוני ש\"ח"], model.tables.income, ltr=(1,)) }}
</section>
{%- endif %}

{%- if model.flags.staff %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "עובדים מקצועיים בחברות המסחור") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.staff_note }}</p>
  {{ gov.chart("chart-staff", model.labels.staff_aria, "h-64 md:h-80") }}
  {{ gov.table("עובדים מקצועיים לפי שנה", ["שנה", "עובדים"], model.tables.staff, ltr=(1,)) }}
</section>
{%- endif %}

{%- if model.flags.index %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "כל המדדים על קנה מידה אחד") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.index_note }}</p>
  {{ gov.chart("chart-index", model.labels.index_aria, "h-80 md:h-[460px]") }}
  {{ gov.table("מדדי מסחור ידע ביחס לשנת הבסיס", model.labels.index_cols, model.tables.index, ltr=(1,)) }}
</section>
{%- endif %}

<script>
  function kcBars(id, d, color, unit, digits) {
    const chart = echarts.init(document.getElementById(id));
    chart.setOption(window.GovEcharts.option({
      color: [color],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: digits }) + unit },
      grid: { left: 16, right: 16, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value" },
      series: [{ type: "bar", data: d.y, barMaxWidth: 36 }]
    }));
    window.addEventListener("resize", () => chart.resize());
  }
{%- if model.flags.startups %}
  (function () {
    kcBars("chart-startups", {{ model.charts.startups | tojson }}, window.GOVIL_PALETTE[0], " חברות", 0);
  })();
{%- endif %}
{%- if model.flags.apps %}
  (function () {
    kcBars("chart-apps", {{ model.charts.apps | tojson }}, window.GOVIL_PALETTE[1], " בקשות", 0);
  })();
{%- endif %}
{%- if model.flags.income %}
  (function () {
    kcBars("chart-income", {{ model.charts.income | tojson }}, window.GOVIL_PALETTE[2], " מיליון ש\"ח", 0);
  })();
{%- endif %}
{%- if model.flags.staff %}
  (function () {
    kcBars("chart-staff", {{ model.charts.staff | tojson }}, window.GOVIL_PALETTE[3], " עובדים", 0);
  })();
{%- endif %}
{%- if model.flags.activity %}
  (function () {
    const d = {{ model.charts.activity | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-activity"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value" },
      series: d.names.map((n, k) => ({ type: "line", name: n, data: d.series[k], symbolSize: 6, lineStyle: { width: k === 0 ? 3 : 2 } }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.index %}
  (function () {
    const d = {{ model.charts.index | tojson }};
    const chart = echarts.init(document.getElementById("chart-index"));
    chart.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 0 }) },
      legend: { top: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 48, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value" },
      series: d.names.map((n, k) => ({ type: "line", name: n, data: d.series[k], showSymbol: false, lineStyle: { width: 2 } }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
</script>
