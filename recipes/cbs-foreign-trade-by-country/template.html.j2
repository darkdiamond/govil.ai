{% import "gov.j2" as gov %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסמה {{ model.release.date }}</p>
  <p class="m-0 mb-3 font-semibold text-ink-deep">{{ model.release.headline }}</p>
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));">
{%- for key in ["exp_m", "imp_m", "exp_y", "imp_y", "bal_y", "bal_nis"] %}
{%- if model.kpis[key] is defined %}
  {{ gov.kpi(model.kpis[key], model.labels[key ~ "_kpi"]) }}
{%- endif %}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

<section class="card p-5 mb-6">
  {{ gov.head("chart-bar", "שותפות הסחר הגדולות של ישראל") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.partners_note }}</p>
  {{ gov.chart("chart-partners", model.labels.partners_aria, "h-[520px] md:h-[560px]") }}
  {{ gov.table(model.labels.partners_caption, ["ארץ", "יבוא", "יצוא", "סך הסחר", "חלק מכלל הסחר"], model.tables.partners, ltr=(1, 2, 3, 4)) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("trending-up", "לאן ישראל מייצאת: יעדי היצוא הגדולים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.exports_note }}</p>
  {{ gov.chart("chart-exports", model.labels.exports_aria, "h-[480px] md:h-[520px]") }}
  {{ gov.table(model.labels.exports_caption, ["ארץ", model.labels.col_ytd, model.labels.col_ytd0, "שינוי", "חלק מהיצוא"], model.tables.exports, ltr=(1, 2, 3, 4)) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("chart-bar", "מאין ישראל מייבאת: מקורות היבוא הגדולים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.imports_note }}</p>
  {{ gov.chart("chart-imports", model.labels.imports_aria, "h-[480px] md:h-[520px]") }}
  {{ gov.table(model.labels.imports_caption, ["ארץ", model.labels.col_ytd, model.labels.col_ytd0, "שינוי", "חלק מהיבוא"], model.tables.imports, ltr=(1, 2, 3, 4)) }}
</section>

{%- if model.flags.continents %}
<section class="card p-5 mb-6">
  {{ gov.head("map-pin", "יבוא ויצוא לפי יבשת") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.continents_note }}</p>
  {{ gov.chart("chart-continents", model.labels.continents_aria, "h-72 md:h-80") }}
  {{ gov.table(model.labels.continents_caption, ["יבשת", "יבוא", "חלק מהיבוא", "יצוא", "חלק מהיצוא", "שינוי ביצוא"], model.tables.continents, ltr=(1, 2, 3, 4, 5)) }}
</section>
{%- endif %}

{%- if model.flags.monthly %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "יצוא ויבוא בכל חודש לפי אזור") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.monthly_note }}</p>
  <h3 class="text-base font-semibold text-ink-deep mt-2 mb-2">יצוא</h3>
  {{ gov.chart("chart-monthly-exp", model.labels.monthly_exp_aria, "h-80 md:h-96") }}
  {{ gov.table(model.labels.monthly_exp_caption, ["חודש"] + model.charts.group_names, model.tables.monthly_exp, ltr=(1, 2, 3, 4, 5, 6, 7)) }}
  <h3 class="text-base font-semibold text-ink-deep mt-6 mb-2">יבוא</h3>
  {{ gov.chart("chart-monthly-imp", model.labels.monthly_imp_aria, "h-80 md:h-96") }}
  {{ gov.table(model.labels.monthly_imp_caption, ["חודש"] + model.charts.group_names, model.tables.monthly_imp, ltr=(1, 2, 3, 4, 5, 6, 7)) }}
</section>
{%- endif %}

{%- if model.flags.balance %}
<section class="card p-5 mb-6">
  {{ gov.head("chart-bar", "המאזן המסחרי מול כל ארץ") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.balance_note }}</p>
  {{ gov.chart("chart-balance", model.labels.balance_aria, "h-[520px] md:h-[560px]") }}
  {{ gov.table(model.labels.balance_caption, ["ארץ", "יצוא", "יבוא", "מאזן"], model.tables.balance, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

{%- if model.flags.movers %}
<section class="card p-5 mb-6">
  {{ gov.head("trending-up", "עם מי הסחר גדל ועם מי ירד") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.movers_note }}</p>
  {{ gov.chart("chart-movers", model.labels.movers_aria, "h-[440px] md:h-[480px]") }}
  {{ gov.table(model.labels.movers_caption, ["ארץ", model.labels.col_ytd0, model.labels.col_ytd, "שינוי", "שינוי באחוזים"], model.tables.movers, ltr=(1, 2, 3, 4)) }}
</section>
{%- endif %}

{%- if model.flags.annual %}
<section class="card p-5 mb-6">
  {{ gov.head("calendar", "שנה מלאה: שותפות הסחר הגדולות") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.annual_note }}</p>
  {{ gov.chart("chart-annual", model.labels.annual_aria, "h-[440px] md:h-[480px]") }}
  {{ gov.table(model.labels.annual_caption, ["ארץ", model.labels.col_f0, model.labels.col_f1, "שינוי"], model.tables.annual, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

{%- if model.flags.diamonds %}
<section class="card p-5 mb-6">
  {{ gov.head("chart-bar", "הסחר ביהלומים לפי ארץ") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.diamonds_note }}</p>
  {{ gov.chart("chart-diamonds", model.labels.diamonds_aria, "h-80 md:h-96") }}
  {{ gov.table(model.labels.diamonds_caption, ["ארץ", "יצוא יהלומים", "יבוא יהלומים", "חלק היהלומים מהיצוא לארץ"], model.tables.diamonds, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("list", "בדולרים ובשקלים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.currency_note }}</p>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <caption class="sr-only">{{ model.labels.currency_caption }}</caption>
      <thead>
        <tr><th scope="col"></th><th scope="col" colspan="3">מיליוני דולרים</th><th scope="col" colspan="3">מיליוני ₪</th></tr>
        <tr><th scope="col"></th><th scope="col">{{ model.labels.y_prev }}</th><th scope="col">{{ model.labels.y_cur }}</th><th scope="col">שינוי</th><th scope="col">{{ model.labels.y_prev }}</th><th scope="col">{{ model.labels.y_cur }}</th><th scope="col">שינוי</th></tr>
      </thead>
      <tbody>
{%- for r in model.tables.currency %}
        <tr>{% for v in r %}{% if loop.first %}<th scope="row">{{ v }}</th>{% else %}<td dir="ltr">{{ v }}</td>{% endif %}{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
  </div>
</section>

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>הנתונים הם סחר בסחורות בלבד, בלי שירותים. היבוא מיוחס לארץ המקור של הסחורה, והיצוא לארץ היעד.</li>
    <li>הנתונים כוללים יהלומים, אלא אם נאמר אחרת. נתוני היצוא והיבוא לפי אזור בכל חודש אינם כוללים יהלומים, אוניות ומטוסים.</li>
    <li>לפי הלמ"ס, לנתוני הסחר עם סין יש לצרף את נתוני הסחר עם הונג קונג. העמוד מציג אותן בנפרד, כמו בלוחות.</li>
    <li>הנתונים של החודשים האחרונים ארעיים, והלמ"ס מעדכנת אותם בהודעות הבאות. העמוד מציג תמיד את הגרסה האחרונה.</li>
  </ul>
</section>

<script>
  (function () {
    const d = {{ model.charts.partners | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-partners"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 0 }) + " מיליון $" },
      legend: { top: 0 },
      grid: { left: 8, right: 28, top: 40, bottom: 8, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true, formatter: (v) => v.toLocaleString("he-IL") } },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [
        { type: "bar", stack: "t", name: "יצוא", data: d.exp },
        { type: "bar", stack: "t", name: "יבוא", data: d.imp }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    for (const [id, d] of [["chart-exports", {{ model.charts.exports | tojson }}], ["chart-imports", {{ model.charts.imports | tojson }}]]) {
      const pal = window.GOVIL_PALETTE;
      const chart = echarts.init(document.getElementById(id));
      chart.setOption(window.GovEcharts.option({
        color: [pal[0], pal[6]],
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 0 }) + " מיליון $" },
        legend: { top: 0 },
        grid: { left: 8, right: 28, top: 40, bottom: 8, containLabel: true },
        xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true, formatter: (v) => v.toLocaleString("he-IL") } },
        yAxis: { type: "category", data: d.names, inverse: true },
        series: [
          { type: "bar", name: {{ model.labels.col_ytd | tojson }}, data: d.cur },
          { type: "bar", name: {{ model.labels.col_ytd0 | tojson }}, data: d.prev }
        ]
      }));
      window.addEventListener("resize", () => chart.resize());
    }
  })();
{%- if model.flags.continents %}
  (function () {
    const d = {{ model.charts.continents | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-continents"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 0 }) + " מיליון $" },
      legend: { top: 0 },
      grid: { left: 8, right: 28, top: 40, bottom: 8, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true, formatter: (v) => v.toLocaleString("he-IL") } },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [
        { type: "bar", name: "יצוא", data: d.exp },
        { type: "bar", name: "יבוא", data: d.imp }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.monthly %}
  (function () {
    const names = {{ model.charts.group_names | tojson }};
    for (const [id, d] of [["chart-monthly-exp", {{ model.charts.monthly_exp | tojson }}], ["chart-monthly-imp", {{ model.charts.monthly_imp | tojson }}]]) {
      const pal = window.GOVIL_PALETTE;
      const chart = echarts.init(document.getElementById(id));
      chart.setOption(window.GovEcharts.option({
        color: [pal[0], pal[1], pal[2], pal[6], pal[3], pal[5], pal[7]],
        tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 0 }) + " מיליון $" },
        legend: { top: 0, type: "scroll" },
        grid: { left: 8, right: 28, top: 48, bottom: 8, containLabel: true },
        xAxis: { type: "category", data: d.x, axisLabel: { rotate: 45 } },
        yAxis: { type: "value" },
        series: names.map((n, k) => ({ type: "line", name: n, data: d.series[k], showSymbol: false,
          lineStyle: k >= 4 ? { type: "dashed", width: 2 } : { width: 3 } }))
      }));
      window.addEventListener("resize", () => chart.resize());
    }
  })();
{%- endif %}
{%- if model.flags.balance %}
  (function () {
    const d = {{ model.charts.balance | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-balance"));
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 0 }) + " מיליון $" },
      grid: { left: 8, right: 28, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true, formatter: (v) => v.toLocaleString("he-IL") } },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [{ type: "bar", name: "מאזן", data: d.bal.map((v) => ({ value: v, itemStyle: { color: v >= 0 ? pal[0] : pal[2] } })) }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.movers %}
  (function () {
    const d = {{ model.charts.movers | tojson }};
    const chart = echarts.init(document.getElementById("chart-movers"));
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 0 }) + " מיליון $" },
      grid: { left: 8, right: 28, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [{ type: "bar", name: "שינוי", data: d.d.map((v) => ({ value: v, itemStyle: { color: v >= 0 ? "#198754" : "#dc3545" } })) }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.annual %}
  (function () {
    const d = {{ model.charts.annual | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-annual"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[6], pal[0]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 0 }) + " מיליון $" },
      legend: { top: 0 },
      grid: { left: 8, right: 28, top: 40, bottom: 8, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true, formatter: (v) => v.toLocaleString("he-IL") } },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [
        { type: "bar", name: d.y0, data: d.f0 },
        { type: "bar", name: d.y1, data: d.f1 }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.diamonds %}
  (function () {
    const d = {{ model.charts.diamonds | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-diamonds"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 0 }) + " מיליון $" },
      legend: { top: 0 },
      grid: { left: 8, right: 28, top: 40, bottom: 8, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: d.names, inverse: true },
      series: [
        { type: "bar", name: "יצוא יהלומים", data: d.exp },
        { type: "bar", name: "יבוא יהלומים", data: d.imp }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
</script>
