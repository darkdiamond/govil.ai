{% import "gov.j2" as gov %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "הפרסום האחרון של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסם {{ model.release.date }}</p>
{%- if model.release.headline %}
  <p class="m-0 mb-3 font-semibold text-ink-deep">{{ model.release.headline }}</p>
{%- endif %}
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">לפרסום המלא באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["latest", "yoy", "rate", "total", "lead", "median"] %}
{%- if model.kpis[key] is defined %}
  {{ gov.kpi(model.kpis[key], model.labels[key ~ "_kpi"]) }}
{%- endif %}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

{%- if model.flags.years %}
<section class="card p-5 mb-6">
  {{ gov.head("trending-up", "מספר העולים לישראל לפי שנים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.years_note }}</p>
  {{ gov.chart("chart-years", model.labels.years_aria, "h-80 md:h-[460px]") }}
  {{ gov.table(model.labels.years_aria, ["שנה", "עולים", model.labels.per1000], model.tables.years, ltr=(1, 2)) }}
</section>
{%- endif %}

{%- if model.flags.periods %}
<section class="card p-5 mb-6">
  {{ gov.head("calendar", "גלי העלייה: עולים לפי תקופת עלייה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.periods_note }}</p>
  {{ gov.chart("chart-periods", model.labels.periods_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.periods_aria, ["תקופה", "עולים", "מכלל העולים", model.labels.per1000_period], model.tables.periods, ltr=(0, 1, 2, 3)) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("chart-bar", "עולים לפי יבשת") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.continents_note }}</p>
  {{ gov.chart("chart-continents", model.labels.continents_aria, "h-64 md:h-80") }}
  {{ gov.table(model.labels.continents_aria, ["יבשת"] + model.labels.years_pair + ["חלק מהעולים"], model.tables.continents, ltr=(1, 2, 3)) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("map-pin", "מאילו ארצות עלו: עולים לפי ארץ מגורים אחרונה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.countries_note }}</p>
  {{ gov.chart("chart-countries", model.labels.countries_aria, "h-[560px] md:h-[620px]") }}
  {{ gov.table(model.labels.countries_aria, ["ארץ"] + model.labels.years_pair + ["שינוי"], model.tables.countries, ltr=(1, 2, 3)) }}
</section>

{%- if model.flags.fsu %}
<section class="card p-5 mb-6">
  {{ gov.head("trending-up", "העלייה מבריה\"מ לשעבר") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.fsu_note }}</p>
  {{ gov.chart("chart-fsu", model.labels.fsu_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.fsu_aria, model.labels.fsu_cols, model.tables.fsu, ltr=range(1, model.labels.fsu_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.months %}
<section class="card p-5 mb-6">
  {{ gov.head("calendar", "עולים לפי חודש עלייה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.months_note }}</p>
  {{ gov.chart("chart-months", model.labels.months_aria, "h-72 md:h-96") }}
  {{ gov.table(model.labels.months_aria, model.labels.months_cols, model.tables.months, ltr=range(1, model.labels.months_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.age %}
<section class="card p-5 mb-6">
  {{ gov.head("chart-bar", "עולים לפי קבוצת גיל") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.age_note }}</p>
  {{ gov.chart("chart-age", model.labels.age_aria, "h-64 md:h-80") }}
  {{ gov.table(model.labels.age_aria, ["קבוצת גיל"] + model.labels.age_years + ["חלק מהעולים"], model.tables.age, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

{%- if model.flags.t4 %}
<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    {{ gov.head("chart-bar", "עולים בוגרים לפי מין וגיל") }}
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.pyramid_note }}</p>
    {{ gov.chart("chart-pyramid", model.labels.pyramid_aria, "h-72 md:h-96") }}
    {{ gov.table(model.labels.pyramid_aria, ["קבוצת גיל", "גברים", "נשים"], model.tables.pyramid, ltr=(1, 2)) }}
  </section>
  <section class="card p-5">
    {{ gov.head("chart-bar", "מצב משפחתי לפי גיל") }}
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.marital_note }}</p>
    {{ gov.chart("chart-marital", model.labels.marital_aria, "h-72 md:h-96") }}
    {{ gov.table(model.labels.marital_aria, ["קבוצת גיל"] + model.charts.marital.names, model.tables.marital, ltr=(1, 2, 3, 4)) }}
  </section>
</div>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("map-pin", "היכן השתקעו העולים: מחוז מגורים ראשון") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.districts_note }}</p>
  {{ gov.chart("chart-districts", model.labels.districts_aria, "h-80 md:h-[460px]") }}
  {{ gov.table(model.labels.districts_aria, model.labels.districts_cols, model.tables.districts, ltr=range(1, model.labels.districts_cols | length) | list) }}
</section>

{%- if model.flags.localities %}
<section class="card p-5 mb-6">
  {{ gov.head("map-pin", "יישובי ההשתקעות העיקריים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.localities_note }}</p>
  {{ gov.chart("chart-localities", model.labels.localities_aria, "h-[560px] md:h-[620px]") }}
  {{ gov.table(model.labels.localities_aria, model.labels.localities_cols, model.tables.localities, ltr=range(1, model.labels.localities_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.education or model.flags.occupations %}
<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
{%- if model.flags.education %}
  <section class="card p-5">
    {{ gov.head("list", "השכלת העולים") }}
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.education_note }}</p>
    {{ gov.chart("chart-education", model.labels.education_aria, "h-64 md:h-80") }}
    {{ gov.table(model.labels.education_aria, ["שנות לימוד", "עולים", "חלק"], model.tables.education, ltr=(1, 2)) }}
  </section>
{%- endif %}
{%- if model.flags.occupations %}
  <section class="card p-5">
    {{ gov.head("building-2", "עולים בעלי מקצוע אקדמי") }}
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.occupations_note }}</p>
    {{ gov.chart("chart-occupations", model.labels.occupations_aria, "h-64 md:h-80") }}
    {{ gov.table(model.labels.occupations_aria, ["תחום עיסוק", "עולים", "חלק"], model.tables.occupations, ltr=(1, 2)) }}
  </section>
{%- endif %}
</div>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>לפי הלמ"ס, הנתונים כוללים עולים, עולים בכוח ותיירים ששינו את מעמדם לעולים או לעולים בכוח, ואינם כוללים אזרחים עולים.</li>
    <li>ארץ המגורים האחרונה היא הארץ שממנה הגיע העולה, ואינה בהכרח ארץ הלידה שלו.</li>
    <li>{{ model.labels.rate_about }}</li>
    <li>נתוני השנה הנוכחית שבתרשים החודשי ארעיים, והלמ"ס מעדכנת אותם בפרסום הבא. העמוד מתעדכן עם כל פרסום שנתי חדש.</li>
  </ul>
</section>

<script>
{%- if model.flags.years %}
  (function () {
    const d = {{ model.charts.years | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-years"));
    const n = d.n.length;
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1]],
      tooltip: {
        trigger: "axis",
        formatter: (ps) => {
          const i = ps[0].dataIndex;
          return echarts.format.encodeHTML(d.x[i]) + "<br>עולים: " + Number(d.n[i]).toLocaleString("he-IL") +
            (d.rate[i] == null ? "" : "<br>" + d.per + ": " + Number(d.rate[i]).toLocaleString("he-IL", { maximumFractionDigits: 1 }));
        }
      },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: [
        { type: "value", axisLabel: { formatter: (v) => Number(v).toLocaleString("he-IL") } },
        { type: "value", splitLine: { show: false } }
      ],
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 20 }],
      series: [
        { type: "bar", name: "עולים", data: d.n.map((v, i) => i === n - 1 ? { value: v, itemStyle: { color: "#0b3668" } } : v) },
        { type: "line", name: d.per, yAxisIndex: 1, data: d.rate, showSymbol: false }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.periods %}
  (function () {
    const d = {{ model.charts.periods | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-periods"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: {
        trigger: "axis",
        formatter: (ps) => {
          const i = ps[0].dataIndex;
          return echarts.format.encodeHTML(d.x[i]) + "<br>עולים: " + Number(d.n[i]).toLocaleString("he-IL") +
            (d.rate[i] == null ? "" : "<br>" + d.per + ": " + Number(d.rate[i]).toLocaleString("he-IL", { maximumFractionDigits: 1 }));
        }
      },
      grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: 45 } },
      yAxis: { type: "value", axisLabel: { formatter: (v) => Number(v).toLocaleString("he-IL") } },
      series: [{ type: "bar", data: d.n }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
  (function () {
    const d = {{ model.charts.continents | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-continents"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[6], pal[0]],
      tooltip: { trigger: "axis", valueFormatter: (v) => Number(v).toLocaleString("he-IL") },
      legend: { top: 0 },
      grid: { left: 16, right: 56, top: 32, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: false }, splitLine: { show: false } },
      yAxis: { type: "category", data: d.x, inverse: true },
      series: [
        { type: "bar", name: d.years[0], data: d.prev },
        { type: "bar", name: d.years[1], data: d.cur, label: { show: true, position: "right", formatter: (p) => Number(p.value).toLocaleString("he-IL") } }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.countries | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-countries"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[6], pal[0]],
      tooltip: { trigger: "axis", valueFormatter: (v) => Number(v).toLocaleString("he-IL") },
      legend: { top: 0 },
      grid: { left: 16, right: 56, top: 32, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: false }, splitLine: { show: false } },
      yAxis: { type: "category", data: d.x, inverse: true, axisLabel: { width: 110, overflow: "break" } },
      series: [
        { type: "bar", name: d.years[0], data: d.prev },
        { type: "bar", name: d.years[1], data: d.cur, label: { show: true, position: "right", formatter: (p) => Number(p.value).toLocaleString("he-IL") } }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- if model.flags.fsu %}
  (function () {
    const d = {{ model.charts.fsu | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-fsu"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[6]].concat(pal),
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 56, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: (v) => Number(v).toLocaleString("he-IL") } },
      series: [{ type: "line", name: "סך עולים", data: d.total, showSymbol: false, lineStyle: { width: 2, type: "dashed" } }].concat(
        d.names.map((nm, k) => ({ type: "line", name: nm, data: d.series[k], showSymbol: false, lineStyle: { width: k === 0 ? 3 : 1.5 } })))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.months %}
  (function () {
    const d = {{ model.charts.months | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-months"));
    const n = d.years.length;
    chart.setOption(window.GovEcharts.option({
      color: d.years.map((y, k) => k === n - 1 ? pal[0] : k === n - 2 ? pal[1] : pal[(k + 2) % pal.length]),
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 56, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: (v) => Number(v).toLocaleString("he-IL") } },
      series: d.years.map((y, k) => ({
        type: "line", name: y, data: d.series[k], connectNulls: false,
        lineStyle: { width: k === n - 1 ? 3 : 1.5 }
      }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.age %}
  (function () {
    const d = {{ model.charts.age | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-age"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[6], pal[0]],
      tooltip: { trigger: "axis", valueFormatter: (v) => Number(v).toLocaleString("he-IL") },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: (v) => Number(v).toLocaleString("he-IL") } },
      series: [
        { type: "bar", name: d.years[0], data: d.prev },
        { type: "bar", name: d.years[1], data: d.cur }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.t4 %}
  (function () {
    const d = {{ model.charts.pyramid | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-pyramid"));
    const abs = (v) => Math.abs(Number(v)).toLocaleString("he-IL");
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: abs },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 24, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: abs } },
      yAxis: { type: "category", data: d.x, axisTick: { show: false } },
      series: [
        { type: "bar", name: "גברים", stack: "p", data: d.men.map((v) => -v) },
        { type: "bar", name: "נשים", stack: "p", data: d.women }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.marital | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-marital"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[6], pal[0], pal[1], pal[2]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 24, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: (v) => v + "%" } },
      yAxis: { type: "category", data: d.x, axisTick: { show: false } },
      series: d.names.map((nm, k) => ({ type: "bar", name: nm, stack: "m", data: d.series[k] }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
  (function () {
    const d = {{ model.charts.districts | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-districts"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1], pal[2], pal[8]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => Number(v).toLocaleString("he-IL") },
      legend: { top: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 40, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: (v) => Number(v).toLocaleString("he-IL") } },
      yAxis: { type: "category", data: d.x, inverse: true, axisLabel: { width: 110, overflow: "break" } },
      series: d.series.map((s) => ({ type: "bar", name: s.name, stack: "d", data: s.data }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- if model.flags.localities %}
  (function () {
    const d = {{ model.charts.localities | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-localities"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1], pal[2], pal[8]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => Number(v).toLocaleString("he-IL") },
      legend: { top: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 40, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: (v) => Number(v).toLocaleString("he-IL") } },
      yAxis: { type: "category", data: d.x, inverse: true, axisLabel: { width: 100, overflow: "break" } },
      series: d.series.map((s) => ({ type: "bar", name: s.name, stack: "l", data: s.data }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.education %}
  (function () {
    const d = {{ model.charts.education | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-education"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: { trigger: "axis", valueFormatter: (v) => Number(v).toLocaleString("he-IL") },
      grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x, name: "שנות לימוד", nameLocation: "middle", nameGap: 28 },
      yAxis: { type: "value", axisLabel: { formatter: (v) => Number(v).toLocaleString("he-IL") } },
      series: [{ type: "bar", data: d.n, label: { show: true, position: "top", formatter: (p) => Number(p.value).toLocaleString("he-IL") } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.occupations %}
  (function () {
    const d = {{ model.charts.occupations | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-occupations"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: { trigger: "axis", valueFormatter: (v) => Number(v).toLocaleString("he-IL") },
      grid: { left: 16, right: 56, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: false }, splitLine: { show: false } },
      yAxis: { type: "category", data: d.x, inverse: true, axisLabel: { width: 120, overflow: "break" } },
      series: [{ type: "bar", data: d.n, label: { show: true, position: "right", formatter: (p) => Number(p.value).toLocaleString("he-IL") } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
</script>
