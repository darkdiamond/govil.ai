      yAxis: { type: "value", name: "אירועים", minInterval: 1 },
      series: y.series.map(function (s, i) {
        return { type: "bar", stack: "k", name: s.name, data: s.data,
                 itemStyle: { color: cols[i % cols.length] } };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

{%- if model.flags.has_workers %}
<script>
  (function () {
    var e = {{ model.charts.employers | tojson }};
    var c = echarts.init(document.getElementById("chart-employers"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 24, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", minInterval: 1, splitNumber: 4, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: e.names, inverse: true,
               axisLabel: { fontSize: 10, width: 150, overflow: "truncate" } },
      series: [{ type: "bar", name: "עובדים אחראים", data: e.values.map(function (v, i) {
        return { value: v, itemStyle: { color: e.in_reg[i] ? "#0b3668" : "#9fb7d9" } };
      }) }]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var w = {{ model.charts.crew | tojson }};
    var c2 = echarts.init(document.getElementById("chart-crew"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 16, top: 32, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: w.names, axisLabel: { fontSize: 10, interval: 0, rotate: 25 } },
      yAxis: { type: "value", name: "קבלנים" },
      series: [{ type: "bar", name: "קבלנים", data: w.values.map(function (v, i) {
        return i === 0 ? { value: v, itemStyle: { color: "#9a6700" } } : v;
      }), itemStyle: { color: "#0068f5" } }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>
{%- endif %}

<script>
  (function () {
    var k = {{ model.charts.contact | tojson }};
    var c = echarts.init(document.getElementById("chart-contact"));
    var series = [{ type: "bar", name: "כלל המרשם", data: k.all, itemStyle: { color: "#0b3668" } }];
    k.roles.forEach(function (r, i) {
      var pc = ["#0068f5", "#5b8fd6", "#9fb7d9", "#c3cfe7"];
      series.push({ type: "bar", name: r, data: k.by_role[i], itemStyle: { color: pc[i % pc.length] } });
    });
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                 valueFormatter: function (v) { return v + "%"; } },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 56, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: k.names, axisLabel: { interval: 0, fontSize: 10 } },
      yAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      series: series
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
