      xAxis: { type: "category", data: s.names, axisLabel: { fontSize: 10, interval: 0, rotate: 25 } },
      yAxis: { type: "value", name: "התליות" },
      series: [{ type: "bar", name: "התליות", data: s.values, itemStyle: { color: "#0b3668" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

{%- if model.flags.has_events %}
<script>
  (function () {
    var y = {{ model.charts.disc_years | tojson }};
