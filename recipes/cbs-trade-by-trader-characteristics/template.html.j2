{% import "gov.j2" as gov %}
{%- macro callout(key) -%}
{%- if model.callouts[key] is defined %}
  <p class="m-0 mb-3 text-sm font-semibold text-ink-deep">{{ model.callouts[key] }}</p>
{%- endif %}
{%- endmacro %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסמה {{ model.release.date }}</p>
{%- if model.release.headline %}
  <p class="m-0 mb-3 text-sm text-ink-deep">{{ model.release.headline }}</p>
{%- endif %}
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["exporters", "importers", "exp_value", "imp_value", "big_share"] %}
{%- if model.kpis[key] is defined %}
  {{ gov.kpi(model.kpis[key], model.labels[key ~ "_kpi"]) }}
{%- endif %}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

{%- if model.flags.count %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "כמה עסקים מייצאים ומייבאים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.count_note }}</p>
  {{ callout("exporters_trend") }}{{ callout("importers_trend") }}
  {{ gov.chart("chart-count", model.labels.count_aria, "h-72 md:h-80") }}
  {{ gov.table("מספר העסקים המייצאים והמייבאים לפי שנה", ["שנה", "עסקים מייצאים", "עסקים מייבאים"], model.tables.count, ltr=(1, 2)) }}
</section>
{%- endif %}

{%- if model.flags.value %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "ערך היצוא והיבוא וחלקם של העסקים הגדולים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.value_note }}</p>
  {{ callout("value_trend") }}{{ callout("big_trend") }}
  {{ gov.chart("chart-value", model.labels.value_aria, "h-72 md:h-96") }}
  {{ gov.table("ערך היצוא והיבוא לפי שנה", ["שנה", "יצוא (מיליארד דולר)", "יבוא (מיליארד דולר)", "חלק העסקים הגדולים ביצוא", "חלק העסקים הגדולים ביבוא"], model.tables.value, ltr=(1, 2, 3, 4)) }}
</section>
{%- endif %}

{%- if model.flags.conc %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "ריכוזיות: מעט עסקים גדולים, רוב הערך") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.conc_note }}</p>
  {{ callout("conc_exp") }}{{ callout("conc_imp") }}
  {{ gov.chart("chart-conc", model.labels.conc_aria, "h-80 md:h-96") }}
  {{ gov.table("התפלגות העסקים וערך הסחר לפי גודל העסק", model.labels.conc_cols, model.tables.conc, ltr=(1, 2, 3, 4)) }}
</section>
{%- endif %}

{%- if model.flags.ind %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "יצוא ויבוא לפי ענף כלכלי") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.ind_note }}</p>
  {{ callout("ind_exp") }}{{ callout("ind_imp") }}
  {{ gov.chart("chart-ind", model.labels.ind_aria, "h-[520px]") }}
  {{ gov.table("ערך היצוא והיבוא לפי ענף (מיליארד דולר)", ["ענף", "יצוא", "יבוא"], model.tables.ind, ltr=(1, 2)) }}
</section>
{%- endif %}

{%- if model.flags.indsize_exp %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "מי מייצא בכל ענף: עסקים קטנים או גדולים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.indsize_exp_note }}</p>
  {{ gov.chart("chart-indsize-exp", model.labels.indsize_exp_aria, "h-80 md:h-96") }}
  {{ gov.table("חלק כל קבוצת גודל בערך היצוא של הענף", model.labels.indsize_cols, model.tables.indsize_exp, ltr=(1, 2, 3, 4)) }}
</section>
{%- endif %}

{%- if model.flags.indsize_imp %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "מי מייבא בכל ענף: עסקים קטנים או גדולים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.indsize_imp_note }}</p>
  {{ gov.chart("chart-indsize-imp", model.labels.indsize_imp_aria, "h-80 md:h-96") }}
  {{ gov.table("חלק כל קבוצת גודל בערך היבוא של הענף", model.labels.indsize_cols, model.tables.indsize_imp, ltr=(1, 2, 3, 4)) }}
</section>
{%- endif %}

{%- if model.flags.indn %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "מספר היצואנים והיבואנים בכל ענף") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.indn_note }}</p>
  {{ callout("ind_avg") }}
  {{ gov.chart("chart-indn", model.labels.indn_aria, "h-[520px]") }}
  {{ gov.table("מספר העסקים המייצאים והמייבאים לפי ענף", ["ענף", "עסקים מייצאים", "עסקים מייבאים", "יצוא ממוצע לעסק מייצא (מיליון דולר)"], model.tables.indn, ltr=(1, 2, 3)) }}
</section>
{%- endif %}

{%- if model.flags.region %}
<section class="card p-5 mb-6">
  {{ gov.head("map-pin", "יצוא ויבוא לפי יבשת") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.region_note }}</p>
  {{ gov.chart("chart-region", model.labels.region_aria, "h-72 md:h-80") }}
  {{ gov.table("ערך היצוא והיבוא לפי יבשת (מיליארד דולר)", ["יבשת", "יצוא", "יבוא"], model.tables.region, ltr=(1, 2)) }}
</section>
{%- endif %}

{%- if model.flags.cty %}
<section class="card p-5 mb-6">
  {{ gov.head("map-pin", "שותפות הסחר הגדולות") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cty_note }}</p>
  {{ callout("cty_exp") }}{{ callout("cty_imp") }}
  {{ gov.chart("chart-cty", model.labels.cty_aria, "h-[560px]") }}
  {{ gov.table("ערך היצוא והיבוא לפי ארץ (מיליארד דולר)", ["ארץ", "יצוא", "יבוא"], model.tables.cty, ltr=(1, 2)) }}
</section>
{%- endif %}

{%- if model.flags.ctytrend %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "היצוא ליעדים הגדולים לאורך השנים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.ctytrend_note }}</p>
  {{ callout("cty_move") }}
  {{ gov.chart("chart-ctytrend", model.labels.ctytrend_aria, "h-72 md:h-96") }}
  {{ gov.table("ערך היצוא ליעדים הגדולים לפי שנה (מיליארד דולר)", model.labels.ctytrend_cols, model.tables.ctytrend, ltr=range(1, model.labels.ctytrend_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.ctyn %}
<section class="card p-5 mb-6">
  {{ gov.head("map-pin", "לאן מייצאים הכי הרבה עסקים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.ctyn_note }}</p>
  {{ callout("cty_importers") }}
  {{ gov.chart("chart-ctyn", model.labels.ctyn_aria, "h-[520px]") }}
  {{ gov.table("מספר העסקים המייצאים והמייבאים לפי ארץ", ["ארץ", "עסקים מייצאים", "עסקים מייבאים"], model.tables.ctyn, ltr=(1, 2)) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>הנתונים מתוך ההודעה השנתית לתקשורת של הלשכה המרכזית לסטטיסטיקה על הסחר בסחורות לפי מאפייני היצואנים והיבואנים. הלמ"ס מצליבה את רשומות המכס על יצוא ויבוא סחורות עם מרשם העסקים שלה. הסחר בשירותים אינו כלול.</li>
    <li>גודל העסק נמדד במספר המועסקים בו, והענף הוא הפעילות הכלכלית העיקרית של העסק (סיווג לפי סדר), ולא סוג הסחורה. ערכים במיליוני דולרים, מוצגים כאן במיליארדים.</li>
    <li>בטבלאות לפי ארץ עסק נספר בכל ארץ שאיתה סחר, ולכן סכום הארצות גדול ממספר העסקים. מטעמי סודיות הלמ"ס לא מפרסמת חלק מהתאים, ולכן סכום הקטגוריות יכול להיות שונה מהסך הכולל.</li>
    <li>כל הודעה מכסה שנה אחת. השנים הקודמות בעמוד לקוחות מההודעות הקודמות, כפי שפורסמו.</li>
  </ul>
</section>

<script>
{%- if model.flags.count %}
  (function () {
    const d = {{ model.charts.count | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-count"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") + " עסקים" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 80, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: [
        { type: "value", name: "מייצאים", axisLabel: { formatter: (v) => v >= 1000 ? (v / 1000).toLocaleString("he-IL") + " אלף" : v } },
        { type: "value", name: "מייבאים", splitLine: { show: false }, axisLabel: { formatter: (v) => v >= 1000 ? (v / 1000).toLocaleString("he-IL") + " אלף" : v } }
      ],
      series: [
        { type: "bar", name: "עסקים מייצאים", data: d.exp, yAxisIndex: 0 },
        { type: "line", name: "עסקים מייבאים", data: d.imp, yAxisIndex: 1, lineStyle: { width: 3 } }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.value %}
  (function () {
    const d = {{ model.charts.value | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-value"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2], pal[1], pal[5]],
      tooltip: { trigger: "axis" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 88, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: [
        { type: "value", name: "מיליארד דולר" },
        { type: "value", max: 100, splitLine: { show: false }, axisLabel: { formatter: "{value}%" } }
      ],
      series: [
        { type: "bar", name: "יצוא", data: d.exp, tooltip: { valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + " מיליארד דולר" } },
        { type: "bar", name: "יבוא", data: d.imp, tooltip: { valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + " מיליארד דולר" } },
        { type: "line", name: "חלק הגדולים ביצוא", data: d.big_exp, yAxisIndex: 1, tooltip: { valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" } },
        { type: "line", name: "חלק הגדולים ביבוא", data: d.big_imp, yAxisIndex: 1, tooltip: { valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" } }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.conc %}
  (function () {
    const d = {{ model.charts.conc | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-conc"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[6], pal[2], pal[1], pal[0]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 64, bottom: 8, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.cats, inverse: true, axisLabel: { width: 90, overflow: "break" } },
      series: d.sizes.map((s, k) => ({ type: "bar", stack: "a", name: s, data: d.series[k] }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.ind %}
  (function () {
    const d = {{ model.charts.ind | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-ind"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(2) + " מיליארד דולר" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 8, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 110, overflow: "break" } },
      series: [
        { type: "bar", name: "יצוא", data: d.exp },
        { type: "bar", name: "יבוא", data: d.imp }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- for key in ["indsize_exp", "indsize_imp"] %}
{%- if model.flags[key] %}
  (function () {
    const d = {{ model.charts[key] | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById({{ ("chart-" ~ key | replace("_", "-")) | tojson }}));
    chart.setOption(window.GovEcharts.option({
      color: [pal[6], pal[2], pal[1], pal[0]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 64, bottom: 8, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 100, overflow: "break" } },
      series: d.sizes.map((s, k) => ({ type: "bar", stack: "a", name: s, data: d.series[k] }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- endfor %}
{%- if model.flags.indn %}
  (function () {
    const d = {{ model.charts.indn | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-indn"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") + " עסקים" },
      grid: { left: 16, right: 56, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: false }, splitLine: { show: false } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 110, overflow: "break" } },
      series: [{ type: "bar", name: "עסקים מייצאים", data: d.exp,
        label: { show: true, position: "right", formatter: (p) => Number(p.value).toLocaleString("he-IL") } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.region %}
  (function () {
    const d = {{ model.charts.region | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-region"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(2) + " מיליארד דולר" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 8, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 90, overflow: "break" } },
      series: [
        { type: "bar", name: "יצוא", data: d.exp },
        { type: "bar", name: "יבוא", data: d.imp }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.cty %}
  (function () {
    const d = {{ model.charts.cty | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-cty"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(2) + " מיליארד דולר" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 8, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 90, overflow: "break" } },
      series: [
        { type: "bar", name: "יצוא", data: d.exp },
        { type: "bar", name: "יבוא", data: d.imp }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.ctytrend %}
  (function () {
    const d = {{ model.charts.ctytrend | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-ctytrend"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1], pal[2], pal[5], pal[6], pal[8]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toFixed(2) + " מיליארד דולר" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 64, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", name: "מיליארד דולר" },
      series: d.names.map((n, k) => ({ type: "line", name: n, data: d.series[k], connectNulls: false }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.ctyn %}
  (function () {
    const d = {{ model.charts.ctyn | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-ctyn"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[2]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") + " עסקים" },
      grid: { left: 16, right: 56, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: false }, splitLine: { show: false } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 90, overflow: "break" } },
      series: [{ type: "bar", name: "עסקים מייצאים", data: d.exp,
        label: { show: true, position: "right", formatter: (p) => Number(p.value).toLocaleString("he-IL") } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
</script>
