    <div class="text-3xl font-bold text-{{ model.kpis.contracts.tone }} mb-1" dir="ltr">{{ model.kpis.contracts.display }}</div>
    <div class="text-sm text-subtle">חוזי נישואין במאגר</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.ytd.tone }} mb-1" dir="ltr">{{ model.kpis.ytd.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.ytd_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.ytd_change.tone }} mb-1" dir="ltr">{{ model.kpis.ytd_change.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.ytd_change_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.inherit.tone }} mb-1" dir="ltr">{{ model.kpis.inherit.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.inherit_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.consent.tone }} mb-1" dir="ltr">{{ model.kpis.consent.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.consent_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.lead.tone }} mb-1" dir="ltr">{{ model.kpis.lead.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.lead_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.registrars.tone }} mb-1" dir="ltr">{{ model.kpis.registrars.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.registrars_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
