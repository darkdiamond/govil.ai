  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cases_year_note }}</p>
  <div id="chart-cases-year" data-fallback="explorer" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.cases_year_aria }}"></div>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
