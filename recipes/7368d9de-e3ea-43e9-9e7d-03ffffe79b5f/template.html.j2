<script>
  (function () {
    var d = {{ model.charts.courts_year | tojson }};
    var c = echarts.init(document.getElementById("chart-courts"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 24, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value" },
      series: (function () {
        var pal = window.GOVIL_PALETTE || [], courts = [];
        return d.series.map(function (s) {
          var court = s.name.split(" · ")[1];
          if (courts.indexOf(court) < 0) { courts.push(court); }
          var col = pal[courts.indexOf(court) % (pal.length || 1)];
          var isCon = s.name.indexOf("חוזים") === 0;
          return { type: "line", name: s.name, data: s.data, symbol: isCon ? "rect" : "circle",
                   itemStyle: { color: col }, lineStyle: { color: col, type: isCon ? "dashed" : "solid" } };
        });
      })()
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

