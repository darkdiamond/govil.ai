{%- if model.flags.vintage %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מועד עדכון הרשומות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.vintage_lede }}</p>
  <div id="chart-vintage" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.vintage_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="depot-table mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.vintage_aria }}</caption>
      <thead><tr><th scope="col">חודש עדכון</th><th scope="col">רשומות</th></tr></thead>
      <tbody>
{%- for r in model.tables.vintage %}
        <tr><th scope="row">{{ r.ym }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
