      <caption class="sr-only">{{ model.labels.bands_aria }}</caption>
      <thead><tr><th scope="col">טווח גודל</th><th scope="col">מתחמים</th><th scope="col">לפי סטטוס</th></tr></thead>
      <tbody>
{%- for r in model.tables.bands %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.total }}</td><td>{{ r.parts }}</td></tr>
