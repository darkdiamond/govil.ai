  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="depot-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.shape_aria }}</caption>
        <thead><tr><th scope="col">מתחם</th><th scope="col">שטח (דונם)</th><th scope="col">היקף (מ׳)</th><th scope="col">מדד קומפקטיות</th></tr></thead>
        <tbody>
{%- for r in model.tables.depots %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.area }}</td><td>{{ r.perim }}</td><td>{{ r.compact }}</td></tr>
