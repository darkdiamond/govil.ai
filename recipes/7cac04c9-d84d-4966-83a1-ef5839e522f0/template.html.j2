{%- if model.flags.shape %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">צורת המתחם: שטח מול היקף</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.shape_lede }}</p>
