<h1>דיפו רק"ל: מתחמי תחזוקה ותפעול של הרכבת הקלה</h1>

<style>
  .depot-table th, .depot-table td { padding: 0.35rem 0.5rem; text-align: start; vertical-align: top; }
  .depot-table tbody tr { border-top: 1px solid #c3cfe7; }
</style>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור מתחם דיפו לפי שם או סטטוס ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: שם המתחם, סוג, סטטוס (קיים, בביצוע, מתוכנן), שטח בדונמים ומועד עדכון</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.count.tone }} mb-1" dir="ltr">{{ model.kpis.count.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.count_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.area.tone }} mb-1" dir="ltr">{{ model.kpis.area.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.area_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.ex_share.tone }} mb-1" dir="ltr">{{ model.kpis.ex_share.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.ex_share_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.largest.tone }} mb-1" dir="ltr">{{ model.kpis.largest.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.largest_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">שטח כל מתחם דיפו</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.depots_lede }}</p>
  <div id="chart-depots" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.depots_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="depot-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.depots_aria }}</caption>
        <thead><tr><th scope="col">מתחם</th><th scope="col">סטטוס</th><th scope="col">שטח (דונם)</th><th scope="col">שיעור מהשטח</th><th scope="col">היקף (מ׳)</th><th scope="col">עדכון</th></tr></thead>
        <tbody>
{%- for r in model.tables.depots %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.status }}</td><td>{{ r.area }}</td><td>{{ r.share }}</td><td>{{ r.perim }}</td><td>{{ r.ym }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">קיים, בביצוע או מתוכנן: מספר מתחמים מול שטח</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.status_lede }}</p>
  <div id="chart-status" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.status_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="depot-table mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.status_aria }}</caption>
      <thead><tr><th scope="col">סטטוס</th><th scope="col">מתחמים</th><th scope="col">שטח (דונם)</th><th scope="col">שיעור מהשטח</th><th scope="col">שטח ממוצע (דונם)</th></tr></thead>
      <tbody>
{%- for r in model.tables.status %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.area }}</td><td>{{ r.share }}</td><td>{{ r.avg }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

