<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">על המאגר</h2>
  </div>
  <p class="m-0 mb-2 text-sm leading-relaxed">דיפו הוא מתחם שבו חונים קרונות הרכבת הקלה בלילה ומתבצעות בו פעולות תחזוקה, ניקוי ותפעול. טבלת הנתונים כוללת לכל מתחם את שמו, סוגו, סטטוס התכנון, שטחו בדונמים, היקף ושטח הפוליגון במטרים ומועד העדכון. גבולות המתחמים עצמם נמצאים בקובצי ה-SHP וה-KML שברשימת ההורדות למטה.</p>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">תיאור מקורי: מתחמי תחזוקה ותפעול, קיימים ומתוכננים, של רכבת קלה</p>
</section>

<script>
  (function () {
    var el = document.getElementById("chart-depots");
    var d = {{ model.charts.depots | tojson }};
    var narrow = el.clientWidth < 500;
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        return echarts.format.encodeHTML(d.names[i]) + "<br>" + echarts.format.encodeHTML(d.status[i]) +
          ": " + d.area[i] + " דונם<br>חציון המתחמים: " + d.median + " דונם";
      } },
      grid: { left: 16, right: 48, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "value", name: "דונם", nameLocation: "end", splitNumber: narrow ? 3 : 5,
               axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: d.names, inverse: true,
               axisLabel: { formatter: function (v) {
                 var m = v.match(/^(.*) (\([^)]*\))$/);
                 var base = m ? m[1] : v, suf = m ? " " + m[2] : "";
                 var max = narrow ? 14 : 30;
                 if (base.length > max) { base = base.slice(0, max - 1) + "…"; }
                 return base + suf;
               } } },
      series: [{
        type: "bar", name: "שטח (דונם)",
        data: d.area.map(function (v, i) { return { value: v, itemStyle: { color: d.colors[i] } }; }),
        label: { show: true, position: "right" },
        markLine: { symbol: "none", silent: true, label: { show: false },
                    lineStyle: { color: "#6c757d", type: "dashed" }, data: [{ xAxis: d.median }] }
      }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.status | tojson }};
    var c = echarts.init(document.getElementById("chart-status"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        var i = p.seriesIndex;
        var isArea = p.dataIndex === 1;
        return echarts.format.encodeHTML(d.names[i]) + ": " +
          (isArea ? d.area[i] + " דונם (" + d.area_share[i] + "%)" : d.count[i] + " מתחמים (" + d.count_share[i] + "%)");
      } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "value", max: 100, splitNumber: 4, axisLabel: { formatter: "{value}%", hideOverlap: true } },
      yAxis: { type: "category", data: ["מספר מתחמים", "שטח"] },
      series: d.names.map(function (n, i) {
        return { type: "bar", stack: "s", name: n, barWidth: 36,
                 itemStyle: { color: d.colors[i] },
                 data: [d.count_share[i], d.area_share[i]],
                 label: { show: true, formatter: function (p) { return p.value >= 8 ? p.value + "%" : ""; },
                          color: i === d.names.length - 1 ? "#0c3058" : "#ffffff" } };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var el = document.getElementById("chart-lines");
    if (!el) { return; }
    var d = {{ model.charts.lines | tojson }};
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 40, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "value", name: "דונם", splitNumber: el.clientWidth < 500 ? 3 : 5, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { interval: 0 } },
      series: d.statuses.map(function (s, i) {
        return { type: "bar", stack: "l", name: s, itemStyle: { color: d.colors[i] },
                 data: d.series[i].map(function (v) { return v > 0 ? v : null; }) };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.bands | tojson }};
    var c = echarts.init(document.getElementById("chart-bands"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: d.names,
               axisLabel: { interval: 0, fontSize: 11, lineHeight: 14,
                            formatter: function (v) { return v.replace(" ", "\n"); } } },
      yAxis: { type: "value", name: "מתחמים", minInterval: 1, axisLabel: { hideOverlap: true } },
      series: d.statuses.map(function (s, i) {
        return { type: "bar", stack: "b", name: s, itemStyle: { color: d.colors[i] }, data: d.series[i] };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var el = document.getElementById("chart-shape");
    if (!el) { return; }
    var d = {{ model.charts.shape | tojson }};
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        var v = p.data;
        return echarts.format.encodeHTML(v[3]) + "<br>" + v[1] + " דונם, היקף " + v[0] +
          " מ׳<br>מדד קומפקטיות: " + v[2];
      } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 32, bottom: 64, containLabel: true },
      xAxis: { type: "value", name: "היקף (מ׳)", nameLocation: "middle", nameGap: 28, scale: true,
               splitNumber: el.clientWidth < 500 ? 3 : 5, axisLabel: { hideOverlap: true } },
      yAxis: { type: "value", name: "שטח (דונם)", axisLabel: { hideOverlap: true } },
      series: d.statuses.map(function (s, i) {
        return { type: "scatter", name: s, symbolSize: 14, itemStyle: { color: d.colors[i], borderColor: "#0b3668" },
                 data: d.points.filter(function (pt) { return pt[4] === s; }) };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var el = document.getElementById("chart-vintage");
    if (!el) { return; }
    var d = {{ model.charts.vintage | tojson }};
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { interval: d.x.length <= 6 ? 0 : "auto", hideOverlap: true } },
      yAxis: { type: "value", name: "רשומות", minInterval: 1, axisLabel: { hideOverlap: true } },
      series: [{ type: "bar", name: "רשומות", data: d.y, barMaxWidth: 64, label: { show: true, position: "top" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
