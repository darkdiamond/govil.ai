    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">שטח דיפו לפי קו רכבת קלה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.lines_lede }}</p>
  <div id="chart-lines" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.lines_aria }}"></div>
