<script>
  (function () {
    var d = {{ model.charts.timeline | tojson }};
    var c = echarts.init(document.getElementById("chart-timeline"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0, type: "scroll" },
      grid: { left: 8, right: 8, top: 36, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { hideOverlap: true } },
      yAxis: [{ type: "value", name: "התקנות" },
              { type: "value", max: 100, axisLabel: { formatter: "{value}%" }, splitLine: { show: false } }],
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 18 }],
      series: [
        { type: "bar", name: "התקנות", data: d.y },
        { type: "line", name: "שיעור מצטבר", yAxisIndex: 1, data: d.cum, showSymbol: false,
          lineStyle: { color: "#0b3668", width: 2 }, itemStyle: { color: "#0b3668" },
          tooltip: { valueFormatter: function (v) { return v + "%"; } } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.cats | tojson }};
    var c = echarts.init(document.getElementById("chart-cats"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 2, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 150, overflow: "truncate" } },
      series: [{ type: "bar", name: "כלי רכב", data: d.values.slice().reverse() }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var P = window.GOVIL_PALETTE;
    var CAT = [P[0], P[2], P[5], P[1], P[6], P[7], P[3], P[4], P[8], P[9]];
    function stacked(id, d, zoom) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: CAT,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { top: 0, type: "scroll" },
        grid: { left: 8, right: 8, top: 36, bottom: zoom ? 56 : 16, containLabel: true },
        xAxis: { type: "category", data: d.x, axisLabel: { hideOverlap: true } },
        yAxis: { type: "value" },
        dataZoom: zoom ? [{ type: "inside" }, { type: "slider", bottom: 8, height: 18 }] : [],
        series: d.series.map(function (s) { return { type: "bar", stack: "t", name: s.name, data: s.data }; })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    stacked("chart-yearcat", {{ model.charts.year_cat | tojson }}, false);
    stacked("chart-makeyear", {{ model.charts.make_year | tojson }}, true);
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.wave | tojson }};
    var P = window.GOVIL_PALETTE;
    var c = echarts.init(document.getElementById("chart-wave"));
    c.setOption(window.GovEcharts.option({
      color: [P[0], P[2], P[5], P[1], P[6], P[7], P[3], P[4], P[8], P[9]],
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      legend: { top: 0, type: "scroll" },
      grid: { left: 8, right: 8, top: 36, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { hideOverlap: true } },
      yAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 18 }],
      series: d.series.map(function (s) { return { type: "line", name: s.name, data: s.data, showSymbol: false }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var b = {{ model.charts.box | tojson }};
    var c = echarts.init(document.getElementById("chart-age"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        var v = p.data.value || p.data;
        var o = v.length > 5 ? v.slice(1) : v;
        return p.name + "<br>חציון: " + o[2] + " שנים<br>רבעונים: " + o[1] + " עד " + o[3] + "<br>אחוזון 5 עד 95: " + o[0] + " עד " + o[4];
      } },
      grid: { left: 8, right: 16, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: b.names },
      yAxis: { type: "value", name: "שנים" },
      series: [{ type: "boxplot", name: "גיל בהתקנה", data: b.data,
                 itemStyle: { color: "#dbe8fb", borderColor: "#0068f5" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    function bars(id, d, name, rotate) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 8, top: 16, bottom: 16, containLabel: true },
        xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, rotate: rotate, fontSize: 11 } },
        yAxis: { type: "value" },
        series: [{ type: "bar", name: name, data: d.values }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    bars("chart-agehist", {{ model.charts.agehist | tojson }}, "כלי רכב", 0);
    bars("chart-weekday", {{ model.charts.weekday | tojson }}, "התקנות", 0);
  })();
</script>

<script>
  (function () {
    function hbar(id, d, name) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 2, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 150, overflow: "truncate" } },
        series: [{ type: "bar", name: name, data: d.values.slice().reverse() }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    hbar("chart-days", {{ model.charts.days | tojson }}, "התקנות");
    hbar("chart-lag", {{ model.charts.lag | tojson }}, "כלי רכב");
  })();
</script>
