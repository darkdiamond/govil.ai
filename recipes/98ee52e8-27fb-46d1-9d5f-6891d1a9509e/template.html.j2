        <caption class="sr-only">{{ model.labels.age_aria }}</caption>
        <thead><tr><th scope="col">קטגוריה</th><th scope="col">כלי רכב</th><th scope="col">{{ model.labels.q5_head }}</th><th scope="col">רבעון תחתון</th><th scope="col">חציון</th><th scope="col">רבעון עליון</th><th scope="col">{{ model.labels.q95_head }}</th></tr></thead>
