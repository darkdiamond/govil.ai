<h1>כלי רכב שמותקנים בהם מסננים לצמצום פליטת מזהמים</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.total_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.peak.tone }} mb-1" dir="ltr">{{ model.kpis.peak.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.peak_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.age.tone }} mb-1" dir="ltr">{{ model.kpis.age.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.age_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.vintage.tone }} mb-1" dir="ltr">{{ model.kpis.vintage.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.vintage_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

{% macro simple_table(rows, caption, head, val, share="שיעור (%)") -%}
<details class="mt-3">
  <summary class="text-sm text-subtle">הצג כטבלה</summary>
  <table class="mt-2 w-full text-sm">
    <caption class="sr-only">{{ caption }}</caption>
    <thead><tr><th scope="col">{{ head }}</th><th scope="col">{{ val }}</th><th scope="col">{{ share }}</th></tr></thead>
    <tbody>
{%- for r in rows %}
      <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
    </tbody>
  </table>
</details>
{%- endmacro %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">התקנות לאורך זמן</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.tl_note }}</p>
  <div id="chart-timeline" data-fallback="explorer" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.tl_aria }}"></div>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">קטגוריית הרכב</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cats_note }}</p>
    <div id="chart-cats" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.cats_aria }}"></div>
    {{ simple_table(model.tables.cats, model.labels.cats_aria, "קטגוריה", "כלי רכב") }}
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">התקנות לפי שנה וקטגוריה</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.yc_note }}</p>
    <div id="chart-yearcat" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.yc_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.yc_caption }}</caption>
        <thead><tr><th scope="col">שנה</th><th scope="col">סך הכול</th>{% for c in model.tables.cat_cols %}<th scope="col">{{ c }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in model.tables.year_cat %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.total }}</td>{% for v in r.cols %}<td>{{ v }}</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
      </div>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">גלי ההתקנה בכל קטגוריה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.wave_note }}</p>
  <div id="chart-wave" data-fallback="explorer" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.wave_aria }}"></div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">שנת הייצור</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.my_note }}</p>
  <div id="chart-makeyear" data-fallback="explorer" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.my_aria }}"></div>
