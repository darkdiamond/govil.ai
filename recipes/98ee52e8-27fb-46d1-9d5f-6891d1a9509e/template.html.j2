<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">התאריכים העמוסים ביותר</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.days_note }}</p>
  <div id="chart-days" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.days_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.days_aria }}</caption>
      <thead><tr><th scope="col">תאריך</th><th scope="col">התקנות</th><th scope="col">שיעור מכלל ההתקנות (%)</th><th scope="col">קטגוריה עיקרית</th><th scope="col">שיעורה ביום זה (%)</th></tr></thead>
      <tbody>
{%- for r in model.tables.days %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td><td>{{ r.cat }}</td><td>{{ r.cat_share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
