{% import "gov.j2" as gov %}
{%- macro callout(key) -%}
{%- if model.callouts[key] is defined %}
  <p class="m-0 mb-3 text-sm font-semibold text-ink-deep">{{ model.callouts[key] }}</p>
{%- endif %}
{%- endmacro %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסמה {{ model.release.date }}</p>
{%- if model.release.headline %}
  <p class="m-0 mb-3 font-semibold text-ink-deep">{{ model.release.headline }}</p>
{%- endif %}
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["out", "outchg", "qty", "income", "comp"] %}
{%- if model.kpis[key] is defined %}
  {{ gov.kpi(model.kpis[key], model.labels[key ~ "_kpi"]) }}
{%- endif %}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

<section class="card p-5 mb-6">
  {{ gov.head("database", "חשבון ענף החקלאות: מתפוקה להכנסה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.account_note }}</p>
  {{ gov.chart("chart-account", model.labels.account_aria, "h-72 md:h-80") }}
  {{ gov.table("חשבון ענף החקלאות", model.labels.account_cols, model.tables.account, ltr=(1, 2, 3)) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("trending-up", "תפוקה, תשומה והכנסה לאורך השנים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.trend_note }}</p>
  {{ gov.chart("chart-trend", model.labels.trend_aria, "h-64 md:h-80") }}
  {{ gov.table("תפוקה, תשומה והכנסה מחקלאות לפי שנה (מיליארדי ש\"ח)", model.labels.trend_cols, model.tables.trend, ltr=range(1, model.labels.trend_cols | length) | list) }}
</section>

{%- if model.flags.branches %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "ערך התפוקה החקלאית לפי ענף") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.branches_note }}</p>
  {{ callout("split") }}
  {{ gov.chart("chart-branches", model.labels.branches_aria, "h-80 md:h-[460px]") }}
  {{ gov.table("ערך התפוקה החקלאית לפי ענף", model.labels.branches_cols, model.tables.branches, ltr=(1, 2, 3)) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("trending-up", "הענפים לאורך השנים") }}
  <p class="m-0 text-sm text-subtle mb-3">ערך התפוקה של כל ענף בכל שנה, מיליוני ש"ח במחירים שוטפים. אפשר להוסיף ולהסתיר ענפים במקרא.</p>
  {{ callout("mover") }}
  {{ gov.chart("chart-btrend", model.labels.btrend_aria, "h-80 md:h-96") }}
  {{ gov.table("ערך התפוקה לפי ענף ושנה (מיליוני ש\"ח)", model.labels.btrend_cols, model.tables.btrend, ltr=range(1, model.labels.btrend_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.pq %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "מחירים או כמויות: מה הזיז כל ענף") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.pq_note }}</p>
  {{ callout("drivers") }}
  {{ gov.chart("chart-pq", model.labels.pq_aria, "h-80 md:h-[460px]") }}
  {{ gov.table("שינוי המחירים והכמויות לפי ענף", model.labels.pq_cols, model.tables.pq, ltr=(1, 2)) }}
</section>
{%- endif %}

{%- if model.flags.inputs %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "התשומות בחקלאות: על מה מוציאים החקלאים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.inputs_note }}</p>
  {{ callout("fodder") }}{{ callout("inputs") }}
  {{ gov.chart("chart-inputs", model.labels.inputs_aria, "h-72 md:h-96") }}
  {{ gov.table("התשומה הקנויה בחקלאות לפי סוג", model.labels.inputs_cols, model.tables.inputs, ltr=(1, 2, 3, 4)) }}
</section>
{%- endif %}

{%- if model.flags.comp %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "פיצויים ותקבולים לחקלאים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.comp_note }}</p>
  {{ callout("comp") }}
  {{ gov.chart("chart-comp", model.labels.comp_aria, "h-64 md:h-80") }}
  {{ gov.table("פיצויים ותקבולים לחקלאים לפי סוג (מיליוני ש\"ח)", model.labels.comp_cols, model.tables.comp, ltr=range(1, model.labels.comp_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.long %}
<section class="card p-5 mb-6">
  {{ gov.head("trending-up", "השינוי השנתי בערך התפוקה לאורך זמן") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.long_note }}</p>
  {{ callout("long") }}
  {{ gov.chart("chart-long", model.labels.long_aria, "h-72 md:h-96") }}
  {{ gov.table("אחוז השינוי השנתי בערך התפוקה החקלאית", model.labels.long_cols, model.tables.long, ltr=range(1, model.labels.long_cols | length) | list) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>הנתונים מתוך ההודעה השנתית לתקשורת של הלשכה המרכזית לסטטיסטיקה על החקלאות בישראל. כל הסכומים במחירים שוטפים (ממוצע מחירי כל שנה), ללא ניכוי האינפלציה.</li>
    <li>התפוקה כוללת תוצרת ביניים (למשל מספוא שגודל במשק ושימש להזנת בעלי חיים) ואינה כוללת את ענף הגינון. התשומה אינה כוללת תמורה למשרות שכיר.</li>
    <li>"השינוי בכמות" הוא השינוי בהיקף הייצור כשמנטרלים את השינוי במחירים, ו"השינוי במחיר" הוא השינוי במחירים שקיבלו או שילמו החקלאים.</li>
    <li>נתוני השנה האחרונה ראשוניים, והלמ"ס מעדכנת את השנים הקודמות בכל הודעה. העמוד משלב את ההודעות האחרונות ומציג לכל שנה את הנתון העדכני ביותר.</li>
  </ul>
</section>

<script>
  (function () {
    const d = {{ model.charts.account | tojson }};
    const pal = window.GOVIL_PALETTE;
    const col = { in: pal[0], out: "#6c757d", sum: pal[1] };
    const chart = echarts.init(document.getElementById("chart-account"));
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + " מיליארד ש\"ח" },
      grid: { left: 16, right: 56, top: 8, bottom: 16, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: (v) => Number(v).toLocaleString("he-IL") } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 120, overflow: "break", fontSize: 11 } },
      series: [{ type: "bar", name: "מיליארד ש\"ח",
        data: d.values.map((v, i) => ({ value: v, itemStyle: { color: col[d.kind[i]] } })),
        label: { show: true, position: "right", formatter: (p) => Number(p.value).toFixed(1) } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.trend | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-trend"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], "#6c757d", pal[1]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + " מיליארד ש\"ח" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 56, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: (v) => Number(v).toLocaleString("he-IL") } },
      series: d.series.map((s) => ({ type: "line", name: s.name, data: s.data, symbolSize: 8, lineStyle: { width: 3 } }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- if model.flags.branches %}
  (function () {
    const d = {{ model.charts.branches | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-branches"));
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Math.round(v).toLocaleString("he-IL") + " מיליון ש\"ח" },
      grid: { left: 16, right: 56, top: 8, bottom: 16, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: (v) => Number(v).toLocaleString("he-IL") } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 120, overflow: "break", fontSize: 11 } },
      series: [{ type: "bar", name: "ערך התפוקה",
        data: d.values.map((v, i) => ({ value: v, itemStyle: { color: d.group[i] === "crops" ? pal[0] : pal[1] } })),
        label: { show: true, position: "right", formatter: (p) => Math.round(p.value).toLocaleString("he-IL") } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.btrend | tojson }};
    const pal = window.GOVIL_PALETTE;
    const sel = {};
    d.series.forEach((s, i) => { sel[s.name] = i < 6; });
    const chart = echarts.init(document.getElementById("chart-btrend"));
    chart.setOption(window.GovEcharts.option({
      color: pal,
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Math.round(v).toLocaleString("he-IL") + " מיליון ש\"ח" },
      legend: { type: "scroll", top: 0, selected: sel },
      grid: { left: 16, right: 16, top: 48, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: (v) => Number(v).toLocaleString("he-IL") } },
      series: d.series.map((s) => ({ type: "line", name: s.name, data: s.data, symbolSize: 7, lineStyle: { width: 2.5, type: s.group === "crops" ? "solid" : "dashed" } }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.pq %}
  (function () {
    const d = {{ model.charts.pq | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-pq"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 24, top: 36, bottom: 16, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: (v) => v + "%" } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 120, overflow: "break", fontSize: 11 } },
      series: [
        { type: "bar", name: "שינוי במחיר", data: d.price },
        { type: "bar", name: "שינוי בכמות", data: d.qty }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.inputs %}
  (function () {
    const d = {{ model.charts.inputs | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-inputs"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Math.round(v).toLocaleString("he-IL") + " מיליון ש\"ח" },
      grid: { left: 16, right: 56, top: 8, bottom: 16, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: (v) => Number(v).toLocaleString("he-IL") } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 120, overflow: "break", fontSize: 11 } },
      series: [{ type: "bar", name: "תשומה קנויה", data: d.values,
        label: { show: true, position: "right", formatter: (p) => Math.round(p.value).toLocaleString("he-IL") } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.comp %}
  (function () {
    const d = {{ model.charts.comp | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-comp"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[1], pal[0], pal[6], pal[5], pal[2]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toFixed(2) + " מיליארד ש\"ח" },
      legend: { type: "scroll", top: 0 },
      grid: { left: 16, right: 16, top: 48, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: (v) => Number(v).toLocaleString("he-IL") } },
      series: d.series.map((s) => ({ type: "bar", stack: "c", name: s.name, data: s.data }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.long %}
  (function () {
    const d = {{ model.charts.long | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-long"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2], pal[1]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 48, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: (v) => v + "%" } },
      series: d.series.map((s, i) => i === 0
        ? { type: "bar", name: s.name, data: s.data.map((v) => ({ value: v, itemStyle: { color: v != null && v < 0 ? "#dc3545" : pal[0] } })) }
        : { type: "line", name: s.name, data: s.data, showSymbol: false, lineStyle: { width: 2 } })
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
</script>
