<script>
  (function () {
    var d = {{ model.charts.types | tojson }};
    var pal = window.GOVIL_PALETTE;
    var c = echarts.init(document.getElementById("chart-types"));
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true, fontSize: 10 } },
      yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 150, overflow: "truncate" } },
      series: [{ type: "bar", name: "כלי רכב", data: d.values.map(function (v, i) {
        return { value: v, itemStyle: { color: pal[d.seg_idx[i] % pal.length] } };
      }).reverse() }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    function stacked(id, d, horizontal) {
      var c = echarts.init(document.getElementById(id));
      var cat = { type: "category", data: horizontal ? d.names.slice().reverse() : d.x,
                  axisLabel: horizontal ? { width: 120, overflow: "truncate" } : { hideOverlap: true, fontSize: 10 } };
      var val = { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true, fontSize: 10 } };
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: { bottom: 0 },
        grid: { left: 8, right: 16, top: 16, bottom: 48, containLabel: true },
        xAxis: horizontal ? val : cat,
        yAxis: horizontal ? cat : val,
        series: d.series.map(function (s) {
          return { type: "bar", stack: "t", name: s.name, data: horizontal ? s.data.slice().reverse() : s.data };
        })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    function hbar(id, d, name, w) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true, fontSize: 10 } },
        yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: w ? (window.innerWidth < 500 ? 120 : w) : 140, overflow: "truncate" } },
        series: [{ type: "bar", name: name, data: d.values.slice().reverse() }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    stacked("chart-years", {{ model.charts.years | tojson }}, false);
    stacked("chart-seats", {{ model.charts.seats | tojson }}, false);
    stacked("chart-colors", {{ model.charts.colors | tojson }}, true);
    stacked("chart-status", {{ model.charts.status | tojson }}, true);
    hbar("chart-taxi-brands", {{ model.charts.taxi_brands | tojson }}, "מוניות");
    hbar("chart-bus-brands", {{ model.charts.bus_brands | tojson }}, "אוטובוסים");
    hbar("chart-taxi-models", {{ model.charts.taxi_models | tojson }}, "מוניות", 170);
    hbar("chart-bus-models", {{ model.charts.bus_models | tojson }}, "אוטובוסים", 170);
  })();
</script>

<script>
  (function () {
    var b = {{ model.charts.box | tojson }};
    var c = echarts.init(document.getElementById("chart-box"));
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "item", formatter: function (p) {
        var v = p.data.value || p.data;
        var o = v.length > 5 ? v.slice(1) : v;
        return p.name + "<br>חציון: " + o[2] + "<br>רבעונים: \u2066" + o[1] + "–" + o[3] + "\u2069<br>אחוזון 5 עד 95: \u2066" + o[0] + "–" + o[4] + "\u2069";
      } },
      grid: { left: 8, right: 16, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", scale: true, name: "שנת ייצור", nameLocation: "middle", nameGap: 28,
               axisLabel: { fontSize: 10, hideOverlap: true, formatter: function (v) { return String(v); } } },
      yAxis: { type: "category", data: b.names, axisLabel: { width: 140, overflow: "truncate" } },
      series: [{ type: "boxplot", name: "שנת ייצור", data: b.data,
                 itemStyle: { color: "#dbe8fb", borderColor: "#0068f5" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.country | tojson }};
    var c = echarts.init(document.getElementById("chart-country"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0, type: "scroll" },
      grid: { left: 8, right: 16, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.x, boundaryGap: false, axisLabel: { hideOverlap: true, fontSize: 10 } },
      yAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      series: d.series.map(function (s) {
        return { type: "line", stack: "t", name: s.name, data: s.data, showSymbol: false, areaStyle: {}, lineStyle: { width: 1 } };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
