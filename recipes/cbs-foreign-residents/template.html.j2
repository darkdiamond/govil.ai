{% import "gov.j2" as gov %}
{%- macro callout(key) -%}
{%- if model.callouts[key] is defined %}
  <p class="m-0 mb-3 text-sm font-semibold text-ink-deep">{{ model.callouts[key] }}</p>
{%- endif %}
{%- endmacro %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסמה {{ model.release.date }}</p>
{%- if model.release.headline %}
  <p class="m-0 mb-3 font-semibold text-ink-deep">{{ model.release.headline }}</p>
{%- endif %}
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["workers", "change", "top", "women", "overstay", "students"] %}
{%- if model.kpis[key] is defined %}
  {{ gov.kpi(model.kpis[key], model.labels[key ~ "_kpi"]) }}
{%- endif %}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

{%- if model.flags.cit %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "עובדים זרים לפי ארץ אזרחות") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cit_note }}</p>
  {{ callout("countries") }}{{ callout("cit_growth") }}
  {{ gov.chart("chart-cit", model.labels.cit_aria, "h-[480px]") }}
  {{ gov.table("עובדים מחו\"ל לפי ארץ אזרחות (אלפים)", model.labels.cit_cols, model.tables.cit, ltr=range(1, model.labels.cit_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.ind %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "עובדים זרים לפי ענף העסקה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.ind_note }}</p>
  {{ callout("ind_lead") }}{{ callout("ind_growth") }}
  {{ gov.chart("chart-ind", model.labels.ind_aria, "h-72 md:h-80") }}
  {{ gov.table("עובדים מחו\"ל לפי ענף העסקה (אלפים)", model.labels.ind_cols, model.tables.ind, ltr=range(1, model.labels.ind_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.sex %}
<section class="card p-5 mb-6">
  {{ gov.head("chart-bar", "גברים ונשים לפי ארץ אזרחות") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.sex_note }}</p>
  {{ callout("sex") }}
  {{ gov.chart("chart-sex", model.labels.sex_aria, "h-[560px]") }}
  {{ gov.table("עובדים מחו\"ל לפי מין וארץ אזרחות (אחוזים)", ["ארץ אזרחות", "גברים", "נשים"], model.tables.sex, ltr=(1, 2)) }}
</section>
{%- endif %}

{%- if model.flags.loc %}
<section class="card p-5 mb-6">
  {{ gov.head("map-pin", "היכן גרים העובדים הזרים: יישובים עיקריים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.loc_note }}</p>
  {{ callout("loc") }}
  {{ gov.chart("chart-loc", model.labels.loc_aria, "h-[560px]") }}
  {{ gov.table("עובדים מחו\"ל ביישובים עיקריים לפי ענף (אלפים)", model.labels.loc_cols, model.tables.loc, ltr=range(1, model.labels.loc_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.ov_year %}
<section class="card p-5 mb-6">
  {{ gov.head("calendar", "תיירים ללא רישיון בתוקף לפי שנת הכניסה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.ov_year_note }}</p>
  {{ callout("ov_year") }}
  {{ gov.chart("chart-ovyear", model.labels.ov_year_aria, "h-72 md:h-80") }}
  {{ gov.table("תיירים ללא רישיון בתוקף לפי שנת הכניסה", ["שנת כניסה", "תיירים", "חלק מהסך"], model.tables.ov_year, ltr=(0, 1, 2)) }}
</section>
{%- endif %}

{%- if model.flags.ov_age %}
<section class="card p-5 mb-6">
  {{ gov.head("chart-bar", "תיירים ללא רישיון בתוקף לפי גיל ומין") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.ov_age_note }}</p>
  {{ callout("ov_age") }}
  {{ gov.chart("chart-ovage", model.labels.ov_age_aria, "h-[460px]") }}
  {{ gov.table("תיירים ללא רישיון בתוקף לפי גיל ומין", ["גיל", "גברים", "נשים"], model.tables.ov_age, ltr=(0, 1, 2)) }}
</section>
{%- endif %}

{%- if model.flags.students %}
<section class="card p-5 mb-6">
  {{ gov.head("chart-bar", "סטודנטים יהודים זרים ובני משפחותיהם") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.students_note }}</p>
  {{ callout("students") }}
  {{ gov.chart("chart-students", model.labels.students_aria, "h-[420px]") }}
  {{ gov.table("סטודנטים יהודים זרים ובני משפחותיהם לפי גיל ומין", ["גיל", "גברים", "נשים"], model.tables.students, ltr=(0, 1, 2)) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>הנתונים מתוך ההודעה השנתית לתקשורת של הלשכה המרכזית לסטטיסטיקה על התושבים הזרים בישראל. כל הודעה מתארת את מצב התושבים הזרים בשנה אחת.</li>
    <li>"תושבים זרים המחזיקים ברישיון עבודה" הם עובדים מחו"ל שהיה להם רישיון עבודה בישראל במהלך השנה. מספרי העובדים מוצגים באלפים, כפי שפורסמו.</li>
    <li>התרשימים בהודעה משתנים משנה לשנה. העמוד מציג לכל נושא את ההודעה העדכנית ביותר שכוללת אותו, ומציין את השנה שאליה הנתונים מתייחסים. ההשוואה בין שנים מבוססת על שתי ההודעות האחרונות.</li>
  </ul>
</section>

<script>
{%- if model.flags.cit %}
  (function () {
    const d = {{ model.charts.cit | tojson }};
    const pal = window.GOVIL_PALETTE;
    const fmt = (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) + " אלף";
    const series = [];
    if (d.prev) series.push({ type: "bar", name: d.prev_year, data: d.prev, itemStyle: { color: pal[6] } });
    series.push({ type: "bar", name: d.year, data: d.cur, itemStyle: { color: pal[0] },
      label: { show: true, position: "right", formatter: (p) => p.value == null ? "" : Number(p.value).toLocaleString("he-IL", { maximumFractionDigits: 1 }) } });
    const chart = echarts.init(document.getElementById("chart-cit"));
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: fmt },
      legend: { top: 0 },
      grid: { left: 16, right: 48, top: 32, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: false }, splitLine: { show: false } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 90, overflow: "break" } },
      series: series
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.ind %}
  (function () {
    const d = {{ model.charts.ind | tojson }};
    const pal = window.GOVIL_PALETTE;
    const fmt = (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) + " אלף";
    const series = [];
    if (d.prev) series.push({ type: "bar", name: d.prev_year, data: d.prev, itemStyle: { color: pal[6] } });
    series.push({ type: "bar", name: d.year, data: d.cur, itemStyle: { color: pal[0] },
      label: { show: true, position: "top", formatter: (p) => p.value == null ? "" : Number(p.value).toLocaleString("he-IL", { maximumFractionDigits: 1 }) } });
    const chart = echarts.init(document.getElementById("chart-ind"));
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: fmt },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 8, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: { interval: 0 } },
      yAxis: { type: "value", axisLabel: { formatter: (v) => v + " אלף" } },
      series: series
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.sex %}
  (function () {
    const d = {{ model.charts.sex | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-sex"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[5]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 8, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 90, overflow: "break" } },
      series: [
        { type: "bar", stack: "a", name: "גברים", data: d.men },
        { type: "bar", stack: "a", name: "נשים", data: d.women }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.loc %}
  (function () {
    const d = {{ model.charts.loc | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-loc"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[5], pal[2], pal[6], pal[8]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 1 }) + " אלף" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: (v) => v + " אלף" } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 90, overflow: "break" } },
      series: d.inds.map((n, k) => ({ type: "bar", stack: "a", name: n, data: d.series[k] }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.ov_year %}
  (function () {
    const d = {{ model.charts.ov_year | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-ovyear"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") + " תיירים" },
      grid: { left: 16, right: 16, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value" },
      series: [{ type: "bar", name: "תיירים ללא רישיון בתוקף", data: d.y }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- for key, cid in [("ov_age", "chart-ovage"), ("students", "chart-students")] %}
{%- if model.flags[key] %}
  (function () {
    const d = {{ model.charts[key] | tojson }};
    const pal = window.GOVIL_PALETTE;
    const fmt = (v) => v == null ? "" : Math.abs(Number(v)).toLocaleString("he-IL");
    const chart = echarts.init(document.getElementById("{{ cid }}"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[5]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: fmt },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: fmt } },
      yAxis: { type: "category", data: d.ages, axisTick: { show: false } },
      series: [
        { type: "bar", stack: "a", name: "גברים", data: d.men.map((v) => -v) },
        { type: "bar", stack: "a", name: "נשים", data: d.women }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- endfor %}
</script>
