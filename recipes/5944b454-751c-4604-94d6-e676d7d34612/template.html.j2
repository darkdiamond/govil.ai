<h1>עצים</h1>
{%- macro head(icon, title) %}
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/{{ icon }}.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ title }}</h2>
  </div>
{%- endmacro %}

<section class="card p-5 mb-6">
  {{ head("info", "תקציר") }}
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
{%- for key in ["total", "documented", "species", "neigh"] %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.kpis[key].label }}</div>
  </div>
{%- endfor %}
</div>

<section class="card p-5 mb-6">
  {{ head("circle-check", "תובנות עיקריות") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  {{ head("map-pin", "מפת העצים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.map_note }}</p>
  <div id="map-main" class="h-72 md:h-[420px]"></div>
</section>
{% if model.flags.has_species %}
<section class="card p-5 mb-6">
  {{ head("database", "המינים הנפוצים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.species_note }}</p>
  <div id="chart-species" class="h-72 md:h-[420px]" role="img" aria-label="{{ model.labels.species_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.species_caption }}</caption>
      <thead><tr><th scope="col">מין</th><th scope="col">עצים</th><th scope="col">שיעור</th><th scope="col">מצטבר</th></tr></thead>
      <tbody>
{%- for r in model.tables.species %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td><td>{{ r.cum }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{% endif %}
{% if model.flags.has_genus %}
<section class="card p-5 mb-6">
  {{ head("database", "קבוצות מינים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.genus_note }}</p>
  <div id="chart-genus" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.genus_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.genus_caption }}</caption>
      <thead><tr><th scope="col">קבוצה</th><th scope="col">עצים</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.genus %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{% endif %}
{% if model.flags.has_neigh %}
<section class="card p-5 mb-6">
  {{ head("database", "עצים לפי שכונה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.neigh_note }}</p>
  <div id="chart-neigh" class="h-72 md:h-[420px]" role="img" aria-label="{{ model.labels.neigh_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.neigh_caption }}</caption>
      <thead><tr><th scope="col">שכונה</th><th scope="col">עצים</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.neigh %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{% endif %}
{% if model.flags.has_mix %}
<section class="card p-5 mb-6">
  {{ head("database", "הרכב המינים בשכונות") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.mix_note }}</p>
  <div id="chart-mix" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.mix_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.mix_caption }}</caption>
      <thead><tr><th scope="col">שכונה</th>{% for c in model.tables.mix.cols %}<th scope="col">{{ c }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for r in model.tables.mix.rows %}
        <tr><th scope="row">{{ r.name }}</th>{% for v in r.vals %}<td>{{ v }}</td>{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>
{% endif %}
{% if model.flags.has_rich %}
<section class="card p-5 mb-6">
  {{ head("database", "מגוון המינים בשכונות") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.rich_note }}</p>
  <div id="chart-rich" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.rich_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.rich_caption }}</caption>
      <thead><tr><th scope="col">שכונה</th><th scope="col">מינים</th><th scope="col">עצים מתועדים</th></tr></thead>
      <tbody>
{%- for r in model.tables.rich %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.species }}</td><td>{{ r.trees }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{% endif %}
{% if model.flags.has_streets %}
<section class="card p-5 mb-6">
  {{ head("database", "הרחובות עם הכי הרבה עצים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.streets_note }}</p>
  <div id="chart-streets" class="h-72 md:h-[420px]" role="img" aria-label="{{ model.labels.streets_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.streets_caption }}</caption>
      <thead><tr><th scope="col">רחוב</th><th scope="col">עצים</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.streets %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{% endif %}

<section class="card p-5 mb-6">
  {{ head("database", "כמה מהמאגר מתועד") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.fields_note }}</p>
  <div id="chart-fields" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.fields_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.fields_caption }}</caption>
      <thead><tr><th scope="col">שדה</th><th scope="col">רשומות</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.fields %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<script>
  (function () {
    var d = {{ model.charts.map | tojson }};
    var el = document.getElementById("map-main");
    if (!el || !window.L) { return; }
    var map = L.map(el, { center: [31.25, 34.79], zoom: 12, zoomSnap: 0.25, scrollWheelZoom: false });
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 18, attribution: "© OpenStreetMap"
    }).addTo(map);
    var ramp = ["#9ec5fe", "#5b9bf8", "#0068f5", "#0b3668"];
    d.cells.forEach(function (p) {
      var t = Math.sqrt(p[2] / d.max);
      var col = ramp[Math.min(ramp.length - 1, Math.floor(t * ramp.length))];
      var mk = L.circleMarker([p[0], p[1]], {
        radius: 2 + 7 * t, color: col, weight: 1, fillColor: col, fillOpacity: 0.45
      }).addTo(map);
      var box = document.createElement("div");
      [["עצים", String(p[2])], ["עם מין מתועד", String(p[3])]].forEach(function (row) {
        var line = document.createElement("div");
        line.textContent = row[0] + ": " + row[1];
        box.appendChild(line);
      });
      mk.bindPopup(box);
    });
    map.fitBounds(d.bounds, { padding: [8, 8] });
  })();
</script>

<script>
  (function () {
    function mk(id) {
      var el = document.getElementById(id);
      if (!el) { return null; }
      var c = echarts.init(el);
      window.addEventListener("resize", function () { c.resize(); });
      return c;
    }
    function hbar(id, d, unit, pct) {
      var c = mk(id);
      if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: pct ? { type: "value", max: 100, axisLabel: { formatter: "{value}%" } } : { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { interval: 0, width: 120, overflow: "truncate" } },
        series: [{ type: "bar", name: unit, data: (pct ? d.pct : d.values).slice().reverse() }]
      }));
    }
    function col(id, d, unit) {
      var c = mk(id);
      if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 16, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, rotate: 40, hideOverlap: true } },
        yAxis: { type: "value" },
        series: [{ type: "bar", name: unit, data: d.values }]
      }));
    }
    hbar("chart-species", {{ model.charts.species | tojson }}, "עצים");
    hbar("chart-genus", {{ model.charts.genus | tojson }}, "עצים");
    hbar("chart-neigh", {{ model.charts.neigh | tojson }}, "עצים");
    hbar("chart-streets", {{ model.charts.streets | tojson }}, "עצים");
    hbar("chart-fields", {{ model.charts.fields | tojson }}, "אחוז", true);
    col("chart-rich", {{ model.charts.rich | tojson }}, "מינים");
  })();
</script>

<script>
  (function () {
    var m = {{ model.charts.mix | tojson }};
    var el = document.getElementById("chart-mix");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0, itemWidth: 12, itemHeight: 10, textStyle: { fontSize: 11 } },
      grid: { left: 8, right: 16, top: 8, bottom: 84, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: m.names.slice().reverse(), axisLabel: { interval: 0, width: 100, overflow: "truncate" } },
      series: m.series.map(function (s, i) {
        var o = { type: "bar", stack: "mix", name: s.name, data: s.data.slice().reverse() };
        if (i === m.series.length - 1) { o.itemStyle = { color: "#c3cfe7" }; }
        return o;
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
