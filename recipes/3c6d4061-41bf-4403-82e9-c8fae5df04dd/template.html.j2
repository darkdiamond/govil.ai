{%- macro head(icon, title) %}
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/{{ icon }}.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ title }}</h2>
  </div>
{%- endmacro %}
<h1>שכבת שטח השיפוט המוניציפלי{% if model.labels.h1_place %} של {{ model.labels.h1_place }}{% endif %}</h1>

<section class="card p-5 mb-6">
{{ head("info", "תקציר") }}
  <p class="m-0 text-subtle leading-relaxed">{{ model.agent_data.summary_he }} השכבה מגדירה את גבול תחום השיפוט של העירייה, כלומר את השטח שבו היא גובה ארנונה, מתכננת ומספקת שירותים, ומיועדת לשילוב במערכות GIS ובמפות בסיס. היא מפורסמת בשתי מערכות קואורדינטות: רשת ישראל החדשה (ITM) וקווי רוחב ואורך (WGS84).</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
{%- for key in ["area", "perim", "ns", "ew"] %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.labels["kpi_" ~ key] }}</div>
  </div>
{%- endfor %}
</div>

<section class="card p-5 mb-6">
{{ head("circle-check", "תובנות עיקריות") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
{{ head("map-pin", "גבול תחום השיפוט על המפה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.map_lede }}</p>
  <div id="map-main" class="h-72 md:h-[420px]" role="region" aria-label="{{ model.labels.map_aria }}" data-fallback="explorer"></div>
</section>

<section class="card p-5 mb-6">
{{ head("list", model.labels.table_title) }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.table_lede }}</p>
{%- if model.flags.single %}
{%- set r = model.tables.units[0] %}
  <dl id="table-units" class="m-0 text-sm" aria-label="{{ model.labels.table_caption }}">
    <div class="flex justify-between gap-3 border-b border-rule py-2"><dt class="text-subtle">יחידה</dt><dd class="m-0 font-semibold text-ink-deep">{{ r.label }}</dd></div>
    <div class="flex justify-between gap-3 border-b border-rule py-2"><dt class="text-subtle">קוד אזור</dt><dd class="m-0" dir="ltr">{{ r.code }}</dd></div>
    <div class="flex justify-between gap-3 border-b border-rule py-2"><dt class="text-subtle">שטח (קמ״ר)</dt><dd class="m-0" dir="ltr">{{ r.area_km2 }}</dd></div>
    <div class="flex justify-between gap-3 border-b border-rule py-2"><dt class="text-subtle">שטח (דונם)</dt><dd class="m-0" dir="ltr">{{ r.dunam }}</dd></div>
    <div class="flex justify-between gap-3 border-b border-rule py-2"><dt class="text-subtle">שטח מחושב מקו הגבול (קמ״ר)</dt><dd class="m-0" dir="ltr">{{ r.drawn_km2 }}</dd></div>
    <div class="flex justify-between gap-3 border-b border-rule py-2"><dt class="text-subtle">היקף (ק״מ)</dt><dd class="m-0" dir="ltr">{{ r.perim_km }}</dd></div>
    <div class="flex justify-between gap-3 border-b border-rule py-2"><dt class="text-subtle">היקף ביחס לעיגול</dt><dd class="m-0" dir="ltr">{{ r.ratio }}</dd></div>
    <div class="flex justify-between gap-3 border-b border-rule py-2"><dt class="text-subtle">מרכז (רוחב, אורך)</dt><dd class="m-0" dir="ltr">{{ r.center or "לא ידוע" }}</dd></div>
  </dl>
{%- else %}
  <div class="overflow-x-auto">
    <table id="table-units" class="w-full text-sm">
      <caption class="sr-only">{{ model.labels.table_caption }}</caption>
      <thead>
        <tr class="border-b border-rule text-ink-deep">
          <th scope="col" class="text-start py-1 pe-3">יחידה</th>
          <th scope="col" class="text-start py-1 pe-3">קוד אזור</th>
          <th scope="col" class="text-start py-1 pe-3">שטח (קמ״ר)</th>
          <th scope="col" class="text-start py-1 pe-3">שטח (דונם)</th>
          <th scope="col" class="text-start py-1 pe-3">שטח מחושב (קמ״ר)</th>
          <th scope="col" class="text-start py-1 pe-3">היקף (ק״מ)</th>
          <th scope="col" class="text-start py-1 pe-3">היקף ביחס לעיגול</th>
          <th scope="col" class="text-start py-1">מרכז (רוחב, אורך)</th>
        </tr>
      </thead>
      <tbody>
{%- for r in model.tables.units %}
        <tr class="border-b border-rule">
          <th scope="row" class="text-start font-normal py-1 pe-3">{{ r.label }}</th>
          <td class="py-1 pe-3" dir="ltr">{{ r.code }}</td>
          <td class="py-1 pe-3" dir="ltr">{{ r.area_km2 }}</td>
          <td class="py-1 pe-3" dir="ltr">{{ r.dunam }}</td>
          <td class="py-1 pe-3" dir="ltr">{{ r.drawn_km2 }}</td>
          <td class="py-1 pe-3" dir="ltr">{{ r.perim_km }}</td>
          <td class="py-1 pe-3" dir="ltr">{{ r.ratio }}</td>
          <td class="py-1" dir="ltr">{{ r.center or "לא ידוע" }}</td>
        </tr>
{%- endfor %}
      </tbody>
    </table>
  </div>
{%- endif %}
  <p class="m-0 mt-3 text-xs text-subtle">היקף ביחס לעיגול: אורך קו הגבול חלקי היקפו של עיגול בעל אותו שטח. עיגול מושלם מקבל ערך אחד, וככל שהגבול מפותל יותר הערך גבוה יותר.</p>
</section>

<section class="card p-5 mb-6">
{{ head("info", "על המאגר") }}
  <p class="m-0 text-sm text-subtle leading-relaxed">עיריית באר שבע מפרסמת את שכבת שטח השיפוט המוניציפלי בכמה פורמטים: טבלת מאפיינים (CSV ו-XLSX, בשתי מערכות הקואורדינטות) וקובצי גאומטריה (GeoJSON ו-SHP) שבהם מצויר קו הגבול המלא. המפה בעמוד זה מצוירת מקובץ ה-GeoJSON, ובו גם נבדקים השטח ונקודת המרכז הרשומים. הטבלה כוללת את שם הרשות, קוד האזור, השטח וההיקף כפי שחושבו בתוכנת ה-GIS, ונקודת מרכז אחת לכל יחידה.</p>
</section>
{%- for chunk in model.charts.map.chunks %}
<script type="application/json" id="map-geo-{{ loop.index0 }}">{{ chunk | tojson }}</script>
{%- endfor %}
<script>
  (function () {
    var el = document.getElementById("map-main");
    if (!el || !window.L) { return; }
    var meta = {{ {"n": model.charts.map.chunks | length, "units": model.charts.map.units, "bounds": model.charts.bounds} | tojson }};
    var pal = window.GOVIL_PALETTE || ["#0068f5", "#0b3668", "#198754", "#dc3545", "#0dcaf0", "#6c757d"];
    var color = function (u) { return u === 0 ? "#0068f5" : pal[u % pal.length]; };
    var geo = {};
    for (var c = 0; c < meta.n; c++) {
      var node = document.getElementById("map-geo-" + c);
      if (!node) { continue; }
      JSON.parse(node.textContent).forEach(function (p) {
        var u = geo[p[0]] = geo[p[0]] || [];
        var poly = u[p[1]] = u[p[1]] || [];
        var ring = poly[p[2]] = poly[p[2]] || [];
        var pts = ring.length ? p[3].slice(1) : p[3];
        pts.forEach(function (q) { ring.push([q[1], q[0]]); });
      });
    }
    var map = L.map(el, { scrollWheelZoom: false, zoomSnap: 0.25 });
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 18, attribution: "© OpenStreetMap" }).addTo(map);
    meta.units.forEach(function (s, u) {
      if (!geo[u]) { return; }
      var shape = L.polygon(geo[u].filter(function (x) { return x; }), {
        color: color(u), weight: 3, opacity: 0.9, fillColor: color(u), fillOpacity: 0.12
      }).addTo(map);
      var box = document.createElement("div");
      var title = document.createElement("strong");
      title.textContent = s.label;
      box.appendChild(title);
      [["קוד אזור", s.code], ["שטח", s.km2 + " קמ״ר"], ["היקף", s.km + " ק״מ"]].forEach(function (row) {
        var d = document.createElement("div");
        d.textContent = row[0] + ": " + row[1];
        box.appendChild(d);
      });
      shape.bindPopup(box);
      if (s.center) {
        L.circleMarker(s.center, { radius: 5, color: "#0b3668", weight: 2, fillColor: "#ffffff", fillOpacity: 1 }).addTo(map);
      }
    });
    map.fitBounds(meta.bounds, { padding: [8, 8] });
  })();
</script>
