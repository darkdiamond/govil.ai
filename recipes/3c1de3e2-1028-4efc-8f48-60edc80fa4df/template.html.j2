{%- for s in model.charts.volume.series %}
        <tr><th scope="row">{{ s.name }}</th>{% for v in s.data %}<td dir="ltr">{% if v is not none %}{{ v | fmt_int }}{% endif %}</td>{% endfor %}</tr>
{%- endfor %}
