  </div>
  <p class="m-0 text-subtle">תיאור נתוני ספרים העוסקים בתיירות בישראל</p>
</section>

<script>
  (function () {
    var enc = echarts.format.encodeHTML;
    function fmt(v) { return Number(v).toLocaleString("he-IL"); }
    var d = {{ model.charts.years | tojson }};
    var el = document.getElementById("chart-years");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: {
        trigger: "axis", axisPointer: { type: "shadow" },
        formatter: function (ps) {
          if (!ps.length) { return ""; }
          var j = ps[0].dataIndex;
          var out = "<b>" + enc(d.x[j]) + "</b> (" + fmt(d.hebrew[j] + d.foreign[j]) + " פריטים)";
          ps.forEach(function (p) { out += "<br/>" + p.marker + enc(p.seriesName) + ": " + fmt(p.value); });
          return out;
        }
      },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 36, bottom: 56, containLabel: true },
      dataZoom: [{ type: "inside" }, { type: "slider", height: 18, bottom: 8 }],
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value" },
      series: [
        { type: "bar", stack: "s", name: "עברית", data: d.hebrew },
        { type: "bar", stack: "s", name: "לועזית", data: d.foreign }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();

  (function () {
    var enc = echarts.format.encodeHTML;
    function fmt(v) { return Number(v).toLocaleString("he-IL"); }
    var d = {{ model.charts.lang | tojson }};
    var el = document.getElementById("chart-lang");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: {
        trigger: "axis", axisPointer: { type: "shadow" },
        formatter: function (ps) {
          if (!ps.length) { return ""; }
          var j = ps[0].dataIndex;
          return "<b>" + enc(d.labels[j]) + "</b> (" + fmt(d.totals[j]) + " פריטים)" +
            "<br/>עברית: " + fmt(d.hebrew[j]) + "<br/>לועזית: " + fmt(d.foreign[j]) +
            "<br/>שיעור לועזית: " + d.foreign_share[j] + "%";
        }
      },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 36, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.labels, axisLabel: { interval: 0, rotate: 30 } },
      yAxis: [
        { type: "value", name: "פריטים" },
        { type: "value", name: "% לועזית", min: 0, max: 100, splitLine: { show: false }, axisLabel: { formatter: "{value}%" } }
      ],
      series: [
        { type: "bar", stack: "s", name: "עברית", data: d.hebrew },
        { type: "bar", stack: "s", name: "לועזית", data: d.foreign },
        { type: "line", name: "שיעור לועזית", yAxisIndex: 1, data: d.foreign_share, symbolSize: 7, lineStyle: { width: 2 } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();

  (function () {
    var enc = echarts.format.encodeHTML;
    function fmt(v) { return Number(v).toLocaleString("he-IL"); }
    function hbar(id, d, unit) {
      var el = document.getElementById(id);
      if (!el) { return; }
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: {
          trigger: "axis", axisPointer: { type: "shadow" },
          formatter: function (ps) {
            if (!ps.length) { return ""; }
            var j = ps[0].dataIndex;
            var s = d.shares ? " (" + d.shares[j] + "%)" : "";
            return enc(d.names[j]) + ": " + fmt(d.counts[j]) + " " + unit + s;
          }
        },
        grid: { left: 16, right: 48, top: 8, bottom: 16, containLabel: true },
        xAxis: { type: "value", minInterval: 1, splitNumber: 3, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 150, overflow: "truncate", interval: 0 } },
        series: [{ type: "bar", data: d.counts, barMaxWidth: 22, label: { show: true, position: "right", formatter: function (p) { return fmt(p.value); } } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    hbar("chart-themes", {{ model.charts.themes | tojson }}, "פריטים");
    hbar("chart-publishers", {{ model.charts.publishers | tojson }}, "פריטים");
    hbar("chart-countries", {{ model.charts.countries | tojson }}, "פריטים");
    hbar("chart-authors", {{ model.charts.authors | tojson }}, "פריטים");
    hbar("chart-remarks", {{ model.charts.remarks | tojson }}, "פריטים");
  })();

  (function () {
    var enc = echarts.format.encodeHTML;
    var d = {{ model.charts.heat | tojson }};
    var el = document.getElementById("chart-heat");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      tooltip: {
        position: "top",
        formatter: function (p) {
          var v = p.value;
          return enc(d.themes[v[1]]) + ", " + enc(d.decades[v[0]]) + ": " + v[2] + "% (" + Number(v[3]).toLocaleString("he-IL") + " פריטים)";
        }
      },
      grid: { left: 16, right: 16, top: 8, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.decades, splitArea: { show: true }, axisLabel: { interval: 0, rotate: 30 } },
      yAxis: { type: "category", data: d.themes, inverse: true, splitArea: { show: true }, axisLabel: { width: 130, overflow: "truncate" } },
      visualMap: {
        min: 0, max: d.max, dimension: 2, calculable: true,
        orient: "horizontal", left: "center", bottom: 0, itemHeight: 120,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{
        type: "heatmap", data: d.cells,
        label: { show: true, fontFamily: "Rubik", fontSize: 10, formatter: function (p) { return p.value[2]; } },
        emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } }
      }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();

  (function () {
    var enc = echarts.format.encodeHTML;
    function fmt(v) { return Number(v).toLocaleString("he-IL"); }
    var d = {{ model.charts.origin | tojson }};
    var el = document.getElementById("chart-origin");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: {
        trigger: "item",
        formatter: function (p) { return enc(p.name) + ": " + fmt(p.value) + " (" + d.shares[p.dataIndex] + "%)"; }
      },
      legend: { bottom: 0, type: "scroll" },
      series: [{
        type: "pie", radius: ["40%", "66%"], center: ["50%", "44%"],
        label: { formatter: function (p) { return d.shares[p.dataIndex] + "%"; } },
        data: d.names.map(function (n, i) { return { name: n, value: d.counts[i] }; })
      }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();

  (function () {
    function fmt(v) { return Number(v).toLocaleString("he-IL"); }
    var d = {{ model.charts.pages | tojson }};
    var el = document.getElementById("chart-pages");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 36, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.bins, name: "עמודים", nameLocation: "middle", nameGap: 28 },
      yAxis: { type: "value" },
      series: [
        { type: "bar", name: "עברית", data: d.hebrew, barMaxWidth: 28 },
        { type: "bar", name: "לועזית", data: d.foreign, barMaxWidth: 28 }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();

  (function () {
    var enc = echarts.format.encodeHTML;
    function fmt(v) { return Number(v).toLocaleString("he-IL"); }
    var d = {{ model.charts.bands | tojson }};
    var el = document.getElementById("chart-bands");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: {
        trigger: "axis",
        formatter: function (ps) {
          if (!ps.length) { return ""; }
          var j = ps[0].dataIndex;
          return "מדבקות " + enc(d.labels[j]) + "<br/>חציון שנת פרסום: " + d.median[j] + "<br/>" + fmt(d.counts[j]) + " פריטים מתוארכים";
        }
      },
      grid: { left: 16, right: 16, top: 24, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.labels, axisLabel: { interval: 0, rotate: 35 } },
      yAxis: { type: "value", scale: true, name: "שנת פרסום" },
      series: [{ type: "line", data: d.median, symbolSize: 8, lineStyle: { width: 2 } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
