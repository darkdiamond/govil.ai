{%- macro simple_table(caption, head1, head2, names, counts, shares=None, head3=None) -%}
  <details class="mt-3">
    <summary class="text-sm text-subtle cursor-pointer">הצג כטבלה</summary>
    <div class="relative overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ caption }}</caption>
        <thead><tr><th scope="col" class="text-start">{{ head1 }}</th><th scope="col" class="text-start">{{ head2 }}</th>{% if shares is not none %}<th scope="col" class="text-start">{{ head3 }}</th>{% endif %}</tr></thead>
        <tbody>
{%- for n in names %}
          <tr><th scope="row" class="text-start font-normal">{{ n }}</th><td>{{ counts[loop.index0] | fmt_int }}</td>{% if shares is not none %}<td>{{ shares[loop.index0] }}%</td>{% endif %}</tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
{%- endmacro -%}

<h1>ספרייה מקצועית של משרד התיירות: קטלוג ספרות מקצועית ומחקרי תיירות</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 mb-2 text-subtle leading-relaxed">{{ model.agent_data.summary_he }}</p>
  <p class="m-0 text-sm text-subtle leading-relaxed">קטלוג הידע המשרדי של הספרייה המקצועית במשרד התיירות מפרט ספרים, דוחות, סקרים, תוכניות אב, כתבי עת ומאמרים בנושאי תיירות, מלונאות ופיתוח תיירותי. לכל פריט נרשמו כותר, מספר מדבקה (מספר המדף בספרייה), שנת פרסום, הוצאה לאור, מקום פרסום, מספר עמודים, מחבר והערות. הרישום נעשה ידנית ולכן חלק מהשדות חסרים או כתובים בכמה צורות; בעמוד זה הם אוחדו ככל האפשר.</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור ספר, דוח או מחקר בתיירות לפי כותר, מחבר או הוצאה ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות הקטלוג: שם הפריט, מספר מדבקה, שנת פרסום, הוצאה לאור, מקום פרסום, מחבר והערות</span>
  </span>
</a>

