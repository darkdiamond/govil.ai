      <thead><tr><th scope="col">ישוב</th><th scope="col">בקבצים הקודמים</th><th scope="col">היום</th><th scope="col">נוספו</th><th scope="col">הוסרו</th></tr></thead>
      <tbody>
{%- for r in model.tables.growth %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.old | fmt_int }}</td><td>{{ r.now | fmt_int }}</td><td>{{ r.added | fmt_int }}</td><td>{{ r.removed | fmt_int }}</td></tr>
{%- endfor %}
