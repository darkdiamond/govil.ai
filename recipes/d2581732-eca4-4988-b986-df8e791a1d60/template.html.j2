{%- if model.flags.renames %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">רחובות ששינו את שמם</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.renames_note }}</p>
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <caption class="sr-only">{{ model.labels.renames_caption }}</caption>
      <thead><tr><th scope="col" class="text-start pe-4">ישוב</th><th scope="col" class="text-start pe-4">שם בקבצים הקודמים</th><th scope="col" class="text-start pe-4">שם נוכחי</th><th scope="col" class="text-start">שינויים בישוב</th></tr></thead>
      <tbody>
{%- for r in model.tables.renames %}
        <tr class="border-t border-rule"><th scope="row" class="text-start py-1 pe-4">{{ r.loc }}</th><td class="py-1 pe-4">{{ r.old }}</td><td class="py-1 pe-4">{{ r.new }}</td><td class="py-1">{{ r.n }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </div>
</section>
{%- endif %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">רשות האוכלוסין וההגירה מפרסמת מידי תקופה רשימת רחובות לשימוש חופשי של הציבור.</p>
</section>

<script>
  (function () {
    function hbar(id, d, color, name) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                   valueFormatter: function (v) { return v.toLocaleString("he-IL"); } },
        grid: { left: 16, right: 40, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 4, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { fontSize: 11, interval: 0 } },
        series: [{ type: "bar", name: name, data: d.values, itemStyle: { color: color },
                   label: { show: true, position: "right", fontSize: 10 } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    hbar("chart-top", {{ model.charts.top | tojson }}, "#0068f5", "רחובות");
    hbar("chart-types", {{ model.charts.types | tojson }}, "#0b3668", "רחובות");
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.dist | tojson }};
    var c = echarts.init(document.getElementById("chart-dist"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 16, top: 32, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.names, name: "רחובות בישוב", nameLocation: "middle", nameGap: 44,
               axisLabel: { fontSize: 10, interval: 0, rotate: 30 } },
      yAxis: { type: "value", name: "ישובים" },
      series: [{ type: "bar", name: "ישובים", data: d.values, itemStyle: { color: "#0068f5" },
                 label: { show: true, position: "top", fontSize: 10 } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var P = window.GOVIL_PALETTE;
    var d = {{ model.charts.names | tojson }};
    var c = echarts.init(document.getElementById("chart-names"));
    c.setOption(window.GovEcharts.option({
      color: P,
      tooltip: { trigger: "item", formatter: function (p) {
        return p.name + ": " + p.value.toLocaleString("he-IL") + " ישובים (" + d.themes[p.dataIndex] + ")";
      } },
      grid: { left: 16, right: 40, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 4, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { fontSize: 12, interval: 0 } },
      series: [{ type: "bar", name: "ישובים", label: { show: true, position: "right", fontSize: 10 },
                 data: d.values.map(function (v, i) {
                   return { value: v, itemStyle: { color: P[d.ci[i] % P.length] } };
                 }) }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

{%- if model.flags.themes %}
<script>
  (function () {
    var d = {{ model.charts.themes | tojson }};
    var c = echarts.init(document.getElementById("chart-themes"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var p = ps[0];
        return p.name + ": " + p.value.toLocaleString("he-IL") + " רחובות ב-" +
          d.locs[p.dataIndex].toLocaleString("he-IL") + " ישובים";
      } },
      grid: { left: 16, right: 48, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 4, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { fontSize: 11, interval: 0 } },
      series: [{ type: "bar", name: "רחובות", data: d.values, itemStyle: { color: "#0068f5" },
                 label: { show: true, position: "right", fontSize: 10 } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

