{%- if model.flags.numbered %}
<script>
  (function () {
    var d = {{ model.charts.numbered | tojson }};
    var c = echarts.init(document.getElementById("chart-numbered"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex;
        return d.names[i] + "<br>ממוספרים: " + d.numbered[i].toLocaleString("he-IL") + " (" + d.numbered_pct[i] +
          "%)<br>בעלי שם: " + d.named[i].toLocaleString("he-IL");
      } },
      legend: { top: 0 },
      grid: { left: 16, right: 24, top: 32, bottom: 16, containLabel: true },
      xAxis: { type: "value", max: 100, splitNumber: 4, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { fontSize: 11, interval: 0 } },
      series: [
        { type: "bar", stack: "t", name: "ממוספרים", data: d.numbered_pct, itemStyle: { color: "#0068f5" } },
        { type: "bar", stack: "t", name: "בעלי שם", data: d.named_pct, itemStyle: { color: "#c3cfe7" } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

{%- if model.flags.growth %}
<script>
  (function () {
