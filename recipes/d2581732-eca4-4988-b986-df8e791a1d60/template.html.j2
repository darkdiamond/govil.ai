        { type: "bar", stack: "t", name: "נוספו", data: d.added, itemStyle: { color: "#198754" } },
        { type: "bar", stack: "t", name: "היו קודם", data: d.kept, itemStyle: { color: "#c3cfe7" } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
