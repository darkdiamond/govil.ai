<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">{{ model.labels.notes }}</p>
</section>

<script>
(function () {
  const units = {{ model.charts.units | tojson }};
  units.forEach(function (u, i) {
    const el = document.getElementById("chart-unit-" + (i + 1));
    if (!el) return;
    const chart = echarts.init(el);
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", valueFormatter: function (v) { return v == null ? "-" : Number(v).toLocaleString("he-IL", { maximumFractionDigits: 2 }) + " " + u.ytitle; } },
      legend: { type: "scroll", top: 0, selected: u.selected },
      grid: { left: 16, right: 16, top: 56, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: u.x, boundaryGap: false },
      yAxis: { type: "value", scale: true, name: u.ytitle, nameTextStyle: { align: "right" } },
      dataZoom: [{ type: "inside" }, { type: "slider", height: 18, bottom: 8 }],
      series: u.series.map(function (s) { return { name: s.name, type: "line", data: s.data, showSymbol: false, connectNulls: false }; })
    }));
    window.addEventListener("resize", function () { chart.resize(); });
  });
})();
</script>

<script>
(function () {
  const d = {{ model.charts.index | tojson }};
  const el = document.getElementById("chart-index");
  if (!el) return;
  const chart = echarts.init(el);
  chart.setOption(window.GovEcharts.option({
    tooltip: { trigger: "axis", valueFormatter: function (v) { return v == null ? "-" : Number(v).toFixed(1); } },
    legend: { type: "scroll", top: 0, selected: d.selected },
    grid: { left: 16, right: 16, top: 56, bottom: 24, containLabel: true },
    xAxis: { type: "category", data: d.x },
    yAxis: { type: "value", scale: true },
    series: d.series.map(function (s) {
      return { name: s.name, type: "line", data: s.data, symbolSize: 6,
        markLine: { symbol: "none", silent: true, data: [{ yAxis: 100 }], lineStyle: { color: "#6c757d", type: "dashed" }, label: { show: false } } };
    })
  }));
  window.addEventListener("resize", function () { chart.resize(); });
})();
</script>

<script>
(function () {
  const d = {{ model.charts.yoy | tojson }};
  const el = document.getElementById("chart-yoy");
  if (!el) return;
  const chart = echarts.init(el);
  chart.setOption(window.GovEcharts.option({
    tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return (v > 0 ? "+" : "") + v + "%"; } },
    grid: { left: 16, right: 24, top: 16, bottom: 16, containLabel: true },
    xAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
    yAxis: { type: "category", data: d.names, axisLabel: { width: 150, overflow: "truncate" } },
    series: [{ type: "bar", name: "שינוי שנתי", data: d.values.map(function (v) {
      return { value: v, itemStyle: { color: v >= 0 ? "#dc3545" : "#0068f5" } };
    }), label: { show: true, position: "right", formatter: function (p) { return (p.value > 0 ? "+" : "") + p.value + "%"; } } }]
  }));
  window.addEventListener("resize", function () { chart.resize(); });
})();
</script>

<script>
(function () {
  const d = {{ model.charts.range | tojson }};
  const el = document.getElementById("chart-range");
  if (!el) return;
  const chart = echarts.init(el);
  chart.setOption(window.GovEcharts.option({
    tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + "% מהטווח"; } },
    grid: { left: 16, right: 32, top: 16, bottom: 16, containLabel: true },
    xAxis: { type: "value", min: 0, max: 100, axisLabel: { formatter: "{value}%" } },
    yAxis: { type: "category", data: d.names, axisLabel: { width: 150, overflow: "truncate" } },
    series: [{ type: "bar", name: "מיקום בטווח", data: d.values, label: { show: true, position: "right", formatter: "{c}%" } }]
  }));
  window.addEventListener("resize", function () { chart.resize(); });
})();
</script>

<script>
(function () {
  const d = {{ model.charts.heat | tojson }};
  const el = document.getElementById("chart-heat");
  if (!el) return;
  const enc = echarts.format.encodeHTML;
  const chart = echarts.init(el);
  chart.setOption(window.GovEcharts.option({
    tooltip: { position: "top", formatter: function (p) {
      const v = p.value[2];
      return enc(d.y[p.value[1]]) + "<br>" + enc(d.x[p.value[0]]) + ": " + (v > 0 ? "+" : "") + v + "%";
    } },
    grid: { left: 16, right: 16, top: 16, bottom: 72, containLabel: true },
    xAxis: { type: "category", data: d.x, splitArea: { show: true } },
    yAxis: { type: "category", data: d.y, splitArea: { show: true }, axisLabel: { width: 130, overflow: "truncate" } },
    visualMap: { min: -d.max, max: d.max, dimension: 2, calculable: true, orient: "horizontal", left: "center", bottom: 8,
      inRange: { color: ["#0068f5", "#f1f7ff", "#dc3545"] }, textStyle: { fontFamily: "Rubik", color: "#0c3058" } },
    series: [{ type: "heatmap", data: d.cells, label: { show: false },
      emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
  }));
  window.addEventListener("resize", function () { chart.resize(); });
})();
</script>

