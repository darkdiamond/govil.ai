{% import "gov.j2" as gov %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסמה {{ model.release.date }}</p>
{%- if model.release.headline %}
  <p class="m-0 mb-3 font-semibold text-ink-deep">{{ model.release.headline }}</p>
{%- endif %}
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["open", "close", "net", "open_chg", "half_open"] %}
{%- if model.kpis[key] is defined %}
  {{ gov.kpi(model.kpis[key], model.labels[key ~ "_kpi"]) }}
{%- endif %}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

{%- if model.flags.trend %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "פתיחות וסגירות עסקים לאורך זמן") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.trend_note }}</p>
  {{ gov.chart("chart-trend", model.labels.trend_aria, "h-80 md:h-[460px]") }}
  {{ gov.table("ממוצע חודשי של פתיחות וסגירות, מנוכה עונתיות, לפי שנה", ["שנה", "פתיחות בחודש", "סגירות בחודש"], model.tables.trend, ltr=(1, 2)) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("database", "כמה תיקים נפתחו ונסגרו בכל שנה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.annual_note }}</p>
  {{ gov.chart("chart-annual", model.labels.annual_aria, "h-72 md:h-80") }}
  {{ gov.table("פתיחות וסגירות של תיקי עוסקי מע\"מ לפי שנה", ["שנה", "פתיחות", "סגירות", "פתיחות פחות סגירות", "פתיחות על כל סגירה"], model.tables.annual, ltr=(1, 2, 3, 4)) }}
</section>

{%- if model.flags.half %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "השינוי ב" ~ model.labels.half_period ~ " לפי ענף") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.half_note }}</p>
  {{ gov.chart("chart-half", model.labels.half_aria, "h-[680px]") }}
  {{ gov.table("אחוז השינוי בפתיחות ובסגירות לפי ענף", ["ענף", "פתיחות", "סגירות"], model.tables.half, ltr=(1, 2)) }}
</section>
{%- endif %}

{%- if model.flags.branches %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "פתיחות וסגירות לפי ענף") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.branches_note }}</p>
  {{ gov.chart("chart-branches", model.labels.branches_aria, "h-[640px]") }}
  {{ gov.table("פתיחות וסגירות של תיקי עוסקי מע\"מ לפי ענף ראשי", ["ענף", "פתיחות", "סגירות", "פתיחות פחות סגירות"], model.tables.branches, ltr=(1, 2, 3)) }}
</section>

<section class="card p-5 mb-6">
  {{ gov.head("circle-check", "באילו ענפים נוספו הכי הרבה עסקים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.net_note }}</p>
  {{ gov.chart("chart-net", model.labels.net_aria, "h-[560px]") }}
  {{ gov.table("פתיחות פחות סגירות לפי ענף ראשי", ["ענף", "פתיחות פחות סגירות", "פתיחות על כל סגירה"], model.tables.net, ltr=(1, 2)) }}
</section>
{%- endif %}

{%- if model.flags.subs %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "תת-ענפים והיי-טק") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.subs_note }}</p>
  {{ gov.chart("chart-subs", model.labels.subs_aria, "h-80 md:h-96") }}
  {{ gov.table("פתיחות וסגירות בתת-ענפים נבחרים ובהיי-טק", model.labels.subs_cols, model.tables.subs, ltr=range(1, model.labels.subs_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.season %}
<section class="card p-5 mb-6">
  {{ gov.head("calendar", "עונתיות: מתי פותחים ומתי סוגרים עסק") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.season_note }}</p>
  {{ gov.chart("chart-season", model.labels.season_aria, "h-72 md:h-80") }}
  {{ gov.table("ממוצע הפתיחות והסגירות לפי חודש", ["חודש", "פתיחות", "סגירות"], model.tables.season, ltr=(1, 2)) }}
</section>
{%- endif %}

{%- if model.flags.multi %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "ענפים נבחרים לאורך זמן") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.multi_note }}</p>
  <div class="grid gap-4 md:grid-cols-3">
{%- for c in model.charts.multi %}
    <div>
      <p class="m-0 text-sm font-semibold text-ink-deep">{{ c.name }}</p>
      {{ gov.chart(c.id, "פתיחות וסגירות, נתוני מגמה: " ~ c.name, "h-56 md:h-64") }}
    </div>
{%- endfor %}
  </div>
{%- if model.flags.multi_table %}
  {{ gov.table("ממוצע חודשי של נתוני המגמה בענפים נבחרים", ["ענף", "פתיחות " ~ model.labels.multi_a, "פתיחות " ~ model.labels.multi_b, "סגירות " ~ model.labels.multi_a, "סגירות " ~ model.labels.multi_b], model.tables.multi, ltr=(1, 2, 3, 4)) }}
{%- endif %}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>הנתונים מתוך ההודעה החצי שנתית לתקשורת של הלשכה המרכזית לסטטיסטיקה על פתיחות וסגירות של תיקי עוסקי מע"מ, המבוססת על נתוני רשות המסים. תיק עוסק מע"מ נפתח כשעסק נרשם כעוסק מורשה או פטור, ונסגר כשהוא מפסיק את פעילותו.</li>
    <li>נתונים מקוריים הם מספר התיקים בפועל. נתונים מנוכי עונתיות מנטרלים את העונתיות (למשל ריבוי הפתיחות בינואר והסגירות בדצמבר), ונתוני המגמה מחליקים גם את התנודות האקראיות. הסיכומים השנתיים הם סכום החודשים בשנים שכל חודשיהן פורסמו.</li>
    <li>ענפי ההיי-טק חוצים כמה ענפים ראשיים, ותת-הענפים הם חלק מהענף הראשי שלהם, ולכן אינם נכללים בתרשים הענפים הראשיים. הנתונים האחרונים עשויים להתעדכן בהודעות הבאות.</li>
  </ul>
</section>

<script>
{%- if model.flags.trend %}
  (function () {
    const d = {{ model.charts.trend | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-trend"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[0], pal[1], pal[1]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 56, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", scale: true },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 20 }],
      series: [
        { type: "line", name: "פתיחות (מנוכה עונתיות)", data: d.open_sa, showSymbol: false, lineStyle: { width: 1, opacity: 0.5 } },
        { type: "line", name: "פתיחות (מגמה)", data: d.open_tr, showSymbol: false, lineStyle: { width: 3 } },
        { type: "line", name: "סגירות (מנוכה עונתיות)", data: d.close_sa, showSymbol: false, lineStyle: { width: 1, opacity: 0.5 } },
        { type: "line", name: "סגירות (מגמה)", data: d.close_tr, showSymbol: false, lineStyle: { width: 3 } }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
  (function () {
    const d = {{ model.charts.annual | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-annual"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1], pal[2]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", axisLabel: { formatter: (v) => Math.abs(v) >= 1000 ? (v / 1000).toLocaleString("he-IL") + " אלף" : v } },
      series: [
        { type: "bar", name: "פתיחות", data: d.open },
        { type: "bar", name: "סגירות", data: d.close },
        { type: "line", name: "פתיחות פחות סגירות", data: d.net, symbolSize: 8 }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- if model.flags.half %}
  (function () {
    const d = {{ model.charts.half | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-half"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : (v > 0 ? "+" : "") + Number(v).toFixed(1) + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 8, containLabel: true },
      xAxis: { type: "value", splitNumber: 4, axisLabel: { formatter: "{value}%", hideOverlap: true } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 120, overflow: "break", fontSize: 11 } },
      series: [
        { type: "bar", name: "פתיחות", data: d.open },
        { type: "bar", name: "סגירות", data: d.close }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.branches %}
  (function () {
    const d = {{ model.charts.branches | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-branches"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: (v) => v >= 1000 ? (v / 1000).toLocaleString("he-IL") + " אלף" : v } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 120, overflow: "break", fontSize: 11 } },
      series: [
        { type: "bar", name: "פתיחות", data: d.open },
        { type: "bar", name: "סגירות", data: d.close }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
  (function () {
    const d = {{ model.charts.net | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-net"));
    chart.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") },
      grid: { left: 16, right: 48, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 120, overflow: "break", fontSize: 11 } },
      series: [{
        type: "bar", name: "פתיחות פחות סגירות",
        data: d.net.map((v) => ({ value: v, itemStyle: { color: v >= 0 ? pal[0] : pal[1] } })),
        label: { show: true, position: "right", formatter: (p) => Number(p.value).toLocaleString("he-IL") }
      }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.subs %}
  (function () {
    const d = {{ model.charts.subs | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-subs"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 8, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 120, overflow: "break", fontSize: 11 } },
      series: [
        { type: "bar", name: "פתיחות", data: d.open },
        { type: "bar", name: "סגירות", data: d.close }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.season %}
  (function () {
    const d = {{ model.charts.season | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-season"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[1]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { interval: 0, rotate: 45 } },
      yAxis: { type: "value" },
      series: [
        { type: "bar", name: "פתיחות", data: d.open },
        { type: "bar", name: "סגירות", data: d.close }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.multi %}
  (function () {
    const all = {{ model.charts.multi | tojson }};
    const pal = window.GOVIL_PALETTE;
    all.forEach((d) => {
      const chart = echarts.init(document.getElementById(d.id));
      chart.setOption(window.GovEcharts.option({
        color: [pal[0], pal[1]],
        tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toLocaleString("he-IL") },
        legend: { top: 0 },
        grid: { left: 8, right: 8, top: 32, bottom: 8, containLabel: true },
        xAxis: { type: "category", data: d.x },
        yAxis: { type: "value", scale: true },
        series: [
          { type: "line", name: "פתיחות", data: d.open, showSymbol: false, lineStyle: { width: 2 } },
          { type: "line", name: "סגירות", data: d.close, showSymbol: false, lineStyle: { width: 2 } }
        ]
      }));
      window.addEventListener("resize", () => chart.resize());
    });
  })();
{%- endif %}
</script>
