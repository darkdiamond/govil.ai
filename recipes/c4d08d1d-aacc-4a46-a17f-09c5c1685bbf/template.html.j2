  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.waves_caption }}</caption>
      <thead><tr><th scope="col">{{ model.labels.waves_col }}</th><th scope="col">חברות</th></tr></thead>
      <tbody>
{%- for r in model.tables.waves %}
        <tr><th scope="row" dir="ltr">{{ r.label }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
