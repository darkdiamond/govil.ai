<script>
  (function () {
    var d = {{ model.charts.waves | tojson }};
    var c = echarts.init(document.getElementById("chart-waves"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", formatter: function (p) {
        return p[0].name + ": " + p[0].value.toLocaleString("he-IL") + " חברות";
      } },
      grid: { left: 40, right: 16, top: 28, bottom: 32, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: 45, fontSize: 10 } },
      yAxis: { type: "log", name: "חברות", min: 1, logBase: 10 },
      series: [{ type: "bar", name: "חברות", data: d.y,
                 label: { show: true, position: "top", fontSize: 10,
                          formatter: function (p) { return p.value.toLocaleString("he-IL"); } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var g = {{ model.charts.gantt | tojson }};
    var data = g.labels.map(function (lab, i) {
      return { value: [i, g.start[i], g.end[i] || g.start[i], g.count[i]],
               itemStyle: { color: g.open[i] ? "#0068f5" : "#0b3668" } };
    });
    var c = echarts.init(document.getElementById("chart-gantt"));
    c.setOption(window.GovEcharts.option({
      tooltip: { formatter: function (p) {
        var i = p.value[0];
        return "פרסום " + g.labels[i] + "<br>" + g.count[i].toLocaleString("he-IL") + " חברות<br>" +
               "מחיקה צפויה: " + (g.end[i] || "—") + (g.open[i] ? " (חלון פתוח)" : " (החלון הסתיים)");
      } },
      grid: { left: 16, right: 24, top: 36, bottom: 32, containLabel: true },
      xAxis: { type: "time", splitNumber: 3, axisLabel: { fontSize: 10, hideOverlap: true,
               formatter: function (v) { var d = new Date(v); return (d.getMonth() + 1) + "." + String(d.getFullYear()).slice(2); } } },
      yAxis: { type: "category", data: g.labels, inverse: true, axisLabel: { fontSize: 10 } },
      series: [{
        type: "custom",
        encode: { x: [1, 2], y: 0 },
        renderItem: function (params, api) {
          var y = api.value(0);
          var a = api.coord([api.value(1), y]);
          var b = api.coord([api.value(2), y]);
          var h = api.size([0, 1])[1] * 0.55;
          return { type: "rect",
                   shape: { x: Math.min(a[0], b[0]), y: a[1] - h / 2,
                            width: Math.max(Math.abs(b[0] - a[0]), 2), height: h },
                   style: api.style() };
        },
        data: data,
        markLine: { symbol: "none", silent: true,
                    lineStyle: { color: "#dc3545", type: "dashed", width: 2 },
                    label: { formatter: "פרסום אחרון", position: "start", color: "#dc3545", fontFamily: "Rubik" },
                    data: [{ xAxis: g.ref }] }
      }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    function hbar(id, d, unit) {
      var el = document.getElementById(id);
      if (!el) { return; }
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis" },
        grid: { left: 16, right: 40, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { fontSize: 11 } },
        series: [{ type: "bar", name: unit, data: d.values,
                   label: { show: true, position: "right", fontSize: 10,
                            formatter: function (p) { return p.value.toLocaleString("he-IL"); } } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    hbar("chart-status", {{ model.charts.status | tojson }}, "חברות");
    hbar("chart-flags", {{ model.charts.flags | tojson }}, "חברות");
    hbar("chart-words", {{ model.charts.words | tojson }}, "שמות");
  })();
</script>

<script>
  (function () {
    var s = {{ model.charts.series | tojson }};
    var c = echarts.init(document.getElementById("chart-series"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 8, right: 8, top: 32, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: s.x, axisLabel: { interval: 0, fontSize: 10 } },
      yAxis: [
        { type: "value", name: "חברות" },
        { type: "value", name: "% שם לועזי", min: 0, max: 100, splitLine: { show: false } }
      ],
      series: [
        { type: "bar", name: "חברות", data: s.count },
        { type: "line", name: "% שם לועזי", yAxisIndex: 1, data: s.en,
          tooltip: { valueFormatter: function (v) { return v + "%"; } } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var el = document.getElementById("chart-years");
    if (el) {
      var y = {{ model.charts.years | tojson }};
      var c2 = echarts.init(el);
      c2.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", formatter: function (p) {
          return y.tips[p[0].dataIndex] + ": " + p[0].value.toLocaleString("he-IL") + " חברות";
        } },
        grid: { left: 40, right: 16, top: 24, bottom: 32, containLabel: true },
        xAxis: { type: "category", data: y.labels, axisLabel: { fontSize: 10 } },
        yAxis: { type: "value", name: "חברות" },
        series: [{ type: "bar", name: "חברות", data: y.y }]
      }));
      window.addEventListener("resize", function () { c2.resize(); });
    }
  })();
</script>
