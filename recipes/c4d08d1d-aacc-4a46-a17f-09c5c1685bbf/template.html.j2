    <div class="text-3xl font-bold text-{{ model.kpis.past.tone }} mb-1" dir="ltr">{{ model.kpis.past.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.past_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.recent.tone }} mb-1" dir="ltr">{{ model.kpis.recent.display }}</div>
