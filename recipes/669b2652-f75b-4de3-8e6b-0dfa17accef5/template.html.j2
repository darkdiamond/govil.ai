</section>

<script>
  (function () {
    function cut(s, k) { return s.length > k ? s.slice(0, k - 1) + "…" : s; }
    function lab() { return window.innerWidth < 640 ? 16 : 34; }

    var y = {{ model.charts.years | tojson }};
    var c = echarts.init(document.getElementById("chart-years"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 60, bottom: 48, containLabel: true },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 18 }],
      xAxis: { type: "category", data: y.x },
      yAxis: { type: "value", name: "ניגשויות" },
      series: y.series.map(function (s) {
        return { type: "bar", stack: "total", name: s.name, data: s.data, itemStyle: { color: s.color } };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var r = {{ model.charts.rate | tojson }};
    var c2 = echarts.init(document.getElementById("chart-rate"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: r.x },
      yAxis: [
        { type: "value", name: "שיעור מעבר", scale: true, axisLabel: { formatter: "{value}%" } },
        { type: "value", name: "ציון ממוצע", scale: true, splitLine: { show: false } }
      ],
      series: [
        { type: "line", name: "שיעור מעבר (%)", data: r.rate, connectNulls: false, itemStyle: { color: "#0068f5" }, lineStyle: { width: 3 } },
        { type: "line", name: "ציון ממוצע", yAxisIndex: 1, data: r.mean, itemStyle: { color: "#0b3668" }, lineStyle: { type: "dashed" } }
      ]
    }));
    window.addEventListener("resize", function () { c2.resize(); });

    var d = {{ model.charts.dist | tojson }};
    var c3 = echarts.init(document.getElementById("chart-dist"));
    c3.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", formatter: function (p) {
        return "ציון " + p[0].name + ": " + p[0].value.toLocaleString("he-IL") + " ניגשויות";
      } },
      grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { interval: 9 } },
      yAxis: { type: "value", name: "ניגשויות" },
      series: [{ type: "bar", name: "ניגשויות", barCategoryGap: "10%",
        data: d.y.map(function (v, i) {
          return { value: v, itemStyle: { color: i >= d.pass ? d.c_pass : "#9fb4d3" } };
        }) }]
    }));
    window.addEventListener("resize", function () { c3.resize(); });
  })();
</script>

<script>
  (function () {
    function cut(s, k) { return s.length > k ? s.slice(0, k - 1) + "…" : s; }
    function lab() { return window.innerWidth < 640 ? 16 : 34; }

    var s = {{ model.charts.subjects | tojson }};
    var c = echarts.init(document.getElementById("chart-subjects"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        return s.names[i] + "<br>שיעור מעבר: " + s.rate[i] + "%<br>ניגשויות: " + s.n[i].toLocaleString("he-IL");
      } },
      grid: { left: 16, right: 24, top: 8, bottom: 24, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: s.names, inverse: true,
               axisLabel: { fontSize: 11, formatter: function (v) { return cut(v, lab()); } } },
      series: [{ type: "bar", name: "שיעור מעבר",
        data: s.rate.map(function (v, i) { return { value: v, itemStyle: { color: s.colors[i] } }; }) }]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var h = {{ model.charts.heat | tojson }};
    var c2 = echarts.init(document.getElementById("chart-heat"));
    c2.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return h.y[p.value[1]] + "<br>" + h.x[p.value[0]] + ": " + p.value[2].toLocaleString("he-IL") + " ניגשויות";
      } },
      grid: { left: 16, right: 16, top: 8, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true }, axisLabel: { fontSize: 10 } },
      yAxis: { type: "category", data: h.y, splitArea: { show: true },
               axisLabel: { fontSize: 10, formatter: function (v) { return cut(v, lab()); } } },
      visualMap: {
        min: 0, max: h.max, calculable: true, dimension: 2,
        orient: "horizontal", left: "center", bottom: 8,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells,
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    function cut(s, k) { return s.length > k ? s.slice(0, k - 1) + "…" : s; }
    function lab() { return window.innerWidth < 640 ? 16 : 34; }

    var m = {{ model.charts.months | tojson }};
    var c = echarts.init(document.getElementById("chart-months"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: m.x, axisLabel: { interval: 0, rotate: 45, fontSize: 10 } },
      yAxis: { type: "value", name: "ניגשויות" },
      series: [{ type: "bar", name: "ניגשויות", data: m.y }]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var e = {{ model.charts.e_years | tojson }};
    var c2 = echarts.init(document.getElementById("chart-eyears"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis" },
      grid: { left: 16, right: 16, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: e.x, axisLabel: { fontSize: 10 } },
      yAxis: { type: "value", name: "פטורים" },
      series: [{ type: "bar", name: "פטורים", data: e.y, itemStyle: { color: "#0b3668" } }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });

    var t = {{ model.charts.inst | tojson }};
    var c3 = echarts.init(document.getElementById("chart-inst"));
    c3.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 32, bottom: 40, containLabel: true },
      xAxis: [
        { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
        { type: "value", max: 100, axisLabel: { formatter: "{value}%" }, splitLine: { show: false } }
      ],
      yAxis: { type: "category", data: t.names, inverse: true,
               axisLabel: { fontSize: 11, formatter: function (v) { return cut(v, lab()); } } },
      series: [
        { type: "bar", name: "ניגשויות", data: t.n },
        { type: "scatter", name: "שיעור מעבר (%)", xAxisIndex: 1, data: t.rate, symbolSize: 12,
          itemStyle: { color: "#0b3668" } }
      ]
    }));
    window.addEventListener("resize", function () { c3.resize(); });
  })();
</script>

<script>
  (function () {
    function cut(s, k) { return s.length > k ? s.slice(0, k - 1) + "…" : s; }
    function lab() { return window.innerWidth < 640 ? 16 : 34; }

    var x = {{ model.charts.e_subj | tojson }};
    var c = echarts.init(document.getElementById("chart-esubj"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 8, bottom: 40, containLabel: true },
      xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: x.names, inverse: true,
               axisLabel: { fontSize: 11, formatter: function (v) { return cut(v, lab()); } } },
      series: [
        { type: "bar", name: "פטורים", data: x.exempt, itemStyle: { color: "#0b3668" } },
        { type: "bar", name: "ניגשויות", data: x.att, itemStyle: { color: "#9fb4d3" } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    function hbar(id, d, unit) {
      var k = echarts.init(document.getElementById(id));
      k.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 16, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 3, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true,
                 axisLabel: { fontSize: 11, formatter: function (v) { return cut(v, lab()); } } },
        series: [{ type: "bar", name: unit, data: d.values }]
      }));
      window.addEventListener("resize", function () { k.resize(); });
    }
    hbar("chart-einst", {{ model.charts.e_inst | tojson }}, "פטורים");
    hbar("chart-surnames", {{ model.charts.surnames | tojson }}, "שמאים");
  })();
</script>
