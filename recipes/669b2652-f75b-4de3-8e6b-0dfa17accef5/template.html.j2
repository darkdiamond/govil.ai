<h1>מאגר שמאי מקרקעין</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.register.tone }} mb-1" dir="ltr">{{ model.kpis.register.display }}</div>
    <div class="text-sm text-subtle">שמאים בעלי רישיון במרשם</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.attempts.tone }} mb-1" dir="ltr">{{ model.kpis.attempts.display }}</div>
    <div class="text-sm text-subtle">ניגשויות לבחינות הרישוי</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.rate.tone }} mb-1" dir="ltr">{{ model.kpis.rate.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.rate_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.exempt.tone }} mb-1" dir="ltr">{{ model.kpis.exempt.display }}</div>
    <div class="text-sm text-subtle">פטורים מבחינה בזכות לימודים</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">ניגשויות לבחינות לפי שנה ותוצאה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.years_note }}</p>
  <div id="chart-years" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.years_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.years_caption }}</caption>
        <thead><tr><th scope="col">שנה</th><th scope="col">ניגשויות</th><th scope="col">עברו</th><th scope="col">נכשלו</th><th scope="col">ללא ציון</th></tr></thead>
        <tbody>
{%- for r in model.tables.years %}
          <tr><th scope="row">{{ r.year }}</th><td>{{ r.n }}</td><td>{{ r.passed }}</td><td>{{ r.failed }}</td><td>{{ r.none }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>

<section class="card p-5 mb-6">
