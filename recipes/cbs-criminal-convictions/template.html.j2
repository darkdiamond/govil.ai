{% import "gov.j2" as gov %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסמה {{ model.release.date }}</p>
{%- if model.release.headline %}
  <p class="m-0 mb-3 font-semibold text-ink-deep">{{ model.release.headline }}</p>
{%- endif %}
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

{%- set kpi_labels = {
  "conv": "מורשעים בדין (אלפים)",
  "def": "עומדים לדין (אלפים)",
  "rate": "מהעומדים לדין הורשעו",
  "minor_rate": "אחוז ההרשעה בקרב קטינים",
  "rec": "מהמורשעים הם מועדים",
} %}
<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["conv", "def", "rate", "minor_rate", "rec"] %}
{%- if model.kpis[key] is defined %}
  {{ gov.kpi(model.kpis[key], kpi_labels[key] ~ ", " ~ model.labels.year) }}
{%- endif %}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

<section class="card p-5 mb-6">
  {{ gov.head("trending-up", "עומדים לדין, מורשעים ומועדים לאורך השנים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.trend_note }} {{ model.labels.prov_note }}</p>
  {{ gov.chart("chart-trend", model.labels.trend_aria, "h-72 md:h-96") }}
  {{ gov.table("עומדים לדין, מורשעים בדין ומועדים (אלפים) לפי שנת פסק דין", ["שנת פסק דין", "עומדים לדין", "מורשעים בדין", "מועדים"], model.tables.trend, ltr=(1, 2, 3)) }}
</section>

{%- if model.flags.get("age_trend") %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "אחוז ההרשעה: מבוגרים וקטינים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.age_note }}</p>
  {{ gov.chart("chart-age", model.labels.age_aria, "h-72 md:h-80") }}
  {{ gov.table("אחוז המורשעים מבין העומדים לדין לפי גיל ושנת פסק דין", model.labels.age_cols, model.tables.age_trend, ltr=range(1, model.labels.age_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.get("comp") %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "מי הם המורשעים: מין, מועדות וקבוצת אוכלוסייה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.comp_note }}</p>
  {{ gov.chart("chart-comp", model.labels.comp_aria, "h-80 md:h-96") }}
  {{ gov.table("התפלגות המורשעים בדין (אחוזים)", model.labels.comp_cols, model.tables.comp, ltr=range(1, model.labels.comp_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.get("adult_off") %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "אחוז ההרשעה של מבוגרים לפי קבוצת עבירה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.adult_off_note }}</p>
  {{ gov.chart("chart-adult-off", model.labels.adult_off_aria, "h-[460px]") }}
  {{ gov.table("אחוז המורשעים מבין המבוגרים שעמדו לדין לפי קבוצת עבירה", model.labels.adult_off_cols, model.tables.adult_off, ltr=range(1, model.labels.adult_off_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.get("minor_off") %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "אחוז ההרשעה של קטינים לפי קבוצת עבירה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.minor_off_note }}</p>
  {{ gov.chart("chart-minor-off", model.labels.minor_off_aria, "h-80 md:h-96") }}
  {{ gov.table("אחוז המורשעים מבין הקטינים שעמדו לדין לפי קבוצת עבירה", model.labels.minor_off_cols, model.tables.minor_off, ltr=range(1, model.labels.minor_off_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.get("adult_pop") %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "מבוגרים: אחוז ההרשעה לפי קבוצת אוכלוסייה וקבוצת עבירה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.adult_pop_note }}</p>
  {{ gov.chart("chart-adult-pop", model.labels.adult_pop_aria, "h-[520px]") }}
  {{ gov.table("אחוז המורשעים מבין המבוגרים שעמדו לדין לפי קבוצת אוכלוסייה וקבוצת עבירה", model.labels.adult_pop_cols, model.tables.adult_pop, ltr=range(1, model.labels.adult_pop_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.get("minor_pop") %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "קטינים: אחוז ההרשעה לפי קבוצת אוכלוסייה וקבוצת עבירה") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.minor_pop_note }}</p>
  {{ gov.chart("chart-minor-pop", model.labels.minor_pop_aria, "h-[460px]") }}
  {{ gov.table("אחוז המורשעים מבין הקטינים שעמדו לדין לפי קבוצת אוכלוסייה וקבוצת עבירה", model.labels.minor_pop_cols, model.tables.minor_pop, ltr=range(1, model.labels.minor_pop_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.get("sexpop") %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "מבוגרים: אחוז ההרשעה לפי מין וקבוצת אוכלוסייה") }}
  <p class="m-0 text-sm text-subtle mb-3">אחוז המורשעים בדין מבין המבוגרים תושבי ישראל שעמדו לדין, שנת פסק דין {{ model.labels.year }}.</p>
  {{ gov.chart("chart-sexpop", model.labels.sexpop_aria, "h-64 md:h-80") }}
  {{ gov.table("אחוז המורשעים מבין המבוגרים שעמדו לדין לפי מין וקבוצת אוכלוסייה", ["קבוצה", "אחוז שהורשעו"], model.tables.sexpop, ltr=(1,)) }}
</section>
{%- endif %}

{%- if model.flags.get("court") %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "מבוגרים: אחוז ההרשעה לפי סוג בית משפט") }}
  <p class="m-0 text-sm text-subtle mb-3">אחוז המורשעים בדין מבין המבוגרים שעמדו לדין, לפי סוג בית המשפט שדן בתיק, שנת פסק דין {{ model.labels.year }}.</p>
  {{ gov.chart("chart-court", model.labels.court_aria, "h-64 md:h-80") }}
  {{ gov.table("אחוז המורשעים מבין המבוגרים שעמדו לדין לפי סוג בית משפט", ["סוג בית משפט", "אחוז שהורשעו"], model.tables.court, ltr=(1,)) }}
</section>
{%- endif %}

{%- if model.flags.get("cluster") %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "מבוגרים: אחוז ההרשעה לפי אשכול חברתי-כלכלי") }}
  <p class="m-0 text-sm text-subtle mb-3">אחוז המורשעים בדין מבין המבוגרים שעמדו לדין, לפי האשכול החברתי-כלכלי של יישוב המגורים (מהנמוך לגבוה), שנת פסק דין {{ model.labels.year }}. הקו המקווקו: סך הכל.</p>
  {{ gov.chart("chart-cluster", model.labels.cluster_aria, "h-64 md:h-80") }}
  {{ gov.table("אחוז המורשעים מבין המבוגרים שעמדו לדין לפי אשכול חברתי-כלכלי", ["אשכול", "אחוז שהורשעו"], model.tables.cluster, ltr=(1,)) }}
</section>
{%- endif %}

{%- if model.flags.get("oecd") %}
<section class="card p-5 mb-6">
  {{ gov.head("chart-bar", "השוואה בין-לאומית: מורשעים לכל 100 אלף נפש") }}
  <p class="m-0 text-sm text-subtle mb-3">מורשעים בדין לכל 100 אלף תושבים במדינות OECD שיש עליהן נתון (מקור: UNODC, כפי שפרסמה הלמ"ס). השיעור חושב מכלל האוכלוסייה. הלמ"ס מדגישה שהשיעור מושפע מהגדרות, ממדיניות האכיפה והתביעה ומאופן פעולת מערכת המשפט בכל מדינה, ולכן אינו מדד ישיר לרמת הפשיעה.</p>
  {{ gov.chart("chart-oecd", model.labels.oecd_aria, "h-[640px]") }}
  {{ gov.table("מורשעים בדין לכל 100 אלף נפש במדינות OECD", ["מדינה", "לכל 100 אלף נפש"], model.tables.oecd, ltr=(1,)) }}
</section>
{%- endif %}

{%- if model.flags.get("oecd_sex") %}
<section class="card p-5 mb-6">
  {{ gov.head("chart-bar", "השוואה בין-לאומית: גברים ונשים") }}
  <p class="m-0 text-sm text-subtle mb-3">גברים ונשים שהורשעו בדין לכל 100 אלף נפש, במדינות OECD שיש עליהן נתון לשני המינים (מקור: UNODC).</p>
  {{ gov.chart("chart-oecd-sex", model.labels.oecd_sex_aria, "h-[640px]") }}
  {{ gov.table("גברים ונשים מורשעים בדין לכל 100 אלף נפש במדינות OECD", ["מדינה", "גברים", "נשים"], model.tables.oecd_sex, ltr=(1, 2)) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>הנתונים מתוך ההודעה השנתית לתקשורת "מורשעים בדין במשפטים פליליים" של הלשכה המרכזית לסטטיסטיקה (הלמ"ס), לפי שנת פסק הדין. הנתונים עוסקים בתושבי ישראל שעמדו לדין.</li>
    <li>אחוז ההרשעה הוא אחוז המורשעים מבין מי שעמדו לדין. מועדים הם מורשעים שהורשעו גם בעבר. קטינים: מתחת לגיל 18 בעת ביצוע העבירה.</li>
    <li>הנתונים הם סיכומים ברמת קבוצה בלבד. הבדלים בין קבוצות מתארים את תוצאות ההליכים הפליליים, ואינם מלמדים לבדם על הסיבות להם.</li>
    <li>התרשימים בהודעה משתנים משנה לשנה. העמוד מציג את התרשימים שבהודעה האחרונה, ומשלים שנים חסרות מההודעה הקודמת.</li>
  </ul>
</section>

<script>
  (function () {
    const pal = window.GOVIL_PALETTE;
    const pct = (v) => v == null ? "לא מתפרסם" : v.toFixed(1) + "%";
    const thou = (v) => v == null ? "–" : v.toFixed(1) + " אלף";
    const num1 = (v) => v == null ? "–" : v.toLocaleString("he-IL", { maximumFractionDigits: 1 });
    function mount(id, opt) {
      const el = document.getElementById(id);
      if (!el) return;
      const chart = echarts.init(el);
      chart.setOption(window.GovEcharts.option(opt));
      window.addEventListener("resize", () => chart.resize());
    }
    function hbars(id, d, opts) {
      const series = (d.series || [{ name: opts.name || "", data: d.y }]).map((s, i) => {
        const o = { type: "bar", name: s.name, data: s.data, barMaxWidth: 22 };
        if (i === 0 && opts.total != null) {
          o.markLine = { symbol: "none", silent: true, lineStyle: { type: "dashed", color: "#0c3058" },
            label: { show: false }, data: [{ xAxis: opts.total }] };
        }
        if (opts.highlight) {
          o.data = s.data.map((v, j) => ({ value: v, itemStyle: { color: opts.highlight(d.x[j], i) } }));
        }
        return o;
      });
      mount(id, {
        color: opts.colors || [pal[0], "#b7d2f7"],
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: opts.fmt || pct },
        legend: series.length > 1 ? { top: 0 } : undefined,
        grid: { left: 16, right: 24, top: series.length > 1 ? 40 : 16, bottom: 16, containLabel: true },
        xAxis: { type: "value", max: opts.max, splitNumber: 4, axisLabel: { formatter: opts.axis || ((v) => v + "%"), hideOverlap: true } },
        yAxis: { type: "category", inverse: true, data: d.x, axisLabel: { width: 120, overflow: "break" } },
        series: series
      });
    }
    function vbars(id, d, total) {
      mount(id, {
        color: [pal[0]],
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: pct },
        grid: { left: 16, right: 24, top: 24, bottom: 16, containLabel: true },
        xAxis: { type: "category", data: d.x, axisLabel: { interval: 0, width: 70, overflow: "break" } },
        yAxis: { type: "value", max: 100, splitNumber: 4, axisLabel: { formatter: (v) => v + "%" } },
        series: [{ type: "bar", data: d.x.map((x, j) => ({ value: d.y[j], itemStyle: { color: x === "סך הכל" ? pal[1] : pal[0] } })),
          barMaxWidth: 40, label: { show: true, position: "top", formatter: (p) => pct(p.value) },
          markLine: total == null ? undefined : { symbol: "none", silent: true, lineStyle: { type: "dashed", color: "#0c3058" }, label: { show: false }, data: [{ yAxis: total }] } }]
      });
    }

    const tr = {{ model.charts.trend | tojson }};
    mount("chart-trend", {
      color: ["#b7d2f7", pal[0], pal[1]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: thou },
      legend: { top: 0 },
      grid: { left: 16, right: 24, top: 40, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: tr.x, axisLabel: { interval: 0, fontSize: 10 } },
      yAxis: { type: "value", axisLabel: { hideOverlap: true } },
      series: tr.series.map((s) => ({ type: "bar", name: s.name, data: s.data, barMaxWidth: 22 }))
    });
{%- if model.flags.get("age_trend") %}
    const ag = {{ model.charts.age_trend | tojson }};
    mount("chart-age", {
      color: [pal[1], pal[0], pal[2]],
      tooltip: { trigger: "axis", valueFormatter: pct },
      legend: { top: 0 },
      grid: { left: 16, right: 24, top: 40, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: ag.x, boundaryGap: false },
      yAxis: { type: "value", max: 100, axisLabel: { formatter: (v) => v + "%" } },
      series: ag.series.map((s) => ({ type: "line", name: s.name, data: s.data, symbolSize: 7, connectNulls: true }))
    });
{%- endif %}
{%- if model.flags.get("comp") %}
    hbars("chart-comp", {{ model.charts.comp | tojson }}, { max: 100, colors: [pal[1], pal[0], pal[2]] });
{%- endif %}
{%- if model.flags.get("adult_off") %}
    const ao = {{ model.charts.adult_off | tojson }};
    hbars("chart-adult-off", ao, { max: 100, total: ao.total });
{%- endif %}
{%- if model.flags.get("minor_off") %}
    const mo = {{ model.charts.minor_off | tojson }};
    hbars("chart-minor-off", mo, { max: 100, total: mo.total });
{%- endif %}
{%- if model.flags.get("adult_pop") %}
    hbars("chart-adult-pop", {{ model.charts.adult_pop | tojson }}, { max: 100, colors: [pal[0], pal[2]] });
{%- endif %}
{%- if model.flags.get("minor_pop") %}
    hbars("chart-minor-pop", {{ model.charts.minor_pop | tojson }}, { max: 100, colors: [pal[0], pal[2]] });
{%- endif %}
{%- if model.flags.get("sexpop") %}
    vbars("chart-sexpop", {{ model.charts.sexpop | tojson }}, null);
{%- endif %}
{%- if model.flags.get("court") %}
    vbars("chart-court", {{ model.charts.court | tojson }}, null);
{%- endif %}
{%- if model.flags.get("cluster") %}
    const cl = {{ model.charts.cluster | tojson }};
    vbars("chart-cluster", cl, cl.total);
{%- endif %}
{%- if model.flags.get("oecd") %}
    const oe = {{ model.charts.oecd | tojson }};
    hbars("chart-oecd", oe, { name: "לכל 100 אלף נפש", fmt: num1, axis: (v) => v,
      highlight: (x) => x === oe.israel ? pal[1] : x === oe.avg ? "#ffc107" : pal[2] });
{%- endif %}
{%- if model.flags.get("oecd_sex") %}
    hbars("chart-oecd-sex", {{ model.charts.oecd_sex | tojson }}, { fmt: num1, axis: (v) => v, colors: [pal[1], pal[2]] });
{%- endif %}
  })();
</script>
