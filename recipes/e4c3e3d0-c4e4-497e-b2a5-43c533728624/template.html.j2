<h1>כתב העת חברה ורווחה — מפתח מאמרים</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור מאמר בחברה ורווחה לפי שם, כותב או חוברת ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: שם המאמר, שמות הכותבים, החוברת, שנת הפרסום וסוג הפרסום — עם קישור לקובץ המאמר.</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.total_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.full.tone }} mb-1" dir="ltr">{{ model.kpis.full.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.full_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.span.tone }} mb-1" dir="ltr">{{ model.kpis.span.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.span_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.issues.tone }} mb-1" dir="ltr">{{ model.kpis.issues.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.issues_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.authors.tone }} mb-1" dir="ltr">{{ model.kpis.authors.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.authors_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.solo.tone }} mb-1" dir="ltr">{{ model.kpis.solo.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.solo_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">פרסומים לפי שנה וסוג</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.yearly_note }}</p>
  <div id="chart-yearly" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.yearly_aria }}" data-fallback="explorer"></div>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/list.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">סוגי הפרסומים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.types_note }}</p>
    <div id="chart-types" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.types_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.types_aria }}</caption>
        <thead><tr><th scope="col">סוג</th><th scope="col">פריטים</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.types %}
          <tr><th scope="row">{{ r.name }}</th><td dir="ltr">{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">מאמרים בחוברת</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.issues_note }}</p>
    <div id="chart-issues" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.issues_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.issues_aria }}</caption>
        <thead><tr><th scope="col">תקופה</th><th scope="col">חוברות</th><th scope="col">ממוצע מאמרים</th><th scope="col">מרבי</th></tr></thead>
        <tbody>
{%- for r in model.tables.issues %}
          <tr><th scope="row">{{ r.label }}</th><td dir="ltr">{{ r.issues }}</td><td dir="ltr">{{ r.mean }}</td><td dir="ltr">{{ r.max }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מכתיבת יחיד לכתיבה משותפת</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.coauthor_note }} {{ model.labels.decade_partial }}</p>
  <div id="chart-coauthor" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.coauthor_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.coauthor_aria }}</caption>
      <thead><tr><th scope="col">תקופה</th><th scope="col">מאמרים</th>{% for b in model.tables.buckets %}<th scope="col">{{ b }}</th>{% endfor %}<th scope="col">ממוצע כותבים</th></tr></thead>
      <tbody>
{%- for r in model.tables.coauthor %}
        <tr><th scope="row">{{ r.label }}</th><td dir="ltr">{{ r.n }}</td>{% for c in r.cells %}<td dir="ltr">{{ c }}</td>{% endfor %}<td dir="ltr">{{ r.mean }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
