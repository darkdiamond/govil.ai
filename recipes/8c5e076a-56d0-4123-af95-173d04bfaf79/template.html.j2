<script>
  (function () {
    function fmt(v) { return Number(v).toLocaleString("he-IL"); }
    function mk(id, opt) {
      var c = echarts.init(document.getElementById(id));
      opt.color = opt.color || window.GOVIL_PALETTE;
      c.setOption(window.GovEcharts.option(opt));
      window.addEventListener("resize", function () { c.resize(); });
    }
    var P = window.GOVIL_PALETTE, DOM_COLORS = [P[0], P[1], P[2]];
    var NARROW = window.innerWidth < 640, LW = NARROW ? 110 : 160;

    var d = {{ model.charts.domains | tojson }};
    mk("chart-domains", {
      color: [P[2], P[1], P[0]],
      tooltip: { trigger: "axis", valueFormatter: fmt },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: { interval: 0 } },
      yAxis: { type: "value" },
      series: [
        { type: "bar", name: "חברות", data: d.companies },
        { type: "bar", name: "קופות וקרנות", data: d.funds },
        { type: "bar", name: "מסלולים", data: d.tracks }
      ]
    });

    function stackedH(id, src, unit, lw) {
      mk(id, {
        color: DOM_COLORS,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return fmt(v) + " " + unit; } },
        legend: { bottom: 0 },
        grid: { left: 16, right: 24, top: 8, bottom: 40, containLabel: true },
        xAxis: { type: "value" },
        yAxis: { type: "category", data: src.names, inverse: true,
                 axisLabel: { width: lw || LW, overflow: "truncate" } },
        series: src.series.map(function (s) { return { type: "bar", stack: "t", name: s.name, data: s.data }; })
      });
    }
    stackedH("chart-types", {{ model.charts.types | tojson }}, "מסלולים");
    stackedH("chart-companies", {{ model.charts.companies | tojson }}, "מסלולים", NARROW ? 120 : 240);
    stackedH("chart-spec", {{ model.charts.spec | tojson }}, "מסלולים");
  })();
</script>

<script>
  (function () {
    function fmt(v) { return Number(v).toLocaleString("he-IL"); }
    function mk(id, opt) {
      var c = echarts.init(document.getElementById(id));
      opt.color = opt.color || window.GOVIL_PALETTE;
      c.setOption(window.GovEcharts.option(opt));
      window.addEventListener("resize", function () { c.resize(); });
    }
    var P = window.GOVIL_PALETTE, DOM_COLORS = [P[0], P[1], P[2]];
    var NARROW = window.innerWidth < 640, LW = NARROW ? 110 : 160;

    var tr = {{ model.charts.tree | tojson }};
    mk("chart-tree", {
      tooltip: { formatter: function (p) { return p.name + ": " + fmt(p.value) + " מסלולים"; } },
      series: [{
        type: "treemap", data: tr, roam: false, nodeClick: "zoomToNode", leafDepth: 1,
        top: 8, left: 4, right: 4, bottom: 32,
        breadcrumb: { bottom: 0, itemStyle: { color: "#0068f5" } },
        label: { show: true, fontFamily: "Rubik", formatter: "{b}" },
        upperLabel: { show: true, height: 22, fontFamily: "Rubik", color: "#fff" },
        levels: [
          { itemStyle: { borderColor: "#fff", borderWidth: 2, gapWidth: 2 } },
          { colorSaturation: [0.35, 0.6], itemStyle: { gapWidth: 1, borderColorSaturation: 0.6 } }
        ]
      }]
    });

    var b = {{ model.charts.banks | tojson }};
    mk("chart-banks", {
      color: DOM_COLORS,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return fmt(v) + " מסלולים"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: b.names, axisLabel: { interval: 0 } },
      yAxis: { type: "value", name: "מסלולים" },
      series: b.series.map(function (s) { return { type: "bar", stack: "t", name: s.name, data: s.data }; })
    });

    var p = {{ model.charts.pool | tojson }};
    mk("chart-pool", {
      color: [P[1], P[2]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: fmt },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: p.names, axisLabel: { interval: 0, width: 80, overflow: "break" } },
      yAxis: { type: "value" },
      series: [
        { type: "bar", name: "חשבונות", data: p.accounts },
        { type: "bar", name: "מסלולים", data: p.tracks }
      ]
    });

    var h = {{ model.charts.heat | tojson }};
    mk("chart-heat", {
      tooltip: { position: "top", formatter: function (q) {
        return h.y[q.value[1]] + " · " + h.x[q.value[0]] + ": " + fmt(q.value[2]) + " מסלולים";
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true }, axisLabel: { interval: 0 } },
      yAxis: { type: "category", data: h.y, inverse: true, splitArea: { show: true },
               axisLabel: { width: LW, overflow: "truncate" } },
      visualMap: {
        min: 0, max: h.max, calculable: true, dimension: 2,
        orient: "horizontal", left: "center", bottom: 8,
        inRange: { color: ["#f1f7ff", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells, label: { show: true, fontFamily: "Rubik",
                 formatter: function (q) { return q.value[2] ? fmt(q.value[2]) : ""; } } }]
    });
  })();
</script>

<script>
  (function () {
    function fmt(v) { return Number(v).toLocaleString("he-IL"); }
    function mk(id, opt) {
      var c = echarts.init(document.getElementById(id));
      opt.color = opt.color || window.GOVIL_PALETTE;
      c.setOption(window.GovEcharts.option(opt));
      window.addEventListener("resize", function () { c.resize(); });
    }
    var P = window.GOVIL_PALETTE, DOM_COLORS = [P[0], P[1], P[2]];
    var NARROW = window.innerWidth < 640, LW = NARROW ? 110 : 160;
    function pct100(id, src) {
      mk(id, {
        color: [P[0], P[1], P[6], P[9]],
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + "%"; } },
        legend: { bottom: 0 },
        grid: { left: 16, right: 24, top: 8, bottom: 64, containLabel: true },
        xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
        yAxis: { type: "category", data: src.names, inverse: true },
        series: src.series.map(function (s) { return { type: "bar", stack: "t", name: s.name, data: s.data }; })
      });
    }
    pct100("chart-modes", {{ model.charts.modes | tojson }});
    pct100("chart-structure", {{ model.charts.structure | tojson }});

    function hbar(id, src, unit) {
      mk(id, {
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return fmt(v) + " " + unit; } },
        grid: { left: 16, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value" },
        yAxis: { type: "category", data: src.names, inverse: true,
                 axisLabel: { width: LW, overflow: "truncate" } },
        series: [{ type: "bar", name: unit, data: src.values }]
      });
    }
    hbar("chart-operators", {{ model.charts.operators | tojson }}, "מסלולים");
    hbar("chart-city", {{ model.charts.cities | tojson }}, "חברות");

    var u = {{ model.charts.updated | tojson }};
    mk("chart-updated", {
      color: DOM_COLORS,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return fmt(v) + " מסלולים"; } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 48, containLabel: true },
      xAxis: { type: "category", data: u.x },
      yAxis: { type: "value", name: "מסלולים" },
      series: u.series.map(function (s) { return { type: "bar", stack: "t", name: s.name, data: s.data }; })
    });
  })();
</script>
