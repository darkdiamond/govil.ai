      <thead><tr><th scope="col">שימוש</th><th scope="col">מבנים</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.use %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
