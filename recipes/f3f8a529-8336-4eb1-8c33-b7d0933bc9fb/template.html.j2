{%- for chunk in model.map_chunks %}
<script type="application/json" id="map-s-{{ loop.index0 }}">{{ chunk | tojson }}</script>
{%- endfor %}
<script>
  (function () {
    var el = document.getElementById("map-main");
    if (!el || !window.L || !window.GovMap) { return; }
    var M = {{ model.map | tojson }};
    var G = M.grid, S = M.shapes;
    var ramp = ["#dbe8fb", "#9fc0ee", "#6c9fd8", "#0068f5", "#0b3668"];
    var bandRamp = ["#c3cfe7", "#9fc0ee", "#6c9fd8", "#3d70b0", "#0068f5", "#0053c4", "#0b3668", "#9a6700", "#dc3545"];
    function cls(v, br) {
      for (var i = 0; i < br.length; i++) { if (v <= br[i]) { return ramp[Math.min(i + ramp.length - br.length, ramp.length - 1)]; } }
      return ramp[ramp.length - 1];
    }
    function num(v) { return Number(v).toLocaleString("en-US"); }
    var popup = GovMap.popup;
    var map = L.map(el, { scrollWheelZoom: false, zoomSnap: 0.25, preferCanvas: true });
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 19, attribution: "© OpenStreetMap" }).addTo(map);
    function cell(c) {
      var la = G.lat0 + c[1] * G.step, lo = G.lon0 + c[0] * G.step;
      return [[la, lo], [la + G.step, lo + G.step]];
    }
    var gB = L.featureGroup(), gA = L.featureGroup();
    G.cells.forEach(function (c) {
      var info = popup(M.cell_title, [["מבנים", num(c[2])], ["דירות", num(c[3])]]);
      L.rectangle(cell(c), { stroke: false, fillColor: cls(c[2], G.breaks), fillOpacity: 0.55 }).bindPopup(info).addTo(gB);
      L.rectangle(cell(c), { stroke: false, fillColor: cls(c[3], G.breaks_apts), fillOpacity: c[3] > 0 ? 0.55 : 0.08 }).bindPopup(info).addTo(gA);
    });
    function path(flat) { return GovMap.ring(flat, S.origin, S.scale); }
    var shp = L.featureGroup(), used = {};
    GovMap.islands("map-s").forEach(function (f) {
      var c = bandRamp[f[0]] || "#0b3668";
      used[f[0]] = true;
      L.polygon(f[7].map(path), { color: c, weight: 1, fillColor: c, fillOpacity: 0.75 })
        .bindPopup(popup(S.uses[f[1]], [["שם", f[6]], ["קומות", num(f[2])], ["דירות", f[3] > 0 ? num(f[3]) : ""],
                                        ["כניסות", f[4] > 0 ? num(f[4]) : ""], ["תכסית", num(f[5]) + " מ\"ר"]]))
        .addTo(shp);
    });
    gB.addTo(map);
    shp.addTo(map);
    var base = {};
    base["מבנים בריבוע"] = gB;
    base["דירות בריבוע"] = gA;
    var over = {};
    over["מבנים גבוהים וגדולים"] = shp;
    L.control.layers(base, over, { collapsed: window.innerWidth < 640 }).addTo(map);
    map.fitBounds(M.bounds, { padding: [8, 8] });

    var legend = document.getElementById("map-legend");
    function item(color, text) {
      var li = document.createElement("li");
      li.className = "flex items-center gap-2";
      var sw = document.createElement("span");
      sw.style.cssText = "display:inline-block;width:12px;height:12px;border-radius:2px;background:" + color;
      li.appendChild(sw);
      li.appendChild(document.createTextNode(text));
      legend.appendChild(li);
    }
    function head(text) {
      var li = document.createElement("li");
      li.className = "w-full font-semibold text-ink";
      li.textContent = text;
      legend.appendChild(li);
    }
    function classes(br, unit) {
      var lo = 1;
      br.forEach(function (b, i) {
        var color = ramp[Math.min(i + ramp.length - br.length, ramp.length - 1)];
        item(color, (lo === b ? num(b) : num(lo) + "-" + num(b)) + " " + unit);
        lo = b + 1;
      });
    }
    var showing = "b";
    function draw() {
      legend.textContent = "";
      if (showing === "b") {
        head("מבנים בריבוע");
        classes(G.breaks, "מבנים");
      } else {
        head("דירות בריבוע");
        classes(G.breaks_apts, "דירות");
      }
      if (map.hasLayer(shp)) {
        head("מבנים גבוהים וגדולים, לפי קומות");
        M.bands.forEach(function (b, i) { if (used[i]) { item(bandRamp[i] || "#0b3668", b); } });
      }
    }
    map.on("baselayerchange", function (e) { showing = e.layer === gA ? "a" : "b"; draw(); });
    map.on("overlayadd overlayremove", draw);
    draw();
  })();
</script>

<script>
  (function () {
    function mk(id) {
      var el = document.getElementById(id);
      if (!el) { return null; }
      var c = echarts.init(el);
      window.addEventListener("resize", function () { c.resize(); });
      return c;
    }
    function hbar(id, names, values, unit, w) {
      var c = mk(id);
      if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 3 },
        yAxis: { type: "category", data: names.slice().reverse(), axisLabel: { width: w, overflow: "truncate" } },
        series: [{ type: "bar", name: unit, data: values.slice().reverse() }]
      }));
    }
    function vbar(id, names, values, unit) {
      var c = mk(id);
      if (!c) { return; }
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 16, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "category", data: names, axisLabel: { interval: 0, rotate: 30, width: 80, overflow: "truncate" } },
        yAxis: { type: "value" },
        series: [{ type: "bar", name: unit, data: values }]
      }));
    }
    var u = {{ model.charts.use | tojson }};
    hbar("chart-use", u.names, u.values, "מבנים", 120);
    var a = {{ model.charts.apts | tojson }};
    vbar("chart-apts", a.names, a.values, "מבני מגורים");
    var e = {{ model.charts.ent | tojson }};
    vbar("chart-ent", e.names, e.values, "מבנים");
    var un = {{ model.charts.units | tojson }};
    hbar("chart-units", un.names, un.values, "יחידות", 120);
    var q = {{ model.charts.quality | tojson }};
    hbar("chart-quality", q.names, q.values, "רשומות", 150);
  })();
</script>

<script>
  (function () {
    function pair(id, d, k1, n1, k2, n2, horizontal) {
      var el = document.getElementById(id);
      if (!el) { return; }
      var c = echarts.init(el);
      var cat = { type: "category", data: horizontal ? d.names.slice().reverse() : d.names,
                  axisLabel: horizontal ? { width: 110, overflow: "truncate" } : { interval: 0, rotate: 30 } };
      var val = { type: "value", axisLabel: { formatter: "{value}%" } };
      function ser(k, n) {
        return { type: "bar", name: n, data: horizontal ? d[k].slice().reverse() : d[k] };
      }
      c.setOption(window.GovEcharts.option({
        color: ["#0068f5", "#9a6700"],
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + "%"; } },
        legend: { bottom: 0 },
        grid: { left: 8, right: 24, top: 8, bottom: 40, containLabel: true },
        xAxis: horizontal ? val : cat,
        yAxis: horizontal ? cat : val,
        series: [ser(k1, n1), ser(k2, n2)]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    pair("chart-area", {{ model.charts.area | tojson }}, "cnt", "שיעור מהמבנים", "area", "שיעור משטח התכסית", true);
    pair("chart-stock", {{ model.charts.stock | tojson }}, "b", "שיעור ממבני המגורים", "a", "שיעור מהדירות", false);
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.floors | tojson }};
    var el = document.getElementById("chart-floors");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: ["#0068f5", "#c3cfe7"],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0 },
      grid: { left: 8, right: 16, top: 16, bottom: 40, containLabel: true },
      xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, rotate: 30 } },
      yAxis: { type: "value" },
      series: [
        { type: "bar", stack: "t", name: "מגורים", data: d.res },
        { type: "bar", stack: "t", name: "שימושים אחרים", data: d.other }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var x = {{ model.charts.box | tojson }};
    var el = document.getElementById("chart-box");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "item", formatter: function (p) {
        var v = p.value;
        return echarts.format.encodeHTML(p.name) + "<br>חציון: " + v[3] + " מ\"ר<br>רבעונים: " + v[2] + " עד " + v[4] + " מ\"ר";
      } },
      grid: { left: 8, right: 16, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: x.names, axisLabel: { interval: 0, rotate: 35, width: 80, overflow: "truncate" } },
      yAxis: { type: "value", name: "מ\"ר" },
      series: [{ type: "boxplot", name: "שטח תכסית", data: x.data,
                 itemStyle: { color: "#dbe8fb", borderColor: "#0068f5" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

