<script>
  (function () {
    function fmt(v) { return Number(v).toLocaleString("he-IL"); }
    function axisFmt(v) {
      if (Math.abs(v) >= 1000000) return (v / 1000000).toLocaleString("he-IL") + " מיליון";
      if (Math.abs(v) >= 1000) return (v / 1000).toLocaleString("he-IL") + " אלף";
      return v;
    }
    function make(id) {
      var el = document.getElementById(id);
      if (!el) return null;
      var c = echarts.init(el);
      window.addEventListener("resize", function () { c.resize(); });
      return { c: c, narrow: el.clientWidth < 500 };
    }
    function axisTip(unit, pct) {
      return function (ps) {
        var out = echarts.format.encodeHTML(ps[0].name);
        ps.forEach(function (p) {
          out += "<br>" + p.marker + echarts.format.encodeHTML(p.seriesName) + ": " +
            (pct ? Number(p.value).toFixed(1) + "%" : fmt(p.value) + (unit ? " " + unit : ""));
        });
        return out;
      };
    }
    window.KrCharts = {
      barH: function (id, d, unit, pct) {
        var m = make(id); if (!m) return;
        m.c.setOption(window.GovEcharts.option({
          tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
            var p = ps[0];
            return echarts.format.encodeHTML(p.name) + ": " + (pct ? Number(p.value).toFixed(1) + "%" : fmt(p.value) + " " + unit);
          } },
          grid: { left: 8, right: 56, top: 8, bottom: 8, containLabel: true },
          xAxis: { type: "value", axisLabel: { formatter: pct ? "{value}%" : axisFmt } },
          yAxis: { type: "category", inverse: true, data: d.names,
                   axisLabel: { width: m.narrow ? 110 : 190, overflow: "truncate" } },
          series: [{ type: "bar", data: d.values, barMaxWidth: 26,
                     label: { show: true, position: "right", formatter: function (p) {
                       return pct ? Number(p.value).toFixed(1) + "%" : fmt(p.value); } } }]
        }));
      },
      barV: function (id, d, unit) {
        var m = make(id); if (!m) return;
        m.c.setOption(window.GovEcharts.option({
          tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: axisTip(unit, false) },
          grid: { left: 8, right: 16, top: 24, bottom: 8, containLabel: true },
          xAxis: { type: "category", data: d.names, axisLabel: { interval: 0, rotate: m.narrow ? 45 : 0 } },
          yAxis: { type: "value", axisLabel: { formatter: axisFmt } },
          series: [{ type: "bar", name: unit, data: d.values, barMaxWidth: 48,
                     label: { show: !m.narrow, position: "top", formatter: function (p) { return fmt(p.value); } } }]
        }));
      },
      lines: function (id, d, unit, pct, partial) {
        var m = make(id); if (!m) return;
        var series = d.series.map(function (s) {
          return { name: s.name, type: "line", data: s.data, symbolSize: 5 };
        });
        m.c.setOption(window.GovEcharts.option({
          tooltip: { trigger: "axis", formatter: axisTip(unit, pct) },
          legend: { bottom: 0, type: "scroll" },
          grid: { left: 8, right: 16, top: 16, bottom: 64, containLabel: true },
          xAxis: { type: "category", data: d.x, axisLabel: { rotate: m.narrow ? 60 : 45 } },
          yAxis: { type: "value", max: pct ? 100 : null, axisLabel: { formatter: pct ? "{value}%" : axisFmt } },
          dataZoom: d.x.length > 20 ? [{ type: "inside" }] : [],
          series: series
        }));
      },
      stack: function (id, d, unit, pct, area) {
        var m = make(id); if (!m) return;
        var series = d.series.map(function (s) {
          return area ? { name: s.name, type: "line", stack: "all", areaStyle: {}, symbol: "none", data: s.data }
                      : { name: s.name, type: "bar", stack: "all", data: s.data, barMaxWidth: 36 };
        });
        m.c.setOption(window.GovEcharts.option({
          tooltip: { trigger: "axis", formatter: axisTip(unit, pct) },
          legend: { bottom: 0, type: "scroll" },
          grid: { left: 8, right: 16, top: 16, bottom: 72, containLabel: true },
          xAxis: { type: "category", data: d.x, boundaryGap: !area, axisLabel: { rotate: m.narrow ? 60 : 0 } },
          yAxis: { type: "value", max: pct ? 100 : null, axisLabel: { formatter: pct ? "{value}%" : axisFmt } },
          dataZoom: d.x.length > 20 ? [{ type: "inside" }] : [],
          series: series
        }));
      },
      grouped: function (id, d) {
        var m = make(id); if (!m) return;
        m.c.setOption(window.GovEcharts.option({
          tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: axisTip("", true) },
          legend: { bottom: 0 },
          grid: { left: 8, right: 48, top: 8, bottom: 40, containLabel: true },
          xAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
          yAxis: { type: "category", inverse: true, data: d.names,
                   axisLabel: { width: m.narrow ? 100 : 180, overflow: "truncate" } },
          series: d.series.map(function (s) {
            return { name: s.name, type: "bar", data: s.data, barMaxWidth: 16 };
          })
        }));
      }
    };
  })();
  (function () {
    var d = {{ model.charts.yearly | tojson }};
    window.KrCharts.lines("chart-yearly", d, "", false);
  })();
  (function () {
    var d = {{ model.charts.heat | tojson }};
    var el = document.getElementById("chart-heat");
    var c = echarts.init(el);
    var narrow = el.clientWidth < 500;
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return echarts.format.encodeHTML(d.months[p.value[0]] + " " + d.years[p.value[1]]) + ": " +
          Number(p.value[2]).toLocaleString("he-IL") + " תיקים";
      } },
      grid: { left: 8, right: 16, top: 16, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: d.months, splitArea: { show: true }, axisLabel: { interval: 0, rotate: narrow ? 60 : 0 } },
      yAxis: { type: "category", data: d.years, splitArea: { show: true } },
      visualMap: { min: 0, max: d.max, dimension: 2, calculable: true, orient: "horizontal", left: "center", bottom: 4,
                   inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
                   textStyle: { fontFamily: "Rubik", color: "#0c3058" } },
      series: [{ type: "heatmap", data: d.cells, label: { show: !narrow, fontFamily: "Rubik", fontSize: 10 },
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    window.KrCharts.barH("chart-funnel", {{ model.charts.funnel | tojson }}, "תיקים", false);
    window.KrCharts.barH("chart-reasons", {{ model.charts.reasons | tojson }}, "תיקים", false);
  })();
{%- if model.flags.mix %}
  (function () {
    window.KrCharts.stack("chart-mix", {{ model.charts.mix | tojson }}, "", true, false);
  })();
{%- endif %}
  (function () {
    window.KrCharts.barV("chart-duration", {{ model.charts.duration | tojson }}, "תיקים");
    window.KrCharts.stack("chart-courts", {{ model.charts.courts | tojson }}, "תיקים", false, false);
  })();
{%- if model.flags.cities %}
  (function () {
    window.KrCharts.barH("chart-cities", {{ model.charts.cities | tojson }}, "תיקים", false);
  })();
{%- endif %}
  (function () {
    var d = {{ model.charts.s42 | tojson }};
    window.KrCharts.lines("chart-s42", { x: d.x, series: [{ name: "כולל סעיף 42", data: d.y }] }, "", true);
    window.KrCharts.barV("chart-bank", {{ model.charts.bank | tojson }}, "תיקים");
    window.KrCharts.barV("chart-amt", {{ model.charts.amt | tojson }}, "תיקים");
  })();
</script>

