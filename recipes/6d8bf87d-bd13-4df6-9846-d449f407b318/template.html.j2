{%- macro head(icon, title) -%}
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/{{ icon }}.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ title }}</h2>
  </div>
{%- endmacro -%}
{%- macro tbl(caption, heads, rows, keys) -%}
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto relative">
      <table class="kr-table mt-2 w-full text-sm">
        <caption class="sr-only">{{ caption }}</caption>
        <thead><tr>{% for h in heads %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in rows %}
          <tr><th scope="row" class="font-normal">{{ r[keys[0]] }}</th>
{%- for k in keys[1:] %}{% set v = r[k] %}{% if v is string %}<td>{{ v }}</td>{% else %}{% for x in v %}<td>{{ x }}</td>{% endfor %}{% endif %}{% endfor -%}
          </tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
{%- endmacro -%}
<h1>מאגר הכונס הרשמי: תיקי פשיטת רגל, פירוק חברות ותביעות חוב</h1>

<style>
  .kr-table th, .kr-table td { padding: 0.35rem 0.5rem; text-align: start; vertical-align: top; }
  .kr-table tbody tr { border-top: 1px solid #c3cfe7; }
</style>

<section class="card p-5 mb-6">
  {{ head("info", "תקציר") }}
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
{%- if model.flags.ended_note %}
  <p class="m-0 mt-2 text-sm text-ink">{{ model.labels.ended_note }}</p>
{%- endif %}
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור חברה בפירוק או תיק פשיטת רגל ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: שם החברה ומספר החברה בקובץ החברות בפירוק, ועיר, בית משפט, סטטוס וסיבת ביטול בתיקי החייבים ובתביעות החוב.</span>
  </span>
</a>

