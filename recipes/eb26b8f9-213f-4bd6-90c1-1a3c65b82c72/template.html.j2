  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.movers_note }}</p>
  <div id="chart-movers" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.movers_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.movers_aria }}</caption>
      <thead><tr><th scope="col">קו</th><th scope="col">מפעילה</th><th scope="col">{{ model.labels.comp_label }}</th><th scope="col">{{ model.labels.lat_label }}</th><th scope="col">שינוי</th><th scope="col">שינוי באחוזים</th></tr></thead>
      <tbody>
