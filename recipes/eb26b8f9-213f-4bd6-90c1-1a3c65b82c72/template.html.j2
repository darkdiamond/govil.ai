  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.occ_note }}</p>
  <div id="chart-occ" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.occ_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
