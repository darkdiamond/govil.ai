  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.heat_aria }}</caption>
      <thead><tr><th scope="col">יום</th>{% for b in model.tables.heat_bands %}<th scope="col" dir="ltr">{{ b }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for r in model.tables.heat %}
        <tr><th scope="row">{{ r.day }}</th>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>
{%- endif %}

{%- if model.flags.sc %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
