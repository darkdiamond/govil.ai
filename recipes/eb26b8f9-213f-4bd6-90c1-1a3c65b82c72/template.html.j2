      <thead><tr><th scope="col">נוסעים לנסיעה</th><th scope="col">כיווני קו</th><th scope="col">חלק בכיווני הקו</th><th scope="col">חלק בנסיעות</th><th scope="col">חלק בעליות</th></tr></thead>
      <tbody>
{%- for r in model.tables.occ %}
