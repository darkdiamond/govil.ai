  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
{%- for m in model.charts.mix %}
    <div>
      <h3 class="m-0 mb-2 text-base font-semibold text-ink-deep">{{ m.title }}</h3>
      <div id="{{ m.id }}" class="h-64 md:h-80" role="img" aria-label="{{ m.title }}: חלק בכיווני הקו וחלק בעליות"></div>
    </div>
{%- endfor %}
  </div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">חלק בכיווני הקו וחלק בעליות לפי מאפיין</caption>
      <thead><tr><th scope="col">מאפיין</th><th scope="col">ערך</th><th scope="col">כיווני קו</th><th scope="col">חלק בכיווני הקו</th><th scope="col">עליות בשבוע</th><th scope="col">חלק בעליות</th></tr></thead>
      <tbody>
{%- for r in model.tables.mix %}
        <tr><td>{{ r.dim }}</td><th scope="row">{{ r.name }}</th><td>{{ r.n }}</td><td>{{ r.sn }}</td><td>{{ r.pax }}</td><td>{{ r.sp }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/triangle-alert.svg" alt="" class="w-5 h-5" />
