<h1>נסועה בקווי אוטובוס: מספר הנוסעים בכל קו</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור קו אוטובוס לפי מספר קו, מפעיל או יישוב ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: מספר קו, מפעילה, אשכול, מטרופולין, יישוב מוצא ויישוב יעד, ונסועה שבועית ויומית לכל קו.</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.pax.tone }} mb-1" dir="ltr">{{ model.kpis.pax.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.pax_kpi }}</div>
  </div>
{%- if model.flags.chg %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.chg.tone }} mb-1" dir="ltr">{{ model.kpis.chg.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.chg_kpi }}</div>
  </div>
{%- endif %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.rides.tone }} mb-1" dir="ltr">{{ model.kpis.rides.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.rides_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.routes.tone }} mb-1" dir="ltr">{{ model.kpis.routes.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.routes_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.occ.tone }} mb-1" dir="ltr">{{ model.kpis.occ.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.occ_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.low.tone }} mb-1" dir="ltr">{{ model.kpis.low.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.low_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">נסועה שבועית לפי רבעון</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.trend_note }}</p>
  <div id="chart-trend" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.trend_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.trend_aria }}</caption>
      <thead><tr><th scope="col">רבעון</th><th scope="col">עליות בשבוע</th><th scope="col">נסיעות בשבוע</th><th scope="col">נוסעים לנסיעה</th><th scope="col">ק״מ בשבוע</th><th scope="col">נוסעים לק״מ</th><th scope="col">עליות ביום שלישי</th><th scope="col">נסיעות ביום שלישי</th><th scope="col">כיווני קו</th></tr></thead>
      <tbody>
{%- for r in model.tables.trend %}
        <tr><th scope="row">{{ r.per }}</th><td>{{ r.pax }}</td><td>{{ r.rides }}</td><td>{{ r.occ }}</td><td>{{ r.km }}</td><td>{{ r.pkm }}</td><td>{{ r.dp }}</td><td>{{ r.dr }}</td><td>{{ r.rows }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">נסועה לפי מטרופולין</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.metro_note }}</p>
  <div id="chart-metro" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.metro_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.metro_aria }}</caption>
      <thead><tr><th scope="col">מטרופולין</th><th scope="col">כיווני קו</th><th scope="col">עליות בשבוע ({{ model.labels.lat_label }})</th><th scope="col">חלק</th>{% if model.flags.metro_comp %}<th scope="col">עליות בשבוע ({{ model.labels.comp_label }})</th><th scope="col">שינוי</th>{% endif %}</tr></thead>
      <tbody>
{%- for r in model.tables.metro %}
        <tr><th scope="row">{{ r.metro }}</th><td>{{ r.n }}</td><td>{{ r.pax }}</td><td>{{ r.share }}</td>{% if model.flags.metro_comp %}<td>{{ r.comp }}</td><td dir="ltr">{{ r.chg }}</td>{% endif %}</tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">המפעילות הגדולות</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.agency_note }}</p>
    <div id="chart-agency" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.agency_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.agency_aria }}</caption>
        <thead><tr><th scope="col">מפעילה</th><th scope="col">עליות בשבוע</th><th scope="col">חלק</th><th scope="col">כיווני קו</th></tr></thead>
        <tbody>
{%- for r in model.tables.agency %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.pax }}</td><td>{{ r.share }}</td><td>{{ r.n }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/list.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">האשכולות הגדולים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cluster_note }}</p>
    <div id="chart-cluster" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.cluster_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.cluster_aria }}</caption>
        <thead><tr><th scope="col">אשכול</th><th scope="col">עליות בשבוע</th><th scope="col">חלק</th><th scope="col">כיווני קו</th></tr></thead>
        <tbody>
{%- for r in model.tables.cluster %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.pax }}</td><td>{{ r.share }}</td><td>{{ r.n }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">הקווים העמוסים ביותר</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.top_note }}</p>
  <div id="chart-top" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.top_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.top_aria }}</caption>
      <thead><tr><th scope="col">קו</th><th scope="col">מפעילה</th><th scope="col">מטרופולין</th><th scope="col">עליות בשבוע</th><th scope="col">נסיעות בשבוע</th><th scope="col">נוסעים לנסיעה</th></tr></thead>
      <tbody>
{%- for r in model.tables.top %}
        <tr><th scope="row">{{ r.label }}</th><td>{{ r.agency }}</td><td>{{ r.metro }}</td><td>{{ r.pax }}</td><td>{{ r.rides }}</td><td>{{ r.occ }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

{%- if model.flags.movers %}
