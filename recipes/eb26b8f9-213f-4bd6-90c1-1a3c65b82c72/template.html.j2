{%- if model.flags.review %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/triangle-alert.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">קווים בהמלצה לבחינה מחדש</h2>
  </div>
  <p id="review-note" class="m-0 text-sm text-subtle mb-3">{{ model.labels.review_note }}</p>
  <div id="chart-review" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.review_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.review_aria }}</caption>
      <thead><tr><th scope="col">עדיפות</th><th scope="col">כיווני קו</th><th scope="col">עליות בשבוע</th><th scope="col">נסיעות בשבוע</th><th scope="col">חציון נוסעים לנסיעה</th></tr></thead>
      <tbody>
{%- for r in model.tables.review %}
        <tr><th scope="row">{{ r.prio }}</th><td>{{ r.n }}</td><td>{{ r.pax }}</td><td>{{ r.rides }}</td><td>{{ r.occ }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{%- endif %}

<script>
  (function () {
    var d = {{ model.charts.trend | tojson }};
    var c = echarts.init(document.getElementById("chart-trend"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                 valueFormatter: function (v) { return Number(v).toLocaleString("he-IL"); } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 72, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { hideOverlap: true } },
      yAxis: [
        { type: "value", name: "עליות בשבוע", axisLabel: { formatter: function (v) { return (v / 1e6).toLocaleString("he-IL") + " מיליון"; } } },
        { type: "value", name: "נסיעות בשבוע", splitLine: { show: false } }
      ],
      dataZoom: [{ type: "inside", startValue: d.zoom_start }, { type: "slider", startValue: d.zoom_start, bottom: 28, height: 16 }],
      series: [
        { type: "bar", name: "עליות בשבוע", data: d.pax },
        { type: "line", name: "נסיעות בשבוע", yAxisIndex: 1, data: d.rides, color: "#0b3668", symbolSize: 7 }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.metro | tojson }};
    var c = echarts.init(document.getElementById("chart-metro"));
    var series = [];
    if (d.comp_name) { series.push({ type: "bar", name: d.comp_name, data: d.comp, color: "#9ec5fe" }); }
    series.push({ type: "bar", name: d.latest_name, data: d.latest, color: "#0068f5" });
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                 valueFormatter: function (v) { return v == null ? "" : Number(v).toLocaleString("he-IL"); } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 40, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: function (v) { return (v / 1e6).toLocaleString("he-IL") + " מ׳"; } } },
      yAxis: { type: "category", data: d.y, inverse: true },
      series: series
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    function bars(id, d) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                   formatter: function (ps) {
                     var p = ps[0];
                     return echarts.format.encodeHTML(p.name) + ": " + Number(p.value).toLocaleString("he-IL") +
                       " עליות בשבוע (" + d.share[p.dataIndex] + "%)";
                   } },
        grid: { left: 16, right: 24, top: 16, bottom: 16, containLabel: true },
        xAxis: { type: "value", axisLabel: { formatter: function (v) { return (v / 1e6).toLocaleString("he-IL") + " מ׳"; } } },
        yAxis: { type: "category", data: d.y, inverse: true, axisLabel: { width: 120, overflow: "truncate" } },
        series: [{ type: "bar", name: "עליות בשבוע", data: d.v.map(function (v, i) {
          return d.y[i] === "אחר" ? { value: v, itemStyle: { color: "#c3cfe7" } } : v;
        }) }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    bars("chart-agency", {{ model.charts.agency | tojson }});
    bars("chart-cluster", {{ model.charts.cluster | tojson }});
  })();
</script>

