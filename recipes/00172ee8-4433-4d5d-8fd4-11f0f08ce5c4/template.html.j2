    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מבנה הגילים הארצי</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.struct_note }}</p>
  <div id="chart-struct" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.struct_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.struct_caption }}</caption>
      <thead><tr><th scope="col">קבוצת גיל</th><th scope="col">תושבים</th><th scope="col">חלק מהתושבים</th><th scope="col">ממוצע לשנת גיל</th></tr></thead>
      <tbody>
{%- for r in model.tables.struct %}
        <tr><th scope="row">{{ r.label }}</th><td>{{ "{:,}".format(r.count) }}</td><td dir="ltr">{{ r.share }}</td><td>{{ r.per_year }}</td></tr>
{%- endfor %}
