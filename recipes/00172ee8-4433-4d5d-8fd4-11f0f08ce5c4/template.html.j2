{%- if model.flags.extremes %}
<script>
  (function () {
    function draw(id, d, nat, color, what) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
          var i = p[0].dataIndex;
          return echarts.format.encodeHTML(d.names[i]) + "<br>" + d.v[i] + "% " + what + " · " + d.total[i].toLocaleString("he-IL") + " תושבים";
        } },
        grid: { left: 16, right: 40, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", min: 0, splitNumber: 4, axisLabel: { formatter: "{value}%" } },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { fontSize: 11, interval: 0 } },
        series: [{ type: "bar", name: what, data: d.v, itemStyle: { color: color },
                   label: { show: true, position: "right", fontSize: 10, formatter: "{c}%" },
                   markLine: { symbol: "none", silent: true, data: [{ xAxis: nat }],
                               lineStyle: { type: "dashed", color: "#6c757d" }, label: { show: false } } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    draw("chart-oldest", {{ model.charts.oldest | tojson }}, {{ model.charts.nat_old | tojson }}, "#0b3668", "בני 65 ומעלה");
    draw("chart-youngest", {{ model.charts.youngest | tojson }}, {{ model.charts.nat_kid | tojson }}, "#0068f5", "בני 18 ומטה");
  })();
</script>
{%- endif %}

