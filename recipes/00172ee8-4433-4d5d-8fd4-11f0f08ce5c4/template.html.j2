  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">הנתונים המפורסמים במסמך זה מבוססים על מרשם האוכלוסין ומכילים נתונים על מספר התושבים החיים, בין אם הם נמצאים בארץ או לאו.
נתונים אלו שונים מנתוני אוכלוסיה בישראל, המפורסמים על ידי הלשכה המרכזית לסטטיסטיקה, שכן הללו הם אומדנים המבוססים על מפקד אוכלוסין, תוך ניכוי הגרים בחו"ל במשך תקופה העולה על שנה.</p>
</section>

<script>
  (function () {
    var d = {{ model.charts.struct | tojson }};
    var c = echarts.init(document.getElementById("chart-struct"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        var s = d.labels[i] + "<br>" + d.counts[i].toLocaleString("he-IL") + " תושבים · " + d.shares[i] + "%";
        if (d.per_year[i] !== null) { s += "<br>" + d.per_year[i].toLocaleString("he-IL") + " בממוצע לשנת גיל"; }
        return s;
      } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 40, containLabel: true },
      xAxis: { type: "category", inverse: true, data: d.labels, axisLabel: { fontSize: 10, interval: 0, rotate: 30 } },
      yAxis: [
        { type: "value", name: "תושבים (מיליונים)", position: "right", nameTextStyle: { align: "right" }, axisLabel: { formatter: function (v) { return v / 1000000; } } },
        { type: "value", name: "לשנת גיל (אלפים)", position: "left", splitLine: { show: false }, axisLabel: { formatter: function (v) { return v / 1000; } } }
      ],
      series: [
        { type: "bar", name: "תושבים", data: d.counts, itemStyle: { color: "#0068f5" },
          label: { show: true, position: "top", fontSize: 10, formatter: function (p) { return d.shares[p.dataIndex] + "%"; } } },
        { type: "line", name: "ממוצע לשנת גיל", yAxisIndex: 1, data: d.per_year, connectNulls: false,
          symbolSize: 8, itemStyle: { color: "#0b3668" } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var P = window.GOVIL_PALETTE;
    var RAMP = ["#c3dafc", "#86b5f9", "#4a90f7", "#0068f5", "#0049ab", "#0b3668"];
    function stack(id, d) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: P,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + "%"; } },
        legend: { bottom: 0, itemGap: 8, itemWidth: 14 },
        grid: { left: 16, right: 16, top: 16, bottom: 72, containLabel: true },
        xAxis: { type: "value", min: 0, max: 100, axisLabel: { formatter: "{value}%" } },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { fontSize: 11, interval: 0 } },
        series: d.series.map(function (vals, i) {
          return { type: "bar", stack: "a", name: d.bands[i], data: vals, barMaxWidth: 28,
                   itemStyle: { color: RAMP[i % RAMP.length] } };
        })
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    stack("chart-districts", {{ model.charts.districts | tojson }});
    stack("chart-cities", {{ model.charts.cities | tojson }});
{%- if model.flags.council %}
    stack("chart-council", {{ model.charts.council | tojson }});
{%- endif %}
  })();
</script>

