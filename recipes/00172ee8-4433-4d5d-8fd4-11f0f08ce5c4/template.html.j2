{%- if model.flags.scatter %}
<script>
  (function () {
    var P = window.GOVIL_PALETTE;
    var SYM = ["circle", "rect", "triangle", "diamond"];
    var s = {{ model.charts.scatter | tojson }};
    var c = echarts.init(document.getElementById("chart-scatter"));
    c.setOption(window.GovEcharts.option({
      color: P,
      tooltip: { trigger: "item", formatter: function (p) {
        return echarts.format.encodeHTML(p.data[3]) + "<br>" + p.data[2].toLocaleString("he-IL") + " תושבים<br>" + p.data[0] +
          "% בני 18 ומטה · " + p.data[1] + "% בני 65 ומעלה";
      } },
      legend: { top: 0, type: "scroll" },
      grid: { left: 16, right: 24, top: 64, bottom: 40, containLabel: true },
      xAxis: { type: "value", name: "בני 18 ומטה", nameLocation: "middle", nameGap: 28, scale: true,
               axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "value", name: "בני 65 ומעלה", min: 0, axisLabel: { formatter: "{value}%" } },
      series: s.map(function (g) {
        return { type: "scatter", name: g.name, data: g.data, symbol: SYM[g.ci % SYM.length],
                 symbolSize: function (v) { return Math.max(5, Math.min(28, Math.sqrt(v[2]) / 18)); },
                 itemStyle: { color: P[g.ci % P.length], opacity: 0.75 } };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}

{%- if model.flags.change %}
<script>
  (function () {
    var d = {{ model.charts.change_bands | tojson }};
    var c = echarts.init(document.getElementById("chart-change-bands"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        return d.labels[i] + "<br>קובץ הארכיון: " + d.base[i].toLocaleString("he-IL") + "<br>הקובץ הנוכחי: " +
          d.cur[i].toLocaleString("he-IL") + "<br>שינוי: " + d.g[i] + "%";
      } },
      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 32, bottom: 40, containLabel: true },
      xAxis: { type: "category", inverse: true, data: d.labels, axisLabel: { fontSize: 10, interval: 0, rotate: 30 } },
      yAxis: { type: "value", name: "תושבים (מיליונים)", position: "right", nameTextStyle: { align: "right" }, axisLabel: { formatter: function (v) { return v / 1000000; } } },
      series: [
        { type: "bar", name: "קובץ הארכיון", data: d.base, itemStyle: { color: "#c3cfe7" } },
        { type: "bar", name: "הקובץ הנוכחי", data: d.cur, itemStyle: { color: "#0068f5" },
          label: { show: true, position: "top", fontSize: 10, formatter: function (p) {
            var g = d.g[p.dataIndex]; return "\u200e" + (g > 0 ? "+" : g < 0 ? "\u2212" : "") + Math.abs(g) + "%"; } } }
      ]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var e = {{ model.charts.change_dist | tojson }};
    var c2 = echarts.init(document.getElementById("chart-change-dist"));
