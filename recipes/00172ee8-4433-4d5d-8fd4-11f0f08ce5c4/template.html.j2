      legend: { bottom: 0 },
      grid: { left: 16, right: 16, top: 24, bottom: 48, containLabel: true },
      xAxis: { type: "category", inverse: true, data: e.names, axisLabel: { fontSize: 10, rotate: 30, interval: 0 } },
      yAxis: { type: "value", position: "right", axisLabel: { formatter: "{value}%" } },
      series: [
        { type: "bar", name: "כלל התושבים", data: e.t, itemStyle: { color: "#c3cfe7" } },
        { type: "bar", name: "בני 18 ומטה", data: e.k, itemStyle: { color: "#0068f5" } },
        { type: "bar", name: "בני 65 ומעלה", data: e.o, itemStyle: { color: "#0b3668" } }
      ]
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>
