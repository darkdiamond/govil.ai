{% import "gov.j2" as gov %}
{%- macro callout(key) -%}
{%- if model.callouts[key] is defined %}
  <p class="m-0 mb-3 text-sm font-semibold text-ink-deep">{{ model.callouts[key] }}</p>
{%- endif %}
{%- endmacro %}
{%- macro source(key) -%}
  <p class="m-0 text-xs text-subtle mb-3">הלוח בהודעה: {{ model.titles[key] }}</p>
{%- endmacro %}
<h1>{{ model.agent_data.seo.name }}</h1>

{{ gov.lede(model.labels.lede) }}

<section class="card p-5 mb-6">
  {{ gov.head("external-link", "ההודעה האחרונה של הלמ\"ס") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.release.title }} · פורסמה {{ model.release.date }}</p>
{%- if model.release.headline %}
  <p class="m-0 mb-3 font-semibold text-ink-deep">{{ model.release.headline }}</p>
{%- endif %}
  <p class="m-0 text-sm flex flex-wrap gap-4">
    <a href="{{ model.release.url }}" target="_blank" rel="noopener">להודעה המלאה באתר הלמ"ס</a>
{%- if model.release.pdf %}
    <a href="{{ model.release.pdf }}" target="_blank" rel="noopener">לדוח המלא (PDF)</a>
{%- endif %}
  </p>
</section>

<div class="grid gap-4 mb-6" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
{%- for key in ["total", "change", "private_avg", "top_share", "per_capita", "cars"] %}
{%- if model.kpis[key] is defined %}
  {{ gov.kpi(model.kpis[key], model.labels[key ~ "_kpi"]) }}
{%- endif %}
{%- endfor %}
</div>

{{ gov.insights(model.insights) }}

<section class="card p-5 mb-6">
  {{ gov.head("list", "איך מתחלקת הנסועה בין סוגי הרכב") }}
  <p class="m-0 text-sm text-subtle mb-2">החלק של כל סוג רכב מכלל הקילומטרים שנסעו כלי הרכב המנועיים בישראל בשנה.</p>
  {{ source("shares") }}
  {{ gov.chart("chart-shares", model.labels.shares_aria, "h-72 md:h-80") }}
  {{ gov.table("חלוקת הנסועה לפי סוג רכב", ["סוג רכב", "חלק מהנסועה"], model.tables.shares, ltr=(1,)) }}
</section>

{%- if model.flags.index %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "נסועה, מספר כלי הרכב והכבישים לאורך השנים") }}
  <p class="m-0 text-sm text-subtle mb-2">{{ model.labels.index_note }}</p>
  {{ source("index") }}
  {{ callout("covid") }}
  {{ gov.chart("chart-index", model.labels.index_aria, "h-72 md:h-96") }}
  {{ gov.table("נסועה, מצבת כלי רכב, אורך ושטח הכבישים (מדד)", ["שנה", "נסועה", "מצבת כלי רכב", "אורך כבישים", "שטח כבישים"], model.tables.index, ltr=(1, 2, 3, 4)) }}
</section>
{%- endif %}

{%- if model.flags.avgtype %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "נסועה ממוצעת לרכב לפי סוג רכב") }}
  <p class="m-0 text-sm text-subtle mb-2">כמה אלפי קילומטרים נוסע בממוצע כל רכב בשנה, לפי סוג הרכב.</p>
  {{ source("avgtype") }}
  {{ callout("avgtype") }}
  {{ gov.chart("chart-avgtype", model.labels.avgtype_aria, "h-72 md:h-80") }}
  {{ gov.table("נסועה ממוצעת לרכב (אלפי ק\"מ) לפי סוג רכב", model.labels.avgtype_cols, model.tables.avgtype, ltr=(1, 2)) }}
</section>
{%- endif %}

{%- if model.flags.totaltype %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "סך הנסועה לפי סוג רכב") }}
  <p class="m-0 text-sm text-subtle mb-2">סך הקילומטרים שנסעו כל כלי הרכב מכל סוג בשנה, במיליוני ק"מ.</p>
  {{ source("totaltype") }}
  {{ callout("totaltype") }}
  {{ gov.chart("chart-totaltype", model.labels.totaltype_aria, "h-72 md:h-80") }}
  {{ gov.table("סך הנסועה השנתית (מיליון ק\"מ) לפי סוג רכב", model.labels.totaltype_cols, model.tables.totaltype, ltr=(1, 2)) }}
</section>
{%- endif %}

{%- if model.flags.age %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "כמה נוסע רכב פרטי לפי גיל הרכב") }}
  <p class="m-0 text-sm text-subtle mb-2">נסועה שנתית ממוצעת של רכב פרטי באלפי ק"מ, לפי גיל הרכב בשנים.</p>
  {{ source("age") }}
  {{ callout("age") }}
  {{ gov.chart("chart-age", model.labels.age_aria, "h-64 md:h-80") }}
  {{ gov.table("נסועה ממוצעת לרכב פרטי לפי גיל הרכב", ["גיל הרכב (שנים)", "אלפי ק\"מ בשנה"], model.tables.age, ltr=(0, 1)) }}
</section>
{%- endif %}

{%- if model.flags.dist %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "כמה קילומטרים בשנה נוסעים רוב כלי הרכב הפרטיים") }}
  <p class="m-0 text-sm text-subtle mb-2">כמה כלי רכב פרטיים נמצאים בכל טווח של נסועה שנתית, באלפי ק"מ.</p>
  {{ source("dist") }}
  {{ callout("dist") }}
  {{ gov.chart("chart-dist", model.labels.dist_aria, "h-64 md:h-80") }}
  {{ gov.table("כלי רכב פרטיים לפי נסועה שנתית", ["נסועה שנתית (אלפי ק\"מ)", "כלי רכב", "אחוז"], model.tables.dist, ltr=(0, 1, 2)) }}
</section>
{%- endif %}

{%- if model.flags.distfuel %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "נסועה שנתית לפי סוג הנעה") }}
  <p class="m-0 text-sm text-subtle mb-2">בכל סוג הנעה: איזה אחוז מכלי הרכב הפרטיים נוסע בכל טווח של נסועה שנתית (אלפי ק"מ).</p>
  {{ source("distfuel") }}
  {{ callout("distfuel") }}
  {{ gov.chart("chart-distfuel", model.labels.distfuel_aria, "h-80 md:h-96") }}
  {{ gov.table("התפלגות הנסועה השנתית בכל סוג הנעה (אחוזים)", model.labels.distfuel_cols, model.tables.distfuel, ltr=range(1, model.labels.distfuel_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.agefuel %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "רכב חדש וותיק לפי סוג הנעה") }}
  <p class="m-0 text-sm text-subtle mb-2">נסועה שנתית ממוצעת של רכב פרטי באלפי ק"מ, לפי סוג ההנעה ולפי קבוצת הגיל של הרכב.</p>
  {{ source("agefuel") }}
  {{ callout("agefuel") }}
  {{ gov.chart("chart-agefuel", model.labels.agefuel_aria, "h-80 md:h-96") }}
  {{ gov.table("נסועה ממוצעת לרכב פרטי לפי סוג הנעה וקבוצת גיל (אלפי ק\"מ)", model.labels.agefuel_cols, model.tables.agefuel, ltr=range(1, model.labels.agefuel_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.owners %}
<section class="card p-5 mb-6">
  {{ gov.head("database", "רכב חדש: פרטי, ליסינג, חברה והשכרה") }}
  <p class="m-0 text-sm text-subtle mb-2">נסועה שנתית ממוצעת של כלי רכב פרטיים חדשים באלפי ק"מ, לפי מי שמחזיק ברכב, בכל שנה.</p>
  {{ source("owners") }}
  {{ callout("owners") }}
  {{ gov.chart("chart-owners", model.labels.owners_aria, "h-72 md:h-80") }}
  {{ gov.table("נסועה ממוצעת של רכב פרטי חדש לפי סוג בעלות (אלפי ק\"מ)", model.labels.owners_cols, model.tables.owners, ltr=range(1, model.labels.owners_cols | length) | list) }}
</section>
{%- endif %}

{%- if model.flags.oecd %}
<section class="card p-5 mb-6">
  {{ gov.head("list", "נסועה לנפש: ישראל מול מדינות OECD") }}
  <p class="m-0 text-sm text-subtle mb-2">כמה אלפי קילומטרים נוסעים כלי הרכב בשנה לכל תושב, בישראל ובמדינות OECD שבחרה הלמ"ס.</p>
  {{ source("oecd") }}
  {{ callout("oecd") }}
  {{ gov.chart("chart-oecd", model.labels.oecd_aria, "h-80 md:h-96") }}
  {{ gov.table("נסועה שנתית לנפש לפי מדינה (אלפי ק\"מ)", ["מדינה", "אלפי ק\"מ לנפש"], model.tables.oecd, ltr=(1,)) }}
</section>
{%- endif %}

<section class="card p-5 mb-6">
  {{ gov.head("tag", "על הנתונים") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm text-subtle marker:text-brand">
    <li>נסועה היא מספר הקילומטרים שנסעו כלי הרכב המנועיים בשנה (קילומטראז'). הנתונים מתוך ההודעה השנתית לתקשורת של הלשכה המרכזית לסטטיסטיקה על נסועת כלי הרכב בישראל.</li>
    <li>הנסועה הכוללת והנסועה הממוצעת של רכב פרטי מובאות כפי שפורסמו בכותרת ההודעה. הלוחות שבהודעה משתנים משנה לשנה, והעמוד מציג את הלוחות שמופיעים בהודעה האחרונה.</li>
    <li>חלק מהלוחות מתייחסים לכלל כלי הרכב הפרטיים וחלקם רק לכלי רכב בבעלות פרטית או לכלי רכב חדשים. כותרת הלוח המקורית מופיעה מעל כל תרשים.</li>
  </ul>
</section>

<script>
  (function () {
    const d = {{ model.charts.shares | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-shares"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => Number(v).toFixed(1) + "%" },
      grid: { left: 16, right: 56, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: false }, splitLine: { show: false } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 110, overflow: "break" } },
      series: [{ type: "bar", data: d.values,
        label: { show: true, position: "right", formatter: (p) => Number(p.value).toFixed(1) + "%" } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- if model.flags.index %}
  (function () {
    const d = {{ model.charts.index | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-index"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[2], pal[6], pal[5]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 64, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", scale: true },
      series: [
        { type: "line", name: "נסועה", data: d.km, showSymbol: false, lineStyle: { width: 3 } },
        { type: "line", name: "מצבת כלי רכב", data: d.fleet, showSymbol: false, lineStyle: { width: 3 } },
        { type: "line", name: "אורך כבישים", data: d.length, showSymbol: false },
        { type: "line", name: "שטח כבישים", data: d.area, showSymbol: false, lineStyle: { type: "dashed" } }
      ]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.avgtype %}
  (function () {
    const d = {{ model.charts.avgtype | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-avgtype"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => Number(v).toFixed(1) + " אלף ק\"מ" },
      grid: { left: 16, right: 48, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: false }, splitLine: { show: false } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 100, overflow: "break" } },
      series: [{ type: "bar", data: d.values,
        label: { show: true, position: "right", formatter: (p) => Number(p.value).toFixed(1) } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.totaltype %}
  (function () {
    const d = {{ model.charts.totaltype | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-totaltype"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[2]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => Number(v).toLocaleString("he-IL") + " מיליון ק\"מ" },
      grid: { left: 16, right: 64, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: false }, splitLine: { show: false } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 100, overflow: "break" } },
      series: [{ type: "bar", data: d.values,
        label: { show: true, position: "right", formatter: (p) => Number(p.value).toLocaleString("he-IL") } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.age %}
  (function () {
    const d = {{ model.charts.age | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-age"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => Number(v).toFixed(1) + " אלף ק\"מ" },
      grid: { left: 16, right: 16, top: 32, bottom: 32, containLabel: true },
      xAxis: { type: "category", data: d.names, name: "גיל הרכב", nameLocation: "middle", nameGap: 28 },
      yAxis: { type: "value", name: "אלפי ק\"מ" },
      series: [{ type: "bar", data: d.values,
        label: { show: true, position: "top", formatter: (p) => Number(p.value).toFixed(1) } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.dist %}
  (function () {
    const d = {{ model.charts.dist | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-dist"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[2]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
        formatter: (ps) => { const p = ps[0]; return echarts.format.encodeHTML(p.name) + " אלף ק\"מ<br>" +
          Number(p.value).toLocaleString("he-IL") + " כלי רכב (" + d.shares[p.dataIndex].toFixed(1) + "%)"; } },
      grid: { left: 16, right: 16, top: 32, bottom: 32, containLabel: true },
      xAxis: { type: "category", data: d.names, name: "אלפי ק\"מ בשנה", nameLocation: "middle", nameGap: 28 },
      yAxis: { type: "value", axisLabel: { formatter: (v) => v >= 1000 ? (v / 1000).toLocaleString("he-IL") + " אלף" : v } },
      series: [{ type: "bar", data: d.values,
        label: { show: true, position: "top", formatter: (p) => d.shares[p.dataIndex].toFixed(0) + "%" } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.distfuel %}
  (function () {
    const d = {{ model.charts.distfuel | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-distfuel"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[6], pal[8], pal[2], pal[0], pal[5], pal[1], pal[9]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + "%" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 56, bottom: 8, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: d.fuels, inverse: true, axisLabel: { width: 90, overflow: "break" } },
      series: d.bands.map((b, k) => ({ type: "bar", stack: "a", name: b, data: d.series[k] }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.agefuel %}
  (function () {
    const d = {{ model.charts.agefuel | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-agefuel"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[0], pal[6], pal[2], pal[5]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + " אלף ק\"מ" },
      legend: { top: 0 },
      grid: { left: 16, right: 40, top: 32, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: false }, splitLine: { show: false } },
      yAxis: { type: "category", data: d.fuels, inverse: true, axisLabel: { width: 90, overflow: "break" } },
      series: d.groups.map((g, k) => ({ type: "bar", name: g, data: d.series[k],
        label: { show: true, position: "right", formatter: (p) => p.value == null ? "" : Number(p.value).toFixed(1) } }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.owners %}
  (function () {
    const d = {{ model.charts.owners | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-owners"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[1], pal[2], pal[0], pal[6], pal[5]],
      tooltip: { trigger: "axis", valueFormatter: (v) => v == null ? "" : Number(v).toFixed(1) + " אלף ק\"מ" },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 64, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", name: "אלפי ק\"מ" },
      series: d.cats.map((c, k) => ({ type: "line", name: c, data: d.series[k], symbolSize: 7 }))
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
{%- if model.flags.oecd %}
  (function () {
    const d = {{ model.charts.oecd | tojson }};
    const pal = window.GOVIL_PALETTE;
    const chart = echarts.init(document.getElementById("chart-oecd"));
    chart.setOption(window.GovEcharts.option({
      color: [pal[6]],
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: (v) => Number(v).toFixed(1) + " אלף ק\"מ לנפש" },
      grid: { left: 16, right: 48, top: 8, bottom: 8, containLabel: true },
      xAxis: { type: "value", axisLabel: { show: false }, splitLine: { show: false } },
      yAxis: { type: "category", data: d.names, axisLabel: { width: 110, overflow: "break" } },
      series: [{ type: "bar",
        data: d.values.map((v, i) => d.names[i] === "ישראל" ? { value: v, itemStyle: { color: pal[0] } } : v),
        label: { show: true, position: "right", formatter: (p) => Number(p.value).toFixed(1) } }]
    }));
    window.addEventListener("resize", () => chart.resize());
  })();
{%- endif %}
</script>
