      series: [{ type: "bar", name: "ספיקת שיא מרבית", data: d.y,
        label: { show: true, position: "right", fontFamily: "Rubik", formatter: function (p) { return Math.round(p.value).toLocaleString("he-IL"); } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.scatter | tojson }};
    var c = echarts.init(document.getElementById("chart-scatter"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        var v = p.value;
        return echarts.format.encodeHTML(v[2]) + "<br>" + v[3] + "<br>" + v[1].toLocaleString("he-IL") +
          " מ״ק לשנייה<br>" + echarts.format.encodeHTML(p.seriesName);
      } },
      legend: { top: 0, type: "scroll" },
      grid: { left: 16, right: 24, top: 48, bottom: 56, containLabel: true },
      xAxis: { type: "value", scale: true, axisLabel: { formatter: function (v) { return String(Math.round(v)); } } },
      yAxis: { type: "log", name: "מ״ק/ש׳" },
      dataZoom: [{ type: "inside" }, { type: "slider", bottom: 8, height: 16 }],
      series: d.series.map(function (s) { return { type: "scatter", name: s.name, data: s.data, symbolSize: 9,
        itemStyle: { opacity: 0.8 } }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
