</section>

{%- if model.flags.storm %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/triangle-alert.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">שיטפונות ששברו שיאים בכמה תחנות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.storm_note }}</p>
  <div id="chart-storm" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.storm_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.storm_aria }}</caption>
      <thead><tr><th scope="col">אירוע</th><th scope="col">תחנות</th><th scope="col">הספיקה הגבוהה (מ״ק לשנייה)</th><th scope="col">בתחנה</th><th scope="col">אזורים</th></tr></thead>
      <tbody>
{%- for r in model.tables.storm %}
        <tr><th scope="row">{{ r.label }}</th><td>{{ r.n }}</td><td>{{ r.maxq }}</td><td>{{ r.lead }}</td><td>{{ r.regions }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>
{%- endif %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">הנחלים עם הספיקות הגבוהות ביותר</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.streams_note }}</p>
  <div id="chart-streams" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.streams_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.streams_aria }}</caption>
      <thead><tr><th scope="col">נחל</th><th scope="col">ספיקת שיא מרבית (מ״ק לשנייה)</th><th scope="col">תחנות</th></tr></thead>
      <tbody>
{%- for r in model.tables.streams %}
        <tr><th scope="row">{{ r.stream }}</th><td>{{ r.q }}</td><td>{{ r.n }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">כל השיאים על ציר הזמן</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.scatter_note }}</p>
  <div id="chart-scatter" class="h-80 md:h-[460px]" data-fallback="explorer" role="img" aria-label="{{ model.labels.scatter_aria }}"></div>
</section>

<script>
  (function () {
    var d = {{ model.charts.top | tojson }};
    var c = echarts.init(document.getElementById("chart-top"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        var i = p[0].dataIndex;
        return echarts.format.encodeHTML(d.names[i]) + "<br>" + d.y[i].toLocaleString("he-IL") +
          " מ״ק לשנייה<br>" + d.date[i] + "<br>" + echarts.format.encodeHTML(d.region[i]);
      } },
      grid: { left: 16, right: 48, top: 16, bottom: 32, containLabel: true },
      xAxis: { type: "value", name: "מ״ק/ש׳" },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { width: 120, overflow: "truncate" } },
      series: [{ type: "bar", name: "ספיקת שיא", data: d.y.map(function (v, i) {
        return i === 0 ? { value: v, itemStyle: { color: "#0b3668" } } : v;
      }), label: { show: true, position: "right", fontFamily: "Rubik", formatter: function (p) { return Math.round(p.value).toLocaleString("he-IL"); } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.region | tojson }};
    var c = echarts.init(document.getElementById("chart-region"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        var i = p.dataIndex, b = d.box[i];
        return echarts.format.encodeHTML(d.regions[i]) + " (" + d.n[i] + " תחנות)<br>מרבי: " + b[4].toLocaleString("he-IL") +
          "<br>רבעון עליון: " + b[3].toLocaleString("he-IL") + "<br>חציון: " + b[2].toLocaleString("he-IL") +
          "<br>רבעון תחתון: " + b[1].toLocaleString("he-IL") + "<br>מזערי: " + b[0].toLocaleString("he-IL") + " מ״ק לשנייה";
      } },
      grid: { left: 16, right: 24, top: 16, bottom: 40, containLabel: true },
      xAxis: { type: "log", name: "מ״ק/ש׳", nameLocation: "middle", nameGap: 26 },
      yAxis: { type: "category", data: d.regions, inverse: true, axisLabel: { width: 130, overflow: "truncate" } },
      series: [{ type: "boxplot", name: "ספיקת שיא", data: d.box,
        itemStyle: { color: "#f1f7ff", borderColor: "#0068f5", borderWidth: 2 } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.dist | tojson }};
    var c = echarts.init(document.getElementById("chart-dist"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        return p[0].name + " מ״ק לשנייה<br>" + p[0].value + " תחנות";
      } },
      grid: { left: 16, right: 16, top: 24, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { interval: 0, rotate: 35 } },
      yAxis: { type: "value", name: "תחנות", minInterval: 1 },
      series: [{ type: "bar", name: "תחנות", data: d.y, label: { show: true, position: "top", fontFamily: "Rubik" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.age | tojson }};
    var c = echarts.init(document.getElementById("chart-age"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (p) {
        return p[0].name + "<br>" + p[0].value + " תחנות";
      } },
      grid: { left: 16, right: 16, top: 24, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { interval: 0, rotate: 35 } },
      yAxis: { type: "value", name: "תחנות", minInterval: 1 },
      series: [{ type: "bar", name: "תחנות", data: d.y, itemStyle: { color: "#0b3668" },
        label: { show: true, position: "top", fontFamily: "Rubik" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.dec | tojson }};
    var c = echarts.init(document.getElementById("chart-dec"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 48, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { rotate: 35 } },
      yAxis: { type: "value", name: "שיאים", minInterval: 1 },
      series: d.series.map(function (s) { return { type: "bar", stack: "r", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.mon | tojson }};
    var c = echarts.init(document.getElementById("chart-mon"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 48, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { interval: 0, rotate: 45 } },
      yAxis: { type: "value", name: "שיאים", minInterval: 1 },
      series: d.series.map(function (s) { return { type: "bar", stack: "r", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
