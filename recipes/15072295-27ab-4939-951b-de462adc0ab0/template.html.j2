<h1>ספיקות שיא היסטוריות בתחנות הידרומטריות</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור ספיקת השיא של תחנה לפי שם או מספר תחנה ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: זיהוי תחנה, שם התחנה בעברית ובאנגלית, שנה הידרולוגית ותאריך המדידה.</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
{%- for key in ["stations", "max", "median", "recent", "span"] %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.labels['kpi_' ~ key] }}</div>
  </div>
{%- endfor %}
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">התחנות עם ספיקת השיא הגבוהה ביותר</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.top_note }}</p>
  <div id="chart-top" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.top_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.top_aria }}</caption>
      <thead><tr><th scope="col">תחנה</th><th scope="col">ספיקת שיא (מ״ק לשנייה)</th><th scope="col">תאריך</th><th scope="col">רום המים (מ׳)</th><th scope="col">אזור</th></tr></thead>
      <tbody>
{%- for r in model.tables.top %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.q }}</td><td>{{ r.date }}</td><td>{{ r.stage }}</td><td>{{ r.region }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">ספיקות השיא לפי אזור ניקוז</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.region_note }}</p>
  <div id="chart-region" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.region_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.region_aria }}</caption>
      <thead><tr><th scope="col">אזור</th><th scope="col">תחנות</th><th scope="col">חציון (מ״ק לשנייה)</th><th scope="col">מרבי (מ״ק לשנייה)</th><th scope="col">התחנה המובילה</th></tr></thead>
      <tbody>
{%- for r in model.tables.region %}
        <tr><th scope="row">{{ r.region }}</th><td>{{ r.n }}</td><td>{{ r.median }}</td><td>{{ r.max }}</td><td>{{ r.lead }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <h2 class="m-0 mb-3 text-base font-semibold text-ink-deep">התפלגות ספיקות השיא</h2>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.dist_note }}</p>
    <div id="chart-dist" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.dist_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.dist_aria }}</caption>
        <thead><tr><th scope="col">ספיקת שיא (מ״ק לשנייה)</th><th scope="col">תחנות</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.dist %}
          <tr><th scope="row">{{ r.bin }}</th><td>{{ r.n }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <h2 class="m-0 mb-3 text-base font-semibold text-ink-deep">כמה זמן עומד השיא</h2>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.age_note }}</p>
    <div id="chart-age" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.age_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.age_aria }}</caption>
        <thead><tr><th scope="col">גיל השיא</th><th scope="col">תחנות</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.age %}
          <tr><th scope="row">{{ r.bin }}</th><td>{{ r.n }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מתי נקבעו השיאים: לפי עשור</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.dec_note }}</p>
  <div id="chart-dec" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.dec_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.dec_aria }}</caption>
      <thead><tr><th scope="col">עשור</th><th scope="col">שיאים</th></tr></thead>
      <tbody>
{%- for r in model.tables.dec %}
        <tr><th scope="row">{{ r.dec }}</th><td>{{ r.n }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">עונת השיטפונות: החודש שבו נמדד השיא</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.mon_note }}</p>
  <div id="chart-mon" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.mon_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.mon_aria }}</caption>
      <thead><tr><th scope="col">חודש</th><th scope="col">שיאים</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.mon %}
        <tr><th scope="row">{{ r.month }}</th><td>{{ r.n }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
