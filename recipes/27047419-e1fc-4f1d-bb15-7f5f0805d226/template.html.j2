<section class="card p-5 mb-6">
  {{ icon_head("סוגי תחנות מיוחדים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.types_note }}</p>
  <div id="chart-types" class="h-80 md:h-[420px]" role="img" aria-label="{{ model.labels.types_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.types_caption }}</caption>
      <thead><tr><th scope="col">סוג תחנה</th><th scope="col">תחנות</th><th scope="col">גוף מפעיל עיקרי</th></tr></thead>
      <tbody>
{%- for r in model.tables.types %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.op }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

{% if model.flags.heat %}
<section class="card p-5 mb-6">
  {{ icon_head("סוג התחנה לפי מטרופולין") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.heat_note }}</p>
  <div id="chart-heat" class="h-96 md:h-[460px]" role="img" aria-label="{{ model.labels.heat_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.heat_caption }}</caption>
      <thead><tr><th scope="col">סוג תחנה</th>{% for h in model.tables.heat_head %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for r in model.tables.heat %}
        <tr><th scope="row">{{ r.label }}</th>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>
{% endif %}

{% if model.flags.ops %}
<section class="card p-5 mb-6">
  {{ icon_head("אמצעי תחבורה לפי מטרופולין") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.ops_note }}</p>
  <div id="chart-ops" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.ops_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.ops_caption }}</caption>
      <thead><tr><th scope="col">סוג מפעיל</th><th scope="col">סה״כ</th><th scope="col">שיעור</th>{% for h in model.tables.ops_head %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for r in model.tables.ops %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td>{% for c in r.cells %}<td>{{ c }}</td>{% endfor %}</tr>
{%- endfor %}
