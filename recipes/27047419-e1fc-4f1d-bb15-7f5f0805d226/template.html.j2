{%- macro icon_head(title, icon="database") -%}
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/{{ icon }}.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ title }}</h2>
  </div>
{%- endmacro -%}
<h1>תחנות תחבורה ציבורית</h1>

<section class="card p-5 mb-6">
  {{ icon_head("תקציר", "info") }}
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">תחנות תחבורה ציבורית</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.locs.tone }} mb-1" dir="ltr">{{ model.kpis.locs.display }}</div>
    <div class="text-sm text-subtle">יישובים ומועצות אזוריות</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.metro_share.tone }} mb-1" dir="ltr">{{ model.kpis.metro_share.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.metro_share_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.rail.tone }} mb-1" dir="ltr">{{ model.kpis.rail.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.rail_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  {{ icon_head("תובנות עיקריות", "circle-check") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  {{ icon_head("מפת התחנות", "map-pin") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.map_note }}</p>
  <div id="map-main" class="h-72 md:h-[420px]" role="region" aria-label="{{ model.labels.map_aria }}"></div>
</section>

<section class="card p-5 mb-6">
  {{ icon_head("תחנות לפי מטרופולין") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.metro_note }}</p>
  <div id="chart-metros" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.metro_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.metro_caption }}</caption>
      <thead><tr><th scope="col">מטרופולין</th><th scope="col">תחנות</th><th scope="col">שיעור</th><th scope="col">יישובים</th></tr></thead>
      <tbody>
{%- for r in model.tables.metros %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td><td>{{ r.locs }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    {{ icon_head("פריסה מדרום לצפון", "map-pin") }}
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.bands_note }}</p>
    <div id="chart-bands" class="h-96 md:h-[460px]" role="img" aria-label="{{ model.labels.bands_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.bands_caption }}</caption>
        <thead><tr><th scope="col">קו רוחב (מעלות)</th><th scope="col">תחנות</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.bands %}
          <tr><th scope="row" dir="ltr">{{ r.label }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    {{ icon_head("צפיפות התחנות", "map-pin") }}
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.grid_note }}</p>
    <div id="chart-grid" class="h-96 md:h-[460px]" role="img" aria-label="{{ model.labels.grid_aria }}" data-fallback="explorer"></div>
  </section>
</div>

<section class="card p-5 mb-6">
  {{ icon_head("היישובים המובילים", "building-2") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cities_note }}</p>
  <div id="chart-cities" class="h-96 md:h-[460px]" role="img" aria-label="{{ model.labels.cities_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.cities_caption }}</caption>
      <thead><tr><th scope="col">יישוב / מועצה</th><th scope="col">תחנות</th><th scope="col">שיעור</th><th scope="col">מטרופולין</th></tr></thead>
      <tbody>
{%- for r in model.tables.cities %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td><td>{{ r.metro }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    {{ icon_head("ריכוז התחנות ביישובים") }}
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.conc_note }}</p>
    <div id="chart-conc" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.conc_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.conc_caption }}</caption>
        <thead><tr><th scope="col">היישובים המובילים</th><th scope="col">שיעור מצטבר מהתחנות</th></tr></thead>
        <tbody>
{%- for r in model.tables.conc %}
          <tr><th scope="row">{{ r.rank }}</th><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    {{ icon_head("גודל היישובים במספר תחנות") }}
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.sizes_note }}</p>
    <div id="chart-sizes" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.sizes_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.sizes_caption }}</caption>
        <thead><tr><th scope="col">תחנות ביישוב</th><th scope="col">יישובים</th><th scope="col">שיעור היישובים</th><th scope="col">תחנות</th><th scope="col">שיעור התחנות</th></tr></thead>
        <tbody>
{%- for r in model.tables.sizes %}
          <tr><th scope="row" dir="ltr">{{ r.label }}</th><td>{{ r.locs }}</td><td dir="ltr">{{ r.locs_share }}</td><td>{{ r.stops }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
