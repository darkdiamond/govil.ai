<section class="card p-5 mb-6">
  {{ icon_head("תיאור מקורי", "list") }}
  <p class="m-0 text-sm text-subtle whitespace-pre-line">קובץ עזר לשיוך מרחבי של תחנות אוטובוס, רק"ל ורכבת ישראל.
השיוכים הקיימים במאגר הם למטרופולין, שטח ישוב \ מועצה אזורית, שכונה ואזור סטטיסטי. בנוסף הקובץ מכיל גם קואורדינטות מיקום התחנה בפורמט WGS84 לביצוע ניתוחים גיאוגרפים שונים.</p>
</section>

<script>
  GovMap.create({
    container: "#map-main",
    resourceId: {{ inputs.main[0].id | tojson }},
    latField: "Lat",
    lngField: "Long",
    projection: "wgs84",
    cluster: true,
    popupTitleField: "CityName",
    popupFields: [
      { field: "StationId", label: "מספר תחנה" },
      { field: "StationTypeName", label: "סוג תחנה" },
      { field: "StationOperatorTypeName", label: "גוף מפעיל" },
      { field: "MetropolinName", label: "מטרופולין" }
    ]
  });
</script>

<script>
  (function () {
    var m = {{ model.charts.metros | tojson }};
    var c1 = echarts.init(document.getElementById("chart-metros"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                 valueFormatter: function (v) { return v.toLocaleString("he-IL"); } },
      grid: { left: 16, right: 56, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "value" },
      yAxis: { type: "category", data: m.names, inverse: true, axisLabel: { interval: 0 } },
      series: [{ type: "bar", name: "תחנות",
                 label: { show: true, position: "right", fontFamily: "Rubik",
                          formatter: function (p) { return p.value.toLocaleString("he-IL"); } },
                 data: m.values.map(function (v, i) { return { value: v, itemStyle: { color: m.colors[i] } }; }) }]
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    var b = {{ model.charts.bands | tojson }};
    var c2 = echarts.init(document.getElementById("chart-bands"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                 valueFormatter: function (v) { return v.toLocaleString("he-IL"); } },
      legend: { type: "scroll", bottom: 0 },
      grid: { left: 16, right: 16, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "value", splitNumber: 3 },
      yAxis: { type: "category", data: b.names, name: "קו רוחב", axisLabel: { interval: 0, fontSize: 11 } },
      series: b.series.map(function (s) {
        return { type: "bar", stack: "b", name: s.name, data: s.data, itemStyle: { color: s.color } };
      })
    }));
    window.addEventListener("resize", function () { c2.resize(); });
  })();
</script>

<script>
  (function () {
    var g = {{ model.charts.grid | tojson }};
    var el = document.getElementById("chart-grid");
    var c = echarts.init(el);
    var pts = g.cells.map(function (k) {
      return [(g.o0 + k[0] + 0.5) * g.step, (g.a0 + k[1] + 0.5) * g.step, k[2]];
    });
    var lonMin = g.o0 * g.step, lonMax = (g.o0 + g.no) * g.step;
    var latMin = g.a0 * g.step, latMax = (g.a0 + g.na) * g.step;
    c.setOption(window.GovEcharts.option({
      tooltip: { formatter: function (p) {
        return "תחנות בתא: " + p.value[2].toLocaleString("he-IL") +
               "<br>" + p.value[1].toFixed(3) + "°, " + p.value[0].toFixed(3) + "°";
      } },
      grid: { left: 8, right: 8, top: 8, bottom: 56 },
      xAxis: { type: "value", min: lonMin, max: lonMax, show: false },
      yAxis: { type: "value", min: latMin, max: latMax, show: false },
      visualMap: {
        type: "piecewise", dimension: 2, pieces: g.pieces,
        orient: "horizontal", left: "center", bottom: 0, itemWidth: 14, itemGap: 6,
        inRange: { color: ["#b7d2f7", "#7fa9ea", "#3d86ef", "#0068f5", "#0053c4", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058", fontSize: 11 }
      },
      series: [{ type: "scatter", symbol: "rect", symbolSize: 4, data: pts, large: false }]
    }));
    function fit() {
      var W = el.clientWidth, H = el.clientHeight - 64;
      var midLat = (latMin + latMax) / 2 * Math.PI / 180;
      var r = (lonMax - lonMin) * Math.cos(midLat) / (latMax - latMin);
      var w = W - 16, h = H;
      if (w / h > r) { w = h * r; } else { h = w / r; }
      c.setOption({ grid: { left: (W - w) / 2, top: 8, width: w, height: h, bottom: null, right: null } });
      var p0 = c.convertToPixel({ gridIndex: 0 }, [lonMin, latMin]);
      var p1 = c.convertToPixel({ gridIndex: 0 }, [lonMin + g.step, latMin + g.step]);
      if (!p0 || !p1) return;
      var sw = Math.max(1, Math.abs(p1[0] - p0[0])), sh = Math.max(1, Math.abs(p1[1] - p0[1]));
      c.setOption({ series: [{ symbolSize: [sw, sh] }] });
    }
    fit();
    window.addEventListener("resize", function () { c.resize(); fit(); });
  })();
</script>

<script>
  (function () {
    var t = {{ model.charts.cities | tojson }};
    var c1 = echarts.init(document.getElementById("chart-cities"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        return p.name + "<br>" + p.seriesName + ": " + p.value.toLocaleString("he-IL") + " תחנות";
      } },
      legend: { type: "scroll", bottom: 0 },
      grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "value", splitNumber: 3 },
      yAxis: { type: "category", data: t.names, inverse: true, axisLabel: { interval: 0, fontSize: 11 } },
      series: t.series.map(function (s) {
        return { type: "bar", stack: "c", name: s.name, data: s.data, itemStyle: { color: s.color } };
      })
    }));
    window.addEventListener("resize", function () { c1.resize(); });

    var q = {{ model.charts.conc | tojson }};
    var c2 = echarts.init(document.getElementById("chart-conc"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", formatter: function (ps) {
        var p = ps[0];
        return "היישובים המובילים: " + p.value[0].toLocaleString("he-IL") + "<br>שיעור מצטבר: " + p.value[1] + "%";
      } },
      grid: { left: 40, right: 24, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "log", min: 1, max: q.y.length, name: "דירוג היישוב", nameLocation: "middle", nameGap: 28 },
      yAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      series: [{ type: "line", showSymbol: false, areaStyle: { opacity: 0.15 },
                 data: q.y.map(function (v, i) { return [i + 1, v]; }) }]
    }));
    window.addEventListener("resize", function () { c2.resize(); });

    var z = {{ model.charts.sizes | tojson }};
    var narrow = document.getElementById("chart-sizes").clientWidth < 500;
    var c3 = echarts.init(document.getElementById("chart-sizes"));
    c3.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                 valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 40, right: 16, top: 24, bottom: narrow ? 76 : 56, containLabel: true },
      xAxis: { type: "category", data: z.names, name: "תחנות ביישוב", nameLocation: "middle", nameGap: narrow ? 46 : 26,
               axisLabel: { interval: 0, fontSize: 11, rotate: narrow ? 35 : 0 } },
      yAxis: { type: "value", axisLabel: { formatter: "{value}%" } },
      series: [{ type: "bar", name: "שיעור מהיישובים", data: z.locs },
               { type: "bar", name: "שיעור מהתחנות", data: z.stops }]
    }));
    window.addEventListener("resize", function () { c3.resize(); });
  })();
</script>

<script>
  (function () {
    var t = {{ model.charts.types | tojson }};
    var c1 = echarts.init(document.getElementById("chart-types"));
    c1.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 48, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "value", splitNumber: 3 },
      yAxis: { type: "category", data: t.names, inverse: true, axisLabel: { interval: 0, fontSize: 11 } },
      series: [{ type: "bar", name: "תחנות", data: t.values,
                 label: { show: true, position: "right", fontFamily: "Rubik" } }]
    }));
    window.addEventListener("resize", function () { c1.resize(); });
  })();
</script>

{% if model.flags.heat %}
<script>
  (function () {
    var h = {{ model.charts.heat | tojson }};
    var c = echarts.init(document.getElementById("chart-heat"));
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return echarts.format.encodeHTML(h.y[p.value[1]]) + " · " + echarts.format.encodeHTML(h.x[p.value[0]]) + ": " + p.value[2].toLocaleString("he-IL");
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 56, containLabel: true },
      xAxis: { type: "category", data: h.x, axisLabel: { interval: 0, rotate: 35, fontSize: 11 }, splitArea: { show: true } },
      yAxis: { type: "category", data: h.y, inverse: true, axisLabel: { interval: 0, fontSize: 11 }, splitArea: { show: true } },
      visualMap: {
        min: 0, max: h.max, calculable: true, dimension: 2,
        orient: "horizontal", left: "center", bottom: 0,
        inRange: { color: ["#dbe8fb", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells, label: { show: true, fontFamily: "Rubik", fontSize: 10 },
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{% endif %}

{% if model.flags.ops %}
<script>
  (function () {
    var o = {{ model.charts.ops | tojson }};
    var c = echarts.init(document.getElementById("chart-ops"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { type: "scroll", bottom: 0 },
      grid: { left: 16, right: 16, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "value", splitNumber: 3 },
      yAxis: { type: "category", data: o.names, inverse: true, axisLabel: { interval: 0 } },
      series: o.series.map(function (s) { return { type: "bar", stack: "o", name: s.name, data: s.data, itemStyle: { color: s.color } }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{% endif %}
