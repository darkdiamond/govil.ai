<h1>בתי הדין השרעיים - תיקים וחוזי נישואין</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}{% if model.labels.dups %} {{ model.labels.dups }}{% endif %}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.cases.tone }} mb-1" dir="ltr">{{ model.kpis.cases.display }}</div>
    <div class="text-sm text-subtle">תיקים במאגר</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.contracts.tone }} mb-1" dir="ltr">{{ model.kpis.contracts.display }}</div>
    <div class="text-sm text-subtle">חוזי נישואין במאגר</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.ytd.tone }} mb-1" dir="ltr">{{ model.kpis.ytd.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.ytd_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.ytd_change.tone }} mb-1" dir="ltr">{{ model.kpis.ytd_change.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.ytd_change_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.open.tone }} mb-1" dir="ltr">{{ model.kpis.open.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.open_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.ramadan.tone }} mb-1" dir="ltr">{{ model.kpis.ramadan.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.ramadan_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.missing.tone }} mb-1" dir="ltr">{{ model.kpis.missing.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.missing_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.qadis.tone }} mb-1" dir="ltr">{{ model.kpis.qadis.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.qadis_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיקים שנפתחו לפי שנה ונושא</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.cases_year_note }}</p>
  <div id="chart-cases-year" data-fallback="explorer" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.cases_year_aria }}"></div>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">שינוי בהרכב הנושאים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.shift_note }}</p>
    <div id="chart-shift" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.shift_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.shift_caption }}</caption>
        <thead><tr><th scope="col">נושא</th><th scope="col">{{ model.charts.shift.base_label }}</th><th scope="col">{{ model.charts.shift.last_label }}</th></tr></thead>
        <tbody>
{%- for r in model.tables.shift %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.base }}</td><td>{{ r.last }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/list.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">סוגי התיקים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.tree_note }}</p>
    <div id="chart-tree" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.tree_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.types_caption }}</caption>
        <thead><tr><th scope="col">סוג תיק</th><th scope="col">נושא</th><th scope="col">תיקים</th></tr></thead>
        <tbody>
{%- for r in model.tables.types %}
          <tr><th scope="row">{{ r.type }}</th><td>{{ r.group }}</td><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">בתי הדין</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.courts_note }}</p>
  <div id="chart-courts" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.courts_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.courts_caption }}</caption>
      <thead><tr><th scope="col">בית דין</th><th scope="col">תיקים</th><th scope="col">חוזי נישואין</th><th scope="col">תיקי גירושין</th><th scope="col">גירושין לכל מאה חוזים</th></tr></thead>
      <tbody>
{%- for r in model.tables.courts %}
        <tr><th scope="row">{{ r.court }}</th><td>{{ r.cases }}</td><td>{{ r.contracts }}</td><td>{{ r.divorce }}</td><td>{{ r.ratio }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיקים לפי בית דין ושנה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.court_heat_note }}</p>
  <div id="chart-court-heat" data-fallback="explorer" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.court_heat_aria }}"></div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">נישואין וגירושין</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.md_note }}</p>
  <div id="chart-md" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.md_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.md_caption }}</caption>
      <thead><tr><th scope="col">שנה</th><th scope="col">חוזי נישואין</th><th scope="col">תיקי גירושין והפרדה</th><th scope="col">גירושין לכל מאה חוזים</th></tr></thead>
      <tbody>
{%- for r in model.tables.md %}
        <tr><th scope="row">{{ r.year }}</th><td>{{ r.contracts }}</td><td>{{ r.divorce }}</td><td>{{ r.ratio }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">עונתיות חוזי הנישואין</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.con_heat_note }}</p>
  <div id="chart-con-heat" data-fallback="explorer" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.con_heat_aria }}"></div>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
{%- if model.flags.ramadan %}
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">הרמדאן והחודשים שסביבו</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.ram_note }}</p>
    <div id="chart-ramadan" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.ram_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.ram_caption }}</caption>
        <thead><tr><th scope="col">שנה</th><th scope="col">שעבאן</th><th scope="col">רמדאן</th><th scope="col">שוואל</th></tr></thead>
        <tbody>
{%- for r in model.tables.ramadan %}
          <tr><th scope="row">{{ r.label }}</th><td>{{ r.before }}</td><td>{{ r.ram }}</td><td>{{ r.after }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
{%- endif %}
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/database.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">יום עריכת החוזה</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.weekday_note }}</p>
    <div id="chart-weekday" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.weekday_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.weekday_caption }}</caption>
        <thead><tr><th scope="col">יום</th><th scope="col">חוזים</th></tr></thead>
        <tbody>
{%- for r in model.tables.weekday %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

{%- if model.flags.outcomes %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">איך מסתיימים התיקים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.outcomes_note }}</p>
  <div id="chart-outcomes" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.outcomes_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.outcomes_caption }}</caption>
      <thead><tr><th scope="col">נושא</th><th scope="col">תיקים</th>{% for c in model.tables.outcome_cols %}<th scope="col">{{ c }}</th>{% endfor %}</tr></thead>
      <tbody>
{%- for r in model.tables.outcomes %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.n }}</td>{% for c in r.cells %}<td dir="ltr">{{ c }}</td>{% endfor %}</tr>
{%- endfor %}
      </tbody>
    </table>
    </div>
  </details>
</section>
{%- endif %}

{%- if model.flags.appeals %}
<p class="text-sm text-subtle mb-3">{{ model.labels.appeals_note }}</p>
<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">בית הדין לערעורים: תיקים לפי שנה</h2>
    </div>
    <div id="chart-appeals-year" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.appeals_year_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.appeals_year_caption }}</caption>
        <thead><tr><th scope="col">שנה</th><th scope="col">תיקים</th></tr></thead>
        <tbody>
{%- for r in model.tables.appeals_year %}
          <tr><th scope="row">{{ r.year }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">בית הדין לערעורים: ההחלטות</h2>
    </div>
    <div id="chart-appeals-out" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.appeals_out_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.appeals_out_caption }}</caption>
        <thead><tr><th scope="col">החלטה</th><th scope="col">תיקים</th></tr></thead>
        <tbody>
{%- for r in model.tables.appeals_out %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
      <table class="mt-4 w-full text-sm">
        <caption class="text-start text-subtle">סוגי הערעורים הנפוצים</caption>
        <thead><tr><th scope="col">סוג</th><th scope="col">תיקים</th></tr></thead>
        <tbody>
{%- for r in model.tables.appeal_types %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
