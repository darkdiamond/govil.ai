    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/list.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">הקאדים ומספר ההחלטות</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.qadis_note }}</p>
    <div id="chart-qadis" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.qadis_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.qadis_caption }}</caption>
        <thead><tr><th scope="col">קאדי</th><th scope="col">החלטות</th><th scope="col">בית הדין העיקרי</th><th scope="col">חלק ההחלטות בו</th></tr></thead>
        <tbody>
{%- for r in model.tables.qadis %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.court }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
{%- endif %}
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/triangle-alert.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">תיקים פתוחים</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.open_note }}</p>
    <div id="chart-open" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.open_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.open_caption }}</caption>
        <thead><tr><th scope="col">שנת פתיחה</th><th scope="col">תיקים פתוחים</th></tr></thead>
        <tbody>
{%- for r in model.tables.open %}
          <tr><th scope="row">{{ r.year }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
      <table class="mt-4 w-full text-sm">
        <caption class="text-start text-subtle">תיקים פתוחים לפי סטטוס</caption>
        <thead><tr><th scope="col">סטטוס</th><th scope="col">תיקים</th></tr></thead>
        <tbody>
{%- for r in model.tables.open_status %}
          <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">רישום חוזי הנישואין</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.quality_note }}</p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <div>
      <h3 class="m-0 mb-2 text-base font-semibold text-ink-deep">ימים מעריכת החוזה ועד רישומו (חציון)</h3>
      <div id="chart-lag" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.lag_aria }}"></div>
    </div>
    <div>
      <h3 class="m-0 mb-2 text-base font-semibold text-ink-deep">חוזים ללא שם רשם נישואין</h3>
      <div id="chart-missing" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.missing_aria }}"></div>
    </div>
  </div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.quality_caption }}</caption>
      <thead><tr><th scope="col">שנה</th><th scope="col">ימים (חציון)</th><th scope="col">נרשמו בתוך שבוע</th><th scope="col">ללא רשם</th><th scope="col">רשמים פעילים</th></tr></thead>
      <tbody>
{%- for r in model.tables.quality %}
        <tr><th scope="row">{{ r.year }}</th><td>{{ r.lag }}</td><td dir="ltr">{{ r.week }}</td><td dir="ltr">{{ r.missing }}</td><td>{{ r.registrars }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">תיקים וחוזי נישואין שנפתחו ונערכו בבתי הדין השרעיים.</p>
</section>

<script>
  (function () {
    var d = {{ model.charts.cases_year | tojson }};
    var c = echarts.init(document.getElementById("chart-cases-year"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { bottom: 0, type: "scroll" },
      grid: { left: 16, right: 16, top: 24, bottom: 96, containLabel: true },
      xAxis: { type: "category", data: d.x },
      yAxis: { type: "value", name: "תיקים" },
      dataZoom: [{ type: "inside", startValue: d.zoom_start }, { type: "slider", startValue: d.zoom_start, bottom: 36, height: 18 }],
      series: d.series.map(function (s) { return { type: "bar", stack: "all", name: s.name, data: s.data }; })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
