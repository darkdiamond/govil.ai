<h1>מעבדות אסבסט מורשות: דיגום ואנליזה</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<a href="#data-explorer" class="card p-4 mb-6 flex items-center gap-3 no-underline">
  <img src="/icons/search.svg" alt="" class="w-5 h-5 shrink-0" />
  <span>
    <span class="block font-semibold text-ink-deep">איתור מעבדת אסבסט מורשית לפי שם, מספר רישיון או עיר ←</span>
    <span class="block text-sm text-subtle">חיפוש חי בכל רשומות המאגר: שם המעבדה, מספר רישיון, סוג רישיון, שמות הדוגמים, כתובת, טלפון ודוא״ל</span>
  </span>
</a>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.total.tone }} mb-1" dir="ltr">{{ model.kpis.total.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.total_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.labs.tone }} mb-1" dir="ltr">{{ model.kpis.labs.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.labs_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.staff.tone }} mb-1" dir="ltr">{{ model.kpis.staff.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.staff_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.disc.tone }} mb-1" dir="ltr">{{ model.kpis.disc.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.disc_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">רישיונות לפי סוג</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.types_note }}</p>
    <div id="chart-types" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.types_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.types_caption }}</caption>
        <thead><tr><th scope="col">סוג רישיון</th><th scope="col">רישיונות</th><th scope="col">שיעור</th></tr></thead>
        <tbody>
{%- for r in model.tables.types %}
          <tr><th scope="row">{{ r.type }}</th><td>{{ r.count }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </details>
  </section>
  <section class="card p-5">
    <div class="flex items-center gap-2 mb-3 text-brand">
      <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
      <h2 class="m-0 text-lg font-semibold text-ink-deep">המעבדות והרישיונות שבידיהן</h2>
    </div>
    <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.labs_note }}</p>
    <div id="chart-labs" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.labs_aria }}"></div>
    <details class="mt-3">
      <summary class="text-sm text-subtle">הצג כטבלה</summary>
      <div class="overflow-x-auto">
        <table class="mt-2 w-full text-sm">
          <caption class="sr-only">{{ model.labels.labs_caption }}</caption>
          <thead><tr><th scope="col">מעבדה</th>{% for c in model.tables.type_cols %}<th scope="col">{{ c }}</th>{% endfor %}<th scope="col">אנשי צוות</th></tr></thead>
          <tbody>
{%- for r in model.tables.labs %}
            <tr><th scope="row">{{ r.name }}</th>{% for v in r.vals %}<td>{{ v }}</td>{% endfor %}<td>{{ r.staff }}</td></tr>
{%- endfor %}
          </tbody>
        </table>
      </div>
    </details>
  </section>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">צוות מורשה בכל רישיון</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.staff_note }}</p>
  <div id="chart-staff" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.staff_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.staff_caption }}</caption>
      <thead><tr><th scope="col">מעבדה</th><th scope="col">סוג רישיון</th><th scope="col">אנשי צוות</th></tr></thead>
      <tbody>
{%- for r in model.tables.staff %}
        <tr><th scope="row">{{ r.lab }}</th><td>{{ r.type }}</td><td>{{ r.staff }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

{%- if model.flags.has_expiry %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מתי פג תוקף הרישיונות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.expiry_note }}</p>
  <div id="chart-expiry" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.expiry_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <div class="overflow-x-auto">
      <table class="mt-2 w-full text-sm">
        <caption class="sr-only">{{ model.labels.expiry_caption }}</caption>
        <thead><tr><th scope="col">שנה</th>{% for c in model.tables.type_cols %}<th scope="col">{{ c }}</th>{% endfor %}<th scope="col">סה״כ</th></tr></thead>
        <tbody>
{%- for r in model.tables.expiry %}
          <tr><th scope="row">{{ r.year }}</th>{% for v in r.vals %}<td>{{ v }}</td>{% endfor %}<td>{{ r.total }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>
{%- endif %}

{%- if model.flags.has_disc %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/triangle-alert.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">היבטים משמעתיים לאורך השנים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.disc_note }}</p>
  <div id="chart-disc" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.disc_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.disc_caption }}</caption>
      <thead><tr><th scope="col">שנה</th>{% for c in model.tables.kind_cols %}<th scope="col">{{ c }}</th>{% endfor %}<th scope="col">סה״כ</th></tr></thead>
      <tbody>
{%- for r in model.tables.disc %}
        <tr><th scope="row">{{ r.year }}</th>{% for v in r.vals %}<td>{{ v }}</td>{% endfor %}<td>{{ r.total }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{%- endif %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">רשימת הרישיונות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.list_note }}</p>
  <div id="table-list" class="overflow-x-auto">
    <table class="w-full text-sm">
      <caption class="sr-only">{{ model.labels.list_caption }}</caption>
      <thead><tr><th scope="col">מעבדה</th><th scope="col">סוג רישיון</th><th scope="col">מספר רישיון</th><th scope="col">בתוקף עד</th><th scope="col">אנשי צוות</th><th scope="col">היבט משמעתי</th></tr></thead>
      <tbody>
{%- for r in model.tables.list %}
        <tr><th scope="row">{{ r.lab }}</th><td>{{ r.type }}</td><td dir="ltr">{{ r.num }}</td><td dir="ltr">{{ r.exp }}</td><td>{{ r.staff }}</td><td>{{ r.disc }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </div>
{%- if model.labels.list_more %}
  <p class="mt-3 mb-0 text-sm text-subtle">{{ model.labels.list_more }}</p>
{%- endif %}
</section>

<script>
  (function () {
    var t = {{ model.charts.types | tojson }};
    var c = echarts.init(document.getElementById("chart-types"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 16, top: 24, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: t.x, axisLabel: { interval: 0, width: 90, overflow: "break" } },
      yAxis: { type: "value", minInterval: 1, name: "רישיונות" },
      series: [{ type: "bar", name: "רישיונות", data: t.y, barMaxWidth: 56,
                 itemStyle: { color: "#0068f5" }, label: { show: true, position: "top" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
<script>
  (function () {
    var t = {{ model.charts.labs | tojson }};
    var c = echarts.init(document.getElementById("chart-labs"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0 },
      grid: { left: 16, right: 24, top: 56, bottom: 16, containLabel: true },
      xAxis: { type: "value", minInterval: 1 },
      yAxis: { type: "category", data: t.labs, inverse: true,
               axisLabel: { width: 130, overflow: "truncate" } },
      series: t.series.map(function (s) {
        return { type: "bar", stack: "l", name: s.name, data: s.data, barMaxWidth: 28 };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
<script>
  (function () {
    var t = {{ model.charts.staff | tojson }};
    var c = echarts.init(document.getElementById("chart-staff"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 32, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "value", minInterval: 1 },
      yAxis: { type: "category", data: t.labels, inverse: true,
               axisLabel: { width: 160, overflow: "truncate" } },
      series: [{ type: "bar", name: "אנשי צוות מורשים", data: t.y, barMaxWidth: 22,
                 itemStyle: { color: "#0068f5" }, label: { show: true, position: "right" } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- if model.flags.has_expiry %}
<script>
  (function () {
    var t = {{ model.charts.expiry | tojson }};
    var c = echarts.init(document.getElementById("chart-expiry"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 56, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: t.years },
      yAxis: { type: "value", minInterval: 1, name: "רישיונות" },
      series: t.series.map(function (s) {
        return { type: "bar", stack: "e", name: s.name, data: s.data, barMaxWidth: 48 };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}
{%- if model.flags.has_disc %}
<script>
  (function () {
    var t = {{ model.charts.disc | tojson }};
    var c = echarts.init(document.getElementById("chart-disc"));
    var cols = { "התליה": "#dc3545", "נזיפה": "#9a6700" };
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 48, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: t.years },
      yAxis: { type: "value", minInterval: 1, name: "אירועים" },
      series: t.series.map(function (s) {
        var o = { type: "bar", stack: "d", name: s.name, data: s.data, barMaxWidth: 48 };
        if (cols[s.name]) { o.itemStyle = { color: cols[s.name] }; }
        return o;
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}
