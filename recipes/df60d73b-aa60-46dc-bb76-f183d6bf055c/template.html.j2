{%- macro head(icon, title) %}
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/{{ icon }}.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">{{ title }}</h2>
  </div>
{%- endmacro %}
{%- macro details_open(caption) %}
  <details class="mt-3">
    <summary class="text-sm text-subtle cursor-pointer">הצג כטבלה</summary>
    <div class="overflow-x-auto">
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ caption }}</caption>
{%- endmacro %}
{%- macro details_close() %}
    </table>
    </div>
  </details>
{%- endmacro %}
<h1>קידומות טלפון בישראל: לאיזו חברה שייך המספר</h1>

<section class="card p-5 mb-6">
{{ head("info", "תקציר") }}
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lead }}</p>
  <p class="m-0 mt-2 text-subtle leading-relaxed">{{ model.labels.lead2 }}</p>
</section>

<section class="card p-5 mb-6">
{{ head("search", "איתור החברה לפי מספר טלפון או קידומת") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.lookup_lede }}</p>
  <label for="np-q" class="sr-only">חיפוש מספר טלפון או קידומת בתוכנית המספור</label>
  <input id="np-q" type="search" inputmode="tel" autocomplete="off" dir="ltr" placeholder="{{ model.labels.lookup_placeholder }}" class="w-full border border-rule rounded-gov px-3 py-2 text-base text-start" />
  <div id="np-out" class="mt-3" aria-live="polite"></div>
  <a href="#data-explorer" class="mt-3 flex items-center gap-2 text-sm text-primary no-underline">
    <img src="/icons/list.svg" alt="" class="w-4 h-4 shrink-0" />
    <span>חיפוש לפי שם החברה (באנגלית) ברשימת הטווחים המלאה ←</span>
  </a>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
{%- for key in ["blocks", "ops", "cap", "prefixes"] %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.labels["kpi_" ~ key] }}</div>
  </div>
{%- endfor %}
</div>

<section class="card p-5 mb-6">
{{ head("circle-check", "תובנות עיקריות") }}
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
{%- if model.labels.bad_note %}
  <p class="m-0 mt-3 text-xs text-subtle">{{ model.labels.bad_note }}</p>
{%- endif %}
</section>

<section class="card p-5 mb-6">
{{ head("list", "רשימת הקידומות: מי מחזיק בכל קידומת") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.dir_lede }}</p>
  <div class="overflow-x-auto">
  <table class="w-full text-sm">
    <caption class="sr-only">{{ model.labels.dir_caption }}</caption>
    <thead><tr class="border-b border-rule text-ink-deep"><th scope="col" class="text-start py-2 pe-3">קידומת</th><th scope="col" class="text-start py-2 pe-3">סוג שירות</th><th scope="col" class="text-start py-2 pe-3">מפעילים</th><th scope="col" class="text-start py-2">הוקצה</th></tr></thead>
    <tbody>
{%- for r in model.tables.directory %}
      <tr class="border-b border-rule align-top"><th scope="row" class="text-start py-2 pe-3 font-semibold text-ink-deep" dir="ltr">{{ r.label }}</th><td class="py-2 pe-3">{{ r.kind }}</td><td class="py-2 pe-3">{{ r.ops }}</td><td class="py-2" dir="ltr">{{ r.util }}</td></tr>
{%- endfor %}
    </tbody>
  </table>
  </div>
</section>

<section class="card p-5 mb-6">
{{ head("database", "מספרים לפי סוג שירות") }}
