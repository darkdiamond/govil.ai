  <div id="chart-cats" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.cat_aria }}"></div>
{{ details_open(model.labels.cat_aria) }}
      <thead><tr class="border-b border-rule text-ink-deep"><th scope="col" class="text-start py-1 pe-3">סוג שירות</th><th scope="col" class="text-start py-1 pe-3">קידומות</th><th scope="col" class="text-start py-1 pe-3">טווחים</th><th scope="col" class="text-start py-1 pe-3">מפעילים</th><th scope="col" class="text-start py-1 pe-3">מספרים</th><th scope="col" class="text-start py-1">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.cats %}
        <tr class="border-b border-rule"><th scope="row" class="text-start font-normal py-1 pe-3">{{ r.name }}</th><td class="py-1 pe-3">{{ r.prefixes }}</td><td class="py-1 pe-3">{{ r.blocks | fmt_int }}</td><td class="py-1 pe-3">{{ r.ops | fmt_int }}</td><td class="py-1 pe-3">{{ r.cap_txt }}</td><td class="py-1" dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
