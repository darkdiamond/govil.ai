        <tr class="border-b border-rule"><th scope="row" class="text-start font-normal py-1 pe-3" dir="ltr">{{ r.label }}</th><td class="py-1 pe-3">{{ r.cap }}</td><td class="py-1 pe-3">{{ r.space }}</td><td class="py-1" dir="ltr">{{ r.util }}</td></tr>
