</section>

<section class="card p-5 mb-6">
{{ head("database", "גודל הטווחים") }}
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.size_lede }}</p>
  <div id="chart-sizes" class="h-64 md:h-80" role="img" aria-label="{{ model.labels.size_aria }}"></div>
{{ details_open(model.labels.size_aria) }}
      <thead><tr class="border-b border-rule text-ink-deep"><th scope="col" class="text-start py-1 pe-3">גודל טווח</th><th scope="col" class="text-start py-1 pe-3">טווחים</th><th scope="col" class="text-start py-1 pe-3">שיעור מהטווחים</th><th scope="col" class="text-start py-1">שיעור מהמספרים</th></tr></thead>
