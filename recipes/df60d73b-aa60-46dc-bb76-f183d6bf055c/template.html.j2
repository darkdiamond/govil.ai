      <thead><tr class="border-b border-rule text-ink-deep"><th scope="col" class="text-start py-1 pe-3">קידומת</th><th scope="col" class="text-start py-1 pe-3">מספרים שהוקצו</th><th scope="col" class="text-start py-1 pe-3">מרחב הקידומת</th><th scope="col" class="text-start py-1">שיעור</th></tr></thead>
      <tbody>
