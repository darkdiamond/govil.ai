{% if model.has_spread %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">כמה מרוכז כל סוג</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.spread_note }}</p>
  <div id="chart-spread" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.spread_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.spread_caption }}</caption>
      <thead><tr><th scope="col">סוג</th><th scope="col">פחים</th><th scope="col">רדיוס פיזור (מטרים)</th></tr></thead>
      <tbody>
{%- for r in model.tables.spread %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.radius }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{% endif %}

<script>
  GovMap.create({
    container: "#map-main",
    resourceId: {{ inputs.bins[0].id | tojson }},
    latField: "lat",
    lngField: "lon",
    projection: "wgs84",
    popupTitleField: "Type",
    popupFields: [{ field: "neighborho", label: "שכונה" }]
  });
</script>

<script>
  (function () {
    function hbar(id, names, values, unit) {
      var el = document.getElementById(id);
      if (!el) { return; }
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value" },
        yAxis: { type: "category", data: names.slice().reverse(), axisLabel: { width: 120, overflow: "truncate" } },
        series: [{ type: "bar", name: unit, data: values.slice().reverse() }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    function vbar(id, names, values, unit, rot) {
      var el = document.getElementById(id);
      if (!el) { return; }
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 16, top: 16, bottom: 28, containLabel: true },
        xAxis: { type: "category", data: names, axisLabel: { rotate: rot } },
        yAxis: { type: "value" },
        series: [{ type: "bar", name: unit, data: values }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    var t = {{ model.charts.type | tojson }};
    hbar("chart-type", t.names, t.values, "פחים");
    var h = {{ model.charts.hood | tojson }};
    hbar("chart-hood", h.names, h.values, "פחים");
    var s = {{ model.charts.spread | tojson }};
    hbar("chart-spread", s.names, s.values, "מטרים");
    var n = {{ model.charts.nearest | tojson }};
    vbar("chart-nearest", n.names, n.values, "נקודות", 0);
    var si = {{ model.charts.sites | tojson }};
    vbar("chart-sites", si.names, si.values, "אתרים", 0);
  })();
</script>

<script>
  (function () {
    var m = {{ model.charts.mix | tojson }};
    var el = document.getElementById("chart-mix");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, valueFormatter: function (v) { return v + "%"; } },
      legend: { bottom: 0 },
      grid: { left: 8, right: 24, top: 8, bottom: 56, containLabel: true },
      xAxis: { type: "value", max: 100, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: m.names.slice().reverse() },
      series: m.series.map(function (s) {
        return { type: "bar", stack: "t", name: s.name, data: s.data.slice().reverse() };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
