  (function () {
    var d = {{ model.charts.amounts | tojson }};
    var el = document.getElementById("chart-amounts");
    var c = echarts.init(el);
    var narrow = el.clientWidth < 500;
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex;
        return echarts.format.encodeHTML(ps[0].name) + " ₪<br>" + d.y[i].toLocaleString("he-IL") + " חיובים"
          + "<br>" + d.amount[i].toLocaleString("he-IL") + " מיליון ₪";
      } },
      grid: { left: 8, right: 16, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "category", data: d.x, axisLabel: { interval: 0, rotate: narrow ? 60 : 35, fontSize: narrow ? 9 : 11 } },
      yAxis: { type: "value", axisLabel: { formatter: function (v) { return v >= 1000000 ? (v / 1000000).toLocaleString("he-IL") + " מיליון" : v >= 1000 ? (v / 1000).toLocaleString("he-IL") + " אלף" : v; } } },
      series: [{ name: "חיובים", type: "bar", data: d.y }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
  (function () {
    var d = {{ model.charts.scatter | tojson }};
    var el = document.getElementById("chart-scatter");
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      tooltip: { trigger: "item", formatter: function (p) {
        return echarts.format.encodeHTML(p.value[2]) + "<br>" + p.value[0].toLocaleString("he-IL") + " חיובים תקפים"
          + "<br>חיוב ממוצע: " + Math.round(p.value[1]).toLocaleString("he-IL") + " ₪";
      } },
      grid: { left: 8, right: 24, top: 24, bottom: 24, containLabel: true },
      xAxis: { type: "log", name: "חיובים", axisLabel: { formatter: function (v) { return v >= 1000000 ? (v / 1000000).toLocaleString("he-IL") + " מיליון" : v >= 1000 ? (v / 1000).toLocaleString("he-IL") + " אלף" : v; } } },
      yAxis: { type: "log", name: "₪ לחיוב" },
      series: [{ type: "scatter", data: d.points, symbolSize: 12 }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
