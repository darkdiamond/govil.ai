      xAxis: { type: "value", max: 100, axisLabel: { formatter: (v) => v + "%" } },
      yAxis: { type: "category", data: d.names.slice().reverse(), axisLabel: { width: 120, overflow: "truncate" } },
      series: [{ name: "שיעור נשים", type: "bar", data: d.share.slice().reverse(),
        label: { show: true, position: "right", formatter: (p) => p.value + "%" } }]
    }));
  })();
  (function () {
    const d = {{ model.charts.flows | tojson }};
