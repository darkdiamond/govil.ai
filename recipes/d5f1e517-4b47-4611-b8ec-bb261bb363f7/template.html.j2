      legend: { top: 0 },
      grid: { left: 16, right: 16, top: 40, bottom: 16, containLabel: true },
      xAxis: { type: "value", axisLabel: { formatter: (v) => fmt(Math.abs(v)), rotate: 30 } },
      yAxis: { type: "category", data: d.ages, axisTick: { show: false } },
      series: [
        { name: "גברים", type: "bar", stack: "p", data: d.men.map((v) => -v) },
        { name: "נשים", type: "bar", stack: "p", data: d.women }
      ]
    }));
  })();
  (function () {
    const d = {{ model.charts.women | tojson }};
    const { mk } = window.__lic;
    const c = mk("chart-women"); if (!c) return;
    c.setOption(window.GovEcharts.option({
