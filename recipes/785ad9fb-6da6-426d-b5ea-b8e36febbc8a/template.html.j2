  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.ratio_caption }}</caption>
      <thead><tr><th scope="col">ישוב</th><th scope="col">רחובות רשמיים</th><th scope="col">שמות חלופיים</th><th scope="col">יחס</th><th scope="col">קבוצה</th></tr></thead>
      <tbody>
{%- for r in model.tables.ratio %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.off | fmt_int }}</td><td>{{ r.syn | fmt_int }}</td><td dir="ltr">{{ r.ratio }}</td><td>{{ r.group }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{%- endif %}
{%- if model.flags.scatter %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">רחובות רשמיים מול שמות חלופיים בכל ישוב</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.scatter_note }}</p>
  <div id="chart-scatter" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.scatter_aria }}" data-fallback="explorer"></div>
</section>
{%- endif %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">אזורי הרישום</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.region_note }}</p>
  <div id="chart-region" class="h-[560px]" role="img" aria-label="{{ model.labels.region_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.region_caption }}</caption>
      <thead><tr><th scope="col">אזור</th><th scope="col">ישובים</th><th scope="col">רחובות רשמיים</th><th scope="col">שמות חלופיים</th><th scope="col">יחס</th></tr></thead>
      <tbody>
{%- for r in model.tables.region %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.locs | fmt_int }}</td><td>{{ r.off | fmt_int }}</td><td>{{ r.syn | fmt_int }}</td><td dir="ltr">{{ r.ratio }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{%- if model.flags.rratio %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/building-2.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">יחס השמות החלופיים לפי אזור</h2>
