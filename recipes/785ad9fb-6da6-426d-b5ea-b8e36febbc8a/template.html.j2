      <caption class="sr-only">{{ model.labels.streets_caption }}</caption>
      <thead><tr><th scope="col">רחוב</th><th scope="col">ישוב</th><th scope="col">שמות חלופיים</th></tr></thead>
      <tbody>
{%- for r in model.tables.streets %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.loc }}</td><td>{{ r.count | fmt_int }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
