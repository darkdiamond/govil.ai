</section>
{%- if model.flags.ratio %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">יחס שמות חלופיים לרחובות רשמיים לפי ישוב</h2>
  </div>
