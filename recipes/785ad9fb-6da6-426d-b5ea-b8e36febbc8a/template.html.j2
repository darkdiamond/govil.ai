  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.rratio_caption }}</caption>
      <thead><tr><th scope="col">אזור</th><th scope="col">יחס</th></tr></thead>
      <tbody>
{%- for r in model.tables.rratio %}
        <tr><th scope="row">{{ r.name }}</th><td dir="ltr">{{ r.ratio }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
