{%- endif %}
{%- if model.flags.alt %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">שמות חלופיים לשמות הישובים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.alt_note }}</p>
  <div id="chart-alt" class="h-[560px]" role="img" aria-label="{{ model.labels.alt_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.alt_caption }}</caption>
      <thead><tr><th scope="col">ישוב</th><th scope="col">שמות חלופיים לישוב</th></tr></thead>
      <tbody>
{%- for r in model.tables.alt %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count | fmt_int }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{%- endif %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תיאור מקורי</h2>
  </div>
  <p class="m-0 text-sm text-subtle whitespace-pre-line">רשות האוכלוסין וההגירה מפרסמת מידי תקופה רשימת רחובות לשימוש חופשי של הציבור. קובץ הסינונימיים מכיל שמות לא רשמיים לרחובות. לכל רשומה מוצמד קוד הרחוב הרשמי לאותה עיר.</p>
</section>

<script>
  (function () {
    function hbar(id, d, color, name) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                   valueFormatter: function (v) { return v.toLocaleString("he-IL"); } },
        grid: { left: 16, right: 40, top: 16, bottom: 24, containLabel: true },
        xAxis: { type: "value", splitNumber: 4, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { fontSize: 11, interval: 0 } },
        series: [{ type: "bar", name: name, data: d.values, itemStyle: { color: color },
                   label: { show: true, position: "right", fontSize: 10 } }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    hbar("chart-kinds", {{ model.charts.kinds | tojson }}, "#0b3668", "שמות חלופיים");
    var s = {{ model.charts.streets | tojson }};
    hbar("chart-streets", { names: s.labels, values: s.values }, "#0068f5", "שמות חלופיים");
    {%- if model.flags.alt %}
    hbar("chart-alt", {{ model.charts.alt | tojson }}, "#0068f5", "שמות חלופיים");
    {%- endif %}
    {%- if model.flags.rratio %}
    hbar("chart-rratio", {{ model.charts.rratio | tojson }}, "#0068f5", "חלופיים לרשמי");
    {%- endif %}
  })();
</script>

<script>
  (function () {
    function stacked(id, d, a, b, an, bn) {
      var c = echarts.init(document.getElementById(id));
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" },
                   valueFormatter: function (v) { return v.toLocaleString("he-IL"); } },
        legend: { top: 0 },
        grid: { left: 16, right: 24, top: 32, bottom: 16, containLabel: true },
        xAxis: { type: "value", splitNumber: 4, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { fontSize: 11, interval: 0 } },
        series: [
          { type: "bar", stack: "t", name: an, data: d[a], itemStyle: { color: "#0068f5" } },
          { type: "bar", stack: "t", name: bn, data: d[b], itemStyle: { color: "#ffc107" } }
        ]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    stacked("chart-top", {{ model.charts.top | tojson }}, "official", "synonym", "רחובות רשמיים", "שמות חלופיים");
    stacked("chart-region", {{ model.charts.region | tojson }}, "official", "synonym", "רחובות רשמיים", "שמות חלופיים");
  })();
</script>

<script>
  (function () {
    var d = {{ model.charts.dist | tojson }};
    var c = echarts.init(document.getElementById("chart-dist"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 16, right: 16, top: 32, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: d.names, name: "שמות חלופיים לרחוב", nameLocation: "middle", nameGap: 36,
               axisLabel: { fontSize: 10, interval: 0, rotate: 30 } },
      yAxis: { type: "value", name: "רחובות" },
      series: [{ type: "bar", name: "רחובות רשמיים", data: d.values, itemStyle: { color: "#0068f5" },
                 label: { show: true, position: "top", fontSize: 10 } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- if model.flags.ratio %}

<script>
  (function () {
    var d = {{ model.charts.ratio | tojson }};
    var c = echarts.init(document.getElementById("chart-ratio"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        return p.name + "<br>יחס: " + p.value + "<br>רשמיים: " + d.off[p.dataIndex].toLocaleString("he-IL") +
          " · חלופיים: " + d.syn[p.dataIndex].toLocaleString("he-IL");
      } },
      grid: { left: 16, right: 40, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "value", splitNumber: 4, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: d.names, inverse: true, axisLabel: { fontSize: 11, interval: 0 } },
      series: [{ type: "bar", name: "יחס", label: { show: true, position: "right", fontSize: 10 },
                 data: d.values.map(function (v, i) {
                   return { value: v, itemStyle: { color: d.group[i] === "high" ? "#0068f5" : "#6c757d" } };
                 }) }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}
{%- if model.flags.scatter %}

<script>
  (function () {
    var d = {{ model.charts.scatter | tojson }};
    var c = echarts.init(document.getElementById("chart-scatter"));
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "item", formatter: function (p) {
        return p.data[2] + "<br>רשמיים: " + p.data[0].toLocaleString("he-IL") +
          "<br>חלופיים: " + p.data[1].toLocaleString("he-IL");
      } },
      grid: { left: 16, right: 24, top: 24, bottom: 40, containLabel: true },
      xAxis: { type: "log", min: 1, name: "רחובות רשמיים", nameLocation: "middle", nameGap: 28,
               axisLabel: { hideOverlap: true } },
      yAxis: { type: "log", min: 1, name: "שמות חלופיים", axisLabel: { hideOverlap: true } },
      series: [{ type: "scatter", name: "ישובים", symbolSize: 7, data: d.points.map(function (p) {
        return [Math.max(p[0], 1), Math.max(p[1], 1), p[2]];
      }), itemStyle: { color: "#0068f5", opacity: 0.6 } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{%- endif %}
