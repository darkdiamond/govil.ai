<h1>רשימת רחובות בישראל - קובץ עם סינונימיים</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.names.tone }} mb-1" dir="ltr">{{ model.kpis.names.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.names_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.locs.tone }} mb-1" dir="ltr">{{ model.kpis.locs.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.locs_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.official.tone }} mb-1" dir="ltr">{{ model.kpis.official.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.official_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.synonyms.tone }} mb-1" dir="ltr">{{ model.kpis.synonyms.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.synonyms_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.with_syn.tone }} mb-1" dir="ltr">{{ model.kpis.with_syn.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.with_syn_kpi }}</div>
  </div>
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis.ratio.tone }} mb-1" dir="ltr">{{ model.kpis.ratio.display }}</div>
    <div class="text-sm text-subtle">{{ model.labels.ratio_kpi }}</div>
  </div>
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">הישובים עם הכי הרבה שמות רחובות</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.top_note }}</p>
  <div id="chart-top" class="h-[560px]" role="img" aria-label="{{ model.labels.top_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.top_caption }}</caption>
      <thead><tr><th scope="col">ישוב</th><th scope="col">רחובות רשמיים</th><th scope="col">שמות חלופיים</th><th scope="col">חלופיים לרשמי</th></tr></thead>
      <tbody>
{%- for r in model.tables.top %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.off | fmt_int }}</td><td>{{ r.syn | fmt_int }}</td><td dir="ltr">{{ r.ratio }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6">
<section class="card p-5">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">כמה שמות חלופיים יש לרחוב</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.dist_note }}</p>
  <div id="chart-dist" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.dist_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.dist_caption }}</caption>
      <thead><tr><th scope="col">שמות חלופיים</th><th scope="col">רחובות רשמיים</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.dist %}
        <tr><th scope="row" dir="ltr">{{ r.name }}</th><td>{{ r.count | fmt_int }}</td><td dir="ltr">{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{%- if model.flags.kinds %}
<section class="card p-5">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/list.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">במה השם החלופי שונה מהרשמי</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.kinds_note }}</p>
  <div id="chart-kinds" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.kinds_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.kinds_caption }}</caption>
      <thead><tr><th scope="col">סוג ההבדל</th><th scope="col">שמות חלופיים</th><th scope="col">שיעור</th><th scope="col">דוגמה (חלופי ← רשמי)</th></tr></thead>
      <tbody>
{%- for r in model.tables.kinds %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count | fmt_int }}</td><td dir="ltr">{{ r.share }}</td><td>{{ r.example }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{%- endif %}
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/tag.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">הרחובות עם הכי הרבה שמות חלופיים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.streets_note }}</p>
  <div id="chart-streets" class="h-[560px]" role="img" aria-label="{{ model.labels.streets_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
