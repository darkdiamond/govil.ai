{% endif %}

{% if model.has_pmap %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">איפה מתועד לחץ עבודה</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.pmap_note }}</p>
  <div id="chart-pmap" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.pmap_aria }}" data-fallback="explorer"></div>
</section>
{% endif %}

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">פערים במאגר</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.quality_note }}</p>
  <div id="chart-quality" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.quality_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.quality_caption }}</caption>
      <thead><tr><th scope="col">סוג הפער</th><th scope="col">רשומות</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.quality %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<script>
  GovMap.create({
    container: "#map-main",
    resourceId: {{ inputs.hydrants[0].id | tojson }},
    latField: "lat",
    lngField: "lon",
    projection: "wgs84",
    fitBounds: false,
    initialView: { center: [{{ model.map_view.lat | tojson }}, {{ model.map_view.lon | tojson }}], zoom: {{ model.map_view.zoom | tojson }} },
    popupFields: [
      { field: "WorkPressu", label: "לחץ עבודה (0 = לא מתועד)" },
      { field: "HouseNum", label: "מספר בית (0 = אין)" }
    ]
  });
</script>

<script>
  (function () {
    function mk(id) {
      var el = document.getElementById(id);
      if (!el) { return null; }
      var c = echarts.init(el);
      window.addEventListener("resize", function () { c.resize(); });
      return c;
    }
    var d = {{ model.charts.density | tojson }};
    var c = mk("chart-density");
    if (c) {
      c.setOption(window.GovEcharts.option({
        tooltip: { formatter: function (p) {
          return "קו אורך " + d.x[p.value[0]] + ", קו רוחב " + d.y[p.value[1]] + ": " + p.value[2];
        } },
        grid: { left: 8, right: 8, top: 8, bottom: 56, containLabel: true },
        xAxis: { type: "category", data: d.x, splitArea: { show: false }, axisLabel: { interval: 3 } },
        yAxis: { type: "category", data: d.y, axisLabel: { interval: 3 } },
        visualMap: { min: 0, max: d.max, dimension: 2, calculable: false, orient: "horizontal",
          left: "center", bottom: 0, inRange: { color: ["#f1f7ff", "#0068f5", "#0b3668"] } },
        series: [{ type: "heatmap", name: "ברזים", data: d.cells, itemStyle: { borderColor: "#fff", borderWidth: 1 } }]
      }));
    }
  })();
</script>

<script>
  (function () {
    function hbar(id, names, values, unit, w) {
      var el = document.getElementById(id);
      if (!el) { return; }
      var c = echarts.init(el);
      c.setOption(window.GovEcharts.option({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
        xAxis: { type: "value", axisLabel: { hideOverlap: true }, splitNumber: 3 },
        yAxis: { type: "category", data: names.slice().reverse(), axisLabel: { width: w, overflow: "truncate" } },
        series: [{ type: "bar", name: unit, data: values.slice().reverse() }]
      }));
      window.addEventListener("resize", function () { c.resize(); });
    }
    var lat = {{ model.charts.lat | tojson }};
    var lon = {{ model.charts.lon | tojson }};
    var pr = {{ model.charts.pressure | tojson }};
    var q = {{ model.charts.quality | tojson }};
    hbar("chart-lat", lat.names, lat.values, "ברזים", 90);
    hbar("chart-lon", lon.names, lon.values, "ברזים", 90);
    hbar("chart-pressure", pr.names, pr.values, "ברזים", 90);
    hbar("chart-quality", q.names, q.values, "רשומות", 150);
  })();
</script>

<script>
  (function () {
    var z = {{ model.charts.nn | tojson }};
    var el = document.getElementById("chart-nn");
    if (!el) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
      grid: { left: 8, right: 16, top: 16, bottom: 24, containLabel: true },
      xAxis: { type: "category", data: z.names },
      yAxis: { type: "value" },
      series: [{ type: "bar", name: "נקודות", data: z.values }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>

<script>
  (function () {
    var m = {{ model.charts.pmap | tojson }};
    var el = document.getElementById("chart-pmap");
    if (!el || !m.series.length) { return; }
    var c = echarts.init(el);
    c.setOption(window.GovEcharts.option({
      color: ["#0068f5", "#198754", "#9a6700", "#dc3545", "#6c757d", "#0b3668"],
      tooltip: { formatter: function (p) {
        return "לחץ " + p.seriesName + "<br>קו רוחב " + p.value[1] + ", קו אורך " + p.value[0];
      } },
      legend: { bottom: 0 },
      grid: { left: 8, right: 16, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "value", scale: true, name: "קו אורך", nameLocation: "middle", nameGap: 26 },
      yAxis: { type: "value", scale: true, name: "קו רוחב" },
      series: m.series.map(function (s) {
        return { type: "scatter", name: s.name, data: s.data, symbolSize: 9 };
      })
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
