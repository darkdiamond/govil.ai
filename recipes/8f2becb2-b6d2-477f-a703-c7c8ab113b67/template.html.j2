<h1>ברזי כיבוי אש (הידרנטים)</h1>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/info.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תקציר</h2>
  </div>
  <p class="m-0 text-subtle leading-relaxed">{{ model.labels.lede }}</p>
</section>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
{%- for key in ["total", "spacing", "cells", "pressure-share"] %}
  <div class="card p-4 text-center">
    <div class="text-3xl font-bold text-{{ model.kpis[key].tone }} mb-1" dir="ltr">{{ model.kpis[key].display }}</div>
    <div class="text-sm text-subtle">{{ model.kpis[key].label }}</div>
  </div>
{%- endfor %}
</div>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/circle-check.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">תובנות עיקריות</h2>
  </div>
  <ul class="list-disc ps-5 m-0 space-y-2 text-sm marker:text-brand">
{%- for i in model.insights %}
    <li>{{ i.text_he }}</li>
{%- endfor %}
  </ul>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">מפת הברזים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.map_note }}</p>
  <div id="map-main" class="h-72 md:h-[420px]"></div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/map-pin.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">צפיפות הברזים בעיר</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.density_note }}</p>
  <div id="chart-density" class="h-80 md:h-[460px]" role="img" aria-label="{{ model.labels.density_aria }}" data-fallback="explorer"></div>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">ברזים מצפון לדרום</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.lat_note }}</p>
  <div id="chart-lat" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.lat_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.lat_caption }}</caption>
      <thead><tr><th scope="col">רצועת קו רוחב</th><th scope="col">ברזים</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.lat %}
        <tr><th scope="row"><bdi dir="ltr">{{ r.name }}</bdi></th><td>{{ r.n }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">ברזים ממערב למזרח</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.lon_note }}</p>
  <div id="chart-lon" class="h-72 md:h-96" role="img" aria-label="{{ model.labels.lon_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.lon_caption }}</caption>
      <thead><tr><th scope="col">רצועת קו אורך</th><th scope="col">ברזים</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.lon %}
        <tr><th scope="row"><bdi dir="ltr">{{ r.name }}</bdi></th><td>{{ r.n }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>

{% if model.has_nn %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">המרחק בין ברזים שכנים</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.nn_note }}</p>
  <div id="chart-nn" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.nn_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.nn_caption }}</caption>
      <thead><tr><th scope="col">מרחק לברז הקרוב (מטרים)</th><th scope="col">נקודות</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.nn %}
        <tr><th scope="row"><bdi dir="ltr">{{ r.name }}</bdi></th><td>{{ r.count }}</td><td>{{ r.share }}</td></tr>
{%- endfor %}
      </tbody>
    </table>
  </details>
</section>
{% endif %}

{% if model.has_pressure %}
<section class="card p-5 mb-6">
  <div class="flex items-center gap-2 mb-3 text-brand">
    <img src="/icons/database.svg" alt="" class="w-5 h-5" />
    <h2 class="m-0 text-lg font-semibold text-ink-deep">לחץ העבודה המתועד</h2>
  </div>
  <p class="m-0 text-sm text-subtle mb-3">{{ model.labels.pressure_note }}</p>
  <div id="chart-pressure" class="h-72 md:h-80" role="img" aria-label="{{ model.labels.pressure_aria }}"></div>
  <details class="mt-3">
    <summary class="text-sm text-subtle">הצג כטבלה</summary>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">{{ model.labels.pressure_caption }}</caption>
      <thead><tr><th scope="col">לחץ עבודה</th><th scope="col">ברזים</th><th scope="col">שיעור</th></tr></thead>
      <tbody>
{%- for r in model.tables.pressure %}
        <tr><th scope="row">{{ r.name }}</th><td>{{ r.count }}</td><td>{{ r.share }}</td></tr>
