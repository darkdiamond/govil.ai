    var cn = ce.clientWidth < 480;
    c.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex;
        return echarts.format.encodeHTML(cf.names[i]) + "<br>" + echarts.format.encodeHTML(cf.auth[i]) + "<br>" + Number(cf.values[i]).toLocaleString("he-IL") + " פרטי מכס";
      } },
      grid: { left: 16, right: 24, top: 16, bottom: 16, containLabel: true },
      xAxis: { type: "value", splitNumber: cn ? 2 : 3, axisLabel: { hideOverlap: true } },
      yAxis: { type: "category", data: cf.names, inverse: true, axisLabel: { interval: 0, width: cn ? 150 : 210, overflow: "truncate", fontSize: cn ? 10 : 11 } },
      series: [{ type: "bar", name: "פרטי מכס", data: cf.values }]
    }));
    window.addEventListener("resize", function () { c.resize(); });

    var s = {{ model.charts.src | tojson }};
    var c2 = echarts.init(document.getElementById("chart-src"));
    c2.setOption(window.GovEcharts.option({
      color: window.GOVIL_PALETTE,
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex, out = ps[0].axisValue;
        ps.forEach(function (p) {
          var q = s.series[p.seriesIndex];
          if (q.counts[i]) { out += "<br>" + p.seriesName + ": " + q.data[i] + "% (" + Number(q.counts[i]).toLocaleString("he-IL") + ")"; }
        });
        return out;
      } },
      legend: { bottom: 0, type: "scroll" },
      grid: { left: 16, right: 24, top: 16, bottom: 48, containLabel: true },
      xAxis: { type: "value", max: 100, splitNumber: 4, axisLabel: { formatter: "{value}%" } },
      yAxis: { type: "category", data: s.names, inverse: true, axisLabel: { width: 100, overflow: "truncate" } },
      series: s.series.map(function (q) { return { type: "bar", stack: "t", name: q.name, data: q.data }; })
    }));
    window.addEventListener("resize", function () { c2.resize(); });

    var sc = {{ model.charts.scope | tojson }};
    window.__govReqHbar("chart-scope", sc.names, sc.series, {
      yAxis: { type: "category", data: sc.names, inverse: true, axisLabel: { width: 100, overflow: "truncate" } }
    });
  })();
</script>

