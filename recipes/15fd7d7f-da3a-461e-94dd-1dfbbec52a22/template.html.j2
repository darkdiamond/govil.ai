<script>
  (function () {
    function hbar(id, names, series, opts) {
      var el = document.getElementById(id);
      if (!el) { return; }
      var c = echarts.init(el);
      var narrow = el.clientWidth < 480;
      c.setOption(window.GovEcharts.option(Object.assign({
        color: window.GOVIL_PALETTE,
        tooltip: { trigger: "axis", axisPointer: { type: "shadow" } },
        legend: series.length > 1 ? { bottom: 0, type: "scroll" } : { show: false },
        grid: { left: 16, right: 24, top: 16, bottom: series.length > 1 ? 48 : 16, containLabel: true },
        xAxis: { type: "value", splitNumber: narrow ? 2 : 3, axisLabel: { hideOverlap: true } },
        yAxis: { type: "category", data: names, inverse: true, axisLabel: { interval: 0, width: narrow ? 115 : 150, overflow: "truncate", fontSize: narrow ? 10 : 11 } },
        series: series.map(function (q) { return { type: "bar", stack: series.length > 1 ? "t" : undefined, name: q.name, data: q.data }; })
      }, opts || {})));
      window.addEventListener("resize", function () { c.resize(); });
    }
    window.__govReqHbar = hbar;

    var o = {{ model.charts.orders | tojson }};
    hbar("chart-orders", o.names, [{ name: "פרטי מכס", data: o.values }], {
      tooltip: { trigger: "axis", axisPointer: { type: "shadow" }, formatter: function (ps) {
        var i = ps[0].dataIndex;
        return echarts.format.encodeHTML(o.full[i]) + "<br>" + Number(o.values[i]).toLocaleString("he-IL") + " פרטי מכס";
      } }
    });

    var au = {{ model.charts.auth | tojson }};
    hbar("chart-auth", au.names, au.series);

    var se = {{ model.charts.sec | tojson }};
    hbar("chart-sec", se.names, se.series);
  })();
</script>

{% if model.flags.heat %}
<script>
  (function () {
    var h = {{ model.charts.heat | tojson }};
    var c = echarts.init(document.getElementById("chart-heat"));
    c.setOption(window.GovEcharts.option({
      tooltip: { position: "top", formatter: function (p) {
        return echarts.format.encodeHTML(h.y[p.value[1]]) + "<br>" + echarts.format.encodeHTML(h.xfull[p.value[0]]) + "<br>" + Number(p.value[2]).toLocaleString("he-IL") + " פרטי מכס";
      } },
      grid: { left: 16, right: 16, top: 16, bottom: 64, containLabel: true },
      xAxis: { type: "category", data: h.x, splitArea: { show: true }, axisLabel: { interval: "auto", hideOverlap: true, fontSize: 10 } },
      yAxis: { type: "category", data: h.y, inverse: true, splitArea: { show: true }, axisLabel: { width: 110, overflow: "truncate", fontSize: 11 } },
      visualMap: {
        type: "piecewise", dimension: 2, orient: "horizontal", left: "center", bottom: 4,
        pieces: [{ min: 1, max: 9 }, { min: 10, max: 99 }, { min: 100, max: 499 }, { min: 500 }],
        inRange: { color: ["#dbe8fb", "#7fb0f5", "#0068f5", "#0b3668"] },
        textStyle: { fontFamily: "Rubik", color: "#0c3058" }
      },
      series: [{ type: "heatmap", data: h.cells, label: { show: false },
                 emphasis: { itemStyle: { shadowBlur: 8, shadowColor: "rgba(0,104,245,.3)" } } }]
    }));
    window.addEventListener("resize", function () { c.resize(); });
  })();
</script>
{% endif %}

