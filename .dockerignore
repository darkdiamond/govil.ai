# Keep the Cloud Run build context small — only the Python service ships.
# Exceptions are whitelisted below for images that need a narrow slice
# of other dirs (e.g. the publisher image needs the frontend lock files).
frontend/
!frontend/package.json
!frontend/package-lock.json
docs/
tests/
venv/
.venv/
node_modules/
.output/
.nuxt/
.git/
.github/
.claude/
data/
# Model-eval snapshots — local-only + gitignored (agent output embeds raw
# dataset content incl. personal contact details). The builder image COPYs
# services/page_builder wholesale, so this dir has to be excluded explicitly
# or it ships inside the container.
services/page_builder/harness-comparison/
*.db
**/__pycache__/
**/*.pyc
.env
.env.local
.DS_Store
*.md
LICENSE
.dockerignore
Dockerfile
cloudbuild-publish.yaml
firebase.json
.firebaserc
infra/
