# Pre-baked image used by cloudbuild-publish.yaml.
#
# Bundles node 22, python 3.11 (Debian bookworm's python3), gcloud SDK (incl.
# gsutil), firebase-tools,
# the publisher's Python deps (services/page_builder/requirements-publish.txt,
# the same file publish.yml installs), and frontend/node_modules. Rebuilt via
# cloudbuild-publisher-image.yaml on changes to the files its trigger's
# --included-files lists (infra/bootstrap.sh).
#
# The image intentionally carries node_modules at /opt/frontend-deps/ so the
# publish build can skip `npm ci` — see cloudbuild-publish.yaml.

# Same Node as publish.yml's setup-node pin: 22.23.0 breaks the deploy's
# WIF/ADC token exchange (see the comment there).
FROM node:26.13.0-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip \
        curl ca-certificates gnupg \
        zstd \
    && install -d -m 0755 /etc/apt/keyrings \
    && curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
        | gpg --dearmor -o /etc/apt/keyrings/cloud.google.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" \
        > /etc/apt/sources.list.d/google-cloud-sdk.list \
    && apt-get update && apt-get install -y --no-install-recommends google-cloud-cli \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# The firebase-tools version frontend/package-lock.json resolves (publish.yml
# deploys with that one).
RUN npm install -g firebase-tools@15.35.0 && npm cache clean --force

# The only Python this image runs is `python3 -m services.page_builder.publish`
# (which imports services/news/publish_news.py). publish.yml runs the same
# module on this same file every day, so both paths share one dependency set.
COPY services/page_builder/requirements-publish.txt /tmp/requirements.txt
RUN pip3 install -r /tmp/requirements.txt && rm /tmp/requirements.txt

# Pre-install frontend deps so the publish build can `cp -a` them into place
# instead of re-running `npm ci`. --ignore-scripts skips `nuxt prepare`
# (needs repo sources we don't have here); `nuxt generate` re-runs prepare
# at build time anyway.
RUN mkdir -p /opt/frontend-deps
COPY frontend/package.json frontend/package-lock.json /opt/frontend-deps/
RUN cd /opt/frontend-deps \
    && npm ci --prefer-offline --no-audit --ignore-scripts \
    && npm cache clean --force

WORKDIR /workspace
