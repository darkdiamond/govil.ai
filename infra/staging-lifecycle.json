{
  "lifecycle": {
    "rule": [
      {
        "action": { "type": "Delete" },
        "condition": {
          "age": 14,
          "matchesPrefix": ["build-cache/"]
        }
      },
      {
        "action": { "type": "Delete" },
        "condition": {
          "age": 400,
          "matchesPrefix": ["models/"]
        }
      }
    ]
  }
}
