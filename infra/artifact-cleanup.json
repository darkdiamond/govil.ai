[
  {
    "name": "delete-older-than-14d",
    "action": { "type": "Delete" },
    "condition": { "tagState": "any", "olderThan": "14d" }
  },
  {
    "name": "keep-5-most-recent",
    "action": { "type": "Keep" },
    "mostRecentVersions": { "keepCount": 5 }
  },
  {
    "name": "keep-latest-tag",
    "action": { "type": "Keep" },
    "condition": { "tagState": "tagged", "tagPrefixes": ["latest"] }
  }
]
