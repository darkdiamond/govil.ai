# govil.ai configuration — copy to .env and fill in.
# .env is gitignored; never commit real secrets.

# --- CKAN (scanner) ---
CKAN_BASE_URL=https://data.gov.il/api/3/action
CKAN_REQUEST_DELAY=0.5
# Upper bound on datasets fetched from CKAN per scan pass. Must cover every
# dataset at/after MIN_MODIFIED_FLOOR (prod: 800).
SCAN_LIMIT=800
# Date gates for the authoring queue (prod: floor 2025-01-01, rolling window off).
# MIN_MODIFIED_FLOOR=2025-01-01
# MAX_AGE_DAYS=100000

# --- Firestore (scanner + builder) ---
FIRESTORE_PROJECT_ID=govdata-il
# Or point at a local emulator for development (uncomment):
# FIRESTORE_EMULATOR_HOST=localhost:8080

# --- Staging + hosting ---
# Staging bucket rendered content.html lands in; the publisher syncs from here.
GCS_STAGING_BUCKET=govdata-il-staging
# Firebase / GCP project for Hosting + deploys.
FIREBASE_PROJECT=govdata-il

# --- Publish trigger ---
# owner/repo the builder dispatches the publish workflow to, reads recipes/
# from (git main) and opens needs-authoring issues on.
PUBLISH_GITHUB_REPO=darkdiamond/govil.ai
PUBLISH_BRANCH=main
# github | cloudbuild — how publishing is triggered.
PUBLISH_VIA=github
# Fine-grained PAT: Actions read+write (publish dispatch) + Issues read+write
# (authoring queue).
GITHUB_DISPATCH_TOKEN=
# Cloud Build fallback (PUBLISH_VIA=cloudbuild).
PUBLISH_TRIGGER_ID=govdata-publish
PUBLISH_REGION=me-west1

# --- Recipe refresh + authoring queue ---
# off | observe | inputs | full — skip CKAN bumps that changed nothing (prod: full).
REFRESH_PRECHECK=off
# Max NEW needs-authoring issues opened per run.
AUTHORING_NOTIFY_CAP=100

# --- Optional: frontend analytics/ads (nuxt generate time) ---
# All three are off when unset: the generated site contains no GA, AdSense,
# or Clarity code, and no ads.txt is emitted. Production sets these as
# GitHub repo variables consumed by .github/workflows/publish.yml.
NUXT_PUBLIC_GTAG_ID=
NUXT_PUBLIC_ADSENSE_ID=
NUXT_PUBLIC_CLARITY_ID=

# --- Optional: embedding-driven relatedness (Voyage) ---
VOYAGE_ENABLED=false
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4

# --- Logging ---
LOG_LEVEL=INFO
