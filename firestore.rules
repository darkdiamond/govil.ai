rules_version = '2';

// govil.ai never reads Firestore from the browser: the site is static
// (nuxt generate), and the only Firestore clients are the builder and the
// publisher, which use the Admin SDK with a service account and bypass these
// rules. Deny every client-SDK request so a console click can't open
// `sources/*` or `scan_runs/*` to the world.
//
// Deploy (manual; publish workflows deploy `--only hosting`):
//   firebase deploy --only firestore:rules --project govdata-il
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
